+  <!-- Public API: slots title/description/action; parts surface/content/actions;
+       optional --drink-card-background and --drink-card-border-color overrides.
+       Site tokens and typography inherit from any ancestor across the shadow root. -->
+  <template id="drink-card-template">
+    <style>
+      @layer base, theme, variants, responsive;
+
+      @layer base {
+        :host {
+          display: block;
+          box-sizing: border-box;
+          min-inline-size: 0;
+          container: drink-card / inline-size;
+          padding: 20px;
+          border: 1px solid transparent;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+        }
+
+        article {
+          display: grid;
+          gap: 15px;
+          text-align: center;
+          overflow-wrap: anywhere;
+        }
+
+        .content {
+          display: grid;
+          align-content: start;
+          gap: 10px;
+        }
+
+        ::slotted(h3),
+        ::slotted(p) {
+          margin: 0;
+        }
+
+        ::slotted(a) {
+          display: inline-block;
+          padding: 10px 20px;
+          border-radius: 5px;
+          text-decoration: none;
+        }
+      }
+
+      @layer theme {
+        :host {
+          /* Private aliases leave public properties free to inherit. */
+          --_primary: var(--primary, #4e342e);
+          --_secondary: var(--secondary, #d7ccc8);
+          --_accent: var(--accent, #ffab40);
+          color: var(--text, #3e2723);
+          background: var(--drink-card-background, white);
+        }
+
+        ::slotted(h3) {
+          color: var(--_primary);
+        }
+
+        ::slotted(a) {
+          color: var(--light, #fafafa);
+          background: var(--_primary);
+        }
+
+        ::slotted(a:focus-visible) {
+          outline: 3px solid var(--_primary);
+          outline-offset: 3px;
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          border-color: var(--drink-card-border-color, var(--_accent));
+          border-block-start-width: 4px;
+        }
+
+        :host([variant="outlined"]) {
+          border-color: var(--drink-card-border-color, var(--_secondary));
+          box-shadow: none;
+        }
+      }
+
+      @layer responsive {
+        /* Measure the host; change its descendants, never the query container. */
+        @container drink-card (min-width: 28rem) {
+          article {
+            grid-template-columns: minmax(0, 1fr) auto;
+            align-items: center;
+            gap: 20px;
+            text-align: start;
+          }
+
+          .actions {
+            max-inline-size: 12rem;
+          }
+        }
+      }
+    </style>
+    <article part="surface">
+      <div class="content" part="content">
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+      </div>
+      <div class="actions" part="actions">
+        <slot name="action"></slot>
+      </div>
+    </article>
+  </template>
+
+  <script type="module">
+    const drinkCardTemplate = document.getElementById('drink-card-template');
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' })
+          .append(drinkCardTemplate.content.cloneNode(true));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
