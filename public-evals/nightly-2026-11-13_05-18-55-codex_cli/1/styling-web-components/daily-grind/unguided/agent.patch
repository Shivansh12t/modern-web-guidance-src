+  <template id="coffee-card-template">
+    <style>
+      /* Later layers override earlier layers without specificity escalation. */
+      @layer reset, base, variants, layout;
+
+      @layer reset {
+        *, *::before, *::after { box-sizing: border-box; }
+        ::slotted(*) { margin: 0; }
+      }
+
+      @layer base {
+        /* Theme tokens and typography inherit across the shadow boundary. */
+        :host {
+          display: block;
+          min-width: 0;
+          container: coffee-card / inline-size;
+          color: var(--text, #3e2723);
+          background: var(--card-surface, #fff);
+          border: 1px solid transparent;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+          font: inherit;
+        }
+
+        .card {
+          display: grid;
+          gap: 15px;
+          height: 100%;
+          padding: var(--card-padding, 20px);
+          text-align: center;
+          overflow-wrap: anywhere;
+        }
+
+        .content { display: grid; gap: 10px; }
+        .title { color: var(--primary, #4e342e); }
+        ::slotted([slot="title"]) { font-size: 1.17em; }
+        ::slotted([slot="description"]) { line-height: inherit; }
+
+        .action {
+          justify-self: center;
+          align-self: end;
+          display: inline-block;
+          padding: 10px 20px;
+          border-radius: 5px;
+          background: var(--primary, #4e342e);
+          color: var(--light, #fafafa);
+          text-decoration: none;
+          transition: background 0.3s;
+        }
+
+        .action:hover { background: var(--text, #3e2723); }
+        .action:focus-visible {
+          outline: 3px solid var(--accent, #ffab40);
+          outline-offset: 3px;
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          border-color: var(--accent, #ffab40);
+          border-top-width: 4px;
+        }
+
+        :host([variant="iced"]) {
+          background: var(--card-surface, var(--secondary, #d7ccc8));
+          box-shadow: none;
+          border-color: var(--primary, #4e342e);
+        }
+      }
+
+      @layer layout {
+        /* Query the host's width, so cards adapt independently of the viewport. */
+        @container coffee-card (min-width: 26rem) {
+          .card {
+            grid-template-columns: minmax(0, 1fr) auto;
+            align-items: center;
+            gap: 24px;
+            text-align: left;
+          }
+          .action { align-self: center; }
+        }
+
+        @container coffee-card (max-width: 17rem) {
+          .card { padding: 16px; }
+          .action { justify-self: stretch; }
+        }
+      }
+    </style>
+    <article class="card" part="card">
+      <div class="content" part="content">
+        <div class="title" part="title"><slot name="title"></slot></div>
+        <div part="description"><slot name="description"></slot></div>
+      </div>
+      <a class="action" part="action"><slot name="action-label">View Details</slot></a>
+    </article>
+  </template>
+
+  <script type="module">
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = ['href'];
+
+      constructor() {
+        super();
+        const template = document.getElementById('coffee-card-template');
+        this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+      }
+
+      connectedCallback() {
+        this.syncLink();
+      }
+
+      attributeChangedCallback() {
+        this.syncLink();
+      }
+
+      syncLink() {
+        const action = this.shadowRoot.querySelector('.action');
+        const href = this.getAttribute('href');
+        if (href) {
+          action.setAttribute('href', href);
+        } else {
+          action.removeAttribute('href');
+        }
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
+
 </body>
 
