+    .seasonal-promo {
+      display: flex;
+      justify-content: center;
+      padding: 24px 32px;
+    }
+
+    .target {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 112px;
+      height: 112px;
+      padding: 16px;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.9rem;
+      font-weight: 700;
+      line-height: 1.3;
+      text-align: center;
+      text-decoration: none;
+      /* Keep a stacking context before, during, and after hover. */
+      isolation: isolate;
+      /* Separate properties let both animations and the transition compose. */
+      transform: scale(1);
+      transition: transform 250ms ease;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      transform: scale(1.12);
+    }
+
+    .target:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -20px 0; }
+      to { translate: 20px 0; }
+    }
+
