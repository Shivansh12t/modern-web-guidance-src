--- a/index.html
+++ b/index.html
@@ -106,8 +106,65 @@
       gap: 20px;
       margin-top: 20px;
     }
 
+    .seasonal-promo {
+      display: flex;
+      justify-content: center;
+      padding: 24px;
+      margin-top: 8px;
+    }
+
+    .target {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      width: 112px;
+      height: 112px;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      text-align: center;
+      font-size: 0.85rem;
+      line-height: 1.4;
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.15);
+      /* Identity transforms establish a stable stacking context before hover. */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+      /* Each animation owns a separate property; hover only changes scale. */
+      animation: promo-spin 12s linear infinite,
+        promo-slide 2.5s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.1;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -18px 0; }
+      to { translate: 18px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation-duration: 60s, 12s;
+        transition: none;
+      }
+
+      .target:hover {
+        scale: 1;
+      }
+    }
+
