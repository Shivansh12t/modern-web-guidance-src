+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const actionClasses = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+    const actionButtons = document.querySelectorAll('button[commandfor="action-target"]');
+
+    function handleAction(command) {
+      if (command === '--reset') {
+        actionTarget.classList.remove(...Object.values(actionClasses));
+      } else if (Object.hasOwn(actionClasses, command)) {
+        actionTarget.classList.toggle(actionClasses[command]);
+      }
+
+      actionButtons.forEach((button) => {
+        const className = actionClasses[button.getAttribute('command')];
+        if (className) {
+          button.setAttribute('aria-pressed', String(actionTarget.classList.contains(className)));
+        }
+      });
+    }
+
+    actionTarget.addEventListener('command', (event) => handleAction(event.command));
+
+    // Support browsers that do not yet implement invoker commands.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      actionButtons.forEach((button) => {
+        button.addEventListener('click', () => handleAction(button.getAttribute('command')));
+      });
+    }
+  </script>
