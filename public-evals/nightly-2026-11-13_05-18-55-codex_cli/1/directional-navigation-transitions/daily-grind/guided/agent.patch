+  <script>
+    const slides = Array.from(document.querySelectorAll('.seasonal-slides .card'));
+    const status = document.querySelector('#seasonal-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let activeIndex = 0;
+    let transitioning = false;
+
+    async function changeSlide(step) {
+      if (transitioning) return;
+      transitioning = true;
+      const update = () => {
+        slides[activeIndex].hidden = true;
+        activeIndex = (activeIndex + step + slides.length) % slides.length;
+        slides[activeIndex].hidden = false;
+        status.textContent = `${activeIndex + 1} of ${slides.length} — ${slides[activeIndex].querySelector('h3').textContent}`;
+      };
+
+      try {
+        if (reducedMotion.matches) {
+          update();
+        } else if (document.startViewTransition &&
+          CSS.supports('selector(:active-view-transition-type(forward))')) {
+          const transition = document.startViewTransition({
+            update,
+            types: [step > 0 ? 'forward' : 'backward']
+          });
+          await transition.finished;
+        } else {
+          update();
+          if (slides[activeIndex].animate) {
+            await slides[activeIndex].animate([
+              { transform: `translateX(${step > 0 ? '100%' : '-100%'})` },
+              { transform: 'translateX(0)' }
+            ], { duration: 300, easing: 'ease-in-out' }).finished;
+          }
+        }
+      } finally {
+        transitioning = false;
+      }
+    }
+
+    document.querySelector('#seasonal-previous').addEventListener('click', () => changeSlide(-1));
+    document.querySelector('#seasonal-next').addEventListener('click', () => changeSlide(1));
+    document.querySelector('.seasonal-controls').hidden = false;
+  </script>
 </body>
 
