+  <script>
+    const drinkCards = document.querySelectorAll('.drink-card');
+
+    function setActionsOpen(card, open) {
+      card.classList.toggle('is-open', open);
+      const toggle = card.querySelector('.actions-toggle');
+      toggle.setAttribute('aria-expanded', String(open));
+      toggle.textContent = open ? 'Close actions' : 'Actions';
+      card.querySelector('.drink-actions').inert = !open;
+    }
+
+    function openActions(card) {
+      drinkCards.forEach(item => setActionsOpen(item, item === card));
+    }
+
+    drinkCards.forEach(card => {
+      let gesture = null;
+      let suppressClick = false;
+      let clickReset;
+
+      card.querySelector('.actions-toggle').addEventListener('click', () => {
+        if (card.classList.contains('is-open')) setActionsOpen(card, false);
+        else openActions(card);
+      });
+
+      card.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0) return;
+        clearTimeout(clickReset);
+        suppressClick = false;
+        if (event.target.closest('.drink-actions')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, horizontal: false };
+      });
+
+      card.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = Math.abs(event.clientX - gesture.x);
+        const dy = Math.abs(event.clientY - gesture.y);
+        if (!gesture.horizontal && dy > 10 && dy > dx) {
+          gesture = null;
+          return;
+        }
+        if (!gesture.horizontal && dx > 12 && dx > dy * 1.5) {
+          gesture.horizontal = true;
+          card.setPointerCapture(event.pointerId);
+        }
+        if (gesture.horizontal) event.preventDefault();
+      });
+
+      card.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = Math.abs(event.clientX - gesture.x);
+        const dy = Math.abs(event.clientY - gesture.y);
+        if (gesture.horizontal) {
+          // A swipe only reveals or dismisses the tray; actions require a fresh click.
+          suppressClick = true;
+          clickReset = setTimeout(() => { suppressClick = false; }, 400);
+          if (dx >= 45 && dx > dy * 1.5) {
+            if (card.classList.contains('is-open')) setActionsOpen(card, false);
+            else openActions(card);
+          }
+        }
+        gesture = null;
+      });
+
+      card.addEventListener('click', event => {
+        if (!suppressClick) return;
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        suppressClick = false;
+      }, true);
+
+      card.addEventListener('pointercancel', () => { gesture = null; });
+      card.addEventListener('lostpointercapture', () => { gesture = null; });
+      card.addEventListener('dragstart', event => event.preventDefault());
+      card.addEventListener('keydown', event => {
+        if (event.key === 'Escape' && card.classList.contains('is-open')) {
+          setActionsOpen(card, false);
+          card.querySelector('.actions-toggle').focus();
+        }
+      });
+    });
+
+    document.addEventListener('pointerdown', event => {
+      if (!event.target.closest('.drink-card')) {
+        drinkCards.forEach(card => setActionsOpen(card, false));
+      }
+    });
+  </script>
