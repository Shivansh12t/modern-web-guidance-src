+  <script>
+    document.querySelectorAll('.drink-card').forEach(card => {
+      const content = card.querySelector('.drink-content');
+      const panel = card.querySelector('.drink-actions');
+      const toggle = card.querySelector('.actions-toggle');
+      const favorite = card.querySelector('.save-favorite');
+
+      // Scrolling only reveals controls; actions run exclusively on activation.
+      const syncState = () => {
+        const travel = card.scrollWidth - card.clientWidth;
+        const open = travel > 0 && card.scrollLeft > travel / 2;
+        if (!open && panel.contains(document.activeElement)) {
+          toggle.focus({ preventScroll: true });
+        }
+        toggle.setAttribute('aria-expanded', String(open));
+        panel.inert = !open;
+      };
+
+      const setOpen = open => {
+        card.scrollTo({ left: open ? card.scrollWidth - card.clientWidth : 0 });
+      };
+
+      toggle.addEventListener('click', () => {
+        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
+      });
+      panel.querySelector('.actions-close').addEventListener('click', () => {
+        toggle.focus({ preventScroll: true });
+        setOpen(false);
+      });
+      card.addEventListener('keydown', event => {
+        if (event.key === 'Escape') {
+          toggle.focus({ preventScroll: true });
+          setOpen(false);
+        }
+      });
+      content.addEventListener('focusin', event => {
+        if (event.target.matches(':focus-visible')) setOpen(false);
+      });
+      favorite.addEventListener('click', () => {
+        const saved = favorite.getAttribute('aria-pressed') !== 'true';
+        favorite.setAttribute('aria-pressed', String(saved));
+        favorite.textContent = saved ? 'Saved' : 'Save Favorite';
+        favorite.setAttribute('aria-label', `${saved ? 'Saved' : 'Save Favorite'}: ${content.querySelector('h3').textContent}`);
+      });
+
+      // Keep accessibility state in sync for native swipes and button scrolling.
+      if ('onscrollsnapchange' in card) {
+        card.addEventListener('scrollsnapchange', syncState);
+      } else {
+        let frame;
+        card.addEventListener('scroll', () => {
+          if (frame) return;
+          frame = requestAnimationFrame(() => {
+            frame = null;
+            syncState();
+          });
+        }, { passive: true });
+        card.addEventListener('scrollend', syncState);
+      }
+      window.addEventListener('load', syncState, { once: true });
+      window.addEventListener('pageshow', syncState);
+      syncState();
+    });
+  </script>
