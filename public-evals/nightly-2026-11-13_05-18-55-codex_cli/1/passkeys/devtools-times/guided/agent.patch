+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,133 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ApiError, authRequest, type Account, type PasskeyList } from '../lib/auth-api';
+import { authenticatePasskey, authError, getPasskeyCapabilities, registerPasskey, syncPasskeys, syncUser, type PasskeyCapabilities } from '../lib/passkeys';
+
+type PendingAction = { kind: 'delete'; id: string; name: string } | { kind: 'profile'; name: string; displayName: string } | { kind: 'create' };
+export default function AccountSettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [list, setList] = useState<PasskeyList | null>(null);
+  const [capabilities, setCapabilities] = useState<PasskeyCapabilities | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [unauthorized, setUnauthorized] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [success, setSuccess] = useState('');
+  const [name, setName] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [nickname, setNickname] = useState('');
+  const [pending, setPending] = useState<PendingAction | null>(null);
+  const [password, setPassword] = useState('');
+  const active = useRef<AbortController | null>(null);
+  const verificationPanel = useRef<HTMLDivElement>(null);
+  const base = import.meta.env.BASE_URL;
+
+  const load = async (signal: AbortSignal) => {
+    const [user, keys] = await Promise.all([
+      authRequest<Account>('/account', undefined, 'GET', signal),
+      authRequest<PasskeyList>('/passkeys', undefined, 'GET', signal),
+    ]);
+    if (signal.aborted) return;
+    setAccount(user); setName(user.name); setDisplayName(user.displayName); setList(keys);
+    await syncPasskeys(keys);
+  };
+  const reloadKeys = async (signal: AbortSignal) => {
+    const keys = await authRequest<PasskeyList>('/passkeys', undefined, 'GET', signal);
+    if (!signal.aborted) { setList(keys); await syncPasskeys(keys); }
+  };
+  const report = (error: unknown) => {
+    if (error instanceof ApiError && error.status === 401) setUnauthorized(true);
+    setError(authError(error));
+  };
+  useEffect(() => {
+    const controller = new AbortController();
+    void load(controller.signal).catch(error => { if (!controller.signal.aborted) report(error); })
+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });
+    getPasskeyCapabilities().then(c => { if (!controller.signal.aborted) setCapabilities(c); }).catch(() => {});
+    return () => { controller.abort(); active.current?.abort(); };
+  }, []);
+  useEffect(() => { if (pending) verificationPanel.current?.focus(); }, [pending]);
+
+  const run = async (action: (signal: AbortSignal) => Promise<void>) => {
+    if (active.current) return;
+    const controller = new AbortController(); active.current = controller;
+    setBusy(true); setError(''); setSuccess('');
+    try { await action(controller.signal); }
+    catch (error) { if (!controller.signal.aborted) report(error); }
+    finally { active.current = null; if (!controller.signal.aborted) setBusy(false); }
+  };
+  const perform = async (action: PendingAction, signal: AbortSignal) => {
+    if (action.kind === 'delete') {
+      await authRequest(`/passkeys/${encodeURIComponent(action.id)}`, {}, 'DELETE', signal);
+      setSuccess('Passkey deleted. You can also remove its saved copy from your password manager.');
+      await reloadKeys(signal);
+    } else if (action.kind === 'create') {
+      await registerPasskey(false, signal);
+      setSuccess('Passkey created. You can now use it to sign in.');
+      await reloadKeys(signal);
+    } else {
+      const updated = await authRequest<Account & { rpId: string; userId: string }>('/account', { name: action.name, displayName: action.displayName }, 'PUT', signal);
+      setAccount(updated); setName(updated.name); setDisplayName(updated.displayName);
+      await syncUser(updated); setSuccess('Account details saved.');
+    }
+  };
+  const verify = (method: 'passkey' | 'password') => void run(async signal => {
+    if (!pending) return;
+    if (method === 'passkey') await authenticatePasskey(signal, false, true);
+    else await authRequest('/reauth/password', { password }, 'POST', signal);
+    setPassword('');
+    const action = pending;
+    setPending(null);
+    await perform(action, signal);
+  });
+  const date = (timestamp?: number) => timestamp ? new Date(timestamp).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Not used yet';
+
+  return <section className="account-settings" aria-labelledby="account-title" aria-busy={loading || busy}>
+    <p className="auth-eyebrow">Your Times account</p>
+    <h1 id="account-title">Account settings</h1>
+    <p className="auth-description">Your details, your security, your peace of mind.</p>
+    {error && <p className="auth-error" role="alert">{error}</p>}
+    {success && <p className="auth-success" role="status">{success}</p>}
+    {loading ? <p role="status">Loading your account…</p> : unauthorized ? <div className="settings-panel"><h2>Sign in to manage your account</h2><p className="auth-description">Your session may have expired.</p><a className="auth-button" href={`${base}signin`}>Sign in</a></div> : !account ? <button className="auth-button" onClick={() => void run(signal => load(signal))}>Try again</button> : <>
+      {pending && <div className="verification-panel" ref={verificationPanel} tabIndex={-1} role="region" aria-labelledby="verification-title">
+        <h2 id="verification-title">Confirm it’s you</h2>
+        <p className="auth-description">{pending.kind === 'delete' ? `Verify your identity to delete “${pending.name}”.` : pending.kind === 'create' ? 'Verify your identity before adding a new passkey.' : 'Verify your identity to save your account details.'}</p>
+        {capabilities?.supported && !!list?.credentials.length && <button className="auth-button" disabled={busy} onClick={() => verify('passkey')}>{busy ? 'Verifying…' : 'Verify with a passkey'}</button>}
+        {account.hasPassword && <form className="auth-stack mt-4" onSubmit={event => { event.preventDefault(); verify('password'); }}>
+          <div><label htmlFor="verify-password">Current password</label><input id="verify-password" type="password" autoComplete="current-password" required value={password} onChange={e => setPassword(e.target.value)} disabled={busy} /></div>
+          <button className="auth-button secondary" disabled={busy}>Verify with password</button>
+        </form>}
+        {!account.hasPassword && (!capabilities?.supported || !list?.credentials.length) && <p className="auth-error">Verification is unavailable on this device. Use a device with access to your passkeys.</p>}
+        <button className="auth-text-link mt-4" disabled={busy} onClick={() => { setPending(null); setPassword(''); }}>Cancel</button>
+      </div>}
+      <fieldset disabled={busy || !!pending} className="settings-panel">
+        <legend className="sr-only">Account details</legend><h2>Account details</h2>
+        <form className="auth-stack" onSubmit={event => { event.preventDefault(); setPending({ kind: 'profile', name: name.trim(), displayName: displayName.trim() }); }}>
+          <div><label htmlFor="account-username">Username</label><input id="account-username" autoComplete="username" required maxLength={100} value={name} onChange={e => setName(e.target.value)} /></div>
+          <div><label htmlFor="display-name">Display name</label><input id="display-name" autoComplete="nickname" required maxLength={100} value={displayName} onChange={e => setDisplayName(e.target.value)} /></div>
+          <button className="auth-button secondary" disabled={!name.trim() || !displayName.trim() || (name === account.name && displayName === account.displayName)}>Save account details</button>
+        </form>
+      </fieldset>
+      <fieldset disabled={busy || !!pending} className="settings-panel">
+        <legend className="sr-only">Passkeys</legend><div className="settings-heading"><div><h2>Passkeys</h2><p className="auth-help">Sign in with your fingerprint, face, or device screen lock.</p></div>
+          {capabilities?.create && <button className="auth-button" onClick={() => setPending({ kind: 'create' })}>Create a passkey</button>}</div>
+        {capabilities && !capabilities.create && <p className="auth-help">Passkey creation is unavailable in this browser. Use a supported browser over HTTPS. Your password remains available.</p>}
+        {list?.credentials.length === 0 && <div className="passkey-empty"><h3>No passkeys yet</h3><p className="auth-help">Add a passkey for faster, safer sign-ins. You can keep using your password.</p></div>}
+        <ul className="passkey-list">{list?.credentials.map(key => <li key={key.id}>
+          <div className="passkey-row">
+            {key.providerIcon?.startsWith('data:image/png;base64,') ? <img src={key.providerIcon} alt="" width="36" height="36" /> : <span className="passkey-icon" aria-hidden="true">⚿</span>}
+            <div className="passkey-info"><h3>{key.name || key.providerName || 'Passkey'}</h3><p className="auth-help">{key.providerName || 'Unknown passkey provider'}</p><p className="auth-help">Created {date(key.registeredAt)} · Last used: {date(key.lastUsedAt)}</p></div>
+            <div className="passkey-actions"><button className="auth-text-link" onClick={() => { setEditing(key.id); setNickname(key.name); }}>Rename<span className="sr-only"> {key.name}</span></button><button className="auth-text-link danger" onClick={() => setPending({ kind: 'delete', id: key.id, name: key.name })} disabled={!account.hasPassword && list.credentials.length === 1}>Delete<span className="sr-only"> {key.name}</span></button></div>
+          </div>
+          {editing === key.id && <form className="rename-form" onSubmit={event => { event.preventDefault(); void run(async signal => {
+            await authRequest(`/passkeys/${encodeURIComponent(key.id)}`, { name: nickname.trim() }, 'PUT', signal);
+            setEditing(null); await reloadKeys(signal); setSuccess('Passkey renamed.');
+          }); }}><label className="sr-only" htmlFor="passkey-nickname">Passkey name</label><input id="passkey-nickname" value={nickname} onChange={e => setNickname(e.target.value)} required maxLength={100} autoFocus /><button className="auth-button secondary" disabled={!nickname.trim()}>Save</button><button type="button" className="auth-text-link" onClick={() => setEditing(null)}>Cancel</button></form>}
+        </li>)}</ul>
+        {!account.hasPassword && list?.credentials.length === 1 && <p className="auth-help">Add another passkey before deleting your only sign-in method.</p>}
+        <p className="auth-help mt-4">Passkeys may sync through your password manager. To stop using a passkey everywhere, delete it here and from your password manager.</p>
+      </fieldset>
+      <button className="auth-text-link" disabled={busy || !!pending} onClick={() => void run(async signal => { await authRequest('/logout', {}, 'POST', signal); window.location.assign(`${base}signin`); })}>Sign out</button>
+    </>}
+  </section>;
+}
diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..b860bf7
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,116 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { authRequest } from '../lib/auth-api';
+import { authenticatePasskey, authError, getPasskeyCapabilities, registerPasskey, type PasskeyCapabilities } from '../lib/passkeys';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [success, setSuccess] = useState('');
+  const [busy, setBusy] = useState('');
+  const [signedIn, setSignedIn] = useState(false);
+  const [created, setCreated] = useState(false);
+  const [capabilities, setCapabilities] = useState<PasskeyCapabilities | null>(null);
+  const active = useRef<AbortController | null>(null);
+  const conditional = useRef<AbortController | null>(null);
+  const mounted = useRef(false);
+  const base = import.meta.env.BASE_URL;
+
+  const armAutofill = async () => {
+    conditional.current?.abort();
+    const controller = new AbortController();
+    conditional.current = controller;
+    try {
+      await authenticatePasskey(controller.signal, true);
+      if (controller.signal.aborted || !mounted.current) return;
+      setSignedIn(true);
+      setSuccess('You’re signed in with your passkey.');
+    } catch (error) {
+      // Background autofill must not interrupt password sign-in or show cancellation errors.
+      if (!controller.signal.aborted && error instanceof Error && error.name !== 'NotAllowedError') {
+        console.warn('Passkey autofill unavailable. Password sign-in is still available.');
+      }
+    }
+  };
+
+  useEffect(() => {
+    mounted.current = true;
+    getPasskeyCapabilities().then(c => {
+      if (!mounted.current) return;
+      setCapabilities(c);
+      if (!signup && c.conditional) void armAutofill();
+    }).catch(() => mounted.current && setCapabilities({ supported: false, create: false, conditional: false }));
+    return () => { mounted.current = false; active.current?.abort(); conditional.current?.abort(); };
+  }, []);
+
+  const run = async (kind: string, action: (signal: AbortSignal) => Promise<void>) => {
+    if (active.current) return;
+    conditional.current?.abort();
+    const controller = new AbortController();
+    active.current = controller;
+    setBusy(kind); setError(''); setSuccess('');
+    let completed = false;
+    try { await action(controller.signal); completed = true; }
+    catch (error) { if (!controller.signal.aborted && mounted.current) setError(authError(error)); }
+    finally {
+      active.current = null;
+      if (mounted.current) {
+        setBusy('');
+        if (!completed && kind === 'passkey' && capabilities?.conditional) void armAutofill();
+      }
+    }
+  };
+
+  const submit = (event: React.FormEvent) => {
+    event.preventDefault();
+    void run('password', async signal => {
+      if (signup) {
+        await authRequest('/register', { username, password }, 'POST', signal);
+        setCreated(true);
+      }
+      try { await authRequest('/login', { username, password }, 'POST', signal); }
+      catch (error) {
+        if (signup) setSuccess('Your account was created. Sign in to set up your passkey.');
+        throw error;
+      }
+      setPassword(''); setSignedIn(true);
+      setSuccess(signup ? 'Your account is ready. Add a passkey for faster, safer sign-ins.' : 'You’re signed in.');
+    });
+  };
+
+  return <section className="auth-card" aria-labelledby="auth-heading" aria-busy={!!busy}>
+    <p className="auth-eyebrow">The DevTools Times</p>
+    <h1 id="auth-heading">{signedIn ? (signup ? 'Welcome to The Times' : 'Welcome back') : signup ? 'Create your account' : 'Sign in'}</h1>
+    <p id="auth-description" className="auth-description">{signedIn ? 'Your next great read is waiting.' : signup ? 'Independent stories. A fresh perspective. An account that’s yours.' : 'Good to see you again. Pick up where you left off.'}</p>
+    {error && <p className="auth-error" role="alert">{error}</p>}
+    {success && <p className="auth-success" role="status">{success}</p>}
+    {!signedIn && !(signup && created) && <>
+      {!signup && <>
+        <button type="button" className="auth-button" disabled={!!busy || !capabilities?.supported}
+          onClick={() => void run('passkey', async signal => {
+            await authenticatePasskey(signal);
+            conditional.current?.abort();
+            setSignedIn(true); setSuccess('You’re signed in with your passkey.');
+          })}>{busy === 'passkey' ? 'Waiting for your passkey…' : 'Sign in with a passkey'}</button>
+        <p className="auth-help">Use your fingerprint, face, or device screen lock. No password needed.</p>
+        {capabilities && !capabilities.supported && <p className="auth-help">Passkeys aren’t available in this browser or connection. Sign in with your password below.</p>}
+        <div className="auth-divider"><span>or use your password</span></div>
+      </>}
+      <form onSubmit={submit} className="auth-stack">
+        <div><label htmlFor="username">Username</label><input id="username" name="username" autoFocus={!signup} aria-describedby="auth-description" autoComplete={signup ? 'username' : 'username webauthn'} required value={username} onChange={e => setUsername(e.target.value)} disabled={!!busy} /></div>
+        <div><label htmlFor="password">Password</label><input id="password" name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} required minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} aria-describedby={signup ? 'password-help' : undefined} value={password} onChange={e => setPassword(e.target.value)} disabled={!!busy} />
+          {signup && <p id="password-help" className="auth-help">Use at least 8 characters, including a number. You can add a passkey after creating your account.</p>}</div>
+        <button className={signup ? 'auth-button' : 'auth-button secondary'} disabled={!!busy} data-skip-tracking="true">{busy === 'password' ? (signup ? 'Creating account…' : 'Signing in…') : signup ? 'Create account' : 'Sign in with password'}</button>
+      </form>
+    </>}
+    {signedIn && <div className="auth-stack">
+      {capabilities?.create && <div className="passkey-promotion"><h2>Add a passkey</h2><p className="auth-help">A simpler, more secure way to sign in. Your biometric information stays on your device.</p>
+        <button className="auth-button" type="button" disabled={!!busy} onClick={() => void run('create', async signal => {
+          await registerPasskey(true, signal); setSuccess('Passkey created. You can use it the next time you sign in.');
+        })}>{busy === 'create' ? 'Creating passkey…' : 'Create a passkey'}</button></div>}
+      <a className="auth-button secondary" href={`${base}account`}>Go to account settings</a>
+      <a className="auth-text-link" href={base}>Continue reading</a>
+    </div>}
+    {!signedIn && <p className="auth-footer">{signup ? 'Already have an account? ' : 'New to The Times? '}<a href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'}</a></p>}
+  </section>;
+}
