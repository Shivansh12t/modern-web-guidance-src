--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,85 @@
+import { ApiError, authRequest, type PasskeyList } from './auth-api';
+
+export interface PasskeyCapabilities { supported: boolean; create: boolean; conditional: boolean }
+export async function getPasskeyCapabilities(): Promise<PasskeyCapabilities> {
+  const unavailable = { supported: false, create: false, conditional: false };
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) return unavailable;
+  await import('webauthn-polyfills');
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return { supported: true, conditional: !!capabilities.conditionalGet,
+      create: !!capabilities.conditionalGet && !!capabilities.passkeyPlatformAuthenticator };
+  } catch { return { ...unavailable, supported: true }; }
+}
+
+export function isBase64Url(value: string) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function signalUnknown(rpId: string | undefined, credentialId: string) {
+  if (!rpId || !isBase64Url(credentialId) || !PublicKeyCredential.signalUnknownCredential) return;
+  try { await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }); }
+  catch (error) { console.warn('Passkey provider synchronization unavailable.', error); }
+}
+
+export async function syncPasskeys(list: PasskeyList) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials || !list.rpId ||
+      !isBase64Url(list.userId) || !list.credentials.every(c => isBase64Url(c.id))) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: list.rpId, userId: list.userId,
+      allAcceptedCredentialIds: list.credentials.map(c => c.id) });
+  } catch (error) { console.warn('Passkey provider synchronization unavailable.', error); }
+}
+
+export async function syncUser(user: { rpId: string; userId: string; name: string; displayName: string }) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails || !user.rpId || !isBase64Url(user.userId)) return;
+  try { await PublicKeyCredential.signalCurrentUserDetails(user); }
+  catch (error) { console.warn('Passkey profile synchronization unavailable.', error); }
+}
+
+export async function registerPasskey(promotion: boolean, signal: AbortSignal) {
+  await import('webauthn-polyfills');
+  const options = await authRequest<PublicKeyCredentialCreationOptionsJSON>('/passkeys/register/options', { promotion }, 'POST', signal);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  const credential = await navigator.credentials.create({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  const encoded = credential.toJSON();
+  // Only verification failures can leave an orphaned credential in the provider.
+  try {
+    await authRequest('/passkeys/register/verify', encoded, 'POST', signal);
+  } catch (error) {
+    await signalUnknown(publicKey.rp.id, encoded.id);
+    throw error;
+  }
+}
+
+export async function authenticatePasskey(signal: AbortSignal, conditional = false, reauthenticate = false) {
+  await import('webauthn-polyfills');
+  const path = reauthenticate ? '/passkeys/reauth' : '/passkeys/authenticate';
+  const options = await authRequest<PublicKeyCredentialRequestOptionsJSON>(`${path}/options`, {}, 'POST', signal);
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  if (reauthenticate && !publicKey.allowCredentials?.length) {
+    throw new Error('No passkeys are available for this account. Verify with your password instead.');
+  }
+  const credential = await navigator.credentials.get({ publicKey, signal,
+    ...(conditional ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  const encoded = credential.toJSON();
+  try { await authRequest(`${path}/verify`, encoded, 'POST', signal); }
+  catch (error) {
+    // Never signal a different account's credential from an authenticated session.
+    if (!reauthenticate && error instanceof ApiError && error.status === 404 && error.code === 'CREDENTIAL_NOT_FOUND') await signalUnknown(publicKey.rpId, encoded.id);
+    throw error;
+  }
+}
+
+export function authError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. Try again or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try a different device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys could not be used on this site. Check that you are using HTTPS, or use your password.';
+    if (error.name === 'AbortError') return 'The request was cancelled. Please try again.';
+  }
+  if (error instanceof TypeError) return 'Unable to reach the authentication service. Please try again.';
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
