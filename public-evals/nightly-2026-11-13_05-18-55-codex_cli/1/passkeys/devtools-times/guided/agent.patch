+.auth-card, .account-settings {
+  color: #1f2937;
+  margin-inline: auto;
+  width: 100%;
+}
+.auth-card { max-width: 440px; padding: 2rem; border: 1px solid #d1d5db; border-radius: 8px; }
+.account-settings { max-width: 720px; }
+.auth-eyebrow { font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 700; margin-bottom: .75rem; }
+.auth-card h1, .account-settings h1 { font-family: Georgia, serif; font-size: 2rem; line-height: 1.2; font-weight: 700; }
+.auth-card h2, .account-settings h2 { font-size: 1.15rem; font-weight: 700; margin-bottom: .6rem; }
+.auth-description { color: #4b5563; font-size: .9rem; margin: .8rem 0 1.5rem; line-height: 1.6; }
+.auth-stack { display: grid; gap: 1rem; }
+.auth-card label, .account-settings label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: .4rem; }
+.auth-card input, .account-settings input { display: block; width: 100%; min-height: 44px; border: 1px solid #9ca3af; border-radius: 4px; padding: .6rem .75rem; background: white; font-size: 1rem; }
+.auth-button { display: inline-flex; justify-content: center; align-items: center; gap: .5rem; min-height: 44px; padding: .65rem 1rem; background: #111827; color: white; border: 1px solid #111827; border-radius: 4px; font-size: .85rem; font-weight: 600; text-align: center; cursor: pointer; }
+.auth-card .auth-button { width: 100%; }
+.auth-button.secondary { background: white; color: #111827; border-color: #9ca3af; }
+.auth-button:hover { background: #374151; color: white; }
+.auth-button.secondary:hover { background: #f3f4f6; color: #111827; }
+.auth-button:disabled, button:disabled.auth-text-link { opacity: .5; cursor: not-allowed; }
+.auth-card :focus-visible, .account-settings :focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
+.auth-help { font-size: .8rem; line-height: 1.6; color: #4b5563; margin-top: .4rem; }
+.auth-divider { display: flex; align-items: center; gap: .75rem; margin-block: 1.5rem; color: #6b7280; font-size: .75rem; }
+.auth-divider::before, .auth-divider::after { content: ''; height: 1px; background: #d1d5db; flex: 1; }
+.auth-error, .auth-success { padding: .85rem; border-radius: 4px; font-size: .85rem; margin-block: 1rem; line-height: 1.6; }
+.auth-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
+.auth-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
+.auth-footer { border-top: 1px solid #e5e7eb; margin-top: 1.5rem; padding-top: 1.5rem; text-align: center; font-size: .85rem; }
+.auth-footer a, .auth-text-link { text-decoration: underline; text-underline-offset: 3px; font-weight: 600; cursor: pointer; font-size: .85rem; }
+button.auth-text-link { min-height: 44px; }
+.auth-text-link { text-align: center; }
+.auth-text-link.danger { color: #991b1b; }
+.passkey-promotion { background: #f9fafb; border: 1px solid #e5e7eb; padding: 1rem; border-radius: 4px; }
+.passkey-promotion .auth-button { margin-top: 1rem; }
+.settings-panel, .verification-panel { border: 1px solid #d1d5db; border-radius: 6px; padding: 1.5rem; margin-block: 1.5rem; min-width: 0; }
+.verification-panel { border-color: #6b7280; background: #f9fafb; }
+.settings-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
+.settings-heading .auth-button { flex-shrink: 0; }
+.passkey-empty { border-block: 1px dashed #d1d5db; padding-block: 2rem; margin-block: 1.5rem; text-align: center; }
+.passkey-empty h3, .passkey-info h3 { font-size: .9rem; font-weight: 600; overflow-wrap: anywhere; }
+.passkey-list > li { border-bottom: 1px solid #e5e7eb; padding-block: 1.25rem; }
+.passkey-row { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; }
+.passkey-info { flex: 1; min-width: 150px; }
+.passkey-actions { display: flex; gap: 1rem; }
+.passkey-icon { display: grid; place-items: center; width: 36px; height: 36px; font-size: 1.5rem; background: #f3f4f6; border-radius: 6px; }
+.rename-form { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; align-items: center; }
+.rename-form input { flex: 1; min-width: 150px; }
+@media (max-width: 480px) {
+  .auth-card { padding: 1.25rem; }
+  .settings-panel, .verification-panel { padding: 1rem; }
+  .passkey-actions { width: 100%; justify-content: flex-end; }
+}
