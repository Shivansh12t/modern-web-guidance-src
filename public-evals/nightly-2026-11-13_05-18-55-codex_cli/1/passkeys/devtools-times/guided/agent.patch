+// The auth service owns sessions, challenges, credential storage and verification.
+export const AUTH_API = (import.meta.env.PUBLIC_AUTH_API_URL || 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api').replace(/\/$/, '');
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) { super(message); }
+}
+
+export async function authRequest<T>(path: string, body?: unknown, method = 'POST', signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${AUTH_API}${path}`, {
+    method, credentials: 'include', cache: 'no-store', signal,
+    headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json().catch(() => null);
+  if (!response.ok) {
+    throw new ApiError(typeof data?.error === 'string' ? data.error : 'The request could not be completed. Please try again.', response.status, typeof data?.code === 'string' ? data.code : undefined);
+  }
+  return data as T;
+}
+
+export interface PasskeyRecord {
+  id: string;
+  name: string;
+  providerName?: string;
+  providerIcon?: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+export interface Account {
+  name: string;
+  displayName: string;
+  hasPassword: boolean;
+}
+export interface PasskeyList {
+  rpId: string;
+  userId: string;
+  credentials: PasskeyRecord[];
+}
