+import { authRequest } from '../lib/auth-client';
+export default function AccountNav() {
+  const [signedIn, setSignedIn] = useState(false);
+  useEffect(() => { authRequest('session').then(data => setSignedIn(!!data.account)).catch(() => {}); }, []);
+  const base = import.meta.env.BASE_URL;
+  return signedIn ? <a className="header-account-link" href={`${base}account`}><UserCircleIcon />My account</a> : <div className="flex items-center gap-3"><a href={`${base}signup`} data-skip-tracking="true" className="header-signup">Sign up <span>↗</span></a><a href={`${base}signin`} data-skip-tracking="true" className="header-signin">Sign in</a></div>;
+}
