+++ b/src/lib/auth-client.ts
@@ -0,0 +1,35 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+export type Account = { username: string; passkeys: { id: string; name: string; createdAt: string; lastUsedAt?: string }[] };
+export class AuthError extends Error {
+  constructor(message: string, public code?: string) { super(message); }
+}
+export async function authRequest(action: string, body?: unknown) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${action}`, {
+    method: action === 'session' ? 'GET' : 'POST', headers: { 'Content-Type': 'application/json' },
+    ...(action === 'session' ? {} : { body: JSON.stringify(body || {}) }), credentials: 'same-origin',
+  });
+  const data = await response.json();
+  if (!response.ok) throw new AuthError(data.error || 'Something went wrong. Please try again.', data.code);
+  return data;
+}
+export function supportsPasskeys() { return window.isSecureContext && browserSupportsWebAuthn(); }
+export async function authenticatePasskey(reauth = false) {
+  const action = reauth ? 'reauth' : 'login';
+  const optionsJSON = await authRequest(`${action}-options`);
+  const credential = await startAuthentication({ optionsJSON });
+  return authRequest(`${action}-verify`, { credential });
+}
+export async function registerPasskey(name: string) {
+  const optionsJSON = await authRequest('register-options');
+  const credential = await startRegistration({ optionsJSON });
+  return authRequest('register-verify', { credential, name });
+}
+export function authMessage(error: unknown): string {
+  if (error instanceof Error) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey for this account already exists on this device. Try another device or security key.';
+    if (error.name === 'SecurityError') return 'Passkeys require a secure connection. Please use HTTPS or localhost.';
+    return error.message;
+  }
+  return 'Something went wrong. Please try again.';
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..fa77494
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,42 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import type { WebAuthnCredential } from '@simplewebauthn/server';
+
+export type Passkey = Omit<WebAuthnCredential, 'publicKey'> & {
+  publicKey: string; name: string; createdAt: string; lastUsedAt?: string;
+};
+export type Account = { id: string; username: string; passkeys: Passkey[] };
+export type AuthSession = {
+  userId?: string; expires: number; verifiedAt?: number;
+  challenge?: { value: string; purpose: 'register' | 'login' | 'reauth'; expires: number };
+};
+type Store = { accounts: Account[]; sessions: Record<string, AuthSession> };
+const directory = resolve(process.env.AUTH_DATA_DIR || '.data');
+let queue: Promise<unknown> = Promise.resolve();
+
+// Serialize read/modify/write operations and atomically replace the store.
+// Deploy a single instance with a persistent volume, or replace with a shared database.
+export function withAuthStore<T>(operation: (store: Store) => Promise<T>): Promise<T> {
+  const result = queue.then(async () => {
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    let store: Store;
+    try { store = JSON.parse(await readFile(resolve(directory, 'auth.json'), 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      store = { accounts: [], sessions: {} };
+    }
+    for (const [id, session] of Object.entries(store.sessions)) {
+      if (session.expires < Date.now()) delete store.sessions[id];
+    }
+    try {
+      return await operation(store);
+    } finally {
+      // Persist consumed challenges even if verification rejects a response.
+      const temporary = resolve(directory, 'auth.json.tmp');
+      await writeFile(temporary, JSON.stringify(store), { mode: 0o600 });
+      await rename(temporary, resolve(directory, 'auth.json'));
+    }
+  });
+  queue = result.catch(() => {});
+  return result;
+}
