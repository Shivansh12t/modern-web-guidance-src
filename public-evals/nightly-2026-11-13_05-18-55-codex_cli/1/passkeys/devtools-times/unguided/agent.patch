index 0000000..b5a00d1
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,116 @@
+import type { APIRoute } from 'astro';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { withAuthStore, type AuthSession } from '../../../lib/auth-store';
+
+const remote = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+const failure = (error: string, status = 400) => Response.json({ error }, { status });
+
+export const ALL: APIRoute = async ({ request, cookies, params, url }) => {
+  const action = params.action;
+  const origin = process.env.AUTH_ORIGIN || url.origin;
+  if (request.method !== 'GET' && request.method !== 'POST') return failure('Method not allowed.', 405);
+  if (request.method === 'POST' && request.headers.get('origin') !== origin) return failure('Request origin is not allowed.', 403);
+  if (request.method === 'GET' && action !== 'session') return failure('Method not allowed.', 405);
+  try {
+    const body = request.method === 'POST' ? await request.json() : {};
+    const response = await withAuthStore(async (store) => {
+      let sessionId = cookies.get('times_auth')?.value || '';
+      let session: AuthSession | undefined = store.sessions[sessionId];
+      let account = store.accounts.find(a => a.id === session?.userId);
+      const setSession = (userId?: string) => {
+        if (sessionId) delete store.sessions[sessionId];
+        sessionId = randomBytes(32).toString('base64url');
+        session = { userId, expires: Date.now() + 7 * 86400000, verifiedAt: userId ? Date.now() : undefined };
+        store.sessions[sessionId] = session;
+        cookies.set('times_auth', sessionId, { httpOnly: true, sameSite: 'lax', secure: origin.startsWith('https:'), path: import.meta.env.BASE_URL, maxAge: 7 * 86400 });
+      };
+      const publicAccount = () => ({ username: account!.username, passkeys: account!.passkeys.map(({ publicKey, counter, transports, ...key }) => key) });
+      if (action === 'session') return Response.json({ account: account ? publicAccount() : null });
+      if (action === 'logout') {
+        delete store.sessions[sessionId];
+        cookies.delete('times_auth', { path: import.meta.env.BASE_URL });
+        return Response.json({ ok: true });
+      }
+      if (action === 'login' || action === 'signup' || action === 'password-reauth') {
+        const username = action === 'password-reauth' ? account?.username : body.username?.trim();
+        if (typeof username !== 'string' || !username || username.length > 100 || typeof body.password !== 'string' || body.password.length > 256) return failure('Enter your username and password.');
+        if (action === 'signup' && !/^(?=.*\d).{8,}$/.test(body.password)) return failure('Use at least 8 characters, including a number.');
+        const response = await fetch(`${remote}/${action === 'signup' ? 'register' : 'login'}`, {
+          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password: body.password }), signal: AbortSignal.timeout(15000),
+        });
+        if (!response.ok) return failure(action === 'signup' ? 'Could not create your account. Try another username.' : 'Your username or password is incorrect. Please try again.', 401);
+        if (action === 'password-reauth') {
+          if (!session || !account) return failure('Please sign in again.', 401);
+          session.verifiedAt = Date.now();
+          return Response.json({ ok: true });
+        }
+        account = store.accounts.find(a => a.username === username);
+        if (!account) {
+          account = { id: randomUUID(), username, passkeys: [] };
+          store.accounts.push(account);
+        }
+        setSession(account.id);
+        return Response.json({ account: publicAccount() });
+      }
+      if (action === 'login-options' || action === 'reauth-options') {
+        if (action === 'reauth-options' && !account) return failure('Please sign in again.', 401);
+        if (!session) setSession();
+        const options = await generateAuthenticationOptions({ rpID: new URL(origin).hostname, userVerification: 'required', ...(action === 'reauth-options' ? { allowCredentials: account!.passkeys.map(k => ({ id: k.id, transports: k.transports })) } : {}) });
+        session!.challenge = { value: options.challenge, purpose: action === 'login-options' ? 'login' : 'reauth', expires: Date.now() + 300000 };
+        return Response.json(options);
+      }
+      if (action === 'login-verify' || action === 'reauth-verify') {
+        const challenge = session?.challenge;
+        if (session) delete session.challenge;
+        const purpose = action === 'login-verify' ? 'login' : 'reauth';
+        if (!challenge || challenge.purpose !== purpose || challenge.expires < Date.now()) return failure('This request expired. Please try again.');
+        const owner = store.accounts.find(a => a.passkeys.some(k => k.id === body.credential?.id));
+        const key = owner?.passkeys.find(k => k.id === body.credential?.id);
+        if (!owner || !key || (purpose === 'reauth' && owner.id !== account?.id)) return failure('This passkey does not belong to your account.', 401);
+        const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: challenge.value, expectedOrigin: origin, expectedRPID: new URL(origin).hostname, requireUserVerification: true, credential: { ...key, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')) } });
+        if (!result.verified) return failure('Passkey verification failed.', 401);
+        key.counter = result.authenticationInfo.newCounter;
+        key.lastUsedAt = new Date().toISOString();
+        account = owner;
+        setSession(owner.id);
+        return Response.json({ account: publicAccount() });
+      }
+      if (!account || !session) return failure('Please sign in to manage your account.', 401);
+      if (!session.verifiedAt || Date.now() - session.verifiedAt > 300000) return Response.json({ error: 'Confirm it’s you before changing your passkeys.', code: 'REAUTH_REQUIRED' }, { status: 403 });
+      if (action === 'register-options') {
+        if (account.passkeys.length >= 10) return failure('You can save up to 10 passkeys. Remove one to add another.');
+        const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID: new URL(origin).hostname, userName: account.username, userID: new TextEncoder().encode(account.id), attestationType: 'none', authenticatorSelection: { residentKey: 'required', userVerification: 'required' }, excludeCredentials: account.passkeys.map(k => ({ id: k.id, transports: k.transports })) });
+        session.challenge = { value: options.challenge, purpose: 'register', expires: Date.now() + 300000 };
+        return Response.json(options);
+      }
+      if (action === 'register-verify') {
+        const challenge = session.challenge;
+        delete session.challenge;
+        if (!challenge || challenge.purpose !== 'register' || challenge.expires < Date.now()) return failure('This request expired. Please try again.');
+        const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: challenge.value, expectedOrigin: origin, expectedRPID: new URL(origin).hostname, requireUserVerification: true });
+        if (!result.verified || !result.registrationInfo) return failure('Passkey verification failed.');
+        const credential = result.registrationInfo.credential;
+        if (store.accounts.some(a => a.passkeys.some(k => k.id === credential.id))) return failure('This passkey is already registered.');
+        const name = typeof body.name === 'string' ? body.name.trim().slice(0, 60) : '';
+        account.passkeys.push({ ...credential, publicKey: Buffer.from(credential.publicKey).toString('base64url'), name: name || 'My passkey', createdAt: new Date().toISOString() });
+        return Response.json({ account: publicAccount() });
+      }
+      if (action === 'rename' || action === 'remove') {
+        const key = account.passkeys.find(k => k.id === body.id);
+        if (!key) return failure('Passkey not found.', 404);
+        if (action === 'rename') {
+          if (typeof body.name !== 'string' || !body.name.trim() || body.name.length > 60) return failure('Enter a name of up to 60 characters.');
+          key.name = body.name.trim();
+        } else account.passkeys = account.passkeys.filter(k => k.id !== body.id);
+        return Response.json({ account: publicAccount() });
+      }
+      return failure('Unknown action.', 404);
+    });
+    response.headers.set('Cache-Control', 'no-store');
+    return response;
+  } catch (error) {
+    console.error('Authentication request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return failure('We couldn’t complete that request. Please try again.', 400);
+  }
+};
