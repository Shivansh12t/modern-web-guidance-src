+import { useEffect, useState, type FormEvent } from 'react';
+import { FingerPrintIcon, ArrowRightIcon, ShieldCheckIcon, KeyIcon, CheckIcon, ArrowUpRightIcon } from '@heroicons/react/24/outline';
+import { authenticatePasskey, authRequest, authMessage, registerPasskey, supportsPasskeys } from '../lib/auth-client';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState('');
+  const [error, setError] = useState('');
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [created, setCreated] = useState(false);
+  const [enrolled, setEnrolled] = useState(false);
+  const base = import.meta.env.BASE_URL;
+  useEffect(() => { setSupported(supportsPasskeys()); }, []);
+  async function submit(event: FormEvent) {
+    event.preventDefault(); setBusy('password'); setError('');
+    try {
+      await authRequest(signup ? 'signup' : 'login', { username, password });
+      setPassword('');
+      if (signup) setCreated(true); else window.location.assign(`${base}account`);
+    } catch (error) { setError(authMessage(error)); } finally { setBusy(''); }
+  }
+  async function passkey() {
+    setBusy('passkey'); setError('');
+    try {
+      if (created) { await registerPasskey('My first passkey'); setEnrolled(true); }
+      else { await authenticatePasskey(); window.location.assign(`${base}account`); }
+    } catch (error) { setError(authMessage(error)); } finally { setBusy(''); }
+  }
+  return <div className="auth-shell">
+    <section className="auth-story">
+      <div className="eyebrow"><span className="small-rule" /> INDEPENDENT MINDS. INFORMED READERS.</div>
+      <div className="auth-story-main">
+        <div className="story-edition">THE READER’S EDITION</div>
+        <h1>A better way<br />to stay<br /><em>in the know.</em></h1>
+        <p>The stories that matter. The perspectives that move you. Your world, a little clearer.</p>
+        <div className="story-benefits">
+          <div><CheckIcon /> Save the stories you want to come back to</div>
+          <div><CheckIcon /> Make room for a wider perspective</div>
+          <div><CheckIcon /> One account. A world of discovery.</div>
+        </div>
+      </div>
+      <div className="story-footer"><span>THE DEVTOOLS TIMES</span><span>Stay curious. Stay informed. <ArrowUpRightIcon /></span></div>
+    </section>
+    <section className="auth-form-panel">
+      <a className="back-link" href={base}>← Back to the Times</a>
+      <div className="auth-form-content">
+        <div className="eyebrow muted">YOUR DAILY DOSE OF PERSPECTIVE</div>
+        <h2>{created ? (enrolled ? 'You’re all set.' : 'One less password.') : signup ? 'Join the conversation.' : 'Welcome back.'}</h2>
+        <p className="auth-intro">{created ? (enrolled ? 'Your passkey is ready. A simpler, safer sign-in starts now.' : 'Your account is ready. Add a passkey for a faster, more secure way to sign in next time.') : signup ? 'Create your free account and make the Times yours.' : 'Sign in to your DevTools Times account.'}</p>
+        {error && <div className="auth-notice error" role="alert">{error}</div>}
+        {created ? <div className="signup-complete">
+          <div className={`passkey-orb ${enrolled ? 'complete' : ''}`}>{enrolled ? <CheckIcon /> : <FingerPrintIcon />}</div>
+          <h3>{enrolled ? 'Passkey created' : 'Your fingerprint. Your face. Your key.'}</h3>
+          <p>Use your device’s screen lock to sign in. Your biometric information stays on your device.</p>
+          {!enrolled && <button className="auth-primary" onClick={passkey} disabled={!!busy || supported !== true}><FingerPrintIcon />{busy ? 'Creating your passkey…' : 'Create a passkey'}<ArrowRightIcon /></button>}
+          {supported === false && <p className="auth-notice">Passkeys aren’t available in this browser. You can add one later on a supported device.</p>}
+          <a className={enrolled ? 'auth-primary' : 'auth-text-link'} href={`${base}account`}>{enrolled ? 'Go to your account' : 'I’ll do this later'}{enrolled && <ArrowRightIcon />}</a>
+        </div> : <>
+          {!signup && <>
+            <button className="auth-passkey" onClick={passkey} disabled={!!busy || supported !== true}><FingerPrintIcon />{busy === 'passkey' ? 'Waiting for your passkey…' : 'Sign in with a passkey'}<ArrowRightIcon /></button>
+            <p className="passkey-helper">Your face, fingerprint, or device PIN. No password needed.</p>
+            {supported === false && <p className="auth-notice">Passkeys aren’t available here. Use your password below.</p>}
+            <div className="auth-divider"><span>or continue with your password</span></div>
+          </>}
+          <form onSubmit={submit} className="auth-fields">
+            <div><label htmlFor="username">Username</label><input id="username" name="username" autoComplete="username" placeholder="Enter your username" value={username} onChange={e => setUsername(e.target.value)} maxLength={100} required disabled={!!busy} /></div>
+            <div><label htmlFor="password">Password</label><input id="password" name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} placeholder={signup ? 'Create a strong password' : 'Enter your password'} value={password} onChange={e => setPassword(e.target.value)} required minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} disabled={!!busy} />{signup && <p className="field-help">At least 8 characters, including a number.</p>}</div>
+            {signup && <div className="signup-passkey-note"><KeyIcon /><p><strong>A simpler sign-in is next.</strong><br />Add a passkey after creating your account.</p></div>}
+            <button className="auth-primary" type="submit" disabled={!!busy} data-skip-tracking="true">{busy === 'password' ? (signup ? 'Creating your account…' : 'Signing in…') : signup ? 'Create account' : 'Sign in'}<ArrowRightIcon /></button>
+          </form>
+          {signup && <p className="auth-terms">By creating an account, you agree to our <a href={`${base}legal/terms`}>Terms of Service</a> and <a href={`${base}legal/privacy`}>Privacy Policy</a>.</p>}
+          <div className="auth-switch">{signup ? 'Already a reader?' : 'New to the Times?'} <a href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'} <span>↗</span></a></div>
+        </>}
+        <div className="auth-trust"><ShieldCheckIcon /><span>Your perspective is personal. So is your account.</span></div>
+      </div>
+      <div className="auth-panel-footer"><span>Good journalism. A little closer.</span><span>EST. 2025</span></div>
+    </section>
+  </div>;
+}
