+.auth-story { background: #193f35; color: #fff; padding: 34px 36px 24px; display: flex; flex-direction: column; position: relative; overflow: hidden; }
+.auth-story::after { content: ''; width: 340px; height: 340px; border: 1px solid #ffffff0b; border-radius: 50%; position: absolute; bottom: -190px; right: -120px; box-shadow: 0 0 0 35px #ffffff04, 0 0 0 70px #ffffff03; pointer-events: none; }
+.eyebrow { font: 600 9px/1.6 Arial, sans-serif; letter-spacing: 1.7px; display: flex; align-items: center; gap: 9px; }
+.small-rule { display: inline-block; height: 1px; width: 22px; background: currentColor; }
+.auth-story > .eyebrow { color: #c5d4b7; font-size: 8px; letter-spacing: 1.25px; }
+.auth-story-main { margin: auto 0; padding: 55px 0 45px; }
+.story-edition { font-size: 9px; letter-spacing: 2.2px; color: #b7c9bd; margin-bottom: 22px; }
+.auth-story h1 { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-size: clamp(44px, 4.4vw, 62px); line-height: 1.08; letter-spacing: -2px; margin: 0 0 24px; }
+.auth-story h1 em { color: #d6dfbd; font-weight: 400; }
+.auth-story-main > p { max-width: 300px; font-size: 13px; line-height: 1.9; color: #c2cfc6; }
+.story-benefits { display: grid; gap: 14px; margin-top: 32px; font-size: 11px; color: #e1e7df; }
+.story-benefits div { display: flex; align-items: center; gap: 10px; }
+.story-benefits svg { color: #b9cba9; width: 15px; height: 15px; }
+.story-footer { display: flex; flex-direction: column; gap: 9px; border-top: 1px solid #ffffff25; padding-top: 19px; }
+.story-footer > span:first-child { font-family: Georgia, serif; font-size: 12px; letter-spacing: 1px; }
+.story-footer > span:last-child { color: #adbdaf; display: flex; align-items: center; justify-content: space-between; font-size: 10px; }
