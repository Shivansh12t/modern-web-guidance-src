+        {tab === 'profile' ? <div className="settings-card"><div className="settings-card-heading"><UserCircleIcon /><div><h3>Your reader profile</h3><p>Your identity at The DevTools Times.</p></div></div><div className="profile-detail"><span>Username</span><strong>{account.username}</strong></div><a className="auth-text-link" href={base}>Explore the latest stories <ArrowUpRightIcon /></a></div> : <>
