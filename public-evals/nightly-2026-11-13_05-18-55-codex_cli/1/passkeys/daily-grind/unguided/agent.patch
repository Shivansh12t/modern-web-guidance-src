diff --git a/tests/webauthn.test.cjs b/tests/webauthn.test.cjs
new file mode 100644
index 0000000..565e81a
--- /dev/null
+++ b/tests/webauthn.test.cjs
@@ -0,0 +1,51 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { webcrypto } = require('node:crypto');
+const fs = require('node:fs');
+const vm = require('node:vm');
+// Exercise the production crypto helpers without a browser or a running server.
+const source = fs.readFileSync('app.js', 'utf8');
+const helpers = source.slice(source.indexOf('const b64 ='), source.indexOf('function authDialog('));
+const context = vm.createContext({ crypto: webcrypto, TextEncoder, TextDecoder, Uint8Array, DOMException, btoa, atob, location: { hostname: 'localhost', origin: 'https://localhost' }, window: { isSecureContext: true, PublicKeyCredential: true }, navigator: { credentials: {} } });
+vm.runInContext(helpers, context);
+context.assert = assert;
+
+test('accepts a matching client challenge and rejects origin, challenge, type, and cross-origin mismatches', () => {
+ vm.runInContext(`
+ const challenge = random();
+ const client = {type:'webauthn.get',challenge:b64(challenge),origin:location.origin};
+ const credential = obj => ({response:{clientDataJSON:new TextEncoder().encode(JSON.stringify(obj))}});
+ validateClient(credential(client),challenge,'webauthn.get');
+ for(const change of [{origin:'https://attacker.example'},{challenge:b64(random())},{type:'webauthn.create'},{crossOrigin:true}]) {
+   assert.throws(()=>validateClient(credential({...client,...change}),challenge,'webauthn.get'));
+ }
+ `,context);
+});
+
+test('requires the correct relying party, user presence, and user verification', async () => {
+ await vm.runInContext(`(async()=>{
+ const data=new Uint8Array(37);
+ data.set(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(location.hostname))));
+ data[32]=5;await validateAuthData(data);
+ for(const flags of [0,1,4]){data[32]=flags;await assert.rejects(()=>validateAuthData(data));}
+ data[32]=5;data[0]^=1;await assert.rejects(()=>validateAuthData(data));
+ await assert.rejects(()=>validateAuthData(new Uint8Array(4)));
+ })()`,context);
+});
+
+test('converts a DER signature and verifies it, rejecting a changed challenge', async () => {
+ await vm.runInContext(`(async()=>{
+ const pair=await crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']);
+ const data=random();
+ const sig=new Uint8Array(await crypto.subtle.sign({name:'ECDSA',hash:'SHA-256'},pair.privateKey,data));
+ const parts=[sig.slice(0,32),sig.slice(32)].map(part=>{while(part.length>1&&part[0]===0)part=part.slice(1);return part[0]&128?[0,...part]:[...part];});
+ const content=[2,parts[0].length,...parts[0],2,parts[1].length,...parts[1]];
+ const der=new Uint8Array([48,content.length,...content]);
+ const raw=rawSignature(der);
+ assert.equal(b64(raw),b64(sig));
+ assert.equal(await crypto.subtle.verify({name:'ECDSA',hash:'SHA-256'},pair.publicKey,raw,data),true);
+ data[0]^=1;
+ assert.equal(await crypto.subtle.verify({name:'ECDSA',hash:'SHA-256'},pair.publicKey,raw,data),false);
+ assert.throws(()=>rawSignature(new Uint8Array([0,0])));
+ })()`,context);
+});
