+  <script>
+    (() => {
+      let activePreview = null;
+
+      document.querySelectorAll('.drink-preview').forEach((component) => {
+        const trigger = component.querySelector('.preview-trigger');
+        const panel = component.querySelector('.hovercard');
+        let closeTimer;
+
+        const position = () => {
+          const anchor = trigger.getBoundingClientRect();
+          const gap = 10;
+          const margin = 12;
+          const width = panel.offsetWidth;
+          const height = panel.offsetHeight;
+          const left = Math.max(margin, Math.min(
+            anchor.left + (anchor.width - width) / 2,
+            window.innerWidth - width - margin
+          ));
+          const below = window.innerHeight - anchor.bottom - gap - margin;
+          const top = below >= height || below >= anchor.top - gap - margin
+            ? anchor.bottom + gap
+            : anchor.top - height - gap;
+          panel.style.left = `${left}px`;
+          panel.style.top = `${Math.max(margin, Math.min(top, window.innerHeight - height - margin))}px`;
+        };
+
+        const close = () => {
+          clearTimeout(closeTimer);
+          panel.hidden = true;
+          trigger.setAttribute('aria-expanded', 'false');
+          if (activePreview?.panel === panel) activePreview = null;
+        };
+
+        const open = () => {
+          clearTimeout(closeTimer);
+          if (activePreview?.panel !== panel) activePreview?.close();
+          panel.hidden = false;
+          trigger.setAttribute('aria-expanded', 'true');
+          activePreview = { panel, component, trigger, close, position };
+          position();
+        };
+
+        const scheduleClose = () => {
+          clearTimeout(closeTimer);
+          // Allow the pointer to cross the gap and enter the interactive preview.
+          closeTimer = setTimeout(() => {
+            if (!component.matches(':hover') && !component.contains(document.activeElement)) close();
+          }, 200);
+        };
+
+        component.addEventListener('pointerenter', (event) => {
+          if (event.pointerType !== 'touch') open();
+        });
+        component.addEventListener('pointerleave', scheduleClose);
+        component.addEventListener('focusin', open);
+        component.addEventListener('focusout', scheduleClose);
+        panel.querySelector('.preview-close').addEventListener('click', () => {
+          trigger.focus();
+          close();
+        });
+      });
+
+      document.addEventListener('keydown', (event) => {
+        if (event.key !== 'Escape' || !activePreview) return;
+        const { component, trigger, close } = activePreview;
+        if (component.contains(document.activeElement)) trigger.focus();
+        close();
+        event.preventDefault();
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (activePreview && !activePreview.component.contains(event.target)) activePreview.close();
+      });
+      window.addEventListener('resize', () => activePreview?.position());
+      window.addEventListener('scroll', () => activePreview?.position(), true);
+    })();
+  </script>
