+  <script type="module">
+    // Wire descriptions before the polyfill loads, including for browse-mode AT.
+    function setupDrinkPreviews() {
+      document.querySelectorAll('a[interestfor]').forEach((link) => {
+        const preview = document.getElementById(link.getAttribute('interestfor'));
+        if (!preview || preview.getAttribute('popover') !== 'hint') return;
+        if (!preview.hasAttribute('role')) preview.setAttribute('role', 'tooltip');
+        if (!link.hasAttribute('aria-describedby')) {
+          link.setAttribute('aria-describedby', preview.id);
+        }
+        // Explicit anchors also work when the interest invoker is polyfilled.
+        const anchor = `--${preview.id}`;
+        link.style.setProperty('anchor-name', anchor);
+        preview.style.setProperty('position-anchor', anchor);
+      });
+    }
+
+    setupDrinkPreviews();
+
+    // Keep compatibility code local and load it only where required.
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('./vendor/popover-polyfill/popover.min.js');
+    }
+    if (!('interestForElement' in HTMLButtonElement.prototype)) {
+      await import('./vendor/interestfor/interestfor.min.js');
+    }
+  </script>
