+    /* Supplemental drink previews; links still navigate normally. */
+    [interestfor] {
+      --interest-delay-start: 0.3s;
+      --interest-delay-end: 0.3s;
+      interest-delay-start: var(--interest-delay-start);
+      interest-delay-end: var(--interest-delay-end);
+    }
+
+    a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    [popover].drink-preview {
+      display: none;
+      width: min(340px, calc(100vw - 32px));
+      max-height: calc(100dvh - 32px);
+      overflow: auto;
+      padding: 24px;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 10px;
+      background: #fffdf9;
+      color: var(--text);
+      box-shadow: 0 12px 36px rgb(62 39 35 / 20%);
+      text-align: left;
+      opacity: 0;
+    }
+
+    [popover].drink-preview:is(:popover-open, .\:popover-open) {
+      display: block;
+      opacity: 1;
+    }
+
+    /* Without anchor positioning, retain the popover's centered placement. */
+    @supports (position-area: block-end) {
+      [popover].drink-preview {
+        inset: auto;
+        margin: 8px 0;
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    .drink-preview .preview-category {
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    .drink-preview h4 {
+      margin: 4px 0 8px;
+      font-size: 1.25rem;
+      line-height: 1.3;
+    }
+
+    .drink-preview dl {
+      display: grid;
+      grid-template-columns: auto 1fr;
+      gap: 6px 16px;
+      margin-top: 16px;
+      padding-top: 12px;
+      border-top: 1px solid var(--secondary);
+      font-size: 0.9rem;
+    }
+
+    .drink-preview dt {
+      font-weight: 600;
+    }
+
+    .drink-preview .btn {
+      font-size: 0.9rem;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover].drink-preview {
+        transition: opacity 0.15s, display 0.15s, overlay 0.15s;
+        transition-behavior: allow-discrete;
+      }
+
+      @starting-style {
+        [popover].drink-preview:is(:popover-open, .\:popover-open) {
+          opacity: 0;
+        }
+      }
+    }
+
