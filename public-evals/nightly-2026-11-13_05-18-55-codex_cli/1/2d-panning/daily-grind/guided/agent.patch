+  <script>
+    const map = document.getElementById('cafe-map');
+    const nativeFreePan = CSS.supports('scroll-axis-lock', 'none');
+    const recenterMap = () => {
+      map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+      map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+    };
+    document.getElementById('map-reset').addEventListener('click', recenterMap);
+    recenterMap();
+
+    if (!nativeFreePan) {
+      map.classList.add('has-pan-fallback');
+      map.addEventListener('wheel', (event) => {
+        // Leave browser zoom gestures intact; normalize line/page wheel units.
+        if (event.ctrlKey) return;
+        event.preventDefault();
+        const unitX = event.deltaMode === 1 ? 20 : event.deltaMode === 2 ? map.clientWidth : 1;
+        const unitY = event.deltaMode === 1 ? 20 : event.deltaMode === 2 ? map.clientHeight : 1;
+        if (event.shiftKey && event.deltaX === 0) {
+          map.scrollLeft += event.deltaY * unitX;
+        } else {
+          map.scrollLeft += event.deltaX * unitX;
+          map.scrollTop += event.deltaY * unitY;
+        }
+      }, { passive: false });
+    }
+
+    // Mouse dragging complements native touch scrolling. Unsupported browsers
+    // also use these raw pointer deltas for unrestricted touch and pen panning.
+    let drag = null;
+    map.addEventListener('pointerdown', (event) => {
+      if (nativeFreePan && event.pointerType !== 'mouse') return;
+      if (!event.isPrimary || event.button !== 0 || drag) return;
+      const bounds = map.getBoundingClientRect();
+      const x = event.clientX - bounds.left - map.clientLeft;
+      const y = event.clientY - bounds.top - map.clientTop;
+      // Keep native scrollbar controls available.
+      if (x < 0 || y < 0 || x >= map.clientWidth || y >= map.clientHeight) return;
+      if (event.pointerType === 'mouse') event.preventDefault();
+      map.focus({ preventScroll: true });
+      drag = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      map.setPointerCapture(event.pointerId);
+      map.classList.add('is-panning');
+    });
+    map.addEventListener('pointermove', (event) => {
+      if (!drag || drag.id !== event.pointerId) return;
+      map.scrollLeft -= event.clientX - drag.x;
+      map.scrollTop -= event.clientY - drag.y;
+      drag.x = event.clientX;
+      drag.y = event.clientY;
+    });
+    const stopPan = (event) => {
+      if (!drag || drag.id !== event.pointerId) return;
+      drag = null;
+      map.classList.remove('is-panning');
+      if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
+    };
+    map.addEventListener('pointerup', stopPan);
+    map.addEventListener('pointercancel', stopPan);
+    map.addEventListener('lostpointercapture', stopPan);
+  </script>
