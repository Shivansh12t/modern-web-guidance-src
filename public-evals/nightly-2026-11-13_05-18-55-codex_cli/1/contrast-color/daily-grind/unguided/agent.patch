+  <script>
+    // Older browsers need a fallback for CSS contrast-color().
+    if (!CSS.supports('color', 'contrast-color(red)')) {
+      const root = document.documentElement;
+      const canvas = document.createElement('canvas');
+      canvas.width = canvas.height = 1;
+      const context = canvas.getContext('2d', { willReadFrequently: true });
+      const probe = document.createElement('span');
+      probe.style.cssText = 'position:fixed;visibility:hidden;pointer-events:none';
+      document.body.append(probe);
+
+      function contrastingText(color) {
+        context.fillStyle = '#fff';
+        context.fillRect(0, 0, 1, 1);
+        // Composite transparent theme colors over the page background.
+        context.fillStyle = getComputedStyle(root).backgroundColor;
+        context.fillRect(0, 0, 1, 1);
+        context.fillStyle = getComputedStyle(document.body || root).backgroundColor;
+        context.fillRect(0, 0, 1, 1);
+        context.fillStyle = color;
+        context.fillRect(0, 0, 1, 1);
+        const channels = [...context.getImageData(0, 0, 1, 1).data].slice(0, 3);
+        const [r, g, b] = channels.map(channel => {
+          const value = channel / 255;
+          return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+        });
+        const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+        return (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05) ? '#000' : '#fff';
+      }
+
+      function updateContrast() {
+        for (const name of ['primary', 'secondary']) {
+          probe.style.color = `var(--${name})`;
+          const foreground = contrastingText(getComputedStyle(probe).color);
+          if (root.style.getPropertyValue(`--on-${name}`) !== foreground) {
+            root.style.setProperty(`--on-${name}`, foreground);
+          }
+        }
+      }
+
+      // Observe inline themes, class changes, and edited or replaced stylesheets.
+      new MutationObserver(records => {
+        if (records.some(record => record.target !== probe)) updateContrast();
+      }).observe(root, { subtree: true, attributes: true, childList: true, characterData: true });
+      document.addEventListener('load', updateContrast, true);
+      document.addEventListener('DOMContentLoaded', updateContrast);
+      window.addEventListener('resize', updateContrast);
+      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateContrast);
+      updateContrast();
+    }
+  </script>
+
