diff --git a/media.js b/media.js
new file mode 100644
index 0000000..11fc26d
--- /dev/null
+++ b/media.js
@@ -0,0 +1,56 @@
+(() => {
+  const players = document.querySelectorAll('[data-deferred-media]');
+
+  function loadMedia(media) {
+    if (!media.hasAttribute('data-deferred-media')) return;
+    // URLs stay in data attributes until intersection, including in browsers
+    // that ignore loading="lazy". Moving them here avoids preload-scanner races.
+    media.removeAttribute('data-deferred-media');
+    if (media.dataset.poster) {
+      media.poster = media.dataset.poster;
+      delete media.dataset.poster;
+    }
+    for (const source of media.querySelectorAll('source[data-src]')) {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    }
+    media.preload = media.dataset.preload || 'none';
+    delete media.dataset.preload;
+    media.load();
+  }
+
+  const observer = 'IntersectionObserver' in window
+    ? new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          loadMedia(entry.target);
+          observer.unobserve(entry.target);
+        }
+      }, { rootMargin: '200px 0px', threshold: 0 })
+    : null;
+
+  for (const media of players) {
+    observer?.observe(media);
+    // Interaction is also an escape hatch for browsers without an observer.
+    const activate = () => {
+      loadMedia(media);
+      observer?.unobserve(media);
+    };
+    media.addEventListener('focus', activate, { once: true });
+    media.addEventListener('pointerdown', activate, { once: true });
+  }
+
+  for (const media of document.querySelectorAll('video, audio')) {
+    media.addEventListener('error', () => {
+      const message = document.createElement('p');
+      message.className = 'media-error';
+      message.setAttribute('role', 'status');
+      message.textContent = 'This player could not load. ';
+      const link = document.createElement('a');
+      link.href = media.querySelector('source').src;
+      link.textContent = 'Open the media file';
+      message.append(link);
+      media.after(message);
+    }, { once: true });
+  }
+})();
