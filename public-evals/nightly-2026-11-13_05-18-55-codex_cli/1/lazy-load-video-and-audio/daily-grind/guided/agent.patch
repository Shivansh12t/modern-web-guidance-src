+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const script = readFileSync('media.js', 'utf8');
+const html = readFileSync('index.html', 'utf8');
+
+function setup(withObserver = true) {
+  const listeners = {};
+  const source = { dataset: { src: 'media/test.mp4' } };
+  let deferred = true;
+  let loads = 0;
+  let callback;
+  let options;
+  let observed;
+  let unobserved;
+  const media = {
+    dataset: { poster: 'media/test.webp', preload: 'metadata' },
+    preload: 'none',
+    hasAttribute: () => deferred,
+    removeAttribute: () => { deferred = false; },
+    querySelectorAll: () => [source],
+    addEventListener: (event, listener) => { listeners[event] = listener; },
+    load: () => { loads++; },
+  };
+  const window = {};
+  if (withObserver) window.IntersectionObserver = class {
+    constructor(cb, opts) { callback = cb; options = opts; }
+    observe(target) { observed = target; }
+    unobserve(target) { unobserved = target; }
+  };
+  runInNewContext(script, {
+    window,
+    IntersectionObserver: window.IntersectionObserver,
+    document: { querySelectorAll: () => [media] },
+  });
+  return {
+    media, source, listeners,
+    intersect: (visible) => callback([{ target: media, isIntersecting: visible }]),
+    get loads() { return loads; },
+    get options() { return options; },
+    get observed() { return observed; },
+    get unobserved() { return unobserved; },
+  };
+}
+
+test('offscreen markup exposes no poster or media URL to the preload scanner', () => {
+  const lazyPlayers = [...html.matchAll(/<(video|audio)\b([^>]*)>([\s\S]*?)<\/\1>/g)]
+    .filter(([, , attrs]) => attrs.includes('data-deferred-media'));
+  assert.equal(lazyPlayers.length, 2);
+  for (const [markup, tag, attrs, content] of lazyPlayers) {
+    assert.match(attrs, /loading="lazy"/);
+    assert.match(attrs, /preload="none"/);
+    assert.doesNotMatch(markup, /\s(?:src|poster)="/);
+    assert.match(content, /data-src="media\//);
+    assert.match(attrs, /\bcontrols\b/);
+    if (tag === 'video') {
+      assert.match(attrs, /width="\d+"/);
+      assert.match(attrs, /height="\d+"/);
+      assert.match(attrs, /data-poster="media\//);
+    }
+  }
+  const hero = html.match(/<video\b[\s\S]*?<\/video>/)[0];
+  assert.doesNotMatch(hero, /loading="lazy"|data-deferred-media/);
+  assert.match(hero, / poster="media\/hero-poster.webp"/);
+  assert.match(hero, / src="media\/hero.mp4"/);
+  assert.doesNotMatch(html, /rel="(?:preload|prefetch)"/);
+});
+
+test('downloads stay deferred until the player approaches the viewport, then activate once', () => {
+  const env = setup();
+  assert.equal(env.observed, env.media);
+  assert.equal(env.options.rootMargin, '200px 0px');
+  env.intersect(false);
+  assert.equal(env.loads, 0);
+  assert.equal(env.source.src, undefined);
+  assert.equal(env.media.poster, undefined);
+  assert.equal(env.media.preload, 'none');
+  env.intersect(true);
+  assert.equal(env.source.src, 'media/test.mp4');
+  assert.equal(env.media.poster, 'media/test.webp');
+  assert.equal(env.media.preload, 'metadata');
+  assert.equal(env.loads, 1);
+  assert.equal(env.unobserved, env.media);
+  env.intersect(true);
+  env.listeners.focus();
+  assert.equal(env.loads, 1);
+});
+
+test('without IntersectionObserver, focus or pointer interaction loads the player', () => {
+  for (const event of ['focus', 'pointerdown']) {
+    const env = setup(false);
+    assert.equal(env.loads, 0);
+    assert.equal(env.source.src, undefined);
+    env.listeners[event]();
+    assert.equal(env.loads, 1);
+    assert.equal(env.source.src, 'media/test.mp4');
+  }
+});
