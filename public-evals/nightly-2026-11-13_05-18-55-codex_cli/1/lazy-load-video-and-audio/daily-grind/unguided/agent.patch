diff --git a/media.js b/media.js
new file mode 100644
index 0000000..f8be713
--- /dev/null
+++ b/media.js
@@ -0,0 +1,60 @@
+(() => {
+  const players = [...document.querySelectorAll('[data-media]')];
+  const pending = new Set(players);
+  const margin = 200;
+  let observer;
+
+  function activate(player) {
+    if (!pending.delete(player)) return;
+    observer?.unobserve(player);
+
+    // Keep every fetching attribute out of the markup until this point.
+    player.querySelectorAll('[data-poster]').forEach((video) => {
+      video.poster = video.dataset.poster;
+      delete video.dataset.poster;
+    });
+    player.querySelectorAll('[data-src]').forEach((asset) => {
+      if (asset.matches('video, audio')) {
+        asset.addEventListener('error', () => {
+          player.querySelector('.media-status').textContent =
+            'This player is unavailable. Follow the credit link to watch or listen at the source.';
+        }, { once: true });
+        asset.preload = 'metadata';
+      }
+      asset.src = asset.dataset.src;
+      delete asset.dataset.src;
+      if (asset.matches('video, audio')) asset.load();
+    });
+  }
+
+  // Keyboard users can reach a player before the next visibility callback.
+  players.forEach((player) => {
+    player.addEventListener('focusin', () => activate(player), { once: true });
+  });
+
+  if ('IntersectionObserver' in window) {
+    observer = new IntersectionObserver((entries) => {
+      entries.forEach((entry) => {
+        if (entry.isIntersecting) activate(entry.target);
+      });
+    }, { rootMargin: `${margin}px 0px`, threshold: 0 });
+    players.forEach((player) => observer.observe(player));
+  } else {
+    // Preserve deferral in older browsers rather than eagerly loading all media.
+    const check = () => {
+      pending.forEach((player) => {
+        const bounds = player.getBoundingClientRect();
+        if (bounds.top <= window.innerHeight + margin && bounds.bottom >= -margin) {
+          activate(player);
+        }
+      });
+      if (!pending.size) {
+        window.removeEventListener('scroll', check);
+        window.removeEventListener('resize', check);
+      }
+    };
+    window.addEventListener('scroll', check, { passive: true });
+    window.addEventListener('resize', check);
+    check();
+  }
+})();
