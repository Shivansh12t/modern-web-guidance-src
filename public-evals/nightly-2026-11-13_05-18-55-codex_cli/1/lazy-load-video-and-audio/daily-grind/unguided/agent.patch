diff --git a/tests/media.test.cjs b/tests/media.test.cjs
new file mode 100644
index 0000000..c28bfbe
--- /dev/null
+++ b/tests/media.test.cjs
@@ -0,0 +1,93 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const code = fs.readFileSync('media.js', 'utf8');
+
+function setup(withObserver = true) {
+  let callback, options;
+  const events = {};
+  const makePlayer = (top) => {
+    const media = {
+      dataset: { src: 'clip.mp4', poster: 'poster.jpg' },
+      preload: 'none', loads: 0,
+      matches: () => true,
+      load() { this.loads++; },
+      addEventListener() {},
+    };
+    const art = { dataset: { src: 'cover.jpg' }, matches: () => false };
+    return {
+      media, art, top,
+      querySelectorAll: (selector) => selector === '[data-poster]' ? [media] : [media, art],
+      addEventListener(name, fn) { this[name] = fn; },
+      getBoundingClientRect() { return { top: this.top, bottom: this.top + 400 }; },
+    };
+  };
+  const players = [makePlayer(100), makePlayer(2000)];
+  const window = {
+    innerHeight: 800,
+    addEventListener(name, fn) { events[name] = fn; },
+    removeEventListener(name) { delete events[name]; },
+  };
+  class Observer {
+    constructor(fn, config) { callback = fn; options = config; }
+    observe() {}
+    unobserve() {}
+  }
+  if (withObserver) window.IntersectionObserver = Observer;
+  vm.runInNewContext(code, {
+    document: { querySelectorAll: () => players }, window,
+    ...(withObserver ? { IntersectionObserver: Observer } : {}),
+  });
+  return { players, callback, options, events };
+}
+
+test('markup has no fetching media or poster attributes before activation', () => {
+  const html = fs.readFileSync('index.html', 'utf8');
+  const tags = html.match(/<(?:video|audio|img|source)\b[^>]*>/g);
+  assert.equal(tags.length, 4);
+  tags.forEach((tag) => {
+    assert.doesNotMatch(tag, /\s(?:src|poster|srcset)\s*=/);
+    assert.match(tag, /data-src=/);
+    if (!tag.startsWith('<img')) assert.match(tag, /preload="none"/);
+  });
+  assert.doesNotMatch(html, /rel=["']preload["']/);
+});
+
+test('only approaching players receive posters, images and media data', () => {
+  const { players, callback, options } = setup();
+  assert.equal(options.rootMargin, '200px 0px');
+  players.forEach(({ media, art }) => {
+    assert.equal(media.src, undefined);
+    assert.equal(media.poster, undefined);
+    assert.equal(art.src, undefined);
+    assert.equal(media.loads, 0);
+  });
+  callback([{ target: players[1], isIntersecting: false }]);
+  assert.equal(players[1].media.src, undefined);
+  callback([{ target: players[0], isIntersecting: true }]);
+  assert.equal(players[0].media.src, 'clip.mp4');
+  assert.equal(players[0].media.poster, 'poster.jpg');
+  assert.equal(players[0].art.src, 'cover.jpg');
+  assert.equal(players[0].media.preload, 'metadata');
+  assert.equal(players[1].media.src, undefined);
+  callback([{ target: players[0], isIntersecting: true }]);
+  assert.equal(players[0].media.loads, 1);
+});
+
+test('keyboard focus activates a player once', () => {
+  const { players } = setup();
+  players[1].focusin();
+  players[1].focusin();
+  assert.equal(players[1].media.loads, 1);
+});
+
+test('fallback keeps distant media deferred until scrolling near it', () => {
+  const { players, events } = setup(false);
+  assert.equal(players[0].media.loads, 1);
+  assert.equal(players[1].media.src, undefined);
+  players[1].top = 990;
+  events.scroll();
+  assert.equal(players[1].media.loads, 1);
+  assert.equal(events.scroll, undefined);
+});
