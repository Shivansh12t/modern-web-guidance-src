       color: var(--primary);
     }
 
+    .seasonal-card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .customizations {
+      min-width: 0;
+      border: 0;
+      border-top: 1px solid var(--secondary);
+      margin-top: 22px;
+      padding-top: 12px;
+      text-align: left;
+    }
+
+    .customizations legend {
+      padding-right: 10px;
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    .customization {
+      position: relative;
+      display: block;
+      margin-bottom: 8px;
+      cursor: pointer;
+    }
+
+    /* Keep native inputs focusable and available to assistive technology. */
+    .customization input {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      margin: 0;
+      opacity: 0;
+    }
+
+    .option-content {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: #faf8f6;
+      font-size: 0.9rem;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .option-icon {
+      width: 20px;
+      height: 20px;
+      flex-shrink: 0;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 1.6;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .checkbox-mark {
+      display: grid;
+      place-items: center;
+      width: 22px;
+      height: 22px;
+      margin-left: auto;
+      flex-shrink: 0;
+      border: 2px solid #8d6e63;
+      border-radius: 5px;
+      background: white;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .checkbox-mark svg {
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: white;
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transform: scale(0.7);
+      transition: stroke-dashoffset 180ms ease, transform 180ms ease;
+    }
+
+    .customization:hover .option-content {
+      border-color: #8d6e63;
+    }
+
+    .customization input:checked + .option-content {
+      background: #fff1db;
+      border-color: #a66321;
+    }
+
+    .customization input:checked + .option-content .checkbox-mark {
+      background: var(--primary);
+      border-color: var(--primary);
+    }
+
+    .customization input:checked + .option-content .checkbox-mark svg {
+      stroke-dashoffset: 0;
+      transform: scale(1);
+    }
+
+    .customization input:focus-visible + .option-content {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .seasonal-card .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    .seasonal-card .customizations {
+      margin-bottom: 18px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option-content,
+      .checkbox-mark,
+      .checkbox-mark svg {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization input {
+        width: 22px;
+        height: 22px;
+        top: 50%;
+        right: 12px;
+        transform: translateY(-50%);
+        opacity: 1;
+        z-index: 1;
+        accent-color: auto;
+      }
+
+      .checkbox-mark {
+        visibility: hidden;
+      }
+
+      .customization input:focus-visible + .option-content {
+        outline-color: Highlight;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
