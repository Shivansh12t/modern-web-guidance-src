index 0000000..81fd022
--- /dev/null
+++ b/favorites.js
@@ -0,0 +1,148 @@
+(() => {
+  const grid = document.querySelector('#favorites-grid');
+  const reset = document.querySelector('#reset-favorites');
+  const status = document.querySelector('#favorites-status');
+  const empty = document.querySelector('#favorites-empty');
+  const originalCards = Array.from(grid.children);
+  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+  // Never fall back to a document transition: that would block the page and
+  // cancel unrelated card transitions. Animation is only an enhancement.
+  function transition(scope, update) {
+    if (reducedMotion.matches || typeof scope.startViewTransition !== 'function') {
+      update();
+      return;
+    }
+    const animation = scope.startViewTransition(update);
+    // A rapid second action may skip this animation, but still applies its update.
+    animation.ready.catch(() => {});
+  }
+
+  function move(node, before = null) {
+    if (typeof grid.moveBefore === 'function') {
+      grid.moveBefore(node, before);
+    } else {
+      const focused = node.contains(document.activeElement) ? document.activeElement : null;
+      grid.insertBefore(node, before);
+      focused?.focus({ preventScroll: true });
+    }
+  }
+
+  function refresh() {
+    const cards = Array.from(grid.children);
+    cards.forEach((card, index) => {
+      card.querySelector('[data-action="earlier"]').setAttribute('aria-disabled', String(index === 0));
+      card.querySelector('[data-action="later"]').setAttribute('aria-disabled', String(index === cards.length - 1));
+    });
+    empty.hidden = cards.length !== 0;
+  }
+
+  function button(label, action, accessibleLabel = label) {
+    const control = document.createElement('button');
+    control.type = 'button';
+    control.textContent = label;
+    control.dataset.action = action;
+    control.setAttribute('aria-label', accessibleLabel);
+    return control;
+  }
+
+  originalCards.forEach((wrapper, index) => {
+    const card = wrapper.querySelector('.drink-card');
+    const name = wrapper.dataset.drink;
+    const tools = document.createElement('div');
+    tools.className = 'card-tools';
+    tools.append(
+      button('←', 'earlier', `Move ${name} earlier`),
+      button('→', 'later', `Move ${name} later`),
+      button('Remove', 'remove', `Remove ${name}`),
+    );
+    card.prepend(tools);
+
+    const customize = button('Customize', 'customize', `Customize ${name}`);
+    customize.className = 'customize';
+    customize.setAttribute('aria-expanded', 'false');
+    customize.setAttribute('aria-controls', `drink-options-${index}`);
+
+    const options = document.createElement('div');
+    options.id = `drink-options-${index}`;
+    options.className = 'drink-options';
+    options.hidden = true;
+
+    function select(labelText, values) {
+      const label = document.createElement('label');
+      label.append(labelText);
+      const input = document.createElement('select');
+      input.name = `${labelText.toLowerCase()}-${index}`;
+      values.forEach(value => input.add(new Option(value, value)));
+      label.append(input);
+      options.append(label);
+      return input;
+    }
+
+    const size = select('Size', ['Regular', 'Large']);
+    const milk = select('Milk', index === 0
+      ? ['Oat milk', 'Whole milk', 'Almond milk', 'No milk']
+      : ['No milk', 'Oat milk', 'Whole milk', 'Almond milk']);
+    const summary = document.createElement('p');
+    summary.className = 'drink-summary';
+    summary.textContent = `${size.value} · ${milk.value}`;
+    card.append(customize, options, summary);
+
+    customize.addEventListener('click', () => {
+      transition(card, () => {
+        options.hidden = !options.hidden;
+        customize.setAttribute('aria-expanded', String(!options.hidden));
+        customize.textContent = options.hidden ? 'Customize' : 'Done customizing';
+        customize.setAttribute('aria-label', `${options.hidden ? 'Customize' : 'Done customizing'} ${name}`);
+      });
+    });
+
+    options.addEventListener('change', () => {
+      transition(card, () => {
+        summary.textContent = `${size.value} · ${milk.value}`;
+        status.textContent = `${name}: ${summary.textContent}.`;
+      });
+    });
+
+    tools.addEventListener('click', event => {
+      const control = event.target.closest('button');
+      if (!control || control.getAttribute('aria-disabled') === 'true') return;
+      transition(grid, () => {
+        // Resolve position inside the callback so rapid actions use current order.
+        if (wrapper.parentElement !== grid) return;
+        const action = control.dataset.action;
+        if (action === 'remove') {
+          const hadFocus = wrapper.contains(document.activeElement);
+          const neighbor = wrapper.nextElementSibling || wrapper.previousElementSibling;
+          wrapper.remove();
+          if (hadFocus) {
+            (neighbor?.querySelector('[data-action="remove"]') || reset).focus({ preventScroll: true });
+          }
+          status.textContent = `${name} removed. ${grid.children.length} drinks remaining. Reset favorites to restore it.`;
+        } else {
+          const neighbor = action === 'earlier' ? wrapper.previousElementSibling : wrapper.nextElementSibling;
+          if (!neighbor) return;
+          move(wrapper, action === 'earlier' ? neighbor : neighbor.nextElementSibling);
+          status.textContent = `${name} moved to position ${Array.from(grid.children).indexOf(wrapper) + 1} of ${grid.children.length}.`;
+        }
+        refresh();
+      });
+    });
+  });
+
+  reset.title = 'Restore removed drinks and their original order';
+  reset.addEventListener('click', () => {
+    transition(grid, () => {
+      originalCards.forEach(card => {
+        if (card.parentElement === grid) move(card);
+        else grid.append(card);
+      });
+      refresh();
+      status.textContent = 'All three favorites restored in their original order. Your drink customizations are kept.';
+    });
+  });
+
+  refresh();
+  reset.hidden = false;
+  document.querySelector('#favorites-help').hidden = false;
+})();
