+        else if (!empty) grid.insertAdjacentHTML('beforeend', '<p class="empty-favorites">A fresh start. Restore your drinks to build your lineup again.</p>');
+      }
+      // Capture current visual positions before cancelling: rapid clicks can interrupt safely.
