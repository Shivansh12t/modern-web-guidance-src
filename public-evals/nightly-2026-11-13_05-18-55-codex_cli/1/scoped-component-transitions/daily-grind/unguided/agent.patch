+            </div></div>
+            <div class="card-tools"><div class="move-controls"><span>Reorder</span><button type="button" data-action="previous" aria-label="Move ${drink.name} earlier">←</button><button type="button" data-action="next" aria-label="Move ${drink.name} later">→</button></div><button type="button" class="remove" data-action="remove" aria-label="Remove ${drink.name}">Remove ×</button></div>
