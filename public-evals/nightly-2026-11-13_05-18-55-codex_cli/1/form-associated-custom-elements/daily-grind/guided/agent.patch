diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..035d958
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,179 @@
+// A single form control: the shadow radios provide interaction, while the
+// ElementInternals value is the only rating entry in the owning form's data.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #radios;
+  #error;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'group';
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; margin-top: 8px; }
+        .stars { display: flex; gap: 4px; width: fit-content; }
+        label { position: relative; display: grid; place-items: center;
+          width: 48px; height: 48px; cursor: pointer; border-radius: 6px; }
+        input { position: absolute; width: 1px; height: 1px; padding: 0;
+          margin: -1px; overflow: hidden; clip-path: inset(50%); }
+        .star { font-size: 36px; line-height: 1; color: #806f64; }
+        label[data-filled] .star { color: #92571d; }
+        label:has(input:focus-visible) { outline: 3px solid #97601f; outline-offset: 2px; }
+        label:hover { background: #e5d9cf; }
+        .description { margin: 6px 0 0; font-size: 0.875rem; color: #695850; }
+        .error { color: #a12e21; font-size: 0.875rem; margin: 6px 0 0; }
+        :host(:disabled) { opacity: 0.6; }
+        :host(:disabled) label { cursor: not-allowed; background: transparent; }
+        @media (forced-colors: active) {
+          .star, label[data-filled] .star { color: CanvasText; }
+          label:has(input:checked) { outline: 2px solid Highlight; }
+        }
+      </style>
+      <div class="stars">
+        ${[1, 2, 3, 4, 5].map(value => `
+          <label>
+            <input type="radio" name="stars" value="${value}"
+              aria-label="${value} ${value === 1 ? 'star' : 'stars'}" aria-describedby="error">
+            <span class="star" aria-hidden="true">☆</span>
+          </label>`).join('')}
+      </div>
+      <p class="description">No rating selected</p>
+      <p id="error" class="error" aria-live="polite" hidden>Please choose a rating.</p>
+    `;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#error = root.querySelector('.error');
+    root.addEventListener('change', event => {
+      // Do not leak the shadow radio's event alongside the control's event.
+      event.stopPropagation();
+      if (this.#disabled || !this.#radios.includes(event.target)) return;
+      this.value = event.target.value;
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    root.addEventListener('input', event => event.stopPropagation());
+    this.addEventListener('invalid', () => {
+      this.#error.hidden = false;
+      this.#internals.ariaInvalid = 'true';
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#setValue(this.getAttribute('value'));
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) this.#setValue(this.getAttribute('value'));
+    else this.#validate();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#setValue(value);
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get type() { return 'star-rating'; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#error.hidden = true;
+    this.#internals.ariaInvalid = null;
+    this.#setValue(this.getAttribute('value'));
+  }
+
+  formDisabledCallback(disabled) {
+    // The browser includes ancestor fieldsets in this effective disabled state.
+    // Never reflect it onto the host: that would prevent fieldset re-enabling.
+    this.#disabled = disabled;
+    this.#radios.forEach(radio => { radio.disabled = disabled; });
+    this.#internals.ariaDisabled = String(disabled);
+  }
+
+  formStateRestoreCallback(state) {
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #setValue(value) {
+    this.#value = /^[1-5]$/.test(String(value)) ? String(value) : '';
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#radios.forEach(radio => {
+      radio.checked = radio.value === this.#value;
+      const filled = Number(radio.value) <= Number(this.#value);
+      radio.parentElement.toggleAttribute('data-filled', filled);
+      radio.nextElementSibling.textContent = filled ? '★' : '☆';
+    });
+    const descriptions = ['Needs work', 'Could be better', 'Pretty good', 'Loved it', 'Made my day'];
+    this.shadowRoot.querySelector('.description').textContent = this.#value
+      ? `${this.#value} of 5 — ${descriptions[Number(this.#value) - 1]}`
+      : 'No rating selected';
+    this.#validate();
+  }
+
+  #validate() {
+    this.#internals.ariaRequired = String(this.required);
+    if (this.required && !this.#value) {
+      this.#internals.setValidity({ valueMissing: true }, 'Please choose a rating.', this.#radios[0]);
+    } else {
+      this.#internals.setValidity({});
+      this.#internals.ariaInvalid = null;
+      this.#error.hidden = true;
+    }
+  }
+}
+
+if ('attachInternals' in HTMLElement.prototype &&
+    'ElementInternals' in window && 'setFormValue' in ElementInternals.prototype) {
+  customElements.define('star-rating', StarRating);
+} else {
+  // Older browsers retain a labeled, validated native control.
+  document.querySelectorAll('star-rating').forEach(rating => {
+    const select = document.createElement('select');
+    for (const attribute of rating.attributes) {
+      select.setAttribute(attribute.name, attribute.value);
+    }
+    select.add(new Option('Choose your rating', ''));
+    for (let value = 1; value <= 5; value++) {
+      select.add(new Option(`${value} ${value === 1 ? 'star' : 'stars'}`, String(value),
+        rating.getAttribute('value') === String(value)));
+    }
+    rating.replaceWith(select);
+  });
+}
+
+const form = document.querySelector('#coffee-feedback');
+const status = document.querySelector('#feedback-status');
+form.addEventListener('submit', event => {
+  // Native constraint validation runs before this event. FormData includes the
+  // custom element directly, without a mirrored hidden input or submit hook.
+  event.preventDefault();
+  const feedback = Object.fromEntries(new FormData(form));
+  try {
+    localStorage.setItem('daily-grind-feedback', JSON.stringify(feedback));
+    status.textContent = 'Thanks for sharing your coffee moment! Your feedback is saved on this device.';
+  } catch {
+    status.textContent = 'Your feedback could not be saved. Please allow browser storage and try again.';
+  }
+});
+form.addEventListener('reset', () => { status.textContent = ''; });
+form.addEventListener('input', () => { status.textContent = ''; });
