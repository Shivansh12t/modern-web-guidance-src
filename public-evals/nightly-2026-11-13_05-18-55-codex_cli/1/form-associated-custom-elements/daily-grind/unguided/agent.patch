diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..5f7bfa6
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,157 @@
+/** A native form-associated control. No hidden input or submit-time validation shim. */
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled', 'aria-labelledby', 'aria-label'];
+
+  #internals;
+  #value = '';
+  #disabled = false;
+  #showError = false;
+  #buttons;
+  #group;
+  #error;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    shadow.innerHTML = `
+      <style>
+        :host { display: inline-block; vertical-align: middle; }
+        .stars { display: flex; gap: 5px; width: max-content; }
+        button { appearance: none; border: 0; background: transparent; padding: 2px; width: 32px; height: 36px; color: #bfc4ad; cursor: pointer; border-radius: 3px; }
+        svg { width: 28px; height: 28px; fill: transparent; stroke: currentColor; stroke-width: 1.35; stroke-linejoin: round; transition: fill .15s, color .15s; }
+        button[data-filled] { color: #a47535; }
+        button[data-filled] svg { fill: #d6b367; }
+        button[data-preview] { color: #a47535; }
+        button[data-preview] svg { fill: #e6cc91; }
+        button:focus-visible { outline: 2px solid #b75c3e; outline-offset: 2px; }
+        button:disabled { opacity: .4; cursor: not-allowed; }
+        .error { font: 10px/1.5 'DM Sans', sans-serif; color: #a3442e; margin-top: 5px; max-width: 210px; }
+        [hidden] { display: none; }
+        @media (prefers-reduced-motion: reduce) { svg { transition: none; } }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Coffee rating">
+        ${[1, 2, 3, 4, 5].map(n => `<button type="button" role="radio" aria-checked="false" aria-label="${n} ${n === 1 ? 'star' : 'stars'}" tabindex="${n === 1 ? 0 : -1}" data-value="${n}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.1 6.3 7 .9-5.1 5 1.2 7-6.2-3.3-6.2 3.3 1.2-7-5.1-5 7-.9Z"/></svg></button>`).join('')}
+      </div><div class="error" id="rating-error" hidden>Please select a star rating.</div>`;
+    this.#group = shadow.querySelector('.stars');
+    this.#buttons = [...shadow.querySelectorAll('button')];
+    this.#error = shadow.querySelector('.error');
+    this.#buttons.forEach((button, index) => {
+      button.addEventListener('click', () => this.#select(index + 1));
+      button.addEventListener('pointerenter', () => {
+        if (!this.#disabled) this.#buttons.forEach((star, i) => star.toggleAttribute('data-preview', i <= index));
+      });
+    });
+    this.#group.addEventListener('pointerleave', () => this.#clearPreview());
+    this.#group.addEventListener('keydown', event => {
+      if (this.#disabled) return;
+      const current = Number(this.#value) || 1;
+      let next;
+      switch (event.key) {
+        case 'ArrowRight': case 'ArrowDown': next = current === 5 ? 1 : current + 1; break;
+        case 'ArrowLeft': case 'ArrowUp': next = current === 1 ? 5 : current - 1; break;
+        case 'Home': next = 1; break;
+        case 'End': next = 5; break;
+        default: return;
+      }
+      event.preventDefault();
+      this.#select(next);
+      this.#buttons[next - 1].focus();
+    });
+    this.addEventListener('invalid', () => { this.#showError = true; this.#render(); });
+  }
+
+  connectedCallback() {
+    this.#render();
+    this.#updateLabel();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value') this.#setValue(newValue);
+    else if (name === 'aria-labelledby' || name === 'aria-label') this.#updateLabel();
+    else this.#render();
+  }
+
+  get value() { return this.#value; }
+  set value(value) { this.#setValue(value); }
+  get name() { return this.getAttribute('name') || ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  focus(options) { this.#buttons[(Number(this.#value) || 1) - 1].focus(options); }
+
+  formDisabledCallback(disabled) {
+    // Includes inherited disabled state from an ancestor fieldset.
+    this.#disabled = disabled;
+    this.#clearPreview();
+    this.#render();
+  }
+
+  formResetCallback() {
+    this.#showError = false;
+    this.#clearPreview();
+    this.#setValue(this.getAttribute('value'));
+  }
+
+  formStateRestoreCallback(state, mode) {
+    this.#showError = false;
+    this.#setValue(typeof state === 'string' ? state : '');
+  }
+
+  #setValue(value) {
+    const string = String(value ?? '');
+    this.#value = /^[1-5]$/.test(string) ? string : '';
+    // The second argument is the state supplied to formStateRestoreCallback.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#render();
+  }
+
+  #select(value) {
+    if (this.#disabled) return;
+    this.#clearPreview();
+    if (this.#value === String(value)) return;
+    this.#setValue(value);
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+  }
+
+  #clearPreview() { this.#buttons.forEach(button => button.removeAttribute('data-preview')); }
+
+  #updateLabel() {
+    // Resolve light-DOM labels because ID references cannot cross a shadow boundary.
+    const labelText = (this.getAttribute('aria-labelledby') || '').split(/\s+/)
+      .map(id => this.ownerDocument.getElementById(id)?.textContent.trim()).filter(Boolean).join(' ');
+    this.#group.setAttribute('aria-label', labelText || this.getAttribute('aria-label') || 'Coffee rating');
+  }
+
+  #render() {
+    const value = Number(this.#value);
+    const missing = this.required && !value;
+    this.#buttons.forEach((button, index) => {
+      button.disabled = this.#disabled;
+      button.setAttribute('aria-checked', String(value === index + 1));
+      button.tabIndex = !this.#disabled && index === (value || 1) - 1 ? 0 : -1;
+      button.toggleAttribute('data-filled', index < value);
+    });
+    this.#group.setAttribute('aria-required', String(this.required));
+    this.#group.setAttribute('aria-disabled', String(this.#disabled));
+    this.#internals.setValidity(missing ? { valueMissing: true } : {}, missing ? 'Please select a star rating.' : '', this.#buttons[0]);
+    const showError = missing && this.#showError && !this.#disabled;
+    this.#error.hidden = !showError;
+    this.#group.setAttribute('aria-invalid', String(showError));
+    if (showError) this.#group.setAttribute('aria-describedby', 'rating-error');
+    else this.#group.removeAttribute('aria-describedby');
+  }
+}
+customElements.define('star-rating', StarRating);
