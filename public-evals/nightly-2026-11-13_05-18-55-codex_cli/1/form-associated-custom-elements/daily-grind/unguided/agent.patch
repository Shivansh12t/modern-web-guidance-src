diff --git a/feedback.js b/feedback.js
new file mode 100644
index 0000000..44754bd
--- /dev/null
+++ b/feedback.js
@@ -0,0 +1,26 @@
+import './star-rating.js';
+
+const form = document.querySelector('#coffee-feedback');
+const rating = document.querySelector('star-rating');
+const hint = document.querySelector('#rating-hint');
+const status = document.querySelector('#form-status');
+const descriptions = ['Give your cup some stars.', '1 star · Room to improve', '2 stars · Could be better', '3 stars · A good cup', '4 stars · Loved it', '5 stars · Made my day!'];
+
+rating.addEventListener('input', () => { hint.textContent = descriptions[Number(rating.value)]; });
+form.addEventListener('input', () => { status.hidden = true; });
+form.addEventListener('reset', () => {
+  hint.textContent = descriptions[0];
+  status.hidden = true;
+});
+form.addEventListener('submit', event => {
+  // Native constraint validation runs before this event, including star-rating.
+  event.preventDefault();
+  const feedback = Object.fromEntries(new FormData(form));
+  try {
+    localStorage.setItem('daily-grind-feedback', JSON.stringify({ ...feedback, submittedAt: new Date().toISOString() }));
+    status.textContent = `Thanks${feedback.name?.trim() ? `, ${feedback.name.trim()}` : ''}! Your feedback has been saved on this device. Here’s to your next great cup.`;
+  } catch {
+    status.textContent = 'Your browser could not save the feedback on this device. Please allow local storage and try again.';
+  }
+  status.hidden = false;
+});
