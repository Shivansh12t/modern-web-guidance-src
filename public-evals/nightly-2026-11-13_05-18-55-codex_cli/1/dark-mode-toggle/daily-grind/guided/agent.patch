+  <script>
+    (() => {
+      const toggle = document.getElementById('theme-toggle');
+      const root = document.documentElement;
+      const schemeMeta = document.querySelector('meta[name="color-scheme"]');
+      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateToggle() {
+        const dark = root.dataset.theme
+          ? root.dataset.theme === 'dark'
+          : systemTheme.matches;
+        toggle.setAttribute('aria-pressed', String(dark));
+      }
+
+      toggle.addEventListener('click', () => {
+        const theme = toggle.getAttribute('aria-pressed') === 'true' ? 'light' : 'dark';
+        root.dataset.theme = theme;
+        schemeMeta.content = theme;
+        updateToggle();
+        try {
+          localStorage.setItem('daily-grind-theme', theme);
+        } catch {
+          // Switching still works for this page if persistence is unavailable.
+        }
+      });
+
+      systemTheme.addEventListener('change', updateToggle);
+      window.addEventListener('storage', (event) => {
+        if (event.key !== 'daily-grind-theme' && event.key !== null) return;
+        if (event.newValue === 'light' || event.newValue === 'dark') {
+          root.dataset.theme = event.newValue;
+          schemeMeta.content = event.newValue;
+        } else {
+          delete root.dataset.theme;
+          schemeMeta.content = 'light dark';
+        }
+        updateToggle();
+      });
+
+      updateToggle();
+      toggle.hidden = false;
+    })();
+  </script>
