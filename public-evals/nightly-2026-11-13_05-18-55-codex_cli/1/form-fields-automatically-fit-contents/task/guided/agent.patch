+  <script>
+    const preferenceForm = document.getElementById('preference-form');
+    const preferenceStatus = document.getElementById('preference-status');
+    const preferenceKey = 'daily-grind-coffee-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(preferenceKey));
+      if (saved && typeof saved === 'object') {
+        for (const field of preferenceForm.elements) {
+          if (field.name && typeof saved[field.name] === 'string') {
+            field.value = saved[field.name];
+          }
+        }
+      }
+    } catch {
+      // The form remains usable when browser storage is unavailable.
+    }
+
+    preferenceForm.addEventListener('input', () => {
+      preferenceStatus.textContent = '';
+    });
+
+    preferenceForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(preferenceKey, JSON.stringify(Object.fromEntries(new FormData(preferenceForm))));
+        preferenceStatus.textContent = 'Your preferences are saved in this browser. See you for your next cup!';
+      } catch {
+        preferenceStatus.textContent = 'Your browser couldn’t save these preferences. Please allow site storage and try again.';
+      }
+    });
+  </script>
+
