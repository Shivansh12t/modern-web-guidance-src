+  <script>
+    const form = document.querySelector('#preferences-form');
+    const fields = [...form.querySelectorAll('.content-sized')];
+    const status = document.querySelector('#save-status');
+    const canvas = document.createElement('canvas');
+    const context = canvas.getContext('2d');
+
+    function fitField(field) {
+      const style = getComputedStyle(field);
+      context.font = style.font;
+      const content = field.tagName === 'SELECT'
+        ? field.selectedOptions[0].textContent
+        : field.value || field.placeholder;
+      const textWidth = Math.max(...content.split('\n').map(line => context.measureText(line).width));
+      const padding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
+      const borders = parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+      // Leave a little room for the input caret and font rounding.
+      field.style.width = `${Math.ceil(textWidth + padding + borders + 3)}px`;
+      if (field.tagName === 'TEXTAREA') {
+        field.style.height = 'auto';
+        field.style.height = `${field.scrollHeight + borders}px`;
+      }
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved === 'object') {
+        fields.forEach(field => {
+          if (typeof saved[field.name] === 'string' &&
+              (field.tagName !== 'SELECT' || [...field.options].some(option => option.value === saved[field.name]))) {
+            field.value = saved[field.name];
+          }
+        });
+      }
+    } catch { /* The form remains usable when local storage is unavailable. */ }
+
+    fields.forEach(field => {
+      field.addEventListener('input', () => { fitField(field); status.textContent = ''; });
+      field.addEventListener('change', () => fitField(field));
+      fitField(field);
+    });
+    window.addEventListener('resize', () => fields.forEach(fitField));
+    document.fonts.ready.then(() => fields.forEach(fitField));
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your preferences are saved on this device. Make yourself at home.';
+      } catch {
+        status.textContent = 'Your browser could not save your preferences. You can still edit them here.';
+      }
+    });
+  </script>
