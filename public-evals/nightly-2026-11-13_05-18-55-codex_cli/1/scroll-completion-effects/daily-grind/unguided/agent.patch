+  <script>
+    const navigation = document.querySelector('nav');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let cancelScroll = () => {};
+
+    function updateNavigationOffset() {
+      document.documentElement.style.setProperty('--nav-offset', `${navigation.offsetHeight + 20}px`);
+    }
+
+    updateNavigationOffset();
+    new ResizeObserver(updateNavigationOffset).observe(navigation);
+
+    navigation.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const selector = link.dataset.scrollTarget || link.getAttribute('href');
+      const target = document.getElementById(selector.replace(/^#/, ''));
+      if (!target) return;
+
+      event.preventDefault();
+      cancelScroll();
+      document.querySelectorAll('.section-arrived').forEach((section) => section.classList.remove('section-arrived'));
+      updateNavigationOffset();
+
+      const desiredTop = target.getBoundingClientRect().top + window.scrollY - navigation.offsetHeight - 20;
+      const destination = Math.max(0, Math.min(desiredTop, document.documentElement.scrollHeight - window.innerHeight));
+      const controller = new AbortController();
+      let frame;
+      let stableFrames = 0;
+      let previousY = window.scrollY;
+      const startedAt = performance.now();
+      let lastMovementAt = startedAt;
+
+      const cleanup = () => {
+        controller.abort();
+        cancelAnimationFrame(frame);
+      };
+      cancelScroll = cleanup;
+
+      // User input or a newer navigation cancels the pending arrival effects.
+      for (const type of ['wheel', 'touchstart', 'pointerdown']) {
+        window.addEventListener(type, cleanup, { passive: true, signal: controller.signal });
+      }
+      window.addEventListener('keydown', (event) => {
+        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(event.key)) cleanup();
+      }, { signal: controller.signal });
+      window.addEventListener('popstate', cleanup, { signal: controller.signal });
+
+      const checkArrival = (now) => {
+        const currentY = window.scrollY;
+        if (Math.abs(currentY - previousY) < 0.1) {
+          stableFrames += 1;
+        } else {
+          stableFrames = 0;
+          lastMovementAt = now;
+        }
+        previousY = currentY;
+
+        // Check actual position and settling, rather than guessing a scroll duration.
+        if (Math.abs(currentY - destination) <= 1 && stableFrames >= 3 && now - startedAt >= 100) {
+          cleanup();
+          history.pushState(null, '', `#${target.id}`);
+          target.focus({ preventScroll: true });
+          target.classList.add('section-arrived');
+          target.addEventListener('animationend', () => target.classList.remove('section-arrived'), { once: true });
+          return;
+        }
+        // A layout change or interrupted scroll must not activate the wrong target.
+        if (now - startedAt > 500 && now - lastMovementAt > 250) {
+          cleanup();
+          return;
+        }
+        frame = requestAnimationFrame(checkArrival);
+      };
+
+      window.scrollTo({ top: destination, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      frame = requestAnimationFrame(checkArrival);
+    });
+  </script>
