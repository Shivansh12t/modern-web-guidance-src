+  <script>
+    let currentScrollId = 0;
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    async function scrollToSection(top) {
+      // Observe before scrolling so even immediate scroll completion is caught.
+      let idleTimer;
+      let finish;
+      const settled = new Promise((resolve) => {
+        finish = () => {
+          clearTimeout(idleTimer);
+          document.removeEventListener('scrollend', finish);
+          document.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(idleTimer);
+          idleTimer = setTimeout(finish, 150);
+        };
+        document.addEventListener('scrollend', finish, { once: true });
+        document.addEventListener('scroll', onScroll, { passive: true });
+        // Handles no movement; subsequent scroll events keep postponing completion.
+        onScroll();
+      });
+
+      try {
+        const result = window.scrollTo({
+          top,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+        if (result && typeof result.then === 'function') await result;
+        // Also covers older browsers and premature root-scroll promise resolution.
+        await settled;
+      } finally {
+        finish();
+      }
+    }
+
+    document.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
+          link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+
+      const selector = link.dataset.scrollTarget || link.getAttribute('href');
+      let target;
+      try {
+        target = document.getElementById(decodeURIComponent(selector.replace(/^#/, '')));
+      } catch {
+        return;
+      }
+      if (!target) return;
+
+      event.preventDefault();
+      const scrollId = ++currentScrollId;
+      document.querySelectorAll('.section-arrived').forEach((section) => {
+        section.classList.remove('section-arrived');
+      });
+      const offset = document.querySelector('nav').getBoundingClientRect().height + 16;
+      const top = Math.max(0, Math.min(
+        window.scrollY + target.getBoundingClientRect().top - offset,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      const hash = '#' + encodeURIComponent(target.id);
+      if (window.location.hash !== hash) history.pushState(null, '', hash);
+      await scrollToSection(top);
+
+      // Ignore superseded requests and scrolls interrupted before the destination.
+      if (scrollId !== currentScrollId || Math.abs(window.scrollY - top) > 2) return;
+      if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
+      target.focus({ preventScroll: true });
+      target.classList.add('section-arrived');
+      target.addEventListener('animationend', () => {
+        target.classList.remove('section-arrived');
+      }, { once: true });
+    });
+  </script>
