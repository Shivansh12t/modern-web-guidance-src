+  <script>
+    const navList = document.querySelector('nav ul');
+    const navItems = [...navList.querySelectorAll('[data-nav-item]')];
+    let activeItem = navItems.find(item => item.pathname === location.pathname) || navItems[0];
+
+    function updateIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const itemBounds = activeItem.getBoundingClientRect();
+      navList.style.setProperty('--indicator-left', `${itemBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-width', `${itemBounds.width}px`);
+      navList.style.setProperty('--indicator-top', `${itemBounds.bottom - listBounds.top + 5}px`);
+    }
+
+    function selectItem(item) {
+      navItems.forEach(link => link.removeAttribute('aria-current'));
+      activeItem = item;
+      activeItem.setAttribute('aria-current', 'page');
+      updateIndicator();
+    }
+
+    navItems.forEach(item => {
+      item.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        // Keep this static page visible while the selection slides to the clicked link.
+        event.preventDefault();
+        selectItem(item);
+      });
+    });
+
+    selectItem(activeItem);
+    requestAnimationFrame(() => requestAnimationFrame(() => navList.classList.add('indicator-ready')));
+    // Keep the JavaScript fallback aligned after resizing or font changes.
+    const navObserver = new ResizeObserver(updateIndicator);
+    navObserver.observe(navList);
+    navItems.forEach(item => navObserver.observe(item));
+    document.fonts.ready.then(updateIndicator);
+  </script>
 </body>
 
