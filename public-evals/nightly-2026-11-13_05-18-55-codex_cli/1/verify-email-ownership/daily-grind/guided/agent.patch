diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..307043c
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,15 @@
+import { mkdirSync } from 'node:fs';
+import { createStore } from './lib/store.mjs';
+import { createVerifier } from './lib/verify-email.mjs';
+import { createApp } from './lib/app.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.PUBLIC_ORIGIN || `http://localhost:${port}`;
+if (new URL(origin).origin !== origin || (process.env.NODE_ENV === 'production' && !origin.startsWith('https://'))) {
+  throw new Error('PUBLIC_ORIGIN must be an exact origin, using HTTPS in production');
+}
+mkdirSync('data', { recursive: true, mode: 0o700 });
+const store = createStore(process.env.DATABASE_PATH || 'data/rewards.sqlite');
+const verifyEmail = createVerifier(process.env.EVP_TRUSTED_ORIGINS ? { trustedOrigins: process.env.EVP_TRUSTED_ORIGINS.split(',').map(value => value.trim()) } : {});
+const app = createApp({ store, verifyEmail, origin, originTrialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN });
+app.listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
