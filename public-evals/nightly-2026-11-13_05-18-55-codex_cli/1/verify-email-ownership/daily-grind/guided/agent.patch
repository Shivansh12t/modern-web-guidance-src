--- /dev/null
+++ b/test/rewards.test.mjs
@@ -0,0 +1,110 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { createVerifier } from '../lib/verify-email.mjs';
+import { createStore } from '../lib/store.mjs';
+import { createApp } from '../lib/app.mjs';
+
+const issuer = 'https://issuer.example';
+const audience = 'https://coffee.example';
+const issuerPair = await generateKeyPair('ES256');
+const holderPair = await generateKeyPair('ES256');
+const issuerKey = await exportJWK(issuerPair.publicKey);
+const holderKey = await exportJWK(holderPair.publicKey);
+const otherPair = await generateKeyPair('ES256');
+const otherKey = await exportJWK(otherPair.publicKey);
+async function presentation({ nonce = 'session-nonce', aud = audience, email = 'Alice@example.com', emailVerified = true, age = 0, signingKey = issuerPair.privateKey, digest = null, issuerValue = issuer } = {}) {
+  const now = Math.floor(Date.now() / 1000) - age;
+  const evt = await new SignJWT({ email, email_verified: emailVerified, cnf: { jwk: holderKey } })
+    .setProtectedHeader({ alg: 'ES256', typ: 'ev+sd-jwt' }).setIssuer(issuerValue).setIssuedAt(now).setExpirationTime(now + 300).sign(signingKey);
+  const sdHash = digest ?? createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb = await new SignJWT({ nonce, aud, sd_hash: sdHash }).setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' }).setIssuedAt(now).sign(holderPair.privateKey);
+  return `${evt}~${kb}`;
+}
+function verifier(overrides = {}) {
+  return createVerifier({
+    trustedOrigins: [issuer],
+    lookupTxt: async () => [['iss=issuer.example']],
+    fetchJson: async url => url.pathname.includes('email-verification') ? { issuer, jwks_uri: `${issuer}/keys` } : { keys: [otherKey, issuerKey] },
+    ...overrides,
+  });
+}
+const params = rawToken => ({ rawToken, submittedEmail: 'alice@example.com', expectedNonce: 'session-nonce', expectedAudience: audience });
+
+test('accepts verified email case-insensitively, holder keys without alg, and JWKS without kid', async () => {
+  await verifier()(params(await presentation()));
+});
+for (const [name, options] of Object.entries({
+  'wrong nonce': { nonce: 'attacker' },
+  'wrong audience': { aud: 'https://attacker.example' },
+  'wrong email': { email: 'mallory@example.com' },
+  'unverified email': { emailVerified: false },
+  'expired token': { age: 600 },
+  'forged issuer signature': { signingKey: holderPair.privateKey },
+  'wrong token digest': { digest: 'not-the-presentation-digest' },
+  'untrusted issuer': { issuerValue: 'https://attacker.example' },
+})) {
+  test(`rejects ${name}`, async () => {
+    await assert.rejects(verifier()(params(await presentation(options))));
+  });
+}
+test('requires key binding and a server nonce', async () => {
+  const token = await presentation();
+  await assert.rejects(verifier()(params(token.split('~')[0] + '~')));
+  await assert.rejects(verifier()({ ...params(token), expectedNonce: '' }));
+});
+test('rejects nondelegated issuer before discovery', async () => {
+  let requested = false;
+  const verify = verifier({ lookupTxt: async () => [['iss=other.example']], fetchJson: async () => { requested = true; } });
+  await assert.rejects(verify(params(await presentation())));
+  assert.equal(requested, false);
+});
+test('rejects metadata mismatch and untrusted JWKS destination', async () => {
+  const token = await presentation();
+  await assert.rejects(verifier({ fetchJson: async () => ({ issuer: 'https://other.example' }) })(params(token)));
+  await assert.rejects(verifier({ fetchJson: async () => ({ issuer, jwks_uri: 'http://127.0.0.1/keys' }) })(params(token)));
+});
+
+// Exercise handlers directly: no HTTP listener, browser, or server entrypoint.
+function response() {
+  return { statusCode: 200, cookie() { return this; }, status(code) { this.statusCode = code; return this; }, type() { return this; }, send(html) { this.html = html; return this; } };
+}
+function signupHandler(store) {
+  const app = createApp({ store, verifyEmail: verifier(), origin: audience });
+  return app.router.stack.find(layer => layer.route?.path === '/api/verify-email').route.stack[0].handle;
+}
+test('endpoint persists only verified accounts, hashes passwords, and consumes replayed sessions', async () => {
+  const store = createStore(':memory:');
+  let savedHash;
+  const save = store.createAccount;
+  store.createAccount = account => { savedHash = account.passwordHash; save(account); };
+  const session = store.issue();
+  const request = { headers: { cookie: `__Host-dg-signup=${session.id}`, origin: audience }, body: { name: 'Alice', email: 'alice@example.com', password: 'a long unique password', csrf: session.csrf, token: await presentation({ nonce: session.nonce }) } };
+  const handler = signupHandler(store);
+  const result = response();
+  await handler(request, result);
+  assert.equal(result.statusCode, 200);
+  assert.match(result.html, /You’re in!/);
+  assert.match(savedHash, /^scrypt:[a-f0-9]{32}:[a-f0-9]{128}$/);
+  const replay = response();
+  await handler(request, replay);
+  assert.equal(replay.statusCode, 403);
+  // The unique index demonstrates the first account was actually persisted.
+  assert.throws(() => store.createAccount({ name: 'Again', email: 'ALICE@example.com', passwordHash: 'test' }), /UNIQUE/);
+  assert.doesNotMatch(result.html, /a long unique password/);
+  store.close();
+});
+test('missing/invalid browser tokens and cross-origin requests create no account', async () => {
+  for (const mode of ['empty', 'invalid', 'csrf', 'origin']) {
+    const store = createStore(':memory:');
+    const session = store.issue();
+    const result = response();
+    await signupHandler(store)({ headers: { cookie: `__Host-dg-signup=${session.id}`, origin: mode === 'origin' ? 'https://attacker.example' : audience }, body: { name: '<script>alert(1)</script>', email: 'alice@example.com', password: 'a long unique password', csrf: mode === 'csrf' ? 'wrong' : session.csrf, token: mode === 'empty' ? '' : 'fake' } }, result);
+    assert.equal(result.statusCode, ['csrf', 'origin'].includes(mode) ? 403 : 422);
+    assert.doesNotMatch(result.html, /value="<script>/);
+    assert.doesNotThrow(() => store.createAccount({ name: 'Alice', email: 'alice@example.com', passwordHash: 'test' }));
+    assert.equal(store.consume(session.id), undefined);
+    store.close();
+  }
+});
