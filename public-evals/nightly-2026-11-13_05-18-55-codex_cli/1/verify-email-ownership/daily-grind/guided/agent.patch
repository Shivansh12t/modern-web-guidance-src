diff --git a/lib/app.mjs b/lib/app.mjs
new file mode 100644
index 0000000..24ef680
--- /dev/null
+++ b/lib/app.mjs
@@ -0,0 +1,63 @@
+import express from 'express';
+import { randomBytes, scrypt as scryptCallback, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+import { readFileSync } from 'node:fs';
+
+const scrypt = promisify(scryptCallback);
+const template = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+const escape = value => String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
+const equal = (a, b) => typeof a === 'string' && typeof b === 'string' && Buffer.byteLength(a) === Buffer.byteLength(b) && timingSafeEqual(Buffer.from(a), Buffer.from(b));
+
+export function createApp({ store, verifyEmail, origin, originTrialToken = '' }) {
+  const app = express();
+  const secure = origin.startsWith('https:');
+  const cookieName = secure ? '__Host-dg-signup' : 'dg-signup';
+  app.disable('x-powered-by');
+  app.use((req, res, next) => {
+    res.set({ 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'same-origin', 'Content-Security-Policy': "default-src 'self'; img-src 'self' https://images.unsplash.com; style-src 'self' 'unsafe-inline'; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" });
+    if (originTrialToken) res.set('Origin-Trial', originTrialToken);
+    next();
+  });
+  app.use(express.urlencoded({ extended: false, limit: '48kb', parameterLimit: 12 }));
+  function render(res, { message = '', success = false, name = '', email = '', status = 200 } = {}) {
+    const session = store.issue();
+    res.cookie(cookieName, session.id, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 600000 });
+    const values = { NONCE: session.nonce, CSRF: session.csrf, MESSAGE: message, NAME: name, EMAIL: email, SUCCESS: success ? 'hidden' : '', MESSAGE_HIDDEN: message ? '' : 'hidden' };
+    res.status(status).type('html').send(template.replace(/\{\{(\w+)\}\}/g, (_, key) => escape(values[key])));
+  }
+  app.get('/', (req, res) => render(res));
+  app.get('/rewards.js', (req, res) => res.sendFile(new URL('../rewards.js', import.meta.url).pathname));
+  app.post('/api/verify-email', async (req, res) => {
+    // A DELETE RETURNING consumes the nonce atomically, including invalid submissions.
+    const cookie = req.headers.cookie?.split(';').map(part => part.trim()).find(part => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    const session = store.consume(cookie);
+    const body = req.body ?? {};
+    if (!session || session.expires < Date.now() || req.headers.origin !== origin || !equal(body.csrf, session.csrf)) {
+      return render(res, { status: 403, message: 'This sign-up session expired. Please try again using the fresh form below.' });
+    }
+    const name = typeof body.name === 'string' ? body.name.trim() : '';
+    const email = typeof body.email === 'string' ? body.email.trim() : '';
+    const password = typeof body.password === 'string' ? body.password : '';
+    if (!name || name.length > 100 || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || password.length < 12 || password.length > 128) {
+      return render(res, { status: 400, name, email, message: 'Enter your name, a valid email address, and a password of 12–128 characters.' });
+    }
+    if (!body.token) return render(res, { status: 422, name, email, message: 'Your email could not be confirmed by this browser. Use a supported browser, sign in to your email provider, and allow email verification when prompted. No account was created and no email was sent.' });
+    try {
+      await verifyEmail({ rawToken: body.token, submittedEmail: email, expectedNonce: session.nonce, expectedAudience: origin });
+    } catch {
+      return render(res, { status: 422, name, email, message: 'We could not verify your email. Please try again and approve the browser prompt. No account was created and no email was sent.' });
+    }
+    const salt = randomBytes(16).toString('hex');
+    const hash = await scrypt(password, salt, 64);
+    try { store.createAccount({ name, email, passwordHash: `scrypt:${salt}:${hash.toString('hex')}` }); }
+    catch (error) {
+      if (error.code !== 'ERR_SQLITE_ERROR' || !String(error.message).includes('UNIQUE')) throw error;
+      return render(res, { status: 409, name, email, message: 'An account already uses this email address. Use your existing rewards account.' });
+    }
+    return render(res, { success: true, message: 'You’re in! Your email is verified and your Daily Grind rewards account is ready. We’ll see you for your next cup.' });
+  });
+  app.use((error, req, res, next) => {
+    render(res, { status: error.status === 413 ? 413 : 500, message: error.status === 413 ? 'This submission is too large. Please try again.' : 'Sign-up is temporarily unavailable. Please try again shortly.' });
+  });
+  return app;
+}
diff --git a/lib/store.mjs b/lib/store.mjs
new file mode 100644
index 0000000..4c1de42
--- /dev/null
+++ b/lib/store.mjs
@@ -0,0 +1,24 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+
+export function createStore(path) {
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS signup_sessions (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, csrf TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, email_key TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, email_verified_at INTEGER NOT NULL);`);
+  return {
+    issue() {
+      db.prepare('DELETE FROM signup_sessions WHERE expires < ?').run(Date.now());
+      const session = { id: randomBytes(32).toString('base64url'), nonce: randomBytes(32).toString('base64url'), csrf: randomBytes(32).toString('base64url') };
+      db.prepare('INSERT INTO signup_sessions VALUES (?, ?, ?, ?)').run(session.id, session.nonce, session.csrf, Date.now() + 600000);
+      return session;
+    },
+    consume(id) {
+      return db.prepare('DELETE FROM signup_sessions WHERE id = ? RETURNING *').get(id ?? '') ;
+    },
+    createAccount({ name, email, passwordHash }) {
+      db.prepare('INSERT INTO accounts VALUES (?, ?, ?, ?, ?, ?)').run(randomUUID(), name, email, email.toLowerCase(), passwordHash, Date.now());
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/lib/verify-email.mjs b/lib/verify-email.mjs
new file mode 100644
index 0000000..c5cd5e9
--- /dev/null
+++ b/lib/verify-email.mjs
@@ -0,0 +1,89 @@
+import { createHash } from 'node:crypto';
+import { resolveTxt } from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const algorithms = ['Ed25519', 'EdDSA', 'ES256'];
+const normalize = alg => alg === 'Ed25519' ? 'EdDSA' : alg;
+export const hasher = (data, alg) => {
+  if (!['sha-256', 'sha-384', 'sha-512'].includes(alg)) throw new Error('Unsupported digest');
+  return createHash(alg.replace('-', '')).update(data).digest();
+};
+
+// Explicit operator-controlled network allowlist, in addition to DNS delegation.
+// Untrusted JWT claims can never select arbitrary network destinations.
+export function createVerifier({
+  trustedOrigins = ['https://accounts.google.com', 'https://verifiablecredentials-pa.googleapis.com'],
+  lookupTxt = resolveTxt,
+  fetchJson,
+} = {}) {
+  const allowed = new Set(trustedOrigins);
+  function trustedUrl(value) {
+    const url = new URL(value);
+    if (url.protocol !== 'https:' || url.username || url.password || !allowed.has(url.origin)) {
+      throw new Error('Untrusted verification destination');
+    }
+    return url;
+  }
+  const loadJson = fetchJson ?? (async url => {
+    const response = await fetch(url, { redirect: 'error', signal: AbortSignal.timeout(5000) });
+    if (!response.ok) throw new Error('Issuer unavailable');
+    let size = 0;
+    const chunks = [];
+    for await (const chunk of response.body) {
+      size += chunk.length;
+      if (size > 131072) throw new Error('Issuer response too large');
+      chunks.push(chunk);
+    }
+    return JSON.parse(Buffer.concat(chunks).toString('utf8'));
+  });
+  return async function verifyEmail({ rawToken, submittedEmail, expectedNonce, expectedAudience }) {
+    if (!expectedNonce || typeof rawToken !== 'string' || rawToken.length > 32768) throw new Error('Invalid presentation');
+    const decoded = decodeSdJwtSync(rawToken, hasher);
+    const payload = decoded.jwt.payload;
+    if (!decoded.kbJwt || payload.email_verified !== true || typeof payload.email !== 'string' ||
+        payload.email.toLowerCase() !== submittedEmail.toLowerCase()) throw new Error('Email not verified');
+    const issuer = trustedUrl(payload.iss);
+    if (issuer.origin !== payload.iss) throw new Error('Issuer must be an exact HTTPS origin');
+    const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+    const records = await lookupTxt(`_email-verification.${domain}`);
+    if (!records.some(parts => `https://${parts.join('').replace(/^iss=/, '').trim()}` === payload.iss && parts.join('').startsWith('iss='))) {
+      throw new Error('Issuer not delegated by email domain');
+    }
+    const metadata = await loadJson(trustedUrl(`${payload.iss}/.well-known/email-verification`));
+    if (metadata.issuer !== payload.iss) throw new Error('Issuer metadata mismatch');
+    const jwks = createLocalJWKSet(await loadJson(trustedUrl(metadata.jwks_uri)));
+    const holder = payload.cnf?.jwk;
+    const kbAlg = decoded.kbJwt.header.alg;
+    if (!holder || holder.d || !algorithms.includes(kbAlg) ||
+        (holder.alg && normalize(holder.alg) !== normalize(kbAlg))) throw new Error('Invalid holder key');
+    const holderKey = await importJWK(holder, kbAlg);
+    const evtOptions = { issuer: payload.iss, algorithms, maxTokenAge: '5m', clockTolerance: 60, requiredClaims: ['iat', 'exp'] };
+    // Both type names occur in EVP implementations during the origin trial.
+    if (!['ev+sd-jwt', 'evt+jwt'].includes(decoded.jwt.header.typ)) throw new Error('Unexpected token type');
+    const sdJwt = new SDJwtInstance({
+      hasher,
+      verifier: async (data, sig) => {
+        const token = `${data}.${sig}`;
+        try { await jwtVerify(token, jwks, evtOptions); }
+        catch (error) {
+          if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+          let matched = false;
+          for await (const key of error) {
+            try { await jwtVerify(token, key, evtOptions); matched = true; break; } catch {}
+          }
+          if (!matched) throw error;
+        }
+        return true;
+      },
+      kbVerifier: async (data, sig) => {
+        await jwtVerify(`${data}.${sig}`, holderKey, { typ: 'kb+jwt', audience: expectedAudience, algorithms: [kbAlg], maxTokenAge: '5m', clockTolerance: 60 });
+        return true;
+      },
+    });
+    await sdJwt.verify(rawToken, {
+      requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: expectedNonce,
+      expectedKeyBindingAudience: expectedAudience, keyBindingMaxAgeSeconds: 300, skewSeconds: 60,
+    });
+  };
+}
