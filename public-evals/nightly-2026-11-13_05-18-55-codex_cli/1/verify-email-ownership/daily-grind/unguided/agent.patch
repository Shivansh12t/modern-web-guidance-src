+import { randomBytes, randomUUID } from 'node:crypto';
+import { readFileSync, mkdirSync, writeFileSync, renameSync, existsSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { verifyEmailToken } from './verification.mjs';
+const root = new URL('../', import.meta.url);
+const cookieName = 'dg_signup';
+const lifetime = 10 * 60 * 1000;
+const random = () => randomBytes(32).toString('base64url');
+
+export function createMemberStore(directory) {
+  mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const file = resolve(directory, 'members.json');
+  const members = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : [];
+  return member => {
+    if (members.some(item => item.email.toLowerCase() === member.email.toLowerCase())) return;
+    const next = [...members, { id: randomUUID(), ...member, emailVerified: true, createdAt: new Date().toISOString() }];
+    writeFileSync(`${file}.tmp`, JSON.stringify(next), { mode: 0o600 });
+    renameSync(`${file}.tmp`, file);
+    members.push(next.at(-1));
+  };
+}
+
+export function createApp({ origin, trialToken = '', verify = verifyEmailToken, saveMember }) {
+  if (!origin || new URL(origin).origin !== origin) throw new Error('APP_ORIGIN must be an exact origin');
+  const challenges = new Map();
+  const attempts = new Map();
+  const secure = origin.startsWith('https:');
+  const baseHeaders = { 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'strict-origin-when-cross-origin', 'X-Frame-Options': 'DENY' };
+  const json = (status, message) => new Response(JSON.stringify({ message }), { status, headers: { ...baseHeaders, 'Content-Type': 'application/json' } });
+  return async function handle(request, client = 'unknown') {
+    const now = Date.now();
+    for (const [id, item] of challenges) if (item.expires <= now) challenges.delete(id);
+    for (const [id, item] of attempts) if (item.expires <= now) attempts.delete(id);
+    const path = new URL(request.url).pathname;
+    if (request.method === 'GET' && (path === '/' || path === '/index.html')) {
+      if (challenges.size >= 10000) return json(503, 'We’re busy brewing. Please try again shortly.');
+      const session = random(); const nonce = random(); const formId = random();
+      challenges.set(formId, { session, nonce, expires: now + lifetime });
+      const html = readFileSync(new URL('index.html', root), 'utf8').replace('__FORM_NONCE__', nonce).replace('__FORM_ID__', formId);
+      return new Response(html, { headers: { ...baseHeaders, 'Content-Type': 'text/html; charset=utf-8', 'Set-Cookie': `${cookieName}=${session}; HttpOnly; SameSite=Lax; Path=/; Max-Age=600${secure ? '; Secure' : ''}`, ...(trialToken ? { 'Origin-Trial': trialToken } : {}) } });
+    }
+    if (request.method === 'GET' && ['/styles.css', '/signup.js'].includes(path)) return new Response(readFileSync(new URL(path.slice(1), root)), { headers: { ...baseHeaders, 'Content-Type': path.endsWith('.css') ? 'text/css' : 'text/javascript' } });
+    if (path !== '/api/verify-email') return json(404, 'This page could not be found.');
+    if (request.method !== 'POST') return new Response(null, { status: 405, headers: { ...baseHeaders, Allow: 'POST' } });
+    if (request.headers.get('origin') !== origin) return json(403, 'Please sign up from the Daily Grind homepage.');
+    const rate = attempts.get(client) ?? { count: 0, expires: now + 60000 };
+    if (attempts.size >= 10000 && !attempts.has(client)) return json(429, 'Please try again in a minute.');
+    attempts.set(client, rate);
+    if (++rate.count > 12) return json(429, 'Please try again in a minute.');
+    if (!request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) return json(415, 'Please use the sign-up form.');
+    const body = await request.text();
+    if (Buffer.byteLength(body) > 40000) return json(413, 'The submitted form is too large.');
+    const form = new URLSearchParams(body);
+    const formId = form.get('formId');
+    const challenge = challenges.get(formId);
+    // Consume synchronously before any asynchronous verification; replay always fails.
+    challenges.delete(formId);
+    const session = request.headers.get('cookie')?.split(';').map(s => s.trim()).find(s => s.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    if (!challenge || challenge.session !== session) return json(409, 'Your sign-up form has expired. Reload this page to try again.');
+    const email = (form.get('email') ?? '').trim();
+    const firstName = (form.get('firstName') ?? '').trim();
+    const lastName = (form.get('lastName') ?? '').trim();
+    if (!/^[^\s@]+@[a-z\d](?:[a-z\d.-]*[a-z\d])?\.[a-z]{2,}$/i.test(email) || email.length > 254 || !firstName || firstName.length > 80 || !lastName || lastName.length > 80) return json(400, 'Please enter your name and a valid email address, then try again with a fresh form.');
+    const rawToken = form.get('token') ?? '';
+    if (!rawToken) return json(422, 'Your email hasn’t been verified. Use a browser that supports email verification, and sign in to your participating email provider in the same browser. Then reload to try again. No email was sent.');
+    try { await verify({ rawToken, email, nonce: challenge.nonce, audience: origin }); }
+    catch { return json(422, 'We couldn’t securely verify your email. Check that you’re signed in to your email provider, then reload to try again. No email was sent.'); }
+    try { await saveMember({ firstName, lastName, email, marketing: form.get('marketing') === 'yes' }); }
+    catch { return json(503, 'We couldn’t save your membership. Please try again with a fresh form.'); }
+    return json(200, 'You’re one of the regulars! Your email is verified and your Daily Grind Rewards membership is ready.');
+  };
+}
