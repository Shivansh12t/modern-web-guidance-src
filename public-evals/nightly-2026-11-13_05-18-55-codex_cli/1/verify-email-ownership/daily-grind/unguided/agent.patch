diff --git a/test/rewards.test.mjs b/test/rewards.test.mjs
new file mode 100644
index 0000000..7c4c097
--- /dev/null
+++ b/test/rewards.test.mjs
@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { createApp, createMemberStore } from '../lib/app.mjs';
+import { verifyEmailToken, publicJson } from '../lib/verification.mjs';
+
+const origin = 'https://coffee.example';
+const issuer = 'https://issuer.example';
+const email = 'Jamie@example.com';
+const nonce = 'test-single-use-nonce';
+const now = Math.floor(Date.now() / 1000);
+const issuerKeys = await generateKeyPair('ES256');
+const holderKeys = await generateKeyPair('ES256');
+const jwk = { ...await exportJWK(holderKeys.publicKey), alg: 'ES256' };
+const issuerJwk = await exportJWK(issuerKeys.publicKey);
+const deps = {
+  txt: async () => [['iss=issuer.example']],
+  json: async url => url.endsWith('/.well-known/email-verification') ? { issuer, jwks_uri: `${issuer}/keys` } : { keys: [issuerJwk] },
+};
+async function token({ claims = {}, kb = {}, signer = issuerKeys.privateKey, holderSigner = holderKeys.privateKey } = {}) {
+  const evt = await new SignJWT({ iss: issuer, email, email_verified: true, iat: now, exp: now + 300, cnf: { jwk }, ...claims }).setProtectedHeader({ alg: 'ES256', typ: 'ev+sd-jwt' }).sign(signer);
+  const hash = createHash('sha256').update(`${evt}~`).digest('base64url');
+  const binding = await new SignJWT({ iat: now, aud: origin, nonce, sd_hash: hash, ...kb }).setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' }).sign(holderSigner);
+  return `${evt}~${binding}`;
+}
+const check = rawToken => verifyEmailToken({ rawToken, email: email.toLowerCase(), nonce, audience: origin }, deps);
+test('accepts signed, provider-delegated, case-insensitive email ownership', async () => {
+  assert.equal((await check(await token())).email, email);
+});
+for (const [label, options] of [
+  ['unverified email', { claims: { email_verified: false } }],
+  ['different email', { claims: { email: 'someone@example.com' } }],
+  ['expired EVT', { claims: { exp: now - 120 } }],
+  ['missing expiry', { claims: { exp: undefined } }],
+  ['stale EVT', { claims: { iat: now - 600 } }],
+  ['wrong audience', { kb: { aud: 'https://attacker.example' } }],
+  ['wrong nonce', { kb: { nonce: 'stolen-nonce' } }],
