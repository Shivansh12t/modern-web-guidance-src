diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..97dc7dd
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,16 @@
+import { createServer } from 'node:http';
+import { createApp, createMemberStore } from './lib/app.mjs';
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) throw new Error('Production requires an HTTPS APP_ORIGIN');
+const handle = createApp({ origin, trialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN, saveMember: createMemberStore(process.env.DATA_DIR || './data') });
+createServer(async (req, res) => {
+  try {
+    const parts = []; let size = 0;
+    for await (const part of req) { size += part.length; if (size > 40000) { res.writeHead(413); res.end('Request too large'); return; } parts.push(part); }
+    const request = new Request(new URL(req.url, origin), { method: req.method, headers: req.headers, ...(['GET', 'HEAD'].includes(req.method) ? {} : { body: Buffer.concat(parts) }) });
+    const response = await handle(request, req.socket.remoteAddress);
+    res.writeHead(response.status, Object.fromEntries(response.headers));
+    res.end(Buffer.from(await response.arrayBuffer()));
+  } catch { res.writeHead(500, { 'Content-Type': 'text/plain' }); res.end('Something went wrong. Please try again.'); }
+}).listen(port, '0.0.0.0', () => console.log(`Daily Grind is listening on port ${port}`));
diff --git a/signup.js b/signup.js
new file mode 100644
index 0000000..3e0577a
--- /dev/null
+++ b/signup.js
@@ -0,0 +1,48 @@
+const form = document.querySelector('#rewards-form');
+const status = document.querySelector('#form-status');
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const button = form.querySelector('[type=submit]');
+  // FormData must be read on submit: Chrome fills the verification token here.
+  const data = new URLSearchParams(new FormData(form));
+  button.disabled = true;
+  button.textContent = 'Confirming your email…';
+  status.className = '';
+  status.textContent = 'Securely checking with your email provider…';
+  try {
+    const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
+    const result = await response.json();
+    status.className = response.ok ? '' : 'error';
+    status.textContent = result.message;
+    if (response.ok) {
+      form.querySelectorAll('input').forEach(input => { input.disabled = true; });
+      button.textContent = 'Welcome to the regulars ✓';
+    } else {
+      // A consumed nonce is never reused. A reload renders a new challenge.
+      button.textContent = 'Try again with a fresh form ↗';
+      button.type = 'button';
+      button.onclick = () => location.reload();
+      button.disabled = false;
+    }
+  } catch {
+    status.className = 'error';
+    status.textContent = 'We couldn’t confirm the result. Reload to start a fresh sign-up. No verification email was sent.';
+    button.textContent = 'Reload sign-up ↗';
+    button.type = 'button';
+    button.onclick = () => location.reload();
+    button.disabled = false;
+  }
+});
+const dialog = document.querySelector('#info-dialog');
+const copy = {
+  terms: ['Rewards Terms', 'Membership is free. Earn 10 points per $1 spent on eligible purchases. Birthday drinks and member offers are subject to availability. Your rewards membership is created only after your email is securely verified.'],
+  privacy: ['Your privacy matters.', 'We use your name and verified email to create and manage your rewards membership. We store your marketing preference and only send promotional updates if you opt in. Your email provider confirms ownership through your browser; we never receive your email password.']
+};
+document.querySelectorAll('[data-dialog]').forEach(button => button.addEventListener('click', () => {
+  const [title, text] = copy[button.dataset.dialog];
+  document.querySelector('#dialog-title').textContent = title;
+  document.querySelector('#dialog-copy').textContent = text;
+  dialog.showModal();
+}));
+document.querySelector('.close-dialog').addEventListener('click', () => dialog.close());
+window.addEventListener('pageshow', event => { if (event.persisted) location.reload(); });
