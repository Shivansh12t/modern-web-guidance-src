+import { createHash } from 'node:crypto';
+import { resolveTxt, lookup } from 'node:dns/promises';
+import { request } from 'node:https';
+import ipaddr from 'ipaddr.js';
+import { decodeSdJwtSync, getClaimsSync, SDJwtInstance } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const algorithms = ['ES256', 'EdDSA', 'Ed25519'];
+const hasher = (data, algorithm) => {
+  if (algorithm !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+const normalize = alg => alg === 'Ed25519' ? 'EdDSA' : alg;
+
+// Pin DNS resolution for each HTTPS request; reject private/reserved destinations,
+// credentials, nonstandard ports, oversized responses, and redirects.
+export async function publicJson(address) {
+  const url = new URL(address);
+  if (url.protocol !== 'https:' || url.username || url.password || (url.port && url.port !== '443')) throw new Error('Unsafe provider URL');
+  const records = await lookup(url.hostname, { all: true });
+  if (!records.length || records.some(record => ipaddr.process(record.address).range() !== 'unicast')) throw new Error('Private provider address');
+  return new Promise((resolve, reject) => {
+    const pinned = records[0];
+    const req = request(url, {
+      method: 'GET', headers: { Accept: 'application/json' },
+      lookup: (_hostname, options, done) => done(null, options.all ? [pinned] : pinned.address, pinned.family),
+    }, res => {
+      if (res.statusCode !== 200) { res.resume(); reject(new Error('Provider request failed')); return; }
+      const parts = []; let length = 0;
+      res.on('data', chunk => { length += chunk.length; if (length > 131072) res.destroy(new Error('Provider response too large')); else parts.push(chunk); });
+      res.on('error', reject);
+      res.on('end', () => { try { resolve(JSON.parse(Buffer.concat(parts).toString())); } catch (err) { reject(err); } });
+    });
+    const timer = setTimeout(() => req.destroy(new Error('Provider request timed out')), 5000);
+    req.on('close', () => clearTimeout(timer));
+    req.on('error', reject); req.end();
+  });
+}
+
+export async function verifyEmailToken({ rawToken, email, nonce, audience }, { txt = resolveTxt, json = publicJson } = {}) {
+  if (!nonce || !rawToken || rawToken.length > 32768) throw new Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const payload = getClaimsSync(decoded.jwt.payload, decoded.disclosures, hasher);
+  const issuer = payload.iss;
+  if (!decoded.kbJwt || payload.email_verified !== true || typeof payload.email !== 'string' || payload.email.toLowerCase() !== email.toLowerCase()) throw new Error('Email claim mismatch');
+  const origin = new URL(issuer);
+  if (origin.protocol !== 'https:' || origin.origin !== issuer || origin.port || origin.username || origin.password) throw new Error('Invalid issuer origin');
+  const domain = email.split('@')[1];
+  const delegation = (await txt(`_email-verification.${domain}`)).map(parts => parts.join(''));
+  if (!delegation.some(record => record.startsWith('iss=') && `https://${record.slice(4).trim()}` === issuer)) throw new Error('Issuer not delegated');
+  const metadata = await json(`${issuer}/.well-known/email-verification`);
+  if (metadata.issuer !== issuer || typeof metadata.jwks_uri !== 'string') throw new Error('Invalid issuer metadata');
+  const keys = createLocalJWKSet(await json(metadata.jwks_uri));
+  const options = { issuer, typ: 'ev+sd-jwt', algorithms, maxTokenAge: '5m', clockTolerance: 60, requiredClaims: ['iat', 'exp'] };
+  const verifier = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      try { await jwtVerify(`${data}.${sig}`, keys, options); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let valid = false;
+        for await (const key of error) {
+          try { await jwtVerify(`${data}.${sig}`, key, options); valid = true; break; } catch { /* Try the next issuer key. */ }
+        }
+        if (!valid) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const key = payload.cnf?.jwk;
+      const alg = decoded.kbJwt.header.alg;
+      if (!key || key.d || !algorithms.includes(key.alg) || !algorithms.includes(alg) || normalize(key.alg) !== normalize(alg)) throw new Error('Invalid holder key');
+      await jwtVerify(`${data}.${sig}`, await importJWK(key, alg), { typ: 'kb+jwt', audience, algorithms: [alg], maxTokenAge: '5m', clockTolerance: 60, requiredClaims: ['iat', 'aud', 'nonce'] });
+      return true;
+    },
+  });
+  await verifier.verify(rawToken, { requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: nonce, expectedKeyBindingAudience: audience, keyBindingMaxAgeSeconds: 300, skewSeconds: 60 });
+  return { email: payload.email };
+}
