+  <script>
+    const logoutTrigger = document.querySelector('.test-dialog-trigger');
+    const logoutDialog = document.getElementById('logout-dialog');
+
+    logoutTrigger.addEventListener('click', (event) => {
+      event.preventDefault();
+      logoutDialog.returnValue = '';
+      logoutDialog.showModal();
+    });
+
+    logoutDialog.addEventListener('close', () => {
+      const confirmed = logoutDialog.returnValue === 'logout';
+      logoutDialog.returnValue = '';
+      if (confirmed) window.location.assign(logoutTrigger.href);
+    });
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const isOutside = (event) => {
+        const rect = logoutDialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      let pressedOutside = false;
+      logoutDialog.addEventListener('pointerdown', (event) => {
+        pressedOutside = isOutside(event);
+      });
+      logoutDialog.addEventListener('pointerup', (event) => {
+        if (pressedOutside && isOutside(event)) logoutDialog.close();
+        pressedOutside = false;
+      });
+    }
+  </script>
+
