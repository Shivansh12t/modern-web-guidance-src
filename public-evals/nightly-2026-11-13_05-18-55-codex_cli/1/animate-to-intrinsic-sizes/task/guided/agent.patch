+  <script>
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+
+    function setCollapsed(element, collapsed) {
+      if (!collapsed) {
+        element.hidden = false;
+        // Establish the collapsed layout before transitioning to natural height.
+        element.getBoundingClientRect();
+      }
+
+      element.inert = collapsed;
+      element.classList.toggle('is-collapsed', collapsed);
+
+      if (collapsed) {
+        // Keep the content rendered until its closing transition has finished.
+        // With reduced motion there are no transitions, so hiding is immediate.
+        const transitions = element.getAnimations();
+        Promise.allSettled(transitions.map(transition => transition.finished)).then(() => {
+          // A quick reopen must not be hidden by an earlier closing animation.
+          if (element.classList.contains('is-collapsed')) element.hidden = true;
+        });
+      }
+    }
+
+    faqTrigger.addEventListener('click', () => {
+      const expanded = faqTrigger.getAttribute('aria-expanded') === 'true';
+      faqTrigger.setAttribute('aria-expanded', String(!expanded));
+      setCollapsed(faqContent, expanded);
+    });
+
+    alertDismiss.addEventListener('click', () => {
+      // Move focus to the next page control before making the alert inert.
+      if (promoAlert.contains(document.activeElement)) {
+        document.querySelector('nav a').focus({ preventScroll: true });
+      }
+      setCollapsed(promoAlert, true);
+    });
+  </script>
+
