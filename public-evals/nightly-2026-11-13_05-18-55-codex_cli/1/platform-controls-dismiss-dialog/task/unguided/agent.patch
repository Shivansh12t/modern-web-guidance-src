+  <script>
+    const dialog = document.getElementById('coffee-details');
+    const title = document.getElementById('coffee-title');
+    const description = document.getElementById('coffee-description');
+    const detailButtons = [...document.querySelectorAll('[data-coffee]')];
+    // A page-specific marker prevents unrelated history entries from opening a dialog.
+    const historyKey = `daily-grind-coffee-${Date.now()}`;
+    let returningToPage = false;
+
+    function showCoffee(button) {
+      const card = button.closest('.card');
+      title.textContent = card.querySelector('h3').textContent;
+      description.textContent = card.querySelector('p').textContent;
+      dialog.showModal();
+    }
+
+    function dismissCoffee() {
+      dialog.close();
+      if (history.state?.[historyKey] && !returningToPage) {
+        returningToPage = true;
+        history.back();
+      }
+    }
+
+    detailButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        if (returningToPage || dialog.open) return;
+        history.pushState({ ...history.state, [historyKey]: button.dataset.coffee }, '');
+        showCoffee(button);
+      });
+    });
+
+    document.getElementById('close-coffee-details').addEventListener('click', dismissCoffee);
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      dismissCoffee();
+    });
+    // Keep history in sync if the browser closes the dialog directly.
+    dialog.addEventListener('close', () => {
+      if (!dialog.open) dismissCoffee();
+    });
+    window.addEventListener('popstate', () => {
+      returningToPage = false;
+      const button = detailButtons.find((item) => item.dataset.coffee === history.state?.[historyKey]);
+      if (button && !dialog.open) {
+        button.focus();
+        showCoffee(button);
+      } else if (!button && dialog.open) {
+        dialog.close();
+      }
+    });
+  </script>
