+(() => {
+  const phoneForm = document.getElementById('phone-form');
+  const otpForm = document.getElementById('otp-form');
+  const phone = document.getElementById('phone');
+  const code = document.getElementById('otp');
+  const send = document.getElementById('send-button');
+  const verify = document.getElementById('verify-button');
+  const resend = document.getElementById('resend');
+  const change = document.getElementById('change-phone');
+  const status = document.getElementById('auth-status');
+  const challenge = document.getElementById('challenge-id');
+  let purpose = 'rewards';
+  let smsController;
+  let cooldown;
+  let busy = false;
+  let receivedCode = null;
+
+  function stopListening() {
+    smsController?.abort();
+    smsController = null;
+  }
+
+  async function listenForCode() {
+    stopListening();
+    if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController();
+    smsController = controller;
+    const timeout = setTimeout(() => controller.abort(), 120000);
+    try {
+      const credential = await navigator.credentials.get({
+        otp: { transport: ['sms'] }, signal: controller.signal,
+      });
+      if (!controller.signal.aborted && credential) {
+        receivedCode = credential.code;
+        applyReceivedCode();
+      }
+    } catch {
+      // Dismissal, timeout, and unavailable SMS access leave manual entry usable.
+    } finally {
+      clearTimeout(timeout);
+      if (smsController === controller) smsController = null;
+    }
+  }
+
+  function applyReceivedCode() {
+    if (receivedCode === null || busy || otpForm.hidden) return;
+    code.value = receivedCode;
+    receivedCode = null;
+    clearError(code);
+    otpForm.requestSubmit();
+  }
+
+  function showError(input, message) {
+    input.setAttribute('aria-invalid', 'true');
+    document.getElementById(input.id + '-error').textContent = message;
+  }
+
+  function clearError(input) {
+    input.removeAttribute('aria-invalid');
+    document.getElementById(input.id + '-error').textContent = '';
+  }
+
+  [phone, code].forEach(input => {
+    input.addEventListener('input', () => clearError(input));
+    input.addEventListener('invalid', () => {
+      showError(input, input === code ? 'Enter the complete 6-digit code from your text message.' : 'Enter your mobile number, including the country code.');
+    });
+  });
+
+  async function post(url, body) {
+    const response = await fetch(url, {
+      method: 'POST', credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(body), signal: AbortSignal.timeout(20000),
+    });
+    if (!response.ok) {
+      const error = new Error('Request failed');
+      error.status = response.status;
+      throw error;
+    }
+    return response.json();
+  }
+
+  function setBusy(value) {
+    busy = value;
+    send.disabled = value;
+    verify.disabled = value;
+    change.disabled = value;
+    phoneForm.setAttribute('aria-busy', String(value));
+    otpForm.setAttribute('aria-busy', String(value));
+  }
+
+  function startCooldown() {
+    clearInterval(cooldown);
+    let remaining = 30;
+    resend.disabled = true;
+    resend.textContent = `Resend in ${remaining}s`;
+    cooldown = setInterval(() => {
+      remaining -= 1;
+      resend.textContent = remaining > 0 ? `Resend in ${remaining}s` : 'Resend code';
+      if (remaining <= 0) {
+        clearInterval(cooldown);
+        resend.disabled = false;
+      }
+    }, 1000);
+  }
+
+  async function requestCode(isResend = false) {
+    if (busy) return;
+    stopListening();
+    receivedCode = null;
+    clearError(phone);
+    clearError(code);
+    status.textContent = '';
+    const normalizedPhone = phone.value.replace(/[\s().-]/g, '');
+    if (!/^\+[1-9][0-9]{7,14}$/.test(normalizedPhone)) {
+      showError(phone, 'Include your country code, for example +1 555 123 4567.');
+      phone.focus();
+      return;
+    }
+    purpose = phoneForm.elements.purpose.value;
+    // Listen before requesting delivery so a fast incoming SMS is not missed.
+    setBusy(true);
+    send.textContent = 'Sending your code…';
+    resend.disabled = true;
+    listenForCode();
+    try {
+      const data = await post(phoneForm.action, { phone: normalizedPhone, purpose });
+      if (typeof data.challengeId !== 'string' || !data.challengeId) throw new Error('Missing challenge');
+      challenge.value = data.challengeId;
+      document.getElementById('phone-display').textContent = phone.value;
+      code.value = '';
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      status.textContent = isResend ? 'A new code is on its way. Use the most recent text message.' : 'Your code is on its way.';
+      startCooldown();
+      code.focus();
+    } catch (error) {
+      stopListening();
+      const message = error.status === 429 ? 'Too many requests. Please wait a few minutes before trying again.' : 'We couldn’t send a code right now. Please try again shortly.';
+      showError(isResend ? code : phone, message);
+      resend.disabled = false;
+    } finally {
+      setBusy(false);
+      send.innerHTML = 'Send me a code <span aria-hidden="true">→</span>';
+      applyReceivedCode();
+    }
+  }
+
+  phoneForm.addEventListener('submit', event => {
+    event.preventDefault();
+    requestCode();
+  });
+
+  otpForm.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    stopListening();
+    clearError(code);
+    status.textContent = '';
+    if (!challenge.value) {
+      showError(code, 'Request a new code before continuing.');
+      return;
+    }
+    setBusy(true);
+    verify.textContent = 'Verifying…';
+    try {
+      const data = await post(otpForm.action, { challengeId: challenge.value, code: code.value, purpose });
+      if (data.verified !== true) throw new Error('Unverified');
+      status.textContent = 'You’re signed in. Taking you to ' + (purpose === 'order' ? 'your order…' : 'Rewards…');
+      // Use fixed destinations; never trust an arbitrary server-provided redirect.
+      window.location.assign(purpose === 'order' ? '/order-online' : '/rewards');
+    } catch (error) {
+      showError(code, error.status === 400 || error.status === 401 || error.status === 410
+        ? 'That code is incorrect or has expired. Try again or request a new code.'
+        : error.status === 429 ? 'Too many attempts. Please wait a few minutes and request a new code.'
+        : 'We couldn’t verify your code right now. Please try again.');
+      code.focus();
+    } finally {
+      setBusy(false);
+      verify.innerHTML = 'Verify &amp; continue <span aria-hidden="true">→</span>';
+    }
+  });
+
+  resend.addEventListener('click', () => requestCode(true));
+  change.addEventListener('click', () => {
+    stopListening();
+    clearInterval(cooldown);
+    receivedCode = null;
+    challenge.value = '';
+    code.value = '';
+    clearError(code);
+    status.textContent = '';
+    otpForm.hidden = true;
+    phoneForm.hidden = false;
+    phone.focus();
+  });
+
+  document.querySelectorAll('[data-purpose]').forEach(link => {
+    link.addEventListener('click', () => {
+      if (busy) return;
+      const selected = link.dataset.purpose;
+      document.getElementById(selected).checked = true;
+      purpose = selected;
+      (otpForm.hidden ? phone : code).focus({ preventScroll: true });
+    });
+  });
+  window.addEventListener('pagehide', () => {
+    stopListening();
+    clearInterval(cooldown);
+  });
+})();
