diff --git a/verification.js b/verification.js
new file mode 100644
index 0000000..42fb898
--- /dev/null
+++ b/verification.js
@@ -0,0 +1,169 @@
+(() => {
+  'use strict';
+  // Static demo only. Production must issue and verify challenges on a server.
+  const DEMO_CODE = '123456';
+  const CODE_LIFETIME = 5 * 60 * 1000;
+  const $ = (id) => document.getElementById(id);
+  const code = $('verification-code');
+  const form = $('code-form');
+  const resend = $('resend');
+  let purpose = 'rewards';
+  let expiresAt = Date.now() + CODE_LIFETIME;
+  let resendAt = 0;
+  let cooldownTimer;
+  let otpController;
+  let otpTimeout;
+  let attempts = 0;
+
+  function stopListening() {
+    if (otpController) otpController.abort();
+    clearTimeout(otpTimeout);
+  }
+
+  function listenForCode() {
+    stopListening();
+    if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    otpController = new AbortController();
+    const controller = otpController;
+    otpTimeout = setTimeout(() => controller.abort(), 60000);
+    // The SMS must end with: @your-domain.example #123456
+    // Start listening before the production server sends the SMS.
+    navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal })
+      .then((credential) => {
+        if (controller.signal.aborted || !credential || !/^\d{6}$/.test(credential.code)) return;
+        code.value = credential.code;
+        code.removeAttribute('aria-invalid');
+        $('code-error').textContent = '';
+        $('verification-status').textContent = 'Code filled from your text message. Select Verify & continue.';
+      })
+      .catch(() => { /* Manual entry and OS autofill remain available. */ })
+      .finally(() => { if (otpController === controller) clearTimeout(otpTimeout); });
+  }
+
+  function showPanel(name) {
+    for (const panel of ['code-panel', 'phone-panel', 'success-panel']) $(panel).hidden = panel !== name;
+    $('verification-status').textContent = '';
+  }
+
+  function clearError() {
+    code.removeAttribute('aria-invalid');
+    $('code-error').textContent = '';
+  }
+
+  function beginChallenge() {
+    expiresAt = Date.now() + CODE_LIFETIME;
+    attempts = 0;
+    code.value = '';
+    clearError();
+    showPanel('code-panel');
+    listenForCode();
+  }
+
+  function updateCooldown() {
+    const seconds = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
+    resend.disabled = seconds > 0;
+    resend.textContent = seconds ? `Resend in ${seconds}s` : 'Resend code';
+    if (!seconds) clearInterval(cooldownTimer);
+  }
+
+  function startCooldown() {
+    clearInterval(cooldownTimer);
+    resendAt = Date.now() + 30000;
+    updateCooldown();
+    cooldownTimer = setInterval(updateCooldown, 1000);
+  }
+
+  code.addEventListener('input', () => {
+    code.value = code.value.replace(/\D/g, '').slice(0, 6);
+    clearError();
+  });
+  // Accept codes copied from messages, including codes with spaces or hyphens.
+  code.addEventListener('paste', (event) => {
+    const pasted = event.clipboardData.getData('text').replace(/\D/g, '');
+    if (pasted.length === 6) {
+      event.preventDefault();
+      code.value = pasted;
+      clearError();
+    }
+  });
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    let error = '';
+    if (!/^\d{6}$/.test(code.value)) error = 'Enter the complete 6-digit verification code.';
+    else if (Date.now() > expiresAt) error = 'This code has expired. Select Resend code to try again.';
+    else if (attempts >= 5) error = 'Too many attempts. Select Resend code to start again.';
+    else if (code.value !== DEMO_CODE) {
+      attempts += 1;
+      error = attempts >= 5 ? 'Too many attempts. Select Resend code to start again.' : 'That code doesn’t match. For this demo, use 123456.';
+    }
+    if (error) {
+      code.setAttribute('aria-invalid', 'true');
+      $('code-error').textContent = error;
+      code.focus();
+      return;
+    }
+    stopListening();
+    showPanel('success-panel');
+    const isOrder = purpose === 'order';
+    $('continue-link').href = isOrder ? '/order-online' : '/rewards';
+    $('continue-link').firstChild.textContent = isOrder ? 'Explore online ordering ' : 'Explore Rewards ';
+    $('success-panel').focus();
+  });
+
+  $('change-number').addEventListener('click', () => {
+    stopListening();
+    showPanel('phone-panel');
+    $('phone-error').textContent = '';
+    $('phone-number').removeAttribute('aria-invalid');
+    $('phone-number').focus();
+  });
+  $('cancel-change').addEventListener('click', () => {
+    showPanel('code-panel');
+    listenForCode();
+    code.focus();
+  });
+  $('phone-form').addEventListener('submit', (event) => {
+    event.preventDefault();
+    const input = $('phone-number');
+    const value = input.value.trim();
+    const digits = value.replace(/\D/g, '');
+    if (!/^\+[\d\s().-]+$/.test(value) || digits.length < 8 || digits.length > 15 || digits.startsWith('0')) {
+      input.setAttribute('aria-invalid', 'true');
+      $('phone-error').textContent = 'Enter a valid mobile number with its country code, for example +1 202 555 0123.';
+      input.focus();
+      return;
+    }
+    input.removeAttribute('aria-invalid');
+    $('phone-display').textContent = '+' + digits.slice(0, -4).replace(/\d/g, '•') + ' ' + digits.slice(-4);
+    beginChallenge();
+    startCooldown();
+    $('verification-status').textContent = 'Demo code ready. Enter 123456; no text was sent.';
+    code.focus();
+  });
+  resend.addEventListener('click', () => {
+    if (Date.now() < resendAt) return;
+    beginChallenge();
+    startCooldown();
+    $('verification-status').textContent = 'A new demo code is ready. Use 123456. It expires in 5 minutes.';
+    code.focus();
+  });
+  $('restart').addEventListener('click', () => {
+    beginChallenge();
+    code.focus();
+  });
+  document.querySelectorAll('[data-purpose]').forEach((link) => {
+    link.addEventListener('click', () => {
+      purpose = link.dataset.purpose;
+      if (!$('success-panel').hidden) beginChallenge();
+      requestAnimationFrame(() => {
+        if (!$('code-panel').hidden) code.focus({ preventScroll: true });
+      });
+    });
+  });
+  window.addEventListener('pagehide', () => {
+    stopListening();
+    clearInterval(cooldownTimer);
+  });
+  listenForCode();
+})();
