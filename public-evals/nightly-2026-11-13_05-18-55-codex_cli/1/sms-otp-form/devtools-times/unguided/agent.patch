+export const normalizePhone = (value: string) => value.replace(/[\s().-]/g, '');
+export const validPhone = (value: string) => /^\+[1-9]\d{7,14}$/.test(value);
+export const validPassword = (value: string) => value.length >= 8 && /\d/.test(value);
diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..a317431
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,74 @@
+import type { APIRoute } from 'astro';
+import { normalizePhone, validPhone, validPassword } from '../../lib/signup';
+
+const reply = (status: number, body: Record<string, unknown>) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+
+export const POST: APIRoute = async ({ request, url }) => {
+  if (request.headers.get('origin') !== url.origin) {
+    return reply(403, { error: 'Please submit this form from this website.' });
+  }
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return reply(400, { error: 'Invalid request.' });
+  }
+  if (!body || typeof body.phone !== 'string') return reply(400, { error: 'Enter a phone number.' });
+  const phone = normalizePhone(body.phone);
+  if (!validPhone(phone)) return reply(400, { error: 'Enter a valid phone number including the country code.' });
+  if (body.action !== 'send' && body.action !== 'verify') return reply(400, { error: 'Invalid request.' });
+  if (body.action === 'verify' && (
+    typeof body.code !== 'string' || !/^\d{6}$/.test(body.code) ||
+    typeof body.username !== 'string' || !body.username.trim() ||
+    typeof body.password !== 'string' || !validPassword(body.password)
+  )) return reply(400, { error: 'Enter your username, a valid password, and the six-digit code.' });
+
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) {
+    return reply(503, { error: 'Phone verification is currently unavailable. Please try again later.' });
+  }
+  try {
+    const sending = body.action === 'send';
+    const params = new URLSearchParams(sending ? { To: phone, Channel: 'sms' } : { To: phone, Code: body.code });
+    if (sending && process.env.TWILIO_VERIFY_TEMPLATE_SID) params.set('TemplateSid', process.env.TWILIO_VERIFY_TEMPLATE_SID);
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(service)}/${sending ? 'Verifications' : 'VerificationCheck'}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: params,
+      signal: AbortSignal.timeout(15000),
+    });
+    const result = await response.json();
+    if (response.status === 429 || result.code === 60203 || result.code === 60202) {
+      return reply(429, { error: 'Too many attempts. Please wait a few minutes before trying again.' });
+    }
+    if (!response.ok) {
+      if (response.status === 404 && !sending) return reply(400, { error: 'This code has expired or was already used. Request a new code.' });
+      return reply(400, { error: sending ? 'We could not send a code to that number. Check the number and try again.' : 'We could not verify this code. Check it or request a new code.' });
+    }
+    if (sending) return reply(200, { sent: true });
+    if (result.status !== 'approved') return reply(400, { error: 'The code is incorrect. Please try again.' });
+
+    // Only create the account after the SMS provider confirms ownership.
+    const registration = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password, phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!registration.ok) {
+      return reply(400, { error: 'Your number was verified, but registration failed. Check your username, then request a new code and try again.', restart: true });
+    }
+    return reply(200, { registered: true });
+  } catch {
+    return reply(503, { error: 'The service could not be reached. Please request a new code and try again.', restart: body.action === 'verify' });
+  }
+};
