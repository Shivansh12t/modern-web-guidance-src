+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { handleSignup } from '../src/server/signup.ts';
+import { normalizePhone } from '../src/utils/phone.ts';
+
+const config = { accountSid: 'account', authToken: 'secret', serviceSid: 'service', templateSid: 'template' };
+const phone = '+14155552671';
+const details = { action: 'register', username: 'reader', password: 'password1', phone, code: '012345' };
+const challenge = () => ({ phone, sid: 'challenge', expiresAt: Date.now() + 600000, verified: false });
+const request = (body: object, origin = 'https://news.example') => new Request('https://news.example/devtools-times/api/signup', {
+  method: 'POST', headers: { origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+});
+function session(initial: Record<string, unknown> = {}) {
+  const store = new Map(Object.entries(initial));
+  return { get: async (key: string) => store.get(key), set: (key: string, value: unknown) => { store.set(key, value); }, delete: (key: string) => { store.delete(key); } };
+}
+const neverFetch = async () => { throw new Error('Unexpected network request'); };
+
+test('normalizes international phone formatting without dropping country code', () => {
+  assert.equal(normalizePhone('+1 (415) 555-2671'), phone);
+});
+test('rejects cross-origin calls and unavailable configuration', async () => {
+  assert.equal((await handleSignup(request(details, 'https://other.example'), session(), config, neverFetch)).status, 403);
+  assert.equal((await handleSignup(request(details), session(), {}, neverFetch)).status, 503);
+});
+test('requires valid phone, credentials, challenge and matching number before registration', async () => {
+  for (const body of [{ ...details, phone: '4155552671' }, { ...details, password: 'short' }, details]) {
+    assert.equal((await handleSignup(request(body), session(), config, neverFetch)).status, 400);
+  }
+  const state = session({ signupChallenge: challenge() });
+  assert.equal((await handleSignup(request({ ...details, phone: '+442079460123' }), state, config, neverFetch)).status, 400);
+});
+test('sends via approved template, binds challenge, and enforces resend cooldown across numbers', async () => {
