new file mode 100644
index 0000000..f4aaff9
--- /dev/null
+++ b/src/server/signup.ts
@@ -0,0 +1,116 @@
+import { normalizePhone } from '../utils/phone';
+
+interface Challenge {
+  phone: string;
+  sid: string;
+  expiresAt: number;
+  verified: boolean;
+}
+
+interface SignupSession {
+  get(key: string): Promise<unknown>;
+  set(key: string, value: unknown): void | Promise<void>;
+  delete(key: string): void;
+}
+
+export interface SignupConfig {
+  accountSid?: string;
+  authToken?: string;
+  serviceSid?: string;
+  templateSid?: string;
+}
+
+const json = (body: object, status = 200) => Response.json(body, {
+  status,
+  headers: { 'Cache-Control': 'no-store' },
+});
+
+export async function handleSignup(request: Request, session: SignupSession | undefined,
+  config: SignupConfig, fetcher: typeof fetch = fetch) {
+  // This app disables Astro's global origin check; enforce it for this sensitive route.
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return json({ error: 'Please submit this form from the sign-up page.' }, 403);
+  }
+  if (!session) return json({ error: 'Sign-up is temporarily unavailable.' }, 503);
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+  const { action, username, password, code } = body;
+  const phone = typeof body.phone === 'string' ? normalizePhone(body.phone) : '';
+  if (!/^\+[1-9][0-9]{7,14}$/.test(phone)) {
+    return json({ error: 'Enter a phone number with its country code, such as +14155552671.' }, 400);
+  }
+  if (!['send', 'register'].includes(action)) return json({ error: 'Invalid action.' }, 400);
+  const { accountSid, authToken, serviceSid, templateSid } = config;
+  if (!accountSid || !authToken || !serviceSid || !templateSid) {
+    return json({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+  }
+  const verify = async (resource: string, params: Record<string, string>) => {
+    const response = await fetcher(`https://verify.twilio.com/v2/Services/${encodeURIComponent(serviceSid)}/${resource}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${accountSid}:${authToken}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams(params),
+      signal: AbortSignal.timeout(15000),
+    });
+    return { response, data: await response.json() };
+  };
+  try {
+    if (action === 'send') {
+      const nextSendAt = Number(await session.get('signupNextSendAt')) || 0;
+      if (nextSendAt > Date.now()) {
+        return json({ error: 'Please wait before requesting another code.', retryAfter: Math.ceil((nextSendAt - Date.now()) / 1000) }, 429);
+      }
+      // Reserve the cooldown even when the provider fails; changing numbers cannot bypass it.
+      await session.set('signupNextSendAt', Date.now() + 30000);
+      session.delete('signupChallenge');
+      const { response, data } = await verify('Verifications', {
+        To: phone, Channel: 'sms', TemplateSid: templateSid,
+      });
+      if (!response.ok || data.status !== 'pending' || typeof data.sid !== 'string') {
+        return json({ error: response.status === 429 ? 'Too many requests. Please try again later.' : 'We could not send a code. Check your number and try again.' }, response.status === 429 ? 429 : 502);
+      }
+      await session.set('signupChallenge', { phone, sid: data.sid, expiresAt: Date.now() + 600000, verified: false });
+      return json({ sent: true, retryAfter: 30 });
+    }
+
+    if (typeof username !== 'string' || !username.trim() || username.length > 100 ||
+      typeof password !== 'string' || password.length < 8 || password.length > 1024 || !/[0-9]/.test(password)) {
+      return json({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+    }
+    const challenge = await session.get('signupChallenge') as Challenge | undefined;
+    if (!challenge || challenge.phone !== phone || challenge.expiresAt <= Date.now()) {
+      return json({ error: 'Your code has expired. Request another code.', codeExpired: true }, 400);
+    }
+    if (!challenge.verified) {
+      if (typeof code !== 'string' || !/^[0-9]{6}$/.test(code)) {
+        return json({ error: 'Enter the 6-digit code from your SMS.', invalidCode: true }, 400);
+      }
+      const { response, data } = await verify('VerificationCheck', { VerificationSid: challenge.sid, Code: code });
+      if (!response.ok || data.status !== 'approved') {
+        const expired = response.status === 404 || data.status === 'max_attempts_reached' || data.status === 'expired';
+        if (expired) session.delete('signupChallenge');
+        return json({ error: expired ? 'Your code has expired or reached its attempt limit. Request another code.' : 'The code could not be verified. Check it and try again.', codeExpired: expired, invalidCode: !expired }, 400);
+      }
+      // Keep the verified result for a retry if account creation fails after Twilio consumes the code.
+      challenge.verified = true;
+      await session.set('signupChallenge', challenge);
+    }
+    const response = await fetcher('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Account creation failed. Try a different username or try again later.' }, 502);
+    session.delete('signupChallenge');
+    return json({ registered: true });
+  } catch {
+    return json({ error: 'We could not connect. Please try again.' }, 502);
+  }
+}
