+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const buttons = [...toolbar.querySelectorAll('button')];
+    const drinks = document.getElementById('favorites-drinks');
+    const cards = [...drinks.querySelectorAll('.card')];
+    const filters = document.getElementById('favorites-filters');
+    const temperature = document.getElementById('favorites-temperature');
+    const status = document.getElementById('favorites-status');
+
+    toolbar.querySelectorAll('[data-view]').forEach(button => {
+      button.addEventListener('click', () => {
+        toolbar.querySelectorAll('[data-view]').forEach(view => {
+          view.setAttribute('aria-pressed', String(view === button));
+        });
+        drinks.classList.toggle('list-view', button.dataset.view === 'list');
+      });
+    });
+
+    document.getElementById('favorites-details-toggle').addEventListener('click', event => {
+      const button = event.currentTarget;
+      const show = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(show));
+      drinks.classList.toggle('details-hidden', !show);
+    });
+
+    function filterDrinks() {
+      cards.forEach(card => {
+        card.hidden = !filters.hidden && temperature.value !== 'all' &&
+          card.dataset.temperature !== temperature.value;
+      });
+    }
+
+    document.getElementById('favorites-filters-toggle').addEventListener('click', event => {
+      filters.hidden = !filters.hidden;
+      event.currentTarget.setAttribute('aria-pressed', String(!filters.hidden));
+      event.currentTarget.setAttribute('aria-expanded', String(!filters.hidden));
+      filterDrinks();
+    });
+    temperature.addEventListener('change', filterDrinks);
+
+    let feedbackTimer;
+    let lastMessage = '';
+    async function copyDrinks() {
+      let message;
+      try {
+        const text = cards.map(card =>
+          `${card.querySelector('h3').textContent}: ${card.querySelector('p').textContent}`
+        ).join('\n');
+        await navigator.clipboard.writeText(`Seasonal Favorites\n${text}`);
+        message = 'Featured drinks copied.';
+      } catch {
+        message = 'Could not copy the drinks. Please try again.';
+      }
+      clearTimeout(feedbackTimer);
+      if (message === lastMessage) message += '\u00a0';
+      lastMessage = message;
+      status.textContent = message;
+      feedbackTimer = setTimeout(() => { status.textContent = ''; }, 4000);
+    }
+
+    if ('CommandEvent' in window) {
+      drinks.addEventListener('command', event => {
+        if (event.command === '--copy') copyDrinks();
+      });
+    } else {
+      document.getElementById('favorites-copy').addEventListener('click', copyDrinks);
+    }
+
+    // Native focusgroup handles navigation where supported; avoid double handling.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      buttons.forEach((button, index) => { button.tabIndex = index ? -1 : 0; });
+      toolbar.addEventListener('focusin', event => {
+        if (buttons.includes(event.target)) {
+          buttons.forEach(button => { button.tabIndex = button === event.target ? 0 : -1; });
+        }
+      });
+      toolbar.addEventListener('keydown', event => {
+        const index = buttons.indexOf(event.target);
+        if (index < 0) return;
+        const rtl = getComputedStyle(toolbar).direction === 'rtl';
+        const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[event.key];
+        let next;
+        if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = buttons.length - 1;
+        else if (step) next = (index + step + buttons.length) % buttons.length;
+        else return;
+        event.preventDefault();
+        buttons[next].focus();
+      });
+    }
+
+    if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+      buttons.forEach((button, index) => {
+        const tip = document.createElement('div');
+        tip.id = `favorites-tip-${index}`;
+        tip.textContent = button.title;
+        tip.setAttribute('popover', 'hint');
+        button.setAttribute('interestfor', tip.id);
+        button.removeAttribute('title');
+        document.body.append(tip);
+      });
+    }
+  </script>
+
