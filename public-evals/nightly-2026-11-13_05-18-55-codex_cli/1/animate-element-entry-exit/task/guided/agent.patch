+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const offers = [
+      ['A Treat for Two', 'Bring a friend and enjoy two lattes for the price of one.'],
+      ['Make Mornings Sweeter', 'Get a complimentary cookie with your morning espresso.'],
+      ['Take the Grind Home', 'Save 15% on a bag of our locally roasted coffee beans.']
+    ];
+    let promoCount = 0;
+    let toggleVersion = 0;
+
+    function updateRemoveButton() {
+      removeBtn.disabled = !domContainer.querySelector('.card:not([data-closing])');
+    }
+
+    async function finishExit(card) {
+      // Keep display intact during the exit, including in browsers that cannot
+      // transition display. getAnimations also handles reduced-motion timing.
+      card.setAttribute('data-closing', '');
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(card.getAnimations().map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+    }
+
+    addBtn.addEventListener('click', () => {
+      const [title, description] = offers[promoCount++ % offers.length];
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+      const paragraph = document.createElement('p');
+      paragraph.textContent = description;
+      card.append(heading, paragraph);
+      domContainer.append(card);
+      updateRemoveButton();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-closing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+      const exit = finishExit(card);
+      updateRemoveButton();
+      await exit;
+      card.remove();
+      updateRemoveButton();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      const version = ++toggleVersion;
+      const show = toggleBtn.getAttribute('aria-expanded') !== 'true';
+      toggleBtn.setAttribute('aria-expanded', String(show));
+      if (show) {
+        toggleCard.removeAttribute('data-closing');
+        toggleCard.hidden = false;
+      } else {
+        await finishExit(toggleCard);
+        // A later click can reverse an exit before it finishes.
+        if (version !== toggleVersion) return;
+        toggleCard.hidden = true;
+        toggleCard.removeAttribute('data-closing');
+      }
+    });
+  </script>
+
 </body>
 
