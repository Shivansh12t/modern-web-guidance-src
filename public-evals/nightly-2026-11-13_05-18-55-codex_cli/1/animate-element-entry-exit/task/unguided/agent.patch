+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const animations = new WeakMap();
+    const exiting = new WeakSet();
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const offers = [
+      ['An Afternoon Pick-Me-Up', 'Make your afternoon brighter with a smooth, refreshing cold brew.'],
+      ['Your Next Favorite', 'Explore our seasonal latte with a cozy touch of maple.'],
+      ['Share a Coffee Break', 'Bring a friend and catch up over your favorite freshly roasted blends.']
+    ];
+    let promoCount = 0;
+
+    async function showCard(card, visible, remove = false) {
+      // Capture the current frame so a quick toggle reverses smoothly.
+      const current = getComputedStyle(card);
+      const start = card.hidden
+        ? { opacity: 0, transform: 'scale(0.92)' }
+        : { opacity: current.opacity, transform: current.transform };
+      animations.get(card)?.cancel();
+      card.hidden = false;
+      if (visible) exiting.delete(card);
+      else exiting.add(card);
+
+      const animation = card.animate([
+        start,
+        { opacity: visible ? 1 : 0, transform: visible ? 'scale(1)' : 'scale(0.92)' }
+      ], {
+        duration: reducedMotion.matches ? 0 : 260,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+      animations.set(card, animation);
+
+      try {
+        await animation.finished;
+        if (!visible) {
+          if (remove) card.remove();
+          else card.hidden = true;
+        }
+        animation.cancel();
+        animations.delete(card);
+        exiting.delete(card);
+      } catch {
+        // A newer interaction takes over when this animation is cancelled.
+      }
+    }
+
+    document.getElementById('addBtn').addEventListener('click', () => {
+      const [title, description] = offers[promoCount++ % offers.length];
+      const card = document.createElement('article');
+      card.className = 'card';
+      const label = document.createElement('span');
+      label.className = 'promo-label';
+      label.textContent = 'Special promo';
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+      const copy = document.createElement('p');
+      copy.textContent = description;
+      card.append(label, heading, copy);
+      card.hidden = true;
+      domContainer.append(card);
+      showCard(card, true);
+    });
+
+    document.getElementById('removeBtn').addEventListener('click', () => {
+      const card = [...domContainer.querySelectorAll('.card')]
+        .reverse().find(card => !card.hidden && !exiting.has(card));
+      if (!card) return;
+      if (card === toggleCard) toggleBtn.setAttribute('aria-expanded', 'false');
+      showCard(card, false, card !== toggleCard);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const visible = toggleBtn.getAttribute('aria-expanded') !== 'true';
+      toggleBtn.setAttribute('aria-expanded', String(visible));
+      showCard(toggleCard, visible);
+    });
+
+    toggleCard.hidden = true;
+    showCard(toggleCard, true);
+  </script>
+
