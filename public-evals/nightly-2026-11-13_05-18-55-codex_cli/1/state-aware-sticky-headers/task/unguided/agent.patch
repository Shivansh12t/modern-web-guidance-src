+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const supportsScrollState = CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let framePending = false;
+
+    function updateStickyHeaders() {
+      framePending = false;
+      if (supportsScrollState) return;
+
+      for (const container of stickyContainers) {
+        const bounds = container.getBoundingClientRect();
+        const sectionBounds = container.parentElement.getBoundingClientRect();
+        const isStuck = bounds.top <= navigationHeight + 1 &&
+          sectionBounds.bottom > navigationHeight + bounds.height;
+        container.classList.toggle('is-stuck', isStuck);
+      }
+    }
+
+    function scheduleUpdate() {
+      if (framePending) return;
+      framePending = true;
+      requestAnimationFrame(updateStickyHeaders);
+    }
+
+    new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      scheduleUpdate();
+    }).observe(navigation);
+
+    // The viewport remains the scroll root; no nested scrolling area is created.
+    if (!supportsScrollState) {
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+    }
+  </script>
