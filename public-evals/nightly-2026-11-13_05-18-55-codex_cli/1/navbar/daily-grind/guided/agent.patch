+  <script>
+    (() => {
+      const header = document.querySelector('.site-header');
+      const inner = header.querySelector('.header-inner');
+      const menu = document.querySelector('#site-menu');
+      const menuButton = header.querySelector('.menu-button');
+      const submenu = document.querySelector('#menu-categories');
+      const submenuButton = header.querySelector('.submenu-button');
+      const dropdown = header.querySelector('.nav-dropdown');
+      const nativePopover = 'popover' in HTMLElement.prototype;
+      let wide = false;
+      let lastWidth = 0;
+      let preview = false;
+
+      const isOpen = element => nativePopover
+        ? element.matches(':popover-open') : element.classList.contains('fallback-open');
+      const setOpen = (element, open, source) => {
+        if (nativePopover) {
+          if (isOpen(element) !== open) {
+            if (open) element.showPopover({ source });
+            else element.hidePopover();
+          }
+        } else {
+          element.classList.toggle('fallback-open', open);
+          element.hidden = !open;
+        }
+      };
+      const positionSubmenu = () => {
+        if (!wide || !isOpen(submenu)) return;
+        if (nativePopover && CSS.supports('position-area', 'block-end')) return;
+        const trigger = submenuButton.getBoundingClientRect();
+        const size = submenu.getBoundingClientRect();
+        submenu.style.top = `${Math.max(8, trigger.bottom + size.height + 8 > innerHeight ? trigger.top - size.height - 8 : trigger.bottom + 8)}px`;
+        submenu.style.left = `${Math.max(8, Math.min(trigger.left, innerWidth - size.width - 8))}px`;
+      };
+      const syncSubmenu = () => {
+        submenuButton.setAttribute('aria-expanded', String(wide ? isOpen(submenu) : !submenu.hidden));
+        positionSubmenu();
+      };
+      const closeSubmenu = () => {
+        if (wide) setOpen(submenu, false);
+        else submenu.hidden = true;
+        preview = false;
+        syncSubmenu();
+      };
+
+      // Normalize trailing slashes while keeping exact page matches.
+      const normalize = path => path.replace(/\/+$/, '') || '/';
+      const path = normalize(location.pathname);
+      header.querySelectorAll('a[href]').forEach(link => {
+        if (normalize(new URL(link.href).pathname) === path) link.setAttribute('aria-current', 'page');
+      });
+      if (path.startsWith('/menu/')) {
+        dropdown.querySelector('a').setAttribute('aria-current', 'true');
+      }
+
+      const layout = () => {
+        const width = inner.clientWidth;
+        if (!wide && width <= lastWidth) return;
+        lastWidth = width;
+        const menuWasOpen = !wide && isOpen(menu);
+        const focusWasInside = menu.contains(document.activeElement);
+        const focusWasButton = document.activeElement === menuButton;
+        if (nativePopover && isOpen(menu)) menu.hidePopover();
+        menu.removeAttribute('popover');
+        menu.hidden = false;
+        header.classList.add('is-wide');
+        const nextWide = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle('is-wide', nextWide);
+        if (nextWide !== wide || !submenu.hasAttribute('data-ready')) {
+          if (wide && isOpen(submenu)) setOpen(submenu, false);
+          submenu.style.top = '';
+          submenu.style.left = '';
+          submenu.classList.remove('fallback-open');
+          if (nextWide && nativePopover) submenu.setAttribute('popover', 'auto');
+          else submenu.removeAttribute('popover');
+          submenu.hidden = !nextWide || !nativePopover;
+          submenu.setAttribute('data-ready', '');
+          submenuButton.setAttribute('aria-expanded', 'false');
+          preview = false;
+        }
+        wide = nextWide;
+        if (!wide) {
+          menu.setAttribute('popover', 'auto');
+          menu.style.setProperty('--menu-top', `${menuButton.getBoundingClientRect().bottom}px`);
+          if (nativePopover) {
+            if (menuWasOpen) menu.showPopover();
+          } else setOpen(menu, menuWasOpen);
+          if (focusWasInside && !menuWasOpen) menuButton.focus();
+        } else {
+          menu.classList.remove('fallback-open');
+          if (focusWasButton) menu.querySelector('a').focus();
+        }
+        menuButton.setAttribute('aria-expanded', String(!wide && isOpen(menu)));
+        positionSubmenu();
+      };
+
+      menuButton.addEventListener('click', () => {
+        if (!nativePopover) {
+          setOpen(menu, !isOpen(menu));
+          menuButton.setAttribute('aria-expanded', String(isOpen(menu)));
+        }
+      });
+      menu.addEventListener('toggle', () => {
+        menuButton.setAttribute('aria-expanded', String(!wide && isOpen(menu)));
+        if (!wide && !isOpen(menu)) closeSubmenu();
+      });
+      submenuButton.addEventListener('click', event => {
+        if (!wide) {
+          submenu.hidden = !submenu.hidden;
+          syncSubmenu();
+        } else if (preview) {
+          event.preventDefault();
+          preview = false;
+        } else if (!nativePopover) {
+          setOpen(submenu, !isOpen(submenu));
+          syncSubmenu();
+        }
+      });
+      submenu.addEventListener('toggle', syncSubmenu);
+      dropdown.addEventListener('pointerenter', event => {
+        if (wide && event.pointerType !== 'touch' && matchMedia('(hover: hover)').matches && !isOpen(submenu)) {
+          preview = true;
+          setOpen(submenu, true, submenuButton);
+          syncSubmenu();
+        }
+      });
+      dropdown.addEventListener('pointerleave', () => { if (preview) closeSubmenu(); });
+      dropdown.addEventListener('focusout', event => {
+        if (event.relatedTarget && !dropdown.contains(event.relatedTarget)) closeSubmenu();
+      });
+      // Older browsers get the same controls with manual light dismissal.
+      if (!nativePopover) {
+        document.addEventListener('click', event => {
+          if (!dropdown.contains(event.target)) closeSubmenu();
+          if (!wide && !header.contains(event.target)) {
+            setOpen(menu, false);
+            menuButton.setAttribute('aria-expanded', 'false');
+          }
+        });
+      }
+      header.addEventListener('keydown', event => {
+        if (event.key !== 'Escape') return;
+        if (!wide && !submenu.hidden) {
+          closeSubmenu();
+          submenuButton.focus();
+          event.preventDefault();
+        } else if (!nativePopover) {
+          if (wide && isOpen(submenu)) { closeSubmenu(); submenuButton.focus(); }
+          else if (!wide && isOpen(menu)) {
+            setOpen(menu, false);
+            menuButton.setAttribute('aria-expanded', 'false');
+            menuButton.focus();
+          }
+        }
+      });
+      layout();
+      const observer = new ResizeObserver(layout);
+      observer.observe(inner);
+      observer.observe(menu);
+      window.addEventListener('resize', positionSubmenu);
+      window.addEventListener('scroll', positionSubmenu, { passive: true });
+    })();
+  </script>
 </body>
 
