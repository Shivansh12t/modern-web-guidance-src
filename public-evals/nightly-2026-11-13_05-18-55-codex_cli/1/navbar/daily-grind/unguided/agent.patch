+  <script>
+    const navigation = document.querySelector('.site-nav');
+    const navToggle = navigation.querySelector('.nav-toggle');
+    const navLinks = navigation.querySelector('.nav-links');
+    const submenuToggle = navigation.querySelector('.submenu-toggle');
+    const submenu = navigation.querySelector('.submenu');
+    const narrowViewport = window.matchMedia('(max-width: 58rem)');
+
+    function setSubmenu(open) {
+      submenuToggle.setAttribute('aria-expanded', String(open));
+      submenu.hidden = !open;
+    }
+
+    function setNavigation(open) {
+      navToggle.setAttribute('aria-expanded', String(open));
+      navLinks.classList.toggle('is-open', open);
+      if (!open) setSubmenu(false);
+    }
+
+    navToggle.addEventListener('click', () => {
+      setNavigation(navToggle.getAttribute('aria-expanded') !== 'true');
+    });
+    submenuToggle.addEventListener('click', () => {
+      setSubmenu(submenu.hidden);
+    });
+    document.addEventListener('click', (event) => {
+      if (!navigation.contains(event.target)) setNavigation(false);
+    });
+    navigation.addEventListener('keydown', (event) => {
+      if (event.key !== 'Escape') return;
+      if (!submenu.hidden) {
+        setSubmenu(false);
+        submenuToggle.focus();
+      } else if (navToggle.getAttribute('aria-expanded') === 'true') {
+        setNavigation(false);
+        navToggle.focus();
+      }
+    });
+    navigation.addEventListener('focusout', (event) => {
+      if (!navigation.contains(event.relatedTarget)) setNavigation(false);
+    });
+    narrowViewport.addEventListener('change', () => {
+      const focusWasInside = navLinks.contains(document.activeElement);
+      setNavigation(false);
+      if (narrowViewport.matches && focusWasInside) navToggle.focus();
+      else if (!narrowViewport.matches && document.activeElement === navToggle) {
+        navLinks.querySelector('a').focus();
+      }
+    });
+
+    const normalizePath = (path) => path.replace(/\/+$/, '') || '/';
+    const currentPath = normalizePath(window.location.pathname);
+    navigation.querySelectorAll('a').forEach((link) => {
+      if (normalizePath(new URL(link.href).pathname) === currentPath) {
+        link.setAttribute('aria-current', 'page');
+      }
+    });
+    if (currentPath.startsWith('/menu/')) {
+      navigation.querySelector('.menu-item > a').classList.add('is-active');
+    }
+  </script>
 </body>
 
