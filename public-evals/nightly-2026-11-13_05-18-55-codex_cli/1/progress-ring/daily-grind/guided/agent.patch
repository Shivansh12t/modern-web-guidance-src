+    /* Loyalty Rewards */
+    .loyalty-section {
+      margin-top: 40px;
+    }
+
+    .loyalty-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .loyalty-card {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      padding: 32px;
+      border-top: 4px solid var(--accent);
+    }
+
+    .reward-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex: 0 0 180px;
+      width: 180px;
+      height: 180px;
+    }
+
+    .reward-ring {
+      --thickness: 12px;
+      --fill-color: var(--primary);
+      --track-color: var(--secondary);
+      appearance: none;
+      display: block;
+      width: 100%;
+      height: 100%;
+      border: var(--thickness) solid transparent;
+      border-radius: 50%;
+      background: conic-gradient(var(--fill-color) calc(var(--value) * 1%), var(--track-color) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+    }
+
+    .reward-ring::-webkit-progress-bar,
+    .reward-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    .reward-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    @supports not (background-clip: border-area) {
+      .reward-ring {
+        border: 0;
+        mask-image: radial-gradient(circle closest-side, transparent calc(100% - var(--thickness)), black calc(100% - var(--thickness) + 0.5px));
+      }
+    }
+
+    @media (forced-colors: active) {
+      .reward-ring {
+        forced-color-adjust: none;
+        --fill-color: CanvasText;
+        --track-color: Canvas;
+      }
+    }
+
+    .reward-ring-content {
+      position: absolute;
+      color: var(--primary);
+      line-height: 1.4;
+    }
+
+    .reward-ring-content strong {
+      display: block;
+      font-size: 2.25rem;
+    }
+
+    .reward-ring-content span {
+      display: block;
+      font-size: 0.85rem;
+    }
+
+    .reward-details {
+      max-width: 400px;
+      text-align: left;
+    }
+
+    .reward-label {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      border-radius: 20px;
+      padding: 3px 12px;
+      margin-bottom: 12px;
+      font-size: 0.8rem;
+      font-weight: 600;
+    }
+
+    @media (max-width: 600px) {
+      .loyalty-card {
+        flex-direction: column;
+        gap: 24px;
+        padding: 24px 20px;
+      }
+
+      .reward-details {
+        text-align: center;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
