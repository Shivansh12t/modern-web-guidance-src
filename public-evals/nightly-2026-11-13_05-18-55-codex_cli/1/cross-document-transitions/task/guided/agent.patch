+  <script>
+    const page = favoritesPage(location.href);
+    const extraFavorites = [
+      [
+        ['Pumpkin Spice Latte', 'Espresso with pumpkin spice and silky steamed milk.', '/menu/seasonal'],
+        ['Cinnamon Cappuccino', 'Rich espresso topped with foam and a dusting of cinnamon.', '/menu/espresso'],
+        ['Vanilla Cream Cold Brew', 'Slow-steeped cold brew finished with vanilla cream.', '/menu/cold-brew']
+      ],
+      [
+        ['Gingerbread Latte', 'Warming gingerbread spices paired with espresso and steamed milk.', '/menu/seasonal'],
+        ['Hazelnut Mocha', 'Chocolate and toasted hazelnut meet our signature espresso.', '/menu/espresso'],
+        ['Maple Cold Brew', 'Smooth cold brew sweetened with a touch of maple syrup.', '/menu/cold-brew']
+      ]
+    ];
+
+    if (page > 1) {
+      document.querySelectorAll('.grid .card').forEach((card, index) => {
+        const [name, description, href] = extraFavorites[page - 2][index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').setAttribute('href', href);
+      });
+    }
+
+    document.getElementById('page-number').textContent = `Page ${page} of ${totalPages}`;
+    for (const [id, target] of [['previous', page - 1], ['next', page + 1]]) {
+      const link = document.getElementById(id);
+      if (target < 1 || target > totalPages) {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+        link.setAttribute('role', 'link');
+      } else {
+        const url = new URL(location.href);
+        url.searchParams.set('page', target);
+        link.href = url.href;
+      }
+    }
+  </script>
