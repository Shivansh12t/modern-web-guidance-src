+  <script>
+    // Register before either document is captured; native links keep full-page navigation.
+    const totalPages = 3;
+    function favoritesPage(url) {
+      const page = Number(new URL(url).searchParams.get('page') || 1);
+      return Number.isInteger(page) && page >= 1 && page <= totalPages ? page : 1;
+    }
+
+    function setNavigationDirection(transition, from, to) {
+      if (!transition) return;
+      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        transition.skipTransition();
+        return;
+      }
+      if (!from || !to || !transition.types) return;
+      const source = new URL(from.url);
+      const destination = new URL(to.url);
+      if (source.origin !== destination.origin || source.pathname !== destination.pathname) return;
+      const difference = favoritesPage(destination) - favoritesPage(source);
+      if (difference) transition.types.add(difference > 0 ? 'next' : 'previous');
+    }
+
+    window.addEventListener('pageswap', (event) => {
+      setNavigationDirection(event.viewTransition, event.activation?.from, event.activation?.entry);
+    });
+    window.addEventListener('pagereveal', (event) => {
+      const activation = window.navigation?.activation;
+      setNavigationDirection(event.viewTransition, activation?.from, activation?.entry);
+    });
+  </script>
 </head>
 
