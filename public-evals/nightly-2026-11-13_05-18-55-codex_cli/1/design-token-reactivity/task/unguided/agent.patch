+  <script>
+    // Keep the control hidden unless inherited custom properties and calc() are supported.
+    if (window.CSS && CSS.supports('padding', 'var(--card-padding)') &&
+        CSS.supports('padding', 'calc(20px * 1.6)')) {
+      const toggle = document.getElementById('toggle-spacious');
+      const container = document.getElementById('target-container');
+
+      toggle.addEventListener('click', () => {
+        const spacious = toggle.getAttribute('aria-pressed') !== 'true';
+        container.style.setProperty('--card-density', spacious ? '1.6' : '1');
+        toggle.setAttribute('aria-pressed', String(spacious));
+      });
+
+      toggle.hidden = false;
+    }
+  </script>
