+  <p id="loading-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
+
+  <script>
+    const loadingLinks = document.querySelectorAll('[data-loading-message]');
+    const loadingStatus = document.getElementById('loading-status');
+
+    loadingLinks.forEach((link) => {
+      const label = link.querySelector('.btn-label');
+      const originalLabel = label.textContent;
+
+      link.addEventListener('click', (event) => {
+        // Keep opening links in other tabs/windows and modified clicks native.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey ||
+            link.hasAttribute('download') || (link.target && link.target !== '_self')) {
+          return;
+        }
+
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        label.textContent = link.dataset.loadingMessage;
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+
+      // A page restored from the back/forward cache must be usable again.
+      window.addEventListener('pageshow', () => {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        label.textContent = originalLabel;
+        loadingStatus.textContent = '';
+      });
+    });
+  </script>
+
