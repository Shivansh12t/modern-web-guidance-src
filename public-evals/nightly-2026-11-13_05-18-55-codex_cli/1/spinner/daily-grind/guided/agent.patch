+  <script>
+    const loadingLinks = document.querySelectorAll('[data-loading-message]');
+    const loadingStatus = document.getElementById('loading-status');
+    const seasonalSection = document.getElementById('seasonal-heading').closest('section');
+    const originalLabels = new Map(Array.from(loadingLinks, link =>
+      [link, link.querySelector('.btn-label').textContent]));
+
+    function resetLoading() {
+      for (const link of loadingLinks) {
+        link.setAttribute('aria-busy', 'false');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('.loading-spinner').hidden = true;
+        link.querySelector('.btn-label').textContent = originalLabels.get(link);
+      }
+      seasonalSection.setAttribute('aria-busy', 'false');
+      loadingStatus.textContent = '';
+    }
+
+    for (const link of loadingLinks) {
+      link.addEventListener('click', event => {
+        // Keep modified clicks and new-tab navigation native and idle here.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey ||
+            link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        resetLoading();
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('.loading-spinner').hidden = false;
+        link.querySelector('.btn-label').textContent = link.dataset.loadingMessage;
+        if (seasonalSection.contains(link)) seasonalSection.setAttribute('aria-busy', 'true');
+        // Keep the announcement outside the busy section so it isn't deferred.
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+    }
+
+    // Restore controls when this page returns from the back/forward cache.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
