     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const spotlightMotion = window.matchMedia(
+      '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)'
+    );
+
+    document.querySelectorAll('.product-card').forEach((card) => {
+      const resetSpotlight = () => {
+        card.style.setProperty('--inner-size', '0px');
+        card.style.setProperty('--outer-size', '0px');
+      };
+
+      const updateSpotlight = (event) => {
+        if (!spotlightMotion.matches || event.pointerType === 'touch') return;
+
+        const bounds = card.getBoundingClientRect();
+        card.style.setProperty('--mouse-x', `${event.clientX - bounds.left}px`);
+        card.style.setProperty('--mouse-y', `${event.clientY - bounds.top}px`);
+        card.style.setProperty('--inner-size', '110px');
+        card.style.setProperty('--outer-size', '160px');
+      };
+
+      card.addEventListener('pointerenter', updateSpotlight);
+      card.addEventListener('pointermove', updateSpotlight);
+      card.addEventListener('pointerleave', resetSpotlight);
+      card.addEventListener('pointercancel', resetSpotlight);
+      spotlightMotion.addEventListener('change', resetSpotlight);
+      card.classList.add('spotlight-ready');
+    });
+  </script>
 </body>
 
