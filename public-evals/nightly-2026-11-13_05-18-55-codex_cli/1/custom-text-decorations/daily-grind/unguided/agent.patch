+    /* A separate text layer reveals only the decoration, preserving native
+       ink skipping instead of drawing a solid border through descenders. */
+    .decorative-line {
+      --line-offset: 0.22em;
+      --line-inset: 0.08em;
+      --line-color: var(--accent);
+      position: relative;
+      display: inline-block;
+    }
+
+    .decorative-line::after {
+      content: attr(data-text) / "";
+      position: absolute;
+      inset: 0;
+      color: transparent;
+      pointer-events: none;
+      text-decoration-line: underline;
+      text-decoration-color: var(--line-color);
+      text-decoration-thickness: 0.08em;
+      text-underline-offset: var(--line-offset);
+      text-decoration-skip-ink: auto;
+      clip-path: inset(-0.4em calc(100% - var(--line-inset)) -0.7em var(--line-inset));
+      transition: clip-path 400ms cubic-bezier(0.22, 1, 0.36, 1);
+    }
+
+    a:hover .decorative-line::after,
+    a:focus-visible .decorative-line::after {
+      clip-path: inset(-0.4em var(--line-inset) -0.7em var(--line-inset));
+    }
+
+    a:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 5px;
+    }
+
+    .seasonal-heading {
+      text-align: center;
+    }
+
+    .seasonal-heading .decorative-line {
+      --line-offset: 0.28em;
+      --line-inset: 0.45em;
+    }
+
+    .card h3 .decorative-line {
+      --line-offset: 0.18em;
+      --line-inset: 0.2em;
+      --line-color: var(--secondary);
+    }
+
+    .seasonal-heading .decorative-line::after,
+    .card h3 .decorative-line::after {
+      animation: reveal-line 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
+    }
+
+    .card h3 .decorative-line::after { animation-delay: 150ms; }
+    .card:nth-child(2) h3 .decorative-line::after { animation-delay: 300ms; }
+    .card:nth-child(3) h3 .decorative-line::after { animation-delay: 450ms; }
+
+    @keyframes reveal-line {
+      to { clip-path: inset(-0.4em var(--line-inset) -0.7em var(--line-inset)); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .decorative-line::after {
+        animation: none !important;
+        transition: none;
+        clip-path: inset(-0.4em var(--line-inset) -0.7em var(--line-inset));
+      }
+    }
