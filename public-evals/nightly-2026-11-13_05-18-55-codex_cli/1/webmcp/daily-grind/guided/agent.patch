+<script>
+    (() => {
+      const menu = [
+        { id: 'maple-oat-latte', name: 'Maple Oat Latte' },
+        { id: 'dark-roast-espresso', name: 'Dark Roast Espresso' },
+        { id: 'cold-brew', name: 'Cold Brew' }
+      ];
+      const quantities = new Map();
+      const status = document.getElementById('order-status');
+
+      function getOrder() {
+        const items = menu.filter(coffee => quantities.has(coffee.id))
+          .map(coffee => ({ ...coffee, quantity: quantities.get(coffee.id) }));
+        return { items, totalQuantity: items.reduce((total, item) => total + item.quantity, 0), submitted: false };
+      }
+
+      function renderOrder(message) {
+        const order = getOrder();
+        const list = document.getElementById('order-items');
+        list.replaceChildren(...order.items.map(item => {
+          const row = document.createElement('li');
+          row.textContent = `${item.name} × ${item.quantity}`;
+          return row;
+        }));
+        list.hidden = order.items.length === 0;
+        document.getElementById('order-empty').hidden = order.items.length > 0;
+        document.getElementById('order-total').textContent = `Total drinks: ${order.totalQuantity}`;
+        document.getElementById('clear-order').disabled = order.items.length === 0;
+        status.textContent = message;
+        return order;
+      }
+
+      // Shared by the form controls and WebMCP tools; schemas alone do not validate input.
+      function addCoffee(coffee, input = {}) {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some(key => key !== 'quantity')) {
+          return { error: 'Provide an object with only an optional quantity.' };
+        }
+        const quantity = input.quantity === undefined ? 1 : input.quantity;
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          return { error: 'Quantity must be a whole number from 1 to 10.' };
+        }
+        const nextQuantity = (quantities.get(coffee.id) || 0) + quantity;
+        if (nextQuantity > 10) {
+          return { error: `Your order can contain at most 10 of each coffee. You already have ${quantities.get(coffee.id)} ${coffee.name}.` };
+        }
+        quantities.set(coffee.id, nextQuantity);
+        return renderOrder(`Added ${quantity} ${coffee.name} to your order.`);
+      }
+
+      function clearOrder() {
+        quantities.clear();
+        return renderOrder('Your order has been cleared.');
+      }
+
+      document.querySelectorAll('.order-controls').forEach(form => {
+        const coffee = menu.find(item => item.id === form.dataset.coffee);
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          if (!form.reportValidity()) return;
+          const result = addCoffee(coffee, { quantity: form.elements.quantity.valueAsNumber });
+          if (result.error) status.textContent = result.error;
+        });
+        form.querySelector('button').disabled = false;
+      });
+      document.getElementById('clear-order').addEventListener('click', clearOrder);
+
+      // Progressive enhancement: ordinary ordering works without WebMCP support.
+      async function registerOrderTools() {
+        const context = document.modelContext;
+        if (!context || typeof context.registerTool !== 'function') return;
+        const controller = new AbortController();
+        const tools = menu.map(coffee => ({
+          name: `order_${coffee.id.replaceAll('-', '_')}`,
+          description: `Add ${coffee.name} to the current tab's order and update the visible summary. Use when the user wants this drink. This creates a local draft order without submitting a purchase.`,
+          inputSchema: {
+            type: 'object',
+            properties: {
+              quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to add; the order holds at most ten of each coffee.' }
+            },
+            additionalProperties: false
+          },
+          execute: input => addCoffee(coffee, input),
+          annotations: { readOnlyHint: false, consequentialHint: false }
+        }));
+        tools.push({
+          name: 'get_coffee_order',
+          description: 'Read the current tab’s coffee order and total drink count.',
+          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+          execute: getOrder,
+          annotations: { readOnlyHint: true }
+        }, {
+          name: 'clear_coffee_order',
+          description: 'Empty the current tab’s draft coffee order and update the visible summary.',
+          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+          execute: clearOrder,
+          annotations: { readOnlyHint: false, consequentialHint: false }
+        });
+        try {
+          for (const tool of tools) {
+            await context.registerTool(tool, { signal: controller.signal });
+          }
+        } catch (error) {
+          controller.abort();
+          console.warn('Coffee ordering tools could not be registered.', error);
+        }
+      }
+      void registerOrderTools();
+    })();
+  </script>
 </body>
 
