+  <script>
+    (() => {
+      const coffees = [
+        { id: 'maple-oat-latte', name: 'Maple Oat Latte', tool: 'order_maple_oat_latte' },
+        { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', tool: 'order_dark_roast_espresso' },
+        { id: 'cold-brew', name: 'Cold Brew', tool: 'order_cold_brew' }
+      ];
+      const order = new Map();
+      const status = document.getElementById('order-status');
+
+      // Shared by the forms and agent tools so both keep the visible order in sync.
+      function orderCoffee(coffee, input = {}) {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some(key => key !== 'quantity')) {
+          throw new Error('Provide an object with an optional quantity only.');
+        }
+        const quantity = input.quantity === undefined ? 1 : input.quantity;
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          throw new Error('Quantity must be a whole number from 1 to 10.');
+        }
+
+        order.set(coffee.id, (order.get(coffee.id) || 0) + quantity);
+        const items = coffees.filter(item => order.has(item.id)).map(item => ({
+          coffee: item.name,
+          quantity: order.get(item.id)
+        }));
+        const list = document.getElementById('order-items');
+        list.replaceChildren(...items.map(item => {
+          const row = document.createElement('li');
+          row.textContent = `${item.quantity} × ${item.coffee}`;
+          return row;
+        }));
+        const totalQuantity = items.reduce((total, item) => total + item.quantity, 0);
+        document.getElementById('order-total').textContent = `Total coffees: ${totalQuantity}`;
+        const message = `Added ${quantity} × ${coffee.name} to your order. Total coffees: ${totalQuantity}.`;
+        status.textContent = message;
+        return { message, items, totalQuantity, submittedToCafe: false };
+      }
+
+      document.querySelectorAll('.order-form').forEach(form => {
+        const coffee = coffees.find(item => item.id === form.dataset.coffee);
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          if (!form.reportValidity()) return;
+          try {
+            orderCoffee(coffee, { quantity: Number(form.elements.quantity.value) });
+          } catch (error) {
+            status.textContent = error.message;
+          }
+        });
+      });
+
+      // Use the current WebMCP API, with support for earlier browser previews.
+      // Manual ordering remains available when WebMCP is not supported.
+      const modelContext = document.modelContext || navigator.modelContext;
+      if (typeof modelContext?.registerTool === 'function') {
+        coffees.forEach(coffee => {
+          try {
+            const registration = modelContext.registerTool({
+              name: coffee.tool,
+              description: `Add ${coffee.name} to the current page's coffee order. Quantity defaults to 1, with 1–10 per call. Updates the visible order summary; does not send an order to the café or charge payment.`,
+              inputSchema: {
+                type: 'object',
+                properties: {
+                  quantity: {
+                    type: 'integer', minimum: 1, maximum: 10, default: 1,
+                    description: 'Number of coffees to add (1–10).'
+                  }
+                },
+                additionalProperties: false
+              },
+              async execute(input) {
+                return JSON.stringify(orderCoffee(coffee, input));
+              }
+            });
+            Promise.resolve(registration).catch(error => console.warn('Coffee tool registration failed:', error));
+          } catch (error) {
+            console.warn('Coffee tool registration failed:', error);
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
