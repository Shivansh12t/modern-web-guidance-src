diff --git a/src/lib/article-tools.ts b/src/lib/article-tools.ts
new file mode 100644
index 0000000..ed80289
--- /dev/null
+++ b/src/lib/article-tools.ts
@@ -0,0 +1,65 @@
+import { flushSync } from 'react-dom';
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+const baseUrl = import.meta.env?.BASE_URL ?? '/';
+
+export const articleUrl = (slug: string) => `${baseUrl}articles/${slug.split('/').map(encodeURIComponent).join('/')}`;
+
+async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${baseUrl}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please try again.`);
+  return response.json();
+}
+
+export const getArticles = (signal?: AbortSignal) => request<Article[]>('articles.json', { signal });
+export const getReadingList = (signal?: AbortSignal) => request<{ readingList: string[] }>('reading-list.json', { signal });
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article => `${article.title}\n${article.summary}`.toLowerCase().includes(term)) : [];
+}
+
+// The existing endpoint toggles membership. Serialize mutations and check the current
+// list first so an agent retry of "add" or "remove" never undoes its previous action.
+let mutationQueue: Promise<unknown> = Promise.resolve();
+export function updateReadingList(slug: string, action: 'add' | 'remove' | 'toggle', signal?: AbortSignal) {
+  const mutation = mutationQueue.then(async () => {
+    signal?.throwIfAborted();
+    let data = await getReadingList(signal);
+    if (action === 'toggle' || data.readingList.includes(slug) !== (action === 'add')) {
+      data = await request<{ readingList: string[] }>('reading-list.json', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug }),
+        signal,
+      });
+    }
+    signal?.throwIfAborted();
+    flushSync(() => window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: data.readingList })));
+    return data;
+  });
+  mutationQueue = mutation.catch(() => {});
+  return mutation;
+}
+
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<string>) => void;
+};
+
+export const errorMessage = (error: unknown) => error instanceof Error ? error.message : String(error);
+
+export async function toolResult<T>(run: () => Promise<T>, signal?: AbortSignal) {
+  try {
+    return await run();
+  } catch (error) {
+    if (signal?.aborted) throw error;
+    return { error: errorMessage(error) };
+  }
+}
