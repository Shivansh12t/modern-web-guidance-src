diff --git a/tests/article-tools.test.mjs b/tests/article-tools.test.mjs
new file mode 100644
index 0000000..22d62bc
--- /dev/null
+++ b/tests/article-tools.test.mjs
@@ -0,0 +1,70 @@
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { articleUrl, searchArticles, getArticles, updateReadingList, toolResult } from '../src/lib/article-tools.ts';
+
+const articles = [
+  { slug: 'coffee', title: 'Coffee Alchemy', summary: 'Roasting beans' },
+  { slug: 'coast', title: 'Coastal Pulse', summary: 'The rhythm of tides' },
+];
+let saved;
+let posts;
+beforeEach(() => {
+  saved = [];
+  posts = 0;
+  globalThis.window = new EventTarget();
+  globalThis.fetch = async (url, options = {}) => {
+    options.signal?.throwIfAborted();
+    if (url.endsWith('/articles.json')) return Response.json(articles);
+    assert.equal(url, '/api/reading-list.json');
+    if (options.method === 'POST') {
+      posts++;
+      const { slug } = JSON.parse(options.body);
+      saved = saved.includes(slug) ? saved.filter(item => item !== slug) : [...saved, slug];
+    }
+    return Response.json({ readingList: saved });
+  };
+});
+
+test('search matches titles and summaries case-insensitively and trims input', () => {
+  assert.deepEqual(searchArticles(articles, ' COFFEE '), [articles[0]]);
+  assert.deepEqual(searchArticles(articles, 'TIDES'), [articles[1]]);
+  assert.deepEqual(searchArticles(articles, ' '), []);
+  assert.deepEqual(searchArticles(articles, 'missing'), []);
+  assert.equal(articleUrl('category/an article'), '/articles/category/an%20article');
+});
+
+test('fetches article catalog', async () => {
+  assert.deepEqual(await getArticles(), articles);
+});
+
+test('repeated and concurrent bookmark operations preserve desired membership', async () => {
+  const updates = [];
+  window.addEventListener('reading-list-changed', event => updates.push(event.detail));
+  await Promise.all([updateReadingList('coffee', 'add'), updateReadingList('coffee', 'add')]);
+  assert.deepEqual(saved, ['coffee']);
+  assert.equal(posts, 1);
+  await updateReadingList('coffee', 'remove');
+  await updateReadingList('coffee', 'remove');
+  assert.deepEqual(saved, []);
+  assert.equal(posts, 2);
+  assert.deepEqual(updates.at(-1), []);
+  await updateReadingList('coffee', 'toggle');
+  assert.deepEqual(saved, ['coffee']);
+});
+
+test('cancelled mutation does not write and does not block later mutations', async () => {
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(updateReadingList('coffee', 'add', controller.signal), { name: 'AbortError' });
+  assert.equal(posts, 0);
+  await updateReadingList('coast', 'add');
+  assert.deepEqual(saved, ['coast']);
+});
+
+test('failed requests return actionable errors and cancellation propagates', async () => {
+  globalThis.fetch = async () => new Response('', { status: 503 });
+  assert.deepEqual(await toolResult(() => getArticles()), { error: 'Request failed (503). Please try again.' });
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(toolResult(async () => controller.signal.throwIfAborted(), controller.signal), { name: 'AbortError' });
+});
