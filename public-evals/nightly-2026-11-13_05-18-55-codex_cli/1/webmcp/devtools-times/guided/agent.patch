diff --git a/src/components/BrowserTools.tsx b/src/components/BrowserTools.tsx
new file mode 100644
index 0000000..0997b7f
--- /dev/null
+++ b/src/components/BrowserTools.tsx
@@ -0,0 +1,79 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { flushSync } from 'react-dom';
+import { articleUrl, getArticles, getReadingList, searchArticles, toolResult, updateReadingList } from '../lib/article-tools';
+
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+const slugProperty = { type: 'string', minLength: 1, description: 'Article identifier returned by article search.' };
+
+// Mounted in the shared layout. The hook detects support and aborts registrations
+// on unmount, including when Astro swaps the page during client navigation.
+export default function BrowserTools() {
+  useWebMCP({
+    name: 'open_search',
+    description: 'Open the article search form so the user or agent can search the newspaper.',
+    inputSchema: emptySchema,
+    execute() {
+      flushSync(() => window.dispatchEvent(new Event('open-article-search')));
+      return { opened: 'search' };
+    },
+  });
+  useWebMCP({
+    name: 'open_reading_list',
+    description: 'Open the reading list and its bookmark management form.',
+    inputSchema: emptySchema,
+    execute() {
+      flushSync(() => window.dispatchEvent(new Event('open-reading-list')));
+      return { opened: 'reading-list' };
+    },
+  });
+  useWebMCP({
+    name: 'search_articles',
+    description: 'Find newspaper articles by words in their headline or summary.',
+    inputSchema: { type: 'object', properties: { query: { type: 'string', minLength: 1, description: 'Words to find in headlines or summaries.' } }, required: ['query'], additionalProperties: false },
+    execute: ({ query }, { signal }) => toolResult(async () => {
+      if (typeof query !== 'string' || !query.trim()) return { error: 'Provide a nonempty search query.' };
+      return { articles: searchArticles(await getArticles(signal), query).map(article => ({ ...article, url: articleUrl(article.slug) })) };
+    }, signal),
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get_article',
+    description: 'Read the text of a newspaper article without navigating away from the current page.',
+    inputSchema: { type: 'object', properties: { slug: slugProperty }, required: ['slug'], additionalProperties: false },
+    execute: ({ slug }, { signal }) => toolResult(async () => {
+      if (typeof slug !== 'string' || !slug.trim()) return { error: 'Provide an article slug from search_articles.' };
+      const article = (await getArticles(signal)).find(article => article.slug === slug);
+      if (!article) return { error: 'Article not found. Use search_articles to find an article slug.' };
+      const response = await fetch(articleUrl(article.slug), { signal });
+      if (!response.ok) return { error: `Article request failed (${response.status}).` };
+      const page = new DOMParser().parseFromString(await response.text(), 'text/html');
+      const body = page.querySelector('[data-article-body]');
+      if (!body) return { error: 'Article text is unavailable.' };
+      body.querySelectorAll('script, style').forEach(element => element.remove());
+      return { ...article, url: articleUrl(article.slug), text: body.textContent?.trim() ?? '' };
+    }, signal),
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get_reading_list',
+    description: 'Read the articles saved in the current browser session’s reading list.',
+    inputSchema: emptySchema,
+    execute: (_input, { signal }) => toolResult(async () => {
+      const [articles, { readingList }] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+      return { articles: articles.filter(article => readingList.includes(article.slug)).map(article => ({ ...article, url: articleUrl(article.slug) })) };
+    }, signal),
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'update_reading_list',
+    description: 'Save an article for later or remove it from the current session’s reading list.',
+    inputSchema: { type: 'object', properties: { slug: slugProperty, action: { type: 'string', enum: ['add', 'remove'], description: 'Whether to save the article or remove its bookmark.' } }, required: ['slug', 'action'], additionalProperties: false },
+    execute: ({ slug, action }, { signal }) => toolResult(async () => {
+      if (typeof slug !== 'string' || (action !== 'add' && action !== 'remove')) return { error: 'Provide an article slug and an add or remove action.' };
+      if (!(await getArticles(signal)).some(article => article.slug === slug)) return { error: 'Article not found. Use search_articles to find an article slug.' };
+      return updateReadingList(slug, action, signal);
+    }, signal),
+    annotations: { readOnlyHint: false },
+  });
+  return null;
+}
