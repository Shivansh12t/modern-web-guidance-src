@@ -0,0 +1,52 @@
+import { getArticles, getReadingList, setBookmark } from './article-client';
+import { emptySchema, registerBrowserTool } from './browser-tools';
+
+let cleanup: (() => void)[] = [];
+export function registerSiteTools() {
+  cleanup.forEach(dispose => dispose());
+  cleanup = [];
+  const add = (tool: Parameters<typeof registerBrowserTool>[0]) => cleanup.push(registerBrowserTool(tool));
+  add({ name: 'list_articles', description: 'List available article slugs, titles and summaries.', inputSchema: emptySchema, execute: async () => ({ articles: await getArticles() }) });
+  add({ name: 'get_reading_list', description: 'Get saved article slugs for the current browser session.', inputSchema: emptySchema, execute: async () => ({ readingList: await getReadingList() }) });
+  add({
+    name: 'set_article_bookmark', description: 'Save or remove an article from the current session reading list. Repeating the same request preserves its state.',
+    inputSchema: { type: 'object', properties: { slug: { type: 'string', description: 'An article slug from list_articles.' }, saved: { type: 'boolean', description: 'True to save; false to remove.' } }, required: ['slug', 'saved'], additionalProperties: false },
+    execute: async ({ slug, saved }) => {
+      if (typeof slug !== 'string' || !slug.trim() || typeof saved !== 'boolean') throw new Error('A slug and boolean saved are required');
+      return { readingList: await setBookmark(slug, saved) };
+    },
+  });
+  const article = document.querySelector<HTMLElement>('article[data-article-slug]');
+  if (!article) return;
+  add({
+    name: 'read_current_article', description: 'Read the title and body of the article currently open in the browser.', inputSchema: emptySchema,
+    execute: async () => ({ slug: article.dataset.articleSlug, title: article.querySelector('h1')?.textContent?.trim(), body: article.querySelector('.prose')?.textContent?.trim(), url: location.href }),
+  });
+  const utilities: Record<string, [string, string]> = {
+    'coastal-pulse': ['get_tide_levels', 'tide-levels'],
+    'coffee-alchemy': ['get_coffee_brew', 'coffee-brew'],
+    'silent-architects': ['get_plant_stats', 'plant-stats'],
+    'super-bowl-lx': ['get_article_popularity', 'article-popularity'],
+  };
+  const utility = utilities[article.dataset.articleSlug ?? ''];
+  if (utility) {
+    const [name, endpoint] = utility;
+    add({
+      name, description: `Request this article's ${endpoint} utility. Returns HTTP status, redirect information and response body, including API failures.`, inputSchema: emptySchema,
+      execute: async () => {
+        const url = new URL(`${import.meta.env.BASE_URL}api/${endpoint}`, location.origin);
+        if (endpoint === 'article-popularity') url.searchParams.set('id', article.dataset.articleSlug!);
+        const response = await fetch(url);
+        const body = await response.text();
+        return { ok: response.ok, status: response.status, redirected: response.redirected, url: response.url, body };
+      },
+    });
+  }
+}
+
+// Astro keeps this module alive between client-side navigations.
+document.addEventListener('astro:page-load', registerSiteTools);
+document.addEventListener('astro:before-swap', () => {
+  cleanup.forEach(dispose => dispose());
+  cleanup = [];
+});
diff --git a/tests/browser-tools.test.mjs b/tests/browser-tools.test.mjs
