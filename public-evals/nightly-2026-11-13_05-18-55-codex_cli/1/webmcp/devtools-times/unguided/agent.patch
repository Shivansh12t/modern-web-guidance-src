diff --git a/src/utils/article-client.ts b/src/utils/article-client.ts
new file mode 100644
index 0000000..6a35f49
--- /dev/null
+++ b/src/utils/article-client.ts
@@ -0,0 +1,44 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function requestJSON<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}${path}`, init);
+  if (!response.ok) throw new Error(`Request failed (${response.status} ${response.statusText})`);
+  return response.json();
+}
+
+export const getArticles = () => requestJSON<Article[]>('api/articles.json');
+export const getReadingList = async () => (await requestJSON<{ readingList: string[] }>('api/reading-list.json')).readingList;
+export const searchArticles = (articles: Article[], query: string) => {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article => `${article.title}\n${article.summary}`.toLowerCase().includes(term)) : [];
+};
+
+async function toggle(slug: string) {
+  const data = await requestJSON<{ readingList: string[] }>('api/reading-list.json', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }),
+  });
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: data.readingList }));
+  return data.readingList;
+}
+
+// Serialize mutations from forms, buttons and agents so simultaneous calls do not
+// both toggle a bookmark based on the same stale reading list.
+let mutation: Promise<unknown> = Promise.resolve();
+function enqueue<T>(operation: () => Promise<T>): Promise<T> {
+  const next = mutation.then(operation, operation);
+  mutation = next.catch(() => {});
+  return next;
+}
+export const toggleBookmark = (slug: string) => enqueue(() => toggle(slug));
+
+export const setBookmark = (slug: string, saved: boolean) => enqueue(async () => {
+  const articles = await getArticles();
+  if (!articles.some(article => article.slug === slug)) throw new Error('Unknown article slug');
+  const list = await getReadingList();
+  return list.includes(slug) === saved ? list : toggle(slug);
+});
diff --git a/src/utils/browser-tools.ts b/src/utils/browser-tools.ts
new file mode 100644
index 0000000..11daf5e
--- /dev/null
+++ b/src/utils/browser-tools.ts
@@ -0,0 +1,36 @@
+/** WebMCP is optional; ordinary controls also work without browser support. */
+export interface BrowserTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: Record<string, unknown>) => Promise<unknown>;
+}
+interface ModelContext {
+  registerTool: (tool: BrowserTool, options?: { signal: AbortSignal }) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+export function registerBrowserTool(tool: BrowserTool): () => void {
+  // Support the current draft and browsers implementing the original preview.
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context) return () => {};
+  const controller = new AbortController();
+  try {
+    Promise.resolve(context.registerTool(tool, { signal: controller.signal }))
+      .catch(error => { if (!controller.signal.aborted) console.warn(`Could not register ${tool.name}`, error); });
+  } catch (error) {
+    console.warn(`Could not register ${tool.name}`, error);
+  }
+  return () => {
+    controller.abort();
+    context.unregisterTool?.(tool.name);
+  };
+}
+
+export const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submission = event as Event & { agentInvoked?: boolean; respondWith?: (result: Promise<unknown>) => void };
+  if (submission.agentInvoked && submission.respondWith) submission.respondWith(result);
+}
