+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+
+// Load only client modules, with Vite's base-path substitution. No server imports.
+const moduleURL = async path => {
+  const source = await readFile(new URL(path, import.meta.url), 'utf8');
+  return `data:text/javascript;base64,${Buffer.from(stripTypeScriptTypes(source.replaceAll('import.meta.env.BASE_URL', JSON.stringify('/devtools-times/')))).toString('base64')}`;
+};
+const browserURL = await moduleURL('../src/utils/browser-tools.ts');
+const articleURL = await moduleURL('../src/utils/article-client.ts');
+const { registerBrowserTool, respondToAgent } = await import(browserURL);
+const client = await import(articleURL);
+const documentMock = new EventTarget();
+globalThis.document = documentMock;
+globalThis.window = new EventTarget();
+globalThis.location = { origin: 'https://example.test', href: 'https://example.test/devtools-times/' };
+
+const tool = { name: 'example', description: 'Example', inputSchema: {}, execute: async () => ({ ok: true }) };
+
+test('unsupported browsers preserve ordinary behavior', () => {
+  assert.doesNotThrow(() => registerBrowserTool(tool)());
+  assert.doesNotThrow(() => respondToAgent(new Event('submit'), Promise.resolve({})));
+});
+
+test('registration aborts on cleanup and supports preview cleanup', async () => {
+  let options;
+  let removed;
+  documentMock.modelContext = {
+    registerTool: (registered, opts) => { assert.equal(registered, tool); options = opts; },
+    unregisterTool: name => { removed = name; },
+  };
+  const dispose = registerBrowserTool(tool);
+  assert.equal(options.signal.aborted, false);
+  dispose();
+  assert.equal(options.signal.aborted, true);
+  assert.equal(removed, 'example');
+  delete documentMock.modelContext;
+});
+
+test('agent submissions return the result promise', async () => {
+  let result;
+  respondToAgent({ agentInvoked: true, respondWith: promise => { result = promise; } }, Promise.resolve({ articles: [] }));
+  assert.deepEqual(await result, { articles: [] });
+});
+
+test('search handles titles, summaries, case and whitespace', () => {
+  const articles = [{ slug: 'a', title: 'Coastal Life', summary: 'Tides' }];
+  assert.deepEqual(client.searchArticles(articles, ' COASTAL '), articles);
+  assert.deepEqual(client.searchArticles(articles, 'tides'), articles);
+  assert.deepEqual(client.searchArticles(articles, ' '), []);
+});
+
+test('concurrent save/remove calls are idempotent, base-aware and synchronize UI', async () => {
+  let saved = [];
+  let posts = 0;
+  let changes = 0;
+  window.addEventListener('reading-list-changed', () => changes++);
+  globalThis.fetch = async (url, init) => {
+    assert.ok(url.startsWith('/devtools-times/api/'));
+    if (url.endsWith('articles.json')) return Response.json([{ slug: 'a' }]);
+    if (init?.method === 'POST') {
+      posts++;
+      const { slug } = JSON.parse(init.body);
+      saved = saved.includes(slug) ? saved.filter(item => item !== slug) : [...saved, slug];
+    }
+    return Response.json({ readingList: saved });
+  };
+  await Promise.all([client.setBookmark('a', true), client.setBookmark('a', true)]);
+  assert.deepEqual(saved, ['a']);
+  assert.equal(posts, 1);
+  await Promise.all([client.setBookmark('a', false), client.setBookmark('a', false)]);
+  assert.deepEqual(saved, []);
+  assert.equal(posts, 2);
+  assert.equal(changes, 2);
+  await assert.rejects(client.setBookmark('unknown', true), /Unknown article/);
+  fetch = async () => new Response(null, { status: 500 });
+  await assert.rejects(client.getArticles(), /500/);
+});
+
+test('Astro navigation removes article tools and re-registers site tools', async () => {
+  const tools = new Map();
+  documentMock.modelContext = { registerTool: (tool, { signal }) => {
+    assert.equal(tools.has(tool.name), false, `duplicate ${tool.name}`);
+    tools.set(tool.name, tool);
+    signal.addEventListener('abort', () => tools.delete(tool.name));
+  } };
+  let article = { dataset: { articleSlug: 'super-bowl-lx' }, querySelector: selector => ({ textContent: selector === 'h1' ? 'Super Bowl' : 'Article body' }) };
+  documentMock.querySelector = () => article;
+  let source = await readFile(new URL('../src/utils/site-tools.ts', import.meta.url), 'utf8');
+  source = source.replace("'./article-client'", JSON.stringify(articleURL)).replace("'./browser-tools'", JSON.stringify(browserURL)).replaceAll('import.meta.env.BASE_URL', JSON.stringify('/devtools-times/'));
+  await import(`data:text/javascript;base64,${Buffer.from(stripTypeScriptTypes(source)).toString('base64')}`);
+  documentMock.dispatchEvent(new Event('astro:page-load'));
+  assert.equal(tools.size, 5);
+  assert.equal((await tools.get('read_current_article').execute({})).body, 'Article body');
+  fetch = async url => {
+    assert.equal(url.pathname, '/devtools-times/api/article-popularity');
+    assert.equal(url.searchParams.get('id'), 'super-bowl-lx');
+    return Response.json({ trending: true });
+  };
+  assert.equal((await tools.get('get_article_popularity').execute({})).status, 200);
+  await assert.rejects(tools.get('set_article_bookmark').execute({ slug: 'a', saved: 'true' }), /boolean/);
+  documentMock.dispatchEvent(new Event('astro:before-swap'));
+  assert.equal(tools.size, 0);
+  article = null;
+  documentMock.dispatchEvent(new Event('astro:page-load'));
+  assert.equal(tools.size, 3);
+  assert.equal(tools.has('read_current_article'), false);
+});
