diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,63 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="theme-color" content="#f7f7f2">
+  <title>Type / Tune — A font-size-adjust playground</title>
+  <link rel="stylesheet" href="styles.css">
+  <script src="script.js" defer></script>
+</head>
+<body>
+  <header class="site-header">
+    <a class="brand" href="./" aria-label="Type Tune home">type<span class="brand-slash">/</span>tune<span class="brand-dot">®</span></a>
+    <div class="header-note"><span class="status-dot"></span> A little playground for better type</div>
+    <a class="source-link" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener noreferrer">About the property <span aria-hidden="true">↗</span></a>
+  </header>
+
+  <main>
+    <section class="intro" aria-labelledby="page-title">
+      <div class="eyebrow"><span class="small-cross" aria-hidden="true">✳</span> THE TYPOGRAPHY LAB <span class="edition">EXPERIMENT 001</span></div>
+      <h1 id="page-title">Different fonts.<br>Same rhythm<span class="coral">.</span></h1>
+      <p class="intro-copy">Good typography is a balancing act. Bring different fonts into harmony with a little help from <code>font-size-adjust</code>.</p>
+      <div class="intro-bottom"><span class="intro-line"></span><span>Less tweaking. More reading.</span><span aria-hidden="true">↓</span></div>
+    </section>
+
+    <section class="workspace" aria-label="Font adjustment playground">
+      <div class="workspace-toolbar"><div><span class="status-dot"></span> LIVE PLAYGROUND</div><button id="reset" type="button"><span aria-hidden="true">↺</span> Reset settings</button></div>
+      <div class="workbench">
+        <aside class="controls" aria-label="Typography settings">
+          <div class="control-heading">Make it your type<span aria-hidden="true">↘</span></div>
+          <div class="control-group"><label for="body-font">Body font</label><select id="body-font"><option value="Arial, sans-serif">Arial</option><option value="Verdana, sans-serif">Verdana</option><option value="Georgia, serif">Georgia</option><option value="'Trebuchet MS', sans-serif">Trebuchet MS</option></select><span class="control-hint">The starting point for your text.</span></div>
+          <div class="control-group"><label for="code-font">Code font</label><select id="code-font"><option value="'Courier New', monospace">Courier New</option><option value="Consolas, monospace">Consolas</option><option value="monospace">System monospace</option></select><span class="control-hint">A different family, a shared height.</span></div>
+          <div class="control-group size-group"><label for="font-size">Font size <output id="size-output" for="font-size">24 px</output></label><input id="font-size" type="range" min="16" max="36" value="24"><div class="range-labels"><span>16 px</span><span>36 px</span></div></div>
+          <div class="switch-row"><label for="guides">Show x-height guides</label><input id="guides" type="checkbox" role="switch"></div>
+          <div class="control-note"><span class="note-icon" aria-hidden="true">i</span><p>Same font size doesn't always mean the same visual size. It's all in the x-height.</p></div>
+          <div class="alphabet" aria-hidden="true">Aa<span>↔</span>Aa</div>
+          <div class="alphabet-caption">A LITTLE ADJUSTMENT GOES A LONG WAY</div>
+        </aside>
+
+        <div class="previews">
+          <section class="preview-card" aria-labelledby="mixed-title">
+            <div class="card-heading"><div class="card-title"><span class="number">01</span><h2 id="mixed-title">Mixed fonts, in harmony</h2></div><span class="badge automatic"><span class="status-dot"></span> Automatic</span></div>
+            <p class="card-description">One text block. Two font families. A consistent visual height.</p>
+            <div class="sample" id="mixed-fonts-container"><p>The details make the design. Even a little <code>inline code</code> should feel right at home.</p></div>
+            <div class="property-row"><code><span class="css-property">font-size-adjust</span>: <span class="css-value">from-font</span>;</code><span class="property-note">Matches the primary font's x-height</span></div>
+          </section>
+
+          <section class="preview-card independent-card" aria-labelledby="theme-title">
+            <div class="card-heading"><div class="card-title"><span class="number">02</span><h2 id="theme-title">A theme of its own</h2></div><span class="badge fixed"><span aria-hidden="true">◇</span> Fixed metric</span></div>
+            <p class="card-description">An independent theme, with its own proportions locked in.</p>
+            <div class="sample" id="independent-theme-container"><span class="theme-label"><span class="theme-mark" aria-hidden="true">✳</span> THE EDITORIAL THEME</span><p>A different character.<br>The same attention to detail.</p><span class="theme-footnote">Georgia meets <code>monospace</code>. Beautifully balanced.</span></div>
+            <div class="property-row"><code><span class="css-property">font-size-adjust</span>: <span class="css-value">0.5</span>;</code><span class="property-note">An explicit x-height ratio</span></div>
+          </section>
+        </div>
+      </div>
+      <div class="workspace-footer"><div><span class="status-dot"></span><span id="support-status">Progressive enhancement built in</span></div><button type="button" id="copy-css"><span aria-hidden="true">▣</span> Copy CSS</button><span id="copy-status" class="sr-only" role="status"></span></div>
+    </section>
+
+    <section class="explanation" aria-label="How font adjustment works"><span class="explanation-icon" aria-hidden="true">x<span>↕</span></span><div><h2>Small property. Big difference.</h2><p><code>font-size-adjust</code> aligns fonts by their lowercase letter height, so your text feels consistent—even when the typeface changes.</p></div><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener noreferrer">Get to know x-height <span aria-hidden="true">↗</span></a></section>
+  </main>
+  <footer class="site-footer"><span>Made for the love of letters.</span><span>TYPE / TUNE <span class="footer-cross" aria-hidden="true">✳</span> A CSS EXPLORATION</span><span>Let your type find its balance.</span></footer>
+</body>
+</html>
