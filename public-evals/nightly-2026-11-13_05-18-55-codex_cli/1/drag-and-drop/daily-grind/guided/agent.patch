+  <script>
+    const row = document.querySelector('.seasonal-row');
+    const status = document.querySelector('#reorder-status');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let drag = null;
+    let announcement;
+
+    function announce(message) {
+      clearTimeout(announcement);
+      status.textContent = '';
+      announcement = setTimeout(() => { status.textContent = message; }, 500);
+    }
+
+    function animateFrom(positions) {
+      if (reducedMotion.matches) return;
+      for (const [card, before] of positions) {
+        const after = card.getBoundingClientRect();
+        card.animate([
+          { translate: `${before.left - after.left}px ${before.top - after.top}px` },
+          { translate: '0 0' }
+        ], { duration: 180, easing: 'ease-out' });
+      }
+    }
+
+    function moveCard(card, reference, positions) {
+      if (row.moveBefore) row.moveBefore(card, reference);
+      else row.insertBefore(card, reference);
+      card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      card.querySelector('.drag-handle').focus({ preventScroll: true });
+      animateFrom(positions);
+      announce(`${card.querySelector('h3').textContent}, position ${[...row.children].indexOf(card) + 1} of ${row.children.length}.`);
+    }
+
+    function positions() {
+      return new Map([...row.children].map(card => [card, card.getBoundingClientRect()]));
+    }
+
+    function updateDrag() {
+      if (!drag) return;
+      const bounds = row.getBoundingClientRect();
+      const x = Math.max(bounds.left, Math.min(drag.x, bounds.right)) - bounds.left - row.clientLeft + row.scrollLeft;
+      const others = [...row.children].filter(card => card !== drag.card);
+      drag.reference = others.find(card => x < card.offsetLeft + card.offsetWidth / 2) || null;
+      drag.card.style.translate = `${drag.x - drag.startX + row.scrollLeft - drag.startScroll}px 0`;
+      if (drag.reference === drag.card.nextElementSibling) {
+        delete row.dataset.drop;
+        return;
+      }
+      const next = drag.reference?.getBoundingClientRect();
+      const previous = (drag.reference ? others[others.indexOf(drag.reference) - 1] : others.at(-1))?.getBoundingClientRect();
+      const markerX = next && previous ? (next.left + previous.right) / 2 : next ? next.left - 10 : previous.right + 10;
+      row.dataset.drop = '';
+      row.style.setProperty('--drop-x', `${markerX - 1.5}px`);
+      row.style.setProperty('--drop-y', `${bounds.top + row.clientTop + 16}px`);
+      row.style.setProperty('--drop-h', `${drag.card.offsetHeight}px`);
+    }
+
+    function scrollDrag(time) {
+      if (!drag) return;
+      const bounds = row.getBoundingClientRect();
+      const zone = Math.min(drag.card.offsetWidth, row.clientWidth / 3);
+      const speed = drag.x < bounds.left + zone ? -Math.min(1, (bounds.left + zone - drag.x) / zone)
+        : drag.x > bounds.right - zone ? Math.min(1, (drag.x - bounds.right + zone) / zone) : 0;
+      row.scrollLeft += speed * Math.min(time - drag.lastTime, 32) * 0.7;
+      drag.lastTime = time;
+      updateDrag();
+      drag.frame = requestAnimationFrame(scrollDrag);
+    }
+
+    function finishDrag(cancelled = false) {
+      if (!drag) return;
+      const current = drag;
+      drag = null;
+      cancelAnimationFrame(current.frame);
+      const before = positions();
+      current.card.style.translate = '';
+      current.card.classList.remove('is-dragging');
+      document.documentElement.classList.remove('is-reordering');
+      delete row.dataset.drop;
+      for (const property of ['--drop-x', '--drop-y', '--drop-h']) row.style.removeProperty(property);
+      if (current.handle.hasPointerCapture(current.id)) current.handle.releasePointerCapture(current.id);
+      if (!cancelled && current.reference !== current.card.nextElementSibling) {
+        moveCard(current.card, current.reference, before);
+      } else {
+        current.card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        animateFrom(before);
+      }
+      if (cancelled) announce('Reordering cancelled.');
+    }
+
+    for (const card of row.children) {
+      const handle = document.createElement('button');
+      handle.type = 'button';
+      handle.className = 'drag-handle';
+      handle.textContent = '↔';
+      handle.setAttribute('aria-label', `Reorder ${card.querySelector('h3').textContent}`);
+      handle.setAttribute('aria-describedby', 'reorder-help');
+      card.prepend(handle);
+
+      handle.addEventListener('pointerdown', event => {
+        if (drag || !event.isPrimary || event.button !== 0) return;
+        card.getAnimations().forEach(animation => animation.finish());
+        handle.focus({ preventScroll: true });
+        drag = { card, handle, id: event.pointerId, startX: event.clientX, x: event.clientX,
+          startScroll: row.scrollLeft, reference: card.nextElementSibling, lastTime: performance.now() };
+        handle.setPointerCapture(event.pointerId);
+        card.classList.add('is-dragging');
+        document.documentElement.classList.add('is-reordering');
+        drag.frame = requestAnimationFrame(scrollDrag);
+      });
+      handle.addEventListener('lostpointercapture', event => {
+        if (drag?.id === event.pointerId) finishDrag(true);
+      });
+      handle.addEventListener('keydown', event => {
+        if (drag || !event.altKey || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
+        event.preventDefault();
+        const reference = event.key === 'ArrowLeft' ? card.previousElementSibling : card.nextElementSibling?.nextElementSibling;
+        if (event.key === 'ArrowLeft' ? !reference : !card.nextElementSibling) return;
+        for (const item of row.children) item.getAnimations().forEach(animation => animation.finish());
+        moveCard(card, reference || null, positions());
+      });
+      card.addEventListener('focusin', event => {
+        if (!drag && event.target.matches(':focus-visible') && !card.getAnimations().length) {
+          card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+      });
+    }
+    document.querySelector('#reorder-help').hidden = false;
+    document.addEventListener('pointermove', event => {
+      if (drag?.id !== event.pointerId) return;
+      drag.x = event.clientX;
+      updateDrag();
+    });
+    document.addEventListener('pointerup', event => {
+      if (drag?.id !== event.pointerId) return;
+      drag.x = event.clientX;
+      updateDrag();
+      finishDrag();
+    });
+    document.addEventListener('pointercancel', event => {
+      if (drag?.id === event.pointerId) finishDrag(true);
+    });
+    document.addEventListener('keydown', event => {
+      if (drag && event.key === 'Escape') { event.preventDefault(); finishDrag(true); }
+    });
+    window.addEventListener('blur', () => finishDrag(true));
+  </script>
