+  <script>
+    const favorites = document.getElementById('seasonal-favorites');
+    const status = document.getElementById('reorder-status');
+    let drag = null;
+
+    const cards = () => Array.from(favorites.children);
+    const title = card => card.querySelector('h3').textContent;
+    const rowFor = card => {
+      const top = card.offsetTop;
+      return cards().filter(item => Math.abs(item.offsetTop - top) < 2);
+    };
+    const announce = card => {
+      const row = rowFor(card);
+      status.textContent = `${title(card)}, position ${row.indexOf(card) + 1} of ${row.length} in this row.`;
+    };
+
+    cards().forEach(card => {
+      const handle = document.createElement('button');
+      handle.type = 'button';
+      handle.className = 'reorder-handle';
+      handle.textContent = '⠿';
+      handle.setAttribute('aria-label', `Reorder ${title(card)}`);
+      handle.setAttribute('aria-describedby', 'reorder-help');
+      card.prepend(handle);
+    });
+
+    favorites.addEventListener('keydown', event => {
+      if (!event.target.matches('.reorder-handle')) return;
+      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
+      event.preventDefault();
+      const card = event.target.closest('.card');
+      const row = rowFor(card);
+      const index = row.indexOf(card);
+      const neighbor = row[index + (event.key === 'ArrowLeft' ? -1 : 1)];
+      if (!neighbor) return;
+      favorites.insertBefore(card, event.key === 'ArrowLeft' ? neighbor : neighbor.nextSibling);
+      event.target.focus();
+      announce(card);
+    });
+
+    favorites.addEventListener('pointerdown', event => {
+      if (drag || !event.isPrimary || event.button !== 0 || event.target.closest('a')) return;
+      const card = event.target.closest('.card');
+      if (!card) return;
+      const row = rowFor(card);
+      if (row.length < 2) return;
+      drag = {
+        card, row, pointerId: event.pointerId, startX: event.clientX,
+        startY: event.clientY, active: false, index: row.indexOf(card),
+        bounds: row.map(item => item.getBoundingClientRect())
+      };
+      card.setPointerCapture(event.pointerId);
+    });
+
+    favorites.addEventListener('pointermove', event => {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      const dx = event.clientX - drag.startX;
+      const dy = event.clientY - drag.startY;
+      if (!drag.active) {
+        if (Math.max(Math.abs(dx), Math.abs(dy)) < 6) return;
+        if (Math.abs(dy) > Math.abs(dx)) {
+          finishDrag(false);
+          return;
+        }
+        drag.active = true;
+        drag.card.classList.add('is-dragging');
+      }
+      const origin = drag.bounds[drag.row.indexOf(drag.card)];
+      const shift = Math.max(drag.bounds[0].left - origin.left,
+        Math.min(dx, drag.bounds[drag.bounds.length - 1].right - origin.right));
+      drag.card.style.transform = `translateX(${shift}px)`;
+      const center = origin.left + origin.width / 2 + shift;
+      const others = drag.row.filter(card => card !== drag.card);
+      drag.index = drag.bounds.reduce((nearest, bounds, index) => {
+        const previous = drag.bounds[nearest];
+        return Math.abs(center - bounds.left - bounds.width / 2) <
+          Math.abs(center - previous.left - previous.width / 2) ? index : nearest;
+      }, 0);
+      clearIndicators();
+      if (drag.index < others.length) others[drag.index].classList.add('drop-before');
+      else others[others.length - 1].classList.add('drop-after');
+    });
+
+    function clearIndicators() {
+      cards().forEach(card => card.classList.remove('drop-before', 'drop-after'));
+    }
+
+    function finishDrag(commit) {
+      if (!drag) return;
+      const { card, row, index, active, pointerId } = drag;
+      drag = null;
+      card.style.transform = '';
+      card.classList.remove('is-dragging');
+      clearIndicators();
+      if (card.hasPointerCapture(pointerId)) card.releasePointerCapture(pointerId);
+      if (commit && active) {
+        const others = row.filter(item => item !== card);
+        favorites.insertBefore(card, others[index] || others[others.length - 1].nextSibling);
+        card.querySelector('.reorder-handle').focus({ preventScroll: true });
+        announce(card);
+      }
+    }
+
+    favorites.addEventListener('pointerup', event => {
+      if (drag && event.pointerId === drag.pointerId) finishDrag(true);
+    });
+    favorites.addEventListener('pointercancel', () => finishDrag(false));
+    favorites.addEventListener('lostpointercapture', () => finishDrag(false));
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape') finishDrag(false);
+    });
+    window.addEventListener('resize', () => finishDrag(false));
+  </script>
