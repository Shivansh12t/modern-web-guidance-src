+  <script>
+    const carousel = document.querySelector('#drink-carousel');
+    const cards = [...carousel.querySelectorAll('.card')];
+    const previous = document.querySelector('#previous-drink');
+    const next = document.querySelector('#next-drink');
+    const status = document.querySelector('#carousel-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const scrollBehavior = () => reducedMotion.matches ? 'instant' : 'smooth';
+
+    function updateControls() {
+      const max = carousel.scrollWidth - carousel.clientWidth;
+      const index = cards.reduce((closest, card, i) =>
+        Math.abs(card.offsetLeft - cards[0].offsetLeft - carousel.scrollLeft) <
+        Math.abs(cards[closest].offsetLeft - cards[0].offsetLeft - carousel.scrollLeft) ? i : closest, 0);
+      previous.disabled = carousel.scrollLeft <= 2;
+      next.disabled = carousel.scrollLeft >= max - 2;
+      const visible = cards.map((card, i) => ({ card, i })).filter(({ card }) => {
+        const left = card.offsetLeft - cards[0].offsetLeft;
+        return left + card.offsetWidth > carousel.scrollLeft + 2 && left < carousel.scrollLeft + carousel.clientWidth - 18;
+      });
+      status.textContent = visible.length > 1
+        ? `${visible[0].i + 1}\u2013${visible.at(-1).i + 1} of ${cards.length}`
+        : `${index + 1} of ${cards.length}`;
+    }
+
+    function move(direction) {
+      carousel.scrollBy({ left: direction * (cards[0].getBoundingClientRect().width + 20), behavior: scrollBehavior() });
+    }
+    previous.addEventListener('click', () => move(-1));
+    next.addEventListener('click', () => move(1));
+    carousel.addEventListener('keydown', event => {
+      if (event.target !== carousel) return;
+      if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        if (event.key === 'Home' || event.key === 'End') {
+          carousel.scrollTo({ left: event.key === 'Home' ? 0 : carousel.scrollWidth, behavior: scrollBehavior() });
+        } else move(event.key === 'ArrowRight' ? 1 : -1);
+      }
+    });
+    let scrollTimer;
+    carousel.addEventListener('scroll', () => {
+      clearTimeout(scrollTimer);
+      scrollTimer = setTimeout(updateControls, 120);
+    }, { passive: true });
+    new ResizeObserver(updateControls).observe(carousel);
+    updateControls();
+
+    const drinks = {
+      maple: { title: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup.', notes: 'A cozy pairing of espresso, oat milk, and gentle maple sweetness.', url: '/menu/seasonal' },
+      espresso: { title: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost.', notes: 'Deep roasted flavor in a small, rich cup. Made for slow sips and early starts.', url: '/menu/espresso' },
+      cold: { title: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness.', notes: 'A long, slow steep brings out a mellow coffee flavor. Served cold for a refreshing finish.', url: '/menu/cold-brew' }
+    };
+    const dialog = document.querySelector('#drink-details');
+    let trigger;
+    let openingAnimation;
+    let closing = false;
+
+    function buttonTransform() {
+      const start = trigger.getBoundingClientRect();
+      const end = dialog.getBoundingClientRect();
+      return `translate(${start.left - end.left}px, ${start.top - end.top}px) scale(${start.width / end.width}, ${start.height / end.height})`;
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        trigger = button;
+        const drink = drinks[button.dataset.drink];
+        document.querySelector('#detail-title').textContent = drink.title;
+        document.querySelector('#detail-description').textContent = drink.description;
+        document.querySelector('#detail-notes').textContent = drink.notes;
+        document.querySelector('#detail-menu').href = drink.url;
+        dialog.classList.remove('is-closing');
+        dialog.showModal();
+        if (!reducedMotion.matches) {
+          openingAnimation = dialog.animate([
+            { transform: buttonTransform(), opacity: 0.3, borderRadius: '5px' },
+            { transform: 'none', opacity: 1, borderRadius: '16px' }
+          ], { duration: 360, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
+        }
+      });
+    });
+
+    async function closeDetails() {
+      if (closing || !dialog.open) return;
+      closing = true;
+      openingAnimation?.cancel();
+      if (!reducedMotion.matches) {
+        dialog.classList.add('is-closing');
+        await dialog.animate([
+          { transform: 'none', opacity: 1 },
+          { transform: buttonTransform(), opacity: 0, borderRadius: '5px' }
+        ], { duration: 220, easing: 'ease-in' }).finished;
+      }
+      dialog.close();
+      closing = false;
+      trigger.focus({ preventScroll: true });
+    }
+    dialog.querySelector('.detail-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => { event.preventDefault(); closeDetails(); });
+    dialog.addEventListener('click', event => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) closeDetails();
+    });
+  </script>
