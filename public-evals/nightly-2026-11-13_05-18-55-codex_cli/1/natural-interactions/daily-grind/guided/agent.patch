+  <script>
+    const scroller = document.querySelector('.drink-scroller');
+    const previous = document.querySelector('#previous-drink');
+    const next = document.querySelector('#next-drink');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateControls() {
+      previous.disabled = scroller.scrollLeft <= 1;
+      next.disabled = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 1;
+    }
+
+    function scrollDrinks(direction) {
+      const cards = scroller.querySelectorAll('.card');
+      const step = cards[1].offsetLeft - cards[0].offsetLeft;
+      scroller.scrollBy({ left: direction * step, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+    }
+
+    previous.addEventListener('click', () => scrollDrinks(-1));
+    next.addEventListener('click', () => scrollDrinks(1));
+    scroller.addEventListener('scroll', updateControls, { passive: true });
+    window.addEventListener('resize', updateControls);
+    document.querySelector('.carousel-controls').hidden = false;
+    updateControls();
+
+    const dialog = document.querySelector('#drink-details');
+    let openingAnimation;
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const origin = button.getBoundingClientRect();
+        const template = document.querySelector(`#details-${button.dataset.drink}`);
+        document.querySelector('#drink-content').replaceChildren(template.content.cloneNode(true));
+        // Give native dialog focus restoration a consistent invoker, including on touch.
+        button.focus({ preventScroll: true });
+        dialog.showModal();
+        if (!reducedMotion.matches && typeof dialog.animate === 'function') {
+          const destination = dialog.getBoundingClientRect();
+          openingAnimation = dialog.animate([
+            { transform: `translate(${origin.left - destination.left}px, ${origin.top - destination.top}px) scale(${origin.width / destination.width}, ${origin.height / destination.height})`, opacity: 0.35 },
+            { transform: 'translate(0, 0) scale(1, 1)', opacity: 1 }
+          ], { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
+        }
+      });
+    });
+    dialog.addEventListener('close', () => {
+      openingAnimation?.cancel();
+      openingAnimation = null;
+    });
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) openingAnimation?.cancel();
+    });
+  </script>
