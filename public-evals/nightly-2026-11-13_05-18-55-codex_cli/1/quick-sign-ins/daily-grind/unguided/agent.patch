+  <script>
+    (() => {
+      const form = document.querySelector('#signin-form');
+      const username = document.querySelector('#signin-username');
+      const password = document.querySelector('#signin-password');
+      const passkeyButton = document.querySelector('#passkey-signin');
+      const passwordButton = document.querySelector('#password-signin');
+      const status = document.querySelector('#auth-status');
+      const context = document.querySelector('#signin-context');
+      const accountAction = document.querySelector('#account-action');
+      const continueLink = document.querySelector('#auth-continue');
+      let signedIn = false;
+      let busy = false;
+      let destination = null;
+      let passkeyController = null;
+
+      // Backend contract: all endpoints return JSON and use same-origin session cookies.
+      // GET /api/auth/session -> { authenticated: boolean }
+      // POST /api/auth/password { username, password } -> { authenticated: true }
+      // POST /api/auth/passkey/options {} -> PublicKeyCredentialRequestOptionsJSON
+      // POST /api/auth/passkey/verify <credential JSON> -> { authenticated: true }
+      // POST /api/auth/logout {} -> any successful JSON response
+      // The server must generate one-use challenges, verify credentials, enforce CSRF
+      // protection (including Origin checks), and issue a secure HttpOnly session cookie.
+      async function request(path, body, signal) {
+        const response = await fetch('/api/auth/' + path, {
+          method: body === undefined ? 'GET' : 'POST',
+          credentials: 'same-origin',
+          mode: 'same-origin',
+          redirect: 'error',
+          cache: 'no-store',
+          headers: body === undefined ? { Accept: 'application/json' } : {
+            Accept: 'application/json', 'Content-Type': 'application/json'
+          },
+          body: body === undefined ? undefined : JSON.stringify(body),
+          signal
+        });
+        if (!response.ok) {
+          if (response.status === 401) throw new Error('We couldn’t sign you in. Please check your details and try again.');
+          if (response.status === 429) throw new Error('Too many attempts. Please wait a moment and try again.');
+          throw new Error('Sign-in is unavailable right now. Please try again later.');
+        }
+        if (!response.headers.get('content-type')?.includes('application/json')) {
+          throw new Error('Sign-in is unavailable right now. Please try again later.');
+        }
+        return response.json();
+      }
+
+      function setBusy(value) {
+        busy = value;
+        passwordButton.disabled = value;
+        passkeyButton.disabled = value;
+        form.setAttribute('aria-busy', String(value));
+      }
+
+      function cancelPasskey() {
+        const controller = passkeyController;
+        passkeyController = null;
+        controller?.abort();
+      }
+
+      function updateSession(authenticated) {
+        signedIn = authenticated;
+        form.hidden = authenticated;
+        document.querySelector('#signin-help').hidden = authenticated;
+        accountAction.textContent = authenticated ? 'Sign out' : 'Sign in';
+        document.querySelector('#signin-title').textContent = authenticated
+          ? 'Welcome back. Make yourself at home.' : 'Welcome back to your daily ritual.';
+        if (authenticated) {
+          cancelPasskey();
+          password.value = '';
+          context.textContent = 'You’re signed in and ready for your next daily ritual.';
+          status.textContent = 'You’re signed in. Keep browsing or continue below.';
+          continueLink.href = destination?.href || '/account';
+          continueLink.textContent = 'Continue to ' + (destination?.label || 'My Account');
+          continueLink.hidden = false;
+        } else {
+          continueLink.hidden = true;
+          context.textContent = 'Sign in for your rewards, favorite orders, and a little more everyday joy.';
+        }
+      }
+
+      function showSignIn() {
+        document.querySelector('#sign-in').scrollIntoView({ block: 'center' });
+        username.focus({ preventScroll: true });
+      }
+
+      document.querySelectorAll('[data-signin]').forEach(link => {
+        link.addEventListener('click', event => {
+          if (signedIn || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+          event.preventDefault();
+          destination = { href: link.getAttribute('href'), label: link.dataset.signin };
+          context.textContent = 'Sign in to continue to ' + destination.label + '. You’ll stay on this page while signing in.';
+          showSignIn();
+        });
+      });
+
+      accountAction.addEventListener('click', async event => {
+        event.preventDefault();
+        if (!signedIn) return showSignIn();
+        if (busy) return;
+        setBusy(true);
+        try {
+          await request('logout', {});
+          updateSession(false);
+          destination = null;
+          status.textContent = 'You’ve signed out.';
+          showSignIn();
+          startConditionalSignIn();
+        } catch (error) {
+          status.textContent = 'We couldn’t sign you out. Please try again.';
+        } finally {
+          setBusy(false);
+        }
+      });
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (busy) return;
+        cancelPasskey();
+        setBusy(true);
+        status.textContent = 'Signing you in…';
+        try {
+          const result = await request('password', { username: username.value, password: password.value });
+          if (result.authenticated !== true) throw new Error('We couldn’t sign you in. Please try again.');
+          updateSession(true);
+        } catch (error) {
+          status.textContent = error instanceof TypeError ? 'Unable to connect. Please try again.' : error.message;
+        } finally {
+          setBusy(false);
+          if (!signedIn) startConditionalSignIn();
+        }
+      });
+
+      function decode(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64), char => char.charCodeAt(0));
+      }
+
+      function encode(value) {
+        return btoa(String.fromCharCode(...new Uint8Array(value)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      const passkeysSupported = window.isSecureContext && !!window.PublicKeyCredential && !!navigator.credentials;
+      passkeyButton.hidden = !passkeysSupported;
+
+      async function signInWithPasskey(conditional) {
+        cancelPasskey();
+        const controller = new AbortController();
+        passkeyController = controller;
+        try {
+          const options = await request('passkey/options', {}, controller.signal);
+          // Decode server-provided base64url values for browsers without JSON helpers.
+          const publicKey = {
+            ...options,
+            challenge: decode(options.challenge),
+            allowCredentials: (options.allowCredentials || []).map(credential => ({
+              ...credential, id: decode(credential.id)
+            }))
+          };
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: conditional ? 'conditional' : 'optional',
+            signal: controller.signal
+          });
+          if (!credential || controller.signal.aborted) return;
+          setBusy(true);
+          status.textContent = 'Signing you in…';
+          const result = await request('passkey/verify', {
+            id: credential.id,
+            rawId: encode(credential.rawId),
+            type: credential.type,
+            authenticatorAttachment: credential.authenticatorAttachment,
+            response: {
+              clientDataJSON: encode(credential.response.clientDataJSON),
+              authenticatorData: encode(credential.response.authenticatorData),
+              signature: encode(credential.response.signature),
+              userHandle: credential.response.userHandle ? encode(credential.response.userHandle) : null
+            },
+            clientExtensionResults: credential.getClientExtensionResults()
+          }, controller.signal);
+          if (result.authenticated !== true) throw new Error('We couldn’t sign you in. Please try again.');
+          updateSession(true);
+        } catch (error) {
+          if (controller.signal.aborted || error.name === 'AbortError') return;
+          // Conditional UI is silent when unavailable; password sign-in stays usable.
+          if (!conditional || busy) {
+            status.textContent = error.name === 'NotAllowedError'
+              ? 'No passkey selected. Try again or use your saved password.'
+              : 'Passkey sign-in is unavailable. Please try again or use your password.';
+          }
+        } finally {
+          if (passkeyController === controller) {
+            passkeyController = null;
+            setBusy(false);
+          }
+        }
+      }
+
+      async function startConditionalSignIn() {
+        if (!passkeysSupported || signedIn || busy || !PublicKeyCredential.isConditionalMediationAvailable) return;
+        try {
+          if (await PublicKeyCredential.isConditionalMediationAvailable()) {
+            if (!signedIn && !busy && !passkeyController) await signInWithPasskey(true);
+          }
+        } catch { /* Password autofill remains available in unsupported browsers. */ }
+      }
+
+      passkeyButton.addEventListener('click', async () => {
+        if (busy) return;
+        setBusy(true);
+        status.textContent = 'Choose your passkey in the browser prompt.';
+        await signInWithPasskey(false);
+        if (!signedIn) startConditionalSignIn();
+      });
+
+      async function initialize() {
+        try {
+          const session = await request('session');
+          // Do not interrupt a sign-in attempt if the session lookup finishes later.
+          if (!busy && session.authenticated === true) updateSession(true);
+        } catch { /* A missing session must never interrupt browsing. */ }
+        startConditionalSignIn();
+      }
+      window.addEventListener('pagehide', () => {
+        cancelPasskey();
+        setBusy(false);
+      });
+      window.addEventListener('pageshow', event => { if (event.persisted) initialize(); });
+      initialize();
+    })();
+  </script>
