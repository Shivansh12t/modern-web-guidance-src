+++ b/src/components/AccountPrivacyNotice.tsx
@@ -0,0 +1,12 @@
+export default function AccountPrivacyNotice({ purpose }: { purpose: string }) {
+  return (
+    <p id="account-privacy" className="text-sm text-gray-700">
+      To {purpose}, we send only your username and password over HTTPS to our
+      external account service at <span className="break-all">us-central1-web-devrel-apps.cloudfunctions.net</span>.
+      {' '}This happens only when you submit this form. The service also receives
+      connection information such as your IP address. This page clears the password
+      after each attempt and does not save credentials or tokens in browser storage.
+      {' '}<a href={`${import.meta.env.BASE_URL}legal/privacy`} className="underline">Read about data use and limitations</a>.
+    </p>
+  );
+}
