diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..047f515
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,22 @@
+// Keep credentials out of URLs, browser storage, analytics, and error messages.
+export async function submitCredentials(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<boolean> {
+  const response = await fetch(
+    `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`,
+    {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      credentials: 'omit',
+      cache: 'no-store',
+      referrerPolicy: 'no-referrer',
+      redirect: 'error',
+    },
+  );
+
+  // The UI only needs the outcome; do not consume tokens or raw service errors.
+  return response.ok;
+}
diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000..1c68152
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { submitCredentials } from '../src/utils/auth.ts';
+
+for (const action of ['login', 'register']) {
+  test(`${action} sends only credentials without ambient data`, async (t) => {
+    t.mock.method(globalThis, 'fetch', async (url, options) => {
+      assert.equal(url, `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`);
+      assert.equal(options.method, 'POST');
+      assert.deepEqual(options.headers, { 'Content-Type': 'application/json' });
+      assert.deepEqual(JSON.parse(options.body), { username: 'demo', password: 'sample123' });
+      assert.equal(options.credentials, 'omit');
+      assert.equal(options.cache, 'no-store');
+      assert.equal(options.referrerPolicy, 'no-referrer');
+      assert.equal(options.redirect, 'error');
+      return { ok: true, json() { throw new Error('Must not read tokens'); } };
+    });
+    assert.equal(await submitCredentials(action, 'demo', 'sample123'), true);
+  });
+}
+
+test('service errors remain private and network errors reach the form handler', async (t) => {
+  const mock = t.mock.method(globalThis, 'fetch', async () => ({
+    ok: false,
+    json() { throw new Error('Must not read raw errors'); },
+  }));
+  assert.equal(await submitCredentials('login', 'demo', 'sample123'), false);
+  mock.mock.mockImplementation(async () => { throw new Error('Network unavailable'); });
+  await assert.rejects(submitCredentials('register', 'demo', 'sample123'));
+});
+
+test('shared document has no external scripts or font connections', async () => {
+  const layout = await readFile(new URL('../src/layouts/Layout.astro', import.meta.url), 'utf8');
+  assert.doesNotMatch(layout, /<script[^>]*src=|fonts\.google|rel="preconnect"|AdSlotFireplace/);
+  assert.match(layout, /<meta name="referrer" content="no-referrer"/);
+  assert.match(layout, /charset="UTF-8"/);
+});
