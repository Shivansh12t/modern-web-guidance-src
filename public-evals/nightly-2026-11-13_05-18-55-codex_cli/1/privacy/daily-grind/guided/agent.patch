+import { cp, mkdir, rm } from 'node:fs/promises';
+
+// Publish only public assets, never source tooling or repository metadata.
+await rm('dist', { recursive: true, force: true });
+await mkdir('dist', { recursive: true });
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(path, `dist/${path}`, { recursive: true });
+}
+console.log('Static site built in dist/.');
diff --git a/scripts/privacy.test.mjs b/scripts/privacy.test.mjs
new file mode 100644
index 0000000..18968d2
--- /dev/null
+++ b/scripts/privacy.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir, access } from 'node:fs/promises';
+import test from 'node:test';
+
+const pages = ['index.html', 'privacy-policy/index.html'];
+const headerText = await readFile('_headers', 'utf8');
+const headers = Object.fromEntries(headerText.trim().split('\n').slice(1).map(line => {
+  const separator = line.indexOf(':');
+  return [line.slice(0, separator).trim(), line.slice(separator + 1).trim()];
+}));
+const directives = Object.fromEntries(headers['Content-Security-Policy'].split(';').map(part => {
+  const [name, ...values] = part.trim().split(/\s+/);
+  return [name, values.join(' ')];
+}));
+
+test('CSP denies execution, collection channels, and framing', () => {
+  for (const name of ['default-src', 'script-src', 'script-src-attr', 'style-src-attr',
+    'connect-src', 'frame-src', 'object-src', 'base-uri', 'form-action', 'worker-src',
+    'manifest-src', 'font-src', 'frame-ancestors', 'trusted-types']) {
+    assert.equal(directives[name], "'none'", name);
+  }
+  assert.equal(directives['style-src'], "'self'");
+  assert.equal(directives['img-src'], "'self'");
+  assert.equal(directives['require-trusted-types-for'], "'script'");
+});
+
+test('privacy headers disable referrers, unused permissions, and caching', () => {
+  assert.equal(headers['Referrer-Policy'], 'no-referrer');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.equal(headers['X-DNS-Prefetch-Control'], 'off');
+  assert.equal(headers['Cache-Control'], 'no-store');
+  assert.equal(headers['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.match(headers['Strict-Transport-Security'], /^max-age=\d+$/);
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics']) {
+    assert.ok(headers['Permissions-Policy'].split(', ').includes(`${feature}=()`));
+  }
+  assert.equal(headers['Set-Cookie'], undefined);
+});
+
+for (const page of pages) {
+  test(`${page} keeps the document fallback aligned and collects no data`, async () => {
+    const html = await readFile(page, 'utf8');
+    const metaPolicy = html.match(/http-equiv="Content-Security-Policy" content="([^"]+)"/)[1];
+    assert.equal(metaPolicy, headers['Content-Security-Policy'].replace("; frame-ancestors 'none'", ''));
+    assert.match(html, /<meta name="referrer" content="no-referrer">/);
+    assert.doesNotMatch(html, /<(?:script|iframe|object|embed|form|input|textarea|select)\b/i);
+    assert.doesNotMatch(html, /\s(?:on\w+|style|ping)\s*=/i);
+    assert.doesNotMatch(html, /rel=["'][^"']*(?:preconnect|dns-prefetch|prefetch|prerender)/i);
+    for (const [, attribute, url] of html.matchAll(/\b(src|href|action)="([^"]+)"/gi)) {
+      assert.ok(url.startsWith('/') && !url.startsWith('//'), `${attribute}: ${url}`);
+      if (attribute === 'src' || url.startsWith('/assets/')) await access(`.${url}`);
+    }
+    assert.ok(html.indexOf('http-equiv="Content-Security-Policy"') < html.indexOf('<link'));
+  });
+}
+
+test('all published styling and media are local and no runtime scripts ship', async () => {
+  const css = await readFile('assets/styles.css', 'utf8');
+  assert.doesNotMatch(css, /@import|https?:|\/\/|data:|expression\s*\(/i);
+  for (const [, url] of css.matchAll(/url\(['"]?([^'"\s)]+)/g)) {
+    assert.ok(url.startsWith('/assets/'));
+    await access(`.${url}`);
+  }
+  for (const name of await readdir('assets')) {
+    assert.match(name, /\.(?:css|jpg)$/);
+  }
+  const photo = await readFile('assets/coffee.jpg');
+  assert.equal(photo.subarray(0, 3).toString('hex'), 'ffd8ff');
+});
