--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,12 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const root = new URL('../', import.meta.url);
+const output = new URL('dist/', root);
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+// Only public assets may be deployed; never copy the working directory wholesale.
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(new URL(path, root), new URL(path, output), { recursive: true });
+}
+console.log(`Static site built in ${fileURLToPath(output)}`);
diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000..1b498b5
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, existsSync } from 'node:fs';
+import { execFileSync } from 'node:child_process';
+import { join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = new URL('../', import.meta.url);
+const read = path => readFileSync(new URL(path, root), 'utf8');
+const headers = Object.fromEntries(read('_headers').trim().split('\n').slice(1).map(line => {
+  const separator = line.indexOf(':');
+  return [line.slice(0, separator).trim(), line.slice(separator + 1).trim()];
+}));
+
+test('headers deny script execution, collection, embedding, and unnecessary permissions', () => {
+  const directives = Object.fromEntries(headers['Content-Security-Policy'].split(';').map(value => {
+    const [key, ...sources] = value.trim().split(/\s+/);
+    return [key, sources.join(' ')];
+  }));
+  for (const key of ['default-src', 'script-src', 'connect-src', 'object-src', 'base-uri', 'form-action', 'frame-ancestors']) {
+    assert.equal(directives[key], "'none'", key);
+  }
+  for (const key of ['img-src', 'style-src']) assert.equal(directives[key], "'self'", key);
+  assert.equal(headers['Referrer-Policy'], 'no-referrer');
+  assert.equal(headers['Cache-Control'], 'no-store');
+  assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.equal(headers['X-DNS-Prefetch-Control'], 'off');
+  assert.match(headers['Strict-Transport-Security'], /^max-age=31536000$/);
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics']) {
+    assert.ok(headers['Permissions-Policy'].split(', ').includes(`${feature}=()`), feature);
+  }
+  assert.ok(!('Set-Cookie' in headers));
+});
+
+test('deployment providers apply the same headers on every route', () => {
+  const vercel = JSON.parse(read('vercel.json'));
+  assert.equal(vercel.headers[0].source, '/(.*)');
+  assert.deepEqual(Object.fromEntries(vercel.headers[0].headers.map(({ key, value }) => [key, value])), headers);
+  assert.equal(vercel.outputDirectory, 'dist');
+  assert.match(read('netlify.toml'), /publish = "dist"/);
+});
+
+test('deployable pages have no collection surfaces or third-party resource requests', () => {
+  for (const path of ['index.html', 'privacy-policy/index.html']) {
+    const html = read(path);
+    assert.doesNotMatch(html, /<(?:script|style|iframe|object|embed|form|input|textarea|base)\b/i, path);
+    assert.doesNotMatch(html, /\s(?:on\w+|style|ping|srcdoc)\s*=/i, path);
+    assert.doesNotMatch(html, /(?:https?:)?\/\/|javascript:|data:|preconnect|dns-prefetch/i, path);
+    assert.match(html, /<meta name="referrer" content="no-referrer">/);
+    const meta = html.match(/http-equiv="Content-Security-Policy" content="([^"]+)"/);
+    assert.ok(meta, path);
+    // frame-ancestors requires an HTTP header, so it must not be put in a meta tag.
+    assert.equal(meta[1], headers['Content-Security-Policy'].replace("; frame-ancestors 'none'", ''));
+    for (const match of html.matchAll(/<(?:link|img)\b[^>]*\b(?:href|src)="([^"]+)"/gi)) {
+      assert.ok(match[1].startsWith('/assets/'), match[1]);
+      assert.ok(existsSync(new URL(`..${match[1]}`, import.meta.url)), match[1]);
+    }
+  }
+  const css = read('assets/styles.css');
+  assert.doesNotMatch(css, /@import|https?:|\/\/|data:/i);
+  for (const match of css.matchAll(/url\(['"]?([^'"\)]+)['"]?\)/g)) {
+    assert.ok(match[1].startsWith('/assets/'), match[1]);
+    assert.ok(existsSync(new URL(`..${match[1]}`, import.meta.url)), match[1]);
+  }
+  const pkg = JSON.parse(read('package.json'));
+  for (const type of ['dependencies', 'devDependencies']) assert.equal(Object.keys(pkg[type] ?? {}).length, 0);
+  assert.doesNotMatch(JSON.stringify(pkg.scripts), /\bdlx\b|\bnpx\b/);
+});
+
+test('build contains only reviewed public assets and includes the privacy page and headers', () => {
+  execFileSync(process.execPath, ['scripts/build.mjs'], { cwd: root });
+  const files = readdirSync(new URL('dist/', root), { recursive: true, withFileTypes: true })
+    .filter(entry => entry.isFile())
+    .map(entry => relative(fileURLToPath(new URL('dist/', root)), join(entry.parentPath, entry.name))).sort();
+  assert.deepEqual(files, ['_headers', 'assets/coffee.jpg', 'assets/styles.css', 'index.html', 'privacy-policy/index.html']);
+  for (const file of files) assert.deepEqual(readFileSync(new URL(`dist/${file}`, root)), readFileSync(new URL(file, root)));
+  const image = readFileSync(new URL('dist/assets/coffee.jpg', root));
+  assert.equal(image.readUInt16BE(0), 0xffd8, 'hero image is a local JPEG');
+});
