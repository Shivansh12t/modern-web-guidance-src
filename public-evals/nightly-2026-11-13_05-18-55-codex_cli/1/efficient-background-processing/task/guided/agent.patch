+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const beans = Array.from({ length: 36 }, () => ({
+        x: 0.08 + Math.random() * 0.84,
+        y: 0.15 + Math.random() * 0.7,
+        angle: Math.random() * Math.PI * 2,
+        speed: 0.6 + Math.random(),
+      }));
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let frameId = null;
+      let intervalId = null;
+      let inViewport = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let lastFrame = null;
+      let elapsed = 0;
+      let degrees = 185;
+
+      function drawBeans() {
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach((bean) => {
+          context.save();
+          context.translate(
+            bean.x * canvas.width + Math.sin(elapsed * bean.speed) * 22,
+            bean.y * canvas.height + Math.cos(elapsed * bean.speed * 1.4) * 12
+          );
+          context.rotate(bean.angle + elapsed * bean.speed);
+          context.fillStyle = degrees > 200 ? '#80482b' : '#b47745';
+          context.beginPath();
+          context.ellipse(0, 0, 14, 9, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#3e2723';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-10, 0);
+          context.bezierCurveTo(-3, -5, 3, 5, 10, 0);
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(timestamp) {
+        if (lastFrame !== null) elapsed += Math.min((timestamp - lastFrame) / 1000, 0.05);
+        lastFrame = timestamp;
+        drawBeans();
+        frameId = requestAnimationFrame(animate);
+      }
+
+      function stop() {
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = null;
+        intervalId = null;
+        lastFrame = null;
+      }
+
+      function syncActivity() {
+        if (!inViewport || renderingSkipped || document.hidden || !pageActive) {
+          stop();
+          return;
+        }
+        if (context) {
+          if (reducedMotion.matches) {
+            if (frameId !== null) cancelAnimationFrame(frameId);
+            frameId = null;
+            lastFrame = null;
+            drawBeans();
+          } else if (frameId === null) {
+            frameId = requestAnimationFrame(animate);
+          }
+        }
+        if (intervalId === null) {
+          intervalId = setInterval(() => {
+            degrees = Math.max(180, Math.min(220, degrees + (Math.random() - 0.4) * 3));
+            temperature.textContent = degrees.toFixed(0);
+          }, 1000);
+        }
+      }
+
+      // Listen on the container itself: this rendering-state event may not bubble.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      // Also enforce exact viewport visibility; native rendering may begin offscreen.
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(([entry]) => {
+          inViewport = entry.isIntersecting;
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Older browsers without either API still pause all simulation timers.
+        const checkVisibility = () => {
+          const bounds = widget.getBoundingClientRect();
+          inViewport = bounds.bottom > 0 && bounds.top < window.innerHeight &&
+            bounds.right > 0 && bounds.left < window.innerWidth;
+          syncActivity();
+        };
+        window.addEventListener('scroll', checkVisibility, { passive: true, capture: true });
+        window.addEventListener('resize', checkVisibility, { passive: true });
+        window.addEventListener('pageshow', checkVisibility);
+        checkVisibility();
+      }
+
+      document.addEventListener('visibilitychange', syncActivity);
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        stop();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        syncActivity();
+      });
+      if (reducedMotion.addEventListener) reducedMotion.addEventListener('change', syncActivity);
+      else reducedMotion.addListener(syncActivity);
+    })();
+  </script>
+
