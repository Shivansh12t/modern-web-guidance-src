+<script>
+    // Keep older browsers in sync, including items inserted or removed later.
+    // Native sibling functions use the same direct-child coordinates in modern browsers.
+    function updateCollections() {
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach(container => {
+        const items = [...container.children];
+        items.forEach((item, index) => {
+          if (item.matches('.card')) item.classList.add('spectrum-card');
+          item.style.setProperty('--fallback-index', index + 1);
+          item.style.setProperty('--fallback-count', items.length);
+        });
+      });
+    }
+    updateCollections();
+    new MutationObserver(updateCollections).observe(document.querySelector('main'), {
+      childList: true,
+      subtree: true
+    });
+  </script>
