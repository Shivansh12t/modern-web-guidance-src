+      border-radius: 50%;
+    }
+
+    .circle-orb {
+      --angle: calc(360deg * (var(--index) - 1) / var(--count) - 90deg);
+      --radius: 32cqi;
+      /* Shrink badges as the count grows to keep neighboring badges apart. */
