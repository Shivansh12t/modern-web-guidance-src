+      aspect-ratio: 1;
+      display: grid;
+      place-content: center;
+      padding: calc(var(--orb-size) / 12);
+      border-radius: 50%;
+      border: 1px solid hsl(var(--hue) 35% 75%);
+      background-color: hsl(var(--hue) 45% 90%);
+      color: #30221e;
+      font-size: min(0.9rem, calc(var(--orb-size) / 7));
+      line-height: 1.4;
+      box-shadow: 0 4px 12px rgb(62 39 35 / 8%);
+      transform: translate(-50%, -50%) translate(
+        calc(cos(var(--angle)) * var(--radius)),
+        calc(sin(var(--angle)) * var(--radius))
+      );
+    }
+
+    .circle-orb span {
