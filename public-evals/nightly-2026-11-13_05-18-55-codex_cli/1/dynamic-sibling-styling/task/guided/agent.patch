+  <script>
+    // Native CSS updates automatically. Keep the same behavior in older browsers.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach((container) => {
+        const updateSiblings = () => {
+          const items = Array.from(container.children);
+          items.forEach((item, index) => {
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', items.length);
+          });
+        };
+        updateSiblings();
+        new MutationObserver(updateSiblings).observe(container, { childList: true });
+      });
+    }
+  </script>
