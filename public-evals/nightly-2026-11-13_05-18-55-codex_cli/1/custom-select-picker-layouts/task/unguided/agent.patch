+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.querySelector('#roast-trigger');
+    const menu = document.querySelector('#roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+
+    function closePicker(restoreFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker() {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      document.querySelector('#roast-value').textContent = option.querySelector('strong').textContent;
+      document.querySelector('#order-now').href = '/order-online?roast=' + option.dataset.roast;
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => menu.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(option));
+      option.addEventListener('keydown', event => {
+        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
+        if (step) {
+          event.preventDefault();
+          options[(index + step + options.length) % options.length].focus();
+        } else if (event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          options[event.key === 'Home' ? 0 : options.length - 1].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          selectRoast(option);
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          closePicker(true);
+        }
+      });
+    });
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
