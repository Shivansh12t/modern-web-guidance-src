+import { createPasskeyStore } from './passkeys.mjs';
+const paths = {
+  coffee: '<path d="M5 8h12v8a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4Z"/><path d="M17 9h2a3 3 0 1 1 0 6h-2M8 3v2m4-3v3m4-2v2M3 22h17"/>',
+  user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>',
+  shield: '<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z"/>',
+  'shield-check': '<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z"/><path d="m8 12 3 3 5-6"/>',
+  key: '<circle cx="8" cy="8" r="5"/><path d="m11.5 11.5 9 9m-3-3 3-3m-6 0 3-3"/>',
+  laptop: '<rect x="4" y="4" width="16" height="12" rx="1"/><path d="m4 16-2 4h20l-2-4M9 20h6"/>',
+  phone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M10 5h4m-3 14h2"/>',
+  pencil: '<path d="m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-5-5L4 14Z"/>',
+  trash: '<path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7"/>',
+  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
+  bag: '<path d="M4 7h16l1 14H3ZM8 8V6a4 4 0 0 1 8 0v2"/>',
+  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8H8a3 3 0 1 1 3-3Zm0 0h4a3 3 0 1 0-3-3Z"/>',
+  heart: '<path d="M20 4c-3-3-7-1-8 1-1-2-5-4-8-1-5 5 2 11 8 16 6-5 13-11 8-16Z"/>',
+  logout: '<path d="M9 4H4v16h5m5-13 5 5-5 5m-7-5h12"/>',
+  lock: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/>',
+  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v1"/>',
+  check: '<path d="m5 12 4 4L19 6"/>',
+  refresh: '<path d="M20 8a8 8 0 0 0-14-3L3 8m0-5v5h5M4 16a8 8 0 0 0 14 3l3-3m0 5v-5h-5"/>',
+  chat: '<path d="M21 11a9 9 0 0 1-9 9H4l-2 2V11a9 9 0 0 1 19 0Z"/><path d="M7 11h.01m5 0h.01m5 0h.01"/>',
+};
+function icon(name) { return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name] || paths.key}</svg>`; }
+document.querySelectorAll('[data-icon]').forEach(el => { el.innerHTML = icon(el.dataset.icon); });
+const $ = id => document.getElementById(id);
+const store = createPasskeyStore({ endpoint: document.body.dataset.accountApi || '', csrfToken: document.querySelector('meta[name="csrf-token"]')?.content || '' });
+let keys = [];
+let selectedId;
+let toastTimer;
+function notify(message) {
+  $('toast-message').textContent = message;
+  $('toast').hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => { $('toast').hidden = true; }, 5500);
+}
+const dateFormat = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+function formatDate(value) { return value == null ? 'Never used' : dateFormat.format(value); }
+function render() {
+  const list = $('passkey-list');
+  list.replaceChildren();
+  $('key-count').textContent = keys.length;
+  if (!keys.length) {
+    const empty = document.createElement('div');
+    empty.className = 'empty';
+    empty.innerHTML = '<strong>No passkeys saved.</strong><p>You can still use your password to sign in. Passkeys you register for this account will appear here.</p>';
+    list.append(empty);
+  }
+  keys.forEach(key => {
+    const row = document.createElement('article');
+    row.className = 'passkey-row';
+    row.innerHTML = `<span class="provider-icon">${icon(key.icon)}</span><div class="key-details"><div class="key-title"><h4></h4></div><p class="provider-name"></p><div class="key-dates"><span class="registered"></span><span class="last-used"></span></div></div><div class="key-actions"><button class="icon-button rename" type="button">${icon('pencil')}</button><button class="icon-button delete" type="button">${icon('trash')}</button></div>`;
+    row.querySelector('h4').textContent = key.name;
+    row.querySelector('.provider-name').textContent = key.provider || 'Passkey provider';
+    row.querySelector('.registered').textContent = `Added ${formatDate(key.registeredAt)}`;
+    row.querySelector('.last-used').textContent = key.lastUsedAt == null ? 'Never used' : `Used ${formatDate(key.lastUsedAt)}`;
+    const rename = row.querySelector('.rename');
+    rename.setAttribute('aria-label', `Rename ${key.name}`);
+    rename.title = 'Rename passkey';
+    rename.addEventListener('click', () => {
+      selectedId = key.id;
+      $('passkey-name').value = key.name;
+      $('rename-error').hidden = true;
+      $('rename-dialog').showModal();
+      $('passkey-name').select();
+    });
+    const remove = row.querySelector('.delete');
+    remove.setAttribute('aria-label', `Remove ${key.name}`);
+    remove.title = 'Remove passkey';
+    remove.addEventListener('click', () => {
+      selectedId = key.id;
+      $('delete-name').textContent = key.name;
+      $('delete-warning').textContent = keys.length === 1 ? 'This is your last passkey. Make sure you can sign in with your password before removing it.' : 'This action can’t be undone. You can register a new passkey later.';
+      $('delete-error').hidden = true;
+      $('delete-dialog').showModal();
+    });
+    list.append(row);
+  });
+  list.setAttribute('aria-busy', 'false');
+}
+async function synchronize() {
+  const result = await store.sync();
+  $('sync-message').textContent = {
+    demo: 'Preview mode. No changes are sent to your browser authenticator or password manager.',
+    sent: 'Your browser has been notified of your current passkeys. Your passkey provider manages synchronization across devices.',
+    unsupported: 'Your account is up to date. This browser can’t sync passkey changes; remove unused keys in your device or password manager settings too.',
+    failed: 'Your account was updated, but your authenticator couldn’t sync. You can remove unused passkeys in your device or password manager settings.',
+  }[result];
+}
+async function load() {
+  $('load-error').hidden = true;
+  $('passkey-list').setAttribute('aria-busy', 'true');
+  try { keys = await store.list(); render(); await synchronize(); }
+  catch (error) {
+    $('load-error').textContent = error.message;
+    $('load-error').hidden = false;
+    $('passkey-list').replaceChildren();
+    const retry = document.createElement('button');
+    retry.className = 'secondary-button';
+    retry.textContent = 'Try again';
+    retry.addEventListener('click', load);
+    $('passkey-list').append(retry);
+    $('passkey-list').setAttribute('aria-busy', 'false');
+    $('key-count').textContent = '—';
+  }
+}
+document.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => $(button.dataset.close).close()));
+for (const action of ['rename', 'delete']) {
+  const form = $(`${action}-form`);
+  const dialog = $(`${action}-dialog`);
+  let busy = false;
+  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    if (action === 'rename' && !$('passkey-name').value.trim()) {
+      $('passkey-name').setCustomValidity('Please enter a passkey name.');
+      $('passkey-name').reportValidity();
+      return;
+    }
+    busy = true;
+    form.querySelectorAll('button').forEach(button => { button.disabled = true; });
+    const errorElement = $(`${action}-error`);
+    errorElement.hidden = true;
+    try {
+      if (action === 'rename') await store.rename(selectedId, $('passkey-name').value);
+      else await store.remove(selectedId);
+      keys = await store.list();
+      dialog.close();
+      render();
+      // The deleted or rebuilt invoker no longer exists; keep keyboard focus in the list.
+      const nextAction = $('passkey-list').querySelector('button');
+      if (nextAction) nextAction.focus();
+      else { $('passkeys-heading').tabIndex = -1; $('passkeys-heading').focus(); }
+      notify(action === 'rename' ? 'Passkey name updated.' : 'Passkey removed from your account.');
+      if (action === 'delete') await synchronize();
+    } catch (error) { errorElement.textContent = error.message; errorElement.hidden = false; }
+    finally { busy = false; form.querySelectorAll('button').forEach(button => { button.disabled = false; }); }
+  });
+}
+$('passkey-name').addEventListener('input', () => $('passkey-name').setCustomValidity(''));
+$('reset-demo').hidden = !store.demo;
+$('mode-label').textContent = store.demo ? 'Preview account · changes are saved only in this browser.' : 'Your registered account passkeys.';
+$('reset-demo').addEventListener('click', async () => {
+  try { store.reset(); await load(); notify('Preview passkeys restored.'); }
+  catch { notify('Browser storage is unavailable. Enable it to use the preview.'); }
+});
+const panels = {
+  overview: ['Welcome back, Jamie.', 'Your daily ritual, at a glance.', '<h3>Good things are brewing.</h3><p>You have 240 Grind points and three saved sign-in methods. Keep your account details and security up to date here.</p>'],
+  orders: ['My orders', 'Your recent coffee moments.', '<h3>A fresh start.</h3><p>This preview account has no recent orders. Your next Daily Grind order will appear here.</p>'],
+  rewards: ['Grind rewards', 'A little thank-you for your daily ritual.', '<h3>240 points. Plenty to look forward to.</h3><p>You’re a Grind club member. Your rewards and point history will appear here when connected to your account.</p>'],
+  details: ['Personal details', 'The familiar face behind the daily ritual.', '<h3>Nice to see you, Jamie.</h3><dl><dt>Name</dt><dd>Jamie Davis</dd><dt>Member since</dt><dd>2024</dd></dl><p>This is a preview profile. Personal details can be managed when your account service is connected.</p>'],
+};
+function selectTab(tab) {
+  const security = tab === 'security';
+  $('security-panel').hidden = !security;
+  $('other-panel').hidden = security;
+  document.querySelectorAll('[data-tab]').forEach(button => {
+    button.classList.toggle('active', button.dataset.tab === tab);
+    if (button.dataset.tab === tab) button.setAttribute('aria-current', 'page');
+    else button.removeAttribute('aria-current');
+  });
+  $('breadcrumb-current').textContent = security ? 'Security & passkeys' : panels[tab][0];
+  if (!security) {
+    $('other-title').textContent = panels[tab][0];
+    $('other-description').textContent = panels[tab][1];
+    $('other-content').innerHTML = panels[tab][2];
+  }
+}
+document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => selectTab(button.dataset.tab)));
+$('back-security').addEventListener('click', () => selectTab('security'));
+document.querySelector('.account-link').addEventListener('click', () => selectTab('security'));
+load();
