diff --git a/tests/passkeys.test.mjs b/tests/passkeys.test.mjs
new file mode 100644
index 0000000..6b1b65f
--- /dev/null
+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPasskeyStore, seedCredentials, syncCredentials, isBase64url } from '../passkeys.mjs';
+const memory = () => {
+  const values = new Map();
+  return { getItem: key => values.get(key) ?? null, setItem: (key, value) => values.set(key, value), removeItem: key => values.delete(key) };
+};
+const account = credentials => ({ rpId: 'dailygrind.example', userId: 'amFtaWU', complete: true, credentials });
+test('demo changes persist across reloads and reset restores keys', async () => {
+  const storage = memory();
+  const store = createPasskeyStore({ storage });
+  const [first] = await store.list();
+  await store.rename(first.id, '  Work laptop  ');
+  assert.equal((await createPasskeyStore({ storage }).list())[0].name, 'Work laptop');
+  await store.remove(first.id);
+  assert.equal((await createPasskeyStore({ storage }).list()).length, 2);
+  for (const key of await store.list()) await store.remove(key.id);
+  assert.deepEqual(await createPasskeyStore({ storage }).list(), []);
+  store.reset();
+  assert.equal((await store.list()).length, 3);
+});
+test('invalid names and failed persistence leave data unchanged', async () => {
+  const storage = memory();
+  const store = createPasskeyStore({ storage });
+  const [first] = await store.list();
+  await assert.rejects(store.rename(first.id, '   '));
+  await assert.rejects(store.rename(first.id, 'a'.repeat(65)));
+  storage.setItem = () => { throw new Error('Storage full'); };
+  await assert.rejects(store.remove(first.id), /Storage full/);
+  assert.equal((await store.list()).length, 3);
+});
+test('only complete valid server data is signaled with the server RP ID', async () => {
+  const calls = [];
+  const api = { signalAllAcceptedCredentials: async value => calls.push(value) };
+  assert.equal(await syncCredentials(account(seedCredentials), api), 'sent');
+  assert.deepEqual(calls[0], { rpId: 'dailygrind.example', userId: 'amFtaWU', allAcceptedCredentialIds: seedCredentials.map(c => c.id) });
+  const originalWarn = console.warn;
+  console.warn = () => {};
+  try {
+    assert.equal(await syncCredentials({ ...account(seedCredentials), complete: false }, api), 'failed');
+    assert.equal(await syncCredentials({ ...account(seedCredentials), userId: 'bad=' }, api), 'failed');
+    assert.equal(calls.length, 1);
+  } finally { console.warn = originalWarn; }
+});
+test('an authoritative empty list can remove the last accepted credential', async () => {
+  let payload;
+  await syncCredentials(account([]), { signalAllAcceptedCredentials: async value => { payload = value; } });
+  assert.deepEqual(payload.allAcceptedCredentialIds, []);
+});
+test('unsupported browsers and rejected signaling do not break management', async () => {
+  assert.equal(await syncCredentials(account(seedCredentials), {}), 'unsupported');
+  const originalWarn = console.warn;
+  console.warn = () => {};
+  try { assert.equal(await syncCredentials(account([]), { signalAllAcceptedCredentials: async () => { throw new Error('Unavailable'); } }), 'failed'); }
+  finally { console.warn = originalWarn; }
+});
+test('real API deletes then fetches a fresh complete list; mutations carry CSRF protection', async () => {
+  const requests = [];
+  let current = structuredClone(seedCredentials);
+  const store = createPasskeyStore({ endpoint: '/api/account/passkeys', csrfToken: 'csrf-value', storage: memory(), fetcher: async (url, options) => {
+    requests.push({ url, ...options });
+    if (options.method === 'DELETE') { current = current.slice(1); return { ok: true, status: 204 }; }
+    return { ok: true, status: 200, json: async () => account(current) };
+  } });
+  await store.list();
+  await store.remove(seedCredentials[0].id);
+  assert.equal(requests[1].method, 'DELETE');
+  assert.equal(requests[1].headers['X-CSRF-Token'], 'csrf-value');
+  assert.equal(requests[1].credentials, 'same-origin');
+  assert.equal(requests[2].url, '/api/account/passkeys');
+  assert.equal((await store.list()).length, 2);
+});
+test('failed account requests never fall back to demo data', async () => {
+  const store = createPasskeyStore({ endpoint: '/api/account/passkeys', storage: memory(), fetcher: async () => ({ ok: false, status: 401 }) });
+  await assert.rejects(store.list(), /session has expired/);
+  assert.equal(await store.sync(), 'failed');
+});
+test('seed credentials and user IDs are unpadded base64url', () => {
+  assert.ok(seedCredentials.every(c => isBase64url(c.id)));
+  for (const value of ['a', 'bad=', '', 'a+b/', null]) assert.equal(isBase64url(value), false);
+});
+test('demo synchronization never reaches the authenticator', async () => {
+  const previous = globalThis.PublicKeyCredential;
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: () => { assert.fail('Demo must never signal'); } };
+  try {
+    const store = createPasskeyStore({ storage: memory() });
+    await store.list();
+    await store.remove(seedCredentials[0].id);
+    assert.equal(await store.sync(), 'demo');
+  } finally { globalThis.PublicKeyCredential = previous; }
+});
