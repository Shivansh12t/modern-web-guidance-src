+export const seedCredentials = [
+  { id: 'ZGFpbHktZ3JpbmQtaWNsb3Vk', name: 'MacBook Pro', provider: 'iCloud Keychain', icon: 'laptop', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 10, 13) },
+  { id: 'ZGFpbHktZ3JpbmQtZ29vZ2xl', name: 'My everyday phone', provider: 'Google Password Manager', icon: 'phone', registeredAt: Date.UTC(2026, 8, 14), lastUsedAt: Date.UTC(2026, 10, 11) },
+  { id: 'ZGFpbHktZ3JpbmQtc2VjdXJpdHkta2V5', name: 'Backup security key', provider: 'Security key', icon: 'key', registeredAt: Date.UTC(2026, 9, 2), lastUsedAt: null },
+];
+export function isBase64url(value) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+export function validateAccount(data) {
+  if (!data || !data.rpId || !isBase64url(data.userId) || data.complete !== true || !Array.isArray(data.credentials) || !data.credentials.every(c => isBase64url(c.id) && typeof c.name === 'string' && c.name.length > 0 && Number.isFinite(c.registeredAt) && (c.lastUsedAt == null || Number.isFinite(c.lastUsedAt))) || new Set(data.credentials.map(c => c.id)).size !== data.credentials.length) {
+    throw new Error('The account service returned incomplete passkey data. Please try again.');
+  }
+  return data;
+}
+export async function syncCredentials(account, credentialAPI = globalThis.PublicKeyCredential) {
+  if (!credentialAPI?.signalAllAcceptedCredentials) return 'unsupported';
+  try {
+    validateAccount(account);
+    await credentialAPI.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: account.credentials.map(c => c.id) });
+    return 'sent';
+  } catch (error) {
+    console.warn('Passkey provider synchronization was not completed.', error);
+    return 'failed';
+  }
+}
+export function createPasskeyStore({ endpoint = '', csrfToken = '', fetcher = globalThis.fetch, storage = globalThis.localStorage } = {}) {
+  const demo = !endpoint;
+  const storageKey = 'daily-grind-passkeys-v1';
+  let credentials;
+  let account;
+  async function request(path = '', options = {}) {
+    const response = await fetcher(`${endpoint}${path}`, { credentials: 'same-origin', cache: 'no-store', ...options, headers: { Accept: 'application/json', ...(options.body ? { 'Content-Type': 'application/json' } : {}), ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}) } });
+    if (!response.ok) throw new Error(response.status === 401 ? 'Your session has expired. Please sign in again.' : 'We couldn’t update your passkeys. Please try again.');
+    return response.status === 204 ? null : response.json();
+  }
+  function persist(next) {
+    // Do not change the visible list if persistence fails.
+    storage.setItem(storageKey, JSON.stringify(next));
+    credentials = next;
+  }
+  return {
+    demo,
+    async list() {
+      if (!demo) { account = validateAccount(await request()); return account.credentials; }
+      if (!credentials) {
+        const saved = storage.getItem(storageKey);
+        if (saved) {
+          const parsed = JSON.parse(saved);
+          if (!Array.isArray(parsed) || !parsed.every(c => isBase64url(c.id) && typeof c.name === 'string' && Number.isFinite(c.registeredAt))) throw new Error('Preview data could not be loaded. Use Reset demo to start again.');
+          credentials = parsed;
+        } else credentials = structuredClone(seedCredentials);
+      }
+      return structuredClone(credentials);
+    },
+    async rename(id, name) {
+      name = name.trim();
+      if (!name || name.length > 64) throw new Error('Enter a name between 1 and 64 characters.');
+      if (demo) {
+        if (!credentials?.some(c => c.id === id)) throw new Error('This passkey no longer exists. Reload the page.');
+        persist(credentials.map(c => c.id === id ? { ...c, name } : c));
+      } else await request(`/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ name }) });
+    },
+    async remove(id) {
+      if (demo) {
+        if (!credentials?.some(c => c.id === id)) throw new Error('This passkey no longer exists. Reload the page.');
+        persist(credentials.filter(c => c.id !== id));
+      } else {
+        await request(`/${encodeURIComponent(id)}`, { method: 'DELETE' });
+        // Refetch the complete authoritative list before notifying any authenticator.
+        account = validateAccount(await request());
+      }
+    },
+    async sync() { return demo ? 'demo' : account ? syncCredentials(account) : 'failed'; },
+    reset() { if (demo) { storage.removeItem(storageKey); credentials = undefined; } },
+  };
+}
