+import { createPasskeyService } from './passkey-service.js';
+
+const apiBase = document.querySelector('meta[name="passkey-api"]')?.content;
+let service;
+let busy = false;
+
+// This static site has no authentication service. Demo records must never be
+// sent to an authenticator: they are not registered WebAuthn credentials.
+const storageKey = 'daily-grind.demo-passkeys.v1';
+const initialKeys = [
+  { id: 'demo-macbook', name: 'MacBook Pro', provider: 'iCloud Keychain', device: 'laptop', created: 'Oct 12, 2026', lastUsed: 'Today', current: true, demo: true },
+  { id: 'demo-iphone', name: 'iPhone 15', provider: 'iCloud Keychain', device: 'phone', created: 'Sep 28, 2026', lastUsed: 'Nov 10, 2026', current: false, demo: true }
+];
+let keys = structuredClone(initialKeys);
+let storageAvailable = true;
+try {
+  const saved = JSON.parse(localStorage.getItem(storageKey));
+  if (Array.isArray(saved) && saved.every(key => key && typeof key.id === 'string' && typeof key.name === 'string' && key.name.trim() && key.name.length <= 50 && key.demo === true && ['phone', 'laptop'].includes(key.device) && typeof key.provider === 'string' && typeof key.created === 'string' && typeof key.lastUsed === 'string' && typeof key.current === 'boolean') && new Set(saved.map(key => key.id)).size === saved.length) keys = saved;
+} catch { storageAvailable = false; }
+const list = document.querySelector('#passkey-list');
+const dialog = document.querySelector('#key-dialog');
+const form = document.querySelector('#key-form');
+const nameInput = document.querySelector('#key-name');
+let operation = null;
+let selectedId = null;
+let opener = null;
+let toastTimeout;
+
+function icon(name) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+  use.setAttribute('href', `#${name}`);
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text) node.textContent = text;
+  return node;
+}
+function render() {
+  list.replaceChildren();
+  document.querySelector('#key-count').textContent = keys.length;
+  document.querySelector('#tab-count').textContent = keys.length;
+  if (!keys.length) {
+    const empty = element('div', 'empty-state');
+    empty.append(icon('key'), element('h4', '', 'A fresh start for your sign-in.'), element('p', '', service ? 'You have no registered passkeys.' : 'No passkeys saved. Add a sample passkey to try it out.'));
+    list.append(empty);
+  }
+  keys.forEach(key => {
+    const row = element('div', 'passkey-row');
+    const device = element('span', 'device-icon');
+    device.append(icon(key.device === 'phone' ? 'phone' : 'laptop'));
+    const details = element('div', 'key-details');
+    const title = element('div', 'key-title');
+    title.append(element('h4', '', key.name));
+    if (key.current) title.append(element('span', 'current-device', 'This device'));
+    const meta = element('div', 'key-meta');
+    meta.append(element('span', '', `Added ${key.created}`), element('b', '', '·'), element('span', '', `Last used ${key.lastUsed === 'Today' ? 'today' : key.lastUsed}`));
+    details.append(title, element('p', 'provider', key.provider), meta);
+    const actions = element('div', 'row-actions');
+    [['edit', 'Rename', 'rename'], ['trash', 'Delete', 'delete']].forEach(([symbol, label, action]) => {
+      const button = element('button', `icon-button ${action}`);
+      button.type = 'button';
+      button.setAttribute('aria-label', `${label} ${key.name}`);
+      button.title = label;
+      button.append(icon(symbol));
+      button.addEventListener('click', () => openDialog(action, key, button));
+      actions.append(button);
+    });
+    row.append(device, details, actions);
+    list.append(row);
+  });
+}
+function notify(message) {
+  const toast = document.querySelector('#toast');
+  clearTimeout(toastTimeout);
+  toast.querySelector('span').textContent = message;
+  toast.hidden = false;
+  toastTimeout = setTimeout(() => { toast.hidden = true; }, 7000);
+}
+function persist(next) {
+  try { localStorage.setItem(storageKey, JSON.stringify(next)); }
+  catch { throw new Error('Your browser could not save this change. Allow site storage and try again.'); }
+  keys = next;
+  render();
+}
+function openDialog(action, key, trigger) {
+  if (busy) return;
+  operation = action;
+  selectedId = key?.id;
+  opener = trigger;
+  form.reset();
+  document.querySelector('#form-error').textContent = '';
+  const deleting = action === 'delete';
+  const adding = action === 'add';
+  document.querySelector('#dialog-title').textContent = deleting ? 'Remove this passkey?' : adding ? 'Add a sample passkey' : 'Give it a familiar name.';
+  document.querySelector('#dialog-description').textContent = deleting ? (service ? `“${key.name}” will no longer be able to sign in to your account.` : `Remove “${key.name}” from this demo account? This won’t change any real credentials on your device.`) : adding ? 'Try the experience with a sample device. No real passkey will be created.' : 'A little label to help you recognize your device. This won’t rename it in your password manager.';
+  document.querySelector('#name-field').hidden = deleting;
+  nameInput.disabled = deleting;
+  nameInput.value = key?.name || '';
+  const warning = document.querySelector('#dialog-warning');
+  warning.hidden = !deleting;
+  warning.textContent = service ? (keys.length === 1 ? 'This is your last passkey. Before removing it, make sure you can sign in with your password or another recovery method.' : 'Your browser’s authenticator will be notified where supported. You may also need to delete the passkey from your password manager.') : keys.length === 1 ? 'This is your last sample passkey. Removing it will leave the list empty. In a connected account, make sure you have another way to sign in.' : 'You can continue exploring with your other sample passkey. Deleted sample passkeys cannot be restored.';
+  const confirm = document.querySelector('#confirm-dialog');
+  confirm.textContent = deleting ? 'Remove passkey' : adding ? 'Add sample passkey' : 'Save name';
+  confirm.classList.toggle('danger-button', deleting);
+  dialog.showModal();
+  if (deleting) document.querySelector('#cancel-dialog').focus();
+  else { nameInput.focus(); nameInput.select(); }
+}
+function closeDialog() {
+  dialog.close();
+  if (opener?.isConnected) opener.focus();
+  else document.querySelector('#add-key').focus();
+}
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  const name = nameInput.value.trim();
+  if (operation !== 'delete' && !name) {
+    document.querySelector('#form-error').textContent = 'Please enter a name for this passkey.';
+    nameInput.focus();
+    return;
+  }
+  busy = true;
+  document.querySelector('#confirm-dialog').disabled = true;
+  try {
+    if (operation === 'rename') {
+      if (service) { keys = await service.rename(selectedId, name); render(); }
+      else persist(keys.map(key => key.id === selectedId ? { ...key, name } : key));
+      notify('Passkey name updated. Make yourself at home.');
+    } else if (operation === 'delete') {
+      if (service) {
+        const result = await service.remove(selectedId);
+        keys = result.passkeys;
+        render();
+        notify(result.sync === 'signaled' ? 'Passkey removed. Your browser’s authenticator was notified.' : 'Passkey removed. Please also remove it from your device’s password manager.');
+      } else {
+        persist(keys.filter(key => key.id !== selectedId));
+        notify('Sample passkey removed. No real credentials were changed.');
+      }
+    } else {
+      const created = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date());
+      persist([...keys, { id: `demo-${crypto.randomUUID()}`, name, device: 'laptop', provider: 'Sample device · Demo only', created, lastUsed: 'Never', current: false, demo: true }]);
+      notify('Sample passkey added. You’re all set to explore.');
+    }
+    closeDialog();
+  } catch (error) { document.querySelector('#form-error').textContent = error.message; }
+  finally { busy = false; document.querySelector('#confirm-dialog').disabled = false; }
+});
+document.querySelector('#add-key').addEventListener('click', event => openDialog('add', null, event.currentTarget));
+document.querySelector('#cancel-dialog').addEventListener('click', closeDialog);
+dialog.querySelector('.close-button').addEventListener('click', closeDialog);
+dialog.addEventListener('cancel', event => { event.preventDefault(); closeDialog(); });
+const infoDialog = document.querySelector('#info-dialog');
+document.querySelector('#learn-more').addEventListener('click', () => infoDialog.showModal());
+infoDialog.querySelector('.close-button').addEventListener('click', () => infoDialog.close());
+document.querySelector('#info-done').addEventListener('click', () => infoDialog.close());
+document.querySelector('#toast button').addEventListener('click', () => { document.querySelector('#toast').hidden = true; });
+const tabs = [...document.querySelectorAll('[role="tab"]')];
+function activateTab(tab) {
+  tabs.forEach(item => {
+    const active = item === tab;
+    item.setAttribute('aria-selected', String(active));
+    item.tabIndex = active ? 0 : -1;
+    document.getElementById(item.getAttribute('aria-controls')).hidden = !active;
+  });
+}
+tabs.forEach((tab, index) => {
+  tab.addEventListener('click', () => activateTab(tab));
+  tab.addEventListener('keydown', event => {
+    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+    event.preventDefault();
+    const next = event.key === 'Home' ? tabs[0] : event.key === 'End' ? tabs.at(-1) : tabs[(index + 1) % tabs.length];
+    activateTab(next);
+    next.focus();
+  });
+});
+document.querySelector('#back-passkeys').addEventListener('click', () => { activateTab(tabs[1]); tabs[1].focus(); });
+window.addEventListener('storage', event => {
+  if (event.key === storageKey) location.reload();
+});
+if (apiBase) {
+  keys = [];
+  document.querySelector('#add-key').hidden = true;
+  document.querySelector('.demo-note').hidden = true;
+  infoDialog.querySelector('.dialog-warning').hidden = true;
+  list.textContent = 'Loading your passkeys…';
+  try {
+    service = createPasskeyService(apiBase, document.querySelector('meta[name="csrf-token"]')?.content);
+    keys = await service.list();
+    render();
+  } catch (error) {
+    list.replaceChildren(element('p', 'empty-state', error.message));
+    document.querySelector('#key-count').textContent = '—';
+    document.querySelector('#tab-count').textContent = '—';
+  }
+} else render();
+if (!apiBase && !storageAvailable) notify('Saved passkeys could not be loaded. Showing sample devices.');
