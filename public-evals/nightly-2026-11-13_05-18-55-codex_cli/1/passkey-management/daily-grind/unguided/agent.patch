diff --git a/passkey-service.js b/passkey-service.js
new file mode 100644
index 0000000..aa80713
--- /dev/null
+++ b/passkey-service.js
@@ -0,0 +1,40 @@
+/** Server integration for authenticated accounts. No demo records enter this path. */
+export function createPasskeyService(baseUrl, csrfToken = '') {
+  const base = new URL(baseUrl, location.origin);
+  if (base.origin !== location.origin) throw new Error('The passkey API must use this site’s origin.');
+  let account;
+  async function request(path = '', method = 'GET', body) {
+    const response = await fetch(base.href.replace(/\/$/, '') + path, {
+      method,
+      credentials: 'same-origin',
+      headers: { Accept: 'application/json', ...(body ? { 'Content-Type': 'application/json' } : {}), ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}) },
+      ...(body ? { body: JSON.stringify(body) } : {})
+    });
+    if (!response.ok) throw new Error(response.status === 401 ? 'Your session has expired. Sign in again to manage your passkeys.' : 'We couldn’t save this change. Please try again.');
+    const snapshot = await response.json();
+    if (!snapshot || typeof snapshot.userId !== 'string' || typeof snapshot.rpId !== 'string' || !Array.isArray(snapshot.passkeys) || !snapshot.passkeys.every(key => typeof key.id === 'string' && typeof key.name === 'string' && !key.demo)) {
+      throw new Error('Your passkeys could not be loaded. Please try again.');
+    }
+    account = snapshot;
+    return snapshot.passkeys;
+  }
+  return {
+    list: () => request(),
+    rename: (id, name) => request(`/${encodeURIComponent(id)}`, 'PATCH', { name }),
+    async remove(id) {
+      // Only signal after the server confirms removal and returns the complete,
+      // authoritative credential list. Never roll back deletion after sync fails.
+      const passkeys = await request(`/${encodeURIComponent(id)}`, 'DELETE');
+      const sync = await syncAuthenticator(account);
+      return { passkeys, sync };
+    }
+  };
+}
+
+export async function syncAuthenticator({ rpId, userId, passkeys }, credentialApi = globalThis.PublicKeyCredential) {
+  if (!credentialApi || typeof credentialApi.signalAllAcceptedCredentials !== 'function') return 'unsupported';
+  try {
+    await credentialApi.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: passkeys.map(key => key.id) });
+    return 'signaled';
+  } catch { return 'failed'; }
+}
