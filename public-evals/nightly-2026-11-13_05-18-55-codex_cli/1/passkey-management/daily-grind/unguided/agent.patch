diff --git a/tests/passkey-service.test.mjs b/tests/passkey-service.test.mjs
new file mode 100644
index 0000000..a22fb55
--- /dev/null
+++ b/tests/passkey-service.test.mjs
@@ -0,0 +1,55 @@
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+const source = await readFile(new URL('../passkey-service.js', import.meta.url), 'utf8');
+const { createPasskeyService, syncAuthenticator } = await import(`data:text/javascript;base64,${Buffer.from(source).toString('base64')}`);
+const snapshot = { rpId: 'coffee.example.com', userId: 'dXNlcg', passkeys: [{ id: 'a2V5', name: 'Laptop' }] };
+globalThis.location = { origin: 'https://coffee.example.com' };
+
+test('deletion waits for the server then signals its authoritative list', async () => {
+  const calls = [];
+  globalThis.fetch = async (url, options) => {
+    calls.push(['delete', url, options]);
+    return { ok: true, json: async () => snapshot };
+  };
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async options => calls.push(['signal', options]) };
+  const result = await createPasskeyService('/api/account/passkeys', 'csrf').remove('old/key');
+  assert.equal(calls[0][1], 'https://coffee.example.com/api/account/passkeys/old%2Fkey');
+  assert.equal(calls[0][2].method, 'DELETE');
+  assert.equal(calls[0][2].credentials, 'same-origin');
+  assert.equal(calls[0][2].headers['X-CSRF-Token'], 'csrf');
+  assert.deepEqual(calls[1], ['signal', { rpId: snapshot.rpId, userId: snapshot.userId, allAcceptedCredentialIds: ['a2V5'] }]);
+  assert.deepEqual(result, { passkeys: snapshot.passkeys, sync: 'signaled' });
+});
+test('failed revocation never signals a credential removal', async () => {
+  let signaled = false;
+  globalThis.fetch = async () => ({ ok: false, status: 401 });
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async () => { signaled = true; } };
+  await assert.rejects(createPasskeyService('/api/account/passkeys').remove('key'), /session has expired/);
+  assert.equal(signaled, false);
+});
+test('unsupported browsers and rejected signals return actionable states', async () => {
+  assert.equal(await syncAuthenticator(snapshot, {}), 'unsupported');
+  assert.equal(await syncAuthenticator(snapshot, { signalAllAcceptedCredentials: async () => { throw new Error('Unavailable'); } }), 'failed');
+});
+test('signal failure does not undo a confirmed server deletion', async () => {
+  globalThis.fetch = async () => ({ ok: true, json: async () => ({ ...snapshot, passkeys: [] }) });
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async () => { throw new Error('Unavailable'); } };
+  assert.deepEqual(await createPasskeyService('/api/account/passkeys').remove('key'), { passkeys: [], sync: 'failed' });
+});
+test('rename updates only the site label and does not signal authenticators', async () => {
+  let signaled = false;
+  globalThis.PublicKeyCredential = { signalAllAcceptedCredentials: async () => { signaled = true; } };
+  globalThis.fetch = async (_url, options) => {
+    assert.equal(options.method, 'PATCH');
+    assert.deepEqual(JSON.parse(options.body), { name: 'My laptop' });
+    return { ok: true, json: async () => snapshot };
+  };
+  await createPasskeyService('/api/account/passkeys').rename('key', 'My laptop');
+  assert.equal(signaled, false);
+});
+test('integration rejects cross-origin endpoints and demo snapshots', async () => {
+  assert.throws(() => createPasskeyService('https://other.example.com/keys'), /same site|site’s origin/);
+  globalThis.fetch = async () => ({ ok: true, json: async () => ({ ...snapshot, passkeys: [{ id: 'demo', name: 'Laptop', demo: true }] }) });
+  await assert.rejects(createPasskeyService('/api/account/passkeys').list(), /could not be loaded/);
+});
