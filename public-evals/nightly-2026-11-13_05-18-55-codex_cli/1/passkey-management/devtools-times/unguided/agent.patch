@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { AccountError, body, json, relyingParty, requireSameOrigin, route } from '../../../lib/server/account';
+import { passkeyStore } from '../../../lib/server/passkey-store';
+
+export const POST: APIRoute = context => route(async () => {
+  requireSameOrigin(context.request);
+  const data = await body(context.request);
+  const { origin, rpId } = relyingParty(context.request);
+  if (data.action === 'options') {
+    const options = await generateAuthenticationOptions({ rpID: rpId, userVerification: 'required' });
+    await context.session!.set('authenticationChallenge', options.challenge, { ttl: 300 });
+    return json(options);
+  }
+  const challenge = await context.session!.get('authenticationChallenge');
+  await context.session!.delete('authenticationChallenge');
+  const credential = data.credential;
+  const key = typeof credential?.id === 'string' ? passkeyStore().find(credential.id) : undefined;
+  if (!challenge || !key || key.rpId !== rpId) throw new AccountError(401, 'Unable to sign in with this passkey. Try another passkey or your password.');
+  const reader = passkeyStore().reader(key.readerId)!;
+  if (credential.response?.userHandle !== reader.userHandle) throw new AccountError(401, 'Unable to sign in with this passkey.');
+  let result;
+  try {
+    result = await verifyAuthenticationResponse({ response: credential, expectedChallenge: challenge,
+      expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: true,
+      credential: { id: key.id, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')), counter: key.counter, transports: key.transports } });
+  } catch { throw new AccountError(401, 'Unable to verify this passkey. Please try again.'); }
+  if (!result.verified || !passkeyStore().use(key.id, key.counter, result.authenticationInfo.newCounter)) {
+    throw new AccountError(401, 'Unable to sign in with this passkey. Please try again.');
+  }
+  await context.session!.regenerate();
+  await context.session!.set('readerId', reader.id, { ttl: 60 * 60 * 24 });
+  return json({ success: true });
+});
diff --git a/src/pages/api/account/passkeys.ts b/src/pages/api/account/passkeys.ts
new file mode 100644
index 0000000..053c781
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { AccountError, body, displayName, json, relyingParty, requireReader, requireSameOrigin, route, snapshot } from '../../../lib/server/account';
+import { passkeyStore } from '../../../lib/server/passkey-store';
+
+export const GET: APIRoute = context => route(async () => {
+  const reader = await requireReader(context);
+  return json(snapshot(reader, relyingParty(context.request).rpId));
+});
+const mutate: APIRoute = context => route(async () => {
+  requireSameOrigin(context.request);
+  const reader = await requireReader(context);
+  const { id, displayName: name } = await body(context.request);
+  if (typeof id !== 'string' || !id) throw new AccountError(400, 'A passkey is required.');
+  const { rpId } = relyingParty(context.request);
+  const store = passkeyStore();
+  const changed = context.request.method === 'PATCH'
+    ? store.rename(reader.id, rpId, id, displayName(name))
+    : store.remove(reader.id, rpId, id);
+  if (!changed) throw new AccountError(404, 'This passkey was not found. Refresh the list and try again.');
+  return json(snapshot(reader, rpId));
+});
+export const PATCH = mutate;
+export const DELETE = mutate;
