diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..3bdcaf3
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,140 @@
+import { useEffect, useRef, useState } from 'react';
+import { startRegistration } from '@simplewebauthn/browser';
+import { ArrowPathIcon, CheckCircleIcon, ComputerDesktopIcon, KeyIcon, PencilSquareIcon, PlusIcon, ShieldCheckIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { accountRequest, browserSignalAPI, syncAuthenticator, type PasskeySnapshot } from '../lib/passkeys';
+
+type Key = PasskeySnapshot['passkeys'][number];
+const inputClass = 'w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-800';
+const buttonClass = 'rounded-md bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 disabled:cursor-wait disabled:opacity-50';
+const date = (value: string) => new Date(value).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<PasskeySnapshot | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [sync, setSync] = useState<'synced' | 'unsupported' | 'failed' | 'pending'>('pending');
+  const [editing, setEditing] = useState<Key | null>(null);
+  const [removing, setRemoving] = useState<Key | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [name, setName] = useState('');
+  const returnFocus = useRef<HTMLButtonElement | null>(null);
+  const editor = useRef<HTMLInputElement | null>(null);
+  const heading = useRef<HTMLHeadingElement | null>(null);
+  const cancelRemove = useRef<HTMLButtonElement | null>(null);
+
+  async function synchronize(snapshot: PasskeySnapshot) {
+    setSync('pending');
+    setSync(await syncAuthenticator(snapshot, browserSignalAPI()));
+  }
+  async function load() {
+    setLoading(true); setError('');
+    try {
+      const snapshot = await accountRequest('passkeys');
+      setData(snapshot);
+      await synchronize(snapshot);
+    } catch (err) { setError((err as Error).message); setData(null); }
+    finally { setLoading(false); }
+  }
+  useEffect(() => { void load(); }, []);
+  useEffect(() => {
+    if (editing || adding) editor.current?.focus();
+    if (removing) cancelRemove.current?.focus();
+  }, [editing, adding, removing]);
+
+  function close() {
+    setEditing(null); setRemoving(null); setAdding(false); setName('');
+    requestAnimationFrame(() => {
+      if (returnFocus.current?.isConnected) returnFocus.current.focus();
+      heading.current?.focus();
+    });
+  }
+  function begin(event: React.MouseEvent<HTMLButtonElement>, key?: Key, remove = false) {
+    returnFocus.current = event.currentTarget;
+    setError(''); setNotice(''); setEditing(null); setRemoving(null); setAdding(false);
+    if (!key) { setAdding(true); setName(''); }
+    else if (remove) setRemoving(key);
+    else { setEditing(key); setName(key.displayName); }
+  }
+  async function save(event: React.FormEvent) {
+    event.preventDefault();
+    if (busy || !name.trim()) return;
+    setBusy(true); setError(''); setNotice('');
+    try {
+      let snapshot: PasskeySnapshot;
+      if (adding) {
+        const optionsJSON = await accountRequest('register-passkey', { action: 'options', displayName: name.trim() });
+        const credential = await startRegistration({ optionsJSON });
+        snapshot = await accountRequest('register-passkey', { action: 'verify', credential });
+      } else {
+        snapshot = await accountRequest('passkeys', { id: editing!.id, displayName: name.trim() }, 'PATCH');
+      }
+      setData(snapshot); setNotice(adding ? 'Your new passkey is ready to use.' : 'Passkey name updated.'); close();
+      await synchronize(snapshot);
+    } catch (err) {
+      setError((err as Error).name === 'NotAllowedError' ? 'Passkey setup was canceled or timed out. You can try again.' : (err as Error).message);
+    } finally { setBusy(false); }
+  }
+  async function remove() {
+    if (!removing || busy) return;
+    setBusy(true); setError(''); setNotice('');
+    try {
+      const snapshot = await accountRequest('passkeys', { id: removing.id }, 'DELETE');
+      setData(snapshot); setNotice('Passkey removed. It can no longer sign in to your account.'); close();
+      await synchronize(snapshot);
+    } catch (err) { setError((err as Error).message); }
+    finally { setBusy(false); }
+  }
+
+  return <section aria-labelledby="passkeys-heading">
+    <div className="mb-7 flex items-start gap-4">
+      <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gray-100"><KeyIcon className="h-6 w-6" /></div>
+      <div><h2 ref={heading} tabIndex={-1} id="passkeys-heading" className="text-2xl font-semibold tracking-tight">Passkeys</h2>
+        <p className="mt-2 max-w-xl text-sm leading-6 text-gray-600">A simpler, safer way to sign in. Use your fingerprint, face, or device screen lock—no password to remember.</p></div>
+    </div>
+
+    {error && <div role="alert" className="mb-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">{error}</div>}
+    {notice && <div role="status" className="mb-5 flex items-start gap-2 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-900"><CheckCircleIcon className="h-5 w-5 shrink-0" />{notice}</div>}
+
+    {loading ? <p role="status" className="py-10 text-sm text-gray-500">Loading your passkeys…</p> : !data ?
+      <div className="rounded-lg border border-gray-200 p-6"><p className="text-sm text-gray-600">Your passkeys couldn’t be loaded.</p><button onClick={load} className={`${buttonClass} mt-4`}>Try again</button><a className="ml-4 text-sm underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in</a></div> : <>
+      <div className="overflow-hidden rounded-lg border border-gray-200">
+        <div className="flex items-center justify-between gap-3 border-b border-gray-200 bg-gray-50 px-5 py-4">
+          <h3 className="text-sm font-semibold">Your registered passkeys <span className="ml-1 rounded bg-gray-200 px-1.5 py-0.5 text-xs text-gray-600">{data.passkeys.length}</span></h3>
+          <button type="button" onClick={load} disabled={busy || !!editing || !!removing || adding} aria-label="Refresh passkeys" className="rounded p-1 text-gray-500 hover:text-gray-900 disabled:opacity-40"><ArrowPathIcon className="h-4 w-4" /></button>
+        </div>
+        {data.passkeys.length === 0 ? <div className="px-6 py-10 text-center"><KeyIcon className="mx-auto mb-3 h-8 w-8 text-gray-400" /><p className="font-semibold">No passkeys yet</p><p className="mt-2 text-sm text-gray-500">Add a passkey to make your next sign-in a little easier.</p></div> :
+          <ul className="divide-y divide-gray-200">{data.passkeys.map(key => <li key={key.id} className="px-5 py-5">
+            <div className="flex flex-wrap items-start gap-3">
+              <ComputerDesktopIcon className="mt-0.5 h-5 w-5 shrink-0 text-gray-500" />
+              <div className="min-w-0 flex-1"><p className="break-words text-sm font-semibold">{key.displayName}</p><p className="mt-1 text-xs leading-5 text-gray-500">Added {date(key.createdAt)}<span className="mx-2">·</span>{key.lastUsedAt ? `Last used ${date(key.lastUsedAt)}` : 'Not used yet'}</p></div>
+              <div className="flex gap-3"><button disabled={busy || !!editing || !!removing || adding} onClick={e => begin(e, key)} aria-label={`Rename ${key.displayName}`} className="rounded p-1 text-gray-500 hover:text-gray-900 disabled:opacity-30"><PencilSquareIcon className="h-5 w-5" /></button>
+                <button disabled={busy || !!editing || !!removing || adding} onClick={e => begin(e, key, true)} aria-label={`Remove ${key.displayName}`} className="rounded p-1 text-gray-500 hover:text-red-700 disabled:opacity-30"><TrashIcon className="h-5 w-5" /></button></div>
+            </div>
+            {editing?.id === key.id && renderEditor()}
+            {removing?.id === key.id && <div className="mt-4 rounded-md border border-red-200 bg-red-50 p-4" role="group" aria-label={`Confirm removal of ${key.displayName}`}>
+              <p className="text-sm font-semibold">Remove this passkey?</p><p className="mt-1 text-sm leading-6 text-gray-600">You won’t be able to use “{key.displayName}” to sign in again. {data.passkeys.length === 1 ? 'This is your last passkey. You can still sign in with your username and password.' : 'Your other passkeys will still work.'}</p>
+              <div className="mt-4 flex gap-3"><button ref={cancelRemove} disabled={busy} onClick={close} className="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold">Keep passkey</button><button disabled={busy} onClick={remove} className="rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">{busy ? 'Removing…' : 'Remove passkey'}</button></div>
+            </div>}
+          </li>)}</ul>}
+      </div>
+      {adding ? renderEditor() : <button onClick={e => begin(e)} disabled={busy || !!editing || !!removing} className={`${buttonClass} mt-5 inline-flex items-center gap-2`}><PlusIcon className="h-4 w-4" />Add a passkey</button>}
+
+      <div className="mt-7 border-t border-gray-200 pt-5 text-xs leading-5 text-gray-500" aria-live="polite">
+        <p>{sync === 'pending' ? 'Updating your browser’s saved passkeys…' : sync === 'synced' ? 'Your browser has been notified of your current passkeys.' : sync === 'unsupported' ? 'This browser can’t update saved passkeys automatically. After removing a passkey here, you can also remove it from your device’s password manager.' : 'Your account is up to date, but your browser couldn’t update its saved passkeys. Retry or remove unused keys from your device’s password manager.'}</p>
+        {sync === 'failed' && <button disabled={busy} className="mt-2 font-semibold text-gray-900 underline" onClick={async () => { setBusy(true); try { await load(); } finally { setBusy(false); } }}>Retry browser sync</button>}
+      </div>
+    </>}
+    <aside className="mt-8 flex gap-3 rounded-lg bg-gray-50 p-5"><ShieldCheckIcon className="mt-0.5 h-5 w-5 shrink-0 text-gray-500" /><div><h3 className="text-sm font-semibold">Made for your peace of mind</h3><p className="mt-1 text-sm leading-6 text-gray-600">Your fingerprint and face data stay on your device. The DevTools Times never sees or stores them.</p></div></aside>
+  </section>;
+
+  function renderEditor() {
+    return <form onSubmit={save} className="mt-4 rounded-md border border-gray-200 bg-gray-50 p-4" onKeyDown={e => { if (e.key === 'Escape' && !busy) close(); }}>
+      <label htmlFor="passkey-name" className="mb-2 block text-sm font-semibold">{adding ? 'Name your new passkey' : 'Passkey display name'}</label>
+      <input ref={editor} id="passkey-name" value={name} onChange={e => setName(e.target.value)} maxLength={64} required disabled={busy} placeholder="e.g. Personal laptop" className={inputClass} />
+      <p className="mt-2 text-xs leading-5 text-gray-500">Choose a name to recognize this key. This label is only used on The DevTools Times.</p>
+      <div className="mt-4 flex gap-3"><button type="submit" disabled={busy || !name.trim()} className={buttonClass}>{busy ? 'Saving…' : adding ? 'Create passkey' : 'Save name'}</button><button type="button" disabled={busy} onClick={close} className="px-3 py-2 text-sm font-semibold">Cancel</button></div>
+    </form>;
+  }
+}
