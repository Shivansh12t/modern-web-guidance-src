diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..d990cca
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,38 @@
+export interface PasskeySnapshot {
+  user: { username: string; userId: string };
+  rpId: string;
+  passkeys: { id: string; displayName: string; createdAt: string; lastUsedAt: string | null }[];
+}
+
+export async function accountRequest(path: string, data?: unknown, method = 'POST') {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/account/${path}`, {
+    method: data === undefined ? 'GET' : method,
+    credentials: 'same-origin', cache: 'no-store',
+    headers: data === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: data === undefined ? undefined : JSON.stringify(data),
+  });
+  const result = await response.json();
+  if (!response.ok) throw new Error(result.error || 'Unable to complete this request. Please try again.');
+  return result;
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+export async function syncAuthenticator(snapshot: PasskeySnapshot, api: SignalAPI | undefined): Promise<'synced' | 'unsupported' | 'failed'> {
+  if (!api?.signalAllAcceptedCredentials) return 'unsupported';
+  try {
+    // Always send the complete authoritative list, including an empty list after removing the last key.
+    await api.signalAllAcceptedCredentials({ rpId: snapshot.rpId, userId: snapshot.user.userId,
+      allAcceptedCredentialIds: snapshot.passkeys.map(key => key.id) });
+    if (api.signalCurrentUserDetails) {
+      // This is the account name, not an individual passkey's local nickname.
+      await api.signalCurrentUserDetails({ rpId: snapshot.rpId, userId: snapshot.user.userId,
+        name: snapshot.user.username, displayName: snapshot.user.username });
+    }
+    return 'synced';
+  } catch { return 'failed'; }
+}
+export const browserSignalAPI = (): SignalAPI | undefined =>
+  typeof PublicKeyCredential === 'undefined' ? undefined : PublicKeyCredential as unknown as SignalAPI;
diff --git a/src/lib/server/account.ts b/src/lib/server/account.ts
new file mode 100644
index 0000000..d09fd34
--- /dev/null
+++ b/src/lib/server/account.ts
@@ -0,0 +1,56 @@
+import type { APIContext } from 'astro';
+import { passkeyStore } from './passkey-store';
+
+export class AccountError extends Error {
+  constructor(public status: number, message: string) { super(message); }
+}
+export const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+export function relyingParty(request: Request) {
+  // Pin this to the public URL in production (also when behind a reverse proxy).
+  const origin = new URL(process.env.WEBAUTHN_ORIGIN || request.url).origin;
+  return { origin, rpId: new URL(origin).hostname };
+}
+export function requireSameOrigin(request: Request) {
+  if (request.headers.get('Origin') !== relyingParty(request).origin) {
+    throw new AccountError(403, 'This request must come from this website.');
+  }
+}
+export async function requireReader(context: Pick<APIContext, 'session'>) {
+  const id = await context.session?.get('readerId');
+  const reader = typeof id === 'string' ? passkeyStore().reader(id) : undefined;
+  if (!reader) throw new AccountError(401, 'Please sign in to manage your passkeys.');
+  return reader;
+}
+export async function body(request: Request) {
+  if (!request.headers.get('Content-Type')?.startsWith('application/json')) {
+    throw new AccountError(415, 'Expected JSON.');
+  }
+  try {
+    const data = await request.json();
+    if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error();
+    return data;
+  } catch { throw new AccountError(400, 'Invalid request.'); }
+}
+export function displayName(value: unknown): string {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > 64) {
+    throw new AccountError(400, 'Use a name between 1 and 64 characters.');
+  }
+  return value.trim();
+}
+export function snapshot(reader: { id: string; username: string; userHandle: string }, rpId: string) {
+  const keys = passkeyStore().list(reader.id, rpId);
+  return {
+    user: { username: reader.username, userId: reader.userHandle }, rpId,
+    passkeys: keys.map(({ id, displayName, createdAt, lastUsedAt }) => ({ id, displayName, createdAt, lastUsedAt })),
+  };
+}
+export async function route(action: () => Promise<Response>) {
+  try { return await action(); }
+  catch (error) {
+    if (error instanceof AccountError) return json({ error: error.message }, error.status);
+    console.error('Account request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'Unable to complete this request. Please try again.' }, 500);
+  }
+}
diff --git a/src/lib/server/passkey-store.ts b/src/lib/server/passkey-store.ts
new file mode 100644
index 0000000..43f2fcf
--- /dev/null
+++ b/src/lib/server/passkey-store.ts
@@ -0,0 +1,66 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface Reader { id: string; username: string; userHandle: string }
+export interface StoredPasskey {
+  id: string; readerId: string; rpId: string; displayName: string;
+  publicKey: string; counter: number; transports: string[];
+  createdAt: string; lastUsedAt: string | null;
+}
+
+// Open lazily: building/importing modules must not create a database.
+export function createPasskeyStore(filename: string) {
+  if (filename !== ':memory:') mkdirSync(dirname(filename), { recursive: true, mode: 0o700 });
+  const db = new DatabaseSync(filename);
+  db.exec(`PRAGMA journal_mode = WAL; PRAGMA foreign_keys = ON; PRAGMA busy_timeout = 5000;
+    CREATE TABLE IF NOT EXISTS readers (
+      id TEXT PRIMARY KEY, username TEXT NOT NULL, userHandle TEXT NOT NULL UNIQUE
+    );
+    CREATE TABLE IF NOT EXISTS passkeys (
+      id TEXT PRIMARY KEY, readerId TEXT NOT NULL REFERENCES readers(id), rpId TEXT NOT NULL,
+      displayName TEXT NOT NULL, publicKey TEXT NOT NULL, counter INTEGER NOT NULL,
+      transports TEXT NOT NULL, createdAt TEXT NOT NULL, lastUsedAt TEXT
+    );`);
+  const decode = (row: any): StoredPasskey | undefined => row && ({ ...row, transports: JSON.parse(row.transports) });
+  return {
+    reader(id: string): Reader | undefined {
+      return db.prepare('SELECT * FROM readers WHERE id = ?').get(id) as Reader | undefined;
+    },
+    ensureReader(id: string, username: string): Reader {
+      db.prepare('INSERT INTO readers VALUES (?, ?, ?) ON CONFLICT(id) DO UPDATE SET username = excluded.username')
+        .run(id, username, randomBytes(32).toString('base64url'));
+      return this.reader(id)!;
+    },
+    list(readerId: string, rpId: string): StoredPasskey[] {
+      return db.prepare('SELECT * FROM passkeys WHERE readerId = ? AND rpId = ? ORDER BY createdAt DESC')
+        .all(readerId, rpId).map(row => decode(row)!);
+    },
+    find(id: string): StoredPasskey | undefined {
+      return decode(db.prepare('SELECT * FROM passkeys WHERE id = ?').get(id));
+    },
+    add(key: StoredPasskey) {
+      db.prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)')
+        .run(key.id, key.readerId, key.rpId, key.displayName, key.publicKey, key.counter,
+          JSON.stringify(key.transports), key.createdAt, key.lastUsedAt);
+    },
+    rename(readerId: string, rpId: string, id: string, name: string): boolean {
+      return db.prepare('UPDATE passkeys SET displayName = ? WHERE readerId = ? AND rpId = ? AND id = ?')
+        .run(name, readerId, rpId, id).changes === 1;
+    },
+    remove(readerId: string, rpId: string, id: string): boolean {
+      return db.prepare('DELETE FROM passkeys WHERE readerId = ? AND rpId = ? AND id = ?')
+        .run(readerId, rpId, id).changes === 1;
+    },
+    use(id: string, oldCounter: number, newCounter: number): boolean {
+      return db.prepare('UPDATE passkeys SET counter = ?, lastUsedAt = ? WHERE id = ? AND counter = ?')
+        .run(newCounter, new Date().toISOString(), id, oldCounter).changes === 1;
+    },
+    close() { db.close(); },
+  };
+}
+let store: ReturnType<typeof createPasskeyStore> | undefined;
+export function passkeyStore() {
+  return store ??= createPasskeyStore(process.env.PASSKEY_DB_PATH || './.data/passkeys.sqlite');
+}
