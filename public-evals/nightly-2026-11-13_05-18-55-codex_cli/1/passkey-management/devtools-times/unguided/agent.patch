+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,25 @@
+import type { APIRoute } from 'astro';
+import { AccountError, body, json, requireSameOrigin, route } from '../../../lib/server/account';
+import { passkeyStore } from '../../../lib/server/passkey-store';
+
+export const POST: APIRoute = context => route(async () => {
+  requireSameOrigin(context.request);
+  const { username, password } = await body(context.request);
+  if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || !password) {
+    throw new AccountError(400, 'Enter your username and password.');
+  }
+  const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username: username.trim(), password }), signal: AbortSignal.timeout(15000),
+  });
+  if (!response.ok) throw new AccountError(response.status === 429 ? 429 : 401, 'Sign-in failed. Check your username and password and try again.');
+  const data = await response.json();
+  if (data.error || typeof data.token !== 'string' || !data.token) throw new AccountError(401, 'Sign-in failed. Please try again.');
+  // Use the upstream immutable subject when available. The demo service's fallback is its unique username.
+  const subject = data.user?.id ?? data.userId ?? data.user?.username ?? data.username ?? username.trim();
+  const name = data.user?.username ?? data.username ?? username.trim();
+  const reader = passkeyStore().ensureReader(String(subject), String(name));
+  await context.session!.regenerate();
+  await context.session!.set('readerId', reader.id, { ttl: 60 * 60 * 24 });
+  return json({ success: true });
+});
