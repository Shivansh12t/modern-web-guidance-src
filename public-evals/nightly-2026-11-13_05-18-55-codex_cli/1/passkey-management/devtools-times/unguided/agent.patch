+import { useState } from 'react';
+import { accountRequest } from '../lib/passkeys';
+export default function SignOutButton() {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  return <div><button disabled={busy} className="text-sm text-gray-500 underline hover:text-gray-900" onClick={async () => {
+    setBusy(true); setError('');
+    try { await accountRequest('logout', {}); window.location.assign(import.meta.env.BASE_URL); }
+    catch { setError('Unable to sign out. Please try again.'); setBusy(false); }
+  }}>{busy ? 'Signing out…' : 'Sign out'}</button>{error && <p role="alert" className="mt-2 text-xs text-red-700">{error}</p>}</div>;
+}
