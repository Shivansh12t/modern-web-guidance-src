@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { AccountError, body, displayName, json, relyingParty, requireReader, requireSameOrigin, route, snapshot } from '../../../lib/server/account';
+import { passkeyStore } from '../../../lib/server/passkey-store';
+
+export const POST: APIRoute = context => route(async () => {
+  requireSameOrigin(context.request);
+  const reader = await requireReader(context);
+  const data = await body(context.request);
+  const { origin, rpId } = relyingParty(context.request);
+  if (data.action === 'options') {
+    const name = displayName(data.displayName);
+    const options = await generateRegistrationOptions({
+      rpName: 'The DevTools Times', rpID: rpId, userName: reader.username,
+      userID: new Uint8Array(Buffer.from(reader.userHandle, 'base64url')), userDisplayName: reader.username,
+      excludeCredentials: passkeyStore().list(reader.id, rpId).map(key => ({ id: key.id, transports: key.transports })),
+      authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+    });
+    await context.session!.set('registration', { challenge: options.challenge, readerId: reader.id, name }, { ttl: 300 });
+    return json(options);
+  }
+  const pending = await context.session!.get('registration');
+  await context.session!.delete('registration');
+  if (!pending || pending.readerId !== reader.id || !data.credential) {
+    throw new AccountError(400, 'Passkey setup expired. Please start again.');
+  }
+  let result;
+  try {
+    result = await verifyRegistrationResponse({ response: data.credential, expectedChallenge: pending.challenge,
+      expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: true });
+  } catch { throw new AccountError(400, 'The passkey could not be verified. Please try again.'); }
+  if (!result.verified) throw new AccountError(400, 'The passkey could not be verified.');
+  const { credential } = result.registrationInfo;
+  passkeyStore().add({ id: credential.id, readerId: reader.id, rpId, displayName: pending.name,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter,
+    transports: credential.transports ?? [], createdAt: new Date().toISOString(), lastUsedAt: null });
+  return json(snapshot(reader, rpId));
+});
diff --git a/tests/passkeys.test.ts b/tests/passkeys.test.ts
new file mode 100644
index 0000000..dd6fae5
--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createPasskeyStore, passkeyStore, type StoredPasskey } from '../src/lib/server/passkey-store';
+import { AccountError, displayName, requireReader, requireSameOrigin, snapshot } from '../src/lib/server/account';
+import { syncAuthenticator, type PasskeySnapshot } from '../src/lib/passkeys';
+
+const key = (id: string, readerId: string, rpId = 'times.example'): StoredPasskey => ({
+  id, readerId, rpId, displayName: 'Laptop', publicKey: 'private-server-metadata', counter: 0,
+  transports: ['internal'], createdAt: '2026-11-13T00:00:00.000Z', lastUsedAt: null,
+});
+
+test('passkey writes enforce reader ownership and RP isolation; deleted keys cannot authenticate', () => {
+  const store = createPasskeyStore(':memory:');
+  try {
+    store.ensureReader('alice', 'Alice'); store.ensureReader('bob', 'Bob');
+    store.add(key('alice-key', 'alice')); store.add(key('bob-key', 'bob'));
+    store.add(key('other-rp', 'alice', 'other.example'));
+    assert.equal(store.rename('bob', 'times.example', 'alice-key', 'Stolen'), false);
+    assert.equal(store.remove('bob', 'times.example', 'alice-key'), false);
+    assert.equal(store.remove('alice', 'other.example', 'alice-key'), false);
+    assert.deepEqual(store.list('alice', 'times.example').map(k => k.id), ['alice-key']);
+    assert.equal(store.rename('alice', 'times.example', 'alice-key', 'Work laptop'), true);
+    assert.equal(store.find('alice-key')?.displayName, 'Work laptop');
+    assert.equal(store.use('alice-key', 0, 1), true);
+    assert.equal(store.use('alice-key', 0, 2), false);
+    assert.ok(store.find('alice-key')?.lastUsedAt);
+    assert.equal(store.remove('alice', 'times.example', 'alice-key'), true);
+    assert.equal(store.find('alice-key'), undefined);
+    assert.equal(store.use('alice-key', 1, 2), false);
+    assert.equal(store.find('bob-key')?.readerId, 'bob');
+  } finally { store.close(); }
+});
+
+test('credentials and the stable WebAuthn user handle persist when storage reopens', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'times-passkey-'));
+  const filename = join(dir, 'passkeys.sqlite');
+  try {
+    let store = createPasskeyStore(filename);
+    const reader = store.ensureReader('alice', 'Alice');
+    assert.equal(Buffer.from(reader.userHandle, 'base64url').length, 32);
+    store.add(key('key', 'alice')); store.close();
+    store = createPasskeyStore(filename);
+    assert.equal(store.ensureReader('alice', 'New account name').userHandle, reader.userHandle);
+    assert.equal(store.find('key')?.displayName, 'Laptop');
+    store.close();
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('names are trimmed and blank or oversized values are rejected', () => {
+  assert.equal(displayName('  Work laptop  '), 'Work laptop');
+  for (const name of ['', '  ', 'a'.repeat(65), null, {}, 12]) {
+    assert.throws(() => displayName(name), error => error instanceof AccountError && error.status === 400);
+  }
+});
+
+test('account mutations reject cross-origin and missing-Origin requests', () => {
+  const old = process.env.WEBAUTHN_ORIGIN;
+  process.env.WEBAUTHN_ORIGIN = 'https://times.example';
+  try {
+    assert.doesNotThrow(() => requireSameOrigin(new Request('http://internal/api', { headers: { Origin: 'https://times.example' } })));
+    for (const headers of [new Headers(), new Headers({ Origin: 'https://evil.example' })]) {
+      assert.throws(() => requireSameOrigin(new Request('https://times.example/api', { headers })), error => error instanceof AccountError && error.status === 403);
+    }
+  } finally {
+    if (old === undefined) delete process.env.WEBAUTHN_ORIGIN; else process.env.WEBAUTHN_ORIGIN = old;
+  }
+});
+
+test('signed-out access is rejected and snapshots omit credential verification material', async () => {
+  await assert.rejects(requireReader({ session: undefined } as any), error => error instanceof AccountError && error.status === 401);
+  process.env.PASSKEY_DB_PATH = ':memory:';
+  const store = passkeyStore();
+  const reader = store.ensureReader('reader', 'Reader');
+  store.add(key('credential', 'reader'));
+  const result = snapshot(reader, 'times.example');
+  assert.equal(result.user.userId, reader.userHandle);
+  assert.equal('publicKey' in result.passkeys[0], false);
+  assert.equal('readerId' in result.passkeys[0], false);
+  assert.deepEqual(result.passkeys.map(k => k.id), ['credential']);
+});
+
+const state: PasskeySnapshot = {
+  rpId: 'times.example', user: { username: 'Reader', userId: 'dXNlcg' },
+  passkeys: [{ id: 'a2V5', displayName: 'My laptop', createdAt: '2026-11-13', lastUsedAt: null }],
+};
+test('browser sync sends the complete list and the account name, never the passkey label', async () => {
+  const calls: unknown[] = [];
+  assert.equal(await syncAuthenticator(state, {
+    async signalAllAcceptedCredentials(options) { calls.push(options); },
+    async signalCurrentUserDetails(options) { calls.push(options); },
+  }), 'synced');
+  assert.deepEqual(calls, [
+    { rpId: 'times.example', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5'] },
+    { rpId: 'times.example', userId: 'dXNlcg', name: 'Reader', displayName: 'Reader' },
+  ]);
+});
+test('removing the final key signals an empty accepted list', async () => {
+  let accepted: string[] | undefined;
+  await syncAuthenticator({ ...state, passkeys: [] }, {
