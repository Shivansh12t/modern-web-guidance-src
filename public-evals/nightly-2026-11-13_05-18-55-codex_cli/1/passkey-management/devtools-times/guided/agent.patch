diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..4bdfa98
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,138 @@
+import { useEffect, useRef, useState } from 'react';
+import providers from '../data/passkey-providers.json';
+import { AccountError, accountRequest, passkeyCapabilities, passkeyError, signalUnknown,
+  syncAcceptedCredentials, syncUserDetails, type AccountSnapshot, type CredentialSummary } from '../lib/passkey-client';
+
+const button = 'rounded border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50 disabled:cursor-wait';
+const input = 'w-full rounded border border-gray-400 px-3 py-2 focus-visible:outline-2 focus-visible:outline-gray-900';
+const providerMap = providers as Record<string, { name: string; icon_light: string }>;
+function providerFor(key: CredentialSummary) {
+  return key.aaguid === '00000000-0000-0000-0000-000000000000' ? undefined : providerMap[key.aaguid.toLowerCase()];
+}
+function date(value?: number) {
+  return value && Number.isFinite(value) ? new Date(value).toLocaleDateString(undefined, { dateStyle: 'medium' }) : 'Never';
+}
+
+export default function AccountSettings() {
+  const [account, setAccount] = useState<AccountSnapshot | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [signedOut, setSignedOut] = useState(false);
+  const [error, setError] = useState('');
+  const [status, setStatus] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [displayName, setDisplayName] = useState('');
+  const [editId, setEditId] = useState<string | null>(null);
+  const [keyName, setKeyName] = useState('');
+  const [removeId, setRemoveId] = useState<string | null>(null);
+  const listHeading = useRef<HTMLHeadingElement>(null);
+
+  function failure(error: unknown) {
+    if (error instanceof AccountError && error.status === 401) { setSignedOut(true); setAccount(null); }
+    setError(passkeyError(error));
+  }
+  async function load() {
+    setLoading(true); setError('');
+    try {
+      const data = await accountRequest<AccountSnapshot>('passkeys');
+      setAccount(data); setDisplayName(data.displayName); setSignedOut(false);
+      void syncAcceptedCredentials(data);
+      void syncUserDetails(data);
+    } catch (error) { failure(error); }
+    finally { setLoading(false); }
+  }
+  useEffect(() => {
+    void load();
+    void passkeyCapabilities().then(capabilities => setCanCreate(Boolean(capabilities?.passkeyPlatformAuthenticator && capabilities?.conditionalGet)));
+  }, []);
+
+  async function mutate(action: string, method: string, body: unknown, message: string, sync?: 'keys' | 'profile') {
+    setBusy(true); setError(''); setStatus('');
+    try {
+      const data = await accountRequest<AccountSnapshot>(action, method, body);
+      setAccount(data); setDisplayName(data.displayName); setEditId(null); setRemoveId(null);
+      const synced = sync === 'keys' ? await syncAcceptedCredentials(data) : sync === 'profile' ? await syncUserDetails(data) : true;
+      setStatus(message + (!synced ? ' Your browser could not sync this update. You can also manage saved passkeys in your password manager.' : ''));
+      if (action.startsWith('passkeys/')) listHeading.current?.focus();
+    } catch (error) { failure(error); }
+    finally { setBusy(false); }
+  }
+  async function createPasskey() {
+    setBusy(true); setError(''); setStatus('');
+    try {
+      const options = await accountRequest<PublicKeyCredentialCreationOptionsJSON>('register/options', 'POST');
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      const credential = await navigator.credentials.create({ publicKey }) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created. Please try again.');
+      let data: AccountSnapshot;
+      try { data = await accountRequest<AccountSnapshot>('register/verify', 'POST', credential.toJSON()); }
+      catch (error) { await signalUnknown(options.rp.id!, credential.id); throw error; }
+      setAccount(data); setStatus('Passkey created. You can now use it to sign in.');
+      await syncAcceptedCredentials(data);
+    } catch (error) { failure(error); }
+    finally { setBusy(false); }
+  }
+
+  return <div className="mx-auto max-w-3xl px-4 py-10 sm:px-8 sm:py-14">
+    <p className="mb-2 text-xs font-bold uppercase tracking-widest text-gray-500">Your reader account</p>
+    <h1 className="font-brand text-4xl text-gray-900 sm:text-5xl">Account settings</h1>
+    <p className="mt-3 text-gray-600">Manage your profile and the ways you sign in to The DevTools Times.</p>
+    <div className="mt-6" role="status" aria-live="polite">{loading ? 'Loading your account…' : status}</div>
+    {error && <p role="alert" className="mt-4 rounded border border-red-200 bg-red-50 p-3 text-red-800">{error}</p>}
+    {signedOut ? <div className="mt-6 border-t border-gray-200 py-6">
+      <h2 className="text-xl font-semibold">Sign in to your account</h2>
+      <p className="my-3 text-gray-600">Your passkeys and profile are only visible when you’re signed in.</p>
+      <a className={button} href={`${import.meta.env.BASE_URL}signin`}>Sign in</a>
+    </div> : !loading && !account ? <button className={`${button} mt-4`} onClick={load}>Try again</button> : null}
+    {account && <>
+      <section aria-labelledby="profile-heading" className="mt-7 border-t border-gray-300 py-7">
+        <h2 id="profile-heading" className="text-xl font-bold">Reader profile</h2>
+        <p className="mt-2 text-sm text-gray-600">Signed in as <strong>{account.name}</strong></p>
+        <form className="mt-5" onSubmit={event => { event.preventDefault(); void mutate('profile', 'PUT', { displayName }, 'Display name updated.', 'profile'); }}>
+          <label htmlFor="reader-display-name" className="mb-2 block text-sm font-semibold">Display name</label>
+          <div className="flex flex-col gap-3 sm:flex-row">
+            <input id="reader-display-name" className={input} value={displayName} onChange={event => setDisplayName(event.target.value)} required maxLength={80} disabled={busy} autoComplete="nickname" />
+            <button className={`${button} shrink-0`} disabled={busy || !displayName.trim() || displayName.trim() === account.displayName}>Save display name</button>
+          </div>
+          <p className="mt-2 text-xs text-gray-500">Updates your account name in supported passkey providers. Your sign-in username stays the same.</p>
+        </form>
+      </section>
+      <section aria-labelledby="passkeys-heading" className="border-t border-gray-300 py-7" aria-busy={busy}>
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div><h2 id="passkeys-heading" ref={listHeading} tabIndex={-1} className="text-xl font-bold">Passkeys <span className="ml-1 text-sm font-normal text-gray-500">({account.credentials.length})</span></h2>
+            <p className="mt-2 max-w-lg text-sm text-gray-600">Use your fingerprint, face, screen lock, or security key to sign in securely.</p></div>
+          {canCreate && <button type="button" className={`${button} border-gray-900 bg-gray-900 text-white hover:bg-gray-700`} disabled={busy} onClick={createPasskey}>Create passkey</button>}
+        </div>
+        {!canCreate && <p className="mt-4 text-sm text-gray-600">You can manage existing passkeys here. To create one, use a browser and device that support passkeys. You can continue signing in with your password.</p>}
+        {account.credentials.length === 0 ? <div className="mt-6 rounded border border-dashed border-gray-300 bg-gray-50 px-5 py-8 text-center">
+          <p className="font-semibold">No passkeys registered</p><p className="mt-2 text-sm text-gray-600">Create a passkey for a faster sign-in, without typing your password.</p>
+        </div> : <ul className="mt-6 divide-y divide-gray-200 rounded border border-gray-200">
+          {account.credentials.map(key => {
+            const provider = providerFor(key);
+            const label = key.name || provider?.name || 'Unknown passkey provider';
+            return <li key={key.id} className="p-4 sm:p-5">
+              <div className="flex items-start gap-3">
+                {provider?.icon_light ? <img src={provider.icon_light} alt="" width={32} height={32} className="mt-1 h-8 w-8 shrink-0 object-contain" /> : <span aria-hidden="true" className="grid h-9 w-9 shrink-0 place-items-center rounded bg-gray-100"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6"><circle cx="8" cy="9" r="4"/><path d="m11 12 9 9m-2-2 2-2m-5-1 2-2"/></svg></span>}
+                <div className="min-w-0 flex-1"><h3 className="break-words font-semibold">{label}</h3>
+                  <p className="mt-1 text-xs text-gray-500">{provider?.name || 'Provider not identified'} · {key.backedUp ? 'Backed up by provider' : 'Not backed up by provider'}</p>
+                  <dl className="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-600"><div><dt className="inline">Created: </dt><dd className="inline">{date(key.registeredAt)}</dd></div><div><dt className="inline">Last used: </dt><dd className="inline">{date(key.lastUsedAt)}</dd></div></dl>
+                </div>
+              </div>
+              {editId === key.id ? <form className="mt-4 space-y-3" onSubmit={event => { event.preventDefault(); void mutate(`passkeys/${encodeURIComponent(key.id)}`, 'PUT', { name: keyName }, 'Passkey name updated.'); }}>
+                <label htmlFor="passkey-name" className="block text-sm font-semibold">Passkey display name</label>
+                <input id="passkey-name" className={input} value={keyName} onChange={event => setKeyName(event.target.value)} maxLength={80} required autoFocus disabled={busy} aria-describedby="passkey-name-help" />
+                <p id="passkey-name-help" className="text-xs text-gray-500">This label helps you recognize the key here. It does not rename it in your password manager.</p>
+                <div className="flex gap-2"><button className={button} disabled={busy || !keyName.trim()}>Save name</button><button type="button" className={button} disabled={busy} onClick={() => setEditId(null)}>Cancel</button></div>
+              </form> : removeId === key.id ? <div className="mt-4 rounded bg-red-50 p-4">
+                <p className="text-sm font-semibold">Remove “{label}”?</p><p className="mt-2 text-sm text-gray-700">You won’t be able to sign in with this passkey again. {account.credentials.length === 1 ? 'This is your last passkey; you can still sign in with your password.' : 'Your other passkeys will keep working.'}</p>
+                <div className="mt-3 flex flex-wrap gap-2"><button type="button" className={`${button} border-red-300 text-red-800`} disabled={busy} onClick={() => mutate(`passkeys/${encodeURIComponent(key.id)}`, 'DELETE', undefined, 'Passkey removed.', 'keys')}>Remove passkey</button><button type="button" className={button} disabled={busy} autoFocus onClick={() => setRemoveId(null)}>Keep passkey</button></div>
+              </div> : <div className="mt-4 flex gap-2"><button type="button" className={button} disabled={busy} aria-label={`Rename ${label}`} onClick={() => { setEditId(key.id); setRemoveId(null); setKeyName(label); }}>Rename</button><button type="button" className={`${button} text-red-800`} disabled={busy} aria-label={`Remove ${label}`} onClick={() => { setRemoveId(key.id); setEditId(null); }}>Remove</button></div>}
+            </li>;
+          })}
+        </ul>}
+        <p className="mt-4 text-xs leading-relaxed text-gray-500">Supported browsers receive updates to the accepted passkeys for your account. If your browser cannot sync, you can remove unused saved entries in your password manager.</p>
+      </section>
+      <div className="border-t border-gray-200 pt-6"><button className={button} type="button" disabled={busy} onClick={async () => { setBusy(true); try { await accountRequest('logout', 'POST'); window.location.assign(import.meta.env.BASE_URL); } catch (error) { failure(error); setBusy(false); } }}>Sign out</button></div>
+    </>}
+  </div>;
+}
