diff --git a/tests/account.test.mjs b/tests/account.test.mjs
new file mode 100644
index 0000000..dc933d8
--- /dev/null
+++ b/tests/account.test.mjs
@@ -0,0 +1,142 @@
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-account-'));
+process.env.ACCOUNT_DB_PATH = join(directory, 'accounts.sqlite');
+process.env.WEBAUTHN_RP_ID = 'example.com';
+process.env.WEBAUTHN_ORIGIN = 'https://example.com';
+const { accountAPI } = await import('../src/lib/account-api.ts');
+const store = await import('../src/lib/account-store.ts');
+after(() => { store.db().close(); rmSync(directory, { recursive: true, force: true }); });
+
+function session(readerId) {
+  const values = new Map(readerId ? [['readerId', readerId]] : []);
+  return {
+    get: async key => values.get(key), set: async (key, value) => values.set(key, value),
+    delete: key => values.delete(key), destroy: () => values.clear(), regenerate: async () => {},
+  };
+}
+async function request(action, method, body, signedSession, origin = 'https://example.com') {
+  const response = await accountAPI({ params: { action }, session: signedSession,
+    request: new Request(`https://example.com/devtools-times/api/account/${action}`, {
+      method, headers: { Origin: origin, 'Content-Type': 'application/json' },
+      ...(method !== 'GET' ? { body: JSON.stringify(body || {}) } : {}),
+    }),
+  });
+  return { status: response.status, data: await response.json(), headers: response.headers };
+}
+const alice = store.readerForLogin('alice');
+const bob = store.readerForLogin('bob');
+const aliceSession = session(alice.id);
+const bobSession = session(bob.id);
+
+test('credentials require a session; cross-origin mutations are rejected', async () => {
+  assert.equal((await request('passkeys', 'GET', null, session())).status, 401);
+  assert.equal((await request('profile', 'PUT', { displayName: 'Alice' }, aliceSession, 'https://evil.example')).status, 403);
+  const result = await request('passkeys', 'GET', null, aliceSession);
+  assert.equal(result.status, 200);
+  assert.deepEqual(result.data.credentials, []);
+  assert.equal(result.data.rpId, 'example.com');
+  assert.equal(result.headers.get('Cache-Control'), 'private, no-store');
+});
+
+// A software authenticator exercises real WebAuthn attestation and assertion verification.
+const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+const jwk = publicKey.export({ format: 'jwk' });
+const cose = isoCBOR.encode(new Map([[1, 2], [3, -7], [-1, 1],
+  [-2, Buffer.from(jwk.x, 'base64url')], [-3, Buffer.from(jwk.y, 'base64url')]]));
+const credentialId = randomBytes(32);
+const id = credentialId.toString('base64url');
+const hash = value => createHash('sha256').update(value).digest();
+function clientData(type, challenge, origin = 'https://example.com') {
+  return Buffer.from(JSON.stringify({ type, challenge, origin, crossOrigin: false }));
+}
+function assertion(challenge, counter, origin) {
+  const client = clientData('webauthn.get', challenge, origin);
+  const count = Buffer.alloc(4); count.writeUInt32BE(counter);
+  const authenticatorData = Buffer.concat([hash('example.com'), Buffer.from([0x05]), count]);
+  return { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: {
+    clientDataJSON: client.toString('base64url'), authenticatorData: authenticatorData.toString('base64url'),
+    signature: sign('sha256', Buffer.concat([authenticatorData, hash(client)]), privateKey).toString('base64url'),
+    userHandle: alice.id,
+  } };
+}
+
+test('verified registration, ownership, rename, profile, sign-in and removal', async () => {
+  const options = await request('register/options', 'POST', {}, aliceSession);
+  assert.equal(options.status, 200);
+  assert.equal(options.data.authenticatorSelection.residentKey, 'required');
+  assert.equal(options.data.authenticatorSelection.authenticatorAttachment, undefined);
+  const client = clientData('webauthn.create', options.data.challenge);
+  const length = Buffer.alloc(2); length.writeUInt16BE(credentialId.length);
+  const authData = Buffer.concat([hash('example.com'), Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), length, credentialId, cose]);
+  const attestation = isoCBOR.encode(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]));
+  const registration = { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: {
+    clientDataJSON: client.toString('base64url'), attestationObject: Buffer.from(attestation).toString('base64url'), transports: ['internal'],
+  } };
+  const registered = await request('register/verify', 'POST', registration, aliceSession);
+  assert.equal(registered.status, 201, JSON.stringify(registered.data));
+  assert.equal(registered.data.credentials[0].id, id);
+  assert.equal(registered.data.credentials[0].publicKey, undefined);
+  assert.equal((await request('register/verify', 'POST', registration, aliceSession)).status, 400, 'challenge cannot be replayed');
+  assert.equal((await request(`passkeys/${id}`, 'PUT', { name: 'Stolen' }, bobSession)).status, 404);
+  assert.equal((await request(`passkeys/${id}`, 'DELETE', {}, bobSession)).status, 404);
+  assert.deepEqual((await request('passkeys', 'GET', null, bobSession)).data.credentials, []);
+  assert.equal((await request(`passkeys/${id}`, 'PUT', { name: '   ' }, aliceSession)).status, 400);
+  assert.equal((await request(`passkeys/${id}`, 'PUT', { name: 'a'.repeat(81) }, aliceSession)).status, 400);
+  const renamed = await request(`passkeys/${id}`, 'PUT', { name: '  My laptop  ' }, aliceSession);
+  assert.equal(renamed.data.credentials[0].name, 'My laptop');
+  const profile = await request('profile', 'PUT', { displayName: 'Alice Reader' }, aliceSession);
+  assert.equal(profile.data.displayName, 'Alice Reader');
+  assert.equal(profile.data.name, 'alice');
+  assert.equal(store.readerForLogin('alice').id, alice.id, 'profile changes preserve password account identity');
+  const anonymous = session();
+  const loginOptions = await request('authenticate/options', 'POST', {}, anonymous);
+  const signed = assertion(loginOptions.data.challenge, 1);
+  assert.equal((await request('authenticate/verify', 'POST', signed, anonymous)).status, 200);
+  assert.equal(await anonymous.get('readerId'), alice.id);
+  assert.equal(store.findPasskey(id).counter, 1);
+  assert.ok(store.findPasskey(id).lastUsedAt);
+  assert.equal((await request('authenticate/verify', 'POST', signed, anonymous)).status, 400);
+  const wrongOriginOptions = await request('authenticate/options', 'POST', {}, session());
+  const badSession = session();
+  const badOptions = await request('authenticate/options', 'POST', {}, badSession);
+  assert.equal((await request('authenticate/verify', 'POST', assertion(badOptions.data.challenge, 2, 'https://evil.example'), badSession)).status, 400);
+  const wrongChallenge = await request('authenticate/options', 'POST', {}, badSession);
+  assert.equal((await request('authenticate/verify', 'POST', assertion(wrongOriginOptions.data.challenge, 2), badSession)).status, 400);
+  assert.equal(wrongChallenge.status, 200);
+  const removed = await request(`passkeys/${id}`, 'DELETE', {}, aliceSession);
+  assert.equal(removed.status, 200);
+  assert.deepEqual(removed.data.credentials, [], 'authoritative empty list allows last-key sync');
+  const removedSession = session();
+  const removedOptions = await request('authenticate/options', 'POST', {}, removedSession);
+  assert.equal((await request('authenticate/verify', 'POST', assertion(removedOptions.data.challenge, 2), removedSession)).status, 404);
+  assert.equal((await request('logout', 'POST', {}, aliceSession)).status, 200);
+  assert.equal((await request('passkeys', 'GET', null, aliceSession)).status, 401);
+});
+
+test('expired and wrong-account challenges cannot be consumed', () => {
+  const challengeId = store.createChallenge('challenge', 'registration', alice.id);
+  assert.equal(store.consumeChallenge(challengeId, 'registration', bob.id), undefined);
+  assert.equal(store.consumeChallenge(challengeId, 'registration', alice.id), undefined);
+  const expired = store.createChallenge('challenge', 'registration', alice.id);
+  store.db().prepare('UPDATE challenges SET expiresAt = 0 WHERE id = ?').run(expired);
+  assert.equal(store.consumeChallenge(expired, 'registration', alice.id), undefined);
+});
+
+test('password service success establishes a session; rejection does not', async context => {
+  const fetch = context.mock.method(globalThis, 'fetch', async () => new Response(JSON.stringify({ user: { username: 'canonical-reader' } })));
+  const signed = session();
+  const login = await request('login', 'POST', { username: 'Canonical-Reader', password: 'not-stored' }, signed);
+  assert.equal(login.status, 200);
+  assert.equal(store.findReader(await signed.get('readerId')).loginName, 'canonical-reader');
+  fetch.mock.mockImplementation(async () => new Response('{}', { status: 401 }));
+  const denied = session();
+  assert.equal((await request('login', 'POST', { username: 'canonical-reader', password: 'wrong' }, denied)).status, 401);
+  assert.equal(await denied.get('readerId'), undefined);
+});
diff --git a/tests/passkey-sync.test.mjs b/tests/passkey-sync.test.mjs
new file mode 100644
