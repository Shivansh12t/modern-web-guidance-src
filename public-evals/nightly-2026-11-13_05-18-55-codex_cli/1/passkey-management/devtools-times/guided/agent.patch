--- /dev/null
+++ b/tests/passkey-sync.test.mjs
@@ -0,0 +1,43 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { syncAcceptedCredentials, syncUserDetails, signalUnknown, validBase64Url } from '../src/lib/passkey-client.ts';
+
+const account = { rpId: 'example.com', userId: 'dXNlci0x', name: 'reader', displayName: 'A Reader', credentials: [{ id: 'Y3JlZC0x' }] };
+afterEach(() => { delete globalThis.window; });
+
+test('sync uses the server RP ID and the entire authoritative credential list, including empty lists', async () => {
+  const calls = [];
+  globalThis.window = { PublicKeyCredential: { signalAllAcceptedCredentials: async data => calls.push(data) }, location: { hostname: 'accounts.example.com' } };
+  assert.equal(await syncAcceptedCredentials(account), true);
+  assert.deepEqual(calls[0], { rpId: 'example.com', userId: 'dXNlci0x', allAcceptedCredentialIds: ['Y3JlZC0x'] });
+  await syncAcceptedCredentials({ ...account, credentials: [] });
+  assert.deepEqual(calls[1].allAcceptedCredentialIds, []);
+});
+test('unsupported browsers and absent browser globals remain usable', async () => {
+  assert.equal(await syncAcceptedCredentials(account), false);
+  globalThis.window = { PublicKeyCredential: {} };
+  assert.equal(await syncUserDetails(account), false);
+  await signalUnknown(account.rpId, 'Y3JlZC0x');
+});
+test('invalid Base64URL metadata skips the entire destructive synchronization', async context => {
+  const warnings = context.mock.method(console, 'warn', () => {});
+  let calls = 0;
+  globalThis.window = { PublicKeyCredential: { signalAllAcceptedCredentials: async () => calls++ } };
+  for (const value of ['', 'a', 'abc=', 'not:valid', 'abc de']) assert.equal(validBase64Url(value), false);
+  assert.equal(await syncAcceptedCredentials({ ...account, credentials: [{ id: 'Y3JlZC0x' }, { id: 'a' }] }), false);
+  assert.equal(await syncAcceptedCredentials({ ...account, userId: 'bad=' }), false);
+  assert.equal(calls, 0);
+  assert.equal(warnings.mock.callCount(), 2);
+});
+test('profile sync passes verified account names; rejected signals are nonfatal', async context => {
+  const warnings = context.mock.method(console, 'warn', () => {});
+  let profile;
+  globalThis.window = { PublicKeyCredential: {
+    signalCurrentUserDetails: async data => { profile = data; },
+    signalAllAcceptedCredentials: async () => { throw new Error('Provider declined'); },
+  } };
+  assert.equal(await syncUserDetails(account), true);
+  assert.deepEqual(profile, { rpId: 'example.com', userId: 'dXNlci0x', name: 'reader', displayName: 'A Reader' });
+  assert.equal(await syncAcceptedCredentials(account), false);
+  assert.equal(warnings.mock.callCount(), 1);
+});
