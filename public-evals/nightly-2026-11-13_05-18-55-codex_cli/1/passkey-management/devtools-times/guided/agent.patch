@@ -0,0 +1,141 @@
+import type { APIContext } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse,
+  generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import type { AuthenticationResponseJSON, RegistrationResponseJSON } from '@simplewebauthn/server';
+import { consumeChallenge, createChallenge, deletePasskey, findPasskey, findReader,
+  insertPasskey, listPasskeys, markUsed, publicPasskey, readerForLogin, renamePasskey,
+  updateDisplayName, type Reader } from './account-store.ts';
+
+export function webauthnConfig() {
+  const origin = process.env.WEBAUTHN_ORIGIN || 'https://astro-news-pytrpecapa-uc.a.run.app';
+  return { origin, rpId: process.env.WEBAUTHN_RP_ID || new URL(origin).hostname };
+}
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), { status, headers: {
+    'Content-Type': 'application/json', 'Cache-Control': 'private, no-store',
+    'Vary': 'Cookie',
+  } });
+}
+function snapshot(reader: Reader) {
+  const { rpId } = webauthnConfig();
+  return { rpId, userId: reader.id, name: reader.loginName, displayName: reader.displayName,
+    credentials: listPasskeys(reader.id, rpId).map(publicPasskey) };
+}
+function validName(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0 && value.trim().length <= 80;
+}
+
+export async function accountAPI(context: APIContext) {
+  const { request, session, params } = context;
+  const action = params.action || '';
+  const method = request.method;
+  if (!session) return json({ error: 'Account sessions are unavailable.' }, 503);
+  if (method !== 'GET' && request.headers.get('Origin') !== new URL(request.url).origin) {
+    return json({ error: 'Please submit this request from the site.' }, 403);
+  }
+  if (method !== 'GET' && !request.headers.get('Content-Type')?.startsWith('application/json')) {
+    return json({ error: 'A JSON request is required.' }, 415);
+  }
+  const readerId = await session.get('readerId');
+  const reader = typeof readerId === 'string' ? findReader(readerId) : undefined;
+  try {
+    if (action === 'login' && method === 'POST') {
+      const { username, password } = await request.json();
+      if (typeof username !== 'string' || !username.trim() || username.length > 254 ||
+          typeof password !== 'string' || !password || password.length > 1024) {
+        return json({ error: 'Enter your username and password.' }, 400);
+      }
+      const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15_000),
+      });
+      if (!response.ok) return json({ error: 'Unable to sign in. Check your username and password.' }, 401);
+      // Only the successful trusted password service response establishes account identity.
+      const result = await response.json();
+      const canonicalName = typeof result.user?.username === 'string' ? result.user.username : username;
+      const account = readerForLogin(canonicalName);
+      await session.regenerate();
+      await session.set('readerId', account.id);
+      return json({ success: true });
+    }
+    if (action === 'authenticate/options' && method === 'POST') {
+      const options = await generateAuthenticationOptions({ rpID: webauthnConfig().rpId, userVerification: 'required' });
+      await session.set('authenticationChallenge', createChallenge(options.challenge, 'authentication'));
+      return json(options);
+    }
+    if (action === 'authenticate/verify' && method === 'POST') {
+      const challengeId = await session.get('authenticationChallenge');
+      session.delete('authenticationChallenge');
+      const challenge = typeof challengeId === 'string' ? consumeChallenge(challengeId, 'authentication') : undefined;
+      if (!challenge) return json({ error: 'Sign-in expired. Please try again.' }, 400);
+      const response: AuthenticationResponseJSON = await request.json();
+      const key = typeof response.id === 'string' ? findPasskey(response.id) : undefined;
+      const { origin, rpId } = webauthnConfig();
+      if (!key || key.rpId !== rpId) return json({ error: 'This passkey is no longer registered. Sign in with your password.' }, reader ? 400 : 404);
+      if (response.response?.userHandle && response.response.userHandle !== key.userId) {
+        return json({ error: 'Unable to verify this passkey.' }, 400);
+      }
+      const verification = await verifyAuthenticationResponse({ response, expectedChallenge: challenge,
+        expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: true,
+        credential: { id: key.id, publicKey: Buffer.from(key.publicKey, 'base64url'), counter: key.counter, transports: key.transports } });
+      if (!verification.verified || !markUsed(key, verification.authenticationInfo.newCounter, verification.authenticationInfo.credentialBackedUp)) {
+        return json({ error: 'Unable to verify this passkey.' }, 400);
+      }
+      await session.regenerate();
+      await session.set('readerId', key.userId);
+      return json({ success: true });
+    }
+    if (!reader) return json({ error: 'Please sign in to manage your account.' }, 401);
+    if (action === 'logout' && method === 'POST') {
+      session.destroy();
+      return json({ success: true });
+    }
+    if (action === 'passkeys' && method === 'GET') return json(snapshot(reader));
+    if (action === 'profile' && method === 'PUT') {
+      const { displayName } = await request.json();
+      if (!validName(displayName)) return json({ error: 'Use a display name of 1–80 characters.' }, 400);
+      return json(snapshot(updateDisplayName(reader.id, displayName.trim())));
+    }
+    const keyId = action.startsWith('passkeys/') ? action.slice('passkeys/'.length) : '';
+    if (keyId && (method === 'PUT' || method === 'DELETE')) {
+      const { rpId } = webauthnConfig();
+      if (method === 'PUT') {
+        const { name } = await request.json();
+        if (!validName(name)) return json({ error: 'Use a passkey name of 1–80 characters.' }, 400);
+        if (!renamePasskey(keyId, reader.id, rpId, name.trim())) return json({ error: 'Passkey not found. Refresh the list.' }, 404);
+      } else if (!deletePasskey(keyId, reader.id, rpId)) return json({ error: 'Passkey not found. Refresh the list.' }, 404);
+      return json(snapshot(reader));
+    }
+    if (action === 'register/options' && method === 'POST') {
+      const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID: webauthnConfig().rpId,
+        userName: reader.loginName, userDisplayName: reader.displayName, userID: Buffer.from(reader.id, 'base64url'),
+        excludeCredentials: listPasskeys(reader.id, webauthnConfig().rpId).map(key => ({ id: key.id, transports: key.transports })),
+        supportedAlgorithmIDs: [-7, -257],
+        attestationType: 'none', authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' } });
+      await session.set('registrationChallenge', createChallenge(options.challenge, 'registration', reader.id));
+      return json(options);
+    }
+    if (action === 'register/verify' && method === 'POST') {
+      const challengeId = await session.get('registrationChallenge');
+      session.delete('registrationChallenge');
+      const challenge = typeof challengeId === 'string' ? consumeChallenge(challengeId, 'registration', reader.id) : undefined;
+      if (!challenge) return json({ error: 'Registration expired. Please try again.' }, 400);
+      const response: RegistrationResponseJSON = await request.json();
+      const { origin, rpId } = webauthnConfig();
+      const result = await verifyRegistrationResponse({ response, expectedChallenge: challenge, expectedOrigin: origin,
+        expectedRPID: rpId, requireUserVerification: true, supportedAlgorithmIDs: [-7, -257] });
+      if (!result.verified) return json({ error: 'Unable to verify this passkey.' }, 400);
+      const { credential, aaguid, credentialBackedUp } = result.registrationInfo;
+      insertPasskey({ id: credential.id, userId: reader.id, rpId, name: '', aaguid,
+        publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter,
+        transports: credential.transports || [], registeredAt: Date.now(), backedUp: credentialBackedUp });
+      return json(snapshot(reader), 201);
+    }
+    return json({ error: 'Account action not found.' }, 404);
+  } catch (error) {
+    if (error instanceof SyntaxError) return json({ error: 'Invalid request.' }, 400);
+    if (action.endsWith('/verify')) return json({ error: 'Unable to verify this passkey. Please try again.' }, 400);
+    console.warn('Account request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'Your changes could not be saved. Please try again.' }, 503);
+  }
+}
diff --git a/src/lib/account-store.ts b/src/lib/account-store.ts
new file mode 100644
index 0000000..3931cd0
--- /dev/null
+++ b/src/lib/account-store.ts
@@ -0,0 +1,90 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface Reader { id: string; loginName: string; displayName: string }
+export interface Passkey {
+  id: string; userId: string; rpId: string; name: string; aaguid: string;
+  publicKey: string; counter: number; transports: string[];
+  registeredAt: number; lastUsedAt?: number; backedUp: boolean;
+}
+
+// SQLite provides durable, atomic updates across requests and worker processes.
+let database: DatabaseSync;
+export function db() {
+  if (!database) {
+    const path = resolve(process.env.ACCOUNT_DB_PATH || '.data/accounts.sqlite');
+    mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    database = new DatabaseSync(path);
+    database.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA busy_timeout = 5000;
+      CREATE TABLE IF NOT EXISTS readers (
+        id TEXT PRIMARY KEY, loginName TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, userId TEXT NOT NULL, rpId TEXT NOT NULL, record TEXT NOT NULL
+      );
+      CREATE INDEX IF NOT EXISTS passkeys_user ON passkeys(userId, rpId);
+      CREATE TABLE IF NOT EXISTS challenges (
+        id TEXT PRIMARY KEY, challenge TEXT NOT NULL, kind TEXT NOT NULL,
+        userId TEXT, expiresAt INTEGER NOT NULL
+      );
+    `);
+  }
+  return database;
+}
+
+export function findReader(id: string) {
+  return db().prepare('SELECT * FROM readers WHERE id = ?').get(id) as Reader | undefined;
+}
+export function readerForLogin(loginName: string) {
+  db().prepare('INSERT OR IGNORE INTO readers VALUES (?, ?, ?)')
+    .run(randomBytes(32).toString('base64url'), loginName, loginName);
+  return db().prepare('SELECT * FROM readers WHERE loginName = ?').get(loginName) as unknown as Reader;
+}
+export function updateDisplayName(id: string, displayName: string) {
+  db().prepare('UPDATE readers SET displayName = ? WHERE id = ?').run(displayName, id);
+  return findReader(id)!;
+}
+export function listPasskeys(userId: string, rpId: string): Passkey[] {
+  return db().prepare('SELECT record FROM passkeys WHERE userId = ? AND rpId = ? ORDER BY rowid')
+    .all(userId, rpId).map(row => JSON.parse(row.record as string));
+}
+export function findPasskey(id: string): Passkey | undefined {
+  const row = db().prepare('SELECT record FROM passkeys WHERE id = ?').get(id);
+  return row ? JSON.parse(row.record as string) : undefined;
+}
+export function insertPasskey(key: Passkey) {
+  db().prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?)').run(key.id, key.userId, key.rpId, JSON.stringify(key));
+}
+export function renamePasskey(id: string, userId: string, rpId: string, name: string) {
+  return db().prepare(`UPDATE passkeys SET record = json_set(record, '$.name', ?)
+    WHERE id = ? AND userId = ? AND rpId = ?`).run(name, id, userId, rpId).changes > 0;
+}
+export function deletePasskey(id: string, userId: string, rpId: string) {
+  return db().prepare('DELETE FROM passkeys WHERE id = ? AND userId = ? AND rpId = ?')
+    .run(id, userId, rpId).changes > 0;
+}
+export function markUsed(key: Passkey, counter: number, backedUp: boolean) {
+  // Never overwrite a concurrent rename; reject a concurrently deleted/replayed key.
+  return db().prepare(`UPDATE passkeys SET record = json_set(record,
+    '$.counter', ?, '$.lastUsedAt', ?, '$.backedUp', json(?))
+    WHERE id = ? AND json_extract(record, '$.counter') = ?`)
+    .run(counter, Date.now(), JSON.stringify(backedUp), key.id, key.counter).changes > 0;
+}
+export function createChallenge(challenge: string, kind: string, userId?: string) {
+  const id = randomBytes(32).toString('base64url');
+  db().prepare('DELETE FROM challenges WHERE expiresAt < ?').run(Date.now());
+  db().prepare('INSERT INTO challenges VALUES (?, ?, ?, ?, ?)')
+    .run(id, challenge, kind, userId || null, Date.now() + 300_000);
+  return id;
+}
+export function consumeChallenge(id: string, kind: string, userId?: string) {
+  const row = db().prepare('DELETE FROM challenges WHERE id = ? RETURNING *').get(id);
+  if (!row || row.kind !== kind || row.userId !== (userId || null) || Number(row.expiresAt) < Date.now()) return;
+  return row.challenge as string;
+}
+
+export function publicPasskey({ publicKey, counter, userId, rpId, ...key }: Passkey) { return key; }
diff --git a/src/lib/passkey-client.ts b/src/lib/passkey-client.ts
new file mode 100644
index 0000000..058a242
--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,76 @@
+export interface CredentialSummary {
+  id: string; name: string; aaguid: string; registeredAt: number;
+  lastUsedAt?: number; backedUp: boolean; transports: string[];
+}
+export interface AccountSnapshot {
+  rpId: string; userId: string; name: string; displayName: string;
+  credentials: CredentialSummary[];
+}
+export class AccountError extends Error {
+  status: number;
+  constructor(message: string, status: number) { super(message); this.status = status; }
+}
+export async function accountRequest<T>(action: string, method = 'GET', body?: unknown): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/account/${action}`, {
+    method, credentials: 'same-origin', cache: 'no-store',
+    ...(method !== 'GET' ? { headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body ?? {}) } : {}),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new AccountError(data.error || 'The request could not be completed.', response.status);
+  return data;
+}
+export function validBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+type SignalConstructor = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+};
+function signalAPI() {
+  return typeof window !== 'undefined' && window.PublicKeyCredential ? window.PublicKeyCredential as SignalConstructor : undefined;
+}
+export async function syncAcceptedCredentials(account: AccountSnapshot): Promise<boolean> {
+  const api = signalAPI();
+  if (!api?.signalAllAcceptedCredentials) return false;
+  const ids = account.credentials.map(key => key.id);
+  // Do not filter malformed IDs: a partial list could remove a valid key from a vault.
+  if (!account.rpId || !validBase64Url(account.userId) || !ids.every(validBase64Url)) {
+    console.warn('Passkey sync skipped: invalid server credential metadata.');
+    return false;
+  }
+  try {
+    await api.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: ids });
+    return true;
+  } catch (error) { console.warn('Passkey sync was unavailable:', error); return false; }
+}
+export async function syncUserDetails(account: AccountSnapshot) {
+  const api = signalAPI();
+  if (!api?.signalCurrentUserDetails || !account.rpId || !validBase64Url(account.userId)) return false;
+  try {
+    await api.signalCurrentUserDetails({ rpId: account.rpId, userId: account.userId, name: account.name, displayName: account.displayName });
+    return true;
+  } catch (error) { console.warn('Passkey profile sync was unavailable:', error); return false; }
+}
+export async function signalUnknown(rpId: string, credentialId: string) {
+  const api = signalAPI();
+  if (!api?.signalUnknownCredential || !rpId || !validBase64Url(credentialId)) return;
+  try { await api.signalUnknownCredential({ rpId, credentialId }); }
+  catch (error) { console.warn('Passkey cleanup was unavailable:', error); }
+}
+export async function passkeyCapabilities() {
+  if (typeof window === 'undefined' || !window.isSecureContext || !window.PublicKeyCredential) return null;
+  await import('webauthn-polyfills');
+  try { return await PublicKeyCredential.getClientCapabilities(); }
+  catch { return null; }
+}
+export function passkeyError(error: unknown) {
+  if (error instanceof Error) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was cancelled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey for this account already exists in that authenticator.';
+    if (error.name === 'SecurityError') return 'Passkeys are unavailable on this address. Use the configured secure site address.';
+    return error.message;
+  }
+  return 'The request could not be completed. Please try again.';
+}
