+    /* Showcase: keep the card's clip inside its padded frame. */
+    .showcase {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 28px;
+      margin-bottom: 48px;
+    }
+
+    .nested-curve-parent {
+      --card-radius: 28px;
+      --card-padding: 12px;
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      background: var(--secondary);
+    }
+
+    .nested-curve-content {
+      height: 100%;
+      overflow: hidden;
+      border-radius: calc(var(--card-radius) - var(--card-padding));
+      background: #fff;
+    }
+
+    .showcase-image {
+      display: block;
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+    }
+
+    .showcase-copy {
+      padding: 24px;
+    }
+
+    .showcase-eyebrow {
+      margin-bottom: 8px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.14em;
+      text-transform: uppercase;
+    }
+
+    .showcase h2 {
+      font-size: 1.65rem;
+      line-height: 1.2;
+      margin-bottom: 12px;
+    }
+
+    /* Only the text layer clips; the button's glow can escape the promo. */
+    .safety-zone-parent {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: flex-start;
+      min-width: 0;
+      padding: 36px;
+      border-radius: 28px;
+      background: var(--primary);
+      color: white;
+      overflow: visible;
+    }
+
+    .promo-text {
+      align-self: stretch;
+      min-width: 0;
+      overflow: hidden;
+    }
+
+    .promo-watermark {
+      display: block;
+      width: max-content;
+      margin-bottom: 16px;
+      color: #d7ccc8;
+      font-size: 3.5rem;
+      font-weight: 800;
+      letter-spacing: 0.06em;
+      line-height: 1;
+      white-space: nowrap;
+    }
+
+    .safety-zone-parent .promo-button {
+      position: relative;
+      margin-top: 24px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 700;
+      box-shadow: 0 0 28px 12px rgba(255, 171, 64, 0.4);
+    }
+
+    .safety-zone-parent .promo-button:hover {
+      background: #ffc470;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid white;
+      outline-offset: 5px;
+    }
+
+    @media (max-width: 700px) {
+      .showcase {
+        grid-template-columns: 1fr;
+      }
+
+      .safety-zone-parent {
+        padding: 28px;
+      }
+    }
