     .btn:hover {
       background: #3e2723;
     }
 
+    /* Showcase: keep the card's padding clean and give the promo glow room. */
+    .showcase {
+      margin-block-end: 48px;
+    }
+
+    .showcase > h2 {
+      text-align: center;
+      margin-block-end: 20px;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 32px;
+      align-items: center;
+    }
+
+    .nested-curve-parent {
+      --card-radius: 28px;
+      --card-padding: 14px;
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      background: var(--secondary);
+      overflow: hidden;
+    }
+
+    /* Fallback keeps the inner curve concentric without clipping the padding. */
+    .nested-curve-content {
+      overflow: hidden;
+      border-radius: calc(var(--card-radius) - var(--card-padding));
+      background: white;
+    }
+
+    .nested-curve-content img {
+      display: block;
+      inline-size: 100%;
+      block-size: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      padding: 24px;
+    }
+
+    .nested-curve-footer h3 {
+      margin-block-end: 8px;
+    }
+
+    .safety-zone-parent {
+      padding: 28px 24px 0;
+      border-radius: 24px;
+      background: var(--primary);
+      color: white;
+      /* Text clips separately so the button glow survives in older browsers. */
+      overflow: visible;
+    }
+
+    .promo-copy {
+      overflow: hidden;
+    }
+
+    .promo-copy h3 {
+      margin-block-end: 12px;
+      font-size: 1.6rem;
+    }
+
+    .promo-teaser {
+      white-space: nowrap;
+      text-overflow: ellipsis;
+      overflow: hidden;
+      margin-block-end: 12px;
+      color: var(--secondary);
+    }
+
+    .promo-button {
+      display: block;
+      inline-size: 100%;
+      margin-block-start: 24px;
+      padding: 14px 20px;
+      border: 0;
+      border-radius: 12px;
+      background: var(--accent);
+      color: var(--text);
+      font: inherit;
+      font-weight: 700;
+      cursor: pointer;
+      box-shadow: 0 0 16px 3px rgb(255 171 64 / 65%);
+    }
+
+    .promo-button:hover {
+      background: #ffc477;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid white;
+      outline-offset: 4px;
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+
+      .nested-curve-content {
+        overflow: visible;
+        border-radius: 0;
+      }
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: 32px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 32px;
+      }
+    }
+
