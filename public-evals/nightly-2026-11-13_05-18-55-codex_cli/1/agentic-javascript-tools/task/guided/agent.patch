diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,72 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const modelContext = document.modelContext;
+
+    if (typeof modelContext?.registerTool === 'function') {
+      let registration;
+
+      const lookupMenuItem = {
+        name: 'get_menu_item',
+        description: 'Looks up a menu item and returns its name, description, and details URL. Use when someone asks about a drink on the menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              minLength: 1,
+              description: 'The menu item to look up, such as Maple Oat Latte. Matching ignores capitalization and surrounding whitespace.'
+            }
+          },
+          required: ['itemName'],
+          additionalProperties: false
+        },
+        execute(input) {
+          if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const requestedName = input.itemName.trim().toLowerCase();
+          const item = items.find((entry) => entry.name.toLowerCase() === requestedName);
+
+          return item ?? {
+            error: `Menu item "${input.itemName.trim()}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        },
+        annotations: { readOnlyHint: true }
+      };
+
+      async function registerMenuTool() {
+        if (registration && !registration.signal.aborted) return;
+
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await modelContext.registerTool(lookupMenuItem, { signal: controller.signal });
+        } catch (error) {
+          controller.abort();
+          if (registration === controller) registration = undefined;
+          if (error?.name !== 'AbortError') {
+            console.warn('Could not register the menu lookup tool.', error);
+          }
+        }
+      }
+
+      window.addEventListener('pagehide', () => registration?.abort());
+      // A page restored from the back/forward cache needs a fresh registration.
+      window.addEventListener('pageshow', () => { void registerMenuTool(); });
+      void registerMenuTool();
+    }
+  </script>
+
 </body>
 
 </html>
