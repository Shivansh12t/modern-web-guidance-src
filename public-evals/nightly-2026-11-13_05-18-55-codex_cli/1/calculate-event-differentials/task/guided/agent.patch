+  <script type="module">
+    const status = document.getElementById('promotion-status');
+    const remaining = document.getElementById('promotion-remaining');
+    const elapsed = document.getElementById('promotion-elapsed');
+    const zone = document.getElementById('promotion-zone');
+
+    try {
+      // Load only when needed; keep the fallback pinned for this static page.
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/temporal-polyfill@0.3.0')).Temporal;
+      const durationFormatter = typeof Intl.DurationFormat === 'function'
+        ? new Intl.DurationFormat(undefined, {
+          style: 'long', days: 'long', daysDisplay: 'always',
+          hours: 'long', hoursDisplay: 'always'
+        })
+        : null;
+      const dayFormatter = new Intl.NumberFormat(undefined, {
+        style: 'unit', unit: 'day', unitDisplay: 'long'
+      });
+      const hourFormatter = new Intl.NumberFormat(undefined, {
+        style: 'unit', unit: 'hour', unitDisplay: 'long'
+      });
+      const formatDuration = ({ days, hours }) => durationFormatter
+        ? durationFormatter.format({ days, hours })
+        : `${dayFormatter.format(days)}, ${hourFormatter.format(hours)}`;
+      const precision = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' };
+      const zero = Temporal.Duration.from({ days: 0, hours: 0 });
+
+      function updatePromotionTimer() {
+        const now = Temporal.Now.zonedDateTimeISO();
+        const timeZone = now.timeZoneId;
+        // Assumed promotion start: January 1, 2026, in the visitor's time zone.
+        const start = Temporal.PlainDate.from('2026-01-01')
+          .toZonedDateTime({ timeZone, plainTime: '00:00' });
+        const end = Temporal.PlainDate.from('2026-03-01')
+          .toZonedDateTime({ timeZone, plainTime: '00:00' });
+        const hasStarted = Temporal.ZonedDateTime.compare(now, start) >= 0;
+        const hasEnded = Temporal.ZonedDateTime.compare(now, end) >= 0;
+
+        status.textContent = hasEnded ? 'Offer ended'
+          : hasStarted ? 'Limited-time offer' : 'Promotion starts soon';
+        remaining.textContent = formatDuration(hasEnded ? zero : now.until(end, precision));
+        elapsed.textContent = formatDuration(hasStarted ? now.since(start, precision) : zero);
+        zone.textContent = ` (${timeZone})`;
+      }
+
+      updatePromotionTimer();
+      setInterval(updatePromotionTimer, 60_000);
+      // Refresh immediately when returning to a tab whose timers were suspended.
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotionTimer();
+      });
+      window.addEventListener('pageshow', updatePromotionTimer);
+    } catch (error) {
+      remaining.textContent = 'Unavailable';
+      elapsed.textContent = 'Unavailable';
+      status.textContent = 'See promotion dates below';
+      console.error('Unable to initialize promotion timer.', error);
+    }
+  </script>
+
 </body>
 
