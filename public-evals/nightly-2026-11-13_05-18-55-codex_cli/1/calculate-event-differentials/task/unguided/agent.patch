+  <script>
+    (() => {
+      // Promotion start is assumed to be January 1; months are zero-based.
+      // Numeric components preserve local midnight instead of parsing a UTC date.
+      const promotionStart = new Date(2026, 0, 1, 0, 0, 0).getTime();
+      const promotionEnd = new Date(2026, 2, 1, 0, 0, 0).getTime();
+      const now = Date.now();
+      const hour = 60 * 60 * 1000;
+
+      function formatDuration(milliseconds) {
+        const totalHours = Math.floor(Math.max(0, milliseconds) / hour);
+        const days = Math.floor(totalHours / 24);
+        const hours = totalHours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} and ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      const remaining = `${formatDuration(promotionEnd - now)} left`;
+      document.getElementById('promotion-remaining').textContent = now >= promotionEnd
+        ? `Offer ended · ${remaining}`
+        : now < promotionStart ? `Coming soon · ${remaining}` : remaining;
+      document.getElementById('promotion-elapsed').textContent =
+        `${formatDuration(now - promotionStart)} elapsed since promotion start.`;
+    })();
+  </script>
+
