+  <script>
+    (() => {
+      const menu = document.querySelector('#coffee-menu');
+      const navigation = menu.querySelector('.menu-navigation');
+      const tablist = menu.querySelector('[role="tablist"]');
+      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+      const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));
+      const scrollButtons = [...navigation.querySelectorAll('.tab-scroll')];
+      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const behavior = () => motion.matches ? 'instant' : 'smooth';
+
+      function updateScrollButtons() {
+        const maxScroll = tablist.scrollWidth - tablist.clientWidth;
+        scrollButtons.forEach(button => {
+          button.hidden = maxScroll <= 1;
+          button.disabled = Number(button.dataset.direction) < 0
+            ? tablist.scrollLeft <= 1
+            : tablist.scrollLeft >= maxScroll - 1;
+        });
+      }
+
+      function revealTab(tab, scrollBehavior = behavior()) {
+        const viewport = tablist.getBoundingClientRect();
+        const bounds = tab.getBoundingClientRect();
+        const offset = bounds.left < viewport.left + 4
+          ? bounds.left - viewport.left - 4
+          : bounds.right > viewport.right - 4
+            ? bounds.right - viewport.right + 4
+            : 0;
+        if (offset) tablist.scrollBy({ left: offset, behavior: scrollBehavior });
+      }
+
+      function selectTab(tab) {
+        tabs.forEach((item, index) => {
+          const selected = item === tab;
+          item.setAttribute('aria-selected', String(selected));
+          item.tabIndex = selected ? 0 : -1;
+          panels[index].hidden = !selected;
+        });
+        revealTab(tab);
+      }
+
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(tab));
+        tab.addEventListener('keydown', event => {
+          let next;
+          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+          if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+          if (event.key === 'Home') next = 0;
+          if (event.key === 'End') next = tabs.length - 1;
+          if (next === undefined) return;
+          event.preventDefault();
+          tabs[next].focus({ preventScroll: true });
+          selectTab(tabs[next]);
+        });
+      });
+
+      scrollButtons.forEach(button => {
+        button.addEventListener('click', () => {
+          tablist.scrollBy({
+            left: Number(button.dataset.direction) * tablist.clientWidth * 0.75,
+            behavior: behavior()
+          });
+        });
+      });
+      tablist.addEventListener('scroll', updateScrollButtons, { passive: true });
+      navigation.hidden = false;
+      selectTab(tabs[0]);
+      updateScrollButtons();
+      // Observe the strip too: showing the arrows changes its available width.
+      const resizeObserver = new ResizeObserver(() => {
+        updateScrollButtons();
+        revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'), 'instant');
+      });
+      resizeObserver.observe(tablist);
+    })();
+  </script>
