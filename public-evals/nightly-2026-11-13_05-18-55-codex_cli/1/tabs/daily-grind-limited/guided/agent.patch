+  <script>
+    const menu = document.querySelector('#coffee-menu');
+    const tablist = menu.querySelector('.menu-tabs');
+    const tabs = [...tablist.querySelectorAll('.menu-tab')];
+    const panels = [...menu.querySelectorAll('.menu-panel')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function revealTab(tab, behavior = 'instant') {
+      tab.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest', behavior });
+    }
+
+    function selectTab(selected) {
+      for (const tab of tabs) {
+        const active = tab === selected;
+        tab.setAttribute('aria-selected', String(active));
+        // Native focusgroup returns keyboard focus to the selected category.
+        tab.toggleAttribute('focusgroupstart', active);
+      }
+      for (const panel of panels) {
+        if (panel.getAttribute('aria-labelledby') === selected.id) {
+          panel.removeAttribute('hidden');
+        } else {
+          panel.setAttribute('hidden', 'until-found');
+        }
+      }
+      revealTab(selected, reducedMotion.matches ? 'instant' : 'smooth');
+    }
+
+    for (const tab of tabs) {
+      tab.addEventListener('click', () => selectTab(tab));
+      // Selection follows native focusgroup arrow-key navigation.
+      tab.addEventListener('focus', () => selectTab(tab));
+    }
+
+    for (const panel of panels) {
+      // Browser find-in-page can reveal a drink in an inactive category.
+      panel.addEventListener('beforematch', () => {
+        selectTab(document.getElementById(panel.getAttribute('aria-labelledby')));
+      });
+    }
+
+    // Preserve visibility of the current category after viewport or font changes.
+    new ResizeObserver(() => {
+      revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'));
+    }).observe(tablist);
+  </script>
