+  <script>
+    (() => {
+      const menu = document.getElementById('coffee-menu');
+      const tablist = menu.querySelector('[role="tablist"]');
+      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+      const panels = tabs.map(tab => document.getElementById(tab.id.replace('tab-', 'panel-')));
+      const scrollerWindow = menu.querySelector('.menu-tabs-window');
+      const scrollButtons = [...menu.querySelectorAll('.menu-scroll')];
+      const hint = menu.querySelector('.menu-hint');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const behavior = () => reducedMotion.matches ? 'instant' : 'smooth';
+
+      // Scroll only the tablist, including in browsers without scrollIntoView's container option.
+      function revealTab(tab, smooth = true) {
+        const listBounds = tablist.getBoundingClientRect();
+        const bounds = tab.getBoundingClientRect();
+        const padding = 20;
+        const delta = bounds.left < listBounds.left + padding
+          ? bounds.left - listBounds.left - padding
+          : bounds.right > listBounds.right - padding
+            ? bounds.right - listBounds.right + padding : 0;
+        if (delta) tablist.scrollBy({ left: delta, behavior: smooth ? behavior() : 'instant' });
+      }
+
+      function selectTab(tab) {
+        tabs.forEach((item, index) => {
+          const selected = item === tab;
+          item.setAttribute('aria-selected', String(selected));
+          item.tabIndex = selected ? 0 : -1;
+          if (selected) panels[index].removeAttribute('hidden');
+          else panels[index].setAttribute('hidden', 'until-found');
+        });
+        revealTab(tab);
+      }
+
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(tab));
+        tab.addEventListener('focus', () => selectTab(tab));
+        panels[index].addEventListener('beforematch', () => selectTab(tab));
+      });
+
+      // Roving tabindex supplies the tab pattern across browsers without native focusgroup.
+      tablist.addEventListener('keydown', event => {
+        const index = tabs.indexOf(document.activeElement);
+        if (index < 0 || event.altKey || event.ctrlKey || event.metaKey) return;
+        let next;
+        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = tabs.length - 1;
+        else return;
+        event.preventDefault();
+        tabs[next].focus({ preventScroll: true });
+      });
+
+      function updateOverflow() {
+        // Compare against the full bar so the controls disappear as soon as all tabs fit.
+        const overflows = tablist.scrollWidth > menu.querySelector('.menu-tabs-bar').clientWidth + 1;
+        scrollButtons.forEach(button => { button.hidden = !overflows; });
+        hint.hidden = !overflows;
+        const maxScroll = tablist.scrollWidth - tablist.clientWidth;
+        const atStart = tablist.scrollLeft <= 1;
+        const atEnd = tablist.scrollLeft >= maxScroll - 1;
+        scrollButtons[0].setAttribute('aria-disabled', String(atStart));
+        scrollButtons[1].setAttribute('aria-disabled', String(atEnd));
+        scrollerWindow.classList.toggle('more-start', overflows && !atStart);
+        scrollerWindow.classList.toggle('more-end', overflows && !atEnd);
+      }
+
+      scrollButtons.forEach(button => button.addEventListener('click', () => {
+        if (button.getAttribute('aria-disabled') === 'true') return;
+        tablist.scrollBy({
+          left: Number(button.dataset.direction) * Math.max(100, tablist.clientWidth * .7),
+          behavior: behavior()
+        });
+      }));
+      tablist.addEventListener('scroll', updateOverflow, { passive: true });
+      const resizeObserver = new ResizeObserver(() => {
+        updateOverflow();
+        revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'), false);
+      });
+      resizeObserver.observe(tablist);
+      tabs.forEach(tab => resizeObserver.observe(tab));
+      updateOverflow();
+    })();
+  </script>
+
