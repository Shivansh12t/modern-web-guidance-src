@@ -0,0 +1,151 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const POLICY = [
+  "default-src 'none'",
+  "script-src 'none' 'report-sample'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  'img-src https://images.unsplash.com',
+  "connect-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  "form-action 'self'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+  'report-to default',
+  'report-uri /security-reports',
+].join('; ');
+const BASELINE = "object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'";
+const DIRECTIVES = new Set(['default-src', 'script-src', 'script-src-elem', 'script-src-attr',
+  'style-src', 'style-src-elem', 'style-src-attr', 'img-src', 'connect-src', 'object-src',
+  'base-uri', 'frame-ancestors', 'form-action', 'require-trusted-types-for', 'trusted-types']);
+
+function createHandler({ publicOrigin = 'http://localhost:11222', policyMode = 'enforce',
+  logReport = (report) => console.info(JSON.stringify(report)) } = {}) {
+  const origin = new URL(publicOrigin);
+  if (!['http:', 'https:'].includes(origin.protocol) || origin.username || origin.password ||
+      origin.pathname !== '/' || origin.search || origin.hash) {
+    throw new Error('PUBLIC_ORIGIN must be an HTTP(S) origin without credentials, path, query, or fragment');
+  }
+  if (!['enforce', 'report-only'].includes(policyMode)) throw new Error('Invalid SECURITY_POLICY_MODE');
+  const secure = origin.protocol === 'https:';
+  // Exact asset mapping prevents traversal and disclosure of source/configuration files.
+  const assets = new Map([
+    ['/styles.css', ['text/css; charset=utf-8', fs.readFileSync(path.join(__dirname, 'styles.css'))]],
+  ]);
+  const home = fs.readFileSync(path.join(__dirname, 'index.html'));
+  const pages = new Set(['/', '/index.html', '/menu', '/locations', '/rewards', '/account',
+    '/order-online', '/menu/seasonal', '/menu/espresso', '/menu/cold-brew', '/about',
+    '/careers', '/contact', '/privacy-policy']);
+
+  function logoutPage(done) {
+    return `<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${done ? 'Signed out' : 'Sign out'} | The Daily Grind</title><link rel="stylesheet" href="/styles.css"></head><body><main class="container logout-page"><h1>${done ? 'You’re signed out' : 'Sign out of The Daily Grind'}</h1>${done ? '<p>Your sign-out request is complete.</p>' : '<form action="/logout" method="post"><button class="btn" type="submit">Logout</button></form>'}<p><a href="/">Return to The Daily Grind</a></p></main></body></html>`;
+  }
+
+  return async function handle(req, res) {
+    res.setHeader('Cache-Control', 'no-store');
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('X-Frame-Options', 'DENY');
+    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+    res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), focus-without-user-activation=()');
+    res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+    res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+    res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+    res.setHeader('Reporting-Endpoints', `default="${origin.origin}/security-reports"`);
+    res.setHeader('Content-Security-Policy', policyMode === 'enforce' ? POLICY : BASELINE);
+    if (policyMode === 'report-only') res.setHeader('Content-Security-Policy-Report-Only', POLICY);
+    // Short initial rollout; do not assume all subdomains are HTTPS-ready.
+    if (secure) res.setHeader('Strict-Transport-Security', 'max-age=300');
+
+    function send(status, body = '', type = 'text/plain; charset=utf-8') {
+      res.statusCode = status;
+      if (status !== 204) res.setHeader('Content-Type', type);
+      res.end(req.method === 'HEAD' ? undefined : body);
+    }
+    let pathname;
+    try {
+      if (!req.url.startsWith('/') || req.url.startsWith('//')) return send(400, 'Bad request');
+      pathname = new URL(req.url, origin).pathname;
+    } catch { return send(400, 'Bad request'); }
+
+    // Permit inbound links, but reject cross-site subresource reads and mutations.
+    const site = req.headers['sec-fetch-site'];
+    if (site && !['same-origin', 'none'].includes(site)) {
+      const navigation = ['GET', 'HEAD'].includes(req.method) &&
+        req.headers['sec-fetch-mode'] === 'navigate' && req.headers['sec-fetch-dest'] === 'document';
+      if (!navigation) return send(403, 'Forbidden');
+    }
+
+    if (pathname === '/security-reports') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return send(405, 'Method not allowed');
+      }
+      const type = (req.headers['content-type'] || '').split(';')[0].trim();
+      if (!['application/csp-report', 'application/reports+json', 'application/json'].includes(type)) {
+        return send(415, 'Unsupported media type');
+      }
+      // Never persist raw reports: URLs, script samples and arbitrary fields can contain secrets.
+      let size = 0;
+      const chunks = [];
+      try {
+        for await (const chunk of req) {
+          size += Buffer.byteLength(chunk);
+          if (size > 16384) return send(413, 'Report too large');
+          chunks.push(Buffer.from(chunk));
+        }
+      } catch { return send(400, 'Invalid report'); }
+      let reports;
+      try { reports = JSON.parse(Buffer.concat(chunks).toString('utf8')); }
+      catch { return send(400, 'Invalid JSON'); }
+      const batch = Array.isArray(reports) ? reports : [reports];
+      if (batch.length > 20) return send(413, 'Too many reports');
+      const counts = new Map();
+      for (const report of batch) {
+        const body = report?.['csp-report'] || (report?.type === 'csp-violation' ? report.body : null);
+        const directive = body?.['effective-directive'] || body?.effectiveDirective;
+        if (!DIRECTIVES.has(directive)) continue;
+        counts.set(directive, (counts.get(directive) || 0) + 1);
+      }
+      for (const [directive, count] of counts) logReport({ type: 'csp-violation', directive, count });
+      return send(204);
+    }
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      if (req.method === 'POST') {
+        // Origin protects older clients without Fetch Metadata; never trust Host/X-Forwarded-*.
+        if (req.headers.origin !== origin.origin) return send(403, 'Forbidden');
+        res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+        // Explicit expiration also handles clients without Clear-Site-Data support.
+        const cookies = new Set(['session', '__Host-session']);
+        for (const cookie of (req.headers.cookie || '').split(';')) {
+          const name = cookie.split('=')[0].trim();
+          if (/^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/.test(name)) cookies.add(name);
+        }
+        res.setHeader('Set-Cookie', [...cookies].map(name =>
+          `${name}=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Path=/; HttpOnly; SameSite=Lax${secure || name.startsWith('__Host-') || name.startsWith('__Secure-') ? '; Secure' : ''}`));
+        return send(200, logoutPage(true), 'text/html; charset=utf-8');
+      }
+      if (['GET', 'HEAD'].includes(req.method)) return send(200, logoutPage(false), 'text/html; charset=utf-8');
+      res.setHeader('Allow', 'GET, HEAD, POST');
+      return send(405, 'Method not allowed');
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return send(405, 'Method not allowed');
+    }
+    if (assets.has(pathname)) {
+      const [type, body] = assets.get(pathname);
+      return send(200, body, type);
+    }
+    if (pages.has(pathname)) return send(200, home, 'text/html; charset=utf-8');
+    return send(404, 'Not found');
+  };
+}
+
+module.exports = { createHandler };
