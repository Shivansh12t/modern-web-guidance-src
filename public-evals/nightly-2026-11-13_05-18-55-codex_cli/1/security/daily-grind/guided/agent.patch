diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..e194f8f
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,105 @@
+'use strict';
+
+// These tests invoke only the pure request handler: no listeners or entrypoint imports.
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const fs = require('node:fs');
+const path = require('node:path');
+const { createHandler } = require('../app');
+
+const origin = 'https://coffee.example';
+async function request(handler, url, { method = 'GET', headers = {}, body = '' } = {}) {
+  const req = Readable.from(body ? [Buffer.from(body)] : []);
+  Object.assign(req, { url, method, headers });
+  const result = { statusCode: 200, headers: {}, body: '' };
+  const res = {
+    setHeader(name, value) { result.headers[name.toLowerCase()] = value; },
+    set statusCode(value) { result.statusCode = value; },
+    end(value) { result.body = value?.toString() || ''; },
+  };
+  await handler(req, res);
+  return result;
+}
+const handler = createHandler({ publicOrigin: origin, logReport() {} });
+
+test('documents, assets, errors, and HEAD carry restrictive headers', async () => {
+  for (const url of ['/', '/styles.css', '/server.js', '/package.json', '/logout']) {
+    const result = await request(handler, url);
+    assert.match(result.headers['content-security-policy'], /require-trusted-types-for 'script'/);
+    assert.match(result.headers['content-security-policy'], /script-src 'none'/);
+    assert.equal(result.headers['x-content-type-options'], 'nosniff');
+    assert.equal(result.headers['x-frame-options'], 'DENY');
+    assert.equal(result.headers['cache-control'], 'no-store');
+    assert.equal(result.headers['strict-transport-security'], 'max-age=300');
+  }
+  assert.equal((await request(handler, '/server.js')).statusCode, 404);
+  assert.equal((await request(handler, '/styles.css')).headers['content-type'], 'text/css; charset=utf-8');
+  assert.equal((await request(handler, '/', { method: 'HEAD' })).body, '');
+  assert.equal((await request(handler, '/')).headers['reporting-endpoints'], `default="${origin}/security-reports"`);
+});
+
+test('logout GET is safe; same-origin POST clears all browser data categories and cookies', async () => {
+  const get = await request(handler, '/logout');
+  assert.equal(get.headers['clear-site-data'], undefined);
+  assert.match(get.body, /method="post"/);
+  const result = await request(handler, '/logout/', {
+    method: 'POST', headers: { origin, 'sec-fetch-site': 'same-origin', cookie: 'session=secret; preference=yes' },
+  });
+  assert.equal(result.statusCode, 200);
+  assert.equal(result.headers['clear-site-data'], '"cookies", "storage", "cache"');
+  for (const name of ['session', '__Host-session', 'preference']) {
+    assert.ok(result.headers['set-cookie'].some(cookie => cookie.startsWith(`${name}=`) && cookie.includes('Max-Age=0') && cookie.includes('Secure')));
+  }
+  assert.doesNotMatch(result.body, /secret/);
+});
+
+test('logout rejects forged, missing and cross-site origins without clearing state', async () => {
+  for (const headers of [{}, { origin: 'https://attacker.example' }, { origin, 'sec-fetch-site': 'cross-site' }, { origin: 'null' }]) {
+    const result = await request(handler, '/logout', { method: 'POST', headers });
+    assert.equal(result.statusCode, 403);
+    assert.equal(result.headers['clear-site-data'], undefined);
+    assert.equal(result.headers['set-cookie'], undefined);
+  }
+});
+
+test('resource isolation permits inbound navigation but denies foreign subresources', async () => {
+  assert.equal((await request(handler, '/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } })).statusCode, 200);
+  assert.equal((await request(handler, '/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'no-cors', 'sec-fetch-dest': 'image' } })).statusCode, 403);
+  assert.equal((await request(handler, '//attacker.example')).statusCode, 400);
+  assert.equal((await request(handler, '/', { method: 'PUT' })).statusCode, 405);
+});
+
+test('report-only rollout keeps baseline protection; HTTP does not enable HSTS', async () => {
+  const result = await request(createHandler({ policyMode: 'report-only' }), '/');
+  assert.match(result.headers['content-security-policy'], /frame-ancestors 'none'/);
+  assert.match(result.headers['content-security-policy-report-only'], /require-trusted-types-for/);
+  assert.equal(result.headers['strict-transport-security'], undefined);
+  assert.throws(() => createHandler({ policyMode: 'disabled' }));
+  assert.throws(() => createHandler({ publicOrigin: 'https://user:pass@coffee.example' }));
+});
+
+test('report collector accepts both formats without retaining secrets', async () => {
+  const logs = [];
+  const collect = createHandler({ publicOrigin: origin, logReport: report => logs.push(report) });
+  for (const report of [
+    { 'csp-report': { 'effective-directive': 'script-src-elem', 'document-uri': `${origin}/?token=SECRET`, 'script-sample': 'SECRET' } },
+    [{ type: 'csp-violation', url: `${origin}/SECRET`, body: { effectiveDirective: 'script-src-elem', sample: 'SECRET' } }],
+  ]) {
+    const result = await request(collect, '/security-reports', { method: 'POST', headers: { 'content-type': 'application/reports+json' }, body: JSON.stringify(report) });
+    assert.equal(result.statusCode, 204);
+  }
+  assert.equal(logs.length, 2);
+  assert.deepEqual(logs[0], { type: 'csp-violation', directive: 'script-src-elem', count: 1 });
+  assert.doesNotMatch(JSON.stringify(logs), /SECRET/);
+  assert.equal((await request(collect, '/security-reports', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{' })).statusCode, 400);
+  assert.equal((await request(collect, '/security-reports', { method: 'POST', headers: { 'content-type': 'application/json' }, body: 'x'.repeat(16385) })).statusCode, 413);
+  assert.equal((await request(collect, '/security-reports', { method: 'POST', headers: { 'content-type': 'text/plain' } })).statusCode, 415);
+});
+
+test('HTML has no executable or inline-style dependencies blocked by the policy', () => {
+  const html = fs.readFileSync(path.join(__dirname, '../index.html'), 'utf8');
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  assert.match(html, /<form action="\/logout" method="post">/);
+  assert.match(html, /href="\/styles.css"/);
+});
