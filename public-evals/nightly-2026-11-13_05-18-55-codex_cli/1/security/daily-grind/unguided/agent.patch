@@ -0,0 +1,150 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+
+// Set this when HTTPS terminates at a reverse proxy. Never trust forwarded
+// protocol headers from arbitrary clients to decide the deployment origin.
+const publicOrigin = process.env.PUBLIC_ORIGIN
+  ? new URL(process.env.PUBLIC_ORIGIN).origin
+  : null;
+if (publicOrigin && !/^https?:\/\//.test(publicOrigin)) {
+  throw new Error('PUBLIC_ORIGIN must be an HTTP or HTTPS origin');
+}
+
+// No executable scripts are needed. Keep future DOM injection sinks closed too.
+const securityHeaders = {
+  'Content-Security-Policy': [
+    "default-src 'none'",
+    "script-src 'none'",
+    "script-src-attr 'none'",
+    "style-src 'self'",
+    "style-src-attr 'none'",
+    "img-src 'self' https://images.unsplash.com",
+    "base-uri 'none'",
+    "object-src 'none'",
+    "frame-ancestors 'none'",
+    "form-action 'self'",
+    "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+  ].join('; '),
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Referrer-Policy': 'no-referrer',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cache-Control': 'no-store',
+  ...(publicOrigin?.startsWith('https://') ? {
+    'Strict-Transport-Security': 'max-age=31536000',
+  } : {}),
+};
+
+// An explicit asset list prevents traversal and exposure of repository files.
+const assets = new Map([
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+]);
+// Preserve existing navigation until these pages have their own content.
+const pages = new Set([
+  '/', '/index.html', '/menu', '/locations', '/rewards', '/account',
+  '/order-online', '/menu/seasonal', '/menu/espresso', '/menu/cold-brew',
+  '/about', '/careers', '/contact', '/privacy-policy',
+]);
+
+function send(req, res, status, body, type = 'text/html; charset=utf-8', headers = {}) {
+  res.writeHead(status, {
+    ...securityHeaders,
+    'Content-Type': type,
+    ...headers,
+  });
+  res.end(req.method === 'HEAD' ? undefined : body);
+}
+
+function logoutPage(message, confirmation = false) {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Logout | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container logout-page">
+    <h1>${message}</h1>
+    ${confirmation ? '<form action="/logout" method="post"><button class="btn" type="submit">Logout</button></form>' : '<p>Your browser has been asked to clear this site’s saved data.</p>'}
+    <a href="/" class="btn">Back to The Daily Grind</a>
+  </main>
+</body>
+</html>`;
+}
+
+async function handleRequest(req, res) {
+  try {
+    // Use a fixed base rather than untrusted Host data to construct resource URLs.
+    const url = new URL(req.url, 'http://localhost');
+    const pathname = url.pathname;
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      if (req.method === 'GET' || req.method === 'HEAD') {
+        send(req, res, 200, logoutPage('Sign out of The Daily Grind?', true));
+        return;
+      }
+      if (req.method !== 'POST') {
+        send(req, res, 405, 'Method not allowed', 'text/plain; charset=utf-8', {
+          Allow: 'GET, HEAD, POST',
+        });
+        return;
+      }
+
+      // Native form POSTs work without JS. Reject cross-origin logout requests.
+      const fetchSite = req.headers['sec-fetch-site'];
+      const origin = req.headers.origin;
+      const expectedOrigin = publicOrigin ||
+        `${req.socket.encrypted ? 'https' : 'http'}://${req.headers.host}`;
+      if ((fetchSite && fetchSite !== 'same-origin' && fetchSite !== 'none') ||
+          (origin && new URL(origin).origin !== expectedOrigin)) {
+        send(req, res, 403, 'Forbidden', 'text/plain; charset=utf-8');
+        return;
+      }
+
+      // No server-side session store exists here. Expire request cookies;
+      // Clear-Site-Data also clears browser storage and caches over HTTPS.
+      const cookieNames = [...new Set((req.headers.cookie || '').split(';')
+        .map(cookie => cookie.trim().split('=')[0])
+        .filter(name => /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(name)))];
+      const expiredCookies = cookieNames.map(name =>
+        `${name}=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; SameSite=Lax${name.startsWith('__Secure-') || name.startsWith('__Host-') || req.socket.encrypted ? '; Secure' : ''}`);
+      send(req, res, 200, logoutPage('You’ve been signed out.'), undefined, {
+        'Clear-Site-Data': '"cache", "cookies", "storage", "prefetchCache", "prerenderCache"',
+        ...(expiredCookies.length ? { 'Set-Cookie': expiredCookies } : {}),
+      });
+      return;
+    }
+
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      send(req, res, 405, 'Method not allowed', 'text/plain; charset=utf-8', {
+        Allow: 'GET, HEAD',
+      });
+      return;
+    }
+
+    const asset = assets.get(pathname);
+    if (!asset && !pages.has(pathname)) {
+      send(req, res, 404, 'Not found', 'text/plain; charset=utf-8');
+      return;
+    }
+    const [filename, type] = asset || ['index.html', 'text/html; charset=utf-8'];
+    const body = await fs.readFile(path.join(__dirname, filename));
+    send(req, res, 200, body, type);
+  } catch (error) {
+    if (error instanceof TypeError) {
+      send(req, res, 400, 'Bad request', 'text/plain; charset=utf-8');
+      return;
+    }
+    console.error('Request failed:', error.code || error.name);
+    send(req, res, 500, 'Server error', 'text/plain; charset=utf-8');
+  }
+}
+
+module.exports = { handleRequest };
