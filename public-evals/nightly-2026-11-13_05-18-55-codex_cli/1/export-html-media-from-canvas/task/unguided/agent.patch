+  <script src="vendor/html2canvas.min.js"></script>
+  <script>
+    const giftCard = document.getElementById('export_element');
+    const recipient = document.getElementById('recipient');
+    const message = document.getElementById('gift-message');
+    const color = document.getElementById('card-color');
+    const canvas = document.getElementById('gift-canvas');
+    const status = document.getElementById('export-status');
+    const renderButton = document.getElementById('render-card');
+    const exportButton = document.getElementById('export-card');
+    const swatches = document.querySelectorAll('.color-choice');
+    let previewTimer;
+    let renderQueue = Promise.resolve();
+
+    function updateCard() {
+      document.getElementById('card-recipient').textContent = recipient.value.trim() ? 'For ' + recipient.value.trim() : 'For someone special';
+      document.getElementById('card-message').textContent = message.value.trim() || 'A little pick-me-up, just for you.';
+      giftCard.style.backgroundColor = color.value;
+      // Choose the higher-contrast text color, including for custom backgrounds.
+      const rgb = color.value.match(/[a-f\d]{2}/gi).map(value => {
+        const channel = parseInt(value, 16) / 255;
+        return channel <= 0.04045 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4);
+      });
+      const luminance = rgb[0] * 0.2126 + rgb[1] * 0.7152 + rgb[2] * 0.0722;
+      giftCard.style.color = luminance > 0.179 ? '#241b17' : '#ffffff';
+      swatches.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.color === color.value)));
+      status.textContent = 'Updating preview…';
+      clearTimeout(previewTimer);
+      previewTimer = setTimeout(() => renderPreview().catch(showError), 250);
+    }
+
+    function showError() {
+      status.textContent = 'Could not render the card. Please try rendering again.';
+    }
+
+    function renderPreview() {
+      clearTimeout(previewTimer);
+      // Serialize captures so rapid edits cannot leave an older image on the canvas.
+      renderQueue = renderQueue.catch(() => {}).then(async () => {
+        const rendered = await html2canvas(giftCard, {
+          scale: 2,
+          backgroundColor: null,
+          logging: false,
+          onclone: clonedDocument => {
+            clonedDocument.getElementById('export_element').style.boxShadow = 'none';
+          }
+        });
+        canvas.width = rendered.width;
+        canvas.height = rendered.height;
+        canvas.getContext('2d').drawImage(rendered, 0, 0);
+        status.textContent = 'Ready to download · PNG';
+      });
+      return renderQueue;
+    }
+
+    recipient.addEventListener('input', updateCard);
+    message.addEventListener('input', updateCard);
+    color.addEventListener('input', updateCard);
+    swatches.forEach(button => button.addEventListener('click', () => {
+      color.value = button.dataset.color;
+      updateCard();
+    }));
+    renderButton.addEventListener('click', () => renderPreview().catch(showError));
+    exportButton.addEventListener('click', async () => {
+      exportButton.disabled = true;
+      renderButton.disabled = true;
+      exportButton.textContent = 'Preparing image…';
+      try {
+        // Always capture the current HTML before exporting, even during a pending edit.
+        await renderPreview();
+        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+        if (!blob) throw new Error('Image encoding failed');
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement('a');
+        link.href = url;
+        link.download = 'daily-grind-gift-card.png';
+        document.body.appendChild(link);
+        link.click();
+        link.remove();
+        setTimeout(() => URL.revokeObjectURL(url), 10000);
+        status.textContent = 'Your gift card image is ready. Enjoy sharing!';
+      } catch (error) {
+        showError();
+      } finally {
+        exportButton.disabled = false;
+        renderButton.disabled = false;
+        exportButton.textContent = 'Download gift card ↓';
+      }
+    });
+    let previousWidth = 0;
+    new ResizeObserver(entries => {
+      const width = entries[0].contentRect.width;
+      if (width !== previousWidth) {
+        previousWidth = width;
+        clearTimeout(previewTimer);
+        previewTimer = setTimeout(() => renderPreview().catch(showError), 250);
+      }
+    }).observe(giftCard);
+    updateCard();
+  </script>
 </body>
 
