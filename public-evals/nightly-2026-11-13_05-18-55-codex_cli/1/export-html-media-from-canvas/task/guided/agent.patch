+  <script src="vendor/html2canvas.min.js"></script>
+  <script>
+    (() => {
+      const message = document.getElementById('gift-message');
+      const color = document.getElementById('gift-color');
+      const colorValue = document.getElementById('gift-color-value');
+      const card = document.getElementById('export_element');
+      const cardMessage = document.getElementById('gift-card-message');
+      const source = document.querySelector('.gift-source');
+      const canvas = document.getElementById('gift-canvas');
+      const button = document.getElementById('gift-export');
+      const status = document.getElementById('gift-status');
+      const context = canvas.getContext('2d');
+      let nativeRendering = Boolean(context && 'content' in HTMLCanvasElement.prototype &&
+        typeof context.drawElementImage === 'function' && typeof canvas.requestPaint === 'function');
+      let pending = Promise.resolve();
+      let revision = 0;
+      let timer;
+      let exporting = false;
+
+      if (nativeRendering) canvas.append(card);
+
+      function updateCard() {
+        cardMessage.textContent = message.value || 'A little coffee, just for you.';
+        card.style.backgroundColor = color.value;
+        colorValue.value = color.value;
+        // Pick the foreground with the higher WCAG contrast for any chosen color.
+        const channels = color.value.match(/[a-f\d]{2}/gi).map(hex => {
+          const channel = parseInt(hex, 16) / 255;
+          return channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
+        });
+        const luminance = channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722;
+        card.style.color = luminance > 0.179 ? '#000000' : '#ffffff';
+        canvas.setAttribute('aria-label', `Coffee gift card: ${cardMessage.textContent}. Background ${color.value}.`);
+      }
+
+      async function paint() {
+        if (!context) throw new Error('Canvas is unavailable.');
+        const scale = Math.max(2, window.devicePixelRatio || 1);
+        canvas.width = Math.round(canvas.clientWidth * scale);
+        canvas.height = Math.round(canvas.width * 0.6);
+        if (nativeRendering) {
+          try {
+            await new Promise((resolve, reject) => {
+              const timeout = setTimeout(() => reject(new Error('Paint timed out.')), 1500);
+              canvas.onpaint = () => {
+                clearTimeout(timeout);
+                try {
+                  context.setTransform(canvas.width / 600, 0, 0, canvas.height / 360, 0, 0);
+                  context.clearRect(0, 0, 600, 360);
+                  context.drawElementImage(card, 0, 0);
+                  resolve();
+                } catch (error) { reject(error); }
+              };
+              canvas.requestPaint();
+            });
+            return;
+          } catch {
+            nativeRendering = false;
+            canvas.onpaint = null;
+            source.append(card);
+          }
+        }
+        if (typeof html2canvas !== 'function') throw new Error('Renderer is unavailable.');
+        const snapshot = await html2canvas(card, {
+          backgroundColor: null,
+          scale: canvas.width / 600,
+          width: 600,
+          height: 360,
+          logging: false
+        });
+        context.setTransform(1, 0, 0, 1, 0, 0);
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        context.drawImage(snapshot, 0, 0, canvas.width, canvas.height);
+      }
+
+      function render() {
+        const current = ++revision;
+        button.disabled = true;
+        pending = pending.catch(() => {}).then(async () => {
+          if (current !== revision) return;
+          updateCard();
+          await document.fonts.ready;
+          await paint();
+          if (current === revision && !exporting) {
+            button.disabled = false;
+            status.textContent = 'Your card is ready to share.';
+          }
+        });
+        pending.catch(() => {
+          status.textContent = 'Could not render your card. Refresh the page to try again.';
+        });
+        return pending;
+      }
+
+      function scheduleRender() {
+        clearTimeout(timer);
+        button.disabled = true;
+        status.textContent = 'Updating your preview…';
+        timer = setTimeout(render, 120);
+      }
+
+      message.addEventListener('input', scheduleRender);
+      color.addEventListener('input', scheduleRender);
+      new ResizeObserver(scheduleRender).observe(canvas);
+
+      button.addEventListener('click', async () => {
+        exporting = true;
+        message.disabled = true;
+        color.disabled = true;
+        clearTimeout(timer);
+        status.textContent = 'Preparing your PNG…';
+        try {
+          await render();
+          const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('PNG export failed.');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          document.body.append(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 60000);
+          status.textContent = 'Your PNG has been downloaded. Share a little happiness!';
+        } catch {
+          status.textContent = 'Could not export your card. Please try again.';
+        } finally {
+          exporting = false;
+          message.disabled = false;
+          color.disabled = false;
+          button.disabled = false;
+        }
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
