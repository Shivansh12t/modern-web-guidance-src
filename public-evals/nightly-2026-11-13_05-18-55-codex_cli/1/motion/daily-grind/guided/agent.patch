+  <script>
+    // Newer browsers expose the exact Animation, including pseudo-element effects.
+    // Older browsers still record lifecycle state without guessing an animation by name.
+    const eventStates = {
+      animationstart: 'running', animationiteration: 'running',
+      animationend: 'finished', animationcancel: 'idle',
+      transitionrun: 'running', transitionstart: 'running',
+      transitionend: 'finished', transitioncancel: 'idle'
+    };
+    for (const type of Object.keys(eventStates)) {
+      document.addEventListener(type, (event) => {
+        const animation = event.animation;
+        document.body.dataset.lastAnimationState = animation?.playState ?? eventStates[event.type];
+      });
+    }
+
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const banner = document.querySelector('.roast-banner');
+    const pauseButton = document.querySelector('.roast-control');
+    let userPaused = false;
+    function updateBanner() {
+      const reduced = motionPreference.matches;
+      banner.dataset.paused = String(userPaused || reduced);
+      pauseButton.disabled = reduced;
+      pauseButton.textContent = reduced ? 'Motion off' : userPaused ? 'Resume' : 'Pause';
+      pauseButton.setAttribute('aria-label', reduced ? 'Daily roast motion off: reduced-motion preference' : `${userPaused ? 'Resume' : 'Pause'} daily roast animation`);
+      document.body.dataset.lastAnimationState = reduced ? 'idle' : userPaused ? 'paused' : 'running';
+    }
+    pauseButton.addEventListener('click', () => {
+      userPaused = !userPaused;
+      updateBanner();
+    });
+    motionPreference.addEventListener('change', updateBanner);
+    updateBanner();
+
+    const drinks = {
+      maple: {
+        title: 'Maple Oat Latte',
+        description: 'A cozy blend of espresso and creamy oat milk, lightly sweetened with Vermont maple syrup.',
+        notes: 'Maple sweetness, mellow espresso, velvety finish.',
+        ingredients: 'Espresso, oat milk, Vermont maple syrup.'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'Our bold dark roast, pulled as a rich espresso with a smoky finish. A little cup with plenty of character.',
+        notes: 'Bold, smoky, full-bodied.',
+        ingredients: 'Freshly ground dark-roast coffee, water.'
+      },
+      cold: {
+        title: 'Cold Brew',
+        description: 'Slow-steeped for 18 hours for a smooth, refreshing cup. Served over ice for an easygoing pick-me-up.',
+        notes: 'Smooth, rounded, refreshing.',
+        ingredients: 'Cold-steeped coffee, water, ice.'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+    document.querySelectorAll('[data-drink]').forEach((button) => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        document.querySelector('#drink-ingredients').textContent = drink.ingredients;
+        dialog.showModal();
+      });
+    });
+
+    async function closeDetails() {
+      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+      // Keep the modal in the top layer until its fade settles, including in
+      // browsers that cannot transition discrete display or overlay on exit.
+      dialog.setAttribute('data-closing', '');
+      const animations = dialog.getAnimations({ subtree: true });
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map((animation) => animation.finished)),
+        new Promise((resolve) => { timeout = setTimeout(resolve, 500); })
+      ]);
+      clearTimeout(timeout);
+      dialog.close();
+      dialog.removeAttribute('data-closing');
+    }
+    document.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDetails();
+    });
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (event) => {
+        const rect = dialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (event) => { pressedOutside = outside(event); });
+      dialog.addEventListener('pointerup', (event) => {
+        if (pressedOutside && outside(event)) closeDetails();
+        pressedOutside = false;
+      });
+    }
+  </script>
