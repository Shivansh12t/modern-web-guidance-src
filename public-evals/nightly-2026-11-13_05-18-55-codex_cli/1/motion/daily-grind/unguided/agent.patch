+  <script>
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const track = document.querySelector('.roast-track');
+    const roastControl = document.querySelector('.roast-control');
+    const dialog = document.querySelector('#drink-details');
+    let roastPaused = false;
+    let openingButton = null;
+
+    // Standard CSS events expose names/properties, not an Animation instance.
+    // Inspect a directly supplied animation first, then resolve the native object.
+    function inspectMotionEvent(event) {
+      const animation = event.animation ?? event.target.getAnimations?.().find(candidate => {
+        const matches = event.type.startsWith('transition')
+          ? candidate.transitionProperty === event.propertyName
+          : candidate.animationName === event.animationName;
+        return matches && (candidate.effect?.pseudoElement || '') === (event.pseudoElement || '');
+      });
+      const completed = event.type.endsWith('end');
+      const canceled = event.type.endsWith('cancel');
+      document.body.dataset.lastAnimationState = canceled ? 'idle'
+        : completed ? 'finished' : (animation?.playState ?? 'running');
+    }
+
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, inspectMotionEvent, true);
+    }
+    document.body.dataset.lastAnimationState = 'idle';
+
+    function updateRoast() {
+      const reduced = motionPreference.matches;
+      track.classList.toggle('is-paused', roastPaused);
+      roastControl.disabled = reduced;
+      roastControl.textContent = reduced ? 'Motion off' : roastPaused ? 'Resume' : 'Pause';
+      roastControl.setAttribute('aria-label', reduced ? 'Daily roast animation disabled by reduced-motion preference'
+        : `${roastPaused ? 'Resume' : 'Pause'} daily roast animation`);
+      const animation = track.getAnimations().find(item => item.animationName === 'daily-roast');
+      document.body.dataset.lastAnimationState = reduced ? 'idle' : animation?.playState ?? (roastPaused ? 'paused' : 'running');
+    }
+    roastControl.addEventListener('click', () => { roastPaused = !roastPaused; updateRoast(); });
+
+    const drinks = {
+      maple: { title: 'Maple Oat Latte', description: 'Rich espresso meets creamy oat milk and a hint of Vermont maple syrup. A cozy, gently sweet seasonal favorite.', notes: 'Maple, toasted oats, caramel', served: 'Hot or iced · Made with oat milk', url: '/menu/seasonal' },
+      espresso: { title: 'Dark Roast Espresso', description: 'A concentrated shot of our bold dark roast, crafted for a full-bodied sip and a lingering, smoky finish.', notes: 'Dark chocolate, toasted nuts, smoke', served: 'Hot · Espresso shot', url: '/menu/espresso' },
+      coldbrew: { title: 'Cold Brew', description: 'Slow-steeped for 18 hours to bring out a naturally smooth, mellow flavor. Poured over ice for an easygoing pick-me-up.', notes: 'Cocoa, soft sweetness, smooth finish', served: 'Iced · Add your favorite milk', url: '/menu/cold-brew' }
+    };
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        openingButton = button;
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        document.querySelector('#drink-served').textContent = drink.served;
+        document.querySelector('#drink-menu').href = drink.url;
+        dialog.classList.remove('is-closing');
+        dialog.showModal();
+      });
+    });
+
+    function finishClose() {
+      dialog.close();
+      dialog.classList.remove('is-closing');
+    }
+    function closeDetails() {
+      if (!dialog.open || dialog.classList.contains('is-closing')) return;
+      if (motionPreference.matches) finishClose();
+      else dialog.classList.add('is-closing');
+    }
+    dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => { event.preventDefault(); closeDetails(); });
+    let backdropPress = false;
+    const outsideDialog = event => {
+      const rect = dialog.getBoundingClientRect();
+      return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
+    };
+    dialog.addEventListener('pointerdown', event => { backdropPress = event.target === dialog && outsideDialog(event); });
+    dialog.addEventListener('click', event => { if (backdropPress && event.target === dialog && outsideDialog(event)) closeDetails(); backdropPress = false; });
+    dialog.addEventListener('animationend', event => {
+      if (event.target === dialog && !event.pseudoElement && event.animationName === 'dialog-out') finishClose();
+    });
+    dialog.addEventListener('close', () => { openingButton?.focus({ preventScroll: true }); });
+    motionPreference.addEventListener('change', () => {
+      updateRoast();
+      if (motionPreference.matches && dialog.classList.contains('is-closing')) finishClose();
+    });
+    updateRoast();
+  </script>
+
