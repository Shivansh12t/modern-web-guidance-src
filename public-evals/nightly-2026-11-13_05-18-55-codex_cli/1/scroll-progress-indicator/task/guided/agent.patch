+  <script>
+    (function () {
+      var progress = document.querySelector('.scroll-progress');
+      var motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
+      var supportsTimeline = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll(root)');
+      var scheduled = false;
+
+      function updateProgress() {
+        scheduled = false;
+        if (supportsTimeline && motionPreference.matches) {
+          progress.style.removeProperty('transform');
+          return;
+        }
+
+        // Direct position updates also preserve progress with reduced motion.
+        var root = document.scrollingElement || document.documentElement;
+        var scrollable = root.scrollHeight - document.documentElement.clientHeight;
+        var fraction = scrollable > 0 ? root.scrollTop / scrollable : 0;
+        progress.style.transform = 'scaleX(' + Math.min(1, Math.max(0, fraction)) + ')';
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      if (!supportsTimeline) {
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      } else {
+        window.addEventListener('scroll', function () {
+          if (!motionPreference.matches) scheduleUpdate();
+        }, { passive: true });
+      }
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (motionPreference.addEventListener) {
+        motionPreference.addEventListener('change', scheduleUpdate);
+      } else {
+        motionPreference.addListener(scheduleUpdate);
+      }
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleUpdate).observe(document.body);
+      }
+      updateProgress();
+    }());
+  </script>
