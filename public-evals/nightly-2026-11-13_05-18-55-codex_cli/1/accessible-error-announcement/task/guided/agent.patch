+  <script>
+    const newsletter = document.getElementById('newsletter');
+    const email = document.getElementById('newsletter-email');
+    const emailError = document.getElementById('newsletter-email-error');
+    const announcement = document.getElementById('newsletter-announcement');
+    let announceTimer;
+    let errorAnnounced = false;
+
+    function syncEmailError(announce = false) {
+      // Match the visual state, not raw validity (an untouched required field is invalid).
+      const showError = email.matches(':user-invalid');
+      email.setAttribute('aria-invalid', String(showError));
+
+      if (showError) {
+        // Hidden descriptions can still be read, so link the error only while visible.
+        email.setAttribute('aria-describedby', emailError.id);
+        if (announce && !errorAnnounced) {
+          errorAnnounced = true;
+          announceTimer = setTimeout(() => {
+            if (email.matches(':user-invalid')) {
+              announcement.textContent = emailError.textContent;
+            }
+          }, 500);
+        }
+      } else {
+        email.removeAttribute('aria-describedby');
+        clearTimeout(announceTimer);
+        announcement.textContent = '';
+        errorAnnounced = false;
+      }
+    }
+
+    function syncAfterInteraction() {
+      syncEmailError(true);
+      // Native interaction flags may settle after the event's default action.
+      requestAnimationFrame(() => syncEmailError(true));
+    }
+
+    email.addEventListener('blur', syncAfterInteraction);
+    email.addEventListener('change', syncAfterInteraction);
+    email.addEventListener('invalid', syncAfterInteraction);
+    email.addEventListener('input', () => syncEmailError());
+    newsletter.addEventListener('reset', () => {
+      setTimeout(() => syncEmailError(), 0);
+    });
+    syncEmailError();
+  </script>
+
 </body>
 
