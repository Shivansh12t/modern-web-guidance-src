+  <script type="module">
+    import { sampleEvents, measureEvents } from './events.mjs';
+
+    const button = document.getElementById('load-events');
+    const status = document.getElementById('timeline-status');
+    const rows = document.getElementById('event-rows');
+    const results = document.getElementById('timeline-results');
+    const number = new Intl.NumberFormat('en-US');
+
+    button.addEventListener('click', () => {
+      try {
+        const events = measureEvents(sampleEvents);
+        const fragment = document.createDocumentFragment();
+        for (const event of events) {
+          const row = document.createElement('tr');
+          const values = [event.name, event.service, event.timestamp,
+            event.intervalNs === null ? '—' : number.format(event.intervalNs)];
+          values.forEach((value, index) => {
+            const cell = document.createElement('td');
+            cell.textContent = value;
+            if (index === 2) cell.className = 'timestamp';
+            if (index === 3) cell.className = 'interval';
+            row.append(cell);
+          });
+          fragment.append(row);
+        }
+        rows.replaceChildren(fragment);
+        results.hidden = false;
+        const elapsed = events.at(-1).timestampNs - events[0].timestampNs;
+        status.textContent = `${events.length} sample events loaded from ${new Set(events.map(event => event.service)).size} services · Total elapsed: ${number.format(elapsed)} ns`;
+        button.textContent = 'Reload sample events';
+      } catch (error) {
+        results.hidden = true;
+        status.textContent = 'Unable to load events. Please try again.';
+      }
+    });
+  </script>
 </body>
 
