+(() => {
+  const host = document.getElementById('views');
+  const views = new Map([['home', document.getElementById('view-home')]]);
+  const names = { home: 'Artisanal Coffee', menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account' };
+  let current = null;
+
+  function mount(name) {
+    if (views.has(name)) return views.get(name);
+
+    // Clone each bounded route exactly once. Never replace or detach visited views.
+    const template = document.getElementById(`template-${name}`);
+    const view = template.content.firstElementChild.cloneNode(true);
+    host.append(view);
+    views.set(name, view);
+
+    if (name === 'menu') {
+      const search = view.querySelector('#menu-search');
+      const cards = [...view.querySelectorAll('#menu-items .card')];
+      search.addEventListener('input', () => {
+        const query = search.value.trim().toLowerCase();
+        cards.forEach(card => { card.hidden = !card.textContent.toLowerCase().includes(query); });
+        view.querySelector('#menu-empty').hidden = cards.some(card => !card.hidden);
+      });
+    }
+    return view;
+  }
+
+  function navigate({ initial = false } = {}) {
+    const route = location.hash.slice(1).replace(/\/$/, '') || '/';
+    const name = route === '/' ? 'home' : route.slice(1);
+    // Only the fixed set of views is cached; unknown hashes return to home.
+    const next = Object.hasOwn(names, name) ? name : 'home';
+    if (current === next) return;
+
+    const active = mount(next);
+    // Move focus out before making the previous view inaccessible.
+    active.classList.remove('inactive');
+    active.removeAttribute('inert');
+    active.removeAttribute('aria-hidden');
+    if (!initial) active.focus();
+
+    views.forEach((view, key) => {
+      if (key === next) return;
+      view.classList.add('inactive');
+      view.setAttribute('inert', '');
+      view.setAttribute('aria-hidden', 'true');
+    });
+
+    document.querySelectorAll('nav a').forEach(link => {
+      if (link.hash === (next === 'home' ? '#/' : `#/${next}`)) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    });
+    document.title = `The Daily Grind | ${names[next]}`;
+    current = next;
+    if (!initial) window.scrollTo(0, 0);
+  }
+
+  // Native hash links retain modified-click behavior and browser Back/Forward.
+  window.addEventListener('hashchange', () => navigate());
+  navigate({ initial: true });
+})();
