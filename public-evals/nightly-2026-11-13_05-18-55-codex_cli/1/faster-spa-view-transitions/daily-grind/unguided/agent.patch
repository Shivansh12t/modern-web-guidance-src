+(() => {
+  const host = document.getElementById('views');
+  const views = new Map([['home', host.querySelector('[data-view="home"]')]]);
+  const scrollPositions = new Map();
+  const routes = new Map([
+    ['/', 'home'], ['/menu', 'menu'], ['/locations', 'locations'],
+    ['/rewards', 'rewards'], ['/account', 'account'],
+  ]);
+  let activeView;
+  views.get('home').hidden = true;
+
+  function initializeView(name, view) {
+    if (name === 'menu') {
+      view.querySelector('#menu-category').addEventListener('change', (event) => {
+        for (const card of view.querySelectorAll('[data-category]')) {
+          card.hidden = event.target.value !== 'all' && card.dataset.category !== event.target.value;
+        }
+      });
+    }
+    if (name === 'locations') {
+      view.querySelector('#location-search').addEventListener('input', (event) => {
+        const query = event.target.value.trim().toLowerCase();
+        let matches = 0;
+        for (const card of view.querySelectorAll('[data-location]')) {
+          card.hidden = !card.dataset.location.includes(query);
+          if (!card.hidden) matches++;
+        }
+        view.querySelector('#location-empty').hidden = matches > 0;
+      });
+    }
+    if (name === 'account') {
+      view.querySelector('#account-form').addEventListener('submit', (event) => {
+        event.preventDefault();
+        view.querySelector('#account-status').textContent = 'Preferences saved for this visit.';
+      });
+    }
+  }
+
+  function render() {
+    const path = window.location.hash.slice(1) || '/';
+    const name = routes.get(path) || 'home';
+    if (activeView === name) return;
+
+    if (activeView) {
+      scrollPositions.set(activeView, window.scrollY);
+      views.get(activeView).hidden = true;
+    }
+
+    // Mount once per route. Hidden views remain connected, retaining their DOM,
+    // input values, expanded details, and event listeners for the next visit.
+    if (!views.has(name)) {
+      const template = document.getElementById(`view-${name}`);
+      const view = template.content.firstElementChild.cloneNode(true);
+      view.hidden = true;
+      host.append(view);
+      initializeView(name, view);
+      views.set(name, view);
+    }
+
+    views.get(name).hidden = false;
+    const isNavigation = activeView !== undefined;
+    activeView = name;
+    document.title = name === 'home'
+      ? 'The Daily Grind | Artisanal Coffee'
+      : `${name === 'account' ? 'My Account' : name[0].toUpperCase() + name.slice(1)} | The Daily Grind`;
+    for (const link of document.querySelectorAll('nav a')) {
+      if (link.getAttribute('href') === `#${path}` && routes.has(path)) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    }
+    if (isNavigation) {
+      const heading = views.get(name).querySelector('h1');
+      heading.setAttribute('tabindex', '-1');
+      heading.focus({ preventScroll: true });
+    }
+    window.scrollTo({ top: scrollPositions.get(name) || 0, behavior: 'instant' });
+  }
+
+  // Let the browser handle hash history, including Back/Forward and new tabs.
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', render);
+  render();
+})();
