diff --git a/src/scripts/section-navigation.ts b/src/scripts/section-navigation.ts
new file mode 100644
index 0000000..cf5e3fe
--- /dev/null
+++ b/src/scripts/section-navigation.ts
@@ -0,0 +1,61 @@
+// Section routes share one mounted shell. No fetching, parsing, or remounting on navigation.
+const shell = document.querySelector<HTMLElement>('[data-section-views]');
+if (shell) {
+    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
+    const routes = new Map([
+        [base || '/', 'top-news'],
+        [`${base}/world`, 'world'],
+        [`${base}/politics`, 'politics'],
+        [`${base}/multimedia`, 'multimedia'],
+        [`${base}/reports`, 'reports'],
+    ]);
+    const normalize = (path: string) => path.replace(/\/$/, '') || '/';
+    const viewFor = (url: URL) => url.origin === location.origin && !url.search
+        ? routes.get(normalize(url.pathname)) : undefined;
+    const panels = Array.from(shell.querySelectorAll<HTMLElement>('[data-section-view]'));
+    const positions = new Map<string, { x: number; y: number }>();
+    let current = panels.find(panel => !panel.hidden)!.dataset.sectionView!;
+    let revision = 0;
+    history.scrollRestoration = 'manual';
+
+    const updateLinks = () => {
+        document.querySelectorAll<HTMLAnchorElement>('a[data-section-link]').forEach(link => {
+            if (viewFor(new URL(link.href)) === current) link.setAttribute('aria-current', 'page');
+            else link.removeAttribute('aria-current');
+        });
+    };
+
+    const activate = (url: URL, push: boolean) => {
+        const next = viewFor(url);
+        if (!next) return;
+        positions.set(current, { x: window.scrollX, y: window.scrollY });
+        if (push) history.pushState({}, '', url);
+        current = next;
+        const active = panels.find(panel => panel.dataset.sectionView === next)!;
+        for (const panel of panels) panel.hidden = panel !== active;
+        document.title = next === 'top-news' ? 'The DevTools Times' : `${active.getAttribute('aria-label')} | The DevTools Times`;
+        updateLinks();
+        active.focus({ preventScroll: true });
+        const position = positions.get(next) ?? { x: 0, y: 0 };
+        const version = ++revision;
+        requestAnimationFrame(() => {
+            if (version !== revision) return;
+            const target = url.hash ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
+            if (target && active.contains(target)) target.scrollIntoView();
+            else window.scrollTo({ left: position.x, top: position.y, behavior: 'instant' });
+        });
+    };
+
+    document.addEventListener('click', event => {
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
+        if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self') || link.hasAttribute('data-astro-reload')) return;
+        const url = new URL(link.href);
+        if (!viewFor(url) || url.hash) return;
+        event.preventDefault();
+        if (url.pathname !== location.pathname || url.search !== location.search) activate(url, true);
+    });
+
+    window.addEventListener('popstate', () => activate(new URL(location.href), false));
+    updateLinks();
+}
