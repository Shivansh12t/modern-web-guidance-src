diff --git a/src/components/SectionViews.astro b/src/components/SectionViews.astro
new file mode 100644
index 0000000..fdcd1d0
--- /dev/null
+++ b/src/components/SectionViews.astro
@@ -0,0 +1,50 @@
+---
+import { getCollection } from 'astro:content';
+import TopNewsView from './TopNewsView.astro';
+import SimpleTeaserGrid from './SimpleTeaserGrid.astro';
+import TopStoryTeaserGrid from './TopStoryTeaserGrid.astro';
+
+interface Props {
+    active: 'top-news' | 'world' | 'politics' | 'multimedia' | 'reports';
+}
+const { active } = Astro.props;
+const articles = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+const multimedia = await getCollection('multimedia');
+const reports = await getCollection('reports');
+const base = import.meta.env.BASE_URL;
+---
+
+<!-- Keep panels connected: hiding a view preserves its islands and local DOM state. -->
+<div data-section-views>
+    <div data-section-view="top-news" hidden={active !== 'top-news'} tabindex="-1" aria-label="Top News">
+        <TopNewsView />
+    </div>
+    <div data-section-view="world" hidden={active !== 'world'} tabindex="-1" aria-label="World">
+        <SimpleTeaserGrid title="World" articles={articles.slice(8, 11)} />
+    </div>
+    <div data-section-view="politics" hidden={active !== 'politics'} tabindex="-1" aria-label="Politics">
+        <TopStoryTeaserGrid title="Politics" articles={articles.slice(11, 15)} />
+    </div>
+    <div data-section-view="multimedia" hidden={active !== 'multimedia'} tabindex="-1" aria-label="Multimedia">
+        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Multimedia</h1>
+            <div class="prose max-w-none">
+                <p>Watch our latest multimedia content.</p>
+                <ul>{multimedia.map(item => <li><a href={`${base}multimedia/${item.id}`}>{item.data.title}</a></li>)}</ul>
+            </div>
+        </div>
+    </div>
+    <div data-section-view="reports" hidden={active !== 'reports'} tabindex="-1" aria-label="Reports">
+        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Reports</h1>
+            <div class="prose max-w-none">
+                <p>Read our latest reports.</p>
+                <ul>{reports.map(report => <li><a href={`${base}reports/${report.id}`}>{report.data.title}</a></li>)}</ul>
+            </div>
+        </div>
+    </div>
+</div>
+
+<script>
+    import '../scripts/section-navigation';
+</script>
