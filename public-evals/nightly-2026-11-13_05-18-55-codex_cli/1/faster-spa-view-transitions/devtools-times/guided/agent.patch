diff --git a/src/scripts/section-navigation.ts b/src/scripts/section-navigation.ts
new file mode 100644
index 0000000..e61798f
--- /dev/null
+++ b/src/scripts/section-navigation.ts
@@ -0,0 +1,69 @@
+import { getSection, sections } from '../utils/sections';
+import type { SectionId } from '../utils/sections';
+
+const host = document.querySelector<HTMLElement>('[data-section-views]');
+
+if (host) {
+  const views = Array.from(host.querySelectorAll<HTMLElement>('[data-section-view]'));
+  const positions = new Map<SectionId, { x: number; y: number }>();
+  let activeSection = host.dataset.activeSection as SectionId;
+  const previousScrollRestoration = history.scrollRestoration;
+  history.scrollRestoration = 'manual';
+
+  function activate(section: SectionId) {
+    positions.set(activeSection, { x: window.scrollX, y: window.scrollY });
+    const next = views.find(view => view.dataset.sectionView === section)!;
+
+    // Reveal and focus first, so focus never remains inside an inert subtree.
+    next.classList.remove('is-inactive');
+    next.inert = false;
+    next.removeAttribute('aria-hidden');
+    next.focus();
+
+    for (const view of views) {
+      if (view === next) continue;
+      view.inert = true;
+      view.setAttribute('aria-hidden', 'true');
+      view.classList.add('is-inactive');
+    }
+
+    activeSection = section;
+    host!.dataset.activeSection = section;
+    document.querySelectorAll<HTMLAnchorElement>('[data-section-link]').forEach(link => {
+      if (link.dataset.sectionLink === section) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+    const label = sections.find(item => item.id === section)!.label;
+    document.title = section === 'top-news' ? 'The DevTools Times' : `${label} | The DevTools Times`;
+    const position = positions.get(section) ?? { x: 0, y: 0 };
+    window.scrollTo({ left: position.x, top: position.y, behavior: 'instant' });
+  }
+
+  document.addEventListener('click', event => {
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+    const link = event.target instanceof Element ? event.target.closest('a') : null;
+    if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+    const url = new URL(link.href, window.location.href);
+    if (url.origin !== window.location.origin || url.hash) return;
+    const section = getSection(url);
+    if (!section) return;
+
+    event.preventDefault();
+    if (url.href === window.location.href) return;
+    history.pushState(null, '', url);
+    activate(section);
+  });
+
+  window.addEventListener('popstate', () => {
+    const section = getSection(new URL(window.location.href));
+    if (section) activate(section);
+    else window.location.reload();
+  });
+
+  window.addEventListener('pagehide', () => {
+    history.scrollRestoration = previousScrollRestoration;
+  });
+  window.addEventListener('pageshow', () => {
+    history.scrollRestoration = 'manual';
+  });
+}
