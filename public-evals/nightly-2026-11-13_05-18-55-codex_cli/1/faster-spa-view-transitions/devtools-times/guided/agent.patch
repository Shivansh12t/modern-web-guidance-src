diff --git a/src/utils/sections.ts b/src/utils/sections.ts
new file mode 100644
index 0000000..b3dfd9d
--- /dev/null
+++ b/src/utils/sections.ts
@@ -0,0 +1,22 @@
+export const sections = [
+  { id: 'top-news', label: 'Top News', path: '' },
+  { id: 'world', label: 'World', path: '?section=world' },
+  { id: 'politics', label: 'Politics', path: '?section=politics' },
+  { id: 'multimedia', label: 'Multimedia', path: 'multimedia' },
+  { id: 'reports', label: 'Reports', path: 'reports' },
+] as const;
+
+export type SectionId = (typeof sections)[number]['id'];
+
+// Only the five fixed sections belong to the SPA; article/category URLs stay links.
+export function getSection(url: URL): SectionId | null {
+  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
+  const path = url.pathname.replace(/\/$/, '');
+  if (path === base) {
+    const section = url.searchParams.get('section');
+    return section === 'world' || section === 'politics' ? section : 'top-news';
+  }
+  if (path === `${base}/multimedia`) return 'multimedia';
+  if (path === `${base}/reports`) return 'reports';
+  return null;
+}
