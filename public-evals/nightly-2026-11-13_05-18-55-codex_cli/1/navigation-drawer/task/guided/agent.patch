+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const closeButton = drawer.querySelector('.drawer-close');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let state = 'closed';
+    let openingId = 0;
+
+    openButton.addEventListener('click', async () => {
+      if (drawer.open) return;
+      const currentOpening = ++openingId;
+      state = 'opening';
+      drawer.showModal();
+      openButton.setAttribute('aria-expanded', 'true');
+
+      // Reset on every opening, including browsers without scroll-initial-target.
+      scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (currentOpening !== openingId || !drawer.open || state !== 'opening') return;
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    });
+
+    function closeDrawer() {
+      if (!drawer.open) return;
+      state = 'closing';
+      ++openingId;
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        drawer.close();
+      } else {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    const observer = new IntersectionObserver(entries => {
+      const entry = entries.at(-1);
+      if (!drawer.open) return;
+      if (entry.intersectionRatio >= 0.001 && state === 'opening') state = 'open';
+      // Ignore the off-screen starting position during the slide-in.
+      if (entry.intersectionRatio < 0.001 && state !== 'opening') drawer.close();
+    }, { root: scroller, threshold: [0.001, 1] });
+    observer.observe(sheet);
+
+    closeButton.addEventListener('click', closeDrawer);
+    let pressedOutside = false;
+    drawer.addEventListener('pointerdown', event => {
+      pressedOutside = !sheet.contains(event.target);
+    });
+    drawer.addEventListener('pointercancel', () => { pressedOutside = false; });
+    drawer.addEventListener('click', event => {
+      if (pressedOutside && !sheet.contains(event.target)) closeDrawer();
+      pressedOutside = false;
+    });
+    drawer.addEventListener('cancel', event => {
+      if (event.cancelable) {
+        event.preventDefault();
+        closeDrawer();
+      }
+    });
+    drawer.addEventListener('close', () => {
+      state = 'closed';
+      ++openingId;
+      openButton.setAttribute('aria-expanded', 'false');
+    });
+
+    // Keep backdrop fading in browsers without scroll-driven animations.
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      const updateBackdrop = () => {
+        const width = sheet.offsetWidth;
+        const opacity = width ? Math.max(0, Math.min(1, 1 - scroller.scrollLeft / width)) : 0;
+        drawer.style.setProperty('--drawer-backdrop', opacity);
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+      window.addEventListener('resize', updateBackdrop);
+    }
+  </script>
