+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.navigation-drawer');
+    const panel = drawer.querySelector('.drawer-panel');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let closing = false;
+    let previousOverflow;
+    let gesture = null;
+    let suppressClick = false;
+
+    function closeDrawer() {
+      if (!drawer.open || closing) return;
+      closing = true;
+      panel.style.removeProperty('transform');
+      drawer.classList.remove('is-open');
+      window.setTimeout(() => drawer.close(), reducedMotion.matches ? 0 : 220);
+    }
+
+    menuButton.addEventListener('click', () => {
+      if (drawer.open) return;
+      previousOverflow = document.body.style.overflow;
+      document.body.style.overflow = 'hidden';
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Commit the offscreen position before starting the entrance transition.
+      panel.getBoundingClientRect();
+      drawer.classList.add('is-open');
+    });
+
+    drawer.querySelector('.close-menu').addEventListener('click', closeDrawer);
+    drawer.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDrawer();
+    });
+    drawer.addEventListener('click', (event) => {
+      if (event.target === drawer || event.target.closest('a')) closeDrawer();
+    });
+    drawer.addEventListener('close', () => {
+      document.body.style.overflow = previousOverflow;
+      menuButton.setAttribute('aria-expanded', 'false');
+      drawer.classList.remove('is-open');
+      panel.style.removeProperty('transform');
+      gesture = null;
+      closing = false;
+      menuButton.focus();
+    });
+
+    panel.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || closing) return;
+      suppressClick = false;
+      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, dragging: false };
+    });
+    panel.addEventListener('pointermove', (event) => {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      const dx = event.clientX - gesture.x;
+      const dy = event.clientY - gesture.y;
+      if (!gesture.dragging) {
+        if (Math.abs(dy) > 10 && Math.abs(dy) >= Math.abs(dx)) {
+          gesture = null;
+          return;
+        }
+        if (dx < 10 || dx <= Math.abs(dy)) return;
+        gesture.dragging = true;
+        panel.setPointerCapture(event.pointerId);
+        panel.style.transition = 'none';
+      }
+      panel.style.transform = `translateX(${Math.max(0, dx)}px)`;
+    });
+
+    function finishGesture(event) {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      const shouldClose = event.type === 'pointerup' && gesture.dragging &&
+        event.clientX - gesture.x >= Math.min(80, panel.clientWidth * 0.25);
+      suppressClick = gesture.dragging;
+      gesture = null;
+      if (panel.hasPointerCapture(event.pointerId)) panel.releasePointerCapture(event.pointerId);
+      panel.style.removeProperty('transition');
+      if (shouldClose) closeDrawer();
+      else panel.style.removeProperty('transform');
+    }
+
+    panel.addEventListener('pointerup', finishGesture);
+    panel.addEventListener('pointercancel', finishGesture);
+    panel.addEventListener('click', (event) => {
+      if (!suppressClick) return;
+      event.preventDefault();
+      event.stopPropagation();
+      suppressClick = false;
+    }, true);
+  </script>
