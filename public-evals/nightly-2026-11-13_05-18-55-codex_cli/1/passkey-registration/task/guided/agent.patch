+  <script type="module">
+    // Vendored webauthn-polyfills 0.1.7 (Apache-2.0): JSON APIs only.
+    import './vendor/webauthn-polyfills/json_serialization.js';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const status = document.getElementById('passkey-status');
+    let registering = false;
+    let supported = false;
+    let registered = false;
+
+    async function checkPasskeySupport() {
+      if (!window.isSecureContext || !window.PublicKeyCredential ||
+          typeof navigator.credentials?.create !== 'function' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        status.textContent = 'Passkey creation is unavailable. Use a supported browser over HTTPS.';
+        return;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        supported = Boolean(capabilities.conditionalGet && capabilities.passkeyPlatformAuthenticator);
+        registerButton.disabled = !supported;
+        status.textContent = supported
+          ? 'You can create a passkey on this device.'
+          : 'Passkey creation is unavailable on this device. You can still use your existing sign-in method.';
+      } catch {
+        status.textContent = 'Could not check passkey availability. Please reload to try again.';
+      }
+    }
+
+    function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        mode: 'same-origin',
+        credentials: 'same-origin',
+        redirect: 'error',
+        cache: 'no-store',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (!supported || registering || registered) return;
+      registering = true;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      status.textContent = 'Preparing your passkey…';
+
+      try {
+        const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+        if (!optionsResponse.ok) throw new Error('Could not prepare your passkey. Please try again.');
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+        // Keep the RP ID and challenge supplied by the authenticated server.
+        if (!publicKey.rp?.id) throw new Error('Passkey setup is unavailable. Please contact support.');
+
+        status.textContent = 'Follow your device’s instructions to create a passkey.';
+        let credential;
+        try {
+          credential = await navigator.credentials.create({ publicKey });
+        } catch (error) {
+          const messages = {
+            InvalidStateError: 'A passkey already exists for this account on this device.',
+            NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+            AbortError: 'Passkey creation was interrupted. You can try again.',
+            SecurityError: 'Passkey setup requires HTTPS and a correctly configured domain.',
+          };
+          status.textContent = messages[error.name] || 'Could not create a passkey. Please try again.';
+          return;
+        }
+        if (!credential) {
+          status.textContent = 'No passkey was created. You can try again.';
+          return;
+        }
+
+        const encodedResponse = credential.toJSON();
+        status.textContent = 'Verifying your passkey…';
+        // Only verification failures signal an orphaned credential, never prompt cancellation.
+        try {
+          const verificationResponse = await postJSON('/api/register/verify', encodedResponse);
+          if (!verificationResponse.ok) throw new Error('Verification failed.');
+          if (verificationResponse.headers.get('Content-Type')?.includes('application/json')) {
+            const result = await verificationResponse.json();
+            if (result.verified === false) throw new Error('Verification failed.');
+          }
+        } catch {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rp.id,
+                credentialId: encodedResponse.id,
+              });
+            } catch {
+              // Optional password-manager synchronization must not mask verification failure.
+            }
+          }
+          status.textContent = 'Could not verify your passkey. Please try again.';
+          return;
+        }
+
+        registered = true;
+        status.textContent = 'Your passkey was created and verified successfully.';
+      } catch (error) {
+        status.textContent = error instanceof TypeError || error instanceof SyntaxError
+          ? 'Could not complete passkey setup. Please try again.'
+          : error.message || 'Could not complete passkey setup. Please try again.';
+      } finally {
+        registering = false;
+        registerButton.disabled = registered || !supported;
+        registerButton.removeAttribute('aria-busy');
+      }
+    });
+
+    checkPasskeySupport();
+  </script>
+
