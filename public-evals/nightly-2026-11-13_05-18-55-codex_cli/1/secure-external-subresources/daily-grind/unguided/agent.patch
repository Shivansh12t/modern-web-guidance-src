+  <script>
+    // Images and fonts do not support native HTML integrity attributes.
+    // Fetch verifies the bytes before they can become a font or displayed image.
+    const verifiedAssets = {
+      "font": {
+        "url": "https://cdn.jsdelivr.net/npm/@fontsource/lato@5.2.0/files/lato-latin-400-normal.woff2",
+        "integrity": "sha384-+chn3xqCWRPSXDBtVEFQn+0J9Gb0SYR2FO1WrXo+L/arnyr8lXLVX2p0BqZIUemc"
+      },
+      "hero": {
+        "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80",
+        "integrity": "sha384-MkCawIXxkhKfMCsafNM9LontDHX3W8n8sYbKwfQ5NE+0xJOWg9RoQMv3OfOjdF4b"
+      },
+      "latte": {
+        "url": "https://images.unsplash.com/photo-1541167760496-1628856ab772?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-y5SDV5LglOgOgZVp+mbxqCANJaUcBzqynTLF+ZhGQlTSjKAjVm5JUFfTmIDgd/+J"
+      },
+      "espresso": {
+        "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-Yl309C3L1ztIQVEAWthyto6bmQ0NCfR6Fh0FKlo8X3ivrTz/hzKSRVHh4ZXfJ2SX"
+      },
+      "cold-brew": {
+        "url": "https://images.unsplash.com/photo-1517701604599-bb29b565090c?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-8BVYoeCa4BfhP0cdbKGlxiGxgD6YRYCANIIF9K4gA7wJ+qrwR9xBeHLywbueB0EJ"
+      }
+    };
+
+    async function fetchVerifiedAsset(name) {
+      const { url, integrity } = verifiedAssets[name];
+      const response = await fetch(url, {
+        integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${name} (${response.status})`);
+      return response;
+    }
+
+    async function loadFont() {
+      const response = await fetchVerifiedAsset('font');
+      const font = new FontFace('Lato', await response.arrayBuffer(), {
+        style: 'normal', weight: '400', display: 'swap'
+      });
+      document.fonts.add(await font.load());
+    }
+
+    async function loadImage(name, element) {
+      const response = await fetchVerifiedAsset(name);
+      const objectURL = URL.createObjectURL(await response.blob());
+      if (name === 'hero') {
+        // The document owns this URL until it is discarded by the browser.
+        element.style.setProperty('--hero-image', `url("${objectURL}")`);
+      } else {
+        element.addEventListener('load', () => {
+          element.hidden = false;
+          URL.revokeObjectURL(objectURL);
+        }, { once: true });
+        element.addEventListener('error', () => {
+          URL.revokeObjectURL(objectURL);
+        }, { once: true });
+        element.src = objectURL;
+      }
+    }
+
+    // Fail closed: retain the system font, hero color, and card text on failure.
+    loadFont().catch(error => console.warn('Verified font unavailable:', error));
+    loadImage('hero', document.querySelector('.hero'))
+      .catch(error => console.warn('Verified hero unavailable:', error));
+    document.querySelectorAll('[data-verified-image]').forEach(element => {
+      loadImage(element.dataset.verifiedImage, element)
+        .catch(error => console.warn('Verified card image unavailable:', error));
+    });
+    document.addEventListener('DOMContentLoaded', () => {
+      if (window.feather) window.feather.replace({ 'aria-hidden': 'true' });
+    });
+  </script>
+
 </body>
 
 </html>
