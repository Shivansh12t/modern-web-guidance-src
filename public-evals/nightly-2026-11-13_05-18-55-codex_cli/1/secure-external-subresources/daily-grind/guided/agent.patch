+  <script>
+    // Hashes are pinned at release time, never derived from runtime responses.
+    // Package assets match their exact npm releases; photos use fixed JPEG
+    // transformations to avoid content negotiation changing the verified bytes.
+    const fontAsset = {
+      url: 'https://cdn.jsdelivr.net/npm/@fontsource/lora@5.3.0/files/lora-latin-400-normal.woff2',
+      integrity: 'sha384-4K0WjzceC/SOy/usx6omCD3VyEOFfhpO97BismDBHNTJVOkoaAqmoEOWkiDGJr/8',
+    };
+    const imageAssets = [
+      {
+        target: 'hero',
+        url: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&h=900&q=80',
+        integrity: 'sha384-YUet8nBDHQZZytDjKEaBDYSEY+6j+mSlWjiARMNti2PWhjnHa74ouBxvRVcUN10H',
+      },
+      {
+        target: 'latte-photo',
+        url: 'https://images.unsplash.com/photo-1570968915860-54d5c301fa9f?fm=jpg&fit=crop&w=640&h=400&q=80',
+        integrity: 'sha384-i/mji0y0+dl8sh3QARunS158pInWjNfs2eQmhNujD0oRGY2d/h9J+sj51LPRCNov',
+      },
+      {
+        target: 'espresso-photo',
+        url: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=640&h=400&q=80',
+        integrity: 'sha384-ebFGHNeEqCguFeCzJzWvZQOmwgCJXN77+FFLpG3HAmkl4RJdOFQyMmDGjQcozx3J',
+      },
+      {
+        target: 'cold-brew-photo',
+        url: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?fm=jpg&fit=crop&w=640&h=400&q=80',
+        integrity: 'sha384-hI7RYGmB16YukMy3u3zUGXrmafIjWjLH1ZDm1OZ2QOSvedWTL6REDfOsnetLUqz1',
+      },
+    ];
+
+    async function fetchVerified(asset) {
+      // Fetch SRI also protects fonts/images in browsers without CSS integrity().
+      // A mismatch rejects the request; there is no unverified network fallback.
+      const response = await fetch(asset.url, {
+        integrity: asset.integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer',
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    async function loadFont() {
+      const response = await fetchVerified(fontAsset);
+      const font = new FontFace('Daily Grind Lora', await response.arrayBuffer(), {
+        weight: '400',
+        style: 'normal',
+        display: 'swap',
+      });
+      document.fonts.add(await font.load());
+    }
+
+    async function loadImage(asset) {
+      const response = await fetchVerified(asset);
+      const objectUrl = URL.createObjectURL(await response.blob());
+      // Only verified bytes reach CSS. Keep the blob alive for this document's
+      // lifetime so background images can be repainted; navigation releases it.
+      document.getElementById(asset.target).style.setProperty(
+        '--verified-image', `url("${objectUrl}")`,
+      );
+    }
+
+    // Independent failures preserve the system font, solid backgrounds, and links.
+    loadFont().catch(error => console.warn('Verified font unavailable.', error));
+    imageAssets.forEach(asset => {
+      loadImage(asset).catch(error => console.warn(`Verified image unavailable: ${asset.target}`, error));
+    });
+    document.addEventListener('DOMContentLoaded', () => {
+      window.feather?.replace({ 'aria-hidden': 'true', focusable: 'false' });
+    });
+  </script>
+
 </body>
 
