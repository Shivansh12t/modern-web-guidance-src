+  <script>
+    const signInForm = document.querySelector('#sign-in-form');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let authenticated = false;
+    let explicitSignIn = false;
+    let conditionalAvailable = false;
+
+    function decodeBase64url(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+      return Uint8Array.from(atob(padded), character => character.charCodeAt(0)).buffer;
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseOptions(options) {
+      if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseRequestOptionsFromJSON(options);
+      }
+      return {
+        ...options,
+        challenge: decodeBase64url(options.challenge),
+        ...(options.allowCredentials && {
+          allowCredentials: options.allowCredentials.map(credential => ({
+            ...credential, id: decodeBase64url(credential.id)
+          }))
+        })
+      };
+    }
+
+    function serializeCredential(credential) {
+      if (typeof credential.toJSON === 'function') return credential.toJSON();
+      return {
+        id: credential.id,
+        rawId: encodeBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        response: {
+          clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+          authenticatorData: encodeBase64url(credential.response.authenticatorData),
+          signature: encodeBase64url(credential.response.signature),
+          userHandle: credential.response.userHandle == null
+            ? null : encodeBase64url(credential.response.userHandle)
+        },
+        clientExtensionResults: credential.getClientExtensionResults()
+      };
+    }
+
+    async function authenticate(conditional = false) {
+      if (authenticated || (conditional && (activeRequest || explicitSignIn))) return;
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+      if (!conditional) {
+        explicitSignIn = true;
+        authButton.disabled = true;
+        authStatus.textContent = 'Confirm your passkey to sign in.';
+      }
+      try {
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin', cache: 'no-store', signal: controller.signal
+        });
+        if (!optionsResponse.ok) throw new Error('Could not load passkey options. Please try again.');
+        const options = await optionsResponse.json();
+        controller.signal.throwIfAborted();
+        const publicKey = parseOptions(options.publicKey ?? options);
+        publicKey.userVerification = 'required';
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal: controller.signal
+        });
+        controller.signal.throwIfAborted();
+        if (!credential) throw new Error('No passkey was selected. Please try again.');
+        // Both autofill and the explicit prompt use the same server verification.
+        authButton.disabled = true;
+        authStatus.textContent = 'Verifying your passkey…';
+        const verificationResponse = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(serializeCredential(credential)),
+          signal: controller.signal
+        });
+        if (!verificationResponse.ok) throw new Error('Passkey verification failed. Please try again.');
+        const result = await verificationResponse.json();
+        controller.signal.throwIfAborted();
+        if (result.verified === false || result.success === false) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        authenticated = true;
+        authStatus.textContent = 'Successfully signed in with your passkey.';
+      } catch (error) {
+        if (controller.signal.aborted) return;
+        if (!conditional || error.name !== 'NotAllowedError') {
+          authStatus.textContent = error.name === 'NotAllowedError'
+            ? 'Passkey sign-in was cancelled or unavailable. Please try again.'
+            : 'Unable to sign in with your passkey. Please try again.';
+        }
+      } finally {
+        if (activeRequest === controller) {
+          activeRequest = undefined;
+          explicitSignIn = false;
+          authButton.disabled = authenticated;
+          if (!conditional && !authenticated && conditionalAvailable) void authenticate(true);
+        }
+      }
+    }
+
+    signInForm.addEventListener('submit', event => {
+      event.preventDefault();
+      if (!explicitSignIn && !authButton.disabled) void authenticate();
+    });
+
+    async function initializePasskeys() {
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        authButton.disabled = true;
+        authStatus.textContent = 'Passkeys are not supported in this browser. Use a supported browser over HTTPS.';
+        return;
+      }
+      try {
+        conditionalAvailable = typeof PublicKeyCredential.isConditionalMediationAvailable === 'function'
+          && await PublicKeyCredential.isConditionalMediationAvailable();
+        if (conditionalAvailable) void authenticate(true);
+      } catch {
+        // The explicit sign-in button remains available if autofill is unsupported.
+      }
+    }
+
+    document.querySelector('#username').addEventListener('focus', () => {
+      if (conditionalAvailable) void authenticate(true);
+    });
+    void initializePasskeys();
+  </script>
+
