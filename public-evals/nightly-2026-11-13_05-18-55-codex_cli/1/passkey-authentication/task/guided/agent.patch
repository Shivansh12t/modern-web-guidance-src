+  <script>
+    (() => {
+      const form = document.querySelector('#sign-in-form');
+      const button = document.querySelector('[data-testid="auth-button"]');
+      const status = document.querySelector('[data-testid="auth-status"]');
+      let conditionalController;
+      let conditionalTask;
+      let explicitPending = false;
+      let verifying = false;
+      let authenticated = false;
+
+      function decodeBase64URL(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')),
+          character => character.charCodeAt(0)).buffer;
+      }
+
+      function encodeBase64URL(value) {
+        return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseOptions(options) {
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(options);
+        }
+        // Compatibility for browsers without the WebAuthn JSON helpers.
+        return {
+          ...options,
+          challenge: decodeBase64URL(options.challenge),
+          ...(options.allowCredentials && {
+            allowCredentials: options.allowCredentials.map(item => ({
+              ...item, id: decodeBase64URL(item.id),
+            })),
+          }),
+        };
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') return credential.toJSON();
+        const response = credential.response;
+        return {
+          id: credential.id,
+          rawId: encodeBase64URL(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: encodeBase64URL(response.clientDataJSON),
+            authenticatorData: encodeBase64URL(response.authenticatorData),
+            signature: encodeBase64URL(response.signature),
+            userHandle: response.userHandle == null ? null : encodeBase64URL(response.userHandle),
+          },
+        };
+      }
+
+      async function authenticate(conditional, controller) {
+        try {
+          const optionsResponse = await fetch('/api/login/options', {
+            credentials: 'same-origin', cache: 'no-store', signal: controller.signal,
+          });
+          if (!optionsResponse.ok) throw new Error('Unable to load sign-in options. Please try again.');
+          const options = await optionsResponse.json();
+          const publicKey = parseOptions(options.publicKey ?? options);
+          if (!conditional) publicKey.userVerification = 'required';
+          controller.signal.throwIfAborted();
+          const credential = await navigator.credentials.get({
+            publicKey,
+            ...(conditional ? { mediation: 'conditional' } : {}),
+            signal: controller.signal,
+          });
+          controller.signal.throwIfAborted();
+          if (!credential) throw new Error('No passkey was selected. Please try again.');
+          verifying = true;
+          button.disabled = true;
+          status.textContent = 'Verifying your passkey…';
+          const encoded = serializeCredential(credential);
+          const verification = await fetch('/api/login/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encoded),
+          });
+          if (!verification.ok) {
+            if (verification.status === 404 && publicKey.rpId &&
+                typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId, credentialId: encoded.id,
+              }).catch(() => {});
+            }
+            throw new Error('Passkey verification failed. Please try again.');
+          }
+          const result = await verification.json();
+          if (result.verified === false || result.success === false || result.authenticated === false) {
+            throw new Error('Passkey verification failed. Please try again.');
+          }
+          authenticated = true;
+          status.textContent = 'Signed in successfully.';
+        } catch (error) {
+          if (error.name === 'AbortError') return;
+          if (error.name === 'NotAllowedError') {
+            if (!conditional) status.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+          } else {
+            status.textContent = error instanceof TypeError
+              ? 'Unable to sign in. Check your connection and try again.'
+              : error.message;
+          }
+        } finally {
+          verifying = false;
+          button.disabled = authenticated || explicitPending;
+        }
+      }
+
+      async function startAutofill() {
+        if (authenticated || explicitPending || verifying) return;
+        const controller = new AbortController();
+        conditionalController = controller;
+        try {
+          const supported = typeof PublicKeyCredential.getClientCapabilities === 'function'
+            ? (await PublicKeyCredential.getClientCapabilities()).conditionalGet
+            : typeof PublicKeyCredential.isConditionalMediationAvailable === 'function' &&
+              await PublicKeyCredential.isConditionalMediationAvailable();
+          if (!supported || controller.signal.aborted || explicitPending) return;
+          await authenticate(true, controller);
+        } catch {
+          // Explicit sign-in remains available if conditional UI is unsupported.
+        }
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (authenticated || explicitPending || verifying) return;
+        explicitPending = true;
+        button.disabled = true;
+        status.textContent = 'Use your device to sign in…';
+        conditionalController?.abort();
+        await conditionalTask;
+        await authenticate(false, new AbortController());
+        explicitPending = false;
+        button.disabled = authenticated;
+        if (!authenticated) conditionalTask = startAutofill();
+      });
+
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+        button.disabled = true;
+        status.textContent = 'Passkeys require a supported browser and a secure connection (HTTPS).';
+        return;
+      }
+      conditionalTask = startAutofill();
+    })();
+  </script>
