+  <script>
+    (() => {
+      const nativeInterest = 'interestForElement' in HTMLButtonElement.prototype;
+      const nativePopover = 'popover' in HTMLElement.prototype;
+      const nativeAnchors = window.CSS && CSS.supports('anchor-name: --a')
+        && CSS.supports('position-area: block-start')
+        && CSS.supports('position-try-fallbacks: flip-block');
+      let active = null;
+
+      // Manual positioning also supports browsers without the Popover API.
+      function position(entry) {
+        if (nativeAnchors) return;
+        const button = entry.trigger.getBoundingClientRect();
+        const popup = entry.tooltip.getBoundingClientRect();
+        const viewport = document.documentElement;
+        const gap = 8;
+        const edge = 12;
+        const left = Math.max(edge, Math.min(
+          button.left + (button.width - popup.width) / 2,
+          viewport.clientWidth - popup.width - edge
+        ));
+        let top = button.top - popup.height - gap;
+        if (top < edge) top = button.bottom + gap;
+        top = Math.max(edge, Math.min(top, viewport.clientHeight - popup.height - edge));
+        entry.tooltip.style.left = `${left}px`;
+        entry.tooltip.style.top = `${top}px`;
+      }
+
+      function close(entry) {
+        clearTimeout(entry.timer);
+        if (nativePopover && entry.tooltip.matches(':popover-open')) {
+          entry.tooltip.hidePopover();
+        }
+        entry.tooltip.classList.remove('is-open');
+        if (active === entry) active = null;
+      }
+
+      document.querySelectorAll('.card [interestfor]').forEach((trigger, index) => {
+        const tooltip = document.getElementById(trigger.getAttribute('interestfor'));
+        const entry = { trigger, tooltip, overTrigger: false, overTooltip: false,
+          focused: false, dismissed: false, timer: null };
+        // Explicit pairs work even when opened programmatically by the fallback.
+        trigger.style.setProperty('anchor-name', `--favorite-${index}`);
+        tooltip.style.setProperty('position-anchor', `--favorite-${index}`);
+
+        if (nativeInterest && nativePopover) {
+          tooltip.addEventListener('toggle', () => {
+            if (tooltip.matches(':popover-open')) {
+              active = entry;
+              position(entry);
+            } else if (active === entry) active = null;
+          });
+          return;
+        }
+
+        // Local interest-invoker fallback: no network or polyfill download needed.
+        // Manual popovers avoid changing unrelated menus in browsers lacking hint.
+        tooltip.setAttribute('popover', 'manual');
+        function interested() {
+          return entry.overTrigger || entry.overTooltip || entry.focused;
+        }
+
+        function update() {
+          clearTimeout(entry.timer);
+          if (interested()) {
+            if (entry.dismissed) return;
+            if (active && active !== entry) {
+              active.dismissed = true;
+              close(active);
+            }
+            active = entry;
+            if (nativePopover) {
+              if (!tooltip.matches(':popover-open')) tooltip.showPopover();
+            } else tooltip.classList.add('is-open');
+            position(entry);
+          } else {
+            entry.dismissed = false;
+            // Let the pointer cross the gap between the link and its tooltip.
+            entry.timer = setTimeout(() => close(entry), 150);
+          }
+        }
+
+        trigger.addEventListener('pointerenter', () => { entry.overTrigger = true; update(); });
+        trigger.addEventListener('pointerleave', () => { entry.overTrigger = false; update(); });
+        trigger.addEventListener('focus', () => { entry.focused = true; update(); });
+        trigger.addEventListener('blur', () => { entry.focused = false; update(); });
+        tooltip.addEventListener('pointerenter', () => { entry.overTooltip = true; update(); });
+        tooltip.addEventListener('pointerleave', () => { entry.overTooltip = false; update(); });
+      });
+
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && active) {
+          active.dismissed = true;
+          close(active);
+        }
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (active && !active.trigger.contains(event.target) && !active.tooltip.contains(event.target)) {
+          active.dismissed = true;
+          close(active);
+        }
+      });
+      window.addEventListener('resize', () => { if (active) position(active); });
+      document.addEventListener('scroll', () => { if (active) position(active); }, true);
+    })();
+  </script>
