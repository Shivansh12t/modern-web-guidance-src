+  <script>
+    const tablist = document.querySelector('.wholesale-tabs');
+    const tabs = [...tablist.querySelectorAll('.wholesale-tab')];
+    const panels = tabs.map(tab => document.getElementById(tab.dataset.panel));
+    const couponButton = document.getElementById('reveal-coupon');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function selectTab(selectedTab) {
+      tabs.forEach((tab, index) => {
+        const selected = tab === selectedTab;
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) {
+          panels[index].removeAttribute('hidden');
+          panels[index].tabIndex = 0;
+        } else {
+          panels[index].setAttribute('hidden', 'until-found');
+          panels[index].removeAttribute('tabindex');
+        }
+      });
+    }
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+    }
+
+    couponButton.addEventListener('click', revealCoupon);
+    couponPanel.addEventListener('beforematch', revealCoupon);
+
+    if ('onbeforematch' in HTMLElement.prototype) {
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(tab));
+        // Find-in-page and fragment navigation must select only the matched panel.
+        panels[index].addEventListener('beforematch', () => selectTab(tab));
+      });
+
+      tablist.addEventListener('keydown', event => {
+        const index = tabs.indexOf(document.activeElement);
+        if (index < 0) return;
+        let next;
+        switch (event.key) {
+          case 'ArrowRight': next = (index + 1) % tabs.length; break;
+          case 'ArrowLeft': next = (index - 1 + tabs.length) % tabs.length; break;
+          case 'Home': next = 0; break;
+          case 'End': next = tabs.length - 1; break;
+          default: return;
+        }
+        event.preventDefault();
+        selectTab(tabs[next]);
+        tabs[next].focus();
+      });
+    } else {
+      // Keep all text searchable when native hidden-content search is unavailable.
+      // Convert the tabs into section links above the linear content.
+      tablist.removeAttribute('role');
+      tablist.removeAttribute('aria-labelledby');
+      tabs.forEach((tab, index) => {
+        const link = document.createElement('a');
+        link.id = tab.id;
+        link.className = tab.className;
+        link.href = '#' + panels[index].id;
+        link.textContent = tab.textContent;
+        tab.replaceWith(link);
+        panels[index].removeAttribute('hidden');
+        panels[index].removeAttribute('role');
+        panels[index].removeAttribute('aria-labelledby');
+        panels[index].tabIndex = 0;
+      });
+      revealCoupon();
+    }
+  </script>
+
