+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const items = Array.from(panel.querySelectorAll('[role="menuitem"]'));
+    let positionFrame;
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const viewportLeft = viewport ? viewport.offsetLeft : 0;
+      const viewportTop = viewport ? viewport.offsetTop : 0;
+      const viewportWidth = viewport ? viewport.width : document.documentElement.clientWidth;
+      const viewportHeight = viewport ? viewport.height : document.documentElement.clientHeight;
+      const padding = 8;
+      const leftBoundary = viewportLeft + padding;
+      const rightBoundary = viewportLeft + viewportWidth - padding;
+      const topBoundary = viewportTop + padding;
+      const bottomBoundary = viewportTop + viewportHeight - padding;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, viewportWidth - padding * 2)}px`;
+      panel.style.maxHeight = `${Math.max(0, viewportHeight - padding * 2)}px`;
+      const bounds = panel.getBoundingClientRect();
+      const below = Math.max(0, bottomBoundary - anchor.bottom);
+      const above = Math.max(0, anchor.top - topBoundary);
+      const flipUp = bounds.height > below && above > below;
+      panel.style.maxHeight = `${Math.min(viewportHeight - padding * 2, flipUp ? above : below)}px`;
+      const height = panel.getBoundingClientRect().height;
+
+      // Prefer the trigger's left edge; flip to its right edge on collision.
+      let left = anchor.left;
+      if (left + bounds.width > rightBoundary) left = anchor.right - bounds.width;
+      left = Math.max(leftBoundary, Math.min(left, rightBoundary - bounds.width));
+      const top = flipUp ? anchor.top - height : anchor.bottom;
+      panel.style.left = `${left}px`;
+      panel.style.top = `${Math.max(topBoundary, Math.min(top, bottomBoundary - height))}px`;
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionPanel);
+    }
+
+    function openMenu(index = 0) {
+      panel.showPopover();
+      trigger.setAttribute('aria-expanded', 'true');
+      positionPanel();
+      items[index].focus({ preventScroll: true });
+    }
+
+    trigger.addEventListener('click', () => {
+      if (panel.matches(':popover-open')) panel.hidePopover();
+      else openMenu();
+    });
+
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openMenu(event.key === 'ArrowUp' ? items.length - 1 : 0);
+      }
+    });
+
+    panel.addEventListener('toggle', () => {
+      trigger.setAttribute('aria-expanded', String(panel.matches(':popover-open')));
+    });
+
+    panel.addEventListener('keydown', (event) => {
+      const index = items.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowDown') next = (index + 1) % items.length;
+      if (event.key === 'ArrowUp') next = (index - 1 + items.length) % items.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = items.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        items[next].focus({ preventScroll: true });
+      }
+      if (event.key === 'Escape' || event.key === 'Tab') {
+        panel.hidePopover();
+        trigger.focus({ preventScroll: true });
+        if (event.key === 'Escape') event.preventDefault();
+      }
+    });
+
+    panel.addEventListener('click', (event) => {
+      const item = event.target.closest('[data-href]');
+      if (item) {
+        panel.hidePopover();
+        window.location.assign(item.dataset.href);
+      }
+    });
+
+    window.addEventListener('resize', schedulePosition);
+    window.addEventListener('scroll', schedulePosition, true);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const resizeObserver = new ResizeObserver(schedulePosition);
+    resizeObserver.observe(trigger);
+    resizeObserver.observe(panel);
+  </script>
