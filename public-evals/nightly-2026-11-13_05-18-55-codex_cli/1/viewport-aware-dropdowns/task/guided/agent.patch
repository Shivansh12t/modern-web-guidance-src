+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativeAnchors = CSS.supports('anchor-name: --options-trigger') &&
+      CSS.supports('position-area: block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks: flip-block');
+    const isOpen = () => nativePopover
+      ? panel.matches(':popover-open')
+      : panel.classList.contains('is-open');
+
+    function positionPanel() {
+      if (!isOpen()) return;
+      const viewport = window.visualViewport;
+      const left = (viewport?.offsetLeft ?? 0) + 8;
+      const top = (viewport?.offsetTop ?? 0) + 8;
+      const right = left + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+      const bottom = top + (viewport?.height ?? document.documentElement.clientHeight) - 16;
+      panel.style.maxWidth = `${Math.max(0, right - left)}px`;
+      panel.style.maxHeight = `${Math.max(0, bottom - top)}px`;
+      const bounds = panel.getBoundingClientRect();
+      if (nativeAnchors && !panel.classList.contains('manual-position') &&
+          bounds.left >= left && bounds.right <= right &&
+          bounds.top >= top && bounds.bottom <= bottom) return;
+
+      // Also clamp unusually small viewports where neither native flip can fit.
+      panel.classList.add('manual-position');
+      const anchor = trigger.getBoundingClientRect();
+      const below = Math.max(0, bottom - anchor.bottom);
+      const above = Math.max(0, anchor.top - top);
+      const openAbove = panel.scrollHeight > below && above > below;
+      panel.style.maxHeight = `${openAbove ? above : below}px`;
+      const size = panel.getBoundingClientRect();
+      const x = anchor.left + size.width <= right ? anchor.left : anchor.right - size.width;
+      const y = openAbove ? anchor.top - size.height : anchor.bottom;
+      panel.style.left = `${Math.max(left, Math.min(x, right - size.width))}px`;
+      panel.style.top = `${Math.max(top, Math.min(y, bottom - size.height))}px`;
+    }
+
+    function syncPanel() {
+      const open = isOpen();
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) {
+        panel.classList.remove('manual-position');
+        panel.style.removeProperty('left');
+        panel.style.removeProperty('top');
+        positionPanel();
+      }
+    }
+
+    function closePanel() {
+      if (nativePopover) panel.hidePopover();
+      else {
+        panel.classList.remove('is-open');
+        syncPanel();
+      }
+    }
+
+    if (nativePopover) {
+      panel.addEventListener('toggle', syncPanel);
+    } else {
+      panel.classList.add('legacy-popover');
+      trigger.addEventListener('click', () => {
+        panel.classList.toggle('is-open');
+        syncPanel();
+      });
+      document.addEventListener('click', (event) => {
+        if (isOpen() && !panel.contains(event.target) && !trigger.contains(event.target)) closePanel();
+      });
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && isOpen()) {
+          closePanel();
+          trigger.focus();
+        }
+      });
+    }
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (action) {
+        closePanel();
+        window.location.assign(action.dataset.href);
+      }
+    });
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, { capture: true, passive: true });
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+  </script>
