+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+  <!-- Only initial content gates the transition; the footer is outside this boundary. -->
+  <link rel="expect" href="#main-content" blocking="render">
+</head>
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main id="main-content" class="container">
+    <h1 class="page-title">Our Locations</h1>
+    <p class="page-title">Your daily coffee ritual starts here.</p>
+    <section class="card" aria-labelledby="visit-title">
+      <h2 id="visit-title">Visit The Daily Grind</h2>
+      <p>Contact our team for cafe locations, opening hours, and directions.</p>
+      <a href="/contact" class="btn">Contact Us</a>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+</body>
+</html>
