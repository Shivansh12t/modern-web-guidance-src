diff --git a/src/scripts/page-transitions.ts b/src/scripts/page-transitions.ts
new file mode 100644
index 0000000..afd8a61
--- /dev/null
+++ b/src/scripts/page-transitions.ts
@@ -0,0 +1,91 @@
+import type { TransitionBeforePreparationEvent } from "astro:transitions/client";
+
+// Keep the current page visible while preparing the incoming page. Async
+// after-swap listeners cannot delay the browser's transition snapshot.
+async function prepareVisuals(event: TransitionBeforePreparationEvent): Promise<boolean> {
+  const cleanups: Array<() => void> = [];
+  let timeout: ReturnType<typeof setTimeout>;
+
+  const interrupted = new Promise<boolean>((resolve) => {
+    const abort = () => resolve(false);
+    event.signal.addEventListener("abort", abort, { once: true });
+    cleanups.push(() => event.signal.removeEventListener("abort", abort));
+    timeout = setTimeout(() => resolve(false), 3000);
+  });
+
+  try {
+    if (event.signal.aborted) return false;
+
+    // Astro preloads CSS bytes; also wait for stylesheet loading/parsing before
+    // swapping. Nonmatching media keeps incoming styles off the current page.
+    const styles = Array.from(
+      event.newDocument.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]'),
+    ).filter((link) => !Array.from(document.styleSheets).some(
+      (sheet) => sheet.href === link.href,
+    )).map((link) => new Promise<boolean>((resolve) => {
+      const pending = link.cloneNode() as HTMLLinkElement;
+      pending.media = "not all";
+      pending.onload = () => resolve(true);
+      pending.onerror = () => resolve(false);
+      cleanups.push(() => {
+        pending.onload = pending.onerror = null;
+        pending.remove();
+      });
+      document.head.append(pending);
+    }));
+
+    // Decode in the live document's environment: images in the detached incoming
+    // document (especially lazy images) do not reliably load. Copy responsive and
+    // request attributes before src so the browser chooses the same resource.
+    // Include lazy images for restored scroll positions and tall viewports.
+    const images = Array.from(event.newDocument.images).map(async (source) => {
+      const image = new Image();
+      for (const attribute of ["crossorigin", "referrerpolicy", "sizes", "srcset", "src"]) {
+        const value = source.getAttribute(attribute);
+        if (value !== null) image.setAttribute(attribute, value);
+      }
+      try {
+        await image.decode();
+        return true;
+      } catch {
+        // Failed images are settled too. An unavailable third-party image
+        // must not disable transitions for the rest of the page.
+        return true;
+      }
+    });
+
+    const font = Promise.all(styles).then(async () => {
+      await document.fonts.ready;
+      await document.fonts.load('500 1em "Grenze"');
+      return true;
+    }).catch(() => false);
+    return await Promise.race([
+      Promise.all([...styles, ...images, font]).then((results) => results.every(Boolean)),
+      interrupted,
+    ]);
+  } finally {
+    clearTimeout(timeout!);
+    cleanups.forEach((cleanup) => cleanup());
+  }
+}
+
+// Processed Astro scripts run once, so these listeners survive page swaps
+// without accumulating on every navigation. The router retains history,
+// scroll restoration, focus handling, and link interception.
+const preparedDocuments = new WeakMap<Document, boolean>();
+
+document.addEventListener("astro:before-preparation", (event) => {
+  const loader = event.loader;
+  event.loader = async () => {
+    await loader();
+    if (event.defaultPrevented || event.signal.aborted) return;
+    preparedDocuments.set(event.newDocument, await prepareVisuals(event));
+  };
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  if (!preparedDocuments.get(event.newDocument)
+    || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+    event.viewTransition.skipTransition();
+  }
+});
