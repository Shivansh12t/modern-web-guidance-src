diff --git a/src/components/PageTransitions.astro b/src/components/PageTransitions.astro
new file mode 100644
index 0000000..6b37eb1
--- /dev/null
+++ b/src/components/PageTransitions.astro
@@ -0,0 +1,36 @@
+---
+interface Props {
+  readyId: string;
+}
+
+const { readyId } = Astro.props;
+---
+
+<!-- Wait for the lead content's closing tag, rather than a partial streamed body. -->
+<link rel="expect" href={`#${readyId}`} blocking="render" />
+
+<script is:inline blocking="render">
+  // Register in the head: a deferred listener can miss the first pagereveal.
+  window.addEventListener('pagereveal', (event) => {
+    const transition = event.viewTransition;
+    if (!transition) return;
+
+    // Render blocking guarantees markup and CSS, but not font or image pixels.
+    // On a cold/failed resource load, keep normal navigation instead of
+    // animating an incomplete snapshot. Warm navigations get the cross-fade.
+    const visibleImages = [...document.images].filter((image) => {
+      const rect = image.getBoundingClientRect();
+      return rect.width > 0 && rect.height > 0 &&
+        rect.bottom > 0 && rect.top < window.innerHeight &&
+        rect.right > 0 && rect.left < window.innerWidth;
+    });
+
+    if (
+      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
+      !document.fonts.check('500 16px Grenze') ||
+      visibleImages.some((image) => !image.complete || image.naturalWidth === 0)
+    ) {
+      transition.skipTransition();
+    }
+  });
+</script>
