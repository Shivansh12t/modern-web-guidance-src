+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastValue.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const completed = 1 + Number(email.value.trim() !== '' && email.validity.valid) + Number(Boolean(form.querySelector('input[name="frequency"]:checked')));
+      progress.value = completed;
+      progress.textContent = `${Math.round(completed / 3 * 100)}%`;
+      progressText.textContent = `${completed} of 3 details set`;
+      status.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      updateSetup();
+      const frequency = form.querySelector('input[name="frequency"]:checked').value;
+      const updates = document.getElementById('email-updates').checked ? 'Email offers selected.' : 'Email offers declined.';
+      status.textContent = `Your plan: ${roastValue.value} roast, delivered ${frequency.toLowerCase()}. ${updates} Checkout is coming soon. No order has been placed and no email signup has been made.`;
+    });
+    updateSetup();
+  </script>
