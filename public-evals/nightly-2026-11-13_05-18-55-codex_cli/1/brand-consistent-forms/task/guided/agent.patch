+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-preference');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const result = document.getElementById('subscription-result');
+    const updates = document.getElementById('email-updates');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const storageKey = 'daily-grind-subscription-preferences';
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastValue.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--fill', `${(Number(roast.value) - 1) / 4 * 100}%`);
+      const completed = 1 + Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')));
+      const percent = Math.round(completed / 3 * 100);
+      progress.value = completed;
+      progress.textContent = `${percent}%`;
+      progressText.textContent = `${completed} of 3 preferences ready · ${percent}%`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        if ([1, 2, 3, 4, 5].includes(Number(saved.roast))) roast.value = saved.roast;
+        const frequency = [...form.querySelectorAll('input[name="frequency"]')]
+          .find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        updates.checked = saved.emailUpdates === true;
+      }
+    } catch { /* Storage may be blocked or contain an outdated value. */ }
+
+    form.addEventListener('input', () => {
+      updateSetup();
+      result.textContent = '';
+    });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({
+          email: email.value.trim(), frequency: frequency.value,
+          roast: Number(roast.value), emailUpdates: updates.checked
+        }));
+        result.textContent = `Preferences saved on this device: ${roastNames[Number(roast.value) - 1]} roast, ${frequency.nextElementSibling.textContent.toLowerCase()}. No order has been placed.`;
+      } catch {
+        result.textContent = 'Your browser could not save these preferences. Allow site storage and try again. No order has been placed.';
+      }
+    });
+    updateSetup();
+  </script>
+
