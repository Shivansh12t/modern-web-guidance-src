+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = Array.from(scroller.querySelectorAll('.bean'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollEndTimer;
+
+    function showVisibleBean() {
+      // Read geometry only after scrolling settles, never in the scroll handler.
+      const bounds = scroller.getBoundingClientRect();
+      const left = bounds.left + scroller.clientLeft;
+      const right = left + scroller.clientWidth;
+      let visibleIndex = 0;
+      let largestOverlap = -1;
+
+      beans.forEach((bean, index) => {
+        const rect = bean.getBoundingClientRect();
+        const overlap = Math.max(0, Math.min(right, rect.right) - Math.max(left, rect.left));
+        if (overlap > largestOverlap) {
+          largestOverlap = overlap;
+          visibleIndex = index;
+        }
+      });
+
+      scrolling = false;
+      status.textContent = `Viewing ${beans[visibleIndex].dataset.bean} · ${visibleIndex + 1} of ${beans.length}`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollEndTimer);
+        scrollEndTimer = setTimeout(() => {
+          scroller.dispatchEvent(new Event('scrollend'));
+        }, 150);
+      }
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', showVisibleBean);
+    // Account for scroll positions restored during load or history navigation.
+    window.addEventListener('pageshow', showVisibleBean);
+    showVisibleBean();
+  </script>
+
