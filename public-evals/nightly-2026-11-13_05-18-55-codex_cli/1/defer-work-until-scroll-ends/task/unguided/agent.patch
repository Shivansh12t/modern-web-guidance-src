+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = Array.from(scroller.querySelectorAll('.bean'));
+    let stopTimer;
+    let scrolling = false;
+
+    function showVisibleBean() {
+      clearTimeout(stopTimer);
+      scrolling = false;
+      const top = scroller.getBoundingClientRect().top + scroller.clientTop;
+      const bottom = top + scroller.clientHeight;
+      let visibleIndex = 0;
+      let largestVisibleArea = -1;
+
+      beans.forEach((bean, index) => {
+        const bounds = bean.getBoundingClientRect();
+        const visibleArea = Math.max(0, Math.min(bottom, bounds.bottom) - Math.max(top, bounds.top));
+        if (visibleArea > largestVisibleArea) {
+          largestVisibleArea = visibleArea;
+          visibleIndex = index;
+        }
+      });
+
+      status.textContent = `Viewing: ${beans[visibleIndex].dataset.bean} (${visibleIndex + 1} of ${beans.length})`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+      clearTimeout(stopTimer);
+      // Keep the movement handler light; measure visibility only after scrolling settles.
+      stopTimer = setTimeout(showVisibleBean, 180);
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', showVisibleBean);
+    showVisibleBean();
+  </script>
+
