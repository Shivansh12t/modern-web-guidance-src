+  <script>
+    (() => {
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-reminder-time');
+      const anniversaryDate = document.getElementById('coffee-anniversary-date');
+      const status = document.getElementById('preferences-status');
+      const storageKey = 'daily-grind-coffee-preferences';
+
+      // These are floating wall-clock/calendar values, never instants.
+      // Keep native input strings (HH:mm and YYYY-MM-DD) throughout storage
+      // and display; Date, timestamps, and UTC conversion would introduce drift.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminderTime === 'string') {
+            pickupTime.value = saved.pickupReminderTime;
+          }
+          if (typeof saved.coffeeAnniversaryDate === 'string') {
+            anniversaryDate.value = saved.coffeeAnniversaryDate;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can select them again below.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminderTime: pickupTime.value,
+            coffeeAnniversaryDate: anniversaryDate.value,
+          }));
+          status.textContent = 'Preferences saved in this browser.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
