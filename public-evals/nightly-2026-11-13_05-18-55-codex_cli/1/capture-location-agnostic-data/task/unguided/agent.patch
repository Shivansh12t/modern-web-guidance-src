+  <script>
+    (() => {
+      const storageKey = 'daily-grind.coffee-preferences';
+      const form = document.getElementById('coffee-preferences-form');
+      const pickupTime = document.getElementById('pickup-time');
+      const coffeeAnniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // These are a wall-clock time and a calendar date, never instants.
+      // Persist native input strings verbatim: no Date, UTC, or timezone conversion.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupTime === 'string') pickupTime.value = saved.pickupTime;
+          if (typeof saved.coffeeAnniversary === 'string') coffeeAnniversary.value = saved.coffeeAnniversary;
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can still select your time and date.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'Unsaved changes. Select Save preferences to keep your selections.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupTime: pickupTime.value,
+            coffeeAnniversary: coffeeAnniversary.value
+          }));
+          status.textContent = 'Preferences saved. Your time and date will stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Your browser could not save these preferences. Your selections will not be kept after reloading.';
+        }
+      });
+    })();
+  </script>
+
