+  <script>
+    const favoritesGrid = document.querySelector('#seasonal-favorites');
+    const favoritesSort = document.querySelector('#favorites-sort');
+    const sortStatus = document.querySelector('#sort-status');
+    const featuredCards = Array.from(favoritesGrid.children);
+    const nameCollator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const cardAnimations = new Map();
+
+    favoritesSort.addEventListener('change', () => {
+      // Capture current visual positions so quick successive changes stay smooth.
+      const previousPositions = new Map(featuredCards.map(card => [card, card.getBoundingClientRect()]));
+      cardAnimations.forEach(animation => animation.cancel());
+      cardAnimations.clear();
+
+      const sortedCards = [...featuredCards];
+      if (favoritesSort.value !== 'featured') {
+        const direction = favoritesSort.value === 'name-desc' ? -1 : 1;
+        sortedCards.sort((a, b) => direction * nameCollator.compare(
+          a.querySelector('h3').textContent.trim(),
+          b.querySelector('h3').textContent.trim()
+        ));
+      }
+      // Reorder the DOM as well, keeping reading and keyboard order consistent.
+      favoritesGrid.append(...sortedCards);
+
+      if (!reducedMotion.matches) {
+        const nextPositions = new Map(sortedCards.map(card => [card, card.getBoundingClientRect()]));
+        sortedCards.forEach(card => {
+          const previous = previousPositions.get(card);
+          const next = nextPositions.get(card);
+          const x = previous.left - next.left;
+          const y = previous.top - next.top;
+          if ((x || y) && typeof card.animate === 'function') {
+            const animation = card.animate([
+              { transform: `translate(${x}px, ${y}px)` },
+              { transform: 'translate(0, 0)' }
+            ], { duration: 450, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
+            cardAnimations.set(card, animation);
+          }
+        });
+      }
+
+      sortStatus.textContent = `Seasonal Favorites sorted by ${favoritesSort.selectedOptions[0].textContent}.`;
+    });
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) {
+        cardAnimations.forEach(animation => animation.cancel());
+        cardAnimations.clear();
+      }
+    });
+  </script>
+
