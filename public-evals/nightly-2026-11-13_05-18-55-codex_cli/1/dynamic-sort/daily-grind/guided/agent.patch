   </footer>
 
+  <script>
+    const favorites = document.querySelector('#seasonal-favorites');
+    const sortControl = document.querySelector('#seasonal-sort');
+    const sortStatus = document.querySelector('#sort-status');
+    const featuredCards = Array.from(favorites.children);
+    const collator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let activeTransition;
+
+    featuredCards.forEach((card, index) => {
+      card.style.viewTransitionName = `seasonal-card-${index}`;
+    });
+
+    function applySort() {
+      // Read the latest choice here so rapid changes always settle on that order.
+      const order = sortControl.value;
+      const sortedCards = [...featuredCards];
+      if (order !== 'featured') {
+        const direction = order === 'name-asc' ? 1 : -1;
+        sortedCards.sort((a, b) => direction * collator.compare(
+          a.querySelector('h3').textContent.trim(),
+          b.querySelector('h3').textContent.trim()
+        ));
+      }
+
+      for (const card of sortedCards) {
+        if (typeof favorites.moveBefore === 'function') {
+          favorites.moveBefore(card, null);
+        } else {
+          favorites.append(card);
+        }
+      }
+      sortStatus.textContent = `Sorted by ${sortControl.selectedOptions[0].textContent}, ${sortedCards.length} favorites.`;
+    }
+
+    sortControl.addEventListener('change', () => {
+      activeTransition?.skipTransition();
+      if (reducedMotion.matches) {
+        applySort();
+      } else if (typeof favorites.startViewTransition === 'function') {
+        activeTransition = favorites.startViewTransition(applySort);
+      } else if (typeof document.startViewTransition === 'function') {
+        activeTransition = document.startViewTransition(applySort);
+      } else {
+        applySort();
+      }
+    });
+
+    document.querySelector('.sort-controls').hidden = false;
+  </script>
+
 </body>
 
