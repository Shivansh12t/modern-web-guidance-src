+  issuer: "The Daily Grind · Local workspace",
+  currency: "USD",
+  id: "DG-V-012345ABCDEF",
+  issuedAt: "2026-11-13T10:00:00.000Z",
+  expiresAt: "2027-11-13T10:00:00.000Z",
+  recipient: "Sam",
+  message: "Coffee on me!",
+  amountCents: 2500,
+});
+
+test("receipt survives JSON download round trip; only public key can be exported", async () => {
+  const signed = await signDocument(identity, receipt());
+  assert.equal(
+    (await verifyDocument(JSON.parse(JSON.stringify(signed)), identity)).payload
+      .totalCents,
+    1100,
+  );
+  assert.equal(identity.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey("jwk", identity.privateKey));
+  const exported = await publicIdentity(identity);
+  assert.equal(exported.publicKey.d, undefined);
+  const publicKey = await crypto.subtle.importKey(
+    "jwk",
+    exported.publicKey,
+    { name: "ECDSA", namedCurve: "P-256" },
+    true,
+    ["verify"],
+  );
+  assert.equal(
+    (await verifyDocument(signed, { keyId: exported.keyId, publicKey }))
+      .expired,
+    false,
+  );
+});
+test("changed customer, date, and internally consistent amount are all rejected", async () => {
+  for (const mutate of [
+    (p) => (p.customer = "Mallory"),
+    (p) => (p.issuedAt = "2026-11-14T10:00:00.000Z"),
+    (p) => {
+      p.items[0].unitCents = 100;
+      p.totalCents = 200;
+    },
+  ]) {
+    const signed = await signDocument(identity, receipt());
+    mutate(signed.payload);
+    await assert.rejects(verifyDocument(signed, identity), /Signature invalid/);
+  }
+});
+test("tampering with a valid voucher amount invalidates its signature", async () => {
+  const signed = await signDocument(identity, voucher());
+  signed.payload.amountCents = 10000;
+  await assert.rejects(verifyDocument(signed, identity), /Signature invalid/);
+});
+test("unknown keys and forged key fingerprints are rejected", async () => {
+  const attacker = await generateIdentity();
+  const signed = await signDocument(attacker, receipt());
+  await assert.rejects(verifyDocument(signed, identity), /Unknown signing key/);
+  signed.keyId = identity.keyId;
+  await assert.rejects(verifyDocument(signed, identity), /Signature invalid/);
+});
+test("voucher expiration is separate from cryptographic validity", async () => {
+  const signed = await signDocument(identity, voucher());
+  assert.equal(
+    (await verifyDocument(signed, identity, Date.parse("2027-01-01"))).expired,
+    false,
+  );
+  assert.equal(
+    (await verifyDocument(signed, identity, Date.parse("2027-11-13T10:00:00Z")))
+      .expired,
+    true,
+  );
+});
+test("wrong algorithm, malformed signature, extra envelope fields, and invalid totals fail closed", async () => {
+  const signed = await signDocument(identity, receipt());
+  await assert.rejects(
+    verifyDocument({ ...signed, algorithm: "none" }, identity),
+    /Unsupported/,
+  );
+  await assert.rejects(
+    verifyDocument({ ...signed, signature: "nonsense!!!" }, identity),
+    /encoding/,
+  );
+  await assert.rejects(
+    verifyDocument({ ...signed, signature: "YQ==" }, identity),
+    /Signature invalid/,
+  );
+  await assert.rejects(
+    verifyDocument({ ...signed, publicKey: "attacker" }, identity),
+    /Unsupported/,
+  );
+  await assert.rejects(
+    signDocument(identity, { ...receipt(), totalCents: 1 }),
+    /amounts/,
+  );
+});
+test("type substitution does not reuse a receipt signature for a voucher", async () => {
+  const signed = await signDocument(identity, receipt());
+  signed.payload = voucher();
+  await assert.rejects(verifyDocument(signed, identity), /Signature invalid/);
+});
+test("canonical serialization permits reordered JSON keys but preserves all content", async () => {
+  const signed = await signDocument(identity, receipt());
+  signed.payload = Object.fromEntries(Object.entries(signed.payload).reverse());
+  assert.equal(
+    (await verifyDocument(signed, identity)).payload.customer,
+    "Alex",
+  );
+  assert.equal(canonical({ z: 2, a: 1 }), '{"a":1,"z":2}');
