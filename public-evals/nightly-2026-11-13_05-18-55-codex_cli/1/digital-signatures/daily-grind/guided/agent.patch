+  border-radius: 50%;
+}
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+h1,
+h2 {
+  font-family: "Libre Caslon Display", Georgia, serif;
+  font-weight: 400;
+}
+h1 {
+  font-size: clamp(44px, 4.7vw, 69px);
+  line-height: 1.05;
+  letter-spacing: -1.7px;
+  margin: 23px 0 18px;
+}
+.hero-copy > p {
+  font-size: 12px;
+  line-height: 1.9;
