@@ -0,0 +1,336 @@
+import {
+  loadIdentity,
+  signDocument,
+  verifyDocument,
+  publicIdentity,
+} from "./signing.mjs";
+const $ = (selector) => document.querySelector(selector);
+const money = (cents) =>
+  new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(
+    cents / 100,
+  );
+const coffees = {
+  maple: { name: "Maple Oat Latte", unitCents: 550 },
+  espresso: { name: "Dark Roast Espresso", unitCents: 350 },
+  coldbrew: { name: "Cold Brew", unitCents: 450 },
+};
+let identity,
+  currentDocument,
+  activeTab = "receipt",
+  revision = 0;
+function notice(message, error = false) {
+  const el = $("#notice");
+  el.textContent = message;
+  el.classList.toggle("error", error);
+  el.hidden = false;
+}
+function status(title, subtitle, state = "") {
+  const el = $("#signature-status");
+  el.className = `signature-status ${state}`;
+  el.querySelector("strong").textContent = title;
+  el.querySelector("small").textContent = subtitle;
+}
+function line(title, detail, price) {
+  const row = document.createElement("div");
+  row.className = "receipt-item";
+  const group = document.createElement("div"),
+    strong = document.createElement("strong"),
+    small = document.createElement("small"),
+    value = document.createElement("span");
+  strong.textContent = title;
+  small.textContent = detail;
+  value.textContent = price;
+  group.append(strong, small);
+  row.append(group, value);
+  return row;
+}
+function renderPreview(payload, signed = false) {
+  $("#preview-label").textContent = signed
+    ? "YOUR SIGNED DOCUMENT"
+    : `A PREVIEW OF YOUR ${payload.type === "receipt" ? "RECEIPT" : "VOUCHER"}`;
+  $("#preview-kind").textContent =
+    payload.type === "receipt" ? "COFFEE RECEIPT" : "GIFT VOUCHER";
+  $("#preview-id").textContent = signed ? payload.id.slice(-12) : "PREVIEW";
+  const content = $("#preview-content");
+  content.replaceChildren();
+  if (payload.type === "receipt") {
+    payload.items.forEach((item) =>
+      content.append(
+        line(
+          item.name,
+          `${item.quantity} × ${money(item.unitCents)}`,
+          money(item.unitCents * item.quantity),
+        ),
+      ),
+    );
+    if (payload.customer)
+      content.append(line(`For ${payload.customer}`, "", ""));
+  } else {
+    content.append(
+      line(
+        `For ${payload.recipient || "someone special"}`,
+        payload.message || "A little coffee love, just for you.",
+        "♡",
+      ),
+    );
+    if (signed)
+      content.append(
+        line(
+          "Valid until",
+          new Date(payload.expiresAt).toLocaleDateString(),
+          "",
+        ),
+      );
+  }
+  $("#preview-total-label").textContent =
+    payload.type === "receipt" ? "Total · USD" : "Gift value · USD";
+  $("#preview-total").textContent = money(
+    payload.type === "receipt" ? payload.totalCents : payload.amountCents,
+  );
+  status(
+    signed ? "Digitally signed" : "Ready for your signature",
+    signed
+      ? "Protected with your browser’s key."
+      : "Authenticity is in the details.",
+    signed ? "signed" : "",
+  );
+  $("#document-actions").hidden = !signed;
+}
+function draft(type) {
+  const data = new FormData($(`#${type}-form`));
+  if (type === "receipt") {
+    const item = {
+      ...coffees[data.get("coffee")],
+      quantity: Number(data.get("quantity")) || 1,
+    };
+    return {
+      type,
+      items: [item],
+      customer: data.get("customer").trim(),
+      totalCents: item.unitCents * item.quantity,
+    };
+  }
+  return {
+    type,
+    recipient: data.get("recipient").trim(),
+    message: data.get("message").trim(),
+    amountCents: Number(data.get("amount")),
+  };
+}
+function refreshDraft() {
+  revision++;
+  currentDocument = null;
+  $("#notice").hidden = true;
+  const payload = draft(activeTab);
+  renderPreview(payload);
+  if (activeTab === "receipt")
+    $("#receipt-total").textContent = money(payload.totalCents);
+}
+function selectTab(name, focus = false) {
+  revision++;
+  activeTab = name;
+  document.querySelectorAll("[data-tab]").forEach((tab) => {
+    const selected = tab.dataset.tab === name;
+    tab.setAttribute("aria-selected", String(selected));
+    tab.tabIndex = selected ? 0 : -1;
+    $(`#panel-${tab.dataset.tab}`).hidden = !selected;
+    if (selected && focus) tab.focus();
+  });
+  $("#notice").hidden = true;
+  if (name !== "verify") refreshDraft();
+}
+document.querySelectorAll("[data-tab]").forEach((tab, i, tabs) => {
+  tab.addEventListener("click", () => selectTab(tab.dataset.tab));
+  tab.addEventListener("keydown", (event) => {
+    let next;
+    if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
+    if (event.key === "ArrowLeft") next = (i + tabs.length - 1) % tabs.length;
+    if (event.key === "Home") next = 0;
+    if (event.key === "End") next = tabs.length - 1;
+    if (next !== undefined) {
+      event.preventDefault();
+      selectTab(tabs[next].dataset.tab, true);
+    }
+  });
+});
+document
+  .querySelectorAll("[data-open]")
+  .forEach((link) =>
+    link.addEventListener("click", () => selectTab(link.dataset.open)),
+  );
+for (const type of ["receipt", "voucher"]) {
+  const form = $(`#${type}-form`);
+  form.addEventListener("input", refreshDraft);
+  form.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    const button = form.querySelector("button[type=submit]");
+    button.disabled = true;
+    const startedAtRevision = revision;
+    // Capture the form before awaiting crypto; don't display changed data as signed.
+    const payload = draft(type);
+    const issuedAt = new Date();
+    const expiresAt = new Date(issuedAt);
+    expiresAt.setUTCFullYear(expiresAt.getUTCFullYear() + 1);
+    Object.assign(payload, {
+      issuer: "The Daily Grind · Local workspace",
+      currency: "USD",
+      id: `DG-${type === "receipt" ? "R" : "V"}-${Array.from(
+        crypto.getRandomValues(new Uint8Array(6)),
+        (n) => n.toString(16).padStart(2, "0"),
+      )
+        .join("")
+        .toUpperCase()}`,
+      issuedAt: issuedAt.toISOString(),
+    });
+    if (type === "voucher") payload.expiresAt = expiresAt.toISOString();
+    try {
+      if (!identity)
+        throw new Error(
+          "Your signing key is not ready. Check the key status below.",
+        );
+      const signed = await signDocument(identity, payload);
+      await verifyDocument(signed, identity);
+      if (activeTab !== type || revision !== startedAtRevision) return;
+      currentDocument = signed;
+      renderPreview(signed.payload, true);
+      notice(
+        `${type === "receipt" ? "Receipt" : "Gift voucher"} signed and checked successfully. Download your document to keep a verifiable copy. This is a local sample, not proof of payment or redeemable credit.`,
+      );
+    } catch (error) {
+      if (revision === startedAtRevision) notice(error.message, true);
+    } finally {
+      button.disabled = !identity;
+    }
+  });
+}
+function download(value, name) {
+  const url = URL.createObjectURL(
+    new Blob([JSON.stringify(value, null, 2)], { type: "application/json" }),
+  );
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = name;
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$("#download-document").addEventListener("click", () => {
+  if (currentDocument)
+    download(currentDocument, `${currentDocument.payload.id}.json`);
+});
+$("#export-key").addEventListener("click", async () => {
+  try {
+    download(
+      await publicIdentity(identity),
+      `daily-grind-public-key-${identity.keyId.slice(0, 12)}.json`,
+    );
+  } catch (error) {
+    notice(error.message, true);
+  }
+});
+$("#check-document").addEventListener("click", () => {
+  if (!currentDocument) return;
+  $("#verify-input").value = JSON.stringify(currentDocument, null, 2);
+  selectTab("verify");
+  $("#verify-form").requestSubmit();
+});
+$("#document-file").addEventListener("change", async (event) => {
+  revision++;
+  const startedAtRevision = revision;
+  const file = event.target.files[0];
+  if (!file) return;
+  currentDocument = null;
+  status("Ready to verify", "Check the uploaded document.");
+  $("#document-actions").hidden = true;
+  try {
+    if (file.size > 100000)
+      throw new Error("Choose a JSON document smaller than 100 KB.");
+    const text = await file.text();
+    if (revision !== startedAtRevision) return;
+    $("#verify-input").value = text;
+    $("#notice").hidden = true;
+  } catch (error) {
+    if (revision !== startedAtRevision) return;
+    event.target.value = "";
+    $("#verify-input").value = "";
+    notice(error.message, true);
+  }
+});
+$("#verify-input").addEventListener("input", () => {
+  revision++;
+  $("#notice").hidden = true;
+  status("Ready to verify", "Check the document after any edits.");
+  $("#document-actions").hidden = true;
+  currentDocument = null;
+});
+$("#verify-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+  const button = event.target.querySelector("button[type=submit]");
+  button.disabled = true;
+  const startedAtRevision = revision;
+  try {
+    const text = $("#verify-input").value;
+    if (new TextEncoder().encode(text).length > 100000)
+      throw new Error("Document exceeds the 100 KB limit.");
+    let document;
+    try {
+      document = JSON.parse(text);
+    } catch {
+      throw new Error(
+        "Unable to read this document. Paste or upload the complete signed JSON file.",
+      );
+    }
+    if (!identity)
+      throw new Error(
+        "Your trusted verification key is unavailable. Check the key status below.",
+      );
+    const result = await verifyDocument(document, identity);
+    if (revision !== startedAtRevision) return;
+    currentDocument = document;
+    renderPreview(result.payload, true);
+    status(
+      result.expired
+        ? "Valid signature · voucher expired"
+        : "Signature verified",
+      "Matches this browser’s trusted key.",
+      result.expired ? "failed" : "signed",
+    );
+    notice(
+      result.expired
+        ? "The signature is authentic and the contents are unchanged, but this voucher has expired. It is a local sample and has no redeemable value."
+        : "Signature verified. The document is unchanged and was signed by this browser’s trusted key. This confirms local signer identity, not merchant authorization or payment.",
+      result.expired,
+    );
+  } catch (error) {
+    if (revision !== startedAtRevision) return;
+    currentDocument = null;
+    $("#document-actions").hidden = true;
+    status(
+      "Verification unsuccessful",
+      "Do not rely on this document.",
+      "failed",
+    );
+    notice(error.message, true);
+  } finally {
+    button.disabled = false;
+  }
+});
+// Disable only signing while storage initializes; verification reports actionable errors.
+document
+  .querySelectorAll("#receipt-form .submit, #voucher-form .submit")
+  .forEach((button) => (button.disabled = true));
+loadIdentity()
+  .then((key) => {
+    identity = key;
+    $("#key-status").textContent =
+      `Your browser’s key · ${key.keyId.slice(0, 12)}…`;
+    $("#key-fingerprint").textContent =
+      `Trusted public key fingerprint (SHA-256): ${key.keyId}`;
+    $("#export-key").disabled = false;
+    document
+      .querySelectorAll("#receipt-form .submit, #voucher-form .submit")
+      .forEach((button) => (button.disabled = false));
+  })
+  .catch((error) => {
+    $("#key-status").textContent = "Signing unavailable";
+    notice(error.message, true);
+  });
