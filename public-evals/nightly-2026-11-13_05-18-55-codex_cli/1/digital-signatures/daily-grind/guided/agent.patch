+test("payload is snapshotted before asynchronous signing", async () => {
+  const payload = receipt();
+  const pending = signDocument(identity, payload);
+  payload.customer = "Changed";
+  const signed = await pending;
+  assert.equal(
+    (await verifyDocument(signed, identity)).payload.customer,
+    "Alex",
+  );
