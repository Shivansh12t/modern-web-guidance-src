+  font-size: 8px;
+  letter-spacing: 2px;
+  margin-top: 5px;
+  font-weight: 500;
+}
+.site-header nav {
+  display: flex;
+  align-items: center;
+  gap: 30px;
+  font-size: 12px;
+  color: #72766e;
+}
+.site-header .nav-active {
+  color: var(--green);
+  position: relative;
+}
+.nav-active:after {
+  content: "";
+  position: absolute;
+  bottom: -38px;
+  height: 2px;
+  left: 0;
+  right: 0;
+  background: var(--green);
+}
+.header-action {
+  border: 1px solid #cfd3c7;
+  border-radius: 5px;
+  padding: 11px 16px;
+  font-size: 11px;
+  font-weight: 600;
+}
+.header-action span {
+  margin-left: 20px;
+}
+.hero {
+  max-width: 1440px;
+  margin: auto;
+  padding: 39px 5% 45px;
+  display: grid;
+  grid-template-columns: 1.1fr 1fr;
+  gap: 35px;
+  align-items: center;
+}
+.eyebrow {
