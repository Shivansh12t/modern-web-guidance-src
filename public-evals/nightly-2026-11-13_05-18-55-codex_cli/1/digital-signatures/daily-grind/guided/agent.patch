+  background: #faf9f5;
+  font-synthesis: none;
+  --green: #293f33;
+  --muted: #777b72;
+  --border: #e4e5dc;
+}
+* {
+  box-sizing: border-box;
+}
+html {
+  scroll-behavior: smooth;
+  scroll-padding-top: 25px;
+}
+body {
+  margin: 0;
+}
+button,
+input,
+select,
+textarea {
+  font: inherit;
+}
+button,
+a,
+input,
+select,
+textarea {
+  -webkit-tap-highlight-color: transparent;
+}
+button,
+a {
+  touch-action: manipulation;
+}
+button {
+  cursor: pointer;
+}
+a {
+  color: inherit;
+  text-decoration: none;
+}
+button:disabled {
+  cursor: wait;
+  opacity: 0.5;
+}
+a:focus-visible,
+button:focus-visible,
+summary:focus-visible {
+  outline: 3px solid #a17c44;
+  outline-offset: 5px;
+}
+input:focus,
+select:focus,
+textarea:focus {
+  outline: 2px solid #718469;
+  outline-offset: 2px;
+}
+[hidden] {
+  display: none !important;
+}
+.announcement {
+  background: var(--green);
+  color: #f2f1e7;
+  text-align: center;
+  font-size: 11px;
+  letter-spacing: 0.3px;
+  padding: 10px 16px;
+}
+.announcement span {
+  color: #bdc8b8;
+  margin-left: 6px;
+}
+.site-header {
+  max-width: 1440px;
+  margin: auto;
+  min-height: 98px;
+  padding: 20px 5%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 25px;
+  border-bottom: 1px solid var(--border);
+}
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  font-size: 16px;
+  font-weight: 750;
+  letter-spacing: 1.5px;
+  white-space: nowrap;
+}
+.brand-icon {
+  font-family: Georgia, serif;
+  font-size: 43px;
+  line-height: 1;
+  transform: rotate(-30deg);
+}
+.brand small {
