@@ -0,0 +1,226 @@
+// Only public material is serialized. The signing private key is non-exportable.
+const KEY_ALGORITHM = { name: "ECDSA", namedCurve: "P-256" };
+const SIGN_ALGORITHM = { name: "ECDSA", hash: "SHA-256" };
+const encoder = new TextEncoder();
+export const SUITE = "ECDSA-P256-SHA256";
+export function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (value && typeof value === "object")
+    return `{${Object.keys(value)
+      .sort()
+      .map((k) => `${JSON.stringify(k)}:${canonical(value[k])}`)
+      .join(",")}}`;
+  return JSON.stringify(value);
+}
+function base64(bytes) {
+  return btoa(String.fromCharCode(...new Uint8Array(bytes)));
+}
+function unbase64(value) {
+  if (typeof value !== "string" || !/^[A-Za-z0-9+/]+={0,2}$/.test(value))
+    throw new Error("Invalid signature encoding.");
+  return Uint8Array.from(atob(value), (c) => c.charCodeAt(0));
+}
+export async function fingerprint(publicKey) {
+  const raw = await crypto.subtle.exportKey("raw", publicKey);
+  return Array.from(
+    new Uint8Array(await crypto.subtle.digest("SHA-256", raw)),
+    (b) => b.toString(16).padStart(2, "0"),
+  ).join("");
+}
+export async function generateIdentity() {
+  const pair = await crypto.subtle.generateKey(KEY_ALGORITHM, false, [
+    "sign",
+    "verify",
+  ]);
+  return { ...pair, keyId: await fingerprint(pair.publicKey) };
+}
+export async function publicIdentity(identity) {
+  return {
+    format: "daily-grind-public-key-v1",
+    algorithm: SUITE,
+    keyId: identity.keyId,
+    publicKey: await crypto.subtle.exportKey("jwk", identity.publicKey),
+  };
+}
+function validatePayload(p) {
+  if (
+    !p ||
+    typeof p !== "object" ||
+    !["receipt", "voucher"].includes(p.type) ||
+    p.issuer !== "The Daily Grind · Local workspace" ||
+    p.currency !== "USD" ||
+    typeof p.id !== "string" ||
+    !/^DG-[RV]-[A-F0-9]{12}$/.test(p.id) ||
+    typeof p.issuedAt !== "string" ||
+    !Number.isFinite(Date.parse(p.issuedAt))
+  )
+    throw new Error("This is not a supported Daily Grind document.");
+  const text = (v, max) => typeof v === "string" && v.length <= max;
+  const amount = (v) => Number.isSafeInteger(v) && v > 0 && v <= 1000000;
+  if (p.type === "receipt") {
+    if (
+      !text(p.customer, 80) ||
+      !Array.isArray(p.items) ||
+      p.items.length !== 1 ||
+      !amount(p.totalCents)
+    )
+      throw new Error("Invalid receipt details.");
+    const item = p.items[0];
+    if (
+      !item ||
+      !text(item.name, 80) ||
+      !amount(item.unitCents) ||
+      !Number.isInteger(item.quantity) ||
+      item.quantity < 1 ||
+      item.quantity > 20 ||
+      p.totalCents !== item.unitCents * item.quantity
+    )
+      throw new Error("Receipt amounts do not match.");
+  } else if (
+    !text(p.recipient, 80) ||
+    !p.recipient.trim() ||
+    !text(p.message, 160) ||
+    ![1000, 2500, 5000, 10000].includes(p.amountCents) ||
+    typeof p.expiresAt !== "string" ||
+    !Number.isFinite(Date.parse(p.expiresAt)) ||
+    Date.parse(p.expiresAt) <= Date.parse(p.issuedAt)
+  )
+    throw new Error("Invalid gift voucher details.");
+}
+function signedBytes(document) {
+  // Classical algorithms ignore a context option. Bind a length-prefixed domain
+  // header and all envelope metadata, including document type, to the signature.
+  const context = encoder.encode(`daily-grind:${document.payload.type}:v1`);
+  const body = encoder.encode(
+    canonical({
+      version: document.version,
+      algorithm: document.algorithm,
+      keyId: document.keyId,
+      payload: document.payload,
+    }),
+  );
+  const framed = new Uint8Array(1 + context.length + body.length);
+  framed[0] = context.length;
+  framed.set(context, 1);
+  framed.set(body, context.length + 1);
+  return framed;
+}
+export async function signDocument(identity, payload) {
+  validatePayload(payload);
+  // Snapshot before the asynchronous signing operation.
+  const document = {
+    version: 1,
+    algorithm: SUITE,
+    keyId: identity.keyId,
+    payload: JSON.parse(JSON.stringify(payload)),
+  };
+  document.signature = base64(
+    await crypto.subtle.sign(
+      SIGN_ALGORITHM,
+      identity.privateKey,
+      signedBytes(document),
+    ),
+  );
+  return document;
+}
+export async function verifyDocument(
+  document,
+  trustedIdentity,
+  now = Date.now(),
+) {
+  if (
+    !document ||
+    document.version !== 1 ||
+    document.algorithm !== SUITE ||
+    Object.keys(document).sort().join(",") !==
+      "algorithm,keyId,payload,signature,version"
+  )
+    throw new Error("Unsupported or incomplete signed document.");
+  if (!trustedIdentity || document.keyId !== trustedIdentity.keyId)
+    throw new Error(
+      "Unknown signing key. This document was not signed by this browser’s trusted key.",
+    );
+  validatePayload(document.payload);
+  const signature = unbase64(document.signature);
+  if (
+    signature.length !== 64 ||
+    !(await crypto.subtle.verify(
+      SIGN_ALGORITHM,
+      trustedIdentity.publicKey,
+      signature,
+      signedBytes(document),
+    ))
+  )
+    throw new Error(
+      "Signature invalid. The document may have been changed or signed with a different key.",
+    );
+  return {
+    payload: document.payload,
+    expired:
+      document.payload.type === "voucher" &&
+      Date.parse(document.payload.expiresAt) <= now,
+  };
+}
+export async function loadIdentity() {
+  if (!globalThis.isSecureContext || !globalThis.crypto?.subtle)
+    throw new Error(
+      "Signing requires a secure connection (HTTPS or localhost) and a browser with Web Crypto support.",
+    );
+  const db = await new Promise((resolve, reject) => {
+    const req = indexedDB.open("daily-grind-signing", 1);
+    req.onupgradeneeded = () => req.result.createObjectStore("keys");
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () =>
+      reject(
+        new Error(
+          "Browser key storage is unavailable. Allow site storage to sign documents.",
+        ),
+      );
+    req.onblocked = () =>
+      reject(
+        new Error(
+          "Key storage is blocked. Close other Daily Grind tabs and reload.",
+        ),
+      );
+  });
+  try {
+    const read = () =>
+      new Promise((resolve, reject) => {
+        const tx = db.transaction("keys", "readonly");
+        const req = tx.objectStore("keys").get("identity");
+        tx.oncomplete = () => resolve(req.result);
+        tx.onerror = tx.onabort = () =>
+          reject(new Error("Unable to read your browser signing key."));
+      });
+    let identity = await read();
+    if (!identity) {
+      const candidate = await generateIdentity();
+      // Read and write in one transaction so concurrent tabs share one identity.
+      identity = await new Promise((resolve, reject) => {
+        const tx = db.transaction("keys", "readwrite");
+        const store = tx.objectStore("keys");
+        const req = store.get("identity");
+        let selected;
+        req.onsuccess = () => {
+          selected = req.result || candidate;
+          if (!req.result) store.put(candidate, "identity");
+        };
+        tx.oncomplete = () => resolve(selected);
+        tx.onerror = tx.onabort = () =>
+          reject(
+            new Error(
+              "Unable to save your signing key. Allow browser site storage and reload.",
+            ),
+          );
+      });
+    }
+    if (
+      identity.privateKey.extractable ||
+      identity.keyId !== (await fingerprint(identity.publicKey))
+    )
+      throw new Error("Stored signing key is invalid.");
+    return identity;
+  } finally {
+    db.close();
+  }
+}
