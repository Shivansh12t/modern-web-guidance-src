+import { algorithm, createSignedDocument, fingerprint, verifyDocument } from './signing.mjs';
+const $ = selector => document.querySelector(selector);
+let currentTab = 'receipt';
+let recent = [];
+try { const saved = JSON.parse(localStorage.getItem('dg-documents') || '[]'); if (Array.isArray(saved)) recent = saved.filter(d => d?.payload && typeof d.signature === 'string').slice(0, 5); } catch { /* A damaged history must not prevent signing. */ }
+const currency = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+function openKeyDatabase() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-keys', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('keys');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(new Error('Browser key storage is unavailable. Enable site storage and try again.'));
+    request.onblocked = () => reject(new Error('Close other Daily Grind tabs and reload to open key storage.'));
+  });
+}
+async function loadKeys() {
+  if (!globalThis.isSecureContext || !crypto.subtle) throw new Error('Secure signing needs HTTPS or localhost and a browser with Web Crypto support.');
+  const database = await openKeyDatabase();
+  try {
+    const stored = await new Promise((resolve, reject) => {
+      const request = database.transaction('keys').objectStore('keys').get('issuer');
+      request.onsuccess = () => resolve(request.result);
+      request.onerror = () => reject(new Error('Could not read the browser signing key.'));
+    });
+    if (stored?.privateKey && stored?.publicKey) return stored;
+    const pair = await crypto.subtle.generateKey(algorithm, false, ['sign', 'verify']);
+    // The write transaction is serialized across tabs. Keep an existing key if another tab won the race.
+    return await new Promise((resolve, reject) => {
+      const transaction = database.transaction('keys', 'readwrite');
+      const store = transaction.objectStore('keys');
+      let selected = pair;
+      const request = store.get('issuer');
+      request.onsuccess = () => { if (request.result) selected = request.result; else store.put(pair, 'issuer'); };
+      transaction.oncomplete = () => resolve(selected);
+      transaction.onerror = () => reject(new Error('Could not save your signing key. Enable browser storage and reload.'));
+      transaction.onabort = () => reject(new Error('The key could not be saved. Reload to try again.'));
+    });
+  } finally { database.close(); }
+}
+const keyPromise = loadKeys();
+// Mark as handled immediately, while keeping failures visible to every action.
+keyPromise.catch(error => showError(error));
+function element(tag, text, className) {
+  const node = document.createElement(tag);
+  if (text !== undefined) node.textContent = text;
+  if (className) node.className = className;
+  return node;
+}
+function showError(error) {
+  const result = $('#result');
+  result.replaceChildren(element('strong', 'We couldn’t complete that.'), element('p', error.message || 'Something went wrong. Please try again.'));
+  result.className = 'result error'; result.hidden = false;
+}
+function download(data, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+  const link = element('a'); link.href = url; link.download = filename; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+function downloadDocument(doc) { download(doc, `daily-grind-${doc.payload.type}-${String(doc.payload.id).replace(/[^a-z0-9-]/gi, '').slice(0, 40)}.json`); }
+function action(text, callback) {
+  const button = element('button', text, 'text-link'); button.type = 'button'; button.addEventListener('click', callback); return button;
+}
+async function verify(doc) {
+  try {
+    const keys = await keyPromise;
+    const payload = await verifyDocument(doc, keys.publicKey);
+    const result = $('#result'); result.className = 'result'; result.hidden = false;
+    result.replaceChildren(element('strong', '✓ Signature verified. Every detail is intact.'), element('p', `${payload.type === 'receipt' ? 'Receipt' : 'Gift voucher'} · ${payload.reference} · ${payload.customer} · ${currency(payload.amountCents)}`), element('p', 'Signed by this browser’s saved issuer key. This confirms integrity and the local signer; it does not confirm payment or voucher redemption.'));
+    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+  } catch (error) { showError(error); }
+}
+function switchTab(tab, focus = false) {
+  currentTab = tab;
+  document.querySelectorAll('[data-tab]').forEach(button => {
+    const selected = button.dataset.tab === tab;
+    button.classList.toggle('active', selected); button.setAttribute('aria-selected', selected); button.tabIndex = selected ? 0 : -1;
+    if (selected && focus) button.focus();
+  });
+  $('#create-panel').setAttribute('aria-labelledby', tab === 'voucher' ? 'voucher-tab' : 'receipt-tab');
+  $('#create-panel').hidden = tab === 'verify'; $('#verify-panel').hidden = tab !== 'verify'; $('#result').hidden = true;
+  const voucher = tab === 'voucher';
+  $('#form-title').textContent = voucher ? 'Give a little daily joy.' : 'Make it official.';
+  $('#form-description').textContent = voucher ? 'Create a signed gift voucher for someone special.' : 'Create a signed receipt for your daily pick-me-up.';
+  $('#name-label').textContent = voucher ? 'Recipient name' : 'Customer name';
+  $('#reference-label').textContent = voucher ? 'Voucher reference' : 'Order reference';
+  $('#reference').placeholder = voucher ? 'e.g. GIFT-1042' : 'e.g. DG-1042';
+  $('#coffee-field').hidden = voucher; $('#quantity-field').hidden = voucher;
+  $('#value-field').hidden = !voucher; $('#sender-field').hidden = !voucher; $('#sender').required = voucher;
+  $('#sign-button').replaceChildren(element('span', voucher ? 'Sign gift voucher' : 'Sign receipt'), element('span', '↗'));
+}
+document.querySelectorAll('[data-tab]').forEach(button => {
+  button.addEventListener('click', () => switchTab(button.dataset.tab));
+  button.addEventListener('keydown', event => {
+    const tabs = ['receipt', 'voucher', 'verify']; let index = tabs.indexOf(currentTab);
+    if (event.key === 'ArrowRight') index = (index + 1) % 3;
+    else if (event.key === 'ArrowLeft') index = (index + 2) % 3;
+    else if (event.key === 'Home') index = 0;
+    else if (event.key === 'End') index = 2;
+    else return;
+    event.preventDefault(); switchTab(tabs[index], true);
+  });
+});
+document.querySelectorAll('[data-open]').forEach(link => link.addEventListener('click', () => switchTab(link.dataset.open)));
+document.querySelectorAll('[data-coffee]').forEach(button => button.addEventListener('click', () => {
+  switchTab('receipt'); $('#coffee').value = button.dataset.coffee; $('#studio').scrollIntoView({ behavior: 'smooth' }); $('#customer').focus({ preventScroll: true });
+}));
+$('#document-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!$('#customer').value.trim() || !$('#reference').value.trim() || (currentTab === 'voucher' && !$('#sender').value.trim())) { showError(new Error('Please enter a name, reference, and sender when creating a voucher.')); return; }
+  const button = $('#sign-button'); button.disabled = true;
+  try {
+    const keys = await keyPromise;
+    const fields = { type: currentTab, customer: $('#customer').value.trim(), reference: $('#reference').value.trim(), currency: 'USD' };
+    if (currentTab === 'receipt') {
+      const [item, price] = $('#coffee').value.split('|'); const quantity = Number($('#quantity').value);
+      Object.assign(fields, { item, quantity, amountCents: Math.round(Number(price) * 100) * quantity });
+    } else Object.assign(fields, { amountCents: Number($('#gift-value').value) * 100, sender: $('#sender').value.trim() });
+    const doc = await createSignedDocument(fields, keys);
+    await verifyDocument(doc, keys.publicKey);
+    recent.unshift(doc); recent = recent.slice(0, 5);
+    let saved = true;
+    try { localStorage.setItem('dg-documents', JSON.stringify(recent)); } catch { saved = false; }
+    renderRecent();
+    const result = $('#result'); result.className = 'result'; result.hidden = false;
+    result.replaceChildren(element('strong', `✓ Your ${fields.type === 'receipt' ? 'receipt' : 'gift voucher'} is signed and sealed.`), element('p', `${fields.reference} · ${fields.customer} · ${currency(fields.amountCents)}`), element('p', saved ? 'Saved on this device. Download a copy to keep your signed document.' : 'Device history could not be saved. Download your signed document now.'), action('Download document ↓', () => downloadDocument(doc)), action('Verify signature →', () => verify(doc)));
+  } catch (error) { showError(error); } finally { button.disabled = false; }
+});
+$('#document-file').addEventListener('change', async event => {
+  const file = event.target.files[0]; if (!file) return;
+  if (file.size > 1024 * 1024) { showError(new Error('Please choose a JSON document smaller than 1 MB.')); event.target.value = ''; return; }
+  try { $('#document-json').value = await file.text(); $('#result').hidden = true; }
+  catch { showError(new Error('The selected file could not be read. Please choose it again.')); }
+});
+$('#document-json').addEventListener('input', () => { $('#result').hidden = true; });
+$('#verify-button').addEventListener('click', async () => {
+  const button = $('#verify-button'); button.disabled = true;
+  try {
+    const text = $('#document-json').value;
+    if (!text.trim()) throw new Error('Choose a signed document or paste its JSON contents first.');
+    if (new TextEncoder().encode(text).length > 1024 * 1024) throw new Error('The document must be smaller than 1 MB.');
+    let doc; try { doc = JSON.parse(text); } catch { throw new Error('This is not valid JSON. Use an original signed Daily Grind document.'); }
+    await verify(doc);
+  } catch (error) { showError(error); } finally { button.disabled = false; }
+});
+$('#export-key').addEventListener('click', async () => {
+  try {
+    const keys = await keyPromise;
+    download({ description: 'Daily Grind local issuer verification key. Trust this fingerprint through a separate trusted channel before using it on another device.', algorithm: 'ECDSA-P256-SHA256', keyId: await fingerprint(keys.publicKey), publicKey: await crypto.subtle.exportKey('jwk', keys.publicKey) }, 'daily-grind-public-key.json');
+  } catch (error) { showError(error); }
+});
+function renderRecent() {
+  $('#document-count').textContent = recent.length;
+  if (!recent.length) return;
+  const container = $('#recent-documents'); container.replaceChildren();
+  for (const doc of recent) {
+    const payload = doc.payload;
+    const row = element('div', undefined, 'document-row');
+    const symbol = element('div', payload.type === 'voucher' ? '♧' : '≡', 'doc-symbol');
+    const details = element('div', undefined, 'document-details');
+    details.append(element('strong', `${payload.type === 'voucher' ? 'Gift voucher' : 'Coffee receipt'} · ${String(payload.reference || '').slice(0, 60)}`), element('p', `${String(payload.customer || '').slice(0, 100)} · ${currency(Number(payload.amountCents) || 0)}`));
+    const check = action('Verify', () => { switchTab('verify'); $('#document-json').value = JSON.stringify(doc, null, 2); verify(doc); $('#studio').scrollIntoView({ behavior: 'smooth' }); }); check.className = 'row-action';
+    const save = action('Download ↓', () => downloadDocument(doc)); save.className = 'row-action';
+    // History is untrusted local storage: only a fresh cryptographic check can mark it verified.
+    row.append(symbol, details, check, save); container.append(row);
+  }
+}
+renderRecent();
