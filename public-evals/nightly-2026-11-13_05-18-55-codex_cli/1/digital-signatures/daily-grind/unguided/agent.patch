diff --git a/signing.mjs b/signing.mjs
new file mode 100644
index 0000000..4245a59
--- /dev/null
+++ b/signing.mjs
@@ -0,0 +1,48 @@
+// Canonical JSON keeps signatures independent of JSON formatting and property order.
+export function canonical(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+}
+export const algorithm = { name: 'ECDSA', namedCurve: 'P-256' };
+const signingAlgorithm = { name: 'ECDSA', hash: 'SHA-256' };
+const encode = value => new TextEncoder().encode(canonical(value));
+export function toBase64(bytes) {
+  return btoa(String.fromCharCode(...new Uint8Array(bytes)));
+}
+function fromBase64(value) {
+  if (typeof value !== 'string' || value.length > 256 || !/^[A-Za-z0-9+/]+={0,2}$/.test(value)) throw new Error('The signature format is invalid.');
+  return Uint8Array.from(atob(value), char => char.charCodeAt(0));
+}
+export async function fingerprint(publicKey) {
+  const raw = await crypto.subtle.exportKey('spki', publicKey);
+  const hash = await crypto.subtle.digest('SHA-256', raw);
+  return Array.from(new Uint8Array(hash), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export async function createSignedDocument(fields, keys) {
+  const payload = {
+    ...fields, version: 1, issuer: 'Daily Grind · local browser', algorithm: 'ECDSA-P256-SHA256',
+    keyId: await fingerprint(keys.publicKey), id: crypto.randomUUID(), issuedAt: new Date().toISOString()
+  };
+  validatePayload(payload);
+  const signature = await crypto.subtle.sign(signingAlgorithm, keys.privateKey, encode(payload));
+  return { payload, signature: toBase64(signature) };
+}
+function validatePayload(payload) {
+  if (!payload || payload.version !== 1 || payload.issuer !== 'Daily Grind · local browser' || payload.algorithm !== 'ECDSA-P256-SHA256' || !['receipt', 'voucher'].includes(payload.type)) throw new Error('This is not a supported Daily Grind document.');
+  for (const name of ['customer', 'reference', 'id', 'issuedAt', 'keyId']) {
+    if (typeof payload[name] !== 'string' || !payload[name].trim() || payload[name].length > 200) throw new Error('The document is missing required details.');
+  }
+  if (!Number.isSafeInteger(payload.amountCents) || payload.amountCents <= 0 || payload.amountCents > 100000 || payload.currency !== 'USD' || !Number.isFinite(Date.parse(payload.issuedAt))) throw new Error('The document contains invalid payment details.');
+  if (payload.type === 'receipt' && (typeof payload.item !== 'string' || !payload.item || !Number.isInteger(payload.quantity) || payload.quantity < 1 || payload.quantity > 4)) throw new Error('The receipt details are invalid.');
+  if (payload.type === 'voucher' && (typeof payload.sender !== 'string' || !payload.sender.trim())) throw new Error('The voucher sender is missing.');
+}
+export async function verifyDocument(document, trustedPublicKey) {
+  if (!document || typeof document !== 'object' || !document.payload || typeof document.signature !== 'string') throw new Error('Choose a signed Daily Grind JSON document.');
+  validatePayload(document.payload);
+  // Never trust a key supplied in the document itself.
+  if (document.payload.keyId !== await fingerprint(trustedPublicKey)) throw new Error('Unknown signing key. This document was not signed by this browser’s saved issuer key.');
+  const valid = await crypto.subtle.verify(signingAlgorithm, trustedPublicKey, fromBase64(document.signature), encode(document.payload));
+  if (!valid) throw new Error('Signature does not match. The document may have been changed or the signature is invalid.');
+  return document.payload;
+}
diff --git a/signing.test.mjs b/signing.test.mjs
new file mode 100644
index 0000000..060e613
--- /dev/null
+++ b/signing.test.mjs
@@ -0,0 +1,43 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { algorithm, canonical, createSignedDocument, verifyDocument } from './signing.mjs';
+const keys = await crypto.subtle.generateKey(algorithm, false, ['sign', 'verify']);
+const receipt = { type: 'receipt', customer: 'Alex Morgan', reference: 'DG-1042', currency: 'USD', amountCents: 1100, item: 'Maple Oat Latte', quantity: 2 };
+test('receipt verifies after a JSON download round trip and property reordering', async () => {
+  const doc = JSON.parse(JSON.stringify(await createSignedDocument(receipt, keys)));
+  doc.payload = Object.fromEntries(Object.entries(doc.payload).reverse());
+  assert.equal((await verifyDocument(doc, keys.publicKey)).amountCents, 1100);
+  assert.equal(keys.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', keys.privateKey));
+});
+test('voucher signature protects gift value, recipient and sender', async () => {
+  const doc = await createSignedDocument({ type: 'voucher', customer: 'Jamie', sender: 'Alex', reference: 'GIFT-1', currency: 'USD', amountCents: 2500 }, keys);
+  assert.equal((await verifyDocument(doc, keys.publicKey)).type, 'voucher');
+  for (const [field, value] of [['amountCents', 10000], ['customer', 'Mallory'], ['sender', 'Mallory']]) {
+    const changed = structuredClone(doc); changed.payload[field] = value;
+    await assert.rejects(verifyDocument(changed, keys.publicKey), /Signature does not match/);
+  }
+});
+test('altered order fields and signatures are rejected', async () => {
+  const doc = await createSignedDocument(receipt, keys);
+  for (const [field, value] of [['reference', 'DG-9999'], ['item', 'Free coffee'], ['quantity', 4], ['issuedAt', '2026-01-01T00:00:00.000Z']]) {
+    const changed = structuredClone(doc); changed.payload[field] = value;
+    await assert.rejects(verifyDocument(changed, keys.publicKey));
+  }
+  const changed = structuredClone(doc); changed.signature = 'A'.repeat(86) + '==';
+  await assert.rejects(verifyDocument(changed, keys.publicKey), /Signature does not match/);
+});
+test('an attacker key cannot become trusted by being included in a document', async () => {
+  const attacker = await crypto.subtle.generateKey(algorithm, false, ['sign', 'verify']);
+  const forged = await createSignedDocument(receipt, attacker);
+  forged.publicKey = await crypto.subtle.exportKey('jwk', attacker.publicKey);
+  await assert.rejects(verifyDocument(forged, keys.publicKey), /Unknown signing key/);
+  const real = await createSignedDocument(receipt, keys);
+  forged.payload.keyId = real.payload.keyId;
+  await assert.rejects(verifyDocument(forged, keys.publicKey), /Signature does not match/);
+});
+test('malformed documents and payment details fail closed', async () => {
+  for (const value of [null, {}, { payload: {}, signature: 'x' }]) await assert.rejects(verifyDocument(value, keys.publicKey));
+  await assert.rejects(createSignedDocument({ ...receipt, amountCents: -100 }, keys));
+  assert.equal(canonical({ b: 2, a: { d: 4, c: 3 } }), '{"a":{"c":3,"d":4},"b":2}');
+});
