diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..72dd80a
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,55 @@
+// The server supplies all markup and CSS. Upgrade only adds behavior.
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorited'];
+
+  #button;
+  #toggleFavorite = () => {
+    this.favorited = !this.favorited;
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { drinkId: this.dataset.drinkId, favorited: this.favorited },
+    }));
+  };
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+
+  set favorited(value) {
+    this.toggleAttribute('favorited', Boolean(value));
+  }
+
+  connectedCallback() {
+    if (!this.shadowRoot) {
+      // Older engines leave the declarative template inert. Reuse its content.
+      const template = this.querySelector(':scope > template[shadowrootmode="open"]');
+      if (!template) return;
+      this.attachShadow({ mode: 'open' }).append(template.content);
+      template.remove();
+    }
+
+    this.#button = this.shadowRoot.getElementById('favorite');
+    if (!this.#button) return;
+    this.#syncState();
+    // The stable callback is registered at most once, including after a move.
+    this.#button.addEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#toggleFavorite);
+  }
+
+  attributeChangedCallback() {
+    this.#syncState();
+  }
+
+  #syncState() {
+    this.#button?.setAttribute('aria-pressed', String(this.favorited));
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
