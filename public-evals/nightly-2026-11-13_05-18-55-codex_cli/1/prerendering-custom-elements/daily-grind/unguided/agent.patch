diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..94fd181
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,31 @@
+// Content and styles arrive in the HTML. Upgrade the existing light DOM in place.
+class DrinkCard extends HTMLElement {
+  #controller;
+
+  connectedCallback() {
+    this.#controller?.abort();
+
+    const button = this.querySelector('.favorite-toggle');
+    const name = this.querySelector('h3')?.textContent.trim();
+    if (!button || !name) return;
+
+    this.#controller = new AbortController();
+    button.addEventListener('click', () => {
+      const favorite = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(favorite));
+      button.setAttribute('aria-label', `${favorite ? 'Unfavorite' : 'Favorite'} ${name}`);
+      button.textContent = favorite ? 'Favorited' : 'Favorite';
+    }, { signal: this.#controller.signal });
+    button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+    const button = this.querySelector('.favorite-toggle');
+    if (button) button.disabled = true;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
