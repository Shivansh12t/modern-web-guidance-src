+  <nav class="breadcrumbs" aria-label="Breadcrumbs">
+    <ol id="breadcrumb-list">
+      <li><a href="/" aria-current="page">Home</a></li>
+    </ol>
+  </nav>
+
+  <script>
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    const segments = window.location.pathname.split('/').filter(Boolean);
+    // Treat the explicit index document as the home page, too.
+    if (segments[segments.length - 1] === 'index.html') segments.pop();
+
+    const pageLabels = {
+      '/menu': 'Menu',
+      '/menu/seasonal': 'Maple Oat Latte',
+      '/menu/espresso': 'Dark Roast Espresso',
+      '/menu/cold-brew': 'Cold Brew',
+      '/account': 'My Account',
+      '/about': 'Our Story',
+      '/careers': 'Join the Team',
+      '/contact': 'Contact Us',
+      '/privacy-policy': 'Privacy'
+    };
+
+    if (segments.length > 0) {
+      breadcrumbList.querySelector('a').removeAttribute('aria-current');
+      let path = '';
+      segments.forEach((segment, index) => {
+        path += '/' + segment;
+        const item = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = path;
+        // Use textContent so URL segments are always rendered as text.
+        link.textContent = pageLabels[path] || segment.split('-')
+          .map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
+        if (index === segments.length - 1) link.setAttribute('aria-current', 'page');
+        item.append(link);
+        breadcrumbList.append(item);
+      });
+    }
+  </script>
