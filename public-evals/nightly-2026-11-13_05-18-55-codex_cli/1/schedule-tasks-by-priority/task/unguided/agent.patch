+  <script>
+    (() => {
+      const definitions = {
+        urgent: { label: 'Checkout', rank: 1, steps: 18 },
+        standard: { label: 'Menu update', rank: 2, steps: 40 },
+        background: { label: 'Telemetry logging', rank: 3, steps: 65 }
+      };
+      const queue = [];
+      let nextId = 0;
+      let completed = 0;
+      let scheduled = false;
+      let lastActive = null;
+      const byId = id => document.getElementById(id);
+      const list = byId('task-list');
+      const log = byId('activity-log');
+      const announce = message => { byId('queue-announcement').textContent = message; };
+      const sortQueue = () => queue.sort((a, b) => a.rank - b.rank || a.id - b.id);
+
+      function record(message) {
+        const entry = document.createElement('li');
+        entry.textContent = message;
+        log.prepend(entry);
+        // Keep long sessions bounded while retaining the most recent activity.
+        if (log.children.length > 80) log.lastElementChild.remove();
+        byId('activity-count').textContent = `(${log.children.length})`;
+      }
+
+      function render() {
+        byId('pending-count').textContent = queue.length;
+        byId('completed-count').textContent = completed;
+        byId('queue-empty').hidden = queue.length > 0;
+        byId('queue-status').textContent = queue.length ? 'Processing · yielding between steps' : completed ? 'All tasks completed' : 'Ready when you are';
+        queue.forEach((task, index) => {
+          const active = index === 0;
+          task.state.textContent = active ? 'Running' : task.done ? 'Paused' : 'Queued';
+          const percent = Math.round(task.done / task.steps * 100);
+          task.bar.style.width = `${percent}%`;
+          task.progress.setAttribute('aria-valuenow', percent);
+          // Move only when priority changes; progress updates preserve the DOM.
+          if (list.children[index] !== task.row) list.insertBefore(task.row, list.children[index] || null);
+        });
+      }
+
+      function enqueue(types) {
+        for (const type of types) {
+          const task = { ...definitions[type], type, id: ++nextId, done: 0 };
+          task.row = document.createElement('li');
+          task.row.className = 'task-row';
+          task.row.innerHTML = `<div class="task-top"><span class="task-title">${task.label}<span class="task-id">#${String(task.id).padStart(3, '0')}</span></span><span><span class="priority priority-${type}">${type}</span><span class="task-state">Queued</span></span></div><div class="task-progress" role="progressbar" aria-label="${task.label} task ${task.id}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>`;
+          task.state = task.row.querySelector('.task-state');
+          task.progress = task.row.querySelector('.task-progress');
+          task.bar = task.progress.firstElementChild;
+          queue.push(task);
+          record(`Queued #${task.id} · ${task.label} (${type})`);
+        }
+        sortQueue();
+        render();
+        announce(`${types.length} ${types.length === 1 ? 'task' : 'tasks'} added to the queue.`);
+        if (!scheduled) {
+          scheduled = true;
+          setTimeout(runStep, 0);
+        }
+      }
+
+      function runStep() {
+        const task = queue[0];
+        if (!task) { scheduled = false; lastActive = null; return; }
+        if (lastActive !== task.id) {
+          record(`${task.done ? 'Resumed' : 'Started'} #${task.id} · ${task.label}`);
+          lastActive = task.id;
+        }
+        // Simulate CPU work in small slices. Each timeout gives input and paint
+        // a turn, and the next slice selects the highest-priority pending task.
+        const end = performance.now() + 4;
+        while (performance.now() < end) { Math.sqrt(Math.random() * 10000); }
+        task.done++;
+        if (task.done >= task.steps) {
+          queue.shift();
+          task.row.remove();
+          completed++;
+          record(`Completed #${task.id} · ${task.label}`);
+          announce(`${task.label} completed. ${queue.length} tasks remaining.`);
+        }
+        render();
+        if (queue.length) setTimeout(runStep, 30);
+        else { scheduled = false; lastActive = null; }
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      byId('run-batch').addEventListener('click', () => {
+        // Intentionally enqueue out of order to demonstrate priority scheduling.
+        enqueue(['background', 'standard', 'urgent', 'background', 'urgent', 'standard']);
+      });
+    })();
+  </script>
+
