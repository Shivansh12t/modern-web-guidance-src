+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = document.getElementById('close-tour');
+
+    // Follow the actual link bounds, including scrolling and layout changes.
+    function positionTour() {
+      if (tourStep.hidden) return;
+
+      const anchor = rewardsLink.getBoundingClientRect();
+      const width = tourStep.offsetWidth;
+      const center = anchor.left + anchor.width / 2;
+      const left = Math.max(12, Math.min(center - width / 2, window.innerWidth - width - 12));
+
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${anchor.bottom + 16}px`;
+      tourStep.style.setProperty('--arrow-left', `${Math.max(16, Math.min(center - left, width - 16))}px`);
+      requestAnimationFrame(positionTour);
+    }
+
+    rewardsLink.addEventListener('click', (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    });
+    rewardsLink.addEventListener('auxclick', (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    });
+
+    closeTour.addEventListener('click', () => {
+      tourStep.hidden = true;
+      rewardsLink.setAttribute('aria-expanded', 'false');
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    positionTour();
+  </script>
 </body>
 
