+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourButton = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    const supportsAnchors = CSS.supports('anchor-name: --rewards-link') &&
+      CSS.supports('top: anchor(bottom)');
+
+    // Keep the tour tethered in browsers without CSS Anchor Positioning, too.
+    const positionTour = () => {
+      const bounds = rewardsLink.getBoundingClientRect();
+      const left = Math.max(12, Math.min(bounds.right - tourStep.offsetWidth,
+        document.documentElement.clientWidth - tourStep.offsetWidth - 12));
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${bounds.bottom + 14}px`;
+    };
+
+    let resizeObserver;
+    tourStep.hidden = false;
+    if (supportsPopover) tourStep.showPopover();
+    if (!supportsAnchors) {
+      positionTour();
+      window.addEventListener('resize', positionTour);
+      window.addEventListener('scroll', positionTour, true);
+      resizeObserver = new ResizeObserver(positionTour);
+      resizeObserver.observe(document.querySelector('nav'));
+      resizeObserver.observe(rewardsLink);
+      resizeObserver.observe(tourStep);
+    }
+    closeTourButton.focus({ preventScroll: true });
+
+    closeTourButton.addEventListener('click', () => {
+      if (supportsPopover && tourStep.matches(':popover-open')) tourStep.hidePopover();
+      tourStep.hidden = true;
+      resizeObserver?.disconnect();
+      window.removeEventListener('resize', positionTour);
+      window.removeEventListener('scroll', positionTour, true);
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    // Preserve the destination once the tour is dismissed, including middle-clicks.
+    const preventTourNavigation = (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    };
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+  </script>
 </body>
 
