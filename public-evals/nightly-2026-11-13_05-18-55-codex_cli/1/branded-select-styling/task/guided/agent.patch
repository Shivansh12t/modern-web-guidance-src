+  <script>
+    // Keep every part branded in browsers without customizable native selects.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.querySelector('#coffee-roast');
+      const picker = select.closest('.roast-picker');
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('role', 'combobox');
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      const list = document.createElement('ul');
+      list.id = 'roast-options';
+      list.className = 'roast-options';
+      list.setAttribute('role', 'listbox');
+      list.setAttribute('aria-labelledby', 'roast-label');
+      list.hidden = true;
+      const options = Array.from(select.options, (option, index) => {
+        const item = document.createElement('li');
+        item.id = `roast-option-${index}`;
+        item.textContent = option.textContent;
+        item.setAttribute('role', 'option');
+        list.append(item);
+        return item;
+      });
+      let active = select.selectedIndex;
+      function syncSelection() {
+        trigger.textContent = select.selectedOptions[0].textContent;
+        options.forEach((item, index) => {
+          item.setAttribute('aria-selected', String(index === select.selectedIndex));
+        });
+      }
+      function highlight(index) {
+        active = (index + options.length) % options.length;
+        options.forEach((item, i) => item.dataset.active = String(i === active));
+        trigger.setAttribute('aria-activedescendant', options[active].id);
+      }
+      function setOpen(open) {
+        list.hidden = !open;
+        trigger.setAttribute('aria-expanded', String(open));
+        if (open) highlight(select.selectedIndex);
+        else trigger.removeAttribute('aria-activedescendant');
+      }
+      function choose(index) {
+        select.selectedIndex = index;
+        select.dispatchEvent(new Event('input', { bubbles: true }));
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        setOpen(false);
+        trigger.focus();
+      }
+      trigger.addEventListener('click', () => setOpen(list.hidden));
+      trigger.addEventListener('keydown', (event) => {
+        const key = event.key;
+        if (key === 'Tab' || key === 'Escape') {
+          setOpen(false);
+          if (key === 'Escape') event.preventDefault();
+          return;
+        }
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(key)) {
+          event.preventDefault();
+          const wasClosed = list.hidden;
+          if (wasClosed) setOpen(true);
+          if (key === 'Home') highlight(0);
+          else if (key === 'End') highlight(options.length - 1);
+          else if (!wasClosed) highlight(active + (key === 'ArrowDown' ? 1 : -1));
+        } else if ((key === 'Enter' || key === ' ') && !list.hidden) {
+          event.preventDefault();
+          choose(active);
+        } else if (key.length === 1 && /[a-z]/i.test(key) && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          const index = options.findIndex(item => item.textContent.toLowerCase().startsWith(key.toLowerCase()));
+          if (index !== -1) {
+            event.preventDefault();
+            if (list.hidden) setOpen(true);
+            highlight(index);
+          }
+        }
+      });
+      options.forEach((item, index) => {
+        item.addEventListener('pointermove', () => highlight(index));
+        item.addEventListener('mousedown', event => event.preventDefault());
+        item.addEventListener('click', () => choose(index));
+      });
+      document.addEventListener('click', event => {
+        if (!picker.contains(event.target)) setOpen(false);
+      });
+      trigger.addEventListener('blur', () => setOpen(false));
+      select.addEventListener('change', syncSelection);
+      syncSelection();
+      select.hidden = true;
+      picker.querySelector('label').htmlFor = trigger.id;
+      picker.append(trigger, list);
+    }
+  </script>
