+<script>
+    (() => {
+      'use strict';
+      const form = document.getElementById('rewards-form');
+      const panels = [...form.querySelectorAll('[data-step]')];
+      const progress = [...document.querySelectorAll('.steps li')];
+      const back = document.getElementById('back');
+      const summary = document.getElementById('error-summary');
+      const password = document.getElementById('password');
+      const toggle = document.querySelector('.show-password');
+      const month = document.getElementById('birth-month');
+      const day = document.getElementById('birth-day');
+      const completion = document.getElementById('completion');
+      let step = 0;
+      // This static preview never transmits, stores, logs, or includes personal data in URLs.
+      // Production requires an HTTPS POST endpoint, server validation, CSRF protection,
+      // rate limiting, email verification, and server-side password hashing (e.g. Argon2id).
+      form.noValidate = true;
+      form.hidden = false;
+      for (let n = 1; n <= 12; n++) month.add(new Option(new Intl.DateTimeFormat('en', { month: 'long' }).format(new Date(2000, n - 1, 1)), String(n)));
+      function updateDays() {
+        const selected = day.value;
+        const count = month.value ? new Date(2000, Number(month.value), 0).getDate() : 31;
+        day.replaceChildren(new Option('Day', ''));
+        for (let n = 1; n <= count; n++) day.add(new Option(String(n), String(n)));
+        day.value = Number(selected) <= count ? selected : '';
+      }
+      updateDays();
+      month.addEventListener('change', updateDays);
+      function clearError(input) {
+        input.removeAttribute('aria-invalid');
+        const error = document.getElementById(input.id + '-error');
+        if (error) { error.hidden = true; error.textContent = ''; }
+        const ids = (input.getAttribute('aria-describedby') || '').split(' ').filter(id => id && id !== input.id + '-error');
+        if (ids.length) input.setAttribute('aria-describedby', ids.join(' '));
+        else input.removeAttribute('aria-describedby');
+      }
+      function setError(input, message) {
+        const error = document.getElementById(input.id + '-error');
+        input.setAttribute('aria-invalid', 'true');
+        error.textContent = message;
+        error.hidden = false;
+        const ids = new Set((input.getAttribute('aria-describedby') || '').split(' ').filter(Boolean));
+        ids.add(error.id);
+        input.setAttribute('aria-describedby', [...ids].join(' '));
+      }
+      function validate() {
+        const invalid = [];
+        panels[step].querySelectorAll('input, select').forEach(input => {
+          clearError(input);
+          let message = '';
+          if (input.required && (input.type === 'checkbox' ? !input.checked : !input.value.trim())) message = input.id === 'terms' ? 'Please agree to the terms to continue.' : 'Please enter your ' + document.querySelector('label[for="' + input.id + '"]').textContent.toLowerCase().replace('create a ', '') + '.';
+          else if (input.type === 'email' && !input.validity.valid) message = 'Enter a valid email address, such as you@example.com.';
+          else if (input.id === 'password' && (input.value.length < 15 || input.value.length > 128)) message = 'Use between 15 and 128 characters for your password.';
+          if (message) { setError(input, message); invalid.push(input); }
+        });
+        if (step === 1 && Boolean(month.value) !== Boolean(day.value)) { setError(day, 'Choose both a birth month and day, or leave both blank.'); invalid.push(day); }
+        summary.hidden = !invalid.length;
+        summary.textContent = invalid.length ? 'Please check ' + invalid.length + (invalid.length === 1 ? ' field' : ' fields') + ' below to continue.' : '';
+        if (invalid.length) invalid[0].focus();
+        return !invalid.length;
+      }
+      function buildReview() {
+        const values = [
+          ['Name', document.getElementById('first-name').value.trim() + ' ' + document.getElementById('last-name').value.trim()],
+          ['Email', document.getElementById('email').value.trim()],
+          ['Password', 'Set · hidden for your privacy'],
+          ['Favorite', document.getElementById('favorite').value || 'No preference'],
+          ['Birthday', month.value && day.value ? month.selectedOptions[0].textContent + ' ' + day.value : 'Not provided'],
+          ['Coffee news', document.getElementById('marketing').checked ? 'Subscribed by email' : 'No thanks']
+        ];
+        const review = document.getElementById('review');
+        review.replaceChildren();
+        values.forEach(([label, value]) => {
+          const row = document.createElement('div');
+          const dt = document.createElement('dt');
+          const dd = document.createElement('dd');
+          dt.textContent = label; dd.textContent = value;
+          row.append(dt, dd); review.append(row);
+        });
+      }
+      function showStep(next) {
+        step = next;
+        summary.hidden = true;
+        panels.forEach((panel, index) => { panel.hidden = index !== step; panel.disabled = index !== step; });
+        progress.forEach((item, index) => {
+          item.classList.toggle('complete', index < step);
+          if (index === step) item.setAttribute('aria-current', 'step');
+          else item.removeAttribute('aria-current');
+        });
+        back.hidden = step === 0;
+        document.getElementById('next-label').textContent = step === 2 ? 'Complete preview' : 'Continue';
+        if (step === 2) buildReview();
+        panels[step].querySelector('legend').focus();
+      }
+      toggle.addEventListener('click', () => {
+        const show = password.type === 'password';
+        password.type = show ? 'text' : 'password';
+        toggle.textContent = show ? 'Hide' : 'Show';
+        toggle.setAttribute('aria-pressed', String(show));
+      });
+      back.addEventListener('click', () => showStep(step - 1));
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        if (!validate()) return;
+        if (step < 2) { showStep(step + 1); return; }
+        form.reset();
+        password.type = 'password';
+        toggle.textContent = 'Show'; toggle.setAttribute('aria-pressed', 'false');
+        document.getElementById('review').replaceChildren();
+        form.hidden = true;
+        completion.hidden = false;
+        completion.focus();
+      });
+      document.getElementById('restart').addEventListener('click', () => {
+        completion.hidden = true; form.hidden = false; updateDays(); showStep(0);
+      });
+    })();
+  </script>
 </body>
 
