diff --git a/scripts/performance-monitor.js b/scripts/performance-monitor.js
new file mode 100644
index 0000000..f343009
--- /dev/null
+++ b/scripts/performance-monitor.js
@@ -0,0 +1,193 @@
+(() => {
+  'use strict';
+
+  // No network requests: an analytics integration can listen for this event.
+  const eventName = 'daily-grind:performance';
+  const limit = 100;
+  const records = [];
+  const inputs = [];
+  const actions = new Map();
+  const paints = new Map();
+  const observers = [];
+  const supported = globalThis.PerformanceObserver?.supportedEntryTypes ?? [];
+  let activeNavigation = null;
+
+  function report(metric) {
+    const record = Object.freeze({ ...metric });
+    records.push(record);
+    if (records.length > limit) records.shift();
+    window.dispatchEvent(new CustomEvent(eventName, { detail: record }));
+  }
+
+  function remember(map, key, value) {
+    map.set(key, value);
+    if (map.size > limit) map.delete(map.keys().next().value);
+  }
+
+  function actionFor(target) {
+    if (!(target instanceof Element)) return null;
+    const control = target.closest('[data-performance-action]');
+    if (!control) return null;
+    const link = target.closest('a');
+    // Restrict navigation monitoring to its actual links.
+    if (control.dataset.performanceAction === 'navigation' && !link) return null;
+    return {
+      action: control.dataset.performanceAction,
+      label: link?.textContent.trim() || control.querySelector('h3')?.textContent.trim(),
+      destination: link ? new URL(link.href).pathname : null,
+    };
+  }
+
+  // Capture input timestamps without changing the event or link behavior. ICP's
+  // startTime may refer to pointerdown or keydown rather than the final click.
+  function captureInput(event) {
+    if (!event.isTrusted) return;
+    const action = actionFor(event.target);
+    if (!action) return;
+    const startTime = event.timeStamp > performance.timeOrigin
+      ? event.timeStamp - performance.timeOrigin : event.timeStamp;
+    inputs.push({ startTime, action });
+    if (inputs.length > limit) inputs.shift();
+  }
+
+  for (const type of ['pointerdown', 'pointerup', 'keydown', 'keyup', 'click']) {
+    document.addEventListener(type, captureInput, { capture: true, passive: true });
+  }
+
+  function attributedAction(entry) {
+    if (actions.has(entry.interactionId)) return actions.get(entry.interactionId);
+    // Event Timing may omit fast inputs below its minimum reporting threshold.
+    // Only match the initiating timestamp; never attribute to the latest click.
+    const input = inputs.find(input => Math.abs(input.startTime - entry.startTime) < 1);
+    if (input) remember(actions, entry.interactionId, input.action);
+    return input?.action;
+  }
+
+  function reportPaint(entry, action) {
+    report({
+      type: 'interaction-contentful-paint',
+      ...action,
+      interactionId: entry.interactionId,
+      startTime: entry.startTime,
+      duration: entry.duration,
+      presentationTime: entry.presentationTime,
+      size: entry.largestContentfulPaint?.size ?? null,
+    });
+  }
+
+  function updateNavigation(entry) {
+    // navigationId can still refer to the previous view if content painted
+    // before pushState. The initiating interaction is the stable correlation.
+    if (activeNavigation?.entry.interactionId === entry.interactionId) {
+      activeNavigation.paint = entry;
+    }
+  }
+
+  function onPaint(entry) {
+    updateNavigation(entry);
+    const action = attributedAction(entry);
+    if (action) reportPaint(entry, action);
+    else {
+      // The Event Timing observer can deliver attribution after the paint.
+      const pending = paints.get(entry.interactionId) ?? [];
+      pending.push(entry);
+      if (pending.length > limit) pending.shift();
+      remember(paints, entry.interactionId, pending);
+    }
+  }
+
+  function onEvent(entry) {
+    if (!entry.interactionId) return;
+    const action = actionFor(entry.target);
+    if (!action) return;
+    remember(actions, entry.interactionId, action);
+    const pending = paints.get(entry.interactionId);
+    if (pending) {
+      for (const paint of pending) reportPaint(paint, action);
+      paints.delete(entry.interactionId);
+    }
+    if (entry.name === 'click') {
+      // This measures the NEXT frame only, not completion of async content.
+      report({
+        type: 'interaction-next-paint',
+        ...action,
+        interactionId: entry.interactionId,
+        startTime: entry.startTime,
+        duration: entry.duration,
+      });
+    }
+  }
+
+  function finalizeNavigation() {
+    if (!activeNavigation) return;
+    const { entry, paint } = activeNavigation;
+    activeNavigation = null;
+    report({
+      type: 'soft-navigation',
+      destination: new URL(entry.name, location.href).pathname,
+      navigationId: entry.navigationId,
+      interactionId: entry.interactionId,
+      startTime: entry.startTime,
+      fcpDuration: entry.duration,
+      lcpDuration: paint?.duration ?? null,
+      size: paint?.largestContentfulPaint?.size ?? null,
+    });
+  }
+
+  function onNavigation(entry) {
+    finalizeNavigation();
+    activeNavigation = {
+      entry,
+      // Include content painted before the URL update and observer delivery.
+      paint: entry.getLargestInteractionContentfulPaint(),
+    };
+  }
+
+  function observe(type, callback, options = {}) {
+    if (!supported.includes(type)) return false;
+    try {
+      const observer = new PerformanceObserver(list => {
+        for (const entry of list.getEntries()) callback(entry);
+      });
+      observer.observe({ type, buffered: true, ...options });
+      observers.push({ observer, callback });
+      return true;
+    } catch {
+      // Experimental APIs may be listed but unavailable under browser policy.
+      return false;
+    }
+  }
+
+  const capabilities = Object.freeze({
+    interactionContentfulPaint: observe('interaction-contentful-paint', onPaint),
+    softNavigation: observe('soft-navigation', onNavigation),
+    eventTiming: observe('event', onEvent, { durationThreshold: 16 }),
+  });
+
+  function flush() {
+    // Consume queued records before finalizing the route, including on pagehide.
+    // Process soft navigations first so queued paints can update the active route.
+    for (const { observer, callback } of observers) {
+      if (callback === onNavigation) {
+        for (const entry of observer.takeRecords()) callback(entry);
+      }
+    }
+    for (const { observer, callback } of observers) {
+      if (callback !== onNavigation) {
+        for (const entry of observer.takeRecords()) callback(entry);
+      }
+    }
+    finalizeNavigation();
+  }
+
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'hidden') flush();
+  });
+  window.addEventListener('pagehide', flush);
+
+  window.dailyGrindPerformance = Object.freeze({
+    capabilities,
+    getRecords: () => records.slice(),
+    flush,
+  });
+})();
diff --git a/scripts/performance-monitor.test.cjs b/scripts/performance-monitor.test.cjs
new file mode 100644
index 0000000..287d078
--- /dev/null
+++ b/scripts/performance-monitor.test.cjs
@@ -0,0 +1,113 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const source = readFileSync(`${__dirname}/performance-monitor.js`, 'utf8');
+
+function setup(types = []) {
+  const observed = new Map();
+  const documentEvents = new Map();
+  const windowEvents = new Map();
+  const emitted = [];
+  class Element {
+    dataset = { performanceAction: 'order-now' };
+    textContent = 'Order Now';
+    href = 'https://daily-grind.example/order-online';
+    closest() { return this; }
+  }
+  class PerformanceObserver {
+    static supportedEntryTypes = types;
+    constructor(callback) { this.callback = callback; this.pending = []; }
+    observe(options) { this.options = options; observed.set(options.type, this); }
+    takeRecords() { return this.pending.splice(0); }
+  }
+  const window = {
+    addEventListener: (name, callback) => windowEvents.set(name, callback),
+    dispatchEvent: event => emitted.push(event.detail),
+  };
+  const document = {
+    visibilityState: 'visible',
+    addEventListener: (name, callback) => documentEvents.set(name, callback),
+  };
+  vm.runInNewContext(source, {
+    window, document, Element, PerformanceObserver, URL,
+    location: { href: 'https://daily-grind.example/' },
+    performance: { timeOrigin: 1000000 },
+    CustomEvent: class { constructor(name, options) { this.detail = options.detail; } },
+  });
+  const send = (type, entries) => observed.get(type).callback({ getEntries: () => entries });
+  return { observed, documentEvents, windowEvents, emitted, window, document, Element, send };
+}
+
+test('unsupported paint APIs leave the page usable without fabricated metrics', () => {
+  const app = setup();
+  assert.equal(app.observed.size, 0);
+  app.window.dailyGrindPerformance.flush();
+  assert.equal(app.emitted.length, 0);
+  assert.equal(app.window.dailyGrindPerformance.capabilities.softNavigation, false);
+});
+
+test('capture attributes fast contentful paints and retains progressive candidates', () => {
+  const app = setup(['interaction-contentful-paint']);
+  app.documentEvents.get('pointerdown')({
+    isTrusted: true, timeStamp: 100, target: new app.Element(),
+  });
+  app.send('interaction-contentful-paint', [
+    { interactionId: 7, startTime: 100, duration: 120, presentationTime: 220 },
+    { interactionId: 7, startTime: 100, duration: 300, presentationTime: 400 },
+    { interactionId: 8, startTime: 150, duration: 500 },
+  ]);
+  assert.equal(app.emitted.length, 2);
+  assert.equal(app.emitted[1].action, 'order-now');
+  assert.equal(app.emitted[1].duration, 300);
+  assert.equal(app.observed.get('interaction-contentful-paint').options.buffered, true);
+});
+
+test('late Event Timing attribution drains paints and labels next-paint separately', () => {
+  const app = setup(['event', 'interaction-contentful-paint']);
+  app.send('interaction-contentful-paint', [{ interactionId: 5, startTime: 10, duration: 200 }]);
+  app.send('event', [{
+    interactionId: 5, name: 'click', startTime: 20, duration: 32, target: new app.Element(),
+  }]);
+  assert.equal(app.emitted[0].type, 'interaction-contentful-paint');
+  assert.equal(app.emitted[0].duration, 200);
+  assert.equal(app.emitted[1].type, 'interaction-next-paint');
+  assert.equal(app.emitted[1].duration, 32);
+});
+
+test('soft navigation seeds pre-URL paint and matches later paints by interactionId', () => {
+  const app = setup(['soft-navigation', 'interaction-contentful-paint']);
+  const seeded = { duration: 80, largestContentfulPaint: { size: 200 } };
+  const navigation = {
+    name: 'https://daily-grind.example/menu', navigationId: 2, interactionId: 9,
+    startTime: 100, duration: 40,
+    getLargestInteractionContentfulPaint: () => seeded,
+  };
+  app.send('soft-navigation', [navigation]);
+  app.window.dailyGrindPerformance.flush();
+  assert.equal(app.emitted[0].lcpDuration, 80);
+  app.send('soft-navigation', [navigation]);
+  app.send('interaction-contentful-paint', [
+    { interactionId: 9, navigationId: 1, duration: 140, largestContentfulPaint: { size: 400 } },
+    { interactionId: 10, navigationId: 2, duration: 900 },
+  ]);
+  app.document.visibilityState = 'hidden';
+  app.documentEvents.get('visibilitychange')();
+  assert.equal(app.emitted[1].lcpDuration, 140);
+  assert.equal(app.emitted[1].fcpDuration, 40);
+  assert.equal(app.emitted[1].destination, '/menu');
+  app.windowEvents.get('pagehide')();
+  assert.equal(app.emitted.length, 2);
+});
+
+test('pagehide consumes pending paint records and retention stays bounded', () => {
+  const app = setup(['event']);
+  const target = new app.Element();
+  app.observed.get('event').pending.push(...Array.from({ length: 110 }, (_, index) => ({
+    interactionId: index + 1, name: 'click', target, startTime: index, duration: 24,
+  })));
+  app.windowEvents.get('pagehide')();
+  assert.equal(app.window.dailyGrindPerformance.getRecords().length, 100);
+  assert.equal(app.window.dailyGrindPerformance.getRecords()[0].interactionId, 11);
+});
