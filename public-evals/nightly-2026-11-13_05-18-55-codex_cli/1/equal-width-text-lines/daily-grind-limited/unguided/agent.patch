+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = [...heroHeading.querySelectorAll('span')];
+
+    function fitHeadingLines() {
+      const width = heroHeading.clientWidth;
+      // Measure natural text widths, then change only the font size of each line.
+      headingLines.forEach(line => { line.style.fontSize = '100px'; });
+      const lineWidths = headingLines.map(line => line.getBoundingClientRect().width);
+      headingLines.forEach((line, index) => {
+        line.style.fontSize = `${100 * width / lineWidths[index]}px`;
+      });
+    }
+
+    let previousWidth = 0;
+    const headingObserver = new ResizeObserver(([entry]) => {
+      if (entry.contentRect.width !== previousWidth) {
+        previousWidth = entry.contentRect.width;
+        fitHeadingLines();
+      }
+    });
+    headingObserver.observe(heroHeading);
+    document.fonts.ready.then(fitHeadingLines);
+  </script>
