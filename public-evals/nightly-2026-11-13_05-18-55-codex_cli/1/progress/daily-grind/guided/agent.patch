+    /* Rewards and order progress */
+    .coffee-progress {
+      margin-bottom: 40px;
+      padding: clamp(20px, 4vw, 32px);
+      background: #fff8ef;
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+    }
+
+    .coffee-progress h2 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 24px;
+      margin-top: 24px;
+    }
+
+    .progress-card {
+      padding: 20px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      min-width: 0;
+    }
+
+    .progress-heading {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 4px 12px;
+      margin-bottom: 12px;
+    }
+
+    .progress-heading label {
+      font-weight: 600;
+    }
+
+    .progress-heading span,
+    .progress-card p {
+      font-size: 0.9rem;
+    }
+
+    .progress-card p {
+      margin-top: 10px;
+    }
+
+    .coffee-progress progress {
+      --progress-fill: var(--primary);
+      --progress-radius: 100px;
+      --progress-duration: 1.8s;
+      appearance: none;
+      border: 0 solid;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      overflow: clip;
+      border-radius: var(--progress-radius);
+      background: #ece5e1;
+      container-type: inline-size;
+    }
+
+    .coffee-progress progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .coffee-progress progress::-webkit-progress-value {
+      background: var(--progress-fill);
+      border-radius: var(--progress-radius);
+      animation: var(--progress-animation, none);
+    }
+
+    .coffee-progress progress::-moz-progress-bar {
+      background: var(--progress-fill);
+      border-radius: var(--progress-radius);
+      animation: var(--progress-animation, none);
+    }
+
+    .coffee-progress progress:indeterminate {
+      --progress-fill: #a65f00;
+      --progress-animation: coffee-loading var(--progress-duration) linear infinite;
+    }
+
+    .coffee-progress progress:indeterminate:dir(rtl) {
+      --progress-animation: coffee-loading var(--progress-duration) linear infinite reverse;
+    }
+
+    @keyframes coffee-loading {
+      from, to {
+        inline-size: 30%;
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .coffee-progress progress {
+        --progress-duration: 10s;
+      }
+    }
+
