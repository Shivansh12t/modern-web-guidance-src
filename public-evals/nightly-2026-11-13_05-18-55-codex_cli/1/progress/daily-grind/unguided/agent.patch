+    /* Rewards and order progress */
+    .progress-section {
+      margin-bottom: 40px;
+      padding: 28px;
+      background: #fff8ef;
+      border: 1px solid #e8d9cb;
+      border-radius: 12px;
+    }
+
+    .progress-section > p {
+      margin-top: 4px;
+      color: #71564d;
+      font-size: 0.9rem;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 28px;
+      margin-top: 24px;
+    }
+
+    .progress-heading {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      flex-wrap: wrap;
+      gap: 4px 12px;
+      margin-bottom: 10px;
+    }
+
+    .progress-heading h3 {
+      font-size: 1rem;
+    }
+
+    .progress-heading span,
+    .progress-note {
+      font-size: 0.85rem;
+      color: #71564d;
+    }
+
+    .progress-track {
+      height: 10px;
+      overflow: hidden;
+      border-radius: 999px;
+      background: #e8ddd5;
+    }
+
+    .progress-fill {
+      height: 100%;
+      border-radius: inherit;
+      background: var(--primary);
+    }
+
+    .progress-fill--rewards {
+      width: 60%;
+    }
+
+    .progress-track--indeterminate .progress-fill {
+      width: 40%;
+      background: #a25b22;
+      animation: brewing 1.8s ease-in-out infinite;
+    }
+
+    .progress-note {
+      margin-top: 10px;
+    }
+
+    @keyframes brewing {
+      from { transform: translateX(-100%); }
+      to { transform: translateX(250%); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-track--indeterminate .progress-fill {
+        animation: none;
+        margin-inline: auto;
+      }
+    }
+
     .grid {
