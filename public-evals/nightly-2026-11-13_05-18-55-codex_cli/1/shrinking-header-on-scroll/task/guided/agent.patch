+  <script>
+    (function () {
+      var nativeScrollAnimation = window.CSS && window.CSS.supports &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (nativeScrollAnimation) return;
+
+      // Older browsers receive the same continuous, reversible 160px shrink.
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var framePending = false;
+
+      function updateNavigation() {
+        framePending = false;
+        if (reducedMotion.matches) {
+          navigation.style.removeProperty('height');
+          return;
+        }
+        var progress = Math.max(0, Math.min(1,
+          (window.pageYOffset || document.documentElement.scrollTop || 0) / 160));
+        navigation.style.height = 'calc(var(--nav-expanded) - ' +
+          (1.25 * progress) + 'rem)';
+      }
+
+      function scheduleUpdate() {
+        if (framePending) return;
+        framePending = true;
+        window.requestAnimationFrame(updateNavigation);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      updateNavigation();
+    }());
+  </script>
+
 </body>
 
