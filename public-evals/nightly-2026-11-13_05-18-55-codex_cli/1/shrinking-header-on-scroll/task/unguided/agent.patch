+  <script>
+    (function () {
+      // Use the same continuous scroll progress when CSS scroll timelines
+      // are unavailable. No time-based transition that can lag behind scrolling.
+      var nativeTimeline = window.CSS && window.CSS.supports &&
+        window.CSS.supports('animation-timeline: scroll()') &&
+        window.CSS.supports('animation-range: 0px 160px');
+      if (nativeTimeline) return;
+
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var reducedMotion = window.matchMedia ?
+        window.matchMedia('(prefers-reduced-motion: reduce)') : null;
+      var scheduled = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function updateNav() {
+        scheduled = false;
+        if (reducedMotion && reducedMotion.matches) {
+          nav.style.height = '';
+          logo.style.fontSize = '';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 160, 1));
+        nav.style.height = 'calc(var(--nav-height) - ' + progress + 'rem)';
+        logo.style.fontSize = (1.5 - 0.25 * progress) + 'rem';
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          requestFrame.call(window, updateNav);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      if (reducedMotion) {
+        if (reducedMotion.addEventListener) {
+          reducedMotion.addEventListener('change', scheduleUpdate);
+        } else if (reducedMotion.addListener) {
+          reducedMotion.addListener(scheduleUpdate);
+        }
+      }
+      updateNav();
+    }());
+  </script>
