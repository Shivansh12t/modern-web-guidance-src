+
+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      const toggle = panel.querySelector('.order-toggle');
+      const body = panel.querySelector('.order-body');
+      const form = panel.querySelector('form');
+      const drink = form.elements.drink;
+      const quantity = form.elements.quantity;
+      const total = panel.querySelector('#order-total');
+      const announcement = document.querySelector('#order-announcement');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      let drag = null;
+      let announcementTimer;
+
+      function announce(message) {
+        clearTimeout(announcementTimer);
+        announcement.textContent = '';
+        announcementTimer = setTimeout(() => { announcement.textContent = message; }, 150);
+      }
+
+      function updateOrder() {
+        const count = Number(quantity.value);
+        const valid = quantity.validity.valid;
+        const price = Number(drink.selectedOptions[0].dataset.price) + (form.elements.size.value === 'large' ? 100 : 0);
+        total.textContent = valid ? money.format(price * count / 100) : '—';
+        panel.querySelector('[data-quantity-step="-1"]').disabled = valid && count <= 1;
+        panel.querySelector('[data-quantity-step="1"]').disabled = valid && count >= 20;
+        if (valid) announce(`Order subtotal ${total.textContent}.`);
+      }
+
+      form.addEventListener('input', updateOrder);
+      panel.querySelectorAll('[data-quantity-step]').forEach(button => {
+        button.hidden = false;
+        button.addEventListener('click', () => {
+          const count = quantity.validity.valid ? Number(quantity.value) : 1;
+          quantity.value = Math.max(1, Math.min(20, count + Number(button.dataset.quantityStep)));
+          updateOrder();
+        });
+      });
+
+      function moveTo(left, top) {
+        const viewport = window.visualViewport;
+        const minLeft = viewport ? viewport.offsetLeft : 0;
+        const minTop = viewport ? viewport.offsetTop : 0;
+        const maxLeft = minLeft + Math.max(0, (viewport ? viewport.width : window.innerWidth) - panel.offsetWidth);
+        const maxTop = minTop + Math.max(0, (viewport ? viewport.height : window.innerHeight) - panel.offsetHeight);
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.style.left = `${Math.max(minLeft, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(minTop, Math.min(top, maxTop))}px`;
+      }
+
+      function keepReachable() {
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', event => {
+        if (event.button !== 0 || !event.isPrimary || drag) return;
+        const rect = panel.getBoundingClientRect();
+        drag = { id: event.pointerId, x: event.clientX - rect.left, y: event.clientY - rect.top };
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('is-dragging');
+      });
+      handle.addEventListener('pointermove', event => {
+        if (!drag || drag.id !== event.pointerId) return;
+        moveTo(event.clientX - drag.x, event.clientY - drag.y);
+      });
+      function finishDrag(event) {
+        if (!drag || drag.id !== event.pointerId) return;
+        drag = null;
+        handle.classList.remove('is-dragging');
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+        announce('Quick order panel moved.');
+      }
+      handle.addEventListener('pointerup', finishDrag);
+      handle.addEventListener('pointercancel', finishDrag);
+      handle.addEventListener('lostpointercapture', finishDrag);
+      handle.addEventListener('keydown', event => {
+        const directions = { ArrowLeft: [-15, 0, 'left'], ArrowRight: [15, 0, 'right'], ArrowUp: [0, -15, 'up'], ArrowDown: [0, 15, 'down'] };
+        const direction = directions[event.key];
+        if (!direction) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + direction[0], rect.top + direction[1]);
+        announce(`Quick order panel moved ${direction[2]}.`);
+      });
+
+      toggle.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        toggle.setAttribute('aria-expanded', String(!body.hidden));
+        toggle.setAttribute('aria-label', body.hidden ? 'Expand quick order' : 'Minimize quick order');
+        toggle.textContent = body.hidden ? '+' : '−';
+        keepReachable();
+      });
+      panel.querySelectorAll('[data-dock]').forEach(button => {
+        button.addEventListener('click', () => {
+          const viewport = window.visualViewport;
+          const width = viewport ? viewport.width : window.innerWidth;
+          const height = viewport ? viewport.height : window.innerHeight;
+          const left = viewport ? viewport.offsetLeft : 0;
+          const top = viewport ? viewport.offsetTop : 0;
+          moveTo(left + (button.dataset.dock === 'left' ? 12 : width - panel.offsetWidth - 12), top + height - panel.offsetHeight - 12);
+          announce(`Quick order panel docked ${button.dataset.dock}.`);
+        });
+      });
+      window.addEventListener('resize', keepReachable);
+      window.visualViewport?.addEventListener('resize', keepReachable);
+      window.visualViewport?.addEventListener('scroll', keepReachable);
+      new ResizeObserver(keepReachable).observe(panel);
+      toggle.hidden = false;
+      panel.querySelector('.order-position').hidden = false;
+      panel.querySelector('.order-total').hidden = false;
+      total.setAttribute('aria-live', 'off');
+      panel.classList.add('is-ready');
+      updateOrder();
+    })();
+  </script>
+
