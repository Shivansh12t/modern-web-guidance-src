+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    async function ensureWebAuthnJSON() {
+      if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function' &&
+          typeof PublicKeyCredential.prototype.toJSON === 'function') return;
+
+      // Older WebAuthn browsers need the JSON conversion APIs. Pin and integrity-check
+      // the self-contained polyfill; loading failure must leave reauthentication blocked.
+      await new Promise((resolve, reject) => {
+        const script = document.createElement('script');
+        script.type = 'module';
+        script.src = 'https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs';
+        script.integrity = 'sha384-EBLK1vCYl7ILfHGSetlZN/n8TaV5nbYKx9JrMwcJvy5NTITz1Q9HDYqCG4NxzuR0';
+        script.crossOrigin = 'anonymous';
+        script.onload = resolve;
+        script.onerror = () => reject(new Error('Unable to load passkey support. Please try again.'));
+        document.head.append(script);
+      });
+    }
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Preparing identity confirmation…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+          throw new Error('Passkey verification requires a supported browser and a secure connection.');
+        }
+        await ensureWebAuthnJSON();
+
+        // The server derives the account from the signed-in session, never a client user ID.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) throw new Error('Unable to start identity confirmation. Please try again.');
+        const options = await optionsResponse.json();
+        if (!Array.isArray(options.allowCredentials) || options.allowCredentials.length === 0 ||
+            !options.allowCredentials.every(credential =>
+              credential.type === 'public-key' && typeof credential.id === 'string' && credential.id.length > 0)) {
+          throw new Error('No registered passkey is available for this account.');
+        }
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON({
+          ...options,
+          userVerification: 'required',
+        });
+        reauthStatus.textContent = 'Use your registered passkey or security key to confirm your identity.';
+        // Only public-key credentials are requested; stored passwords cannot satisfy this ceremony.
+        const credential = await navigator.credentials.get({ publicKey });
+        if (!credential || credential.type !== 'public-key') {
+          throw new Error('Identity confirmation was not completed. Please try again.');
+        }
+        const assertion = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(assertion),
+        });
+        if (!verifyResponse.ok) {
+          if (verifyResponse.status === 404 && publicKey.rpId &&
+              typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId,
+                credentialId: assertion.id,
+              });
+            } catch {
+              // Credential synchronization is optional and cannot change verification failure.
+            }
+          }
+          throw new Error('Identity confirmation failed. Please try again.');
+        }
+        reauthStatus.textContent = 'Identity confirmed. You can now continue your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Identity confirmation was cancelled or timed out. Please try again.'
+          : error instanceof Error ? error.message : 'Identity confirmation failed. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    });
+  </script>
