+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    function decodeBase64url(value) {
+      if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+$/.test(value) || value.length % 4 === 1) {
+        throw new Error('The server returned invalid verification options.');
+      }
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')), character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Preparing identity verification…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+          throw new Error('Passkey verification requires a supported browser and a secure connection.');
+        }
+
+        // The authenticated session determines the account; never accept a client-supplied user ID.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({})
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start identity verification. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = options.publicKey ?? options;
+        // An empty allow-list would permit credentials outside this account's registered set.
+        if (!Array.isArray(publicKey.allowCredentials) || publicKey.allowCredentials.length === 0) {
+          throw new Error('No registered passkey or security key is available for this account.');
+        }
+        const requestOptions = {
+          ...publicKey,
+          challenge: decodeBase64url(publicKey.challenge),
+          allowCredentials: publicKey.allowCredentials.map(credential => {
+            if (credential.type !== 'public-key') throw new Error('The server returned invalid verification options.');
+            return { ...credential, id: decodeBase64url(credential.id) };
+          }),
+          userVerification: 'required'
+        };
+
+        reauthStatus.textContent = 'Confirm with your registered passkey or security key…';
+        // Only public-key credentials are requested. Stored passwords cannot satisfy this ceremony.
+        const credential = await navigator.credentials.get({ publicKey: requestOptions });
+        if (!credential || credential.type !== 'public-key' ||
+            !requestOptions.allowCredentials.some(allowed => encodeBase64url(allowed.id) === encodeBase64url(credential.rawId))) {
+          throw new Error('A registered passkey or security key is required.');
+        }
+        const assertion = {
+          id: credential.id,
+          rawId: encodeBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment ?? null,
+          response: {
+            clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+            authenticatorData: encodeBase64url(credential.response.authenticatorData),
+            signature: encodeBase64url(credential.response.signature),
+            userHandle: credential.response.userHandle == null ? null : encodeBase64url(credential.response.userHandle)
+          },
+          clientExtensionResults: credential.getClientExtensionResults()
+        };
+        reauthStatus.textContent = 'Verifying your identity…';
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(assertion)
+        });
+        if (!verifyResponse.ok || (await verifyResponse.json()).verified !== true) {
+          throw new Error('Identity verification failed. Please try again.');
+        }
+        reauthStatus.textContent = 'Identity confirmed. You may continue with your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Verification was canceled or timed out. Please try again.'
+          : error.message || 'Identity verification failed. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    });
+  </script>
