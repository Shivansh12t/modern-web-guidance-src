+  <script>
+    const infoButton = document.getElementById('anchor');
+    const tooltip = document.getElementById('latte-tooltip');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativePositioning = CSS.supports('container-type: anchored') &&
+      CSS.supports('position-area: block-start');
+    let tooltipOpen = false;
+    let positionFrame;
+
+    function positionTooltip() {
+      if (!tooltipOpen) return;
+      delete tooltip.dataset.placement;
+      tooltip.style.removeProperty('left');
+      tooltip.style.removeProperty('top');
+      tooltip.style.removeProperty('--arrow-x');
+
+      const anchor = infoButton.getBoundingClientRect();
+      const bounds = tooltip.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const edge = 16;
+      const gap = 12;
+      const viewportLeft = viewport?.offsetLeft ?? 0;
+      const viewportTop = viewport?.offsetTop ?? 0;
+      const viewportRight = viewportLeft + (viewport?.width ?? window.innerWidth);
+      const viewportBottom = viewportTop + (viewport?.height ?? window.innerHeight);
+
+      if (nativePositioning && bounds.left >= viewportLeft + edge &&
+          bounds.right <= viewportRight - edge && bounds.top >= viewportTop + edge &&
+          bounds.bottom <= viewportBottom - edge) return;
+
+      const above = anchor.top - gap - bounds.height;
+      const below = anchor.bottom + gap;
+      const placement = above >= viewportTop + edge ||
+        anchor.top - viewportTop >= viewportBottom - anchor.bottom ? 'top' : 'bottom';
+      const center = anchor.left + anchor.width / 2;
+      const left = Math.max(viewportLeft + edge,
+        Math.min(center - bounds.width / 2, viewportRight - bounds.width - edge));
+      const top = Math.max(viewportTop + edge, Math.min(
+        placement === 'top' ? above : below, viewportBottom - bounds.height - edge));
+
+      tooltip.dataset.placement = placement;
+      tooltip.style.left = `${left}px`;
+      tooltip.style.top = `${top}px`;
+      tooltip.style.setProperty('--arrow-x', `${Math.max(14,
+        Math.min(center - left, bounds.width - 14))}px`);
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionTooltip);
+    }
+
+    function closeTooltip() {
+      if (nativePopover) {
+        if (tooltipOpen) tooltip.hidePopover();
+      } else {
+        tooltipOpen = false;
+        tooltip.hidden = true;
+        infoButton.setAttribute('aria-expanded', 'false');
+      }
+    }
+
+    if (nativePopover) {
+      tooltip.hidden = false;
+      tooltip.addEventListener('beforetoggle', (event) => {
+        tooltipOpen = event.newState === 'open';
+        if (tooltipOpen) schedulePosition();
+      });
+    } else {
+      infoButton.setAttribute('aria-expanded', 'false');
+      infoButton.addEventListener('click', () => {
+        tooltipOpen = !tooltipOpen;
+        tooltip.hidden = !tooltipOpen;
+        infoButton.setAttribute('aria-expanded', String(tooltipOpen));
+        positionTooltip();
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (!infoButton.contains(event.target) && !tooltip.contains(event.target)) closeTooltip();
+      });
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') closeTooltip();
+      });
+    }
+
+    // Dismiss before another keyboard-focused control can be covered.
+    document.addEventListener('focusin', (event) => {
+      if (event.target !== infoButton && !tooltip.contains(event.target)) closeTooltip();
+    });
+    window.addEventListener('scroll', schedulePosition, { capture: true, passive: true });
+    window.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    new ResizeObserver(schedulePosition).observe(tooltip);
+  </script>
