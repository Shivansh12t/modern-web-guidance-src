   </footer>
 
+  <div id="maple-tooltip" class="info-tooltip" role="tooltip" hidden>
+    A cozy blend of espresso, creamy oat milk, and Vermont maple syrup. Available for the season.
+    <span class="tooltip-arrow" aria-hidden="true"></span>
+  </div>
+
+  <script>
+    const anchor = document.getElementById('anchor');
+    const tooltip = document.getElementById('maple-tooltip');
+    const arrow = tooltip.querySelector('.tooltip-arrow');
+    let pinned = false;
+    let closeTimer;
+    let positionFrame;
+
+    function positionTooltip() {
+      if (tooltip.hidden) return;
+      const padding = 12;
+      const gap = 12;
+      const viewport = window.visualViewport;
+      const left = (viewport?.offsetLeft ?? 0) + padding;
+      const top = (viewport?.offsetTop ?? 0) + padding;
+      const right = left + (viewport?.width ?? window.innerWidth) - padding * 2;
+      const bottom = top + (viewport?.height ?? window.innerHeight) - padding * 2;
+      tooltip.style.maxWidth = `${Math.max(0, right - left)}px`;
+      const rect = anchor.getBoundingClientRect();
+      const { width, height } = tooltip.getBoundingClientRect();
+      const centerX = rect.left + rect.width / 2;
+      const centerY = rect.top + rect.height / 2;
+      const space = {
+        top: rect.top - top - gap,
+        bottom: bottom - rect.bottom - gap,
+        right: right - rect.right - gap,
+        left: rect.left - left - gap,
+      };
+      const sides = ['top', 'bottom', 'right', 'left'];
+      const required = side => side === 'top' || side === 'bottom' ? height : width;
+      // Prefer above, then flip to a side that fits within the viewport.
+      const side = sides.find(side => space[side] >= required(side)) ??
+        sides.reduce((best, side) =>
+          space[side] / required(side) > space[best] / required(best) ? side : best);
+      const vertical = side === 'top' || side === 'bottom';
+      let x = vertical ? centerX - width / 2 :
+        side === 'left' ? rect.left - gap - width : rect.right + gap;
+      let y = vertical ?
+        (side === 'top' ? rect.top - gap - height : rect.bottom + gap) : centerY - height / 2;
+      const clamp = (value, min, max) => Math.max(min, Math.min(value, Math.max(min, max)));
+      x = clamp(x, left, right - width);
+      y = clamp(y, top, bottom - height);
+      tooltip.dataset.side = side;
+      tooltip.style.left = `${x}px`;
+      tooltip.style.top = `${y}px`;
+      // Keep the pointer aimed at the button even when the tooltip is shifted.
+      arrow.style.left = vertical ? `${clamp(centerX - x - 5, 12, width - 22)}px` : '';
+      arrow.style.top = vertical ? '' : `${clamp(centerY - y - 5, 12, height - 22)}px`;
+    }
+
+    function openTooltip() {
+      clearTimeout(closeTimer);
+      tooltip.hidden = false;
+      positionTooltip();
+    }
+
+    function closeTooltip() {
+      clearTimeout(closeTimer);
+      tooltip.hidden = true;
+      pinned = false;
+    }
+
+    function scheduleClose() {
+      clearTimeout(closeTimer);
+      closeTimer = setTimeout(() => {
+        if (!pinned && document.activeElement !== anchor &&
+            !anchor.matches(':hover') && !tooltip.matches(':hover')) closeTooltip();
+      }, 120);
+    }
+
+    anchor.addEventListener('pointerenter', openTooltip);
+    anchor.addEventListener('focus', openTooltip);
+    anchor.addEventListener('pointerleave', scheduleClose);
+    anchor.addEventListener('blur', scheduleClose);
+    anchor.addEventListener('click', () => {
+      if (pinned) closeTooltip();
+      else {
+        pinned = true;
+        openTooltip();
+      }
+    });
+    tooltip.addEventListener('pointerenter', () => clearTimeout(closeTimer));
+    tooltip.addEventListener('pointerleave', scheduleClose);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape') closeTooltip();
+    });
+    document.addEventListener('pointerdown', event => {
+      if (!anchor.contains(event.target) && !tooltip.contains(event.target)) closeTooltip();
+    });
+
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionTooltip);
+    }
+    window.addEventListener('resize', schedulePosition);
+    window.addEventListener('scroll', schedulePosition, true);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    new ResizeObserver(schedulePosition).observe(tooltip);
+  </script>
+
 </body>
 
