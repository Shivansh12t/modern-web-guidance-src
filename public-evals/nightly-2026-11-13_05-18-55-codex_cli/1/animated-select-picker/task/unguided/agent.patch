--- a/index.html
+++ b/index.html
@@ -92,8 +92,91 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    .store-select {
+      width: min(100%, 300px);
+      margin-top: 1.5rem;
+      padding: 0.85rem 1rem;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      color: var(--primary);
+      font: inherit;
+      text-align: left;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    /* Keep the native select, including its keyboard and selection behavior. */
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 240ms ease;
+      }
+
+      .store-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .store-select::picker(select) {
+        margin-top: 8px;
+        padding: 6px;
+        border: 1px solid var(--secondary);
+        border-radius: 8px;
+        background: var(--light);
+        color: var(--primary);
+        box-shadow: 0 12px 30px rgb(0 0 0 / 20%);
+        opacity: 0;
+        transition-property: opacity, display, overlay;
+        transition-duration: 240ms;
+        transition-timing-function: ease;
+        /* Retain the top-layer picker until its exit fade finishes. */
+        transition-behavior: allow-discrete;
+      }
+
+      .store-select::picker(select):popover-open {
+        opacity: 1;
+      }
+
+      @starting-style {
+        .store-select::picker(select):popover-open {
+          opacity: 0;
+        }
+      }
+
+      .store-select option {
+        padding: 0.65rem 0.75rem;
+        border-radius: 4px;
+      }
+
+      .store-select option:checked {
+        background: var(--secondary);
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--primary);
+        color: white;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker-icon,
+      .store-select::picker(select) {
+        transition-duration: 0s;
+      }
+    }
+
