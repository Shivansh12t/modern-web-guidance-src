--- a/index.html
+++ b/index.html
@@ -92,8 +92,100 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    .store-chooser {
+      width: min(100%, 300px);
+      margin-top: 1.25rem;
+      text-align: left;
+    }
+
+    .store-chooser label {
+      display: block;
+      margin-bottom: 0.4rem;
+      font-weight: 600;
+    }
+
+    .store-select {
+      width: 100%;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      background: var(--light);
+      color: var(--text);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* Enhance the native picker; unsupported browsers keep their OS dropdown. */
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+      }
+
+      .store-select:open::picker-icon {
+        transform: rotate(180deg);
+      }
+
+      .store-select::picker(select) {
+        width: anchor-size(width);
+        margin-block: 0.4rem;
+        padding: 0.35rem;
+        border: 1px solid var(--secondary);
+        border-radius: 5px;
+        background: var(--light);
+        color: var(--text);
+        box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
+        opacity: 0;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+      }
+
+      .store-select option {
+        padding: 0.65rem 0.75rem;
+        border-radius: 3px;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        background: var(--secondary);
+        font-weight: 700;
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        .store-select::picker-icon {
+          transition: transform 0.25s ease;
+        }
+
+        .store-select::picker(select) {
+          transition: opacity 0.25s ease, display 0.25s, overlay 0.25s;
+          transition-behavior: allow-discrete;
+        }
+      }
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+      }
+    }
+
