+
+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+    const launcher = document.getElementById('open-feedback');
+    const form = document.getElementById('feedback-form');
+    const destinations = [document.getElementById('hero-section'), document.getElementById('favorites-section')];
+    const destinationNames = ['Welcome', 'Seasonal Favorites'];
+    let currentDestination = 0;
+    let returnFocus = launcher;
+
+    function openFeedback() {
+      if (dialog.open) return;
+      returnFocus = document.activeElement;
+      dialog.showModal();
+    }
+    function closeFeedback() { dialog.close(); }
+    launcher.addEventListener('click', openFeedback);
+    document.getElementById('close-feedback').addEventListener('click', closeFeedback);
+    document.getElementById('feedback-done').addEventListener('click', closeFeedback);
+    dialog.addEventListener('close', () => {
+      if (returnFocus instanceof HTMLElement && returnFocus !== document.body) returnFocus.focus({ preventScroll: true });
+      else launcher.focus({ preventScroll: true });
+    });
+    document.getElementById('move-feedback').addEventListener('click', () => {
+      const focused = document.activeElement;
+      const selection = focused instanceof HTMLTextAreaElement ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection] : null;
+      const scrollTop = dialog.scrollTop;
+      currentDestination = (currentDestination + 1) % destinations.length;
+      const destination = destinations[currentDestination];
+      if (typeof destination.moveBefore === 'function') {
+        // A state-preserving DOM move keeps the dialog in the modal top layer.
+        destination.moveBefore(dialog, null);
+      } else {
+        // Older browsers remove reparented dialogs from the top layer. Restore
+        // modal semantics synchronously using the same node and form controls.
+        destination.append(dialog);
+        if (dialog.open) dialog.removeAttribute('open');
+        dialog.showModal();
+      }
+      document.getElementById('modal-location').textContent = 'Currently in: ' + destinationNames[currentDestination];
+      document.getElementById('move-feedback').title = 'Move to ' + destinationNames[(currentDestination + 1) % destinations.length];
+      if (focused instanceof HTMLElement) focused.focus({ preventScroll: true });
+      if (selection) focused.setSelectionRange(...selection);
+      dialog.scrollTop = scrollTop;
+    });
+    form.addEventListener('change', () => {
+      const rating = Number(new FormData(form).get('rating'));
+      document.querySelectorAll('.rating-choice').forEach((label, i) => label.classList.toggle('filled', i < rating));
+      document.getElementById('rating-caption').textContent = ['Every little detail matters.', 'We can do better.', 'Room for a little more care.', 'A good cup.', 'That hit the spot.', 'Made your day. Made ours.'][rating];
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const feedback = Object.fromEntries(new FormData(form));
+      try {
+        const saved = JSON.parse(localStorage.getItem('daily-grind-feedback') || '[]');
+        localStorage.setItem('daily-grind-feedback', JSON.stringify([...saved, { ...feedback, createdAt: new Date().toISOString() }]));
+      } catch {
+        document.querySelector('#feedback-success p').textContent = 'Thanks for taking the time to share your thoughts. Storage is unavailable, so your feedback could not be saved.';
+      }
+      form.hidden = true;
+      document.getElementById('feedback-success').hidden = false;
+      document.getElementById('feedback-done').focus();
+    });
+    // Start with the feedback overlay visible, attached to the welcome section.
+    destinations[0].append(dialog);
+    openFeedback();
+  </script>
