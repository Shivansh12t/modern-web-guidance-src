+  <button class="feedback-launcher" id="feedback-open" type="button" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M20 15a3 3 0 0 1-3 3H9l-5 3V6a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v9Z"/><path d="M8 8h8M8 12h5"/></svg>
+    Feedback
+  </button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackOpen = document.getElementById('feedback-open');
+    const feedbackMove = document.getElementById('feedback-move');
+    const feedbackSections = [document.getElementById('favorites-section'), document.getElementById('hero-section')];
+
+    feedbackOpen.addEventListener('click', () => feedbackDialog.showModal());
+    feedbackMove.addEventListener('click', () => {
+      const destination = feedbackSections.find(section => section !== feedbackDialog.parentElement);
+      if (typeof destination.moveBefore === 'function') {
+        // Atomic reparenting retains the top layer, modality, and focused control.
+        destination.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const focusedControl = feedbackDialog.contains(document.activeElement) ? document.activeElement : null;
+        // Explicitly clear modal state before a traditional move, then restore it.
+        if (wasOpen) feedbackDialog.close();
+        destination.appendChild(feedbackDialog);
+        if (wasOpen) {
+          // Preserve the original invoker for native focus return on final dismissal.
+          feedbackOpen.focus();
+          feedbackDialog.showModal();
+          focusedControl?.focus();
+        }
+      }
+      document.getElementById('feedback-location').textContent = 'Moved to ' + destination.dataset.feedbackSection;
+      const nextSection = feedbackSections.find(section => section !== destination);
+      feedbackMove.setAttribute('aria-label', 'Move feedback to ' + nextSection.dataset.feedbackSection + ' section');
+    });
+
+    document.getElementById('feedback-form').addEventListener('submit', event => {
+      event.preventDefault();
+      const values = new FormData(event.currentTarget);
+      const result = document.getElementById('feedback-result');
+      try {
+        localStorage.setItem('daily-grind-feedback', JSON.stringify({
+          rating: values.get('rating'), message: values.get('message'), savedAt: new Date().toISOString()
+        }));
+        result.textContent = 'Thank you! Your feedback is saved on this device.';
+      } catch {
+        result.textContent = 'Your browser could not save this feedback. Your draft is still here.';
+      }
+    });
+
+    // Open the feedback overlay on arrival; the floating button opens it again.
+    feedbackOpen.focus();
+    feedbackDialog.showModal();
+  </script>
+
