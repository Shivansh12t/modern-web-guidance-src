+  <script>
+    (() => {
+      const gallery = document.getElementById('gallery');
+      const slides = [...gallery.querySelectorAll('.gallery-item')];
+      const indicators = [...document.querySelectorAll('.gallery-indicator')];
+      const status = document.getElementById('gallery-status');
+      const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+      const supportsScrollEnd = 'onscrollend' in gallery;
+      let activeIndex = 0;
+      let requestedIndex = null;
+      let settleTimer;
+      let pointerDown = false;
+
+      const nearestIndex = () => {
+        const bounds = gallery.getBoundingClientRect();
+        const center = bounds.left + gallery.clientWidth / 2;
+        return slides.reduce((nearest, slide, index) => {
+          const rect = slide.getBoundingClientRect();
+          const distance = Math.abs(rect.left + rect.width / 2 - center);
+          return distance < nearest.distance ? { index, distance } : nearest;
+        }, { index: 0, distance: Infinity }).index;
+      };
+
+      const preview = (index) => {
+        indicators.forEach((button, i) => {
+          button.classList.toggle('pending', i === index && i !== activeIndex);
+        });
+      };
+
+      const settle = () => {
+        if (pointerDown) return;
+        clearTimeout(settleTimer);
+        activeIndex = nearestIndex();
+        requestedIndex = null;
+        indicators.forEach((button, index) => {
+          button.classList.remove('pending');
+          button.classList.toggle('active', index === activeIndex);
+          if (index === activeIndex) button.setAttribute('aria-current', 'true');
+          else button.removeAttribute('aria-current');
+        });
+        status.textContent = `Photo ${activeIndex + 1} of ${slides.length}: ${slides[activeIndex].querySelector('figcaption').textContent}`;
+      };
+
+      const scheduleSettle = () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, 200);
+      };
+
+      const goTo = (index) => {
+        requestedIndex = Math.max(0, Math.min(index, slides.length - 1));
+        preview(requestedIndex);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + slides[requestedIndex].getBoundingClientRect().left - gallery.getBoundingClientRect().left,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+        // An already selected target may produce no scroll events.
+        if (nearestIndex() === requestedIndex) scheduleSettle();
+      };
+
+      indicators.forEach((button, index) => button.addEventListener('click', () => goTo(index)));
+      gallery.addEventListener('keydown', (event) => {
+        let target = requestedIndex ?? nearestIndex();
+        if (event.key === 'ArrowRight') target++;
+        else if (event.key === 'ArrowLeft') target--;
+        else if (event.key === 'Home') target = 0;
+        else if (event.key === 'End') target = slides.length - 1;
+        else return;
+        event.preventDefault();
+        goTo(target);
+      });
+
+      if (supportsSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', (event) => {
+          const index = slides.indexOf(event.snapTargetInline);
+          if (index !== -1) preview(index);
+        });
+      }
+      if ('onscrollsnapchange' in gallery) {
+        gallery.addEventListener('scrollsnapchange', settle);
+      }
+      gallery.addEventListener('scroll', () => {
+        clearTimeout(settleTimer);
+        if (!supportsSnapChanging) preview(requestedIndex ?? nearestIndex());
+        if (!supportsScrollEnd) scheduleSettle();
+      }, { passive: true });
+      if (supportsScrollEnd) gallery.addEventListener('scrollend', settle);
+
+      gallery.addEventListener('pointerdown', () => {
+        pointerDown = true;
+        requestedIndex = null;
+        clearTimeout(settleTimer);
+      });
+      const releasePointer = () => {
+        if (!pointerDown) return;
+        pointerDown = false;
+        scheduleSettle();
+      };
+      window.addEventListener('pointerup', releasePointer);
+      window.addEventListener('pointercancel', releasePointer);
+      gallery.addEventListener('wheel', () => { requestedIndex = null; }, { passive: true });
+      window.addEventListener('resize', () => {
+        // Keep the selected slide aligned after the viewport changes size.
+        gallery.scrollTo({ left: activeIndex * gallery.clientWidth, behavior: 'instant' });
+        settle();
+      });
+    })();
+  </script>
+
