+  <script>
+    const gallery = document.getElementById('gallery');
+    const slides = [...gallery.querySelectorAll('.gallery-item')];
+    const controls = document.querySelector('.gallery-thumbnails');
+    const thumbnails = [...controls.querySelectorAll('.thumbnail')];
+    const nativeFocusGroup = 'focusGroup' in HTMLElement.prototype;
+
+    function closestSlide() {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      return slides.reduce((closest, slide, index) => {
+        const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
+        return distance < closest.distance ? { index, distance } : closest;
+      }, { index: 0, distance: Infinity }).index;
+    }
+
+    function preview(index) {
+      if (index < 0) return;
+      thumbnails.forEach((button, i) => button.classList.toggle('pending', i === index));
+    }
+
+    function activate(index) {
+      if (index < 0) return;
+      thumbnails.forEach((button, i) => {
+        button.classList.remove('pending');
+        button.classList.toggle('active', i === index);
+        if (i === index) button.setAttribute('aria-current', 'true');
+        else button.removeAttribute('aria-current');
+      });
+      if (!nativeFocusGroup && !controls.contains(document.activeElement)) {
+        thumbnails.forEach((button, i) => { button.tabIndex = i === index ? 0 : -1; });
+      }
+    }
+
+    thumbnails.forEach((button, index) => {
+      button.addEventListener('click', () => {
+        if (Math.abs(gallery.scrollLeft - slides[index].offsetLeft) < 1) {
+          activate(index);
+          return;
+        }
+        preview(index);
+        gallery.scrollTo({
+          left: slides[index].offsetLeft,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    const nativeChanging = 'onscrollsnapchanging' in gallery;
+    const nativeChange = 'onscrollsnapchange' in gallery;
+    const nativeScrollEnd = 'onscrollend' in gallery;
+    let frame = null;
+    let settleTimer;
+
+    if (nativeChanging) {
+      gallery.addEventListener('scrollsnapchanging', event => {
+        preview(slides.indexOf(event.snapTargetInline));
+      });
+    }
+    if (nativeChange) {
+      gallery.addEventListener('scrollsnapchange', event => {
+        activate(slides.indexOf(event.snapTargetInline));
+      });
+    }
+
+    function settle() {
+      clearTimeout(settleTimer);
+      cancelAnimationFrame(frame);
+      frame = null;
+      activate(closestSlide());
+    }
+
+    if (!nativeChanging || !nativeChange || !nativeScrollEnd) {
+      gallery.addEventListener('scroll', () => {
+        if (!nativeChanging && frame === null) {
+          frame = requestAnimationFrame(() => {
+            frame = null;
+            preview(closestSlide());
+          });
+        }
+        if (!nativeScrollEnd) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(settle, 180);
+        }
+      }, { passive: true });
+    }
+    // Also clear pending when a gesture returns to the already active snap target.
+    if (nativeScrollEnd) gallery.addEventListener('scrollend', settle);
+
+    if (!nativeFocusGroup) {
+      controls.setAttribute('role', 'toolbar');
+      controls.addEventListener('focusin', event => {
+        thumbnails.forEach(button => { button.tabIndex = button === event.target ? 0 : -1; });
+      });
+      controls.addEventListener('keydown', event => {
+        const current = thumbnails.indexOf(document.activeElement);
+        if (current < 0) return;
+        let next;
+        if (event.key === 'ArrowRight') next = (current + 1) % thumbnails.length;
+        else if (event.key === 'ArrowLeft') next = (current - 1 + thumbnails.length) % thumbnails.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = thumbnails.length - 1;
+        else return;
+        event.preventDefault();
+        thumbnails[next].focus({ preventScroll: true });
+      });
+    }
+
+    activate(closestSlide());
+    window.addEventListener('load', settle, { once: true });
+    window.addEventListener('pageshow', settle);
+    window.addEventListener('resize', settle);
+  </script>
+
