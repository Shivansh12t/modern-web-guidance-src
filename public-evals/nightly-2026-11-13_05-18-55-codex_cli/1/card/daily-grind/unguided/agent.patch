+  <script>
+    const drinkNames = {
+      maple: 'Maple Oat Latte',
+      espresso: 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+    const order = new Map();
+    const orderItems = document.getElementById('order-items');
+    const status = document.getElementById('order-status');
+    const displaySize = size => size.charAt(0).toUpperCase() + size.slice(1);
+
+    function renderOrder() {
+      orderItems.replaceChildren();
+      let count = 0;
+      for (const [key, item] of order) {
+        count += item.quantity;
+        const row = document.createElement('li');
+        row.className = 'order-item';
+        const description = document.createElement('span');
+        description.textContent = `${item.quantity} × ${displaySize(item.size)} ${drinkNames[item.drink]}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-item';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${displaySize(item.size)} ${drinkNames[item.drink]} from order`);
+        remove.addEventListener('click', () => {
+          order.delete(key);
+          renderOrder();
+          document.querySelector('.order-summary summary').focus();
+          status.textContent = `${displaySize(item.size)} ${drinkNames[item.drink]} removed from your order.`;
+        });
+        row.append(description, remove);
+        orderItems.append(row);
+      }
+      document.getElementById('order-count').textContent = `(${count})`;
+      document.getElementById('empty-order').hidden = count > 0;
+    }
+
+    document.querySelectorAll('.drink-form').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        renderOrder();
+        status.textContent = `${displaySize(size)} ${drinkNames[drink]} added. ${item.quantity} of this drink in your order.`;
+      });
+    });
+  </script>
