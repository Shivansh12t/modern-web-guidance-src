+  <script>
+    const order = new Map();
+    const orderItems = document.querySelector('#order-items');
+    const orderCount = document.querySelector('#order-count');
+    const emptyOrder = document.querySelector('#empty-order');
+
+    function renderOrder() {
+      orderItems.replaceChildren();
+      let count = 0;
+      for (const [key, item] of order) {
+        count += item.quantity;
+        const row = document.createElement('li');
+        const description = document.createElement('span');
+        description.textContent = `${item.quantity} × ${item.name} — ${item.size}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-item';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${item.size} ${item.name} from order`);
+        remove.addEventListener('click', () => {
+          const nextFocus = row.nextElementSibling?.querySelector('button')
+            || row.previousElementSibling?.querySelector('button');
+          const nextLabel = nextFocus?.getAttribute('aria-label');
+          order.delete(key);
+          renderOrder();
+          const remainingButton = Array.from(orderItems.querySelectorAll('button'))
+            .find(button => button.getAttribute('aria-label') === nextLabel);
+          (remainingButton || document.querySelector(`[data-drink="${item.id}"] button`)).focus();
+        });
+        row.append(description, remove);
+        orderItems.append(row);
+      }
+      orderCount.textContent = count;
+      emptyOrder.hidden = count > 0;
+    }
+
+    document.querySelectorAll('form[data-drink]').forEach(form => {
+      const card = form.closest('.card');
+      const name = card.querySelector('h3').textContent;
+      const status = form.querySelector('output');
+      form.querySelector('button').disabled = false;
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const size = new FormData(form).get('size');
+        const id = form.dataset.drink;
+        const key = `${id}:${size}`;
+        const item = order.get(key) || { id, name, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        renderOrder();
+        status.textContent = `Added ${size} ${name}. ${item.quantity} of this size in your order.`;
+      });
+      form.addEventListener('change', () => { status.textContent = ''; });
+    });
+  </script>
