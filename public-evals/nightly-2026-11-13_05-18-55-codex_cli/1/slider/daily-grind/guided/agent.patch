+  <script>
+    const strengthSlider = document.querySelector('#brew-strength');
+    const strengthValue = document.querySelector('#strength-value');
+    const strengthLabels = document.querySelectorAll('.strength-labels span');
+    const strengths = ['Mild', 'Medium', 'Bold', 'Extra Bold'];
+
+    function updateStrength() {
+      const value = Number(strengthSlider.value);
+      const progress = (value - Number(strengthSlider.min)) /
+        (Number(strengthSlider.max) - Number(strengthSlider.min)) * 100;
+      strengthSlider.style.setProperty('--slider-progress', `${progress}%`);
+      strengthSlider.setAttribute('aria-valuetext', strengths[value]);
+      strengthValue.textContent = strengths[value];
+      strengthLabels.forEach((label, index) => {
+        label.classList.toggle('is-selected', index === value);
+      });
+    }
+
+    strengthSlider.addEventListener('input', updateStrength);
+    updateStrength();
+  </script>
+
