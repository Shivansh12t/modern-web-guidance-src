+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthValue = document.getElementById('strength-value');
+    const strengthDescription = document.getElementById('strength-description');
+    const strengthLabels = document.querySelectorAll('.strength-labels span');
+    const strengths = [
+      { name: 'Mild', description: 'Light and mellow. An easy start to your day.' },
+      { name: 'Medium', description: 'Smooth and balanced. A little richness in every sip.' },
+      { name: 'Bold', description: 'Rich and full-bodied. A deeper, more intense cup.' },
+      { name: 'Extra Bold', description: 'Deep and robust. Our most intense brew experience.' }
+    ];
+
+    function updateStrength() {
+      const index = Number(strengthSlider.value);
+      const strength = strengths[index];
+      strengthSlider.style.setProperty('--progress', `${index / 3 * 100}%`);
+      strengthSlider.setAttribute('aria-valuetext', strength.name);
+      strengthValue.textContent = strength.name;
+      strengthDescription.textContent = strength.description;
+      strengthLabels.forEach((label, position) => {
+        label.classList.toggle('is-selected', position === index);
+      });
+    }
+
+    strengthSlider.addEventListener('input', updateStrength);
+    updateStrength();
+  </script>
