+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let settleTimer;
+    let focusTarget = null;
+
+    function settleSection() {
+      clearTimeout(settleTimer);
+      const snapTop = panel.getBoundingClientRect().top +
+        parseFloat(getComputedStyle(panel).scrollPaddingBlockStart);
+      const active = sections.reduce((nearest, section) => {
+        const distance = item => Math.abs(item.querySelector('header').getBoundingClientRect().top - snapTop);
+        return distance(section) < distance(nearest) ? section : nearest;
+      });
+
+      links.forEach(link => {
+        const isActive = link.hash === '#' + active.id;
+        link.classList.toggle('is-active', isActive);
+        if (isActive) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+
+      if (focusTarget === active) {
+        active.querySelector('h3').focus({ preventScroll: true });
+      }
+      focusTarget = null;
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const section = document.getElementById(link.hash.slice(1));
+        focusTarget = section;
+        const offset = section.querySelector('header').getBoundingClientRect().top -
+          panel.getBoundingClientRect().top - parseFloat(getComputedStyle(panel).scrollPaddingBlockStart);
+        panel.scrollTo({ top: panel.scrollTop + offset, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+        // Also handle clicks on the section that is already in view.
+        if (Math.abs(offset) < 1) settleSection();
+      });
+    });
+
+    panel.addEventListener('scroll', () => {
+      clearTimeout(settleTimer);
+      settleTimer = setTimeout(settleSection, 180);
+    }, { passive: true });
+    panel.addEventListener('scrollend', settleSection);
+    settleSection();
+  </script>
