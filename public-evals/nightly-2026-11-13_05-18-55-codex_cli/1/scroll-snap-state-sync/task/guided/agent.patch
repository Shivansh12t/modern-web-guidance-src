+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = [...panel.querySelectorAll('.drink-section h3')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function setActiveLink(header) {
+      if (!headers.includes(header)) return;
+      for (const link of links) {
+        if (link.hash === `#${header.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    function scrollToHeader(header, behavior) {
+      const inset = parseFloat(getComputedStyle(panel).scrollPaddingBlockStart) || 0;
+      panel.scrollTo({
+        top: panel.scrollTop + header.getBoundingClientRect().top
+          - panel.getBoundingClientRect().top - panel.clientTop - inset,
+        behavior,
+      });
+    }
+
+    for (const link of links) {
+      link.addEventListener('click', (event) => {
+        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
+        const header = headers.find((item) => `#${item.id}` === link.hash);
+        if (!header) return;
+        event.preventDefault();
+        header.focus({ preventScroll: true });
+        scrollToHeader(header, reducedMotion.matches ? 'instant' : 'smooth');
+        if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+      });
+    }
+
+    function syncSettledHeader() {
+      const inset = parseFloat(getComputedStyle(panel).scrollPaddingBlockStart) || 0;
+      const top = panel.getBoundingClientRect().top + panel.clientTop + inset;
+      const nearest = headers.reduce((current, header) =>
+        Math.abs(header.getBoundingClientRect().top - top)
+          < Math.abs(current.getBoundingClientRect().top - top) ? header : current);
+      setActiveLink(nearest);
+    }
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        if (event.snapTargetBlock) setActiveLink(event.snapTargetBlock);
+      });
+    } else {
+      // Delay observer updates until scrolling stops, including during smooth navigation.
+      let settleTimer;
+      function scheduleSync() {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(syncSettledHeader, 180);
+      }
+      const observer = new IntersectionObserver(scheduleSync, {
+        root: panel,
+        threshold: [0, 0.9],
+      });
+      headers.forEach((header) => observer.observe(header));
+      panel.addEventListener('scroll', scheduleSync, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        clearTimeout(settleTimer);
+        syncSettledHeader();
+      });
+    }
+
+    function restoreHash() {
+      const header = headers.find((item) => `#${item.id}` === location.hash);
+      if (header) {
+        scrollToHeader(header, 'instant');
+        setActiveLink(header);
+      }
+    }
+    window.addEventListener('hashchange', restoreHash);
+    restoreHash();
+  </script>
+
