+// Reuse with a stable drink-id and a human-readable drink-name.
+class FavoriteToggle extends HTMLElement {
+  connectedCallback() {
+    if (this.shadowRoot) return;
+
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = `
+      <style>
+        :host { display: inline-block; }
+        button {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          gap: 8px;
+          min-height: 44px;
+          padding: 8px 14px;
+          border: 1px solid var(--secondary, #d7ccc8);
+          border-radius: 24px;
+          background: white;
+          color: var(--primary, #4e342e);
+          font: inherit;
+          cursor: pointer;
+        }
+        button:hover { border-color: var(--primary, #4e342e); }
+        button:focus-visible {
+          outline: 3px solid var(--primary, #4e342e);
+          outline-offset: 3px;
+        }
+        button[aria-pressed="true"] {
+          background: var(--primary, #4e342e);
+          border-color: var(--primary, #4e342e);
+          color: white;
+        }
+        svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; }
+        button[aria-pressed="true"] svg { fill: currentColor; }
+        .state { font-size: 0.8em; }
+      </style>
+      <button type="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
+        </svg>
+        <span>Favorite</span>
+        <span class="state" aria-hidden="true">Off</span>
+      </button>
+    `;
+
+    const button = root.querySelector('button');
+    button.setAttribute('aria-label', `Favorite ${this.getAttribute('drink-name') || 'drink'}`);
+    const drinkId = this.getAttribute('drink-id');
+    const storageKey = drinkId ? `daily-grind:favorite:${drinkId}` : null;
+    const render = (selected) => {
+      button.setAttribute('aria-pressed', String(selected));
+      root.querySelector('.state').textContent = selected ? 'On' : 'Off';
+    };
+
+    try {
+      render(storageKey !== null && localStorage.getItem(storageKey) === 'true');
+    } catch {
+      // The toggle still works when browser storage is unavailable.
+    }
+
+    button.addEventListener('click', () => {
+      const selected = button.getAttribute('aria-pressed') !== 'true';
+      render(selected);
+      try {
+        if (storageKey) localStorage.setItem(storageKey, String(selected));
+      } catch {
+        // Keep the in-memory selection if storage is blocked or full.
+      }
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { drinkId, favorite: selected },
+      }));
+    });
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
