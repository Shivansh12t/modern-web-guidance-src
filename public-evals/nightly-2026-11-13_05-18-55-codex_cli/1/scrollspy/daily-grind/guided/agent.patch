+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let navHeight = nav.getBoundingClientRect().height;
+    let framePending = false;
+
+    function updateCurrentSection() {
+      let currentLink;
+
+      if (nativeTracking) {
+        currentLink = nav.querySelector('a:target-current');
+      } else {
+        // Keep the section that has reached the sticky bar active until the next arrives.
+        let currentIndex = 0;
+        sections.forEach((section, index) => {
+          if (section.getBoundingClientRect().top <= navHeight + 17) currentIndex = index;
+        });
+        // Short final sections may never reach the top of the viewport.
+        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+          currentIndex = sections.length - 1;
+        }
+        currentLink = links[currentIndex];
+      }
+
+      links.forEach(link => {
+        const active = link === currentLink;
+        link.classList.toggle('target-current', !nativeTracking && active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scheduleUpdate() {
+      if (framePending) return;
+      framePending = true;
+      requestAnimationFrame(() => {
+        framePending = false;
+        updateCurrentSection();
+      });
+    }
+
+    // Recalculate the anchor offset when the navigation wraps or fonts change.
+    new ResizeObserver(() => {
+      navHeight = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navHeight}px`);
+      scheduleUpdate();
+    }).observe(nav);
+
+    if (!nativeTracking) {
+      const observer = new IntersectionObserver(scheduleUpdate);
+      sections.forEach(section => observer.observe(section));
+    }
+
+    document.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    updateCurrentSection();
+  </script>
+
