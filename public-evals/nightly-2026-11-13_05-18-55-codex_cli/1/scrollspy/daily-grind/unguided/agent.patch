+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = sectionLinks.map(link => document.querySelector(link.hash));
+    let updatePending = false;
+
+    function updateActiveSection() {
+      updatePending = false;
+      const navHeight = navigation.getBoundingClientRect().height;
+      // Follow the section near the top third of the unobstructed viewport.
+      const readingLine = navHeight + (window.innerHeight - navHeight) * 0.3;
+      let activeSection = null;
+
+      for (const section of sections) {
+        const bounds = section.getBoundingClientRect();
+        if (bounds.top <= readingLine && bounds.bottom > navHeight) {
+          activeSection = section;
+        }
+      }
+
+      // The final section may be too short to reach the reading line.
+      if (window.scrollY > 0 &&
+          window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+        activeSection = sections[sections.length - 1];
+      }
+
+      for (const link of sectionLinks) {
+        if (activeSection && link.hash === `#${activeSection.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    function scheduleUpdate() {
+      if (!updatePending) {
+        updatePending = true;
+        requestAnimationFrame(updateActiveSection);
+      }
+    }
+
+    const navigationObserver = new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.offsetHeight}px`);
+      scheduleUpdate();
+    });
+    navigationObserver.observe(navigation);
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    updateActiveSection();
+  </script>
+
