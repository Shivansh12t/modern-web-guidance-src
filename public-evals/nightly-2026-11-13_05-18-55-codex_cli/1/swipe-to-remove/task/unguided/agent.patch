+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const cartCount = document.getElementById('cart-count');
+    const cartEmpty = document.getElementById('cart-empty');
+    const cartStatus = document.getElementById('cart-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach((item) => {
+      const content = item.querySelector('.SwipeableList-content');
+      const button = item.querySelector('.cart-remove');
+      const name = item.querySelector('h3').textContent;
+      let gesture = null;
+      let removing = false;
+      const threshold = () => Math.min(120, content.clientWidth * 0.3);
+
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      };
+
+      const remove = (direction = -1) => {
+        if (removing) return;
+        removing = true;
+        gesture = null;
+        const hadFocus = item.contains(document.activeElement);
+        const nextButton = item.nextElementSibling?.querySelector('button') ||
+          item.previousElementSibling?.querySelector('button');
+        item.classList.remove('is-dragging');
+        item.classList.add('is-ready');
+        item.style.height = `${item.getBoundingClientRect().height}px`;
+        button.disabled = true;
+        content.style.transform = `translateX(${direction * 110}%)`;
+
+        const finish = () => {
+          item.remove();
+          const count = cartList.children.length;
+          cartCount.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+          cartEmpty.hidden = count !== 0;
+          cartStatus.textContent = `${name} removed from cart. ${cartCount.textContent} remaining.`;
+          if (hadFocus) {
+            if (nextButton?.isConnected) nextButton.focus();
+            else {
+              const title = document.getElementById('cart-title');
+              title.tabIndex = -1;
+              title.focus();
+            }
+          }
+        };
+
+        if (reducedMotion.matches) {
+          finish();
+          return;
+        }
+        window.setTimeout(() => {
+          item.style.height = '0px';
+          item.style.opacity = '0';
+          window.setTimeout(finish, 280);
+        }, 180);
+      };
+
+      button.addEventListener('click', () => remove());
+      content.addEventListener('pointerdown', (event) => {
+        if (removing || gesture || !event.isPrimary || event.button !== 0 || event.target.closest('button')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, offset: 0, dragging: false };
+      });
+      content.addEventListener('pointermove', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 8) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { reset(); return; }
+          gesture.dragging = true;
+          content.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.offset = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+      });
+      content.addEventListener('pointerup', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        if (gesture.dragging && Math.abs(gesture.offset) >= threshold()) remove(Math.sign(gesture.offset));
+        else reset();
+      });
+      content.addEventListener('pointercancel', reset);
+      content.addEventListener('lostpointercapture', () => { if (gesture) reset(); });
+      item.classList.add('is-initialized');
+    });
+  </script>
