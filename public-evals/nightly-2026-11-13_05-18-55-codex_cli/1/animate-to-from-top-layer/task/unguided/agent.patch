+  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" class="close-button" id="close-dialog-btn" aria-label="Close logout dialog">&times;</button>
+    <h2 id="logout-title">Ready to log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your Daily Grind account?</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout-btn" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside class="floating-notice" id="floating-notice" aria-label="Coffee update" hidden>
+    <div role="status" aria-live="polite" aria-atomic="true" id="notice-message"></div>
+    <button type="button" class="close-button" id="dismiss-notice-btn" aria-label="Dismiss coffee update">&times;</button>
+  </aside>
+
+  <script>
+    const dialog = document.getElementById('logout-dialog');
+    const openDialogButton = document.getElementById('open-dialog-btn');
+    const closeDialog = () => {
+      if (dialog.open && !dialog.classList.contains('is-closing')) {
+        dialog.classList.add('is-closing');
+      }
+    };
+
+    openDialogButton.addEventListener('click', (event) => {
+      event.preventDefault();
+      dialog.classList.remove('is-closing');
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('animationend', (event) => {
+      if (event.target === dialog && event.animationName === 'dialog-exit') {
+        dialog.close();
+        dialog.classList.remove('is-closing');
+      }
+    });
+
+    const notice = document.getElementById('floating-notice');
+    const noticeButton = document.getElementById('foobar');
+    const dismissNoticeButton = document.getElementById('dismiss-notice-btn');
+    let noticeAnimation;
+
+    noticeButton.addEventListener('click', () => {
+      noticeAnimation?.cancel();
+      notice.hidden = false;
+      notice.inert = false;
+      noticeButton.setAttribute('aria-expanded', 'true');
+      document.getElementById('notice-message').innerHTML = '<strong>A fresh reason to stop by</strong><p>Our seasonal favorites are here. Explore the menu to find your next coffee break.</p>';
+      noticeAnimation = notice.animate([
+        { opacity: 0, transform: 'translateY(20px)' },
+        { opacity: 1, transform: 'translateY(0)' }
+      ], { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 240, easing: 'ease-out' });
+    });
+
+    dismissNoticeButton.addEventListener('click', () => {
+      noticeAnimation?.cancel();
+      if (notice.contains(document.activeElement)) noticeButton.focus();
+      notice.inert = true;
+      noticeButton.setAttribute('aria-expanded', 'false');
+      noticeAnimation = notice.animate([
+        { opacity: 1, transform: 'translateY(0)' },
+        { opacity: 0, transform: 'translateY(16px)' }
+      ], { duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 180, easing: 'ease-in', fill: 'forwards' });
+      noticeAnimation.onfinish = () => { notice.hidden = true; };
+    });
+  </script>
+
