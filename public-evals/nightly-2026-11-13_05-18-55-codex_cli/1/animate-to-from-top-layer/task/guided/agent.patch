+  <div role="region" aria-label="Notifications">
+    <div class="floating-notice" id="floating-notice" popover="manual" aria-labelledby="notice-title">
+      <h3 id="notice-title">A little coffee knowledge</h3>
+      <p>Our cold brew is steeped for 18 hours for maximum smoothness. Explore our seasonal favorites above to find your next cup.</p>
+      <button type="button" class="dismiss-button" id="dismiss-notice-btn" aria-label="Dismiss coffee information">&times;</button>
