+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const noticeButton = document.getElementById('foobar');
+    const notice = document.getElementById('floating-notice');
+    const announcement = document.getElementById('notice-announcement');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+
+    if (!hasPopover) notice.hidden = true;
+
+    // Keep overlays in the top layer until their exit animations finish,
+    // including in browsers without discrete display/overlay transitions.
+    async function dismiss(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      await Promise.race([
+        Promise.allSettled(element.getAnimations({ subtree: true }).map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 500))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    function dismissNotice() {
+      const hadFocus = notice.contains(document.activeElement);
+      return dismiss(notice, () => {
+        if (hasPopover) notice.hidePopover();
+        else {
+          notice.hidden = true;
+          notice.classList.remove('is-visible');
+        }
+        announcement.textContent = '';
+        if (hadFocus) noticeButton.focus();
+      });
+    }
+
+    logoutLink.addEventListener('click', event => {
+      // Preserve normal navigation if native dialogs are unavailable.
+      if (typeof dialog.showModal !== 'function') return;
+      event.preventDefault();
+      if (hasPopover ? notice.matches(':popover-open') : !notice.hidden) dismissNotice();
+      if (!dialog.open) dialog.showModal();
+    });
+
+    document.getElementById('logout-form').addEventListener('submit', event => {
+      event.preventDefault();
+      const value = event.submitter?.value || 'cancel';
+      dismiss(dialog, () => {
+        dialog.close();
+        if (value === 'confirm') window.location.assign(logoutLink.href);
+      });
+    });
+
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      dismiss(dialog, () => dialog.close());
+    });
+
+    noticeButton.addEventListener('click', () => {
+      if (notice.hasAttribute('data-closing')) return;
+      if (hasPopover) {
+        notice.showPopover();
+      } else {
+        notice.hidden = false;
+        // Commit the closed style before entering in the manual fallback.
+        void notice.offsetWidth;
+        notice.classList.add('is-visible');
+      }
+      const message = notice.querySelector('p').textContent;
+      if (typeof document.ariaNotify === 'function') document.ariaNotify(message);
+      else announcement.textContent = message;
+    });
+
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissNotice);
+  </script>
