+  <script>
+    const hero = document.querySelector('.hero');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const videoHome = document.getElementById('video-home');
+    const player = document.getElementById('roasting-player');
+    const toggle = document.getElementById('theater-toggle');
+    const placeholder = document.getElementById('video-placeholder');
+    const canMoveWithoutReloading = typeof heroSlot.moveBefore === 'function';
+    let theaterActive = false;
+
+    // Older browsers reinitialize iframes when reparented. Position the same
+    // player over the hero slot instead, keeping its browsing context alive.
+    function positionPlayer() {
+      if (!theaterActive || canMoveWithoutReloading) return;
+      const bounds = heroSlot.getBoundingClientRect();
+      player.style.width = `${bounds.width}px`;
+      heroSlot.style.setProperty('--toolbar-height', `${player.querySelector('.video-toolbar').offsetHeight}px`);
+      player.style.left = `${bounds.left + window.scrollX}px`;
+      player.style.top = `${bounds.top + window.scrollY}px`;
+    }
+
+    toggle.addEventListener('click', () => {
+      theaterActive = !theaterActive;
+      hero.classList.toggle('theater-active', theaterActive);
+      placeholder.hidden = !theaterActive;
+
+      if (canMoveWithoutReloading) {
+        // Atomic moves preserve the iframe's playback, fullscreen, and focus state.
+        const destination = theaterActive ? heroSlot : videoHome;
+        destination.moveBefore(player, theaterActive ? null : placeholder);
+      } else {
+        heroSlot.classList.toggle('is-overlay-slot', theaterActive);
+        player.classList.toggle('is-positioned', theaterActive);
+        if (theaterActive) positionPlayer();
+        else {
+          player.style.removeProperty('width');
+          player.style.removeProperty('left');
+          player.style.removeProperty('top');
+        }
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterActive));
+      toggle.textContent = theaterActive ? 'Exit theater mode' : 'Enter theater mode';
+      (theaterActive ? hero : videoHome).scrollIntoView({ block: 'start', behavior: 'instant' });
+    });
+
+    // Account for responsive wrapping, font loading, and other layout changes.
+    if (typeof ResizeObserver === 'function') {
+      const layoutObserver = new ResizeObserver(positionPlayer);
+      layoutObserver.observe(heroSlot);
+      layoutObserver.observe(player);
+      layoutObserver.observe(document.querySelector('nav'));
+    }
+    window.addEventListener('resize', positionPlayer);
+    window.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && theaterActive) toggle.click();
+    });
+  </script>
