+  <script>
+    const hero = document.querySelector('.hero');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const home = document.getElementById('video-home');
+    const player = document.getElementById('coffee-player');
+    const toggle = document.getElementById('theater-toggle');
+    const status = document.getElementById('video-status');
+    const canMove = typeof heroSlot.moveBefore === 'function';
+    let theater = false;
+
+    // Keep the iframe connected on browsers without atomic DOM moves.
+    // Position it over a reserved hero slot instead of reparenting and reloading it.
+    function positionFallback() {
+      if (canMove || !theater) return;
+      const bounds = heroSlot.getBoundingClientRect();
+      player.style.width = `${bounds.width}px`;
+      heroSlot.style.height = `${player.offsetHeight}px`;
+      player.style.left = `${bounds.left + window.scrollX}px`;
+      player.style.top = `${bounds.top + window.scrollY}px`;
+    }
+
+    toggle.hidden = false;
+    toggle.addEventListener('click', () => {
+      theater = !theater;
+      hero.classList.toggle('is-theater', theater);
+      heroSlot.hidden = !theater;
+      if (canMove) {
+        // Moving the existing wrapper atomically preserves the iframe's browsing context.
+        (theater ? heroSlot : home).moveBefore(player, null);
+      } else {
+        player.classList.toggle('is-positioned', theater);
+        if (theater) {
+          positionFallback();
+        } else {
+          for (const property of ['width', 'left', 'top']) player.style.removeProperty(property);
+          heroSlot.style.removeProperty('height');
+        }
+      }
+      toggle.setAttribute('aria-pressed', String(theater));
+      status.textContent = theater ? 'The video is now in the hero. Turn off Theater mode to bring it back.' : 'The video is back in this section.';
+      toggle.focus({ preventScroll: true });
+      player.scrollIntoView({ block: 'center', behavior: 'instant' });
+    });
+
+    if (!canMove) {
+      window.addEventListener('resize', positionFallback);
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(positionFallback);
+        observer.observe(heroSlot);
+        observer.observe(player);
+      }
+    }
+  </script>
+
