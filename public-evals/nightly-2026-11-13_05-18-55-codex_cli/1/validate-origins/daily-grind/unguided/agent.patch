diff --git a/page.mjs b/page.mjs
new file mode 100644
index 0000000..d651a33
--- /dev/null
+++ b/page.mjs
@@ -0,0 +1,25 @@
+import { createMessageHandler } from './message-security.mjs';
+
+const widget = document.getElementById('ordering-widget');
+const orderLink = document.getElementById('order-link');
+
+window.addEventListener('message', createMessageHandler({
+  pageURL: window.location.href,
+  widgetWindow: widget.contentWindow,
+  redirect: (url) => window.location.assign(url),
+  setOrderingLink: (url) => {
+    orderLink.href = url;
+    orderLink.target = '_blank';
+    orderLink.rel = 'noopener noreferrer';
+  },
+  onWidgetMessage: (payload) => {
+    widget.dispatchEvent(new CustomEvent('ordering-widget-message', { detail: payload }));
+  },
+}));
+
+// Load after installing the listener so the initialization message cannot race it.
+// No allow-same-origin: this widget intentionally has an opaque origin.
+widget.srcdoc = `<!doctype html><script>
+  parent.postMessage({ type: 'widget:init' }, ${JSON.stringify(window.location.origin)});
+  parent.postMessage({ type: 'widget:message', payload: { status: 'ready' } }, ${JSON.stringify(window.location.origin)});
+<\/script>`;
