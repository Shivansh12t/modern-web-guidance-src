@@ -0,0 +1,19 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Daily Grind Coffee Tip</title>
+</head>
+<body>
+  <p>Freshly ground beans make a brighter cup.</p>
+  <script>
+    // The iframe receives only the parent's origin as its referrer, never URL parameters.
+    const parentOrigin = new URL(document.referrer).origin;
+    if (parentOrigin !== 'null') {
+      parent.postMessage({ type: 'init' }, parentOrigin);
+      parent.postMessage({ type: 'status', message: 'Your daily coffee tip is ready.' }, parentOrigin);
+    }
+  </script>
+</body>
+</html>
