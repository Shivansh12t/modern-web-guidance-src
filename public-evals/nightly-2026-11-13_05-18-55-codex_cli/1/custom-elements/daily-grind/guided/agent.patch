+# The Daily Grind
+
+The static page loads `coffee-card.js` as a browser module. No build is required.
+Each autonomous `<coffee-card>` owns an open shadow root and inherits the page's
+font and color theme. Its light-DOM content remains readable if JavaScript fails.
+
+## Coffee card API
+
+| Attribute / property | Type | Behavior |
+| --- | --- | --- |
+| `name` | string | Heading; defaults to an empty string. |
+| `description` | string | Description; defaults to an empty string. |
+| `href` | string | Details URL; supports relative and HTTP(S) URLs. Missing or invalid URLs disable the link. |
+| `price` | number | Optional USD price. Missing means no price is shown; the getter defaults to `0`. Invalid or negative markup values read as `0`; invalid property assignments throw `TypeError`. |
+| `disabled` | boolean | Presence disables the details link. `disabled="false"` is still true, following HTML boolean semantics. |
+
+Properties reflect to attributes, and attribute changes update properties and the
+rendered content. Setting string properties or `price` to `null` or `undefined`
+removes the attribute. Set `disabled = false` to remove the boolean attribute.
+
+```js
+const card = document.querySelector('coffee-card');
+card.name = 'Maple Oat Latte';
+card.price = 5.5; // Reflects as price="5.5" and displays $5.50.
+card.disabled = true; // Adds disabled, removes link navigation.
+card.removeAttribute('disabled'); // Restores navigation.
+```
+
+Cards replay properties assigned before registration during connection. Connection
+attaches the click listener; disconnection removes it; reinsertion restores it
+without duplicate listeners. Attribute updates change existing nodes to preserve
+focus. Prices are optional so the existing menu does not invent pricing.
+
+Activating an enabled details link emits a bubbling, composed, cancelable
+`coffee-select` event with `{ name, href, price }` in `detail` (`price` is `null`
+when omitted). Cancel that event to handle selection instead of navigating.
diff --git a/coffee-card.js b/coffee-card.js
new file mode 100644
index 0000000..c353458
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,158 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    :host([hidden]) { display: none; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    .price { margin-top: 10px; font-weight: bold; }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+    a[aria-disabled="true"] { opacity: 0.6; cursor: not-allowed; }
+  </style>
+  <article aria-labelledby="name">
+    <h3 id="name"></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a>View Details</a>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'disabled'];
+
+  #name;
+  #description;
+  #price;
+  #link;
+  #currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#name = root.querySelector('h3');
+    this.#description = root.querySelector('.description');
+    this.#price = root.querySelector('.price');
+    this.#link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    // Replay values assigned before registration so own properties cannot mask setters.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this.#render();
+    // Adding the same callback is idempotent, including repeated connections.
+    this.#link.addEventListener('click', this.#onClick);
+  }
+
+  disconnectedCallback() {
+    this.#link.removeEventListener('click', this.#onClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#setString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#setString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.#setString('href', value); }
+
+  get price() {
+    const value = Number(this.getAttribute('price'));
+    return Number.isFinite(value) && value >= 0 ? value : 0;
+  }
+
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    if (!Number.isFinite(number) || number < 0) {
+      throw new TypeError('price must be a finite, non-negative number');
+    }
+    this.setAttribute('price', String(number));
+  }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  #setString(attribute, value) {
+    if (value == null) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  #render() {
+    // Keep existing nodes so updates preserve keyboard focus and event listeners.
+    this.#name.textContent = this.name;
+    this.#description.textContent = this.description;
+    this.#price.hidden = !this.hasAttribute('price');
+    this.#price.textContent = this.#currency.format(this.price);
+
+    let url;
+    try {
+      url = new URL(this.href, this.ownerDocument.baseURI);
+    } catch {
+      // An invalid URL is presented as an unavailable link.
+    }
+    const unavailable = this.disabled || !this.href || !['http:', 'https:'].includes(url?.protocol);
+    if (unavailable) {
+      this.#link.removeAttribute('href');
+      this.#link.setAttribute('role', 'link');
+      this.#link.setAttribute('aria-disabled', 'true');
+      this.#link.setAttribute('tabindex', '-1');
+    } else {
+      this.#link.setAttribute('href', this.href);
+      this.#link.removeAttribute('role');
+      this.#link.removeAttribute('aria-disabled');
+      this.#link.removeAttribute('tabindex');
+    }
+    this.#link.textContent = unavailable ? 'Unavailable' : 'View Details';
+  }
+
+  #onClick = (event) => {
+    if (this.#link.getAttribute('aria-disabled') === 'true') {
+      event.preventDefault();
+      return;
+    }
+    const selection = new CustomEvent('coffee-select', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      detail: { name: this.name, href: this.href, price: this.hasAttribute('price') ? this.price : null },
+    });
+    if (!this.dispatchEvent(selection)) event.preventDefault();
+  };
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
