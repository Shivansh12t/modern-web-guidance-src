@@ -0,0 +1,116 @@
+import assert from 'node:assert/strict';
+import { afterEach, test } from 'node:test';
+import { readFile } from 'node:fs/promises';
+import { Window } from 'happy-dom';
+
+const window = new Window();
+for (const key of ['document', 'HTMLElement', 'customElements', 'CustomEvent']) {
+  globalThis[key] = window[key];
+}
+const { CoffeeCard } = await import('./coffee-card.mjs');
+afterEach(() => document.body.replaceChildren());
+
+function card() {
+  const element = document.createElement('coffee-card');
+  document.body.append(element);
+  return element;
+}
+
+test('registers an autonomous element and renders existing page content', async () => {
+  document.body.innerHTML = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+  const cards = [...document.querySelectorAll('coffee-card')];
+  assert.equal(cards.length, 3);
+  assert.ok(cards.every(element => element instanceof CoffeeCard));
+  assert.deepEqual(cards.map(element => element.shadowRoot.querySelector('h3').textContent),
+    ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']);
+  assert.equal(cards[0].shadowRoot.querySelector('a').getAttribute('href'), '/menu/seasonal');
+});
+
+test('string properties and attributes reflect in both directions and render as text', () => {
+  const element = card();
+  for (const property of ['name', 'description', 'href']) {
+    element[property] = 'initial';
+    assert.equal(element.getAttribute(property), 'initial');
+    element.setAttribute(property, 'updated');
+    assert.equal(element[property], 'updated');
+    element[property] = null;
+    assert.equal(element.hasAttribute(property), false);
+    assert.equal(element[property], '');
+  }
+  element.name = '<img src=x onerror=alert(1)>';
+  element.description = 'Updated description';
+  assert.equal(element.shadowRoot.querySelector('h3').textContent, element.name);
+  assert.equal(element.shadowRoot.querySelector('img'), null);
+  assert.equal(element.shadowRoot.querySelector('.description').textContent, element.description);
+});
+
+test('numeric price reflects, formats zero and decimals, and handles invalid values', () => {
+  const element = card();
+  element.price = 4.5;
+  assert.equal(element.getAttribute('price'), '4.5');
+  assert.equal(element.price, 4.5);
+  assert.equal(element.shadowRoot.querySelector('.price').textContent, '$4.50');
+  element.setAttribute('price', '0');
+  assert.equal(element.price, 0);
+  assert.equal(element.shadowRoot.querySelector('.price').hidden, false);
+  for (const value of ['', 'bad', '-1', 'Infinity']) {
+    element.setAttribute('price', value);
+    assert.equal(element.price, null);
+    assert.equal(element.shadowRoot.querySelector('.price').hidden, true);
+  }
+  for (const value of [null, undefined, NaN, Infinity, -1, '']) {
+    element.price = value;
+    assert.equal(element.hasAttribute('price'), false);
+  }
+});
+
+test('featured follows HTML boolean presence semantics', () => {
+  const element = card();
+  assert.equal(element.featured, false);
+  element.featured = true;
+  assert.equal(element.getAttribute('featured'), '');
+  assert.equal(element.shadowRoot.querySelector('.badge').hidden, false);
+  element.setAttribute('featured', 'false');
+  assert.equal(element.featured, true);
+  element.featured = false;
+  assert.equal(element.hasAttribute('featured'), false);
+  assert.equal(element.shadowRoot.querySelector('.badge').hidden, true);
+});
+
+test('disconnect cleans listeners, reconnect refreshes attributes without duplicate handlers', () => {
+  const element = card();
+  const link = element.shadowRoot.querySelector('a');
+  let selections = 0;
+  element.addEventListener('coffee-select', event => {
+    selections++;
+    assert.equal(event.composed, true);
+    assert.equal(event.bubbles, true);
+    assert.equal(event.detail.name, element.name);
+  });
+  link.click();
+  assert.equal(selections, 1);
+  element.remove();
+  link.click();
+  assert.equal(selections, 1);
+  element.name = 'Changed while detached';
+  document.body.append(element);
+  assert.equal(element.shadowRoot.querySelector('h3').textContent, element.name);
+  link.click();
+  assert.equal(selections, 2);
+  element.remove();
+  document.body.append(element);
+  link.click();
+  assert.equal(selections, 3);
+});
+
+test('replays own properties assigned before upgrade', () => {
+  const element = new CoffeeCard();
+  Object.defineProperty(element, 'name', { configurable: true, writable: true, value: 'Early name' });
+  Object.defineProperty(element, 'price', { configurable: true, writable: true, value: 3.25 });
+  Object.defineProperty(element, 'featured', { configurable: true, writable: true, value: true });
+  document.body.append(element);
+  assert.equal(Object.hasOwn(element, 'name'), false);
+  assert.equal(element.getAttribute('name'), 'Early name');
+  assert.equal(element.getAttribute('price'), '3.25');
+  assert.equal(element.featured, true);
+});
