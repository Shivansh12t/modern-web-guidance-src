+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    *, *::before, *::after { box-sizing: border-box; }
+    h3, p { margin: 0; padding: 0; }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    .badge { color: var(--primary, #4e342e); font-weight: bold; }
+    .price { margin-top: 10px; }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 2px solid var(--accent, #ffab40); outline-offset: 3px; }
+    [hidden] { display: none; }
+  </style>
+  <article>
+    <p class="badge" hidden>Featured</p>
+    <h3></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a>View Details</a>
+  </article>
+`;
+
+/**
+ * Strings: name, description, href (null removes the attribute).
+ * price: nonnegative finite number, or null when absent/invalid; displayed in USD.
+ * featured: HTML boolean semantics — presence is true, even featured="false".
+ * Emits a bubbling, composed coffee-select event when View Details is clicked.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured'];
+
+  #heading;
+  #description;
+  #price;
+  #badge;
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#heading = root.querySelector('h3');
+    this.#description = root.querySelector('.description');
+    this.#price = root.querySelector('.price');
+    this.#badge = root.querySelector('.badge');
+    this.#link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    // Replay properties assigned before the custom element was registered.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.prototype.hasOwnProperty.call(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this.#render();
+    this.#link.addEventListener('click', this.#onSelect);
+  }
+
+  disconnectedCallback() {
+    this.#link.removeEventListener('click', this.#onSelect);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#setString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#setString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.#setString('href', value); }
+
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const value = Number(raw);
+    return Number.isFinite(value) && value >= 0 ? value : null;
+  }
+
+  set price(value) {
+    if (value == null || String(value).trim() === '') {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    if (Number.isFinite(number) && number >= 0) {
+      this.setAttribute('price', String(number));
+    } else {
+      this.removeAttribute('price');
+    }
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  #setString(name, value) {
+    if (value == null) this.removeAttribute(name);
+    else this.setAttribute(name, String(value));
+  }
+
+  #onSelect = () => {
+    this.dispatchEvent(new CustomEvent('coffee-select', {
+      bubbles: true,
+      composed: true,
+      detail: { name: this.name, href: this.href, price: this.price, featured: this.featured },
+    }));
+  };
+
+  #render() {
+    this.#heading.textContent = this.name;
+    this.#description.textContent = this.description;
+    this.#badge.hidden = !this.featured;
+    const price = this.price;
+    this.#price.hidden = price === null;
+    this.#price.textContent = price === null ? '' : new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(price);
+    if (this.href) this.#link.setAttribute('href', this.href);
+    else this.#link.removeAttribute('href');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/coffee-card.test.mjs b/coffee-card.test.mjs
