+  <script>
+    (() => {
+      const key = 'daily-grind.dark-mode';
+      const scheme = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('dark-mode');
+      const state = document.querySelector('.preference-state');
+      const note = document.querySelector('.preference-note');
+
+      function applyPreference(enabled) {
+        scheme.content = enabled ? 'dark' : 'light';
+        toggle.checked = enabled;
+        state.textContent = enabled ? 'On' : 'Off';
+      }
+
+      applyPreference(scheme.content === 'dark');
+      try {
+        localStorage.getItem(key);
+      } catch {
+        note.textContent = 'Changes apply for this visit. Device storage is unavailable.';
+      }
+      document.querySelector('.preferences').hidden = false;
+
+      toggle.addEventListener('change', () => {
+        applyPreference(toggle.checked);
+        try {
+          localStorage.setItem(key, String(toggle.checked));
+          note.textContent = 'Your preference is saved on this device.';
+        } catch {
+          note.textContent = 'Changes apply for this visit. Your preference could not be saved.';
+        }
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.storageArea === window.localStorage && (event.key === key || event.key === null)) {
+          applyPreference(event.newValue === 'true');
+        }
+      });
+    })();
+  </script>
+
