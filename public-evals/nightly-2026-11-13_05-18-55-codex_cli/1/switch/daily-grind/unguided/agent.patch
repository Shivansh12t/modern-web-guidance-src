+  <script>
+    const darkModeSwitch = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+
+    darkModeSwitch.checked = document.documentElement.dataset.theme === 'dark';
+    darkModeState.textContent = darkModeSwitch.checked ? 'On' : 'Off';
+
+    darkModeSwitch.addEventListener('change', () => {
+      const enabled = darkModeSwitch.checked;
+      document.documentElement.dataset.theme = enabled ? 'dark' : 'light';
+      darkModeState.textContent = enabled ? 'On' : 'Off';
+      try {
+        localStorage.setItem('daily-grind-dark-mode', String(enabled));
+      } catch {
+        // Keep the current session usable if storage is blocked or full.
+      }
+    });
+  </script>
