@@ -207,6 +285,46 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const storageKey = 'daily-grind:show-seasonal-favorites';
+      const toggle = document.getElementById('seasonal-toggle');
+      const favorites = document.getElementById('seasonal-favorites');
+      const state = document.getElementById('seasonal-state');
+      const storageNote = document.getElementById('preference-storage');
+
+      function applyPreference(enabled) {
+        toggle.checked = enabled;
+        favorites.hidden = !enabled;
+        state.textContent = enabled ? 'On' : 'Off';
+      }
+
+      try {
+        applyPreference(localStorage.getItem(storageKey) !== 'false');
+      } catch {
+        storageNote.textContent = 'Your preference applies for this visit. Device storage is unavailable.';
+      }
+
+      toggle.addEventListener('change', () => {
+        applyPreference(toggle.checked);
+        try {
+          localStorage.setItem(storageKey, String(toggle.checked));
+          storageNote.textContent = 'Your preference is saved on this device.';
+        } catch {
+          storageNote.textContent = 'Your preference applies for this visit. Device storage is unavailable.';
+        }
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.storageArea === localStorage && (event.key === storageKey || event.key === null)) {
+          applyPreference(event.newValue !== 'false');
+        }
+      });
+
+      document.getElementById('preferences').hidden = false;
+    })();
+  </script>
+
 </body>
 
