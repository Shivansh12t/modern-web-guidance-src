+  <script>
+    (() => {
+      const section = document.querySelector('.coffee-story');
+      const button = section.querySelector('.motion-toggle');
+      const layers = Array.from(section.querySelectorAll('[data-travel]'));
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      // The static scene is the fallback when observation is unavailable.
+      if (!('IntersectionObserver' in window)) return;
+
+      let visible = false;
+      let paused = false;
+      let listening = false;
+      let frame = 0;
+
+      function render() {
+        frame = 0;
+        const bounds = section.getBoundingClientRect();
+        const progress = Math.max(-1, Math.min(1,
+          (window.innerHeight / 2 - bounds.top - bounds.height / 2) /
+          ((window.innerHeight + bounds.height) / 2)));
+        layers.forEach(layer => {
+          layer.style.transform = `translate3d(0, ${progress * Number(layer.dataset.travel)}px, 0)`;
+        });
+      }
+
+      function schedule() {
+        if (!frame) frame = window.requestAnimationFrame(render);
+      }
+
+      function syncMotion() {
+        const active = visible && !paused && !reducedMotion.matches && !document.hidden;
+        button.hidden = reducedMotion.matches;
+        section.classList.toggle('is-moving', active);
+        if (active && !listening) {
+          window.addEventListener('scroll', schedule, { passive: true });
+          window.addEventListener('resize', schedule, { passive: true });
+        } else if (!active && listening) {
+          window.removeEventListener('scroll', schedule);
+          window.removeEventListener('resize', schedule);
+        }
+        listening = active;
+        if (active) schedule();
+        else {
+          window.cancelAnimationFrame(frame);
+          frame = 0;
+          if (reducedMotion.matches) layers.forEach(layer => layer.style.removeProperty('transform'));
+        }
+      }
+
+      button.addEventListener('click', () => {
+        paused = !paused;
+        button.textContent = paused ? 'Resume motion' : 'Pause motion';
+        syncMotion();
+      });
+      reducedMotion.addEventListener('change', syncMotion);
+      document.addEventListener('visibilitychange', syncMotion);
+      const observer = new IntersectionObserver(entries => {
+        visible = entries[0].isIntersecting;
+        syncMotion();
+      });
+      observer.observe(section);
+      syncMotion();
+    })();
+  </script>
+
