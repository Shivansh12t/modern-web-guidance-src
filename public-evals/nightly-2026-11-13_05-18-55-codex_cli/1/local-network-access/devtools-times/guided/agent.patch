+++ b/src/components/DiagnosticsWidget.tsx
@@ -0,0 +1,133 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import { queryNetworkPermission, requestDiagnostics, validateEndpoint } from '../utils/diagnostics';
+import type { NetworkPermission, TargetSpace } from '../utils/diagnostics';
+
+function ConnectionCard({ space, title, description, defaultUrl }: {
+  space: TargetSpace; title: string; description: string; defaultUrl: string;
+}) {
+  const id = useId();
+  const permissionName: NetworkPermission = space === 'local' ? 'local-network' : 'loopback-network';
+  const permissionLabel = space === 'local' ? 'Local network' : 'Loopback network';
+  const [url, setUrl] = useState(defaultUrl);
+  const [permission, setPermission] = useState<PermissionState | 'unknown'>('unknown');
+  const [state, setState] = useState<'idle' | 'connecting' | 'success' | 'error'>('idle');
+  const [message, setMessage] = useState('Ready when you are.');
+  const [preview, setPreview] = useState('');
+  const active = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    let disposed = false;
+    let status: PermissionStatus | null = null;
+    const update = () => {
+      if (disposed || !status) return;
+      setPermission(status.state);
+      if (status.state === 'denied') active.current?.abort();
+    };
+    void queryNetworkPermission(permissionName).then(result => {
+      if (disposed) return;
+      status = result;
+      update();
+      status?.addEventListener('change', update);
+    });
+    return () => {
+      disposed = true;
+      status?.removeEventListener('change', update);
+      active.current?.abort();
+    };
+  }, [permissionName]);
+
+  async function connect(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (active.current) return;
+    setPreview('');
+    try {
+      if (!window.isSecureContext) throw new Error('Open The DevTools Times over HTTPS to use local connections.');
+      const endpoint = validateEndpoint(url, space);
+      if (permission === 'denied') throw new Error(`Allow ${permissionLabel} in your browser’s site settings, then try again.`);
+      const controller = new AbortController();
+      active.current = controller;
+      setState('connecting');
+      setMessage('Connecting… Allow the browser permission prompt if it appears.');
+      let timedOut = false;
+      const timeout = window.setTimeout(() => {
+        timedOut = true;
+        controller.abort();
+      }, 15000);
+      const started = performance.now();
+      try {
+        const body = await requestDiagnostics(endpoint, space, controller.signal);
+        if (controller.signal.aborted) return;
+        setPreview(body);
+        setState('success');
+        setMessage(`Endpoint responded successfully · ${Math.round(performance.now() - started)} ms. This is a one-time check.`);
+      } catch (error) {
+        setState('error');
+        setMessage(controller.signal.aborted
+          ? timedOut ? 'Connection timed out after 15 seconds. Check the endpoint and try again.' : 'Connection cancelled.'
+          : error instanceof TypeError
+            ? 'The browser could not read the endpoint. Check the service, browser network permissions, CORS, and HTTP/HTTPS support.'
+            : error instanceof Error ? error.message : 'Connection failed. Try again.');
+      } finally {
+        window.clearTimeout(timeout);
+        active.current = null;
+      }
+    } catch (error) {
+      setState('error');
+      setMessage(error instanceof Error ? error.message : 'Connection failed.');
+    }
+  }
+
+  return (
+    <form onSubmit={connect} className="min-w-0 rounded-lg border border-gray-300 bg-white p-5">
+      <div className="mb-4 flex flex-wrap items-center justify-between gap-2">
+        <h3 className="font-bold text-gray-900">{title}</h3>
+        <span className="rounded border border-gray-200 bg-gray-50 px-2 py-1 font-mono text-xs text-gray-600">{space === 'local' ? 'LAN' : '127.0.0.1'}</span>
+      </div>
+      <p className="mb-4 text-sm text-gray-600">{description}</p>
+      <label htmlFor={`${id}-url`} className="mb-1 block text-sm font-semibold text-gray-800">Status endpoint URL</label>
+      <input id={`${id}-url`} type="url" required value={url} onChange={e => {
+        setUrl(e.target.value);
+        setState('idle');
+        setPreview('');
+        setMessage('Ready when you are.');
+      }} disabled={state === 'connecting'} spellCheck={false} autoCapitalize="none" autoComplete="off"
+        aria-describedby={`${id}-permission ${id}-status`}
+        className="w-full min-w-0 rounded border border-gray-400 bg-white px-3 py-2 font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:bg-gray-100" />
+      <p id={`${id}-permission`} className="mt-2 text-xs text-gray-600">
+        {permissionLabel} permission: {permission === 'unknown' ? 'checked by your browser when connecting' : permission === 'prompt' ? 'will ask when connecting' : permission}.
+      </p>
+      {permission === 'denied' && <p className="mt-2 text-sm text-red-800">Open this site’s browser settings and allow {permissionLabel} access, then retry. Reload if the permission status does not update.</p>}
+      <div className="mt-4 flex gap-3">
+        <button type="submit" disabled={state === 'connecting' || permission === 'denied'} className="rounded bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:cursor-not-allowed disabled:opacity-50">
+          {state === 'connecting' ? 'Connecting…' : 'Connect'}
+        </button>
+        {state === 'connecting' && <button type="button" onClick={() => active.current?.abort()} className="rounded px-3 py-2 text-sm font-semibold text-gray-700 underline focus-visible:outline-2 focus-visible:outline-amber-600">Cancel</button>}
+      </div>
+      <p id={`${id}-status`} role="status" aria-live="polite" aria-atomic="true" className={`mt-3 text-sm ${state === 'error' ? 'text-red-800' : state === 'success' ? 'text-green-800' : 'text-gray-600'}`}>{message}</p>
+      {preview && <details className="mt-3 text-sm text-gray-700"><summary className="cursor-pointer font-semibold">Response preview</summary><pre className="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-all rounded bg-gray-100 p-3 text-xs">{preview}</pre></details>}
+    </form>
+  );
+}
+
+export default function DiagnosticsWidget() {
+  const id = useId();
+  return (
+    <section aria-labelledby={`${id}-title`} className="my-6 border-y-2 border-gray-900 bg-gray-50 p-4 sm:p-6">
+      <p className="mb-2 text-xs font-bold uppercase tracking-widest text-gray-600">The developer’s workbench</p>
+      <h2 id={`${id}-title`} className="font-brand text-3xl text-gray-900">Developer diagnostics</h2>
+      <p className="mt-2 max-w-3xl text-sm leading-relaxed text-gray-600">Check your hardware and companion CLI directly from this browser. Enter your service’s status URL, then connect. Your browser may ask for separate access to your local network and this machine.</p>
+      <div className="mt-5 grid gap-4 md:grid-cols-2">
+        <ConnectionCard space="local" title="Hardware test device" description="Power on your device and join the same private Wi-Fi network." defaultUrl="http://192.168.1.100:8080/api/status" />
+        <ConnectionCard space="loopback" title="Local companion CLI" description="Start your companion CLI on this machine with its HTTP status service enabled." defaultUrl="http://127.0.0.1:45678/health" />
+      </div>
+      <details className="mt-4 text-sm text-gray-600">
+        <summary className="cursor-pointer font-semibold text-gray-800">Connection requirements & troubleshooting</summary>
+        <div className="mt-2 space-y-2 leading-relaxed">
+          <p>Use this page over HTTPS. These are one-time GET requests from your browser to the URLs you enter; connections do not go through The DevTools Times server.</p>
+          <p>Your service must allow this page’s origin with the standard <code>Access-Control-Allow-Origin</code> response header. A successful response (HTTP 2xx) can contain JSON, text, or an empty body. No cookies or authorization headers are sent.</p>
+          <p>If blocked, check Local network or Loopback network access in your browser’s site settings. Confirm the address, port, firewall, and service are reachable. Browser support varies: if an HTTP endpoint is blocked, try a trusted HTTPS endpoint or a current browser that supports Local Network Access.</p>
+        </div>
+      </details>
+    </section>
+  );
+}
