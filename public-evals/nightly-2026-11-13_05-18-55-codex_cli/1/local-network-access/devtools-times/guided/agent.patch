diff --git a/src/utils/diagnostics.test.ts b/src/utils/diagnostics.test.ts
new file mode 100644
index 0000000..28074bb
--- /dev/null
+++ b/src/utils/diagnostics.test.ts
@@ -0,0 +1,76 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { queryNetworkPermission, requestDiagnostics, validateEndpoint } from './diagnostics.ts';
+
+test('accepts private LAN and loopback endpoints in their respective address spaces', () => {
+  for (const host of ['192.168.1.100', '10.1.2.3', '172.16.0.1', '172.31.255.255', '169.254.1.2', 'device.local', '[fd12::1]', '[fe80::1]']) {
+    assert.equal(validateEndpoint(`http://${host}:8080/api/status`, 'local').port, '8080');
+  }
+  for (const host of ['127.0.0.1', '127.1.2.3', 'localhost', 'cli.localhost', '[::1]']) {
+    assert.equal(validateEndpoint(`https://${host}:45678/health`, 'loopback').pathname, '/health');
+  }
+});
+
+test('rejects public endpoints, mismatched address spaces, credentials, and unsupported schemes', () => {
+  for (const value of ['bad url', 'https://example.com', 'http://172.32.0.1', 'http://192.169.1.1', 'http://127.0.0.1', 'ftp://192.168.1.1', 'http://user:password@192.168.1.1', 'http://192.168.1.1/#fragment']) {
+    assert.throws(() => validateEndpoint(value, 'local'));
+  }
+  assert.throws(() => validateEndpoint('http://192.168.1.1', 'loopback'));
+});
+
+test('sends distinct targetAddressSpace options, omits credentials, and reads responses', async t => {
+  const signal = new AbortController().signal;
+  const requests: RequestInit[] = [];
+  t.mock.method(globalThis, 'fetch', async (_url: URL, options: RequestInit) => {
+    requests.push(options);
+    return new Response('{"status":"ok"}');
+  });
+  for (const space of ['local', 'loopback'] as const) {
+    const url = validateEndpoint(space === 'local' ? 'http://192.168.1.1' : 'http://127.0.0.1', space);
+    assert.equal(await requestDiagnostics(url, space, signal), '{"status":"ok"}');
+    assert.deepEqual(requests.at(-1), {
+      method: 'GET', mode: 'cors', targetAddressSpace: space, credentials: 'omit',
+      referrerPolicy: 'no-referrer', cache: 'no-store', redirect: 'error', signal,
+    });
+  }
+});
+
+test('reports HTTP and network failures rather than claiming a connection', async t => {
+  const url = new URL('http://127.0.0.1/health');
+  const signal = new AbortController().signal;
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => new Response('', { status: 503 }));
+  await assert.rejects(requestDiagnostics(url, 'loopback', signal), /HTTP 503/);
+  fetchMock.mock.mockImplementation(async () => { throw new TypeError('Failed to fetch'); });
+  await assert.rejects(requestDiagnostics(url, 'loopback', signal), /Failed to fetch/);
+});
+
+test('bounds response previews and cancels the stream', async t => {
+  let cancelled = false;
+  t.mock.method(globalThis, 'fetch', async () => new Response(new ReadableStream({
+    start(controller) { controller.enqueue(new TextEncoder().encode('x'.repeat(5000))); },
+    cancel() { cancelled = true; },
+  })));
+  const result = await requestDiagnostics(new URL('http://127.0.0.1'), 'loopback', new AbortController().signal);
+  assert.equal(result, 'x'.repeat(4096) + '\n[Preview limited to 4 KB]');
+  assert.equal(cancelled, true);
+});
+
+test('unsupported permissions fall back without querying the legacy permission', async t => {
+  const names: string[] = [];
+  const original = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+  Object.defineProperty(globalThis, 'navigator', {
+    configurable: true,
+    value: {
+      permissions: {
+        query: async ({ name }: { name: string }) => {
+          names.push(name);
+          throw new TypeError('Unsupported permission');
+        },
+      },
+    },
+  });
+  t.after(() => { if (original) Object.defineProperty(globalThis, 'navigator', original); });
+  assert.equal(await queryNetworkPermission('local-network'), null);
+  assert.equal(await queryNetworkPermission('loopback-network'), null);
+  assert.deepEqual(names, ['local-network', 'loopback-network']);
+});
diff --git a/src/utils/diagnostics.ts b/src/utils/diagnostics.ts
