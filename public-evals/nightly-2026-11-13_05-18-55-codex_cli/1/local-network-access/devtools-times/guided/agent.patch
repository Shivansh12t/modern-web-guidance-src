index 0000000..ad9c820
--- /dev/null
+++ b/src/utils/diagnostics.ts
@@ -0,0 +1,74 @@
+export type TargetSpace = 'local' | 'loopback';
+export type NetworkPermission = 'local-network' | 'loopback-network';
+
+export function validateEndpoint(value: string, space: TargetSpace): URL {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error('Enter a full HTTP or HTTPS URL, including the port and status path.');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const octets = host.split('.').map(Number);
+  const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+  const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (ipv4 && octets[0] === 127);
+  const local = (ipv4 && (octets[0] === 10 ||
+    (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+    (octets[0] === 192 && octets[1] === 168) ||
+    (octets[0] === 169 && octets[1] === 254))) ||
+    (host.endsWith('.local') && host !== '.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/i.test(host);
+  if (space === 'loopback' ? !loopback : !local) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address such as 127.0.0.1, localhost, or [::1].'
+      : 'Use a private LAN address such as 192.168.1.100, 10.0.0.1, or device.local.');
+  }
+  return url;
+}
+
+// Some browsers do not yet recognize the granular permission names.
+export async function queryNetworkPermission(name: NetworkPermission): Promise<PermissionStatus | null> {
+  try {
+    return await navigator.permissions.query({ name: name as PermissionName });
+  } catch {
+    return null;
+  }
+}
+
+export async function requestDiagnostics(url: URL, space: TargetSpace, signal: AbortSignal) {
+  // Keep these options on the browser request; a server proxy would reach the
+  // hosting server's network rather than the reader's device.
+  const options: RequestInit & { targetAddressSpace: TargetSpace } = {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: space,
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'no-store',
+    redirect: 'error',
+    signal,
+  };
+  const response = await fetch(url, options);
+  if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check the status URL and service logs.`);
+  // Read a bounded preview so an unexpectedly large/streaming response cannot
+  // fill memory or keep the connection alive indefinitely.
+  const reader = response.body?.getReader();
+  if (!reader) return 'The endpoint responded successfully with an empty body.';
+  const decoder = new TextDecoder();
+  let preview = '';
+  let remaining = 4096;
+  try {
+    while (remaining > 0) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      preview += decoder.decode(value.subarray(0, remaining), { stream: true });
+      remaining -= Math.min(value.length, remaining);
+    }
+    preview += decoder.decode();
+  } finally {
+    await reader.cancel();
+  }
+  return preview + (remaining === 0 ? '\n[Preview limited to 4 KB]' : '') || 'The endpoint responded successfully with an empty body.';
+}
