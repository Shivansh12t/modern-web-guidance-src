@@ -0,0 +1,167 @@
+/* Each card checks a read-only endpoint; no network requests occur on page load. */
+document.querySelectorAll('.equipment-form').forEach((form) => {
+  const input = form.elements.endpoint;
+  const connect = form.querySelector('[type="submit"]');
+  const disconnect = form.querySelector('[type="button"]');
+  const badge = form.querySelector('.connection-badge');
+  const status = form.querySelector('.connection-status');
+  const permissionLabel = form.querySelector('[data-permission-state]');
+  const initialLabel = connect.textContent;
+  const permissionName = form.dataset.permission;
+  const addressSpace = form.dataset.space;
+  let permissionStatus;
+  let pending;
+
+  function show(state, message) {
+    badge.dataset.state = state;
+    badge.textContent = {
+      idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Not connected',
+    }[state];
+    status.textContent = message;
+    form.setAttribute('aria-busy', String(state === 'connecting'));
+    input.readOnly = state === 'connecting' || state === 'connected';
+    connect.disabled = state === 'connecting';
+    connect.textContent = state === 'connecting' ? 'Connecting…' : state === 'connected' ? 'Check again' : initialLabel;
+    disconnect.hidden = state !== 'connecting' && state !== 'connected';
+    disconnect.textContent = state === 'connecting' ? 'Cancel' : 'Disconnect';
+  }
+
+  function permissionDeniedMessage() {
+    return `Access is blocked. Open this site’s browser settings, allow ${addressSpace === 'local' ? 'Local network' : 'Loopback network'} access, then try again.`;
+  }
+
+  function updatePermission() {
+    permissionLabel.textContent = {
+      granted: 'Allowed', prompt: 'Will ask when you connect', denied: 'Blocked — change browser site settings',
+    }[permissionStatus.state];
+    if (permissionStatus.state === 'denied') {
+      stop();
+      show('error', permissionDeniedMessage());
+    }
+  }
+
+  async function checkPermission() {
+    if (permissionStatus) return permissionStatus.state;
+    try {
+      // Unsupported granular permission names must fall back to a user-initiated attempt.
+      permissionStatus = await navigator.permissions.query({ name: permissionName });
+      permissionStatus.addEventListener('change', updatePermission);
+      updatePermission();
+      return permissionStatus.state;
+    } catch {
+      permissionLabel.textContent = 'Not reported by this browser; connect to try';
+      return 'prompt';
+    }
+  }
+
+  function stop() {
+    if (pending) {
+      pending.abort();
+      pending = undefined;
+    }
+  }
+
+  function endpoint() {
+    const url = new URL(input.value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS status URL without a username, password, or fragment.');
+    }
+    const host = url.hostname;
+    const ipv4 = host.split('.').map(Number);
+    const isIPv4 = ipv4.length === 4 && ipv4.every((part) => Number.isInteger(part) && part >= 0 && part <= 255);
+    const isLoopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (isIPv4 && ipv4[0] === 127);
+    const isLocal = (isIPv4 && (ipv4[0] === 10 || (ipv4[0] === 172 && ipv4[1] >= 16 && ipv4[1] <= 31) ||
+      (ipv4[0] === 192 && ipv4[1] === 168) || (ipv4[0] === 169 && ipv4[1] === 254))) ||
+      host.endsWith('.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/i.test(host);
+    if (addressSpace === 'loopback' ? !isLoopback : !isLocal) {
+      throw new Error(addressSpace === 'loopback'
+        ? 'Use a loopback address: 127.0.0.1, localhost, or [::1].'
+        : 'Use a private LAN address such as 192.168.1.100 or brewer.local.');
+    }
+    return url;
+  }
+
+  input.addEventListener('input', () => {
+    input.setCustomValidity('');
+    input.removeAttribute('aria-invalid');
+  });
+
+  disconnect.addEventListener('click', () => {
+    const wasConnecting = Boolean(pending);
+    stop();
+    show('idle', wasConnecting ? 'Connection cancelled. You can try again when ready.' : 'Disconnected from this page. Your equipment is still running.');
+    connect.focus();
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (pending) return;
+    let url;
+    try {
+      url = endpoint();
+    } catch (error) {
+      input.setCustomValidity(error.message);
+      input.setAttribute('aria-invalid', 'true');
+      input.reportValidity();
+      return;
+    }
+    if (!window.isSecureContext) {
+      show('error', 'Open this homepage over HTTPS to connect to local equipment. Localhost development is also supported.');
+      return;
+    }
+
+    const controller = new AbortController();
+    pending = controller;
+    show('connecting', 'Allow access if your browser asks. Checking the status endpoint…');
+    let timeout;
+    let timedOut = false;
+    try {
+      const permission = await checkPermission();
+      if (pending !== controller) return;
+      if (permission === 'denied') {
+        show('error', permissionDeniedMessage());
+        return;
+      }
+      timeout = setTimeout(() => {
+        timedOut = true;
+        controller.abort();
+      }, 20000);
+      const response = await fetch(url.href, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: addressSpace,
+        credentials: 'omit',
+        cache: 'no-store',
+        redirect: 'error',
+        referrerPolicy: 'no-referrer',
+        signal: controller.signal,
+      });
+      if (pending !== controller) return;
+      // A readable 2xx response confirms reachability; opaque responses never count.
+      if (!response.ok || response.type === 'opaque') {
+        throw new Error(`The endpoint returned HTTP ${response.status}. Check the status path and equipment configuration.`);
+      }
+      // Status checks need no response body and should not leave a stream open.
+      if (response.body) await response.body.cancel();
+      if (pending !== controller) return;
+      show('connected', `Status endpoint reached at ${new Date().toLocaleTimeString()}. This is a single check; select Check again to refresh.`);
+    } catch (error) {
+      if (pending !== controller) return;
+      if (permissionStatus?.state === 'denied') {
+        show('error', permissionDeniedMessage());
+      } else if (timedOut) {
+        show('error', 'The connection timed out after 20 seconds. Check the device, address, network, and browser permission, then try again.');
+      } else if (error instanceof TypeError) {
+        show('error', `Could not connect. ${addressSpace === 'local' ? 'Check the brewer is on the same Wi-Fi.' : 'Start the helper on this computer and check its port.'} Allow access in browser site settings. The endpoint must allow this site through CORS; your browser may also block local HTTP connections. See connection requirements below.`);
+      } else {
+        show('error', error.message || 'Connection failed. Check the equipment and try again.');
+      }
+    } finally {
+      clearTimeout(timeout);
+      if (pending === controller) pending = undefined;
+    }
+  });
+
+  connect.disabled = false;
+  void checkPermission();
+});
