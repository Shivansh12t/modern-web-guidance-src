+// Connections are browser-side only. A successful check requires the documented
+// health response, rather than an opaque response or an unrelated web page.
+(() => {
+  'use strict';
+
+  function healthEndpoint(value, device) {
+    const url = new URL(value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash || url.search) {
+      throw new Error('Use an HTTP or HTTPS address without credentials, a query, or a fragment.');
+    }
+    const host = url.hostname;
+    if (device === 'helper') {
+      if (!['127.0.0.1', 'localhost', '[::1]'].includes(host)) {
+        throw new Error('Use 127.0.0.1, localhost, or [::1] and your desktop helper’s port.');
+      }
+    } else {
+      const parts = host.split('.').map(Number);
+      const privateIPv4 = /^\d+\.\d+\.\d+\.\d+$/.test(host) && parts.every(n => n >= 0 && n <= 255) &&
+        (parts[0] === 10 || (parts[0] === 192 && parts[1] === 168) ||
+          (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31));
+      if (!privateIPv4) throw new Error('Enter your brewer’s private IP address, such as http://192.168.1.100.');
+    }
+    if (url.pathname === '/') url.pathname = '/health';
+    return url;
+  }
+
+  document.querySelectorAll('[data-device]').forEach(form => {
+    const device = form.dataset.device;
+    const input = form.elements.address;
+    const status = form.querySelector('.connection-status');
+    const feedback = form.querySelector('.connection-feedback');
+    const connect = form.querySelector('.connect-button');
+    const disconnect = form.querySelector('.disconnect-button');
+    const initialLabel = connect.textContent;
+    let activeRequest = null;
+
+    function render(state, message) {
+      status.dataset.state = state;
+      status.textContent = { idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection failed' }[state];
+      feedback.textContent = message;
+      connect.disabled = state === 'connecting';
+      connect.textContent = state === 'connecting' ? 'Checking connection…' : state === 'connected' ? 'Check again ↻' : initialLabel;
+      disconnect.hidden = state !== 'connected' && state !== 'connecting';
+      disconnect.textContent = state === 'connecting' ? 'Cancel' : 'Disconnect';
+      form.setAttribute('aria-busy', String(state === 'connecting'));
+    }
+
+    function reset(message) {
+      if (activeRequest) activeRequest.abort();
+      activeRequest = null;
+      render('idle', message);
+    }
+
+    input.addEventListener('input', () => {
+      input.setCustomValidity('');
+      reset('Address updated. Connect to check this equipment.');
+    });
+    disconnect.addEventListener('click', () => reset('Disconnected. You can reconnect whenever you’re ready.'));
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      let endpoint;
+      try {
+        endpoint = healthEndpoint(input.value.trim(), device);
+      } catch (error) {
+        render('error', error instanceof TypeError ? 'Enter a full address starting with http:// or https://.' : error.message);
+        input.focus();
+        return;
+      }
+
+      if (activeRequest) activeRequest.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+      render('connecting', 'Allow network access if prompted. Checking the service…');
+      const timeout = setTimeout(() => controller.abort(), 15000);
+      try {
+        const response = await fetch(endpoint.href, {
+          method: 'GET',
+          mode: 'cors',
+          credentials: 'omit',
+          cache: 'no-store',
+          redirect: 'error',
+          targetAddressSpace: device === 'brewer' ? 'local' : 'loopback',
+          signal: controller.signal
+        });
+        if (!response.ok) throw new Error(`The service returned HTTP ${response.status}. Check its health endpoint and try again.`);
+        let health;
+        try { health = await response.json(); } catch {
+          throw new Error('The service responded, but its health endpoint did not return valid JSON. See connection help.');
+        }
+        if (!health || health.status !== 'ok') {
+          throw new Error('The service did not report a healthy status. Expected {"status":"ok"}; see connection help.');
+        }
+        if (activeRequest !== controller) return;
+        render('connected', `Health check passed at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}. Ready to use.`);
+      } catch (error) {
+        if (activeRequest !== controller) return;
+        const message = controller.signal.aborted
+          ? 'Connection timed out. Check the address and that the service is running, then try again.'
+          : error instanceof TypeError
+            ? 'Could not reach the service. Check Wi-Fi or the helper app, browser network permissions, and CORS. See connection help below.'
+            : error.message;
+        render('error', message);
+      } finally {
+        clearTimeout(timeout);
+        if (activeRequest === controller) activeRequest = null;
+      }
+    });
+  });
+})();
