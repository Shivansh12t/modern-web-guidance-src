+.help-content code { background: #f4f0e9; padding: 1px 4px; border-radius: 3px; overflow-wrap: anywhere; }
+button:focus-visible, summary:focus-visible { outline: 2px solid #bd9868; outline-offset: 3px; }
+@media (max-width: 720px) {
