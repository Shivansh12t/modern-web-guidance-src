+.connection-card label { display: block; font-size: .76rem; font-weight: 600; margin-bottom: 7px; }
+.address-field { display: flex; align-items: center; gap: 10px; border: 1px solid #ded6ce; border-radius: 6px; padding: 0 12px; background: #fdfcfb; }
+.address-field:focus-within { outline: 2px solid #bd9868; outline-offset: 2px; }
+.address-field svg { width: 18px; height: 18px; flex-shrink: 0; color: #a08a78; }
+.address-field input { width: 100%; min-width: 0; border: 0; outline: 0; padding: 12px 0; background: transparent; font: .85rem ui-monospace, SFMono-Regular, Consolas, monospace; color: #58463b; }
+.address-hint { font-size: .7rem; color: #8c8076; margin-top: 7px; min-height: 24px; }
+.connection-actions { display: flex; gap: 10px; margin-top: 17px; }
+.connect-button, .disconnect-button { cursor: pointer; border: 1px solid var(--primary); border-radius: 6px; padding: 11px 15px; font: 600 .8rem 'Segoe UI', sans-serif; transition: background .2s; }
+.connect-button { display: flex; flex: 1; justify-content: space-between; align-items: center; color: #fff; background: var(--primary); }
+.connect-button:hover { background: #34221e; }
+.connect-button:disabled { cursor: wait; opacity: .7; }
+.disconnect-button { color: var(--primary); background: #fff; }
+.disconnect-button:hover { background: #f5f0e9; }
+.disconnect-button[hidden] { display: none; }
+.connection-feedback { margin-top: 12px; font-size: .72rem; color: #86766b; min-height: 24px; overflow-wrap: anywhere; }
