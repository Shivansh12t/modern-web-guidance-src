+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Espresso with creamy oat milk and a hint of Vermont maple syrup. Served hot.',
+        sizes: ['Small (8 oz)', 'Medium (12 oz)', 'Large (16 oz)'],
+        milk: 'oat'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey dark roast espresso, freshly pulled for a rich morning boost. Served hot.',
+        sizes: ['Single shot', 'Double shot', 'Triple shot'],
+        milk: 'none'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours for maximum smoothness and served over ice.',
+        sizes: ['Small (12 oz)', 'Medium (16 oz)', 'Large (20 oz)'],
+        milk: 'none'
+      }
+    };
+    const dialog = document.querySelector('#order-dialog');
+    const form = document.querySelector('#order-form');
+    const drink = form.elements.drink;
+    const confirmation = document.querySelector('#discard-confirmation');
+    let initialOptions = '';
+    let opener;
+    let editingTarget;
+    let orderCount = 0;
+    const orderOptions = () => JSON.stringify(Array.from(new FormData(form)));
+
+    function updateDrink() {
+      const details = drinks[drink.value];
+      document.querySelector('#drink-description').textContent = details.description;
+      form.elements.size.replaceChildren(...details.sizes.map(size => new Option(size, size)));
+      form.elements.milk.value = details.milk;
+    }
+
+    function closeDialog() {
+      dialog.close();
+    }
+
+    function requestDismissal() {
+      if (orderOptions() !== initialOptions) {
+        if (confirmation.hidden) editingTarget = document.activeElement;
+        confirmation.hidden = false;
+        document.querySelector('#keep-editing').focus();
+      } else {
+        closeDialog();
+      }
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        form.reset();
+        drink.value = button.dataset.drink;
+        updateDrink();
+        initialOptions = orderOptions();
+        confirmation.hidden = true;
+        dialog.showModal();
+        document.body.classList.add('dialog-open');
+      });
+    });
+
+    drink.addEventListener('change', updateDrink);
+    document.querySelector('.close-dialog').addEventListener('click', requestDismissal);
+    document.querySelector('#cancel-order').addEventListener('click', requestDismissal);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      requestDismissal();
+    });
+    // Only dismiss for gestures that both start and end on the backdrop.
+    let pointerStartedOutside = false;
+    function outsideDialog(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+    dialog.addEventListener('pointerdown', event => {
+      pointerStartedOutside = event.target === dialog && outsideDialog(event);
+    });
+    dialog.addEventListener('click', event => {
+      if (pointerStartedOutside && event.target === dialog && outsideDialog(event)) requestDismissal();
+      pointerStartedOutside = false;
+    });
+    document.querySelector('#keep-editing').addEventListener('click', () => {
+      confirmation.hidden = true;
+      if (editingTarget && form.contains(editingTarget)) editingTarget.focus();
+      else drink.focus();
+    });
+    document.querySelector('#discard-changes').addEventListener('click', closeDialog);
+    dialog.addEventListener('close', () => {
+      document.body.classList.remove('dialog-open');
+      confirmation.hidden = true;
+      opener?.focus();
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      orderCount += Number(form.elements.quantity.value);
+      document.querySelector('#order-status').textContent =
+        `${form.elements.quantity.value} × ${drinks[drink.value].name} (${form.elements.size.value}, ` +
+        `${form.elements.milk.selectedOptions[0].text}) added to your order for this visit. ` +
+        `${orderCount} drink(s) total. No payment has been taken.`;
+      initialOptions = orderOptions();
+      closeDialog();
+    });
+  </script>
