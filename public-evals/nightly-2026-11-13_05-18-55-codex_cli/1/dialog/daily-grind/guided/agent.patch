+  <dialog id="drink-dialog" closedby="any" aria-labelledby="drink-title" aria-describedby="drink-description">
+    <div class="dialog-header">
+      <h2 id="drink-title">Maple Oat Latte</h2>
+      <button type="button" class="dialog-close" id="close-dialog">Close</button>
+    </div>
+    <p id="drink-description"></p>
+    <form id="order-options" class="order-options">
+      <label for="drink-choice">Drink
+        <select id="drink-choice" name="drink" autofocus>
+          <option value="maple">Maple Oat Latte</option>
+          <option value="espresso">Dark Roast Espresso</option>
+          <option value="cold-brew">Cold Brew</option>
+        </select>
+      </label>
+      <label for="drink-size">Size
+        <select id="drink-size" name="size"></select>
+      </label>
+      <label for="drink-milk">Milk
+        <select id="drink-milk" name="milk">
+          <option value="none">No milk</option>
+          <option value="oat">Oat milk</option>
+          <option value="whole">Whole milk</option>
+          <option value="almond">Almond milk</option>
+        </select>
+      </label>
+      <label for="drink-quantity">Quantity
+        <input id="drink-quantity" name="quantity" type="number" value="1" min="1" max="20" step="1" required>
+      </label>
+      <label for="drink-notes">Special instructions (optional)
+        <textarea id="drink-notes" name="notes" rows="2" maxlength="300"></textarea>
+      </label>
+    </form>
+    <p id="order-summary" role="status"></p>
+    <p>Customize your order here. No order is placed or charged from this dialog.</p>
+    <p id="discard-notice" class="discard-notice">You have changed your order options. To close this dialog, confirm with “Discard changes”, or keep editing.</p>
+    <div class="dialog-actions">
+      <button type="button" id="discard-changes" class="btn" aria-describedby="discard-notice">Discard changes</button>
+      <button type="button" id="keep-editing" class="secondary-btn" aria-describedby="discard-notice">Keep editing</button>
+    </div>
+  </dialog>
+
+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, paired with freshly brewed espresso.',
+        sizes: ['Small', 'Medium', 'Large'],
+        milk: 'oat'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Enjoy a rich dark roast served as espresso shots.',
+        sizes: ['Single shot', 'Double shot', 'Triple shot'],
+        milk: 'none'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness and served cold over ice.',
+        sizes: ['Small', 'Medium', 'Large'],
+        milk: 'none'
+      }
+    };
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('order-options');
+    const choice = document.getElementById('drink-choice');
+    const size = document.getElementById('drink-size');
+    const milk = document.getElementById('drink-milk');
+    const quantity = document.getElementById('drink-quantity');
+    const keepEditing = document.getElementById('keep-editing');
+    let dirty = false;
+
+    function showDrink() {
+      const drink = drinks[choice.value];
+      document.getElementById('drink-title').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      size.replaceChildren(...drink.sizes.map(label => new Option(label, label)));
+      milk.value = drink.milk;
+    }
+
+    function updateSummary() {
+      const amount = quantity.validity.valid ? quantity.value : 'Choose a quantity (1–20)';
+      document.getElementById('order-summary').textContent =
+        `${amount} × ${drinks[choice.value].name} · ${size.value} · ${milk.selectedOptions[0].textContent}`;
+    }
+
+    function requestDismiss() {
+      if (dirty) {
+        keepEditing.focus();
+        return;
+      }
+      dialog.close();
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        form.reset();
+        dirty = false;
+        dialog.removeAttribute('data-dirty');
+        dialog.setAttribute('closedby', 'any');
+        choice.value = button.dataset.drink;
+        showDrink();
+        updateSummary();
+        dialog.showModal();
+      });
+    });
+
+    function updateOrder(event) {
+      if (event.target === choice && document.getElementById('drink-title').textContent !== drinks[choice.value].name) {
+        showDrink();
+      }
+      dirty = true;
+      dialog.setAttribute('data-dirty', '');
+      // Disable native dismissal, including repeated Escape presses, once edited.
+      dialog.setAttribute('closedby', 'none');
+      updateSummary();
+    }
+    form.addEventListener('input', updateOrder);
+    form.addEventListener('change', updateOrder);
+    form.addEventListener('submit', event => event.preventDefault());
+    document.getElementById('close-dialog').addEventListener('click', requestDismiss);
+    dialog.addEventListener('cancel', event => {
+      if (dirty) {
+        event.preventDefault();
+        requestDismiss();
+      }
+    });
+    // Safari without closedby can force-close on repeated Escape. Suppress the
+    // default key action only for dirty orders in browsers missing that guard.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      dialog.addEventListener('keydown', event => {
+        if (event.key === 'Escape' && dirty) {
+          event.preventDefault();
+          requestDismiss();
+        }
+      });
+      let pressedOutside = false;
+      const outside = event => {
+        const rect = dialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      dialog.addEventListener('pointerdown', event => { pressedOutside = outside(event); });
+      dialog.addEventListener('pointerup', event => {
+        if (pressedOutside && outside(event)) requestDismiss();
+        pressedOutside = false;
+      });
+    }
+    keepEditing.addEventListener('click', () => choice.focus());
+    document.getElementById('discard-changes').addEventListener('click', () => {
+      if (!dirty) return;
+      form.reset();
+      dirty = false;
+      dialog.close('discard');
+    });
+    dialog.addEventListener('close', () => { dialog.returnValue = ''; });
+  </script>
+
 </body>
 
