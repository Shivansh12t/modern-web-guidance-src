+  <script>
+    const reviewsList = document.querySelector('.reviews-list');
+    const topHint = document.querySelector('.scroll-hint-top');
+    const bottomHint = document.querySelector('.scroll-hint-bottom');
+
+    function updateScrollHints() {
+      topHint.hidden = reviewsList.scrollTop <= 0;
+      bottomHint.hidden = Math.ceil(reviewsList.scrollTop + reviewsList.clientHeight) >= reviewsList.scrollHeight;
+    }
+
+    reviewsList.addEventListener('scroll', updateScrollHints, { passive: true });
+    window.addEventListener('resize', updateScrollHints);
+    const reviewsResizeObserver = new ResizeObserver(updateScrollHints);
+    reviewsResizeObserver.observe(reviewsList);
+    for (const review of reviewsList.children) {
+      reviewsResizeObserver.observe(review);
+    }
+    updateScrollHints();
+  </script>
+
