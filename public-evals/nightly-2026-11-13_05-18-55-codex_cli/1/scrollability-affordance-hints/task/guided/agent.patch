+  <script>
+    // Native scroll-state queries handle the hints where supported.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const scroller = document.querySelector('.reviews-scroll');
+      const updateHints = () => {
+        const remaining = scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop;
+        scroller.classList.toggle('more-start', scroller.scrollTop > 0);
+        // Allow for fractional scroll positions at the bottom edge.
+        scroller.classList.toggle('more-end', remaining > 1);
+      };
+
+      scroller.addEventListener('scroll', updateHints, { passive: true });
+      const resizeObserver = new ResizeObserver(updateHints);
+      resizeObserver.observe(scroller);
+      resizeObserver.observe(scroller.querySelector('.reviews-list'));
+      updateHints();
+    }
+  </script>
+
