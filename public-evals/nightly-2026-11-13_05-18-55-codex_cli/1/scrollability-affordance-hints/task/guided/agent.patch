+    }
+
+    .reviews-scroll {
+      height: 360px;
+      overflow-y: auto;
+      container-type: scroll-state;
+      scrollbar-gutter: stable;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      scroll-padding-block: 20px;
+    }
+
+    .reviews-scroll:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .reviews-scroll::before,
+    .reviews-scroll::after {
+      content: "";
+      display: block;
+      position: sticky;
+      height: 20px;
+      z-index: 1;
+      pointer-events: none;
+      opacity: 0;
+    }
+
+    .reviews-scroll::before {
+      top: 0;
+      margin-bottom: -20px;
+      background: radial-gradient(farthest-side at 50% 0, rgb(78 52 46 / 24%), transparent);
+    }
+
+    .reviews-scroll::after {
+      bottom: 0;
+      margin-top: -20px;
+      background: radial-gradient(farthest-side at 50% 100%, rgb(78 52 46 / 24%), transparent);
+    }
+
+    @container scroll-state(scrollable: top) {
+      .reviews-scroll::before {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: bottom) {
+      .reviews-scroll::after {
+        opacity: 1;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .reviews-scroll.more-start::before,
+      .reviews-scroll.more-end::after {
+        opacity: 1;
+      }
+    }
+
+    .reviews-list {
+      list-style: none;
+      padding: 0 24px;
+    }
+
+    .review {
+      padding: 24px 0;
+    }
+
+    .review + .review {
+      border-top: 1px solid #eee7e4;
+    }
+
+    .review-stars {
+      color: #996015;
+      letter-spacing: 2px;
+      margin-bottom: 8px;
+    }
+
+    .review blockquote {
+      margin-bottom: 10px;
+    }
+
+    .review-author {
+      font-size: 0.9rem;
+      font-weight: 600;
+      color: var(--primary);
+    }
