index 0000000..635e6c1
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,130 @@
+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { dirname, join, resolve } from 'node:path';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const dataDirectory = resolve(process.env.DATA_DIR || join(root, 'data'));
+const publicOrigin = process.env.PUBLIC_ORIGIN ? new URL(process.env.PUBLIC_ORIGIN).origin : null;
+const assets = new Map([
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+function setSecurityHeaders(res, nonce) {
+  // Applied to every response, including any future document/worker routes.
+  res.setHeader('Connection-Allowlist', '(response-origin "https://images.unsplash.com"); report-to=security');
+  res.setHeader('Reporting-Endpoints', 'security="/api/security-reports"');
+  res.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic'`,
+    "script-src-attr 'none'",
+    "style-src 'self'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "worker-src 'none'",
+    "frame-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+    'report-to security',
+  ].join('; '));
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('X-DNS-Prefetch-Control', 'off');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Cache-Control', 'no-store');
+}
+
+function send(res, status, body, type = 'text/plain; charset=utf-8') {
+  res.writeHead(status, { 'Content-Type': type });
+  res.end(body);
+}
+
+async function readBody(req, limit = 4096) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) {
+      const error = new Error('Request too large');
+      error.status = 413;
+      throw error;
+    }
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+function signupResult(req, res, status, message) {
+  if (req.headers.accept?.includes('application/json')) {
+    send(res, status, JSON.stringify({ ok: status === 200, message }), 'application/json; charset=utf-8');
+  } else {
+    // Messages are server-owned constants; never interpolate customer input.
+    send(res, status, `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Daily Grind newsletter</title><link rel="stylesheet" href="/styles.css"><main class="container"><h1>Daily Grind newsletter</h1><p>${message}</p><a href="/">Return to the homepage</a></main></html>`, 'text/html; charset=utf-8');
+  }
+}
+
+const server = createServer(async (req, res) => {
+  const nonce = randomBytes(18).toString('base64');
+  setSecurityHeaders(res, nonce);
+  try {
+    const origin = publicOrigin || new URL(`${req.socket.encrypted ? 'https' : 'http'}://${req.headers.host}`).origin;
+    const path = new URL(req.url, origin).pathname;
+    if (req.method === 'POST' && path === '/api/newsletter') {
+      if ((req.headers.origin && req.headers.origin !== origin) ||
+          (req.headers['sec-fetch-site'] && req.headers['sec-fetch-site'] !== 'same-origin')) {
+        return signupResult(req, res, 403, 'We couldn’t complete your signup. Please return to the homepage and try again.');
+      }
+      const type = req.headers['content-type']?.split(';')[0].trim();
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return signupResult(req, res, 415, 'Please use the newsletter form on our homepage.');
+      }
+      const body = await readBody(req);
+      let email;
+      try {
+        email = type === 'application/json' ? JSON.parse(body)?.email : new URLSearchParams(body).get('email');
+      } catch {
+        return signupResult(req, res, 400, 'Please enter a valid email address and try again.');
+      }
+      if (typeof email !== 'string' || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
+        return signupResult(req, res, 400, 'Please enter a valid email address and try again.');
+      }
+      await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+      await appendFile(join(dataDirectory, 'newsletter.jsonl'), JSON.stringify({ email: email.trim(), subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      return signupResult(req, res, 200, 'You’re signed up! Look out for news from Daily Grind.');
+    }
+    if (req.method === 'POST' && path === '/api/security-reports') {
+      const reports = JSON.parse(await readBody(req, 65536));
+      // Discard URLs, samples, and all other potentially sensitive report data.
+      const count = (Array.isArray(reports) ? reports : []).filter(report =>
+        ['connection-allowlist', 'csp-violation'].includes(report?.type)).length;
+      if (count) console.warn(`Browser security policy violations: ${count}`);
+      res.writeHead(204);
+      return res.end();
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', path.startsWith('/api/') ? 'POST' : 'GET, HEAD');
+      return send(res, 405, 'Method not allowed');
+    }
+    if (path === '/' || path === '/index.html') {
+      const html = (await readFile(join(root, 'index.html'), 'utf8')).replace('__SCRIPT_NONCE__', nonce);
+      return send(res, 200, req.method === 'HEAD' ? '' : html, 'text/html; charset=utf-8');
+    }
+    const asset = assets.get(path);
+    if (!asset) return send(res, 404, 'Page not found');
+    return send(res, 200, req.method === 'HEAD' ? '' : await readFile(join(root, asset[0])), asset[1]);
+  } catch (error) {
+    if (res.destroyed) return;
+    const status = error.status === 413 ? 413 : error instanceof SyntaxError ? 400 : 500;
+    signupResult(req, res, status, 'We couldn’t complete the request. Please try again later.');
+  }
+});
+
+server.requestTimeout = 15000;
+server.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
