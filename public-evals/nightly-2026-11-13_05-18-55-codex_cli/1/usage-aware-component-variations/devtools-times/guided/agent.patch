+
+@layer components {
+  /* Inherited fallback values also respect nested sections in older browsers. */
+  :where([data-surface="default"]) {
+    --surface: default;
+    --teaser-badge-display: none;
+    --teaser-action-background: transparent;
+    --teaser-action-color: var(--color-amber-800);
+  }
+
+  :where([data-surface="featured"]) {
+    --surface: featured;
+    --teaser-badge-display: inline-flex;
+    --teaser-action-background: var(--color-amber-800);
+    --teaser-action-color: white;
+  }
+
+  .teaser-badge {
+    display: var(--teaser-badge-display, none);
+    align-self: flex-start;
+    margin-block-end: 0.75rem;
+    padding: 0.25rem 0.625rem;
+    border-radius: 0.25rem;
+    background: var(--color-amber-100);
+    color: var(--color-amber-900);
+    font-size: 0.75rem;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+
+  .teaser-action {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5rem;
+    min-block-size: 2.75rem;
+    padding: 0.5rem 1rem;
+    border: 1px solid var(--color-amber-800);
+    border-radius: 0.25rem;
+    background: var(--teaser-action-background, transparent);
+    color: var(--teaser-action-color, var(--color-amber-800));
+    font-size: 0.875rem;
+    font-weight: 600;
+    text-decoration: none;
+  }
+
+  .teaser-action:hover {
+    text-decoration: underline;
+    text-underline-offset: 0.2em;
+  }
+
+  .teaser-action:focus-visible {
+    outline: 2px solid var(--color-amber-800);
+    outline-offset: 3px;
+  }
+
+  /* Components react to context without knowing which layout provides it. */
+  @container style(--surface: featured) {
+    .teaser-badge {
+      display: inline-flex;
+    }
+
+    .teaser-action {
+      background: var(--color-amber-800);
+      color: white;
+    }
+  }
+
+  @container style(--surface: default) {
+    .teaser-badge {
+      display: none;
+    }
+
+    .teaser-action {
+      background: transparent;
+      color: var(--color-amber-800);
+    }
+  }
+}
