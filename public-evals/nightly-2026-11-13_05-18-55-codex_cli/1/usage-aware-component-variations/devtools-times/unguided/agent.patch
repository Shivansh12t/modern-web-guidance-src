--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1,7 +1,68 @@
 @import "tailwindcss";
 
+/* Section context is inherited by every teaser and action inside it. */
+section[data-presentation="default"] {
+  --teaser-badge-display: none;
+  --teaser-background: transparent;
+  --action-background: transparent;
+  --action-color: #92400e;
+  --action-hover-background: #fffbeb;
+}
+
+section[data-presentation="featured"] {
+  --teaser-badge-display: inline-flex;
+  --teaser-background: #fffbeb;
+  --action-background: #92400e;
+  --action-color: #ffffff;
+  --action-hover-background: #78350f;
+}
+
+.teaser-card {
+  background-color: var(--teaser-background, transparent);
+}
+
+.teaser-badge {
+  display: var(--teaser-badge-display, none);
+  align-self: flex-start;
+  margin-bottom: 0.75rem;
+  padding: 0.25rem 0.625rem;
+  border-radius: 9999px;
+  background-color: #fde68a;
+  color: #78350f;
+  font-size: 0.75rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.article-action {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  align-self: flex-start;
+  gap: 0.5rem;
+  margin-top: 1rem;
+  padding: 0.5rem 1rem;
+  border: 1px solid #92400e;
+  border-radius: 0.375rem;
+  background-color: var(--action-background, transparent);
+  color: var(--action-color, #92400e);
+  font-size: 0.875rem;
+  font-weight: 600;
+  transition: background-color 150ms ease;
+}
+
+.article-action:hover {
+  background-color: var(--action-hover-background, #fffbeb);
+}
+
+.article-action:focus-visible {
+  outline: 2px solid #92400e;
+  outline-offset: 3px;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
