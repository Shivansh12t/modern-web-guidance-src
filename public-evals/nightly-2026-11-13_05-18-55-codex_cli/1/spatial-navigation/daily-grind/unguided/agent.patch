+const directions = {
+  ArrowLeft: ['left', 'right', 'top', 'bottom', -1],
+  ArrowRight: ['left', 'right', 'top', 'bottom', 1],
+  ArrowUp: ['top', 'bottom', 'left', 'right', -1],
+  ArrowDown: ['top', 'bottom', 'left', 'right', 1],
+};
+
+// Work in physical coordinates so CSS column counts, ordering, and direction
+// do not need to be duplicated in JavaScript. Edges never wrap to another row.
+export function findNeighbor(rects, currentIndex, key) {
+  const direction = directions[key];
+  const current = rects[currentIndex];
+  if (!direction || !current) return -1;
+
+  const [start, end, crossStart, crossEnd, sign] = direction;
+  const horizontal = key === 'ArrowLeft' || key === 'ArrowRight';
+  const center = (rect) => (rect[crossStart] + rect[crossEnd]) / 2;
+  let bestIndex = -1;
+  let bestDistance = Infinity;
+  let bestOffset = Infinity;
+
+  rects.forEach((rect, index) => {
+    if (index === currentIndex) return;
+    const distance = sign > 0
+      ? rect[start] - current[end]
+      : current[start] - rect[end];
+    // Allow a subpixel rounding difference at shared edges.
+    if (distance < -1) return;
+    const overlap = Math.min(rect[crossEnd], current[crossEnd])
+      - Math.max(rect[crossStart], current[crossStart]);
+    if (horizontal && overlap <= 0) return;
+
+    const offset = Math.abs(center(rect) - center(current));
+    if (distance < bestDistance - 1
+      || (Math.abs(distance - bestDistance) <= 1 && offset < bestOffset)) {
+      bestIndex = index;
+      bestDistance = distance;
+      bestOffset = offset;
+    }
+  });
+  return bestIndex;
+}
+
+export function initializeCardNavigation(root) {
+  root.querySelectorAll('[data-card-grid]').forEach((grid) => {
+    grid.addEventListener('keydown', (event) => {
+      if (!Object.hasOwn(directions, event.key)
+        || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey
+        || event.defaultPrevented) return;
+
+      const link = event.target.closest('[data-card-link]');
+      if (!link || link.closest('[data-card-grid]') !== grid) return;
+
+      // Read fresh geometry on every keypress, including after responsive
+      // reflow. Hidden cards must never receive focus.
+      const entries = Array.from(grid.querySelectorAll('[data-card-link]'))
+        .filter((item) => item.closest('[data-card-grid]') === grid
+          && !item.closest('[hidden], [inert], [aria-hidden="true"]'))
+        .map((item) => ({ link: item, rect: item.closest('.card').getBoundingClientRect() }))
+        .filter(({ link: item, rect }) => rect.width > 0 && rect.height > 0
+          && item.getClientRects().length > 0
+          && getComputedStyle(item).visibility === 'visible');
+      const currentIndex = entries.findIndex((entry) => entry.link === link);
+      if (currentIndex < 0) return;
+
+      event.preventDefault();
+      const nextIndex = findNeighbor(entries.map((entry) => entry.rect), currentIndex, event.key);
+      if (nextIndex >= 0) entries[nextIndex].link.focus();
+    });
+  });
+}
+
+if (typeof document !== 'undefined') initializeCardNavigation(document);
diff --git a/card-navigation.test.mjs b/card-navigation.test.mjs
new file mode 100644
index 0000000..a01f3f4
--- /dev/null
+++ b/card-navigation.test.mjs
@@ -0,0 +1,107 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { findNeighbor, initializeCardNavigation } from './card-navigation.mjs';
+
+const box = (left, top, width = 250, height = 200) => ({
+  left, top, right: left + width, bottom: top + height, width, height,
+});
+
+test('three columns: arrows follow physical positions and stop at edges', () => {
+  const rects = [box(0, 0), box(270, 0), box(540, 0)];
+  assert.equal(findNeighbor(rects, 0, 'ArrowRight'), 1);
+  assert.equal(findNeighbor(rects, 2, 'ArrowLeft'), 1);
+  assert.equal(findNeighbor(rects, 0, 'ArrowLeft'), -1);
+  assert.equal(findNeighbor(rects, 2, 'ArrowRight'), -1);
+  assert.equal(findNeighbor(rects, 1, 'ArrowDown'), -1);
+  assert.equal(findNeighbor(rects, 1, 'ArrowUp'), -1);
+});
+
+test('two columns: vertical arrows reach an incomplete final row without wrapping', () => {
+  const rects = [box(0, 0), box(270, 0), box(0, 220)];
+  assert.equal(findNeighbor(rects, 0, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(rects, 1, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(rects, 2, 'ArrowUp'), 0);
+  assert.equal(findNeighbor(rects, 1, 'ArrowRight'), -1);
+  assert.equal(findNeighbor(rects, 2, 'ArrowLeft'), -1);
+});
+
+test('single column: only vertical arrows move focus', () => {
+  const rects = [box(0, 0), box(0, 220), box(0, 440)];
+  assert.equal(findNeighbor(rects, 1, 'ArrowUp'), 0);
+  assert.equal(findNeighbor(rects, 1, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(rects, 1, 'ArrowLeft'), -1);
+  assert.equal(findNeighbor(rects, 1, 'ArrowRight'), -1);
+});
+
+test('visual reordering and RTL positions override DOM order', () => {
+  const rects = [box(540, 0), box(0, 0), box(270, 0)];
+  assert.equal(findNeighbor(rects, 0, 'ArrowLeft'), 2);
+  assert.equal(findNeighbor(rects, 1, 'ArrowRight'), 2);
+});
+
+test('vertical movement chooses the nearest row, then the nearest column', () => {
+  const rects = [box(270, 0), box(0, 220), box(270, 440)];
+  assert.equal(findNeighbor(rects, 0, 'ArrowDown'), 1);
+});
+
+test('unequal card heights do not cause vertical movement within the same row', () => {
+  const rects = [box(0, 0), box(270, 0, 250, 100), box(0, 220)];
+  assert.equal(findNeighbor(rects, 1, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(rects, 0, 'ArrowRight'), 1);
+  assert.equal(findNeighbor(rects, 1, 'ArrowUp'), -1);
+});
+
+test('empty grids, a single card, and unrelated keys have no destination', () => {
+  assert.equal(findNeighbor([], 0, 'ArrowDown'), -1);
+  assert.equal(findNeighbor([box(0, 0)], 0, 'ArrowRight'), -1);
+  assert.equal(findNeighbor([box(0, 0)], 0, 'Enter'), -1);
+});
+
+test('keyboard handler refreshes layout, skips hidden cards, and preserves native keys', (t) => {
+  const originalStyle = Object.getOwnPropertyDescriptor(globalThis, 'getComputedStyle');
+  globalThis.getComputedStyle = () => ({ visibility: 'visible' });
+  t.after(() => {
+    if (originalStyle) Object.defineProperty(globalThis, 'getComputedStyle', originalStyle);
+    else delete globalThis.getComputedStyle;
+  });
+  let handler;
+  let focused;
+  const grid = {
+    addEventListener: (_, callback) => { handler = callback; },
+    querySelectorAll: () => links,
+  };
+  const links = [0, 1, 2].map((index) => ({
+    rect: box(index * 270, 0),
+    hidden: false,
+    closest(selector) {
+      if (selector === '[data-card-link]') return this;
+      if (selector === '[data-card-grid]') return grid;
+      if (selector === '.card') return { getBoundingClientRect: () => this.rect };
+      return this.hidden ? this : null;
+    },
+    getClientRects: () => [1],
+    focus: () => { focused = index; },
+  }));
+  initializeCardNavigation({ querySelectorAll: () => [grid] });
+  const press = (key, options = {}) => {
+    focused = undefined;
+    let prevented = false;
+    handler({ key, target: links[0], preventDefault: () => { prevented = true; }, ...options });
+    return prevented;
+  };
+  assert.equal(press('ArrowRight'), true);
+  assert.equal(focused, 1);
+  links[1].hidden = true;
+  press('ArrowRight');
+  assert.equal(focused, 2);
+  links.forEach((link, index) => { link.rect = box(0, index * 220); });
+  press('ArrowDown');
+  assert.equal(focused, 2);
+  assert.equal(press('ArrowRight'), true);
+  assert.equal(focused, undefined);
+  for (const key of ['Tab', 'Enter', ' ']) assert.equal(press(key), false);
+  for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'defaultPrevented']) {
+    assert.equal(press('ArrowDown', { [modifier]: true }), false);
+    assert.equal(focused, undefined);
+  }
+});
