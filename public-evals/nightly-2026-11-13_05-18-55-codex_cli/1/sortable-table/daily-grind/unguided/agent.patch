+  <script>
+    const seasonalDrinks = document.getElementById('seasonal-drinks');
+    const sortableHeaders = seasonalDrinks.querySelectorAll('th[aria-sort]');
+    const collator = new Intl.Collator('en', { sensitivity: 'base' });
+
+    sortableHeaders.forEach((header) => {
+      header.querySelector('button').addEventListener('click', () => {
+        const ascending = header.getAttribute('aria-sort') !== 'ascending';
+        const rows = Array.from(seasonalDrinks.tBodies[0].rows);
+
+        rows.sort((a, b) => {
+          const comparison = collator.compare(
+            a.cells[header.cellIndex].textContent.trim(),
+            b.cells[header.cellIndex].textContent.trim()
+          );
+          return ascending ? comparison : -comparison;
+        });
+
+        sortableHeaders.forEach((otherHeader) => otherHeader.setAttribute('aria-sort', 'none'));
+        header.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');
+        seasonalDrinks.tBodies[0].append(...rows);
+      });
+    });
+  </script>
