+  <script>
+    const shop = document.getElementById('local-shop');
+    const shopError = document.getElementById('local-shop-error');
+    const announcement = document.getElementById('order-announcement');
+    let announceTimer;
+
+    const syncShopError = (invalid, announce = false) => {
+      const wasInvalid = shop.getAttribute('aria-invalid') === 'true';
+      shop.setAttribute('aria-invalid', String(invalid));
+      if (invalid) {
+        shop.setAttribute('aria-describedby', shopError.id);
+      } else {
+        shop.removeAttribute('aria-describedby');
+      }
+      clearTimeout(announceTimer);
+      announcement.textContent = '';
+      if (invalid && !wasInvalid && announce) {
+        announceTimer = setTimeout(() => {
+          announcement.textContent = shopError.textContent;
+        }, 500);
+      }
+    };
+
+    // Let the browser update :user-invalid before syncing accessible feedback.
+    for (const event of ['blur', 'input', 'change']) {
+      shop.addEventListener(event, () => {
+        requestAnimationFrame(() => {
+          syncShopError(shop.matches(':user-invalid'), event !== 'input');
+        });
+      });
+    }
+
+    // Native validation blocks submission and focuses this required field.
+    shop.addEventListener('invalid', () => syncShopError(true));
+    shop.form.addEventListener('reset', () => {
+      requestAnimationFrame(() => syncShopError(false));
+    });
+  </script>
