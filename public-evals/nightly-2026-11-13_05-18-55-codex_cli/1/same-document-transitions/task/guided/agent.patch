+<script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const descriptions = {
+      maple: 'Our seasonal favorite pairs rich espresso with creamy oat milk and a hint of Vermont maple syrup. A little sweetness, a smooth finish, and all the comfort of a crisp autumn morning.',
+      espresso: 'Deeply roasted beans bring a bold, smoky character to this concentrated classic. Freshly pulled for a rich crema and a full-bodied finish. Perfect for your morning boost or an afternoon pause.',
+      'cold-brew': 'Slowly steeped for 18 hours, our cold brew brings out the mellow sweetness of the beans. Served over ice for a smooth, refreshing coffee with a clean finish.'
+    };
+    let selectedCard = null;
+    let busy = false;
+    let listScroll = 0;
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    async function changeView(showDetail) {
+      const update = () => {
+        listPage.hidden = showDetail;
+        detailPage.hidden = !showDetail;
+        if (showDetail) {
+          document.querySelector('main').scrollIntoView({ block: 'start', behavior: 'instant' });
+        } else {
+          window.scrollTo({ top: listScroll, behavior: 'instant' });
+        }
+      };
+      try {
+        if (document.startViewTransition && !reducedMotion.matches) {
+          const transition = document.startViewTransition(update);
+          // A skipped animation still commits the DOM update.
+          await transition.finished.catch(() => {});
+        } else {
+          update();
+        }
+      } finally {
+        const heading = document.getElementById(showDetail ? 'title' : 'list-heading');
+        heading.focus({ preventScroll: true });
+        // Keep names only for the selected pair during forward/reverse snapshots.
+        selectedCard?.classList.remove('selected');
+        busy = false;
+      }
+    }
+
+    document.querySelectorAll('.thumbnail').forEach(card => {
+      card.querySelector('button').addEventListener('click', async () => {
+        if (busy) return;
+        busy = true;
+        selectedCard = card;
+        listScroll = window.scrollY;
+        const image = card.querySelector('img');
+        hero.src = image.currentSrc || image.src;
+        hero.alt = image.alt;
+        title.textContent = card.querySelector('.title').textContent;
+        document.getElementById('description').textContent = descriptions[card.dataset.favorite];
+        // Prepare the full-size image before taking the destination snapshot.
+        await hero.decode().catch(() => {});
+        card.classList.add('selected');
+        await changeView(true);
+      });
+    });
+
+    document.getElementById('back').addEventListener('click', () => {
+      if (busy || !selectedCard) return;
+      busy = true;
+      selectedCard.classList.add('selected');
+      changeView(false);
+    });
+  </script>
