+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const emailError = document.getElementById('newsletter-error');
+    const signupStatus = newsletter.querySelector('[role="status"]');
+
+    // Keep native email constraints, but control when feedback appears.
+    newsletter.noValidate = true;
+
+    function setEmailError(show) {
+      email.setAttribute('aria-invalid', String(show));
+      emailError.hidden = !show;
+      if (show) {
+        email.setAttribute('aria-describedby', emailError.id);
+      } else {
+        email.removeAttribute('aria-describedby');
+      }
+    }
+
+    email.addEventListener('blur', () => {
+      const invalid = !email.validity.valid;
+      setEmailError(invalid);
+      signupStatus.textContent = invalid ? emailError.textContent : '';
+    });
+
+    email.addEventListener('focus', () => {
+      setEmailError(false);
+      signupStatus.textContent = '';
+    });
+
+    email.addEventListener('input', () => {
+      setEmailError(false);
+      signupStatus.textContent = '';
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!email.validity.valid) {
+        email.focus();
+        setEmailError(true);
+        return;
+      }
+
+      setEmailError(false);
+      // Replace with a newsletter provider request when one is configured.
+      signupStatus.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
