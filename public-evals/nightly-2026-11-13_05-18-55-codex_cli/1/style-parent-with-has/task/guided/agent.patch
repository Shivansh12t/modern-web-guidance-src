+  <script>
+    const contactForm = document.getElementById('contact-form');
+    const contactFields = [...contactForm.querySelectorAll('input, textarea')];
+    const errorAnnouncer = document.getElementById('contact-errors');
+    const contactStatus = document.getElementById('contact-status');
+    let announceTimer;
+
+    function validateContent(field) {
+      // Keep names unrestricted while rejecting whitespace-only names and messages.
+      field.setCustomValidity(field.value && !field.value.trim()
+        ? document.getElementById(field.dataset.error).textContent : '');
+    }
+
+    function syncError(field, showError, announce = false) {
+      const previouslyInvalid = field.getAttribute('aria-invalid') === 'true';
+      field.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        field.setAttribute('aria-describedby', field.dataset.error);
+      } else {
+        field.removeAttribute('aria-describedby');
+      }
+      if (announce && showError && !previouslyInvalid) {
+        clearTimeout(announceTimer);
+        errorAnnouncer.textContent = '';
+        announceTimer = setTimeout(() => {
+          errorAnnouncer.textContent = document.getElementById(field.dataset.error).textContent;
+        }, 500);
+      }
+    }
+
+    contactFields.forEach((field) => {
+      field.addEventListener('blur', () => {
+        validateContent(field);
+        // Leaving a required field blank counts as interaction, even without typing.
+        syncError(field, !field.validity.valid, true);
+      });
+      field.addEventListener('input', () => {
+        validateContent(field);
+        clearTimeout(announceTimer);
+        errorAnnouncer.textContent = '';
+        contactStatus.textContent = '';
+        const showError = !field.validity.valid &&
+          (field.matches(':user-invalid') || field.getAttribute('aria-invalid') === 'true');
+        syncError(field, showError);
+      });
+      field.addEventListener('invalid', () => {
+        clearTimeout(announceTimer);
+        errorAnnouncer.textContent = '';
+        syncError(field, true);
+      });
+    });
+
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      contactFields.forEach(validateContent);
+      if (!contactForm.reportValidity()) return;
+      // No delivery service is configured for this static page; preserve the draft.
+      contactStatus.textContent = 'Message delivery is currently unavailable. Your message has not been sent. Please visit us in store for help.';
+    });
+  </script>
