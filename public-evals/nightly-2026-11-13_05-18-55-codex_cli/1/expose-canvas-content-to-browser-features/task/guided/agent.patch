+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const controls = document.getElementById('cup-controls');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('cup-milk');
+      const syrup = document.getElementById('cup-syrup');
+      const ctx = canvas.getContext('2d');
+      let nativeHTML = Boolean(ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function');
+
+      // Move the same controls, preserving native input, select, and keyboard behavior.
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.onpaint = null;
+        canvas.removeAttribute('content');
+        canvas.setAttribute('aria-hidden', 'true');
+        stage.append(controls);
+      }
+
+      if (!nativeHTML) useOverlay();
+      if (!ctx) return;
+
+      let width = 480;
+      let height = 540;
+      const milkColors = { oat: '#bd9066', whole: '#d5ad82', almond: '#bb8a59', soy: '#c5a17b', none: '#593726' };
+
+      function drawCup() {
+        // Work in CSS pixels; only the backing store uses physical display pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+        const center = width / 2;
+        ctx.fillStyle = '#e2d3c2';
+        ctx.beginPath();
+        ctx.ellipse(center, 506, width * 0.36, 13, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        ctx.strokeStyle = '#c4ad97';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        for (const offset of [-28, 0, 28]) {
+          ctx.beginPath();
+          ctx.moveTo(center + offset, 80);
+          ctx.bezierCurveTo(center + offset - 15, 64, center + offset + 15, 53, center + offset, 36);
+          ctx.stroke();
+        }
+
+        const paper = ctx.createLinearGradient(width * 0.1, 0, width * 0.9, 0);
+        paper.addColorStop(0, '#e5cdb0');
+        paper.addColorStop(0.45, '#fff3df');
+        paper.addColorStop(1, '#e5cdb0');
+        ctx.fillStyle = paper;
+        ctx.strokeStyle = '#c8ad8b';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(width * 0.1, 126);
+        ctx.lineTo(width * 0.18, 478);
+        ctx.quadraticCurveTo(center, 507, width * 0.82, 478);
+        ctx.lineTo(width * 0.9, 126);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        ctx.fillStyle = '#fff8ec';
+        ctx.beginPath();
+        ctx.ellipse(center, 126, width * 0.4, 26, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = milkColors[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(center, 126, width * 0.365, 18, 0, 0, Math.PI * 2);
+        ctx.fill();
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = syrup.value === 'caramel' ? '#9b5926' : '#805439';
+          ctx.lineWidth = 2;
+          ctx.beginPath();
+          ctx.ellipse(center, 126, width * 0.18, 7, 0, 0, Math.PI * 2);
+          ctx.stroke();
+        }
+      }
+
+      function render() {
+        drawCup();
+        if (nativeHTML) {
+          try {
+            // drawElementImage also maps hit testing and focus to these coordinates.
+            ctx.drawElementImage(controls, width * 0.2, 184);
+          } catch {
+            // A partial API implementation must still leave the form usable.
+            useOverlay();
+            drawCup();
+          }
+        }
+      }
+
+      function requestRender() {
+        if (nativeHTML) canvas.requestPaint();
+        else render();
+      }
+
+      function updateOrder() {
+        const cupName = name.value.trim();
+        document.getElementById('cup-title').textContent = cupName ? `${cupName}’s latte` : 'Your latte';
+        document.getElementById('cup-recipe').textContent =
+          `${milk.selectedOptions[0].textContent} · ${syrup.selectedOptions[0].textContent}`;
+        requestRender();
+      }
+
+      if (nativeHTML) canvas.onpaint = render;
+      controls.addEventListener('input', updateOrder);
+      controls.addEventListener('change', updateOrder);
+      // Repaint native focus rings, text selections, and open-control styling too.
+      for (const event of ['focusin', 'focusout', 'pointerup', 'keyup']) {
+        controls.addEventListener(event, requestRender);
+      }
+
+      function resize(entry) {
+        const bounds = canvas.getBoundingClientRect();
+        width = bounds.width;
+        height = bounds.height;
+        if (!width || !height) return;
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        const dpr = window.devicePixelRatio || 1;
+        canvas.width = pixels ? pixels.inlineSize : Math.round(width * dpr);
+        canvas.height = pixels ? pixels.blockSize : Math.round(height * dpr);
+        controls.style.width = `${width * 0.6}px`;
+        requestRender();
+      }
+
+      const observer = new ResizeObserver(([entry]) => resize(entry));
+      const supportsDevicePixels = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixels ? { box: 'device-pixel-content-box' } : {});
+      // Also cover zoom and moving between displays with different pixel densities.
+      let densityQuery;
+      function watchDensity() {
+        densityQuery?.removeEventListener('change', onDensityChange);
+        densityQuery = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        densityQuery.addEventListener('change', onDensityChange);
+      }
+      function onDensityChange() {
+        resize();
+        watchDensity();
+      }
+      window.addEventListener('resize', () => resize());
+      watchDensity();
+      resize();
+    })();
+  </script>
