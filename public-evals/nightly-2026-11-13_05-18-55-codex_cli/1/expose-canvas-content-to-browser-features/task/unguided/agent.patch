+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const context = canvas.getContext('2d');
+      const stage = canvas.parentElement;
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('cup-milk');
+      const syrup = document.getElementById('cup-syrup');
+      const summary = document.getElementById('order-summary');
+      const milkColors = {
+        'Whole milk': '#fff6e5', 'Oat milk': '#ead6b4',
+        'Almond milk': '#e9c89d', 'Soy milk': '#f1e3c5', 'No milk': '#67412c'
+      };
+      const syrupColors = {
+        'No syrup': '#745346', Maple: '#936038', Vanilla: '#ac8860',
+        Caramel: '#b77736', Hazelnut: '#80503b'
+      };
+
+      function draw() {
+        if (!context) return;
+        const bounds = canvas.getBoundingClientRect();
+        const ratio = window.devicePixelRatio || 1;
+        const width = Math.round(bounds.width * ratio);
+        const height = Math.round(bounds.height * ratio);
+        if (!width || !height) return;
+        if (canvas.width !== width || canvas.height !== height) {
+          canvas.width = width;
+          canvas.height = height;
+        }
+        context.setTransform(width / 600, 0, 0, height / 620, 0, 0);
+        context.clearRect(0, 0, 600, 620);
+
+        // Soft backdrop and a grounded shadow.
+        context.fillStyle = '#eae0d1';
+        context.beginPath();
+        context.ellipse(300, 315, 245, 245, 0, 0, Math.PI * 2);
+        context.fill();
+        context.fillStyle = '#d8c8b4';
+        context.beginPath();
+        context.ellipse(300, 566, 177, 15, 0, 0, Math.PI * 2);
+        context.fill();
+
+        // Steam curls.
+        context.strokeStyle = '#c6b298';
+        context.lineWidth = 5;
+        context.lineCap = 'round';
+        [260, 300, 340].forEach((x) => {
+          context.beginPath();
+          context.moveTo(x, 100);
+          context.bezierCurveTo(x - 20, 78, x + 20, 65, x, 43);
+          context.stroke();
+        });
+
+        // Cup body reflects the selected milk.
+        context.beginPath();
+        context.moveTo(120, 164);
+        context.lineTo(480, 164);
+        context.lineTo(441, 548);
+        context.quadraticCurveTo(300, 577, 159, 548);
+        context.closePath();
+        const body = context.createLinearGradient(120, 0, 480, 0);
+        body.addColorStop(0, '#fffaf1');
+        body.addColorStop(1, milkColors[milk.value]);
+        context.fillStyle = body;
+        context.fill();
+        context.strokeStyle = '#d5c0a5';
+        context.lineWidth = 2;
+        context.stroke();
+
+        // Sleeve and HTML controls use the same design coordinates.
+        context.beginPath();
+        context.moveTo(127, 204);
+        context.lineTo(473, 204);
+        context.lineTo(445, 480);
+        context.quadraticCurveTo(300, 500, 155, 480);
+        context.closePath();
+        context.fillStyle = syrupColors[syrup.value];
+        context.fill();
+
+        // Two-piece takeaway lid.
+        context.fillStyle = '#3e2c27';
+        context.beginPath();
+        context.roundRect(132, 119, 336, 38, 12);
+        context.fill();
+        context.fillStyle = '#574139';
+        context.beginPath();
+        context.roundRect(106, 145, 388, 30, 10);
+        context.fill();
+        context.fillStyle = '#291e1a';
+        context.beginPath();
+        context.roundRect(342, 128, 66, 8, 4);
+        context.fill();
+      }
+
+      function update() {
+        const cupName = name.value.trim();
+        const syrupText = syrup.value === 'No syrup' ? 'No syrup' : `${syrup.value} syrup`;
+        summary.textContent = `${cupName ? `${cupName}’s coffee` : 'Your coffee'} · ${milk.value} · ${syrupText}`;
+        draw();
+      }
+
+      document.querySelector('.cup-controls').addEventListener('input', update);
+      document.querySelector('.cup-controls').addEventListener('change', update);
+      new ResizeObserver(draw).observe(stage);
+      window.addEventListener('resize', draw);
+      // Re-arm the query whenever zooming or moving to a different-DPI display.
+      function watchPixelRatio() {
+        const query = window.matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          draw();
+          watchPixelRatio();
+        }, { once: true });
+      }
+      watchPixelRatio();
+      update();
+    })();
+  </script>
+
 </body>
 
