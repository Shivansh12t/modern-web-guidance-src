+  <script type="module">
+    const button = document.getElementById('summarize-journal');
+    const status = document.getElementById('journal-status');
+    const summary = document.getElementById('journal-summary');
+    const points = document.getElementById('journal-summary-points');
+    const options = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+      monitor(monitor) {
+        monitor.addEventListener('downloadprogress', (event) => {
+          const percent = Math.round(event.loaded * 100);
+          status.textContent = `Downloading the on-device AI model: ${percent}%. This may take a few minutes.`;
+        });
+      },
+    };
+
+    // Check before the click so model creation retains the user's activation.
+    async function prepareSummarizer() {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        status.textContent = 'On-device summaries are unavailable in this browser. Try a browser with built-in AI on HTTPS; the full journal is above.';
+        return;
+      }
+
+      try {
+        const availability = await window.Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          status.textContent = 'On-device AI is unavailable on this device. You can still read the full journal above.';
+          return;
+        }
+        status.textContent = availability === 'available'
+          ? 'Get a few key points with AI running on your device.'
+          : 'Your first summary needs an AI model download, which may take a few minutes. The summary runs on your device.';
+        button.disabled = false;
+      } catch {
+        status.textContent = 'Could not check on-device AI availability. Reload the page to try again; the full journal is above.';
+      }
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      button.textContent = 'Summarizing…';
+      summary.setAttribute('aria-busy', 'true');
+      status.textContent = 'Preparing your on-device summary…';
+      let summarizer;
+
+      try {
+        summarizer = await window.Summarizer.create(options);
+        status.textContent = 'Reading the journal and finding the key points…';
+        const text = document.getElementById('journal-text').innerText;
+        const result = await summarizer.summarize(text);
+        const items = result.split(/\r?\n/)
+          .map((line) => line.trim().replace(/^(?:[-*•]\s*|\d+[.)]\s+)/, '').trim())
+          .filter(Boolean);
+        if (!items.length) throw new Error('Empty summary');
+
+        // Treat model output as text, never as HTML.
+        points.replaceChildren(...items.map((item) => {
+          const li = document.createElement('li');
+          li.textContent = item;
+          return li;
+        }));
+        summary.hidden = false;
+        status.textContent = 'Your AI-generated key points are ready below. See the full journal above for details.';
+      } catch (error) {
+        status.textContent = error.name === 'NotAllowedError'
+          ? 'The browser could not start on-device AI. Check its AI permissions, then select Summarize to try again.'
+          : 'The on-device summary could not finish. Select Summarize to try again, or read the full journal above.';
+      } finally {
+        summarizer?.destroy();
+        summary.setAttribute('aria-busy', 'false');
+        button.textContent = 'Summarize';
+        button.disabled = false;
+      }
+    });
+
+    prepareSummarizer();
+  </script>
+
 </body>
 
