+        <button id="summarize-journal" class="btn" type="button" aria-controls="journal-summary" aria-describedby="journal-status">Summarize</button>
+        <p id="journal-status" class="journal-status" role="status" aria-live="polite">Short on time? Get a few key points with your browser's built-in AI. First use may download a model.</p>
+        <div id="journal-summary" class="journal-summary" aria-labelledby="summary-heading" hidden>
+          <h3 id="summary-heading">Our sourcing, at a glance</h3>
+          <ul id="journal-summary-points"></ul>
+          <p class="journal-status">AI-generated summary. Read the journal above for the full story.</p>
+        </div>
+      </div>
+    </section>
