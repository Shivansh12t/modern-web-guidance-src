+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'Built-in AI summarization is not supported here. Try a compatible desktop browser, such as Chrome, on HTTPS or localhost. You can still read the full journal above.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.hidden = true;
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Checking your browser’s AI availability…';
+      let summarizer;
+
+      try {
+        const options = {
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en'
+        };
+        const availability = await window.Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'Your browser’s AI model is unavailable on this device. You can still read the full journal above.';
+          return;
+        }
+
+        journalStatus.textContent = availability === 'available'
+          ? 'Summarizing the journal on your device…'
+          : 'Preparing your browser’s AI model. The first download may take a few minutes…';
+        summarizer = await window.Summarizer.create({
+          ...options,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const percent = Math.round(event.loaded * 100);
+              journalStatus.textContent = percent < 100
+                ? `Downloading your browser’s AI model… ${percent}%`
+                : 'Summarizing the journal on your device…';
+            });
+          }
+        });
+
+        const source = document.getElementById('journal-story').innerText;
+        const summary = await summarizer.summarize(source);
+        // Build real list items without interpreting AI output as HTML.
+        const points = [];
+        for (const line of summary.split(/\r?\n/)) {
+          const text = line.trim();
+          if (!text) continue;
+          const bullet = /^(?:[-*•–]|\d+[.)])\s+/;
+          if (bullet.test(text) || points.length === 0) {
+            points.push(text.replace(bullet, ''));
+          } else {
+            points[points.length - 1] += ` ${text}`;
+          }
+        }
+        if (!points.length) throw new Error('Empty summary');
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your summary is ready below. Generated on your device with built-in AI.';
+      } catch (error) {
+        journalStatus.textContent = 'The browser couldn’t create a summary. Please try again. If a model download is needed, check your connection and browser AI settings.';
+      } finally {
+        summarizer?.destroy();
+        summaryPanel.removeAttribute('aria-busy');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+  </script>
+
