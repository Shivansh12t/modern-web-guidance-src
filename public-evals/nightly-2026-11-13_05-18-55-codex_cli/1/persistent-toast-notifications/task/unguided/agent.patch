+  <script>
+    (() => {
+      const stack = document.querySelector('.toast-stack');
+      const announcer = document.querySelector('#toast-announcer');
+      const active = new Map();
+      let announceTimer;
+
+      function dismiss(toast, restoreFocus = false) {
+        const state = active.get(toast);
+        if (!state) return;
+        clearTimeout(state.timer);
+        active.delete(toast);
+        if (restoreFocus && toast.contains(document.activeElement)) state.trigger.focus();
+        toast.classList.add('is-leaving');
+        // A timeout also removes the element when animation events are unavailable.
+        setTimeout(() => toast.remove(), 220);
+      }
+
+      function pause(toast) {
+        const state = active.get(toast);
+        if (!state || !state.timer) return;
+        clearTimeout(state.timer);
+        state.timer = null;
+        state.remaining = Math.max(0, state.remaining - (performance.now() - state.started));
+      }
+
+      function resume(toast) {
+        const state = active.get(toast);
+        if (!state || state.timer || document.hidden || toast.matches(':hover') || toast.contains(document.activeElement)) return;
+        state.started = performance.now();
+        state.timer = setTimeout(() => dismiss(toast), state.remaining);
+      }
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger) return;
+        const template = document.getElementById(trigger.dataset.toastTarget);
+        if (!(template instanceof HTMLTemplateElement)) return;
+        event.preventDefault();
+        // Bound the stack to the available screen height, including on phones.
+        const limit = Math.max(1, Math.min(4, Math.floor((window.innerHeight - 48) / 130)));
+        while (active.size >= limit) dismiss(active.keys().next().value, true);
+        const toast = template.content.querySelector('.toast').cloneNode(true);
+        stack.append(toast);
+        active.set(toast, { trigger, remaining: 6000, started: 0, timer: null });
+        toast.querySelector('.toast-close').addEventListener('click', () => dismiss(toast, true));
+        toast.addEventListener('pointerenter', () => pause(toast));
+        toast.addEventListener('pointerleave', () => resume(toast));
+        toast.addEventListener('focusin', () => pause(toast));
+        toast.addEventListener('focusout', () => queueMicrotask(() => resume(toast)));
+        toast.addEventListener('keydown', (event) => {
+          if (event.key === 'Escape') dismiss(toast, true);
+        });
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announceTimer = setTimeout(() => {
+          announcer.textContent = toast.querySelector('.toast-content').textContent;
+        }, 50);
+        resume(toast);
+      });
+
+      document.addEventListener('visibilitychange', () => {
+        for (const toast of active.keys()) document.hidden ? pause(toast) : resume(toast);
+      });
+    })();
+  </script>
