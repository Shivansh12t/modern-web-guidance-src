+  <div id="toast-stack" class="toast-stack" popover="manual" role="region" aria-label="Notifications" tabindex="-1"></div>
+  <p class="sr-only">Order announcements</p>
+  <div id="toast-announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
+  <template id="toast-template">
+    <article class="toast">
+      <span class="toast-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 12 4 4 8-8"/></svg></span>
+      <div class="toast-copy"><h3>Added to your order</h3><p></p></div>
+      <button type="button" class="toast-close" aria-label="Dismiss notification"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
+    </article>
+  </template>
+  <script>
+    (() => {
+      const stack = document.getElementById('toast-stack');
+      const template = document.getElementById('toast-template');
+      const announcer = document.getElementById('toast-announcer');
+      const nativePopover = 'popover' in HTMLElement.prototype;
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const order = new Map();
+      let count = 0;
+      let announcementTimer;
+
+      function dismissToast(toast, trigger) {
+        if (toast.classList.contains('is-leaving')) return;
+        const hadFocus = toast.contains(document.activeElement);
+        toast.classList.add('is-leaving');
+        const finish = () => {
+          if (!toast.isConnected) return;
+          toast.remove();
+          const remaining = stack.querySelector('.toast:not(.is-leaving) .toast-close');
+          if (hadFocus) (remaining || trigger)?.focus({ preventScroll: true });
+          if (!stack.childElementCount) {
+            if (nativePopover) stack.hidePopover();
+            stack.classList.remove('is-open');
+          }
+        };
+        if (reducedMotion.matches) finish();
+        else {
+          toast.addEventListener('animationend', finish, { once: true });
+          // Complete dismissal even if animations are disabled by user styles.
+          window.setTimeout(finish, 220);
+        }
+      }
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger) return;
+        const product = trigger.dataset.product;
+        const title = trigger.dataset.toastTitle || 'Added to your order';
+        let message = trigger.dataset.toastMessage || 'Your update is complete.';
+        if (product) {
+          count += 1;
+          order.set(product, (order.get(product) || 0) + 1);
+          document.getElementById('order-count').textContent = `${count} ${count === 1 ? 'drink' : 'drinks'} in your order`;
+          document.getElementById('order-detail').textContent = Array.from(order, ([name, quantity]) => `${quantity} × ${name}`).join(' · ');
+          message = `${product} is in your order. A little pick-me-up, on its way.`;
+        }
+        const toast = template.content.firstElementChild.cloneNode(true);
+        toast.querySelector('h3').textContent = title;
+        toast.querySelector('p').textContent = message;
+        toast.querySelector('.toast-close').addEventListener('click', () => dismissToast(toast, trigger));
+        stack.append(toast);
+        if (!stack.classList.contains('is-open')) {
+          if (nativePopover) stack.showPopover();
+          stack.classList.add('is-open');
+        }
+        stack.scrollTop = stack.scrollHeight;
+        const announcement = `${title}. ${message}`;
+        if (typeof document.ariaNotify === 'function') {
+          document.ariaNotify(announcement, { priority: 'normal' });
+        } else {
+          clearTimeout(announcementTimer);
+          announcer.textContent = '';
+          announcementTimer = window.setTimeout(() => { announcer.textContent = announcement; }, 100);
+        }
+      });
+    })();
+  </script>
