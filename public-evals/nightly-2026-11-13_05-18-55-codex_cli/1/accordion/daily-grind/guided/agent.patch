+    /* Coffee FAQ */
+    #coffee-faq {
+      margin-top: 40px;
+    }
+
+    #coffee-faq h2 {
+      text-align: center;
+      color: var(--primary);
+      margin-bottom: 20px;
+    }
+
+    .faq-item {
+      margin-top: 12px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .faq-trigger {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      width: 100%;
+      padding: 20px;
+      border: 0;
+      border-radius: 8px;
+      background: transparent;
+      color: var(--primary);
+      font: inherit;
+      font-weight: 600;
+      text-align: left;
+      cursor: pointer;
+    }
+
+    .faq-trigger::before {
+      content: '';
+      flex: 0 0 8px;
+      height: 8px;
+      border-right: 2px solid currentColor;
+      border-bottom: 2px solid currentColor;
+      transform: rotate(-45deg);
+      transition: transform 0.3s ease;
+    }
+
+    .faq-trigger[aria-expanded="true"]::before {
+      transform: rotate(45deg);
+    }
+
+    .faq-trigger:hover,
+    .faq-trigger[aria-expanded="true"] {
+      background: var(--secondary);
+    }
+
+    .faq-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .faq-panel {
+      display: grid;
+      grid-template-rows: 1fr;
+      visibility: visible;
+    }
+
+    /* Grid tracks animate natural content height without fixed height limits. */
+    .faq-ready .faq-panel {
+      grid-template-rows: 0fr;
+      visibility: hidden;
+      transition: grid-template-rows 0.3s ease, visibility 0s linear 0.3s;
+    }
+
+    .faq-ready .is-open .faq-panel {
+      grid-template-rows: 1fr;
+      visibility: visible;
+      transition-delay: 0s;
+    }
+
+    .faq-panel-inner {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    .faq-panel p {
+      padding: 16px 20px 20px;
+    }
+
+    .faq-panel a {
+      color: var(--primary);
+      text-underline-offset: 3px;
+    }
+
+    .faq-panel a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #coffee-faq .faq-panel,
+      #coffee-faq .faq-trigger::before {
+        transition: none;
+      }
+    }
+
