+  <script>
+    (() => {
+      const faq = document.getElementById('coffee-faq');
+      const items = [...faq.querySelectorAll('.faq-item')];
+
+      const setExpanded = (item, expanded) => {
+        const trigger = item.querySelector('.faq-trigger');
+        const panel = item.querySelector('.faq-panel');
+        // Return focus before making a closing panel unavailable.
+        if (!expanded && panel.contains(document.activeElement)) trigger.focus();
+        trigger.setAttribute('aria-expanded', String(expanded));
+        panel.inert = !expanded;
+        item.classList.toggle('is-open', expanded);
+      };
+
+      // Answers remain readable if JavaScript is unavailable.
+      items.forEach(item => {
+        setExpanded(item, false);
+        item.querySelector('.faq-trigger').addEventListener('click', () => {
+          const expand = !item.classList.contains('is-open');
+          items.forEach(other => setExpanded(other, other === item && expand));
+        });
+      });
+      faq.classList.add('faq-ready');
+    })();
+  </script>
