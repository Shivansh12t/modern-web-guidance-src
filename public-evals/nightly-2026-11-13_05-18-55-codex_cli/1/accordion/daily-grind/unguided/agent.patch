+    /* Coffee FAQ */
+    #coffee-faq {
+      margin-top: 48px;
+    }
+
+    #coffee-faq h2 {
+      text-align: center;
+      color: var(--primary);
+    }
+
+    .faq-intro {
+      text-align: center;
+      margin: 8px 0 24px;
+    }
+
+    .faq-item {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      margin-top: 12px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
+    }
+
+    .faq-question {
+      width: 100%;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      padding: 20px;
+      border: 0;
+      background: white;
+      color: var(--primary);
+      font: inherit;
+      font-weight: 600;
+      text-align: left;
+      cursor: pointer;
+      transition: background-color 0.25s ease;
+    }
+
+    .faq-question:hover,
+    .faq-question[aria-expanded="true"] {
+      background: #f5f0ed;
+    }
+
+    .faq-question:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -4px;
+    }
+
+    .faq-icon {
+      flex: 0 0 24px;
+      height: 24px;
+      display: grid;
+      place-items: center;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 1.25rem;
+      line-height: 1;
+      transition: transform 0.3s ease;
+    }
+
+    .faq-question[aria-expanded="true"] .faq-icon {
+      transform: rotate(45deg);
+    }
+
+    .faq-panel {
+      display: grid;
+      grid-template-rows: 0fr;
+      opacity: 0;
+      visibility: hidden;
+      transition: grid-template-rows 0.3s ease, opacity 0.3s ease,
+        visibility 0.3s;
+    }
+
+    .faq-panel.is-open {
+      grid-template-rows: 1fr;
+      opacity: 1;
+      visibility: visible;
+    }
+
+    .faq-panel-inner {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    .faq-panel p {
+      padding: 4px 20px 20px;
+    }
+
+    .faq-panel a {
+      color: var(--primary);
+      text-underline-offset: 3px;
+    }
+
+    .faq-panel a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .faq-question,
+      .faq-icon,
+      .faq-panel {
+        transition: none;
+      }
+    }
