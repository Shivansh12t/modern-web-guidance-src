@@ -206,7 +269,64 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('email-error');
+    const signupStatus = document.getElementById('signup-status');
+    let emailTouched = false;
+    let submitAttempted = false;
+
+    function validateEmail() {
+      let message = '';
+
+      if (emailTouched || submitAttempted) {
+        if (emailInput.validity.valueMissing) {
+          message = 'Please enter your email address.';
+        } else if (emailInput.validity.typeMismatch) {
+          message = 'Please enter a valid email address.';
+        }
+      }
+
+      emailError.textContent = message;
+      emailError.hidden = !message;
+
+      if (message) {
+        emailInput.setAttribute('aria-invalid', 'true');
+        emailInput.setAttribute('aria-describedby', 'email-error');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+        emailInput.removeAttribute('aria-describedby');
+      }
+
+      return emailInput.validity.valid;
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailTouched = true;
+      validateEmail();
+    });
+
+    emailInput.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      validateEmail();
+    });
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      submitAttempted = true;
+      signupStatus.textContent = '';
+
+      if (!validateEmail()) {
+        emailInput.focus();
+        return;
+      }
+
+      signupStatus.textContent = 'Online signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
