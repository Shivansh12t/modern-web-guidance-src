+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-error');
+    const announcement = document.getElementById('mailing-list-announcement');
+    const submissionStatus = document.getElementById('mailing-list-status');
+    let announcementTimer;
+
+    function syncEmailError(announce = false) {
+      const invalid = email.matches(':user-invalid');
+      const wasInvalid = email.getAttribute('aria-invalid') === 'true';
+      email.setAttribute('aria-invalid', String(invalid));
+      if (invalid) {
+        emailError.textContent = email.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter an email address in the format you@example.com.';
+        email.setAttribute('aria-describedby', emailError.id);
+        if (announce && !wasInvalid) {
+          clearTimeout(announcementTimer);
+          announcement.textContent = '';
+          announcementTimer = setTimeout(() => {
+            announcement.textContent = emailError.textContent;
+          }, 500);
+        }
+      } else {
+        email.removeAttribute('aria-describedby');
+        clearTimeout(announcementTimer);
+        announcement.textContent = '';
+      }
+    }
+
+    email.addEventListener('blur', () => syncEmailError(true));
+    email.addEventListener('input', () => {
+      syncEmailError();
+      submissionStatus.textContent = '';
+    });
+    email.addEventListener('change', () => syncEmailError(true));
+    email.addEventListener('invalid', () => {
+      // Let native validation focus the field and announce its linked error.
+      clearTimeout(announcementTimer);
+      announcement.textContent = '';
+      syncEmailError();
+    });
+    mailingList.addEventListener('reset', () => setTimeout(() => {
+      syncEmailError();
+      submissionStatus.textContent = '';
+    }));
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // This static site has no mailing list service connected yet.
+      submissionStatus.textContent = 'Online sign-up is currently unavailable. Please contact us to join our mailing list.';
+    });
+  </script>
+
 </body>
 
