+(() => {
+  'use strict';
+  const $ = id => document.getElementById(id);
+  const current = location.origin;
+  let destination = '';
+  let transfer = null;
+  $('current-origin').textContent = current;
+  function step(index) {
+    ['transfer-form', 'review', 'settle'].forEach((id, i) => $(id).hidden = i !== index);
+    document.querySelectorAll('[data-step]').forEach((el, i) => {
+      el.classList.toggle('current', i === index);
+      el.classList.toggle('done', i < index);
+      el.querySelector('b').textContent = i < index ? '✓' : String(i + 1);
+      if (i === index) el.setAttribute('aria-current', 'step');
+      else el.removeAttribute('aria-current');
+    });
+  }
+  function error(message) {
+    $('error').textContent = message;
+    $('error').hidden = !message;
+    $('destination').setAttribute('aria-invalid', String(Boolean(message)));
+  }
+  $('destination').addEventListener('input', () => error(''));
+  $('transfer-form').addEventListener('submit', event => {
+    event.preventDefault();
+    let url;
+    try { url = new URL($('destination').value.trim()); } catch { error('Enter a complete address, such as https://app.example.com.'); return; }
+    if (url.protocol !== 'https:' || url.username || url.password) { error('Use an HTTPS address without a username or password.'); return; }
+    if (url.pathname !== '/' || url.search || url.hash) { error('Enter only the origin, without a path, query, or fragment.'); return; }
+    if (url.origin === current) { error('Choose a different origin from your current address.'); return; }
+    destination = url.origin;
+    $('review-from').textContent = current;
+    $('review-to').textContent = destination;
+    $('review-settings').textContent = $('keep-settings').checked ? 'Local settings included' : 'Not included';
+    $('review-shortcuts').textContent = $('keep-shortcuts').checked ? 'Installation guide included' : 'Not included';
+    step(1);
+  });
+  $('back').addEventListener('click', () => step(0));
+  function download() {
+    try {
+      if (!transfer) {
+        const settings = Object.create(null);
+        if ($('keep-settings').checked) {
+          for (let i = 0; i < localStorage.length; i++) {
+            const key = localStorage.key(i);
+            // Authentication credentials are not portable configuration.
+            if (!/token|password|secret|credential|session|auth|cookie/i.test(key)) settings[key] = localStorage.getItem(key);
+          }
+        }
+        transfer = { format: 'daily-grind-transfer', version: 1, source: current, destination, createdAt: new Date().toISOString(), settings, shortcuts: $('keep-shortcuts').checked };
+      }
+      const url = URL.createObjectURL(new Blob([JSON.stringify(transfer, null, 2)], { type: 'application/json' }));
+      const link = document.createElement('a');
+      link.href = url;
+      link.download = 'daily-grind-transfer.json';
+      document.body.append(link); link.click(); link.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 1000);
+      $('open-destination').href = destination;
+      $('shortcut-instructions').hidden = !transfer.shortcuts;
+      step(2);
+    } catch {
+      $('export-error').textContent = 'Your browser could not export local settings. Allow local storage and downloads, then try again.';
+      $('export-error').hidden = false;
+    }
+  }
+  $('download').addEventListener('click', () => { transfer = null; download(); });
+  $('download-again').addEventListener('click', download);
+  $('start-over').addEventListener('click', () => { transfer = null; step(0); });
+  $('import-button').addEventListener('click', () => $('import-file').click());
+  $('import-file').addEventListener('change', async event => {
+    const file = event.target.files[0];
+    if (!file) return;
+    const status = $('import-status');
+    try {
+      if (file.size > 5 * 1024 * 1024) throw new Error('This transfer file is too large (maximum 5 MB).');
+      const data = JSON.parse(await file.text());
+      if (data.format !== 'daily-grind-transfer' || data.version !== 1 || !data.settings || typeof data.settings !== 'object' || Array.isArray(data.settings)) throw new Error('Choose a valid Daily Grind transfer file.');
+      if (data.destination !== current) throw new Error('This file is for a different origin. Open ' + String(data.destination).slice(0, 200) + ' to import it.');
+      const entries = Object.entries(data.settings);
+      if (entries.some(([key, value]) => typeof value !== 'string' || /token|password|secret|credential|session|auth|cookie/i.test(key))) throw new Error('This file contains unsupported settings. Export a fresh transfer file.');
+      // Keep a rollback snapshot so a storage failure cannot leave a partial import.
+      const previous = entries.map(([key]) => [key, localStorage.getItem(key)]);
+      try { entries.forEach(([key, value]) => localStorage.setItem(key, value)); }
+      catch (error) {
+        previous.forEach(([key, value]) => { if (value === null) localStorage.removeItem(key); else localStorage.setItem(key, value); });
+        throw new Error('There was not enough browser storage. Free some space and try again.');
+      }
+      status.textContent = `${entries.length} local setting${entries.length === 1 ? '' : 's'} imported. Your configuration is ready at this address.`;
+      if (data.shortcuts) showPanel('shortcuts');
+    } catch (error) { status.textContent = error instanceof SyntaxError ? 'This file is not valid JSON. Choose your exported transfer file.' : error.message; }
+    event.target.value = '';
+  });
+  const panels = {
+    overview: ['Your installed app', '<p>The Daily Grind is running at this origin:</p><p id="overview-origin"></p><p>Use Move app to export local configuration and prepare your next address.</p>'],
+    preferences: ['Your preferences', '<p>Your locally saved preferences travel in the transfer file when “Bring my configuration” is selected. Existing settings at the destination are replaced only for matching keys.</p><p>Account data, sign-in credentials, cookies, IndexedDB, and browser permissions are not included. Sign in again at the new address to access account data.</p>'],
+    shortcuts: ['Reconnect your shortcuts', '<ol><li>Open your new address in a browser that supports installed web apps.</li><li>Use the browser’s “Install app” or “Add to Home Screen” option.</li><li>Pin the newly installed app to your taskbar, dock, or desktop.</li><li>Check that your configuration was imported, then remove the old shortcut.</li></ol><p>Your browser and operating system manage shortcuts. This page cannot rewrite them automatically.</p>'],
+    help: ['A smooth move, step by step', '<ol><li>Deploy this app at your new HTTPS origin.</li><li>Enter the new origin and download your transfer file.</li><li>Open the new address, choose “Import a transfer file,” and select the downloaded file.</li><li>Sign in again if needed, install the new app, and replace your old shortcuts.</li></ol><p>Only local storage configuration is transferred. Your original app and its settings stay available until you remove them.</p>'],
+    privacy: ['Your settings stay in your hands', '<p>Export and import happen locally in your browser. This page does not send the transfer file to a server. The file is not encrypted, so store it privately and delete it after importing.</p><p>Settings whose names indicate authentication credentials are excluded. Review the downloaded file before sharing it.</p>']
+  };
+  function showPanel(name) {
+    const [title, body] = panels[name];
+    $('dialog-title').textContent = title;
+    $('dialog-body').innerHTML = body;
+    if (name === 'overview') $('overview-origin').textContent = current;
+    $('dialog').showModal();
+  }
+  document.querySelectorAll('[data-panel]').forEach(button => button.addEventListener('click', () => showPanel(button.dataset.panel)));
+  $('migration-nav').addEventListener('click', () => { step(0); $('destination').focus(); });
+  $('dialog').addEventListener('click', event => { if (event.target === $('dialog')) { const rect = $('dialog').getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) $('dialog').close(); } });
+})();
