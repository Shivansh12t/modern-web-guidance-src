diff --git a/scripts/build-migration.mjs b/scripts/build-migration.mjs
new file mode 100644
index 0000000..8ded4e9
--- /dev/null
+++ b/scripts/build-migration.mjs
@@ -0,0 +1,99 @@
+import { mkdir, readFile, writeFile, copyFile, rm } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve, join } from 'node:path';
+import { getDomain } from 'tldts';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const configPath = resolve(root, process.argv[2] ?? 'migration.config.json');
+const config = JSON.parse(await readFile(configPath, 'utf8'));
+const old = parseOrigin(config.oldOrigin);
+const next = parseOrigin(config.newOrigin);
+const domain = getDomain(old.hostname, { allowPrivateDomains: true });
+if (old.origin === next.origin || !domain ||
+    domain !== getDomain(next.hostname, { allowPrivateDomains: true })) {
+  throw new Error('Migration requires distinct HTTPS origins on the same registrable domain.');
+}
+config.oldOrigin = old.origin;
+config.newOrigin = next.origin;
+const oldId = appId(config.oldAppId, old);
+const newId = appId(config.newAppId, next);
+if (!Array.isArray(config.settingsKeys) || config.settingsKeys.some(key =>
+  typeof key !== 'string' || !key || key === 'daily-grind:origin-migration:v1') ||
+  new Set(config.settingsKeys).size !== config.settingsKeys.length) {
+  throw new Error('settingsKeys must contain unique, explicit configuration keys.');
+}
+
+const template = await readFile(join(root, 'index.html'), 'utf8');
+const manifest = JSON.parse(await readFile(join(root, 'manifest.webmanifest'), 'utf8'));
+for (const role of ['old', 'new']) {
+  const out = join(root, 'dist', role);
+  await rm(out, { recursive: true, force: true });
+  await mkdir(join(out, '.well-known'), { recursive: true });
+  for (const file of ['icon.svg', 'migration.mjs', 'migration-storage.mjs', 'migration-transfer.mjs',
+    'migration-bridge.html', 'migration-bridge.mjs']) {
+    await copyFile(join(root, file), join(out, file));
+  }
+  await writeFile(join(out, 'migration.config.json'), JSON.stringify(config, null, 2));
+  const generated = { ...manifest, id: role === 'old' ? oldId : newId };
+  if (role === 'old') {
+    generated.migrate_to = { id: newId, install_url: `${next.origin}/` };
+    await writeFile(join(out, '.well-known/web-app-origin-association'),
+      JSON.stringify({ [newId]: { allow_migration: true } }, null, 2));
+  } else {
+    generated.migrate_from = [{ id: oldId, install_url: `${old.origin}/`, behavior: 'suggest' }];
+  }
+  await writeFile(join(out, 'manifest.webmanifest'), JSON.stringify(generated, null, 2));
+  const notice = role === 'old' ? `
+  <aside class="migration-notice" data-migration-notice aria-label="Our new address">
+    <p><strong>The Daily Grind is moving.</strong> Your coffee, at a new address.</p>
+    <p><a href="${next.origin}/">Continue to our new home</a>. We'll bring your settings over.</p>
+    <p>If your browser offers an app update, accept it to keep your installed shortcut.
+      Otherwise, install from the new address after checking your settings.</p>
+    <button type="button" data-export>Download settings backup</button>
+    <p role="status" aria-live="polite"></p>
+  </aside>` : `
+  <aside class="migration-notice" data-migration-notice aria-label="Welcome to our new address">
+    <p><strong>Welcome to our new home.</strong> Same Daily Grind.</p>
+    <p role="status" aria-live="polite">Preparing to transfer your settings…</p>
+    <button type="button" data-retry>Retry settings transfer</button>
+    <label>Import settings backup <input type="file" accept="application/json,.json" data-import></label>
+    <p><a href="${old.origin}/">Visit the original address to download a backup</a>.</p>
+    <noscript>Enable JavaScript to transfer your saved settings.</noscript>
+  </aside>`;
+  await writeFile(join(out, 'index.html'), template.replace('<!-- MIGRATION_NOTICE -->', notice));
+  await writeFile(join(out, '_headers'), `
+/manifest.webmanifest
+  Content-Type: application/manifest+json
+  Cache-Control: no-cache
+/.well-known/web-app-origin-association
+  Content-Type: application/json
+  Cache-Control: no-cache
+/migration.config.json
+  Cache-Control: no-store
+/migration-bridge.html
+  Cache-Control: no-store
+  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors ${next.origin}
+`);
+}
+console.log(`Built dist/old for ${old.origin} and dist/new for ${next.origin}.`);
+if ([old.hostname, next.hostname].some(host => host.endsWith('.example'))) {
+  console.log('Example origins only: configure your actual domains before deployment.');
+}
+
+function parseOrigin(value) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password ||
+      url.pathname !== '/' || url.search || url.hash) {
+    throw new Error('Origins must be bare HTTPS origins, without credentials, paths, queries, or fragments.');
+  }
+  return url;
+}
+
+function appId(value, origin) {
+  if (typeof value !== 'string' || !value.startsWith('/') || value.startsWith('//')) {
+    throw new Error('App IDs must be origin-relative paths matching the installed manifest identity.');
+  }
+  const url = new URL(value, origin);
+  if (url.origin !== origin.origin || url.hash) throw new Error('Invalid app ID.');
+  return url.href;
+}
diff --git a/test/migration-transfer.test.mjs b/test/migration-transfer.test.mjs
new file mode 100644
index 0000000..55c2b68
--- /dev/null
+++ b/test/migration-transfer.test.mjs
@@ -0,0 +1,78 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { requestSettings } from '../migration-transfer.mjs';
+
+const config = { oldOrigin: 'https://old.dailygrind.example' };
+
+// Unit-test the actual message protocol with window/frame stand-ins, not a browser.
+function setup(t) {
+  const listeners = new Set();
+  const messages = [];
+  let timeout;
+  let removed = false;
+  const frame = {
+    contentWindow: { postMessage: (data, origin) => messages.push({ data, origin }) },
+    addEventListener() {},
+    remove() { removed = true; },
+  };
+  for (const [key, value] of Object.entries({
+    window: {
+      addEventListener: (_, callback) => listeners.add(callback),
+      removeEventListener: (_, callback) => listeners.delete(callback),
+    },
+    document: { createElement: () => frame, body: { append() {} } },
+  })) {
+    const previous = Object.getOwnPropertyDescriptor(globalThis, key);
+    Object.defineProperty(globalThis, key, { value, configurable: true });
+    t.after(() => previous ? Object.defineProperty(globalThis, key, previous) : delete globalThis[key]);
+  }
+  t.mock.method(globalThis, 'setTimeout', callback => { timeout = callback; return 1; });
+  t.mock.method(globalThis, 'clearTimeout', () => {});
+  return {
+    frame, messages, listeners,
+    removed: () => removed,
+    timeout: () => timeout(),
+    send(data, origin = config.oldOrigin, source = frame.contentWindow) {
+      for (const listener of listeners) listener({ data, origin, source });
+    },
+  };
+}
+
+test('message protocol requires exact sender window, origin and response nonce; cleans up after success', async t => {
+  const env = setup(t);
+  const result = requestSettings(config);
+  const ready = { type: 'daily-grind:bridge-ready' };
+  env.send(ready, `${config.oldOrigin}.attacker.example`);
+  env.send(ready, config.oldOrigin, {});
+  assert.equal(env.messages.length, 0);
+  env.send(ready);
+  assert.equal(env.messages[0].origin, config.oldOrigin);
+  const nonce = env.messages[0].data.nonce;
+  const backup = { version: 1, settings: {} };
+  env.send({ type: 'daily-grind:settings', nonce: 'wrong', backup });
+  assert.equal(env.removed(), false);
+  env.send({ type: 'daily-grind:settings', nonce, backup });
+  assert.deepEqual(await result, backup);
+  assert.equal(env.removed(), true);
+  assert.equal(env.listeners.size, 0);
+});
+
+test('blocked bridge times out and removes its frame and listener', async t => {
+  const env = setup(t);
+  const result = requestSettings(config);
+  const rejection = assert.rejects(result, /timed out/);
+  env.timeout();
+  await rejection;
+  assert.equal(env.removed(), true);
+  assert.equal(env.listeners.size, 0);
+});
+
+test('source storage errors reject the transfer instead of marking empty settings as migrated', async t => {
+  const env = setup(t);
+  const result = requestSettings(config);
+  env.send({ type: 'daily-grind:bridge-ready' });
+  const rejection = assert.rejects(result, /storage unavailable/);
+  env.send({ type: 'daily-grind:settings', nonce: env.messages[0].data.nonce, error: true });
+  await rejection;
+  assert.equal(env.removed(), true);
+});
