+import { readSettings, trustedOrigin, validateBackup } from './migration-storage.mjs';
+
+const response = await fetch('/migration.config.json', { cache: 'no-store' });
+if (!response.ok) throw new Error('Migration configuration unavailable.');
+const config = await response.json();
+
+if (location.origin === config.oldOrigin && parent !== window) {
+  window.addEventListener('message', event => {
+    if (event.source !== parent || !trustedOrigin(event.origin, config.newOrigin) ||
+        event.data?.type !== 'daily-grind:request-settings' ||
+        typeof event.data.nonce !== 'string' || event.data.nonce.length > 100) return;
+    const reply = { type: 'daily-grind:settings', nonce: event.data.nonce };
+    try {
+      reply.backup = validateBackup(readSettings(localStorage, config.settingsKeys), config.settingsKeys);
+    } catch {
+      reply.error = true;
+    }
+    parent.postMessage(reply, config.newOrigin);
+  });
+  // Signal only after the listener and configuration are ready.
+  parent.postMessage({ type: 'daily-grind:bridge-ready' }, config.newOrigin);
+}
diff --git a/migration-storage.mjs b/migration-storage.mjs
new file mode 100644
index 0000000..85db99e
--- /dev/null
+++ b/migration-storage.mjs
@@ -0,0 +1,53 @@
+export const MAX_BACKUP_BYTES = 256 * 1024;
+export const MIGRATION_MARKER = 'daily-grind:origin-migration:v1';
+
+export function trustedOrigin(candidate, expected) {
+  try {
+    if ('Origin' in globalThis) {
+      return Origin.from(candidate).isSameOrigin(Origin.from(expected));
+    }
+    const actual = new URL(candidate).origin;
+    return actual !== 'null' && actual === new URL(expected).origin;
+  } catch {
+    return false;
+  }
+}
+
+export function readSettings(storage, keys) {
+  return {
+    version: 1,
+    settings: Object.fromEntries(keys.flatMap(key => {
+      const value = storage.getItem(key);
+      return value === null ? [] : [[key, value]];
+    })),
+  };
+}
+
+export function validateBackup(backup, keys) {
+  if (!backup || backup.version !== 1 || !backup.settings ||
+      typeof backup.settings !== 'object' || Array.isArray(backup.settings) ||
+      new TextEncoder().encode(JSON.stringify(backup)).length > MAX_BACKUP_BYTES ||
+      Object.entries(backup.settings).some(([key, value]) =>
+        !keys.includes(key) || typeof value !== 'string')) {
+    throw new Error('This is not a valid Daily Grind settings backup.');
+  }
+  return backup;
+}
+
+// Keep newer destination settings; retain source data and roll back failed writes.
+export function importSettings(storage, backup, keys, marker) {
+  validateBackup(backup, keys);
+  const written = [];
+  try {
+    for (const [key, value] of Object.entries(backup.settings)) {
+      if (storage.getItem(key) === null) {
+        storage.setItem(key, value);
+        written.push(key);
+      }
+    }
+    storage.setItem(MIGRATION_MARKER, marker);
+  } catch (error) {
+    for (const key of written) storage.removeItem(key);
+    throw error;
+  }
+}
diff --git a/migration-transfer.mjs b/migration-transfer.mjs
new file mode 100644
index 0000000..5b2994d
--- /dev/null
+++ b/migration-transfer.mjs
@@ -0,0 +1,31 @@
+import { trustedOrigin } from './migration-storage.mjs';
+
+export function requestSettings(config) {
+  return new Promise((resolve, reject) => {
+    const frame = document.createElement('iframe');
+    frame.hidden = true;
+    frame.title = 'Transfer Daily Grind settings';
+    frame.referrerPolicy = 'no-referrer';
+    frame.src = `${config.oldOrigin}/migration-bridge.html`;
+    const nonce = crypto.randomUUID();
+    const finish = (error, backup) => {
+      clearTimeout(timer);
+      window.removeEventListener('message', receive);
+      frame.remove();
+      if (error) reject(error);
+      else resolve(backup);
+    };
+    const receive = event => {
+      if (event.source !== frame.contentWindow || !trustedOrigin(event.origin, config.oldOrigin)) return;
+      if (event.data?.type === 'daily-grind:bridge-ready') {
+        frame.contentWindow.postMessage({ type: 'daily-grind:request-settings', nonce }, config.oldOrigin);
+      } else if (event.data?.type === 'daily-grind:settings' && event.data.nonce === nonce) {
+        finish(event.data.error ? new Error('Source storage unavailable.') : null, event.data.backup);
+      }
+    };
+    const timer = setTimeout(() => finish(new Error('Transfer timed out.')), 10000);
+    frame.addEventListener('error', () => finish(new Error('Source unavailable.')), { once: true });
+    window.addEventListener('message', receive);
+    document.body.append(frame);
+  });
+}
