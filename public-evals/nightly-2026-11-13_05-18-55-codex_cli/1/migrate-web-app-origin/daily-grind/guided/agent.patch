diff --git a/migration.mjs b/migration.mjs
new file mode 100644
index 0000000..b828c2e
--- /dev/null
+++ b/migration.mjs
@@ -0,0 +1,80 @@
+import { importSettings, readSettings, validateBackup,
+  MAX_BACKUP_BYTES, MIGRATION_MARKER } from './migration-storage.mjs';
+import { requestSettings } from './migration-transfer.mjs';
+
+const notice = document.querySelector('[data-migration-notice]');
+if (notice) initialize().catch(() => {
+  notice.querySelector('[role="status"]').textContent =
+    'Settings transfer is unavailable. Your settings remain safe at the original address.';
+});
+
+async function initialize() {
+  const response = await fetch('/migration.config.json', { cache: 'no-store' });
+  if (!response.ok) throw new Error('Migration configuration unavailable.');
+  const config = await response.json();
+  const status = notice.querySelector('[role="status"]');
+  const report = message => { status.textContent = message; };
+
+  if (location.origin === config.oldOrigin) {
+    notice.querySelector('[data-export]').addEventListener('click', () => {
+      try {
+        const backup = validateBackup(readSettings(localStorage, config.settingsKeys), config.settingsKeys);
+        const url = URL.createObjectURL(new Blob([JSON.stringify(backup)], { type: 'application/json' }));
+        const link = document.createElement('a');
+        link.href = url;
+        link.download = 'daily-grind-settings.json';
+        link.click();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+        report('Backup downloaded. You can import it at the new address.');
+      } catch {
+        report('Unable to read settings. Enable site storage and try downloading again.');
+      }
+    });
+    return;
+  }
+  if (location.origin !== config.newOrigin) return;
+
+  const marker = `${config.oldOrigin}${config.oldAppId}`;
+  const apply = backup => importSettings(localStorage, backup, config.settingsKeys, marker);
+  notice.querySelector('[data-import]').addEventListener('change', async event => {
+    const input = event.target;
+    const file = input.files[0];
+    if (!file) return;
+    try {
+      if (file.size > MAX_BACKUP_BYTES) throw new Error('Backup too large.');
+      apply(JSON.parse(await file.text()));
+      report('Your settings are ready. Any settings already saved here were kept.');
+    } catch {
+      report('Could not import settings. Choose a valid Daily Grind backup and allow site storage.');
+    } finally {
+      input.value = '';
+    }
+  });
+
+  let pending = false;
+  const retry = notice.querySelector('[data-retry]');
+  async function transfer() {
+    if (pending) return;
+    pending = true;
+    retry.disabled = true;
+    report('Bringing your settings over from the original address…');
+    try {
+      apply(await requestSettings(config));
+      report('Your settings are ready. Any settings already saved here were kept.');
+    } catch {
+      report('Automatic transfer was unavailable. Retry, or download a settings backup at the original address and import it here.');
+    } finally {
+      pending = false;
+      retry.disabled = false;
+    }
+  }
+  retry.addEventListener('click', transfer);
+  try {
+    if (localStorage.getItem(MIGRATION_MARKER) === marker) {
+      report('Your settings have already been transferred.');
+      return;
+    }
+  } catch { /* Show the import controls even when storage is disabled. */ }
+  await transfer();
+}
+
