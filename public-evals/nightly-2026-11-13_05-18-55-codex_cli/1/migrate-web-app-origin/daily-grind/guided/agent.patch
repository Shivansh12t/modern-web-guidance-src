+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { readFile, mkdtemp, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { importSettings, readSettings, validateBackup, trustedOrigin,
+  MAX_BACKUP_BYTES, MIGRATION_MARKER } from '../migration-storage.mjs';
+
+const keys = ['daily-grind:preferences', 'daily-grind:settings'];
+const marker = 'https://old.dailygrind.example/';
+function memoryStorage(entries = []) {
+  const data = new Map(entries);
+  return {
+    getItem: key => data.get(key) ?? null,
+    setItem: (key, value) => data.set(key, value),
+    removeItem: key => data.delete(key),
+  };
+}
+
+test('transfers only configuration, preserves destination values and leaves source intact', () => {
+  const source = memoryStorage([[keys[0], '{"milk":"oat"}'], [keys[1], 'old'], ['auth-token', 'secret']]);
+  const destination = memoryStorage([[keys[1], 'new']]);
+  const backup = readSettings(source, keys);
+  assert.equal(backup.settings['auth-token'], undefined);
+  importSettings(destination, backup, keys, marker);
+  assert.equal(destination.getItem(keys[0]), '{"milk":"oat"}');
+  assert.equal(destination.getItem(keys[1]), 'new');
+  assert.equal(destination.getItem(MIGRATION_MARKER), marker);
+  assert.equal(source.getItem(keys[0]), '{"milk":"oat"}');
+  importSettings(destination, backup, keys, marker);
+  assert.equal(destination.getItem(keys[1]), 'new');
+});
+
+test('rolls back copied settings if storage fills before the completion marker is saved', () => {
+  const storage = memoryStorage([[keys[1], 'existing']]);
+  const write = storage.setItem;
+  storage.setItem = (key, value) => {
+    if (key === MIGRATION_MARKER) throw new Error('QuotaExceededError');
+    write(key, value);
+  };
+  assert.throws(() => importSettings(storage, { version: 1, settings: { [keys[0]]: 'copy' } }, keys, marker));
+  assert.equal(storage.getItem(keys[0]), null);
+  assert.equal(storage.getItem(keys[1]), 'existing');
+  assert.equal(storage.getItem(MIGRATION_MARKER), null);
+});
+
+test('rejects malformed, oversized, non-string and unapproved backup data before any writes', () => {
+  for (const backup of [null, {}, { version: 2, settings: {} }, { version: 1, settings: [] },
+    { version: 1, settings: { token: 'secret' } }, { version: 1, settings: { [keys[0]]: 7 } },
+    { version: 1, settings: { [keys[0]]: 'a'.repeat(MAX_BACKUP_BYTES) } }]) {
+    const storage = memoryStorage();
+    assert.throws(() => importSettings(storage, backup, keys, marker));
+    assert.equal(storage.getItem(MIGRATION_MARKER), null);
+  }
+  assert.deepEqual(validateBackup({ version: 1, settings: {} }, keys), { version: 1, settings: {} });
+});
+
+test('normalizes origins while rejecting opaque, spoofed, downgraded, and wrong-port senders', () => {
+  const expected = 'https://app.dailygrind.example';
+  assert.equal(trustedOrigin(`${expected}:443/`, expected), true);
+  for (const origin of ['null', 'data:text/html,hello', 'invalid',
+    `${expected}.attacker.example`, `${expected}:444`, 'http://app.dailygrind.example']) {
+    assert.equal(trustedOrigin(origin, expected), false);
+  }
+});
+
+test('build outputs mutually authorized manifests, settings controls, and frame restrictions', async () => {
+  execFileSync(process.execPath, ['scripts/build-migration.mjs']);
+  const json = async path => JSON.parse(await readFile(path, 'utf8'));
+  const oldManifest = await json('dist/old/manifest.webmanifest');
+  const newManifest = await json('dist/new/manifest.webmanifest');
+  const association = await json('dist/old/.well-known/web-app-origin-association');
+  assert.equal(oldManifest.migrate_to.id, newManifest.id);
+  assert.equal(newManifest.migrate_from[0].id, oldManifest.id);
+  assert.equal(newManifest.migrate_from[0].behavior, 'suggest');
+  assert.equal(association[newManifest.id].allow_migration, true);
+  assert.match(await readFile('dist/old/index.html', 'utf8'), /data-export/);
+  assert.match(await readFile('dist/new/index.html', 'utf8'), /data-import/);
+  assert.match(await readFile('dist/old/_headers', 'utf8'), /frame-ancestors https:\/\/app.dailygrind.example/);
+  for (const role of ['old', 'new']) {
+    assert.match(await readFile(`dist/${role}/migration-bridge.mjs`, 'utf8'), /event.source !== parent/);
+    assert.deepEqual(await json(`dist/${role}/migration.config.json`), await json('migration.config.json'));
+  }
+});
+
+test('build rejects cross-site/private-suffix tenants, non-HTTPS URLs and invalid identities', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'daily-grind-test-'));
+  const config = JSON.parse(await readFile('migration.config.json', 'utf8'));
+  try {
+    for (const changes of [
+      { newOrigin: 'https://app.other.example' },
+      { oldOrigin: 'https://one.github.io', newOrigin: 'https://two.github.io' },
+      { oldOrigin: 'http://old.dailygrind.example' },
+      { newOrigin: 'https://app.dailygrind.example/path' },
+      { newOrigin: config.oldOrigin },
+      { oldAppId: '//attacker.example/' },
+      { oldAppId: '/\\attacker.example/' },
+    ]) {
+      const file = join(dir, 'config.json');
+      await writeFile(file, JSON.stringify({ ...config, ...changes }));
+      const result = spawnSync(process.execPath, ['scripts/build-migration.mjs', file]);
+      assert.notEqual(result.status, 0, JSON.stringify(changes));
+    }
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
