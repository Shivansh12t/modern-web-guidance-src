+    .card.spring,
+    .card.bounce {
+      transition: transform 220ms ease-out, box-shadow 220ms ease-out;
+    }
+
+    .card.spring:focus-within {
+      animation: card-spring 650ms both;
+    }
+
+    .card.bounce:focus-within {
+      animation: card-bounce 700ms both;
+    }
+
+    .card.spring:focus-within,
+    .card.bounce:focus-within {
+      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
+    }
+
+    @media (hover: hover) and (pointer: fine) {
+      .card.spring:hover {
+        animation: card-spring 650ms both;
+      }
+
+      .card.bounce:hover {
+        animation: card-bounce 700ms both;
+      }
+
+      .card.spring:hover,
+      .card.bounce:hover {
+        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
+      }
+    }
+
+    @keyframes card-spring {
+      0% { transform: scale(1); }
+      40% { transform: scale(1.065); }
+      65% { transform: scale(1.025); }
+      82% { transform: scale(1.045); }
+      100% { transform: scale(1.04); }
+    }
+
+    @keyframes card-bounce {
+      0% { transform: translateY(0); }
+      35% { transform: translateY(-10px); }
+      55% { transform: translateY(0); }
+      72% { transform: translateY(-5px); }
+      85% { transform: translateY(0); }
+      94% { transform: translateY(-2px); }
+      100% { transform: translateY(0); }
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        animation: none !important;
+        transition: none;
+      }
+    }
