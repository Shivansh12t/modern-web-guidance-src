+  <script type="module">
+    const carousel = document.querySelector('.carousel');
+    const track = carousel.querySelector('.carousel-track');
+    const slides = [...track.children];
+    const markers = carousel.querySelector('.carousel-markers');
+    const status = carousel.querySelector('[role="status"]');
+    let pendingTarget = null;
+    let lastSettled = 0;
+    let activeMarker = -1;
+    let scrollTimer;
+    let frame;
+
+    function currentSlide() {
+      const center = track.getBoundingClientRect().left + track.clientWidth / 2;
+      return slides.reduce((nearest, slide, index) => {
+        const distance = (item) => {
+          const rect = item.getBoundingClientRect();
+          return Math.abs(rect.left + rect.width / 2 - center);
+        };
+        return distance(slide) < distance(slides[nearest]) ? index : nearest;
+      }, 0);
+    }
+
+    function updateMarkers(index) {
+      if (activeMarker === index) return;
+      [...markers.children].forEach((button, position) => {
+        if (position === index) button.setAttribute('aria-current', 'true');
+        else button.removeAttribute('aria-current');
+      });
+      activeMarker = index;
+    }
+
+    function goTo(index) {
+      pendingTarget = (index + slides.length) % slides.length;
+      updateMarkers(pendingTarget);
+      const target = slides[pendingTarget].getBoundingClientRect();
+      const viewport = track.getBoundingClientRect();
+      const offset = target.left + target.width / 2 - viewport.left - track.clientWidth / 2;
+      if (Math.abs(offset) < 1) {
+        pendingTarget = null;
+        return;
+      }
+      track.scrollBy({ left: offset });
+    }
+
+    function settle() {
+      const index = currentSlide();
+      pendingTarget = null;
+      updateMarkers(index);
+      if (index !== lastSettled) {
+        status.textContent = `Slide ${index + 1} of ${slides.length}: ${slides[index].querySelector('h3').textContent}`;
+        lastSettled = index;
+      }
+    }
+
+    slides.forEach((slide, index) => {
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.setAttribute('aria-label', `Show ${slide.querySelector('h3').textContent}`);
+      button.setAttribute('aria-controls', track.id);
+      button.addEventListener('click', () => goTo(index));
+      markers.append(button);
+    });
+
+    carousel.querySelectorAll('[data-direction]').forEach((button) => {
+      button.addEventListener('click', () => {
+        goTo((pendingTarget ?? currentSlide()) + Number(button.dataset.direction));
+      });
+    });
+
+    const supportsScrollEnd = 'onscrollend' in track;
+    track.addEventListener('scroll', () => {
+      if (pendingTarget === null && !frame) {
+        frame = requestAnimationFrame(() => {
+          updateMarkers(currentSlide());
+          frame = null;
+        });
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(settle, 150);
+      }
+    }, { passive: true });
+    if (supportsScrollEnd) track.addEventListener('scrollend', settle);
+
+    updateMarkers(0);
+    carousel.querySelector('.carousel-controls').hidden = false;
+    markers.hidden = false;
+  </script>
