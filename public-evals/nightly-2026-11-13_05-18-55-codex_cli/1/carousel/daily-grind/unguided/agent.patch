+  <script>
+    const carousel = document.querySelector('.carousel');
+    const slides = Array.from(carousel.querySelectorAll('.card'));
+    const position = carousel.querySelector('.carousel-position');
+    let currentSlide = 0;
+
+    function showSlide(direction) {
+      slides[currentSlide].hidden = true;
+      currentSlide = (currentSlide + direction + slides.length) % slides.length;
+      slides[currentSlide].hidden = false;
+      position.textContent = `${currentSlide + 1} / ${slides.length}`;
+    }
+
+    carousel.querySelectorAll('button[data-direction]').forEach((button) => {
+      button.addEventListener('click', () => showSlide(Number(button.dataset.direction)));
+    });
+
+    carousel.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        event.preventDefault();
+        // Keep focus visible if a detail link is about to be hidden.
+        if (event.target.closest('.card')) {
+          carousel.querySelector(`[data-direction="${event.key === 'ArrowRight' ? 1 : -1}"]`).focus();
+        }
+        showSlide(event.key === 'ArrowRight' ? 1 : -1);
+      }
+    });
+  </script>
