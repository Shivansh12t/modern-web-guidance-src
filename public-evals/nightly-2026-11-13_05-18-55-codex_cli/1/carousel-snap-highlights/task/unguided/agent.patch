+  <script>
+    const carousel = document.querySelector('.carousel');
+    const items = [...carousel.querySelectorAll('.carousel-item')];
+    let scrollTimer;
+
+    function highlightSnappedItem() {
+      const bounds = carousel.getBoundingClientRect();
+      const center = bounds.left + carousel.clientWidth / 2;
+      const snappedItem = items.reduce((nearest, item) => {
+        const distance = (card) => {
+          const rect = card.getBoundingClientRect();
+          return Math.abs(rect.left + rect.width / 2 - center);
+        };
+        return distance(item) < distance(nearest) ? item : nearest;
+      });
+
+      items.forEach((item) => {
+        item.classList.toggle('is-snapped', item === snappedItem);
+      });
+    }
+
+    carousel.addEventListener('scroll', () => {
+      clearTimeout(scrollTimer);
+      // Fallback for browsers that do not support scrollend.
+      scrollTimer = setTimeout(highlightSnappedItem, 150);
+    }, { passive: true });
+    carousel.addEventListener('scrollend', () => {
+      clearTimeout(scrollTimer);
+      highlightSnappedItem();
+    });
+    new ResizeObserver(highlightSnappedItem).observe(carousel);
+    highlightSnappedItem();
+  </script>
