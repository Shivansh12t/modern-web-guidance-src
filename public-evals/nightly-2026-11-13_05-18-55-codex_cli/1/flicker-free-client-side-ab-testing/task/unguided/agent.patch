+  <script>
+    // SDK integration contract: dispatch `experiment:applied` only after ALL DOM
+    // changes are committed. Script load alone is not proof a variant is ready.
+    (() => {
+      let applied = false;
+      let failed = false;
+      let timer;
+      function displayState() {
+        const stage = document.querySelector('.hero-stage');
+        const fallback = document.getElementById('fallback-hero');
+        if (!stage || !fallback) return;
+        stage.classList.toggle('fallback', failed && !applied);
+        fallback.hidden = !failed || applied;
+        const hero = document.getElementById('experiment-hero');
+        hero.inert = !applied;
+        hero.setAttribute('aria-hidden', String(!applied));
+      }
+      window.addEventListener('experiment:applied', () => {
+        if (failed) return; // Lock this visit to the fallback; never swap visible content later.
+        applied = true;
+        clearTimeout(timer);
+        document.documentElement.dataset.experimentState = 'applied';
+        displayState();
+      });
+      window.addEventListener('experiment:unavailable', () => {
+        if (applied) return;
+        failed = true;
+        displayState();
+      });
+      document.addEventListener('DOMContentLoaded', displayState);
+      timer = setTimeout(() => window.dispatchEvent(new Event('experiment:unavailable')), 1800);
+    })();
+  </script>
