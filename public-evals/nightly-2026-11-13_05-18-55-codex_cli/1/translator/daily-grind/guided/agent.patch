diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..6269925
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,115 @@
+(() => {
+  const select = document.querySelector('#language-select');
+  const button = document.querySelector('#translate-button');
+  const restore = document.querySelector('#restore-button');
+  const status = document.querySelector('#translation-status');
+  const passages = [...document.querySelectorAll('[data-translate]')];
+  const originals = passages.map((element) => element.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let readyOptions = null;
+  let activeTranslator = null;
+
+  function display(texts, language) {
+    passages.forEach((element, index) => {
+      element.textContent = texts[index];
+      element.lang = language;
+    });
+    restore.hidden = language === 'en';
+  }
+
+  async function prepare() {
+    const request = ++revision;
+    const language = select.value;
+    readyOptions = null;
+    button.disabled = true;
+    // Invalidate in-flight work before releasing its model resources.
+    activeTranslator?.destroy();
+    activeTranslator = null;
+    if (language === 'en') {
+      display(originals, 'en');
+      restore.hidden = true;
+      status.textContent = 'Showing original English. Choose a language to translate.';
+      return;
+    }
+    if (cache.has(language)) {
+      display(cache.get(language), language);
+      status.textContent = 'Showing your on-device translation. AI translations may contain mistakes.';
+      return;
+    }
+    status.textContent = 'Checking this language on your device…';
+    const options = { sourceLanguage: 'en', targetLanguage: language };
+    try {
+      const availability = await window.Translator.availability(options);
+      if (request !== revision) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. Choose another language or show original English.';
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      button.textContent = availability === 'available' ? 'Translate' : 'Download & translate';
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'A language pack is needed. Select Download & translate to continue; an internet connection may be required.';
+    } catch {
+      if (request !== revision) return;
+      status.textContent = 'Could not check this language. Choose another language or try again.';
+    }
+  }
+
+  button.addEventListener('click', async () => {
+    if (!readyOptions || button.disabled) return;
+    const options = readyOptions;
+    const request = ++revision;
+    let translator;
+    button.disabled = true;
+    restore.hidden = false;
+    status.textContent = 'Preparing on-device translation…';
+    try {
+      // Call create directly from the click, before awaiting, to retain user activation.
+      translator = await window.Translator.create({
+        ...options,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            if (request !== revision) return;
+            status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%. Translation stays on your device.`;
+          });
+        },
+      });
+      if (request !== revision) return;
+      activeTranslator = translator;
+      status.textContent = 'Translating menu descriptions and our story…';
+      const translated = [];
+      for (const original of originals) {
+        const result = await translator.translate(original);
+        if (request !== revision) return;
+        translated.push(result);
+      }
+      cache.set(options.targetLanguage, translated);
+      display(translated, options.targetLanguage);
+      status.textContent = 'Translated on your device. AI translations may contain mistakes.';
+    } catch {
+      if (request !== revision) return;
+      status.textContent = 'Translation could not finish. Your current text is unchanged. Try again or show original English.';
+      button.disabled = false;
+      button.textContent = 'Try translation again';
+    } finally {
+      translator?.destroy();
+      if (activeTranslator === translator) activeTranslator = null;
+    }
+  });
+
+  select.addEventListener('change', prepare);
+  restore.addEventListener('click', () => {
+    select.value = 'en';
+    prepare();
+  });
+
+  if (!window.isSecureContext || !('Translator' in window)) {
+    status.textContent = 'On-device translation is unavailable in this browser. The original English is shown. Try a supported desktop browser, such as Chrome, over HTTPS.';
+    return;
+  }
+  select.disabled = false;
+  prepare();
+})();
