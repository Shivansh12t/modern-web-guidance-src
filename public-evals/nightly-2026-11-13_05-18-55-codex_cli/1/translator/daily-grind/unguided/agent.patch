+// All fallback copy ships with the page. No translation service receives text.
+(() => {
+  const selector = document.getElementById('language');
+  const status = document.getElementById('translation-status');
+  const statusText = document.getElementById('status-text');
+  const regions = [...document.querySelectorAll('[data-translate]')];
+  const original = Object.fromEntries(regions.map(node => [node.dataset.translate, node.textContent]));
+  const translations = {
+    en: original,
+    es: {
+      hero: 'De origen ético, tostado localmente y preparado siempre con cariño. Encuentra tu café favorito y siéntete como en casa.',
+      maple: 'Cremosa leche de avena con un toque de sirope de arce de Vermont. Un poco de bienestar en cada sorbo.',
+      espresso: 'Intenso, ahumado y perfectamente equilibrado. Tu pequeño pero poderoso ritual matutino.',
+      coldbrew: 'Infusionado durante 18 horas para un acabado naturalmente dulce y extrasuave. La espera merece la pena.',
+      story: 'Creemos que la mejor parte de tu día puede empezar con algo pequeño. Un grano tostado con esmero. Una cara conocida. Un momento para bajar el ritmo.',
+      storyMore: 'Por eso elegimos nuestro café con cuidado, lo tostamos localmente y ponemos un poco de corazón en todo lo que hacemos. Vengas de donde vengas, hay un lugar para ti en The Daily Grind.'
+    },
+    fr: {
+      hero: 'Un café issu de sources éthiques, torréfié localement et toujours préparé avec soin. Trouvez votre tasse préférée et faites comme chez vous.',
+      maple: 'Un lait d’avoine onctueux avec une touche de sirop d’érable du Vermont. Un peu de réconfort à chaque gorgée.',
+      espresso: 'Intense, fumé et parfaitement équilibré. Votre petit rituel du matin qui a du caractère.',
+      coldbrew: 'Infusé pendant 18 heures pour une douceur naturelle et une texture particulièrement soyeuse. L’attente en vaut la peine.',
+      story: 'Nous croyons que le meilleur moment de votre journée peut commencer par un petit rien. Un grain torréfié avec soin. Un visage familier. Un instant pour ralentir.',
+      storyMore: 'C’est pourquoi nous choisissons notre café avec soin, le torréfions localement et mettons du cœur dans tout ce que nous faisons. D’où que vous veniez, vous avez votre place chez The Daily Grind.'
+    },
+    de: {
+      hero: 'Ethisch bezogen, lokal geröstet und immer mit Sorgfalt zubereitet. Finde deinen Lieblingskaffee und fühl dich wie zu Hause.',
+      maple: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont. Ein kleiner Wohlfühlmoment mit jedem Schluck.',
+      espresso: 'Kräftig, rauchig und wunderbar ausgewogen. Dein kleines, aber kraftvolles Morgenritual.',
+      coldbrew: '18 Stunden lang gezogen, für natürliche Süße und einen besonders weichen Geschmack. Das Warten lohnt sich.',
+      story: 'Wir glauben, dass der schönste Teil deines Tages mit etwas Kleinem beginnen kann. Einer sorgfältig gerösteten Bohne. Einem vertrauten Gesicht. Einem Moment zum Durchatmen.',
+      storyMore: 'Deshalb wählen wir unseren Kaffee mit Bedacht aus, rösten ihn vor Ort und stecken in alles, was wir tun, ein wenig Herz. Woher du auch kommst, bei The Daily Grind ist ein Platz für dich.'
+    },
+    ja: {
+      hero: '倫理的に調達し、地元で焙煎し、いつも心を込めて淹れるコーヒー。お気に入りの一杯を見つけて、ゆっくりおくつろぎください。',
+      maple: 'クリーミーなオーツミルクに、バーモント産メープルシロップをほんのりと。ひと口ごとに、ほっとするひとときを。',
+      espresso: '力強くスモーキーで、絶妙なバランス。小さな一杯が、朝に大きな元気を届けます。',
+      coldbrew: '18時間かけてじっくり抽出し、自然な甘さとなめらかな口当たりに。待つだけの価値がある一杯です。',
+      story: '一日のいちばん素敵な時間は、小さなことから始まると信じています。丁寧に焙煎された一粒の豆。見慣れた笑顔。少しだけ、ひと息つく時間。',
+      storyMore: 'だから私たちはコーヒーを大切に選び、地元で焙煎し、すべてに心を込めています。どこから来た方にも、The Daily Grindにはあなたの居場所があります。'
+    }
+  };
+  const names = { en: 'English', es: 'Español', fr: 'Français', de: 'Deutsch', ja: '日本語' };
+  const cache = new Map();
+  let revision = 0;
+
+  function announce(message, state = 'ready') {
+    statusText.textContent = message;
+    status.dataset.state = state;
+  }
+
+  function display(copy, language) {
+    for (const region of regions) {
+      region.textContent = copy[region.dataset.translate];
+      // Only the translated regions change language; navigation stays English.
+      region.lang = language;
+    }
+  }
+
+  function remember(language) {
+    try { localStorage.setItem('daily-grind-language', language); } catch { /* Storage is optional. */ }
+  }
+
+  async function changeLanguage(useNative = false) {
+    const language = selector.value;
+    const request = ++revision;
+    const saved = translations[language];
+    if (!saved) return;
+    remember(language);
+    display(cache.get(language) || saved, language);
+    if (language === 'en') {
+      announce('Original English · Private by design');
+      return;
+    }
+    announce(`${names[language]} · Translated on your device`);
+    // Restoring a preference never initiates a model download without a gesture.
+    if (!useNative || cache.has(language) || typeof globalThis.Translator?.create !== 'function') return;
+
+    let translator;
+    try {
+      announce('Preparing on-device translation…', 'busy');
+      // Create immediately in the change gesture, so language pack downloads are allowed.
+      translator = await globalThis.Translator.create({
+        sourceLanguage: 'en',
+        targetLanguage: language,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (request !== revision) return;
+            const progress = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+            announce(`Downloading language pack… ${progress}%`, 'busy');
+          });
+        }
+      });
+      if (request !== revision) return;
+      announce('Translating on your device…', 'busy');
+      const copy = {};
+      for (const [key, text] of Object.entries(original)) {
+        if (request !== revision) return;
+        const result = await translator.translate(text);
+        if (typeof result !== 'string' || !result.trim()) throw new Error('Empty translation');
+        copy[key] = result;
+      }
+      cache.set(language, copy);
+      if (request !== revision) return;
+      display(copy, language);
+      announce(`${names[language]} · Translated on your device`);
+    } catch {
+      if (request === revision) announce(`${names[language]} · Included translation · Works offline`);
+    } finally {
+      translator?.destroy?.();
+    }
+  }
+
+  selector.addEventListener('change', () => { void changeLanguage(true); });
+  let preferred;
+  try { preferred = localStorage.getItem('daily-grind-language'); } catch { /* Use English. */ }
+  if (preferred && Object.hasOwn(translations, preferred)) {
+    selector.value = preferred;
+    void changeLanguage();
+  }
+})();
