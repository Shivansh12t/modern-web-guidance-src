diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..b6f30a3
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,134 @@
+type TranslatorInstance = { translate: (text: string) => Promise<string>; destroy: () => void };
+type TranslatorAPI = {
+  availability: (options: { sourceLanguage: string; targetLanguage: string }) => Promise<string>;
+  create: (options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    monitor: (monitor: EventTarget) => void;
+  }) => Promise<TranslatorInstance>;
+};
+
+class ArticleTranslator extends HTMLElement {
+  private cleanup = new AbortController();
+  private original = new Map<Text, string>();
+  private regions = new Map<HTMLElement, { lang: string | null; dir: string | null }>();
+  private translator?: TranslatorInstance;
+  private generation = 0;
+  private appliedLanguage = 'en';
+
+  connectedCallback() {
+    this.cleanup = new AbortController();
+    const select = this.querySelector<HTMLSelectElement>('[data-language]')!;
+    const submit = this.querySelector<HTMLButtonElement>('[data-translate]')!;
+    const restore = this.querySelector<HTMLButtonElement>('[data-restore]')!;
+    const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    if (!api) {
+      this.status('On-device translation isn’t available in this browser. Try a recent desktop Chrome with built-in translation support.');
+      submit.disabled = true;
+      select.disabled = true;
+      return;
+    }
+    submit.addEventListener('click', () => void this.translate(api, select.value), { signal: this.cleanup.signal });
+    restore.addEventListener('click', () => this.restore(), { signal: this.cleanup.signal });
+  }
+
+  disconnectedCallback() {
+    this.generation++;
+    this.cleanup.abort();
+    this.translator?.destroy();
+  }
+
+  private status(message: string) {
+    this.querySelector<HTMLElement>('[data-status]')!.textContent = message;
+  }
+
+  private busy(value: boolean) {
+    this.setAttribute('aria-busy', String(value));
+    this.querySelector<HTMLSelectElement>('[data-language]')!.disabled = value;
+    const button = this.querySelector<HTMLButtonElement>('[data-translate]')!;
+    button.disabled = value;
+    button.textContent = value ? 'Translating…' : 'Translate ↗';
+  }
+
+  private restore() {
+    this.generation++;
+    this.translator?.destroy();
+    this.translator = undefined;
+    for (const [node, text] of this.original) node.textContent = text;
+    for (const [element, attrs] of this.regions) {
+      for (const attr of ['lang', 'dir'] as const) {
+        if (attrs[attr] === null) element.removeAttribute(attr);
+        else element.setAttribute(attr, attrs[attr]!);
+      }
+    }
+    this.appliedLanguage = 'en';
+    this.querySelector<HTMLButtonElement>('[data-restore]')!.hidden = true;
+    this.busy(false);
+    this.status('Showing the original English. Article text stays on this device.');
+  }
+
+  private async translate(api: TranslatorAPI, targetLanguage: string) {
+    if (targetLanguage === 'en') { this.restore(); return; }
+    if (targetLanguage === this.appliedLanguage) { this.status('You’re already reading this translation.'); return; }
+    const run = ++this.generation;
+    const current = () => run === this.generation && this.isConnected;
+    this.busy(true);
+    this.status('Preparing on-device translation. A language pack may need to download.');
+    try {
+      const options = { sourceLanguage: 'en', targetLanguage };
+      // Start create in the click handler so the browser can authorize a language-pack download.
+      const creation = api.create({ ...options, monitor: (monitor) => {
+        monitor.addEventListener('downloadprogress', (event) => {
+          if (current()) this.status(`Downloading language pack… ${Math.round((event as Event & { loaded: number }).loaded * 100)}%`);
+        });
+      } });
+      const translator = await creation;
+      if (!current()) { translator.destroy(); return; }
+      this.translator = translator;
+      const availability = await api.availability(options);
+      if (availability === 'unavailable') throw new Error('unsupported');
+      const nodes: Text[] = [];
+      document.querySelectorAll<HTMLElement>('[data-translatable]').forEach((region) => {
+        if (!this.regions.has(region)) this.regions.set(region, { lang: region.getAttribute('lang'), dir: region.getAttribute('dir') });
+        const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT, {
+          acceptNode: (node) => node.textContent?.trim() && !node.parentElement?.closest('code, pre, script, style, [translate="no"], [data-no-translate]')
+            ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+        });
+        while (walker.nextNode()) {
+          const node = walker.currentNode as Text;
+          if (!this.original.has(node)) this.original.set(node, node.textContent!);
+          nodes.push(node);
+        }
+      });
+      if (!nodes.length) { this.status('There are no articles or teasers to translate on this page.'); return; }
+      const translations = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      for (const [index, node] of nodes.entries()) {
+        if (!current()) return;
+        const source = this.original.get(node)!;
+        const text = source.trim();
+        const translated = cache.get(text) ?? await translator.translate(text);
+        cache.set(text, translated);
+        translations.set(node, source.replace(text, () => translated));
+        if (current()) this.status(`Translating article text… ${Math.round((index + 1) / nodes.length * 100)}%`);
+      }
+      if (!current()) return;
+      for (const [node, text] of translations) node.textContent = text;
+      for (const region of this.regions.keys()) { region.lang = targetLanguage; region.dir = targetLanguage === 'ar' ? 'rtl' : 'ltr'; }
+      this.appliedLanguage = targetLanguage;
+      this.querySelector<HTMLButtonElement>('[data-restore]')!.hidden = false;
+      const name = this.querySelector<HTMLSelectElement>('[data-language]')!.selectedOptions[0].text;
+      this.status(`Now reading in ${name}. AI translations may contain mistakes.`);
+    } catch {
+      if (current()) this.status('Translation couldn’t finish. This language may be unavailable or its download failed. Please try again.');
+    } finally {
+      if (current()) {
+        this.translator?.destroy();
+        this.translator = undefined;
+        this.busy(false);
+      }
+    }
+  }
+}
+
+if (!customElements.get('article-translator')) customElements.define('article-translator', ArticleTranslator);
