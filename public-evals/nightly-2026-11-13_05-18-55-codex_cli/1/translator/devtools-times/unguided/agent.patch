+}
+/* A quiet reading tool, styled to sit alongside the newspaper masthead. */
+.translation-panel {
+  margin: 24px 24px 0;
+  padding: 24px;
+  border: 1px solid #e5e3db;
+  border-radius: 8px;
+  background: #f8f8f3;
+  color: #252b28;
+  font-family: Arial, sans-serif;
+}
+article-translator { display: flex; align-items: center; justify-content: space-between; gap: 28px; }
+.translation-intro { display: flex; align-items: center; gap: 16px; }
+.translation-icon { display: grid; place-items: center; flex-shrink: 0; width: 48px; height: 48px; background: #e8ece2; color: #3d5541; border-radius: 50%; }
+.translation-icon svg { width: 27px; height: 27px; }
+.translation-eyebrow { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 9px; font-weight: 700; letter-spacing: 1.1px; color: #697267; }
+.translation-badge { display: inline-flex; align-items: center; gap: 5px; color: #43634a; font-size: 10px; font-weight: 400; letter-spacing: 0; }
+.translation-badge span { width: 5px; height: 5px; border-radius: 50%; background: #668567; }
+.translation-intro h2 { font-family: 'Grenze', Georgia, serif; font-size: 29px; line-height: 1.25; margin: 5px 0; font-weight: 500; }
+.translation-intro p { font-size: 11px; color: #6a706a; line-height: 1.6; }
+.translation-actions { flex: 0 1 475px; }
+.translation-fields { display: flex; align-items: center; gap: 12px; }
+.translation-source, .translation-target { display: flex; flex-direction: column; gap: 5px; }
+.translation-source { flex-shrink: 0; }
+.translation-source > span, .translation-target > span { font-size: 10px; color: #71776f; }
+.translation-source strong { font-size: 13px; font-weight: 500; padding: 10px 0; }
+.translation-arrow { color: #959b90; margin-top: 19px; }
+.translation-target { flex: 1; min-width: 120px; }
+.translation-target select { width: 100%; background: #fff; color: #333d34; padding: 9px 30px 9px 11px; border: 1px solid #d7dcd2; border-radius: 4px; font-size: 13px; cursor: pointer; height: 38px; }
+.translation-submit { display: flex; align-items: center; justify-content: center; gap: 20px; align-self: flex-end; border: 1px solid #2f4837; border-radius: 4px; background: #2f4837; color: white; height: 38px; padding: 0 16px; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; }
+.translation-submit:hover:not(:disabled) { background: #223b2a; }
+.translation-submit:disabled { cursor: not-allowed; opacity: .55; }
+.translation-target select:disabled { cursor: not-allowed; opacity: .65; }
+.translation-panel :is(button, select):focus-visible { outline: 2px solid #658166; outline-offset: 3px; }
+.translation-feedback { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 6px 12px; margin-top: 10px; }
+.translation-feedback p { font-size: 10px; line-height: 1.5; color: #747b70; }
+.translation-feedback button { font-size: 11px; text-decoration: underline; text-underline-offset: 3px; color: #35563c; cursor: pointer; }
+.translation-feedback button[hidden] { display: none; }
+.translation-noscript { margin-top: 12px; font-size: 12px; }
+@media (max-width: 1000px) {
+  article-translator { align-items: flex-start; flex-direction: column; gap: 20px; }
+  .translation-actions { flex: auto; width: 100%; }
+}
+@media (max-width: 480px) {
+  .translation-panel { margin: 16px 16px 0; padding: 18px 16px; }
+  .translation-icon { width: 38px; height: 38px; }
+  .translation-intro { gap: 11px; }
+  .translation-intro h2 { font-size: 26px; }
+  .translation-eyebrow { font-size: 8px; gap: 6px; }
+  .translation-fields { flex-wrap: wrap; gap: 10px; }
+  .translation-source { min-width: 75px; }
+  .translation-submit { flex: 1; gap: 8px; padding: 0 10px; }
+  .translation-target { min-width: 105px; }
+}
