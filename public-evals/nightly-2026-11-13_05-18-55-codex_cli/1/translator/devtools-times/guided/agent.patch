+---
+const languages = [
+  ['en', 'English'], ['ar', 'العربية'], ['zh', '中文'], ['nl', 'Nederlands'],
+  ['fr', 'Français'], ['de', 'Deutsch'], ['hi', 'हिन्दी'], ['it', 'Italiano'],
+  ['ja', '日本語'], ['ko', '한국어'], ['pt', 'Português'], ['es', 'Español'],
+  ['uk', 'Українська'],
+];
+---
+
+<section data-translation-control aria-label="Article translation" class="border-b border-amber-200 bg-amber-50 px-4 py-3 md:px-6" hidden>
+  <div class="flex flex-wrap items-center gap-3">
+    <svg aria-hidden="true" class="h-5 w-5 text-amber-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
+      <path stroke-linecap="round" stroke-linejoin="round" d="m4 5 7 0m-3-2v2m-2 0c0 5 3 8 6 10M11 5c0 5-3 8-7 10m10 4 4-11 4 11m-6.5-4h5" />
+    </svg>
+    <label for="article-language" class="text-sm font-semibold text-gray-900">Read in</label>
+    <select id="article-language" data-translation-language aria-describedby="translation-note" class="min-h-10 rounded border border-amber-300 bg-white px-3 text-sm text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800" disabled>
+      {languages.map(([code, name]) => <option value={code} lang={code} selected={code === 'es'}>{name}{code === 'en' ? ' (original)' : ''}</option>)}
+    </select>
+    <button type="button" data-translation-start class="min-h-10 rounded bg-gray-800 px-4 text-sm font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800" disabled>Translate</button>
+    <button type="button" data-translation-reset class="min-h-10 rounded px-2 text-sm font-semibold text-amber-900 underline underline-offset-4 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800" hidden>Show original</button>
+    <span class="text-xs text-amber-900">On-device AI translation</span>
+  </div>
+  <p id="translation-note" class="mt-2 text-xs text-gray-600">Translates article text and teasers on this page. Text stays on your device. Language packs may need a one-time download. AI translations can contain errors.</p>
+  <p data-translation-status role="status" aria-live="polite" aria-atomic="true" class="mt-1 text-sm text-gray-700">Checking on-device translation…</p>
+  <noscript><p class="mt-1 text-sm text-gray-700">Enable JavaScript to use on-device translation.</p></noscript>
+</section>
+
+<script>
+  import '../scripts/translation';
+</script>
