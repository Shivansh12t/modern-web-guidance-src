diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..17b5ab7
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,196 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+interface LocalTranslator {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+}
+interface TranslatorAPI {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    monitor: (monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }) => void;
+  }): Promise<LocalTranslator>;
+}
+
+function initializeTranslation() {
+  const control = document.querySelector<HTMLElement>('[data-translation-control]');
+  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-translate]'));
+  if (!control || control.dataset.initialized || !roots.length) return;
+  control.dataset.initialized = 'true';
+  control.hidden = false;
+
+  const language = control.querySelector<HTMLSelectElement>('[data-translation-language]')!;
+  const start = control.querySelector<HTMLButtonElement>('[data-translation-start]')!;
+  const reset = control.querySelector<HTMLButtonElement>('[data-translation-reset]')!;
+  const status = control.querySelector<HTMLElement>('[data-translation-status]')!;
+  const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+  if (!api) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop version of Chrome or Edge. You can still read the English original.';
+    return;
+  }
+
+  // Keep text nodes, links, formatting, and embedded article widgets intact.
+  const originals = new Map<Text, string>();
+  const attributes = roots.map(root => ({ root, lang: root.getAttribute('lang'), dir: root.getAttribute('dir') }));
+  for (const root of roots) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        if (!node.textContent?.trim() || node.parentElement?.closest('script, style, pre, code, button, textarea, select, [translate="no"], [data-no-translate]')) {
+          return NodeFilter.FILTER_REJECT;
+        }
+        return NodeFilter.FILTER_ACCEPT;
+      },
+    });
+    let node;
+    while ((node = walker.nextNode())) originals.set(node as Text, node.textContent!);
+  }
+
+  let version = 0;
+  let active: LocalTranslator | undefined;
+  let busy = false;
+  let disposed = false;
+  let pair: LanguagePair | undefined;
+  language.disabled = false;
+
+  function destroyTranslator() {
+    active?.destroy();
+    active = undefined;
+  }
+
+  function restoreText() {
+    for (const [node, text] of originals) node.data = text;
+    for (const { root, lang, dir } of attributes) {
+      if (lang === null) root.removeAttribute('lang'); else root.setAttribute('lang', lang);
+      if (dir === null) root.removeAttribute('dir'); else root.setAttribute('dir', dir);
+    }
+    reset.hidden = true;
+  }
+
+  async function checkAvailability() {
+    const current = ++version;
+    pair = undefined;
+    start.disabled = true;
+    if (language.value === 'en') {
+      start.disabled = false;
+      start.textContent = 'Show original';
+      status.textContent = 'English is the original language of these articles.';
+      return;
+    }
+    start.textContent = 'Translate';
+    status.textContent = 'Checking language availability…';
+    const options = { sourceLanguage: 'en', targetLanguage: language.value };
+    try {
+      const availability = await api!.availability(options);
+      if (current !== version || disposed) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language pair is unavailable on your device. Choose another language.';
+        return;
+      }
+      pair = options;
+      start.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'A language pack is needed. Select Translate to download it and translate on your device.';
+    } catch {
+      if (current !== version || disposed) return;
+      status.textContent = 'Could not check translation availability. Choose a language to try again.';
+    }
+  }
+
+  language.addEventListener('change', checkAvailability);
+  reset.addEventListener('click', () => {
+    ++version;
+    destroyTranslator();
+    busy = false;
+    language.disabled = false;
+    control.removeAttribute('aria-busy');
+    restoreText();
+    void checkAvailability();
+  });
+
+  start.addEventListener('click', async () => {
+    if (busy || disposed) return;
+    if (language.value === 'en') {
+      restoreText();
+      status.textContent = 'Showing the English original.';
+      return;
+    }
+    if (!pair) return;
+    const options = pair;
+    const current = ++version;
+    busy = true;
+    start.disabled = true;
+    language.disabled = true;
+    reset.hidden = false;
+    control.setAttribute('aria-busy', 'true');
+    status.textContent = 'Preparing on-device translation…';
+    let translator: LocalTranslator | undefined;
+    let registered = false;
+    try {
+      // Availability was checked beforehand: create runs directly in the click
+      // handler so model downloads retain the required user activation.
+      translator = await api!.create({
+        ...options,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (current === version && !disposed) {
+              status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%. Keep this page open.`;
+            }
+          });
+        },
+      });
+      if (current !== version || disposed) return;
+      active = translator;
+      registered = true;
+      const translated = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      let completed = 0;
+      for (const [node, original] of originals) {
+        if (current !== version || disposed) return;
+        const text = original.trim();
+        let result = cache.get(text);
+        if (result === undefined) {
+          result = await translator.translate(text);
+          if (current !== version || disposed) return;
+          if (!result.trim()) throw new Error('Empty translation');
+          cache.set(text, result);
+        }
+        translated.set(node, original.replace(text, () => result!));
+        status.textContent = `Translating article text and teasers: ${Math.round(++completed / originals.size * 100)}%.`;
+      }
+      if (current !== version || disposed) return;
+      // Commit together so a failed/cancelled request never leaves mixed text.
+      for (const [node, text] of translated) node.data = text;
+      for (const root of roots) {
+        root.lang = options.targetLanguage;
+        root.dir = options.targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      }
+      const label = language.selectedOptions[0].textContent;
+      status.textContent = `Showing ${label}. Translated on your device with AI. You can return to the English original at any time.`;
+    } catch {
+      if (current !== version || disposed) return;
+      status.textContent = 'Translation could not be completed. Your current text is unchanged. Check your connection for language-pack downloads, then try again.';
+    } finally {
+      // A cancelled create() may resolve later; release its model as well.
+      if (active === translator) {
+        destroyTranslator();
+      } else if (!registered) {
+        translator?.destroy();
+      }
+      if (current === version && !disposed) {
+        busy = false;
+        start.disabled = false;
+        language.disabled = false;
+        control.removeAttribute('aria-busy');
+      }
+    }
+  });
+
+  document.addEventListener('astro:before-swap', () => {
+    disposed = true;
+    ++version;
+    destroyTranslator();
+  }, { once: true });
+  void checkAvailability();
+}
+
+document.addEventListener('astro:page-load', initializeTranslation);
