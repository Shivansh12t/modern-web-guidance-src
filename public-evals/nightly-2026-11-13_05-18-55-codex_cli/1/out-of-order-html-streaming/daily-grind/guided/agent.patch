+  <script type="module">
+    // Backend contract (HTML fragments, not full documents):
+    // GET /api/menu/seasonal -> coffee cards; GET /api/reviews -> review markup.
+    // GET /api/cms/seasonal-promo -> editorial HTML, including widget scripts.
+    // The CMS route MUST exclude customer input, including customer reviews.
+    // GET /api/menu/events -> text/event-stream; emit "menu-changed" events.
+    // Other client code can also dispatch Event("menu-changed") on document.
+
+    // Progressive fallback: native <template for> consumes the template when
+    // supported. Otherwise this trusted, document-authored template remains.
+    for (const template of document.querySelectorAll('template[for][data-target]')) {
+      document.getElementById(template.dataset.target)
+        .replaceChildren(template.content.cloneNode(true));
+      template.remove();
+    }
+
+    const cards = document.getElementById('seasonal-cards');
+    const menuStatus = document.getElementById('menu-status');
+    const refreshButton = document.getElementById('refresh-menu');
+    cards.setAttribute('aria-busy', 'false');
+    menuStatus.textContent = '';
+    refreshButton.hidden = false;
 
+    let purifierPromise;
+    async function safeSetHTML(target, html, reviewOnly = false) {
+      const elements = ['p', 'blockquote', 'cite', 'strong', 'em', 'b', 'i', 'br', 'ul', 'ol', 'li'];
+      if ('setHTML' in Element.prototype) {
+        target.setHTML(html, reviewOnly ? { sanitizer: { elements, attributes: [] } } : {});
+      } else {
+        // Load a maintained sanitizer only in browsers without native support.
+        purifierPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.3.0/+esm')
+          .then(module => module.default);
+        const purifier = await purifierPromise;
+        target.replaceChildren(purifier.sanitize(html, {
+          RETURN_DOM_FRAGMENT: true,
+          ...(reviewOnly ? {
+            ALLOWED_TAGS: [...elements, '#text'], ALLOWED_ATTR: [],
+            ALLOW_ARIA_ATTR: false, ALLOW_DATA_ATTR: false, KEEP_CONTENT: false
+          } : {})
+        }));
+      }
+    }
+
+    async function fetchHTML(path) {
+      const response = await fetch(path, {
+        headers: { Accept: 'text/html' },
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error'
+      });
+      if (!response.ok || !response.headers.get('Content-Type')?.includes('text/html')) {
+        throw new Error('Expected an HTML fragment');
+      }
+      return response;
+    }
+
+    // Serialize refreshes and coalesce changes arriving during an active fetch.
+    let refreshing = false;
+    let refreshAgain = false;
+    async function refreshMenu() {
+      if (refreshing) { refreshAgain = true; return; }
+      refreshing = true;
+      refreshButton.disabled = true;
+      cards.setAttribute('aria-busy', 'true');
+      menuStatus.textContent = 'Updating seasonal favorites…';
+      try {
+        const response = await fetchHTML('/api/menu/seasonal');
+        const next = document.createElement('div');
+        if ('streamHTML' in Element.prototype && response.body && 'TextDecoderStream' in window) {
+          await response.body.pipeThrough(new TextDecoderStream()).pipeTo(next.streamHTML());
+        } else {
+          await safeSetHTML(next, await response.text());
+        }
+        if (!next.querySelector('.card')) throw new Error('Expected coffee cards');
+        // Keep the existing menu on fetch/parse failure. Restore focus only if
+        // the visitor was inside the cards at the moment of replacement.
+        const active = document.activeElement;
+        const hadFocus = cards.contains(active);
+        const href = hadFocus ? active.getAttribute('href') : null;
+        cards.replaceChildren(...next.childNodes);
+        if (hadFocus) {
+          const equivalent = href && [...cards.querySelectorAll('a[href]')]
+            .find(link => link.getAttribute('href') === href);
+          (equivalent || document.getElementById('seasonal-heading')).focus({ preventScroll: true });
+        }
+        menuStatus.textContent = 'Seasonal favorites are up to date.';
+      } catch {
+        menuStatus.textContent = 'Unable to refresh the menu. Please try again.';
+      } finally {
+        refreshing = false;
+        refreshButton.disabled = false;
+        cards.setAttribute('aria-busy', 'false');
+        if (refreshAgain) { refreshAgain = false; void refreshMenu(); }
+      }
+    }
+
+    async function loadReviews() {
+      const target = document.getElementById('customer-reviews');
+      const status = document.getElementById('reviews-status');
+      try {
+        const response = await fetchHTML('/api/reviews');
+        // Always sanitize user content; never pass it to the CMS insertion path.
+        await safeSetHTML(target, await response.text(), true);
+        status.textContent = target.textContent.trim() ? '' : 'No customer reviews yet.';
+      } catch {
+        status.textContent = 'Customer reviews are unavailable right now.';
+      } finally {
+        target.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    // Detect the OPTION too: older setHTMLUnsafe implementations silently ignore
+    // runScripts. This probe parses no markup and executes no scripts.
+    let supportsRunScripts = false;
+    if ('setHTMLUnsafe' in Element.prototype) {
+      document.createElement('div').setHTMLUnsafe('', {
+        get runScripts() { supportsRunScripts = true; return false; }
+      });
+    }
+
+    async function loadTrustedPromo() {
+      const target = document.getElementById('cms-promo');
+      try {
+        // This fixed first-party editorial endpoint is the only executable source.
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        const html = await response.text();
+        if (supportsRunScripts) {
+          target.setHTMLUnsafe(html, { runScripts: true });
+        } else {
+          // Trusted CMS only. innerHTML leaves scripts inert, so explicitly
+          // activate widget scripts in source order in older browsers.
+          target.innerHTML = html;
+          for (const inert of target.querySelectorAll('script')) {
+            const script = document.createElement('script');
+            for (const attr of inert.attributes) script.setAttribute(attr.name, attr.value);
+            script.textContent = inert.textContent;
+            const loaded = (script.src || script.type === 'module')
+              ? new Promise((resolve, reject) => {
+                  script.onload = resolve;
+                  script.onerror = reject;
+                }) : Promise.resolve();
+            script.async = false;
+            inert.replaceWith(script);
+            await loaded;
+          }
+        }
+      } catch {
+        document.getElementById('promo-status').textContent = 'The latest promotion is unavailable.';
+      }
+    }
+
+    refreshButton.addEventListener('click', refreshMenu);
+    document.addEventListener('menu-changed', refreshMenu);
+    // Polling also covers missed events and browsers without EventSource.
+    let poll;
+    let events;
+    function startUpdates() {
+      poll = setInterval(() => {
+        if (document.visibilityState === 'visible') void refreshMenu();
+      }, 60000);
+      events = 'EventSource' in window ? new EventSource('/api/menu/events') : null;
+      events?.addEventListener('menu-changed', refreshMenu);
+      // Refresh on (re)connection to pick up changes missed while disconnected.
+      events?.addEventListener('open', refreshMenu);
+    }
+    window.addEventListener('pagehide', () => {
+      events?.close();
+      clearInterval(poll);
+    });
+    window.addEventListener('pageshow', event => {
+      if (event.persisted) { startUpdates(); void refreshMenu(); }
+    });
+    startUpdates();
+    void loadReviews();
+    void loadTrustedPromo();
+  </script>
