+  <!-- Flush the initial layout first; emit this template when the menu is ready.
+       A body-level template can target the nested seasonal-cards range. Only
+       server-authored/escaped menu markup belongs here, never raw reviews. -->
+  <template for="seasonal-cards" id="initial-seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script type="module">
+    const cards = document.getElementById('seasonal-cards');
+    const refreshButton = document.getElementById('refresh-menu');
+    const menuStatus = document.getElementById('menu-status');
+    const reviews = document.getElementById('customer-reviews');
+    const promo = document.getElementById('cms-promo');
+
+    // Older parsers leave <template for> inert. Clone only this trusted,
+    // server-authored template; never use this path for fetched HTML.
+    const initialCards = document.getElementById('initial-seasonal-cards');
+    if (cards.querySelector('.placeholder') && initialCards) {
+      cards.replaceChildren(initialCards.content.cloneNode(true));
+      initialCards.remove();
+    }
+
+    /* Server contract (same-origin):
+       GET /api/menu/seasonal -> text/html, card children only, not a whole page.
+       GET /api/menu/events -> text/event-stream; emit "menu-changed" events
+         after a menu revision is committed. EventSource reconnects on disconnect.
+       GET /api/reviews -> text/html, customer-submitted review markup.
+       GET /api/cms/seasonal-promo -> text/html, trusted CMS markup + widget script.
+         This endpoint must contain only publisher-controlled HTML and scripts;
+         customer submissions must never be interpolated into this response.
+       All endpoints must authenticate/authorize requests as appropriate.
+    */
+    async function fetchHTML(path, signal) {
+      const response = await fetch(path, {
+        signal,
+        headers: { Accept: 'text/html' },
+        cache: 'no-store',
+        credentials: 'same-origin',
+        redirect: 'error'
+      });
+      if (!response.ok ||
+          response.headers.get('Content-Type')?.split(';')[0].trim().toLowerCase() !== 'text/html') {
+        throw new Error('Expected an HTML fragment');
+      }
+      return response.text();
+    }
+
+    let menuRequest;
+    async function refreshSeasonalMenu() {
+      // A newer notification supersedes any pending response.
+      menuRequest?.abort();
+      const request = new AbortController();
+      menuRequest = request;
+      cards.setAttribute('aria-busy', 'true');
+      refreshButton.disabled = true;
+      menuStatus.textContent = 'Refreshing the seasonal menu…';
+      try {
+        const html = await fetchHTML('/api/menu/seasonal', request.signal);
+        if (request.signal.aborted) return;
+        // Safe native insertion removes scripts and other XSS-capable markup.
+        cards.setHTML(html);
+        menuStatus.textContent = 'The seasonal menu is up to date.';
+      } catch (error) {
+        if (request.signal.aborted) return;
+        menuStatus.textContent = 'Unable to refresh. The last available menu is still shown.';
+      } finally {
+        if (menuRequest === request) {
+          cards.setAttribute('aria-busy', 'false');
+          refreshButton.disabled = false;
+        }
+      }
+    }
+
+    let menuEvents;
+    function connectMenuEvents() {
+      menuEvents = new EventSource('/api/menu/events');
+      menuEvents.addEventListener('menu-changed', refreshSeasonalMenu);
+      menuEvents.onerror = () => {
+        if (!refreshButton.disabled) {
+          menuStatus.textContent = 'Live menu updates are reconnecting. You can refresh the menu manually.';
+        }
+      };
+      // Reconcile changes missed while disconnected, including the first load.
+      menuEvents.onopen = refreshSeasonalMenu;
+    }
+
+    if (typeof cards.setHTML === 'function') {
+      refreshButton.hidden = false;
+      refreshButton.addEventListener('click', refreshSeasonalMenu);
+      // Also let other first-party menu controls announce a committed change.
+      document.addEventListener('menu-changed', refreshSeasonalMenu);
+      if ('EventSource' in window) {
+        connectMenuEvents();
+      } else {
+        refreshSeasonalMenu();
+      }
+    } else {
+      menuStatus.textContent = 'For the latest seasonal choices, visit our full menu.';
+      const menuLink = document.createElement('a');
+      menuLink.href = '/menu';
+      menuLink.textContent = ' Browse menu';
+      menuStatus.append(menuLink);
+    }
+
+    async function loadReviews() {
+      try {
+        if (typeof reviews.setHTML !== 'function') throw new Error('Safe insertion unavailable');
+        const html = await fetchHTML('/api/reviews');
+        // Untrusted reviews always use the native sanitizer. Never opt into scripts.
+        reviews.setHTML(html);
+      } catch {
+        reviews.textContent = 'Customer reviews are currently unavailable.';
+      } finally {
+        reviews.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    async function loadPromo() {
+      try {
+        if (typeof promo.setHTMLUnsafe !== 'function') throw new Error('HTML insertion unavailable');
+        const html = await fetchHTML('/api/cms/seasonal-promo');
+        // This fixed first-party CMS endpoint is the sole script-enabled sink.
+        // runScripts requires a browser supporting the renewed HTML setters.
+        promo.setHTMLUnsafe(html, { runScripts: true });
+      } catch {
+        document.getElementById('promo-status').textContent = 'Visit Rewards for our latest offers.';
+      } finally {
+        promo.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    loadReviews();
+    loadPromo();
+    window.addEventListener('pagehide', () => {
+      menuRequest?.abort();
+      menuEvents?.close();
+    });
+    window.addEventListener('pageshow', (event) => {
+      if (event.persisted && typeof cards.setHTML === 'function') {
+        if ('EventSource' in window) connectMenuEvents();
+        else refreshSeasonalMenu();
+      }
+    });
+  </script>
+
 </body>
 
