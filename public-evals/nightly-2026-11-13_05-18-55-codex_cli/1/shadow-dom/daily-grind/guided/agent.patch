index 0000000..60fcdcd
--- /dev/null
+++ b/seasonal-card.js
@@ -0,0 +1,97 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+    }
+
+    :host([hidden]) { display: none; }
+
+    article {
+      box-sizing: border-box;
+      height: 100%;
+      background: white;
+      color: #3e2723;
+      font: 16px/1.6 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      overflow-wrap: anywhere;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      color: #4e342e;
+      font-size: 1.17em;
+    }
+
+    p { margin: 0; }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 10px;
+      border-radius: 12px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.75em;
+      font-weight: bold;
+    }
+
+    .badge[hidden] { display: none; }
+
+    a {
+      display: inline-block;
+      background: #4e342e;
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 3px solid #4e342e; outline-offset: 3px; }
+  </style>
+  <article>
+    <span class="badge" hidden>Limited</span>
+    <h3></h3>
+    <p></p>
+    <a></a>
+  </article>
+`;
+
+class SeasonalCard extends HTMLElement {
+  static observedAttributes = ['drink-title', 'description', 'href', 'action-label', 'limited'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    this.#update();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#update();
+  }
+
+  #update() {
+    const root = this.shadowRoot;
+    root.querySelector('h3').textContent = this.getAttribute('drink-title') ?? '';
+    root.querySelector('p').textContent = this.getAttribute('description') ?? '';
+    const action = root.querySelector('a');
+    action.textContent = this.getAttribute('action-label') ?? 'View Details';
+    const href = this.getAttribute('href');
+    if (href === null) action.removeAttribute('href');
+    else action.setAttribute('href', href);
+    root.querySelector('.badge').hidden = !this.hasAttribute('limited');
+  }
+}
+
+customElements.define('seasonal-card', SeasonalCard);
