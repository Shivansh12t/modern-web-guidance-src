+const template = document.createElement('template');
+
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: #3e2723;
+    }
+
+    h3 {
+      margin-bottom: 10px;
+      color: #4e342e;
+      font-size: 1.17em;
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      font-size: 0.75rem;
+      font-weight: bold;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    /* Slotted nodes remain in the page; protect them from global resets too. */
+    ::slotted(*) {
+      all: unset !important;
+      box-sizing: border-box !important;
+      font: inherit !important;
+      color: inherit !important;
+    }
+
+    ::slotted(a[slot="action"]) {
+      display: inline-block !important;
+      background: #4e342e !important;
+      color: white !important;
+      padding: 10px 20px !important;
+      text-decoration: none !important;
+      border-radius: 5px !important;
+      margin-top: 15px !important;
+      cursor: pointer !important;
+      transition: background 0.3s !important;
+    }
+
+    ::slotted(a[slot="action"]:hover) {
+      background: #3e2723 !important;
+    }
+
+    ::slotted(a[slot="action"]:focus-visible) {
+      outline: 2px solid #4e342e !important;
+      outline-offset: 3px !important;
+    }
+  </style>
+  <article>
+    <div class="badge" hidden><slot name="badge"></slot></div>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <slot name="action"></slot>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  constructor() {
+    super();
+    const shadow = this.attachShadow({ mode: 'open' });
+    shadow.append(template.content.cloneNode(true));
+
+    const badgeSlot = shadow.querySelector('slot[name="badge"]');
+    const badge = shadow.querySelector('.badge');
+    // Slot changes cover badges added, removed, or reassigned by the page.
+    badgeSlot.addEventListener('slotchange', () => {
+      badge.hidden = !badgeSlot.assignedNodes().some(node =>
+        node.nodeType === Node.ELEMENT_NODE || node.textContent.trim()
+      );
+    });
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
