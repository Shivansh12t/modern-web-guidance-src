+(() => {
+  const form = document.querySelector('#coffee-form');
+  const result = document.querySelector('#coffee-result');
+  const allowed = {
+    temperature: ['hot', 'iced'],
+    flavor: ['balanced', 'bold', 'sweet'],
+    milk: ['oat', 'dairy', 'none'],
+  };
+
+  function recommend(preferences) {
+    const { temperature, flavor, milk } = preferences;
+    let name;
+    let description;
+    if (flavor === 'sweet') {
+      name = milk === 'none' ? 'Maple Black Coffee' : 'Maple Latte';
+      description = 'A touch of real maple syrup brings a warm sweetness to our locally roasted coffee.';
+    } else if (flavor === 'bold') {
+      name = milk === 'none' ? 'Dark Roast Americano' : 'Dark Roast Latte';
+      description = 'Our dark roast espresso brings deep, rich flavor and a beautifully bold finish.';
+    } else {
+      name = temperature === 'iced' ? 'Signature Cold Brew' : milk === 'none' ? 'House Filter Coffee' : 'House Latte';
+      description = temperature === 'iced'
+        ? 'Steeped for 18 hours for a smooth, mellow cup with a naturally balanced finish.'
+        : 'Our small-batch house roast makes a smooth, rounded cup for an everyday moment of joy.';
+    }
+    const temperatureLabel = temperature === 'iced' ? 'Iced' : 'Hot';
+    const milkLabel = { oat: 'with oat milk', dairy: 'with dairy milk', none: 'served black' }[milk];
+    return { name, temperature, milk, flavor, customization: `${temperatureLabel}, ${milkLabel}`, description };
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const preferences = Object.fromEntries(new FormData(form));
+    const valid = Object.entries(allowed).every(([key, values]) => values.includes(preferences[key]));
+    let response;
+    if (!valid || !form.checkValidity()) {
+      result.textContent = 'Please choose a temperature, flavor, and milk preference to find your coffee.';
+      form.reportValidity();
+      response = { success: false, error: 'Invalid coffee preferences. Choose one of the available options for every field.' };
+    } else {
+      const coffee = recommend(preferences);
+      const label = document.createElement('p');
+      label.className = 'result-label';
+      label.textContent = 'Your coffee match';
+      const heading = document.createElement('h3');
+      heading.textContent = coffee.name;
+      const customization = document.createElement('p');
+      customization.textContent = coffee.customization;
+      const description = document.createElement('p');
+      description.textContent = coffee.description;
+      result.replaceChildren(label, heading, customization, description);
+      response = { success: true, recommendation: coffee, message: 'Coffee recommendation only. No order has been placed.' };
+    }
+    // WebMCP-capable browsers return this same result to the invoking agent.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(response));
+    }
+  });
+
+  form.addEventListener('change', () => {
+    result.replaceChildren();
+  });
+
+  const presets = {
+    maple: { temperature: 'hot', flavor: 'sweet', milk: 'oat' },
+    espresso: { temperature: 'hot', flavor: 'bold', milk: 'none' },
+    'cold-brew': { temperature: 'iced', flavor: 'balanced', milk: 'none' },
+  };
+  document.querySelectorAll('[data-coffee]').forEach((button) => {
+    button.addEventListener('click', () => {
+      for (const [key, value] of Object.entries(presets[button.dataset.coffee])) {
+        form.elements.namedItem(key).value = value;
+      }
+      form.requestSubmit();
+      document.querySelector('#coffee-finder').scrollIntoView({ block: 'start' });
+    });
+  });
+})();
