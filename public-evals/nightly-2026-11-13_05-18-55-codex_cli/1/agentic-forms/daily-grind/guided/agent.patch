+(() => {
+  const form = document.getElementById('coffee-finder-form');
+  const status = document.getElementById('coffee-status');
+  const cards = [...document.querySelectorAll('#coffee-results .card')];
+  const coffees = cards.map((card) => ({
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    url: card.querySelector('a').getAttribute('href'),
+    temperature: card.dataset.temperature,
+    flavor: card.dataset.flavor,
+  }));
+
+  const showAll = () => {
+    cards.forEach((card) => { card.hidden = false; });
+    status.textContent = `Showing all ${coffees.length} seasonal coffees.`;
+  };
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const data = new FormData(form);
+    const preferences = {
+      temperature: data.get('temperature') || 'any',
+      flavor: data.get('flavor') || 'any',
+    };
+    const matches = coffees.filter((coffee, index) => {
+      const matchesPreferences = Object.entries(preferences).every(
+        ([key, value]) => value === 'any' || coffee[key] === value
+      );
+      cards[index].hidden = !matchesPreferences;
+      return matchesPreferences;
+    });
+
+    const message = matches.length
+      ? `Found ${matches.length} matching ${matches.length === 1 ? 'coffee' : 'coffees'}. Explore your results below.`
+      : 'No coffees match these preferences. Try another combination or select Show all coffees.';
+    status.textContent = message;
+
+    // WebMCP uses the same submission and results as the visible form.
+    // Unsupported browsers continue to use the ordinary client-side finder.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve({
+        preferences,
+        count: matches.length,
+        matches,
+        message,
+      }));
+    }
+  });
+
+  form.addEventListener('reset', showAll);
+  form.addEventListener('change', () => {
+    showAll();
+    status.textContent = 'Preferences updated. Select Find my coffee to see your matches.';
+  });
+})();
