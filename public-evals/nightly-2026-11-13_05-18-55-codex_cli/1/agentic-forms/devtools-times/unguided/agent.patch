diff --git a/src/hooks/useAuthForm.ts b/src/hooks/useAuthForm.ts
new file mode 100644
index 0000000..2352e99
--- /dev/null
+++ b/src/hooks/useAuthForm.ts
@@ -0,0 +1,57 @@
+import { useCallback, useEffect, useRef, useState, type FormEvent } from 'react';
+import { authTools, credentialsSchema, submitCredentials, type AuthAction, type Credentials, type AuthResult } from '../utils/auth';
+import { registerAgentTool } from '../utils/webmcp';
+
+export function useAuthForm(action: AuthAction) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const pending = useRef(false);
+
+  const submit = useCallback(async (input: Credentials, signal?: AbortSignal): Promise<AuthResult> => {
+    if (pending.current) return { ok: false, message: 'A submission is already in progress.' };
+    pending.current = true;
+    setError(null);
+    setSuccess(null);
+    setLoading(true);
+    try {
+      const result = await submitCredentials(action, input, signal);
+      if (result.ok) {
+        setSuccess(result.message);
+        if (action === 'signup') {
+          setUsername('');
+          setPassword('');
+        }
+      } else {
+        setError(result.message);
+      }
+      return result;
+    } finally {
+      pending.current = false;
+      setLoading(false);
+    }
+  }, [action]);
+
+  useEffect(() => registerAgentTool({
+    ...authTools[action],
+    inputSchema: credentialsSchema,
+    execute: async (input, options) => {
+      // Validate at runtime as well as providing a schema to the agent.
+      const credentials = input as Credentials;
+      if (!pending.current && credentials && typeof credentials.username === 'string' && typeof credentials.password === 'string') {
+        setUsername(credentials.username);
+        setPassword(credentials.password);
+      }
+      return submit(credentials, options?.signal);
+    },
+  }), [action, submit]);
+
+  const handleSubmit = async (event: FormEvent) => {
+    event.preventDefault();
+    await submit({ username, password });
+  };
+
+  return { username, setUsername, password, setPassword, error, success, loading, handleSubmit };
+}
diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..c52743e
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,73 @@
+export type AuthAction = 'signin' | 'signup';
+export interface Credentials {
+  username: string;
+  password: string;
+}
+
+export interface AuthResult {
+  ok: boolean;
+  message: string;
+}
+
+export const authTools = {
+  signin: {
+    name: 'sign_in',
+    description: 'Sign in to The DevTools Times using a username and password. Returns the login result.',
+  },
+  signup: {
+    name: 'sign_up',
+    description: 'Create a DevTools Times account using a username and password. Returns the registration result; sign in separately after success.',
+  },
+};
+
+export const credentialsSchema = {
+  type: 'object',
+  properties: {
+    username: { type: 'string', minLength: 1, description: 'Account username.' },
+    password: { type: 'string', minLength: 1, description: 'Account password.' },
+  },
+  required: ['username', 'password'],
+  additionalProperties: false,
+};
+
+// Both the form and the agent use this action. Never return credentials or tokens.
+export async function submitCredentials(
+  action: AuthAction,
+  input: Credentials,
+  signal?: AbortSignal,
+): Promise<AuthResult> {
+  if (!input || typeof input.username !== 'string' || !input.username ||
+      typeof input.password !== 'string' || !input.password) {
+    return { ok: false, message: 'Username and password are required.' };
+  }
+
+  try {
+    const response = await fetch(
+      `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action === 'signin' ? 'login' : 'register'}`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: input.username, password: input.password }),
+        signal,
+      },
+    );
+    const data = await response.json();
+    if (!response.ok) {
+      return {
+        ok: false,
+        message: `${action === 'signin' ? 'Login' : 'Registration'} failed: ${data?.error || 'Unknown error'}`,
+      };
+    }
+    return {
+      ok: true,
+      message: action === 'signin'
+        ? 'Login successful!'
+        : 'User registered successfully! You can now sign in.',
+    };
+  } catch {
+    return {
+      ok: false,
+      message: signal?.aborted ? 'Request cancelled.' : 'An unexpected error occurred. Please try again later.',
+    };
+  }
+}
diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..7ac1b56
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,37 @@
+export interface AgentTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: unknown, options?: { signal?: AbortSignal }) => Promise<unknown>;
+}
+
+interface ModelContext {
+  registerTool: (tool: AgentTool) => void | Promise<void>;
+  unregisterTool: (name: string) => void;
+}
+
+// The early WebMCP API lives on navigator; newer versions use document.
+export function registerAgentTool(tool: AgentTool): () => void {
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context) return () => {};
+
+  let disposed = false;
+  let registered = false;
+  try {
+    const registration = context.registerTool(tool);
+    Promise.resolve(registration).then(() => {
+      registered = true;
+      if (disposed) context.unregisterTool(tool.name);
+    }).catch(() => {
+      console.warn(`Could not register agent tool: ${tool.name}`);
+    });
+  } catch {
+    console.warn(`Could not register agent tool: ${tool.name}`);
+  }
+
+  return () => {
+    disposed = true;
+    if (registered) context.unregisterTool(tool.name);
+  };
+}
diff --git a/tests/agent-tools.test.mjs b/tests/agent-tools.test.mjs
new file mode 100644
index 0000000..36f4e44
--- /dev/null
+++ b/tests/agent-tools.test.mjs
@@ -0,0 +1,97 @@
+import assert from 'node:assert/strict';
+import { test, afterEach } from 'node:test';
+import { submitCredentials } from '../src/utils/auth.ts';
+import { registerAgentTool } from '../src/utils/webmcp.ts';
+
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  delete globalThis.document;
+  delete navigator.modelContext;
+});
+
+for (const [action, endpoint] of [['signin', 'login'], ['signup', 'register']]) {
+  test(`${action} posts credentials and only returns the outcome`, async () => {
+    const controller = new AbortController();
+    globalThis.fetch = async (url, options) => {
+      assert.ok(url.endsWith(`/api/${endpoint}`));
+      assert.equal(options.method, 'POST');
+      assert.equal(options.headers['Content-Type'], 'application/json');
+      assert.equal(options.signal, controller.signal);
+      assert.deepEqual(JSON.parse(options.body), { username: 'reader', password: 'secret123' });
+      return Response.json({ token: 'private-token' });
+    };
+    const result = await submitCredentials(action, { username: 'reader', password: 'secret123' }, controller.signal);
+    assert.equal(result.ok, true);
+    assert.deepEqual(Object.keys(result), ['ok', 'message']);
+    assert.doesNotMatch(JSON.stringify(result), /private-token|secret123/);
+  });
+}
+
+test('invalid inputs never send a request', async () => {
+  globalThis.fetch = () => assert.fail('Must not fetch invalid credentials');
+  for (const input of [null, {}, { username: 'reader', password: '' }, { username: 3, password: 'secret' }]) {
+    assert.equal((await submitCredentials('signin', input)).ok, false);
+  }
+});
+
+test('API errors preserve the existing form error messages', async () => {
+  globalThis.fetch = async () => Response.json({ error: 'APP_ERR_2001' }, { status: 401 });
+  assert.deepEqual(await submitCredentials('signin', { username: 'reader', password: 'wrong' }), {
+    ok: false, message: 'Login failed: APP_ERR_2001',
+  });
+});
+
+test('network and malformed response failures return an error outcome', async () => {
+  for (const fetcher of [async () => { throw new Error('offline'); }, async () => new Response('<html>')]) {
+    globalThis.fetch = fetcher;
+    assert.deepEqual(await submitCredentials('signup', { username: 'reader', password: 'secret123' }), {
+      ok: false, message: 'An unexpected error occurred. Please try again later.',
+    });
+  }
+});
+
+test('cancellation returns an error outcome', async () => {
+  const controller = new AbortController();
+  controller.abort();
+  globalThis.fetch = async (_url, { signal }) => { signal.throwIfAborted(); };
+  assert.deepEqual(await submitCredentials('signin', { username: 'reader', password: 'secret123' }, controller.signal), {
+    ok: false, message: 'Request cancelled.',
+  });
+});
+
+const tool = { name: 'sign_in', description: 'Sign in', inputSchema: {}, execute: async () => ({ ok: true }) };
+
+test('unsupported browsers skip registration', () => {
+  globalThis.document = {};
+  assert.doesNotThrow(() => registerAgentTool(tool)());
+});
+
+for (const target of ['document', 'navigator']) {
+  test(`registers on ${target} and unregisters on unmount`, async () => {
+    globalThis.document = {};
+    const calls = [];
+    globalThis[target].modelContext = {
+      registerTool: (value) => calls.push(value),
+      unregisterTool: (name) => calls.push(name),
+    };
+    const cleanup = registerAgentTool(tool);
+    await Promise.resolve();
+    assert.deepEqual(calls, [tool]);
+    cleanup();
+    assert.deepEqual(calls, [tool, 'sign_in']);
+  });
+}
+
+test('unmount during async registration still removes the tool', async () => {
+  let resolve;
+  const removed = [];
+  globalThis.document = { modelContext: {
+    registerTool: () => new Promise((done) => { resolve = done; }),
+    unregisterTool: (name) => removed.push(name),
+  } };
+  registerAgentTool(tool)();
+  resolve();
+  await Promise.resolve();
+  assert.deepEqual(removed, ['sign_in']);
+});
