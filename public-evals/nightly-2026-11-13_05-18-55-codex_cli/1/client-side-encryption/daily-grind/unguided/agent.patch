+import { createRecipient } from './crypto.js';
+const icons = {
+  lock: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4M12 14v3"/>',
+  shield: '<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m9 12 2 2 4-4"/>',
+  note: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
+  home: '<path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8"/>',
+  layers: '<path d="m12 3 10 5-10 5L2 8l10-5Zm-10 9 10 5 10-5M2 16l10 5 10-5"/>',
+  sparkles: '<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3ZM20 2v4M18 4h4"/>',
+  key: '<circle cx="8" cy="9" r="5"/><path d="m12 13 8 8m-3-3 3-3m-6 0 3-3"/>',
+  check: '<path d="m5 12 4 4L19 6"/>',
+  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>',
+};
+document.querySelectorAll('[data-icon]').forEach(el => {
+  el.outerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[el.dataset.icon] || ''}</svg>`;
+});
+const $ = id => document.getElementById(id);
+let saved = null;
+let busy = false;
+function status(message, error = false) {
+  $('status').textContent = message;
+  $('status').classList.toggle('error', error);
+}
+$('note').addEventListener('input', () => {
+  $('counter').textContent = `${$('note').value.length} / 500`;
+  status(saved ? 'Unsaved changes. Encrypt again to update your saved note.' : '');
+});
+$('delivery-label').addEventListener('input', () => { if (saved) status('Unsaved changes. Encrypt again to update your saved note.'); });
+document.querySelectorAll('[name="protection"]').forEach(radio => radio.addEventListener('change', () => {
+  document.querySelectorAll('.protection').forEach(card => card.classList.toggle('selected', card.querySelector('input').checked));
+  if (saved) status('Protection changed. Encrypt again to update your saved note.');
+}));
+function eraseSaved() {
+  saved?.recipient.destroy();
+  saved = null;
+  $('view-note').hidden = true;
+  $('preview-label').textContent = 'WHAT AN ENCRYPTED NOTE LOOKS LIKE';
+  $('cipher-preview').textContent = 'U2FsdGVkX1+7cK9mQx4vN8pL3bR6jY2wF5hT0zA9eD7uX1kC4sM8...';
+  $('preview-caption').textContent = "Just a scramble. That's the point.";
+  $('decrypted-note').textContent = '';
+  $('saved-label').textContent = 'Your delivery note';
+}
+$('clear').addEventListener('click', () => {
+  if (busy) return;
+  eraseSaved();
+  $('note').value = ''; $('delivery-label').value = ''; $('counter').textContent = '0 / 500';
+  status('Note cleared. Your temporary recipient key has been removed.');
+});
+$('note-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  if (!$('note').value.trim()) { status('Add a delivery note before encrypting.', true); $('note').focus(); return; }
+  busy = true; $('encrypt').disabled = true; $('clear').disabled = true;
+  status('Establishing a shared secret and encrypting your note…');
+  let recipient;
+  try {
+    const mode = document.querySelector('[name="protection"]:checked').value;
+    recipient = createRecipient(mode);
+    const envelope = await recipient.encrypt({ label: $('delivery-label').value.trim(), note: $('note').value.trim() });
+    // Verify authentication with the recipient before accepting the encrypted result.
+    await recipient.decrypt(envelope);
+    eraseSaved();
+    saved = { envelope, recipient };
+    $('cipher-preview').textContent = `${envelope.ciphertext.slice(0, 88)}…`;
+    $('preview-label').textContent = 'YOUR ENCRYPTED NOTE';
+    $('preview-caption').textContent = 'Encrypted & saved for this session.';
+    $('view-note').hidden = false;
+    $('note').value = ''; $('delivery-label').value = ''; $('counter').textContent = '0 / 500';
+    status('Your note is encrypted. View it securely using the preview.');
+  } catch (error) {
+    recipient?.destroy();
+    status(error.message === 'Encryption requires HTTPS or localhost and a browser with Web Crypto support.' ? error.message : 'We couldn’t encrypt your note. Your draft is still here. Please try again.', true);
+  } finally { busy = false; $('encrypt').disabled = false; $('clear').disabled = false; }
+});
+$('view-note').addEventListener('click', async () => {
+  if (!saved) return;
+  try {
+    const note = await saved.recipient.decrypt(saved.envelope);
+    $('saved-label').textContent = note.label || 'Your delivery note';
+    $('decrypted-note').textContent = note.note;
+    $('note-dialog').showModal();
+  } catch { status('This note could not be authenticated. Its contents cannot be shown.', true); }
+});
+$('download').addEventListener('click', () => {
+  if (!saved) return;
+  const url = URL.createObjectURL(new Blob([JSON.stringify(saved.envelope, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a'); link.href = url; link.download = 'daily-grind-encrypted-note.json'; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+});
+['protection-info', 'how-it-works', 'footer-privacy'].forEach(id => $(id).addEventListener('click', event => { event.preventDefault(); $('privacy-dialog').showModal(); }));
+document.querySelectorAll('dialog').forEach(dialog => {
+  dialog.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
+  dialog.addEventListener('click', event => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
+});
+$('note-dialog').addEventListener('close', () => { $('decrypted-note').textContent = ''; $('saved-label').textContent = 'Your delivery note'; });
+window.addEventListener('pagehide', () => { eraseSaved(); $('note').value = ''; $('delivery-label').value = ''; });
diff --git a/src/crypto.js b/src/crypto.js
new file mode 100644
index 0000000..af8d9ae
--- /dev/null
+++ b/src/crypto.js
@@ -0,0 +1,76 @@
+import { x25519 } from '@noble/curves/ed25519.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+
+const utf8 = new TextEncoder();
+export const suites = {
+  classical: 'X25519',
+  hybrid: 'X25519+ML-KEM-768',
+  quantum: 'ML-KEM-768',
+};
+const base64 = bytes => btoa(String.fromCharCode(...bytes));
+const unbase64 = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+const random = size => crypto.getRandomValues(new Uint8Array(size));
+const kemFor = mode => mode === 'hybrid' ? ml_kem768_x25519 : ml_kem768;
+
+async function deriveKey(secret, salt, header) {
+  const material = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  const transcriptHash = new Uint8Array(await crypto.subtle.digest('SHA-256', utf8.encode(JSON.stringify(header))));
+  return crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt,
+    info: utf8.encode(`daily-grind/delivery-note/v1/${header.suite}/${base64(transcriptHash)}`) },
+  material, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+}
+
+export function createRecipient(mode) {
+  if (!Object.hasOwn(suites, mode)) throw new Error('Unsupported protection option.');
+  if (!globalThis.crypto?.subtle) throw new Error('Encryption requires HTTPS or localhost and a browser with Web Crypto support.');
+  const keys = mode === 'classical' ? x25519.keygen() : kemFor(mode).keygen();
+  let destroyed = false;
+  return {
+    async encrypt(note) {
+      if (destroyed) throw new Error('This session key has expired.');
+      let sharedSecret, cipherText;
+      if (mode === 'classical') {
+        const ephemeral = x25519.keygen();
+        try {
+          sharedSecret = x25519.getSharedSecret(ephemeral.secretKey, keys.publicKey);
+          cipherText = ephemeral.publicKey;
+        } finally { ephemeral.secretKey.fill(0); }
+      } else ({ sharedSecret, cipherText } = kemFor(mode).encapsulate(keys.publicKey));
+      const salt = random(32), iv = random(12);
+      const header = { version: 1, purpose: 'daily-grind/delivery-note', suite: suites[mode],
+        cipher: 'AES-256-GCM', kdf: 'HKDF-SHA-256', recipientPublicKey: base64(keys.publicKey),
+        encapsulation: base64(cipherText), salt: base64(salt), iv: base64(iv) };
+      try {
+        const key = await deriveKey(sharedSecret, salt, header);
+        const plain = utf8.encode(JSON.stringify(note));
+        try {
+          const encrypted = await crypto.subtle.encrypt({ name: 'AES-GCM', iv,
+            additionalData: utf8.encode(JSON.stringify(header)), tagLength: 128 }, key, plain);
+          return { ...header, ciphertext: base64(new Uint8Array(encrypted)) };
+        } finally { plain.fill(0); }
+      } finally { sharedSecret.fill(0); }
+    },
+    async decrypt(envelope) {
+      if (destroyed) throw new Error('This session key has expired.');
+      const { ciphertext, ...header } = envelope;
+      if (header.version !== 1 || header.purpose !== 'daily-grind/delivery-note' ||
+        header.suite !== suites[mode] || header.cipher !== 'AES-256-GCM' ||
+        header.kdf !== 'HKDF-SHA-256' || header.recipientPublicKey !== base64(keys.publicKey)) {
+        throw new Error('Invalid encrypted note.');
+      }
+      const encapsulation = unbase64(header.encapsulation);
+      const secret = mode === 'classical' ? x25519.getSharedSecret(keys.secretKey, encapsulation)
+        : kemFor(mode).decapsulate(encapsulation, keys.secretKey);
+      try {
+        const key = await deriveKey(secret, unbase64(header.salt), header);
+        const plain = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM',
+          iv: unbase64(header.iv), additionalData: utf8.encode(JSON.stringify(header)), tagLength: 128 },
+        key, unbase64(ciphertext)));
+        try { return JSON.parse(new TextDecoder().decode(plain)); }
+        finally { plain.fill(0); }
+      } finally { secret.fill(0); }
+    },
+    destroy() { keys.secretKey.fill(0); destroyed = true; },
+  };
+}
diff --git a/src/crypto.test.js b/src/crypto.test.js
new file mode 100644
index 0000000..0d6e7a1
--- /dev/null
+++ b/src/crypto.test.js
@@ -0,0 +1,28 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRecipient, suites } from './crypto.js';
+for (const mode of Object.keys(suites)) {
+  test(`${mode}: round trip, fresh randomness, and tamper rejection`, async () => {
+    const recipient = createRecipient(mode);
+    const note = { label: 'Home 🏡', note: 'Gate 2468. Quiet knock, please.' };
+    const envelope = await recipient.encrypt(note);
+    assert.deepEqual(await recipient.decrypt(envelope), note);
+    const second = await recipient.encrypt(note);
+    assert.notEqual(envelope.ciphertext, second.ciphertext);
+    assert.notEqual(envelope.iv, second.iv);
+    assert.notEqual(envelope.encapsulation, second.encapsulation);
+    assert(!JSON.stringify(envelope).includes(note.note));
+    for (const field of ['ciphertext', 'encapsulation', 'salt', 'iv', 'recipientPublicKey']) {
+      const modified = { ...envelope };
+      modified[field] = (envelope[field][0] === 'A' ? 'B' : 'A') + envelope[field].slice(1);
+      await assert.rejects(() => recipient.decrypt(modified), `${field} tampering must fail`);
+    }
+    await assert.rejects(() => recipient.decrypt({ ...envelope, suite: 'other' }));
+    await assert.rejects(() => recipient.decrypt({ ...envelope, extra: 'unauthenticated' }));
+    const other = createRecipient(mode);
+    await assert.rejects(() => other.decrypt(envelope));
+    other.destroy(); recipient.destroy();
+    await assert.rejects(() => recipient.decrypt(envelope));
+  });
+}
+test('unsupported protection fails closed', () => { assert.throws(() => createRecipient('invalid')); });
