new file mode 100644
index 0000000..0290f23
--- /dev/null
+++ b/src/app.js
@@ -0,0 +1,137 @@
+const $ = (id) => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+const originals = [
+  { id: 0, name: 'left', rgb: [.75, .25, .25] },
+  { id: 1, name: 'right', rgb: [.25, .25, .75] },
+  { id: 6, name: 'mirror', rgb: [.999, .999, .999] },
+  { id: 7, name: 'glass', rgb: [.999, .999, .999] },
+];
+let colors = structuredClone(originals);
+let worker;
+let frameAvailable = false;
+let seed = 1;
+let lastSamples = 0;
+
+function updatePalette() {
+  for (const { name, rgb } of colors) {
+    const css = `rgb(${rgb.map((value) => Math.round(value * 255)).join(' ')})`;
+    $(`swatch-${name}`).style.setProperty('--swatch', css);
+    $(`swatch-${name}`).title = `${name}: ${css}`;
+  }
+}
+function setStatus(text, busy = false) {
+  $('status').textContent = text;
+  $('status-dot').classList.toggle('busy', busy);
+  $('stop').hidden = !busy;
+}
+function stopRendering() {
+  worker?.terminate();
+  worker = undefined;
+  setStatus(lastSamples ? 'Render paused' : 'Render stopped');
+}
+function startRender() {
+  worker?.terminate();
+  const width = Number($('resolution').value);
+  const height = width * 3 / 4;
+  const samples = Number($('samples').value);
+  lastSamples = 0;
+  $('sample-count').textContent = '0';
+  $('render-time').textContent = '0.0 s';
+  $('progress').style.width = '0%';
+  document.querySelector('.progress-track').setAttribute('aria-valuenow', '0');
+  setStatus('Starting renderer', true);
+  try {
+    worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.error) {
+        setStatus(`Render failed: ${data.error}`);
+        worker?.terminate();
+        return;
+      }
+      if (canvas.width !== data.width || canvas.height !== data.height) {
+        canvas.width = data.width;
+        canvas.height = data.height;
+      }
+      context.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+      $('render-stage').classList.add('has-frame');
+      frameAvailable = true;
+      lastSamples = data.samples;
+      $('sample-count').textContent = data.samples;
+      $('render-time').textContent = `${(data.elapsed / 1000).toFixed(1)} s`;
+      const progress = Math.round(data.samples / samples * 100);
+      $('progress').style.width = `${progress}%`;
+      document.querySelector('.progress-track').setAttribute('aria-valuenow', String(progress));
+      // Announce state transitions rather than every progressive pass.
+      if (data.done) {
+        setStatus('Render complete');
+        worker?.terminate();
+        worker = undefined;
+      } else if (data.samples === 4) {
+        setStatus('Tracing the light…', true);
+      }
+    };
+    worker.onerror = (event) => {
+      setStatus('Unable to load renderer. Please reload to retry.');
+      console.error('smallpt worker:', event.message);
+      worker?.terminate();
+    };
+    worker.postMessage({ width, height, samples, seed, colors });
+  } catch (error) {
+    setStatus('WebAssembly workers are unavailable in this browser.');
+    console.error(error);
+  }
+}
+function randomColor(sphere) {
+  // Saturated diffuse walls and gentler sphere tints retain useful light transport.
+  const hue = Math.random() * 6;
+  const channel = (offset) => {
+    const k = (hue + offset) % 6;
+    return 1 - .78 * Math.max(0, Math.min(k, 4 - k, 1));
+  };
+  const rgb = [channel(5), channel(3), channel(1)];
+  return rgb.map((value) => sphere ? .64 + value * .34 : .13 + value * .65);
+}
+$('randomize').addEventListener('click', () => {
+  colors = originals.map((entry) => ({ ...entry, rgb: randomColor(entry.id >= 6) }));
+  seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  updatePalette();
+  startRender();
+});
+$('reset').addEventListener('click', () => {
+  colors = structuredClone(originals);
+  seed = 1;
+  updatePalette();
+  startRender();
+});
+$('samples').addEventListener('change', startRender);
+$('resolution').addEventListener('change', startRender);
+$('stop').addEventListener('click', stopRendering);
+$('download').addEventListener('click', async () => {
+  // Before the first live frame, export the locally generated path-traced preview.
+  const output = frameAvailable ? canvas : document.createElement('canvas');
+  if (!frameAvailable) {
+    const preview = $('preview');
+    try { await preview.decode(); } catch { setStatus('Preview is still loading. Try again.'); return; }
+    output.width = preview.naturalWidth;
+    output.height = preview.naturalHeight;
+    output.getContext('2d').drawImage(preview, 0, 0);
+  }
+  output.toBlob((blob) => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${seed}-${frameAvailable ? lastSamples : 'preview'}spp.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+window.addEventListener('pagehide', () => worker?.terminate());
+updatePalette();
+if (!('WebAssembly' in window) || !('Worker' in window)) {
+  setStatus('This browser does not support WebAssembly workers.');
+  $('randomize').disabled = true;
+} else {
+  startRender();
+}
diff --git a/src/render-worker.js b/src/render-worker.js
new file mode 100644
index 0000000..a214fbb
--- /dev/null
+++ b/src/render-worker.js
@@ -0,0 +1,19 @@
+import createRenderer from '../assets/smallpt.js';
+self.onmessage = async ({ data }) => {
+  try {
+    const wasm = await createRenderer();
+    const { width, height, samples, seed, colors } = data;
+    wasm._init_scene(width, height, seed);
+    colors.forEach(({ id, rgb }) => wasm._set_color(id, ...rgb));
+    const start = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row += 12) {
+        wasm._render_rows(row, Math.min(12, height - row), pass);
+      }
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, wasm._pixel_buffer(), width * height * 4).slice();
+      self.postMessage({ pixels, width, height, samples: (pass + 1) * 4, elapsed: performance.now() - start, done: (pass + 1) * 4 >= samples }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || String(error) });
+  }
+};
diff --git a/src/renderer.cpp b/src/renderer.cpp
new file mode 100644
index 0000000..690fbaa
--- /dev/null
+++ b/src/renderer.cpp
@@ -0,0 +1,55 @@
+#include "smallpt-core.hpp"
+#include <vector>
+#include <cstdint>
+
+// Browser adapter: preserve smallpt's integrator and 2x2 tent-filtered sampling.
+static int width, height;
+static uint32_t sceneSeed;
+static std::vector<Vec> accumulation;
+static std::vector<unsigned char> pixels;
+extern "C" {
+void init_scene(int w, int h, uint32_t seed) {
+  width=w; height=h; sceneSeed=seed;
+  accumulation.assign(w*h*4, Vec());
+  pixels.assign(w*h*4, 255);
+  spheres[0].c=Vec(.75,.25,.25); spheres[1].c=Vec(.25,.25,.75);
+  spheres[6].c=Vec(.999,.999,.999); spheres[7].c=Vec(.999,.999,.999);
+}
+void set_color(int id, double r, double g, double b) {
+  if (id==0 || id==1 || id==6 || id==7) spheres[id].c=Vec(r,g,b);
+}
+unsigned char* pixel_buffer() { return pixels.data(); }
+void render_rows(int first, int count, int pass) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for(int y=first; y<first+count && y<height; ++y) {
+    uint32_t mix=sceneSeed ^ (uint32_t(y+1)*2654435761u) ^ (uint32_t(pass+1)*2246822519u);
+    unsigned short Xi[3]={static_cast<unsigned short>(mix),static_cast<unsigned short>(mix>>16),static_cast<unsigned short>(y*y*y+pass+1)};
+    for(int x=0; x<width; ++x) {
+      int i=(height-y-1)*width+x;
+      Vec color;
+      for(int sy=0;sy<2;++sy) for(int sx=0;sx<2;++sx) {
+        double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        Vec &sum=accumulation[i*4+sy*2+sx];
+        sum=sum+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec average=sum*(1./(pass+1));
+        color=color+Vec(clamp(average.x),clamp(average.y),clamp(average.z))*.25;
+      }
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y);
+      pixels[i*4+2]=toInt(color.z); pixels[i*4+3]=255;
+    }
+  }
+}
+}
+#ifdef NATIVE_PREVIEW
+int main() {
+  init_scene(640,480,1);
+  for(int p=0;p<64;++p) render_rows(0,480,p);
+  FILE *file=fopen("/tmp/smallpt-preview.ppm","wb");
+  fprintf(file,"P6\n640 480\n255\n");
+  for(int i=0;i<640*480;++i) fwrite(pixels.data()+i*4,1,3,file);
+  fclose(file);
+}
+#endif
diff --git a/src/smallpt-core.hpp b/src/smallpt-core.hpp
new file mode 100644
index 0000000..f446ac0
--- /dev/null
+++ b/src/smallpt-core.hpp
@@ -0,0 +1,75 @@
+// Original tracing core by Kevin Beason. See vendor/LICENSE.txt.
+#include <math.h>   // smallpt, a Path Tracer by Kevin Beason, 2008
+#include <stdlib.h> // Make : g++ -O3 -fopenmp smallpt.cpp -o smallpt
+#include <stdio.h>  //        Remove "-fopenmp" for g++ version < 4.2
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
