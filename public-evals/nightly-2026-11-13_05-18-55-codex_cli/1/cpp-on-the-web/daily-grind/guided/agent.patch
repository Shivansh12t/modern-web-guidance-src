+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+const bytes = await readFile(new URL('../assets/smallpt.wasm', import.meta.url));
+assert.equal(WebAssembly.validate(bytes), true);
+const originalFetch = globalThis.fetch;
+globalThis.fetch = async (url) => {
+  assert.equal(new URL(url).pathname.endsWith('/assets/smallpt.wasm'), true);
+  return new Response(bytes, { headers: { 'Content-Type': 'application/wasm' } });
+};
+try {
+  const { default: createRenderer } = await import('../assets/smallpt.js');
+  const wasm = await createRenderer();
+  const render = (tint) => {
+    wasm._init_scene(32, 24, 42);
+    if (tint) wasm._set_color(6, ...tint);
+    for (let pass = 0; pass < 4; pass++) wasm._render_rows(0, 24, pass);
+    return wasm.HEAPU8.slice(wasm._pixel_buffer(), wasm._pixel_buffer() + 32 * 24 * 4);
+  };
+  const original = render();
+  assert(original.some((value, index) => index % 4 !== 3 && value > 0));
+  assert(original.every((value, index) => index % 4 !== 3 || value === 255));
+  assert.deepEqual(render(), original, 'A fixed seed should be repeatable');
+  assert.notDeepEqual(render([.95, .65, .7]), original, 'Sphere tint should change the output');
+  console.log('Wasm smoke check passed: exports, rendering, RGBA buffer, fixed seeds, sphere tint.');
+} finally {
+  globalThis.fetch = originalFetch;
+}
