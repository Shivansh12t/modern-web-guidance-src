--- /dev/null
+++ b/scripts/check-wasm.cjs
@@ -0,0 +1,17 @@
+const assert = require('node:assert/strict');
+const createSmallpt = require('../public/smallpt.js');
+(async()=>{
+ const m=await createSmallpt();
+ function render(color){
+  m._init(64,48,42);m._set_color(0,...color);
+  for(let i=0;i<4;i++){m._render_rows(0,48);m._finish_pass()}
+  return m.HEAPU8.slice(m._buffer(),m._buffer()+64*48*4);
+ }
+ const original=render([.75,.25,.25]);
+ const changed=render([.25,.75,.25]);
+ assert.equal(original.length,64*48*4);
+ assert.ok(original.some((v,i)=>i%4!==3&&v>0),'Rendered image must contain light');
+ assert.ok(original.every((v,i)=>i%4!==3||v===255),'Every pixel must be opaque');
+ assert.notDeepEqual(original,changed,'Sphere colors must change rendered output');
+ console.log('WebAssembly checks passed: RGBA output, illumination, and randomized-color support.');
+})().catch(e=>{console.error(e);process.exitCode=1});
