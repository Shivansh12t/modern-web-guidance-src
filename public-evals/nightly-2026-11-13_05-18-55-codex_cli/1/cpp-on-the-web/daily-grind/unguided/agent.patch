+#!/usr/bin/env bash
+set -euo pipefail
+emcc src/smallpt.cpp -O3 --no-entry -s WASM=1 -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=worker,node -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s ALLOW_MEMORY_GROWTH=1 -s EXPORTED_FUNCTIONS='["_init","_set_color","_buffer","_render_rows","_finish_pass"]' -o public/smallpt.js
diff --git a/scripts/check-wasm.cjs b/scripts/check-wasm.cjs
new file mode 100644
