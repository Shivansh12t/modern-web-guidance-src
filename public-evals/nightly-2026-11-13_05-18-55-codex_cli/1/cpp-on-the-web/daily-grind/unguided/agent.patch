diff --git a/public/worker.js b/public/worker.js
new file mode 100644
index 0000000..f58e1b0
--- /dev/null
+++ b/public/worker.js
@@ -0,0 +1,33 @@
+importScripts('smallpt.js');
+const ready = createSmallpt();
+let generation = 0;
+self.onmessage = async ({data}) => {
+  const current = ++generation;
+  try {
+    const m = await ready;
+    if(current !== generation) return;
+    const {width, height, target, seed, colors, id} = data;
+    m._init(width,height,seed);
+    colors.forEach(({index,rgb})=>m._set_color(index,...rgb));
+    let pass=0, row=0;
+    const started=performance.now();
+    function step() {
+      if(current!==generation) return;
+      try {
+        const end=performance.now()+65;
+        do {
+          m._render_rows(row,4);
+          row+=4;
+          if(row>=height) {
+            row=0;pass++;m._finish_pass();
+            const pixels=m.HEAPU8.slice(m._buffer(),m._buffer()+width*height*4);
+            self.postMessage({id,pixels,spp:pass*4,progress:pass*4/target,elapsed:performance.now()-started,done:pass*4>=target},[pixels.buffer]);
+            if(pass*4>=target) return;
+          }
+        } while(performance.now()<end);
+        setTimeout(step,0);
+      } catch(error) { self.postMessage({id,error:error.message}); }
+    }
+    step();
+  } catch(error) { self.postMessage({id:data.id,error:error.message}); }
+};
