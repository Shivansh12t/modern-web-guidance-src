+const $=id=>document.getElementById(id);
+const canvas=$('render'), ctx=canvas.getContext('2d');
+const inputs=['left-color','right-color','mirror-color','glass-color'].map($);
+const original=['#bf4040','#4040bf','#ffffff','#ffffff'];
+const ids=[0,1,6,7];
+const preview=new Image();
+let hasFrame=false, runId=0, worker;
+preview.onload=()=>{if(!hasFrame)ctx.drawImage(preview,0,0,640,480)};
+preview.src='public/preview.png';
+function fail(message){$('status').textContent='Render unavailable';$('time').textContent=message;$('status-dot').style.background='#b77955'}
+function render(){
+  if(!worker)return;
+  const colors=inputs.map((input,i)=>({index:ids[i],rgb:[1,3,5].map(p=>parseInt(input.value.slice(p,p+2),16)/255*(i>1?.999:1))}));
+  $('status').textContent='Tracing light…';$('status-dot').style.background='';$('time').textContent='Starting a new render';$('progress').style.width='0%';$('toolbar-spp').textContent='0 SPP';
+  worker.postMessage({id:++runId,width:640,height:480,target:Number($('quality').value),seed:crypto.getRandomValues(new Uint32Array(1))[0],colors});
+}
+try{
+  worker=new Worker('public/worker.js');
+  worker.onmessage=({data})=>{
+    if(data.id!==runId)return;
+    if(data.error){fail(data.error);return}
+    hasFrame=true;
+    ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels),640,480),0,0);
+    $('toolbar-spp').textContent=`${data.spp} SPP`;
+    $('progress').style.width=`${Math.min(100,data.progress*100)}%`;
+    $('status').textContent=data.done?'Render complete':'Tracing light…';
+    $('time').textContent=`${(data.elapsed/1000).toFixed(1)}s${data.done?' · All light accounted for':` · ${Math.round(data.progress*100)}%`}`;
+  };
+  worker.onerror=()=>fail('Unable to load WebAssembly. Reload to retry.');
+  render();
+}catch(error){fail(error.message)}
+function hsl(h,s,l){s/=100;l/=100;const a=s*Math.min(l,1-l);const f=n=>{const k=(n+h/30)%12;return Math.round(255*(l-a*Math.max(-1,Math.min(k-3,9-k,1)))).toString(16).padStart(2,'0')};return `#${f(0)}${f(8)}${f(4)}`}
+$('randomize').onclick=()=>{
+ const h=Math.random()*360;
+ inputs[0].value=hsl(h,45+Math.random()*25,55);
+ inputs[1].value=hsl((h+100+Math.random()*100)%360,50,57);
+ inputs[2].value=hsl((h+30)%360,25,85);
+ inputs[3].value=hsl((h+200)%360,22,88);
+ $('palette-name').textContent='A fresh perspective';render();
+};
+inputs.forEach(input=>input.addEventListener('change',()=>{$('palette-name').textContent='Your palette';render()}));
+$('quality').onchange=render;
+$('reset').onclick=()=>{inputs.forEach((input,i)=>input.value=original[i]);$('palette-name').textContent='The original';render()};
+$('download').onclick=()=>{canvas.toBlob(blob=>{if(!blob)return;const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`smallpt-${Date.now()}.png`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)},'image/png')};
+$('expand').onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await canvas.parentElement.requestFullscreen()}catch{ $('time').textContent='Fullscreen is unavailable in this browser' }};
+$('about-button').onclick=()=>$('about').showModal();
+$('close-about').onclick=()=>$('about').close();
+$('about').addEventListener('click',event=>{if(event.target===$('about')){const r=$('about').getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)$('about').close()}});
