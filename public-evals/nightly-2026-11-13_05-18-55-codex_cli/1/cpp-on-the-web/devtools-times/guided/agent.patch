+const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = el<HTMLCanvasElement>('render');
+const ctx = canvas.getContext('2d');
+const base = el('playground').dataset.base!;
+const quality = el<HTMLSelectElement>('quality');
+const resolution = el<HTMLSelectElement>('resolution');
+const defaults = ['#c7a8ef', '#a8ebc7'];
+let colors = [...defaults];
+let worker: Worker | undefined;
+let renderId = 0;
+let hasFrame = false;
+const status = el('status');
+const dot = el('status-dot');
+function updateColors() {
+  colors.forEach((color, i) => {
+    el<HTMLInputElement>(`color-${i}`).value = color;
+    el(`hex-${i}`).textContent = color.toUpperCase();
+    el(`orb-${i}`).style.background = `radial-gradient(circle at 32% 25%, #ffffff 0%, ${color} 45%, ${color} 100%)`;
+  });
+}
+function showError(message: string) {
+  status.textContent = message;
+  dot.className = 'status-dot error';
+  el('rerender').textContent = 'Try rendering again';
+}
+function startRender() {
+  if (!ctx || typeof WebAssembly === 'undefined' || typeof Worker === 'undefined') {
+    showError('This browser needs WebAssembly and Web Workers.');
+    return;
+  }
+  try {
+    if (!worker) {
+      worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+      worker.onerror = () => { worker?.terminate(); worker = undefined; showError('Renderer could not load. Try rendering again.'); };
+      worker.onmessage = ({ data }) => {
+        if (data.id !== renderId) return;
+        if (data.error) { console.error(data.error); worker?.terminate(); worker = undefined; showError('Render failed. Try rendering again.'); return; }
+        if (canvas.width !== data.width || canvas.height !== data.height) { canvas.width = data.width; canvas.height = data.height; }
+        ctx.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+        canvas.classList.add('has-render');
+        hasFrame = true;
+        el<HTMLButtonElement>('download').disabled = false;
+        el('progress').style.width = `${data.progress * 100}%`;
+        el('stat-time').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+        el('stat-samples').textContent = `${Math.floor(data.progress * Number(quality.value))}`;
+        if (data.done) {
+          status.textContent = 'Render complete';
+          dot.className = 'status-dot';
+        } else { status.textContent = `Tracing light · ${Math.round(data.progress * 100)}%`; }
+      };
+    }
+    const width = Number(resolution.value), height = width * 3 / 4;
+    const samples = Number(quality.value);
+    el('stat-target').textContent = `${samples}`;
+    el('stat-samples').textContent = '0';
+    el('stat-time').textContent = '0.0s';
+    el('stat-size').textContent = `${width} × ${height}`;
+    el('progress').style.width = '0%';
+    dot.className = 'status-dot running';
+    status.textContent = 'Tracing light…';
+    const rgb = colors.map(color => [1, 3, 5].map(offset => parseInt(color.slice(offset, offset + 2), 16) / 255));
