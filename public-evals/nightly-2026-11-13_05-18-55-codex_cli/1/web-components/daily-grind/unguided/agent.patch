@@ -0,0 +1,185 @@
+// Components inherit the site's public theme tokens; all other styles stay local.
+const baseStyles = `
+  :host { display: block; font-family: inherit; color: inherit; line-height: 1.6; }
+  *, *::before, *::after { box-sizing: border-box; }
+  h1, h3, p { margin: 0; }
+  [hidden] { display: none !important; }
+  a { color: inherit; }
+  a:focus-visible, button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40); outline-offset: 4px;
+  }
+  .btn {
+    display: inline-block; background: var(--primary, #4e342e); color: white;
+    padding: 10px 20px; text-decoration: none; border-radius: 5px;
+    margin-top: 15px; transition: background 0.3s;
+  }
+  .btn:hover { background: #3e2723; }
+  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
+`;
+
+function template(styles, markup) {
+  const element = document.createElement('template');
+  element.innerHTML = `<style>${baseStyles}${styles}</style>${markup}`;
+  return element;
+}
+
+class GrindElement extends HTMLElement {
+  constructor(content) {
+    super();
+    this.attachShadow({ mode: 'open' }).append(content.content.cloneNode(true));
+  }
+}
+
+const cardTemplate = template(`
+  :host { height: 100%; }
+  article {
+    height: 100%; background: white; padding: 20px; border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 10%); text-align: center;
+    display: flex; flex-direction: column; align-items: center;
+  }
+  h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+  p { flex: 1; }
+`, `<article aria-labelledby="name">
+  <h3 id="name"></h3>
+  <p></p>
+  <a class="btn">View Details</a>
+</article>`);
+
+export class CoffeeCard extends GrindElement {
+  static observedAttributes = ['name', 'description', 'href'];
+
+  constructor() { super(cardTemplate); }
+
+  connectedCallback() { this.update(); }
+  attributeChangedCallback() { this.update(); }
+
+  update() {
+    const name = this.getAttribute('name') || 'Coffee';
+    this.shadowRoot.querySelector('h3').textContent = name;
+    this.shadowRoot.querySelector('p').textContent = this.getAttribute('description') || '';
+    const link = this.shadowRoot.querySelector('a');
+    // Accept relative and web URLs, and reject executable URL schemes.
+    const href = this.getAttribute('href');
+    let url;
+    try { url = new URL(href || '', document.baseURI); } catch { /* Invalid link. */ }
+    if (href && url && ['http:', 'https:'].includes(url.protocol)) {
+      link.setAttribute('href', href);
+      link.hidden = false;
+    } else {
+      link.removeAttribute('href');
+      link.hidden = true;
+    }
+    link.setAttribute('aria-label', `View Details: ${name}`);
+  }
+}
+
+const heroTemplate = template(`
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80') center / cover;
+    display: flex; flex-direction: column; justify-content: center;
+    align-items: center; color: white; text-align: center; padding: 40px 20px;
+  }
+  ::slotted(h1) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; line-height: 1.2; }
+  ::slotted(p) { margin: 0; }
+  ::slotted(a) {
+    display: inline-block; background: var(--primary, #4e342e); color: white;
+    padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 15px;
+  }
+  ::slotted(a:hover) { background: #3e2723; }
+`, `<header><slot name="heading"></slot><slot></slot><slot name="action"></slot></header>`);
+
+export class CoffeeHero extends GrindElement {
+  constructor() { super(heroTemplate); }
+}
+
+const navTemplate = template(`
+  :host { position: sticky; top: 0; z-index: 1000; }
+  nav {
+    background: var(--primary, #4e342e); color: white; padding: 1rem 5%;
+    display: flex; justify-content: space-between; align-items: center; gap: 20px;
+  }
+  .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  .links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+  ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted(.logout-link) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+  button {
+    font: inherit; background: transparent; color: white; border: 1px solid var(--accent, #ffab40);
+    border-radius: 4px; padding: 5px 12px; cursor: pointer;
+  }
+  [hidden] { display: none !important; }
+  @media (max-width: 700px) {
+    nav { flex-wrap: wrap; }
+    .links { width: 100%; flex-direction: column; align-items: stretch; gap: 16px; }
+    .logo { font-size: 1.2rem; }
+  }
+`, `<nav aria-label="Main navigation">
+  <span class="logo"><slot name="brand">THE DAILY GRIND</slot></span>
+  <button type="button" aria-expanded="false" aria-controls="links" hidden>Menu</button>
+  <div class="links" id="links"><slot></slot></div>
+</nav>`);
+
+export class GrindNavigation extends GrindElement {
+  constructor() { super(navTemplate); }
+
+  connectedCallback() {
+    this.controller?.abort();
+    this.controller = new AbortController();
+    const { signal } = this.controller;
+    const button = this.shadowRoot.querySelector('button');
+    const links = this.shadowRoot.querySelector('.links');
+    const narrow = window.matchMedia('(max-width: 700px)');
+    const setOpen = (open) => {
+      button.setAttribute('aria-expanded', String(open));
+      links.hidden = narrow.matches && !open;
+    };
+    const reset = () => {
+      // Keep focus available when a resize hides a link or the menu button.
+      if (narrow.matches) button.hidden = false;
+      if (narrow.matches && this.contains(document.activeElement)) button.focus();
+      if (!narrow.matches && this.shadowRoot.activeElement === button) {
+        this.querySelector('a')?.focus();
+      }
+      button.hidden = !narrow.matches;
+      setOpen(false);
+    };
+    button.addEventListener('click', () => {
+      setOpen(button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && narrow.matches && button.getAttribute('aria-expanded') === 'true') {
+        setOpen(false);
+        button.focus();
+      }
+    }, { signal });
+    this.addEventListener('click', (event) => {
+      if (narrow.matches && event.composedPath().some((node) => node instanceof HTMLAnchorElement)) {
+        setOpen(false);
+        button.focus();
+      }
+    }, { signal });
+    narrow.addEventListener('change', reset, { signal });
+    reset();
+  }
+
+  disconnectedCallback() { this.controller?.abort(); }
+}
+
+const footerTemplate = template(`
+  footer { background: var(--secondary, #d7ccc8); text-align: center; padding: 40px 20px; }
+  nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 20px; }
+  ::slotted(a) { color: var(--text, #3e2723); text-decoration: none; font-size: 0.85rem; }
+  ::slotted(a:hover) { text-decoration: underline; }
+  ::slotted(p) { margin: 0; }
+`, `<footer><nav aria-label="Footer navigation"><slot name="link"></slot></nav><slot></slot></footer>`);
+
+export class GrindFooter extends GrindElement {
+  constructor() { super(footerTemplate); }
+}
+
+customElements.define('coffee-card', CoffeeCard);
+customElements.define('coffee-hero', CoffeeHero);
+customElements.define('grind-navigation', GrindNavigation);
+customElements.define('grind-footer', GrindFooter);
