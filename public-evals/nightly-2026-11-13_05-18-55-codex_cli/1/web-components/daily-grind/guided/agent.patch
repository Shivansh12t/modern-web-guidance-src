index 0000000..1fc28bc
--- /dev/null
+++ b/components/grind-navigation.js
@@ -0,0 +1,116 @@
+import { createTemplate, baseStyles } from './shared.js';
+
+const template = createTemplate(`
+  <nav aria-label="Main navigation" part="navigation">
+    <div class="brand"><slot name="brand"></slot></div>
+    <button type="button" aria-expanded="false" aria-controls="links" part="toggle">Menu</button>
+    <div id="links"><slot></slot></div>
+  </nav>
+`, `${baseStyles}
+  :host { position: sticky; top: 0; z-index: 1000; }
+  nav {
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 1rem 5%;
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 1rem;
+  }
+  .brand { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  #links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+  #links[hidden] { display: none; }
+  ::slotted(a) { color: white; text-decoration: none; font-size: .9rem; padding: 8px 0; }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted(a[slot="brand"]) { font-size: inherit; }
+  ::slotted(a[data-logout]) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+  button {
+    display: none;
+    background: transparent;
+    color: inherit;
+    font: inherit;
+    border: 1px solid var(--accent, #ffab40);
+    border-radius: 4px;
+    padding: 8px 12px;
+    cursor: pointer;
+  }
+  button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+  @media (max-width: 640px) {
+    button { display: block; }
+    #links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 4px; }
+  }
+`);
+
+export class GrindNavigation extends HTMLElement {
+  #toggle;
+  #links;
+  #viewport;
+  #expanded = false;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true }).append(template.content.cloneNode(true));
+    this.#toggle = this.shadowRoot.querySelector('button');
+    this.#links = this.shadowRoot.getElementById('links');
+  }
+
+  connectedCallback() {
+    this.#viewport = window.matchMedia('(max-width: 640px)');
+    this.#toggle.addEventListener('click', this.#toggleMenu);
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('click', this.#onNavigate);
+    this.#viewport.addEventListener('change', this.#syncViewport);
+    this.#syncViewport();
+  }
+
+  disconnectedCallback() {
+    this.#toggle.removeEventListener('click', this.#toggleMenu);
+    this.removeEventListener('keydown', this.#onKeydown);
+    this.removeEventListener('click', this.#onNavigate);
+    this.#viewport.removeEventListener('change', this.#syncViewport);
+  }
+
+  #render() {
+    this.#toggle.setAttribute('aria-expanded', String(this.#expanded));
+    this.#links.hidden = this.#viewport.matches && !this.#expanded;
+  }
+
+  #syncViewport = () => {
+    // If a resize would hide the focused link/control, move focus to its visible replacement.
+    const active = this.shadowRoot.activeElement || document.activeElement;
+    const focusedLink = active instanceof Element && this.contains(active) && active.matches('a:not([slot="brand"])');
+    this.#expanded = false;
+    this.#render();
+    if (this.#viewport.matches && focusedLink) this.#toggle.focus();
+    if (!this.#viewport.matches && active === this.#toggle) this.querySelector('a:not([slot])')?.focus();
+  };
+
+  #toggleMenu = () => {
+    this.#expanded = !this.#expanded;
+    this.#render();
+  };
+
+  #onKeydown = (event) => {
+    if (event.key === 'Escape' && this.#viewport.matches && this.#expanded) {
+      event.preventDefault();
+      this.#expanded = false;
+      this.#render();
+      this.#toggle.focus();
+    }
+  };
+
+  #onNavigate = (event) => {
+    const link = event.composedPath().find(node => node instanceof HTMLAnchorElement);
+    if (link && link.slot !== 'brand' && this.#viewport.matches && this.#expanded) {
+      this.#expanded = false;
+      this.#render();
+      this.#toggle.focus();
+    }
+  };
+}
+
+if (!customElements.get('grind-navigation')) customElements.define('grind-navigation', GrindNavigation);
