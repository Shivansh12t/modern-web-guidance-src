diff --git a/tests/components.test.js b/tests/components.test.js
new file mode 100644
index 0000000..035b0b1
--- /dev/null
+++ b/tests/components.test.js
@@ -0,0 +1,116 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+
+const window = new Window({ url: 'https://daily-grind.example' });
+for (const name of ['window', 'document', 'HTMLElement', 'HTMLAnchorElement', 'Element', 'customElements']) {
+  globalThis[name] = name === 'window' ? window : window[name];
+}
+
+const viewport = new window.EventTarget();
+viewport.matches = false;
+window.matchMedia = () => viewport;
+await import('../components/index.js');
+const page = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+
+function mountPage(mobile = false) {
+  // Disconnect the previous instance before changing the shared viewport.
+  document.body.replaceChildren();
+  viewport.matches = mobile;
+  document.body.innerHTML = page.match(/<body>([\s\S]*)<\/body>/)[1];
+}
+
+function resize(mobile) {
+  viewport.matches = mobile;
+  viewport.dispatchEvent(new window.Event('change'));
+}
+
+function navigation() {
+  const host = document.querySelector('grind-navigation');
+  return { host, button: host.shadowRoot.querySelector('button'), links: host.shadowRoot.getElementById('links') };
+}
+
+test('cards use independent shadow roots and preserve content, slots, and native links', () => {
+  mountPage();
+  const cards = [...document.querySelectorAll('coffee-card')];
+  assert.equal(cards.length, 3);
+  assert.notEqual(cards[0].shadowRoot, cards[1].shadowRoot);
+  for (const card of cards) {
+    assert.ok(card.shadowRoot.querySelector('article'));
+    assert.ok(card.shadowRoot.querySelector('style'));
+    assert.equal(card.hasAttribute('tabindex'), false);
+    const title = card.querySelector('h3');
+    assert.equal(card.shadowRoot.querySelector('slot[name="heading"]').assignedElements()[0], title);
+    const link = card.querySelector('a');
+    assert.ok(link.getAttribute('aria-label').includes(title.textContent));
+    assert.match(link.getAttribute('href'), /^\/menu\//);
+  }
+  cards[0].querySelector('h3').textContent = 'New seasonal coffee';
+  assert.equal(cards[0].shadowRoot.querySelector('slot[name="heading"]').assignedElements()[0].textContent, 'New seasonal coffee');
+  assert.equal(cards[1].querySelector('h3').textContent, 'Dark Roast Espresso');
+  assert.ok(document.querySelector('coffee-hero').shadowRoot.querySelector('header'));
+  assert.equal(document.querySelector('h1').textContent, 'Wake Up Your Senses');
+});
+
+test('mobile disclosure synchronizes visibility and ARIA, and Escape restores focus', () => {
+  mountPage(true);
+  const { host, button, links } = navigation();
+  assert.equal(links.hidden, true);
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  assert.equal(button.getRootNode().getElementById(button.getAttribute('aria-controls')), links);
+  button.click();
+  assert.equal(links.hidden, false);
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
+  host.querySelector('a').focus();
+  host.querySelector('a').dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true, composed: true }));
+  assert.equal(links.hidden, true);
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  assert.equal(host.shadowRoot.activeElement, button);
+});
+
+test('resizing keeps desktop links available and moves focus out of hidden content', () => {
+  mountPage(true);
+  const { host, button, links } = navigation();
+  button.focus();
+  resize(false);
+  assert.equal(links.hidden, false);
+  assert.equal(document.activeElement, host.querySelector('a'));
+  resize(true);
+  assert.equal(links.hidden, true);
+  assert.equal(host.shadowRoot.activeElement, button);
+});
+
+test('navigation can disconnect and reconnect without duplicate toggle listeners', () => {
+  mountPage(true);
+  const { host, button, links } = navigation();
+  host.remove();
+  document.body.prepend(host);
+  button.click();
+  assert.equal(links.hidden, false);
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
