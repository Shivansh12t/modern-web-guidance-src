+// Only trusted, static component markup is parsed here. Consumer content uses slots.
+export function createTemplate(markup, styles) {
+  const template = document.createElement('template');
+  template.innerHTML = `<style>${styles}</style>${markup}`;
+  return template;
+}
+
+export const baseStyles = `
+  :host { display: block; }
+  :host([hidden]) { display: none; }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+`;
+
+export const actionStyles = `
+  ::slotted(a[slot="action"]) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+  ::slotted(a[slot="action"]:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+`;
