+import { createTemplate, baseStyles, actionStyles } from './shared.js';
+
+const template = createTemplate(`
+  <article part="card">
+    <slot name="heading"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </article>
+`, `${baseStyles}
+  :host { height: 100%; }
+  article {
+    height: 100%;
+    background: var(--card-background, white);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+    text-align: center;
+  }
+  ::slotted([slot="heading"]) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+  ::slotted([slot="description"]) { margin: 0; }
+  ${actionStyles}
+`);
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true }).append(template.content.cloneNode(true));
+  }
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
