+  <script>
+    const menubar = document.querySelector('.app-menu');
+    const triggers = [...menubar.querySelectorAll('.menu-trigger')];
+    const menuFor = trigger => document.getElementById(trigger.getAttribute('aria-controls'));
+    const itemsFor = trigger => [...menuFor(trigger).querySelectorAll('[role="menuitem"]')];
+
+    function closeMenus() {
+      triggers.forEach(trigger => {
+        trigger.setAttribute('aria-expanded', 'false');
+        menuFor(trigger).hidden = true;
+      });
+    }
+
+    function selectTrigger(trigger) {
+      triggers.forEach(item => { item.tabIndex = item === trigger ? 0 : -1; });
+      trigger.focus();
+    }
+
+    function openMenu(trigger, position = 0) {
+      closeMenus();
+      selectTrigger(trigger);
+      trigger.setAttribute('aria-expanded', 'true');
+      menuFor(trigger).hidden = false;
+      const items = itemsFor(trigger);
+      items[position < 0 ? items.length - 1 : position].focus();
+    }
+
+    triggers.forEach((trigger, index) => {
+      trigger.addEventListener('click', () => {
+        const wasOpen = trigger.getAttribute('aria-expanded') === 'true';
+        closeMenus();
+        selectTrigger(trigger);
+        if (!wasOpen) openMenu(trigger);
+      });
+
+      trigger.parentElement.addEventListener('keydown', event => {
+        const inSubmenu = event.target !== trigger;
+        const items = itemsFor(trigger);
+        const current = items.indexOf(event.target);
+        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+          event.preventDefault();
+          const next = triggers[(index + (event.key === 'ArrowRight' ? 1 : -1) + triggers.length) % triggers.length];
+          closeMenus();
+          if (inSubmenu) openMenu(next);
+          else selectTrigger(next);
+        } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+          event.preventDefault();
+          const direction = event.key === 'ArrowDown' ? 1 : -1;
+          if (!inSubmenu) openMenu(trigger, direction === 1 ? 0 : -1);
+          else items[(current + direction + items.length) % items.length].focus();
+        } else if (event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          const last = event.key === 'End';
+          if (inSubmenu) items[last ? items.length - 1 : 0].focus();
+          else { closeMenus(); selectTrigger(triggers[last ? triggers.length - 1 : 0]); }
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          closeMenus();
+          selectTrigger(trigger);
+        } else if (event.key === 'Tab') {
+          // Return focus to the trigger so Tab leaves the menubar naturally.
+          if (inSubmenu) selectTrigger(trigger);
+          closeMenus();
+        } else if (inSubmenu && event.key === ' ') {
+          event.preventDefault();
+          event.target.click();
+        }
+      });
+    });
+
+    document.addEventListener('click', event => {
+      if (!menubar.contains(event.target) || event.target.closest('.submenu a')) closeMenus();
+    });
+    menubar.addEventListener('focusout', event => {
+      if (!menubar.contains(event.relatedTarget)) closeMenus();
+    });
+  </script>
