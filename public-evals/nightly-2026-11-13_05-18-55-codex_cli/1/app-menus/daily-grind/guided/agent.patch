+  <script>
+    (() => {
+      const bar = document.querySelector('[role="menubar"]');
+      const triggers = [...bar.querySelectorAll('.menu-trigger')];
+      const menus = triggers.map(trigger => document.getElementById(trigger.getAttribute('commandfor')));
+      const nativePopover = Object.hasOwn(HTMLElement.prototype, 'popover');
+      const nativeInvoker = 'commandForElement' in HTMLButtonElement.prototype;
+      const nativeFocusgroup = 'focusGroup' in HTMLElement.prototype;
+      const anchored = CSS.supports('position-area: block-end');
+      let suppressPreview = false;
+      let returningToWindow = false;
+
+      const isOpen = menu => nativePopover ? menu.matches(':popover-open') : menu.hasAttribute('data-open');
+      const itemsFor = menu => [...menu.querySelectorAll('a[href]')];
+
+      function positionMenu(menu, trigger) {
+        if (nativePopover && anchored) return;
+        const rect = trigger.getBoundingClientRect();
+        const gutter = 8;
+        const left = Math.max(gutter, Math.min(rect.left, innerWidth - menu.offsetWidth - gutter));
+        const below = rect.bottom;
+        const top = below + menu.offsetHeight <= innerHeight - gutter
+          ? below : Math.max(gutter, rect.top - menu.offsetHeight);
+        menu.style.setProperty('--menu-left', `${left}px`);
+        menu.style.setProperty('--menu-top', `${top}px`);
+      }
+
+      function hide(menu) {
+        if (!isOpen(menu)) return;
+        if (nativePopover) menu.hidePopover();
+        else {
+          menu.removeAttribute('data-open');
+          triggers[menus.indexOf(menu)].setAttribute('aria-expanded', 'false');
+        }
+      }
+
+      function closeAll() {
+        const previous = suppressPreview;
+        suppressPreview = true;
+        menus.forEach(hide);
+        suppressPreview = previous;
+      }
+
+      function show(menu, trigger) {
+        if (isOpen(menu)) return;
+        closeAll();
+        if (nativePopover) menu.showPopover({ source: trigger });
+        else {
+          menu.setAttribute('data-open', '');
+          trigger.setAttribute('aria-expanded', 'true');
+        }
+        positionMenu(menu, trigger);
+      }
+
+      function restore(trigger, fromPointer = false) {
+        suppressPreview = true;
+        trigger.focus({ focusVisible: !fromPointer });
+        closeAll();
+        suppressPreview = false;
+      }
+
+      function moveTo(trigger, direction) {
+        const next = triggers[(triggers.indexOf(trigger) + direction + triggers.length) % triggers.length];
+        closeAll();
+        triggers.forEach(item => { item.tabIndex = item === next ? 0 : -1; });
+        next.focus();
+      }
+
+      triggers.forEach((trigger, index) => {
+        const menu = menus[index];
+        const group = menu.firstElementChild;
+        const items = itemsFor(menu);
+
+        if (!nativePopover) menu.setAttribute('data-fallback', '');
+        // Older Popover implementations do not create an implicit source anchor.
+        if (nativePopover && anchored && !('source' in ToggleEvent.prototype)) {
+          trigger.style.setProperty('anchor-name', `--${trigger.id}`);
+          menu.style.setProperty('position-anchor', `--${trigger.id}`);
+        }
+        if (!nativeFocusgroup) {
+          group.setAttribute('role', 'menu');
+          items.forEach(item => item.setAttribute('role', 'menuitem'));
+        }
+
+        trigger.addEventListener('focus', event => {
+          if (!suppressPreview && !returningToWindow && !menu.contains(event.relatedTarget)) show(menu, trigger);
+        });
+        trigger.addEventListener('blur', event => {
+          if (!menu.contains(event.relatedTarget)) hide(menu);
+        });
+        // Keep pointer focus from opening a preview before the click can toggle it.
+        trigger.addEventListener('pointerdown', event => event.preventDefault());
+        trigger.addEventListener('pointerenter', event => {
+          if (event.pointerType === 'touch' || !menus.some(isOpen) || isOpen(menu)) return;
+          closeAll();
+          suppressPreview = true;
+          trigger.focus({ focusVisible: false });
+          suppressPreview = false;
+          show(menu, trigger);
+        });
+        trigger.addEventListener('click', event => {
+          if (!nativeInvoker || !nativePopover) {
+            event.preventDefault();
+            if (isOpen(menu)) restore(trigger, event.detail > 0);
+            else {
+              suppressPreview = true;
+              trigger.focus({ focusVisible: event.detail === 0 });
+              suppressPreview = false;
+              show(menu, trigger);
+            }
+          } else if (!isOpen(menu)) {
+            suppressPreview = true;
+            trigger.focus({ focusVisible: event.detail === 0 });
+            suppressPreview = false;
+          }
+        });
+        menu.addEventListener('toggle', () => {
+          trigger.setAttribute('aria-expanded', String(isOpen(menu)));
+          if (isOpen(menu)) positionMenu(menu, trigger);
+        });
+
+        trigger.addEventListener('keydown', event => {
+          if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+            event.preventDefault();
+            moveTo(trigger, event.key === 'ArrowLeft' ? -1 : 1);
+          } else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+            event.preventDefault();
+            show(menu, trigger);
+            (event.key === 'End' || event.key === 'ArrowUp' ? items.at(-1) : items[0]).focus();
+          }
+        });
+        menu.addEventListener('keydown', event => {
+          if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+            event.preventDefault();
+            moveTo(trigger, event.key === 'ArrowLeft' ? -1 : 1);
+          } else if (!nativeFocusgroup && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+            event.preventDefault();
+            const current = items.indexOf(document.activeElement);
+            const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1
+              : (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+            items[next].focus();
+          } else if (event.key === ' ' && items.includes(event.target)) {
+            event.preventDefault();
+            event.target.click();
+          }
+        });
+        items.forEach(item => {
+          item.addEventListener('pointermove', event => {
+            if (event.pointerType !== 'touch') item.focus({ focusVisible: false });
+          });
+          item.addEventListener('click', event => restore(trigger, event.detail > 0));
+        });
+      });
+
+      bar.addEventListener('keydown', event => {
+        const index = menus.findIndex(menu => menu.contains(event.target));
+        const trigger = index >= 0 ? triggers[index] : event.target.closest('.menu-trigger');
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (trigger) restore(trigger);
+        } else if (event.key === 'Tab') {
+          // Return to the bar's single stop, then let Tab leave in either direction.
+          if (trigger) {
+            triggers.forEach(item => { item.tabIndex = item === trigger ? 0 : -1; });
+            restore(trigger);
+          }
+        }
+      });
+      document.addEventListener('focusin', event => {
+        if (!bar.contains(event.target)) closeAll();
+      });
+      document.addEventListener('pointerdown', event => {
+        if (!bar.contains(event.target)) closeAll();
+      });
+      window.addEventListener('blur', () => {
+        returningToWindow = true;
+        closeAll();
+      });
+      window.addEventListener('focus', () => {
+        setTimeout(() => { returningToWindow = false; }, 0);
+      });
+      const reposition = () => menus.forEach((menu, index) => {
+        if (isOpen(menu)) positionMenu(menu, triggers[index]);
+      });
+      window.addEventListener('resize', reposition);
+      document.addEventListener('scroll', reposition, true);
+    })();
+  </script>
+
 </body>
 
