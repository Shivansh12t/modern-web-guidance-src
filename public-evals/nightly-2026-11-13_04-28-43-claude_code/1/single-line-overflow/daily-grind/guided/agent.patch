+  <script>
+    // Fallback for browsers without scroll-driven animations / style queries:
+    // flag truncated labels so the hint and hover/focus reveal still apply.
+    (() => {
+      const observer = new ResizeObserver(entries => {
+        for (const { target } of entries) {
+          target.classList.toggle('truncated', target.scrollWidth > target.clientWidth);
+        }
+      });
+      for (const el of document.querySelectorAll('.truncate')) observer.observe(el);
+    })();
+  </script>
