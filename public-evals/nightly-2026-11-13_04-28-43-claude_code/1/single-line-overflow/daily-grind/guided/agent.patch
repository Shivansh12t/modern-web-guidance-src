+    /* Single-line truncation: the full text stays in the DOM (accessible name,
+       find-in-page, copy); only its rendering is clipped with an ellipsis. */
+    @property --truncated {
+      syntax: "<integer>";
+      inherits: false;
+      initial-value: 0;
+    }
+
+    .truncate {
+      display: block;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+      /* Keep at least a character plus the ellipsis visible */
+      min-inline-size: 2.5em;
+      /* Scroll timeline is only active while the text overflows -> sets the flag */
+      animation: truncated linear both;
+      animation-timeline: scroll(self inline);
+    }
+
+    @keyframes truncated {
+      from, to {
+        --truncated: 1;
+      }
+    }
+
+    /* Script fallback (ResizeObserver) sets the same flag */
+    .truncate.truncated {
+      --truncated: 1;
+    }
+
+    /* Hint that more text is available */
+    @container style(--truncated: 1) {
+      .truncate > span {
+        text-decoration: underline dotted;
+        text-underline-offset: 3px;
+      }
+    }
+
+    .truncate.truncated > span {
+      text-decoration: underline dotted;
+      text-underline-offset: 3px;
+    }
+
+    /* Reveal the full text on hover / keyboard focus by scrolling it inside its box */
+    @media (prefers-reduced-motion: no-preference) {
+      .truncate:is(:hover, :focus-visible) {
+        text-overflow: clip;
+      }
+
+      @container style(--truncated: 1) {
+        .truncate:is(:hover, :focus-visible) > span {
+          display: inline-block;
+          margin-inline-start: 100%;
+          translate: calc(1px - 100%);
+          transition: margin-inline-start 1.5s ease-in, translate 1.5s ease-in;
+        }
+
+        .truncate:is(:hover, :focus-visible):dir(rtl) > span {
+          translate: calc(100% - 1px);
+        }
+      }
+
+      .truncate.truncated:is(:hover, :focus-visible) > span {
+        display: inline-block;
+        margin-inline-start: 100%;
+        translate: calc(1px - 100%);
+        transition: margin-inline-start 1.5s ease-in, translate 1.5s ease-in;
+      }
+
+      .truncate.truncated:is(:hover, :focus-visible):dir(rtl) > span {
+        translate: calc(100% - 1px);
+      }
+    }
+
