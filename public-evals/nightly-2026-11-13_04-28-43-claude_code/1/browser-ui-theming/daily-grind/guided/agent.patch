+  <script>
+    (() => {
+      const form = document.getElementById('order-form');
+      const total = document.getElementById('order-total');
+      const sweetness = document.getElementById('sweetness');
+      const dateInput = document.getElementById('pickup-date');
+      const sweetLabels = ['None', 'Light', 'Regular', 'Sweet', 'Extra'];
+      const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      // Pickup: today through two weeks out (local date, not UTC)
+      const toISODate = (d) => {
+        const pad = (n) => String(n).padStart(2, '0');
+        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+      };
+      const today = new Date();
+      const later = new Date(today);
+      later.setDate(today.getDate() + 14);
+      dateInput.min = dateInput.value = toISODate(today);
+      dateInput.max = toISODate(later);
+
+      // Keep slider fill (WebKit/Blink) and accessible value text in sync
+      const syncSlider = () => {
+        sweetness.style.setProperty('--attr-min', sweetness.min);
+        sweetness.style.setProperty('--attr-max', sweetness.max);
+        sweetness.style.setProperty('--control-value', sweetness.value);
+        sweetness.setAttribute('aria-valuetext', sweetLabels[sweetness.value]);
+      };
+
+      const updateTotal = () => {
+        const drink = form.drink.selectedOptions[0];
+        const size = form.querySelector('input[name="size"]:checked');
+        const shots = Math.max(0, Number(form.shots.value) || 0);
+        const extras = form.querySelectorAll('input[name="extras"]:checked').length;
+        const price = Number(drink.dataset.price)
+          + Number(size?.dataset.price || 0)
+          + Math.max(0, shots - 2) * 0.80
+          + (form.milk.value === 'oat' || form.milk.value === 'almond' ? 0.60 : 0)
+          + extras * 0.75;
+        total.value = fmt.format(price);
+      };
+
+      form.addEventListener('input', () => {
+        syncSlider();
+        updateTotal();
+      });
+      form.addEventListener('change', updateTotal);
+
+      syncSlider();
+      updateTotal();
+    })();
+  </script>
+
