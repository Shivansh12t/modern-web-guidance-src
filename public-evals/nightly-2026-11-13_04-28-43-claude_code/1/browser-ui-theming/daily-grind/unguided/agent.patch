+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const drink = form.elements.drink;
+      const shots = form.elements.shots;
+      const sweetness = form.elements.sweetness;
+      const sweetOut = document.getElementById('sweetness-out');
+      const caffeine = document.getElementById('caffeine');
+      const total = document.getElementById('order-total');
+      const date = form.elements.pickup_date;
+
+      // Default pickup date: today, and disallow past dates
+      const now = new Date();
+      const today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+      date.min = today;
+      date.value = today;
+      date.defaultValue = today;
+
+      const EXTRA_SHOT = 0.80;
+
+      function update() {
+        sweetOut.value = sweetness.value + '%';
+        const shotCount = Math.min(4, Math.max(1, Number(shots.value) || 1));
+        caffeine.value = shotCount;
+
+        let price = Number(drink.selectedOptions[0]?.dataset.price || 0);
+        const size = form.querySelector('input[name="size"]:checked');
+        price += Number(size?.dataset.price || 0);
+        form.querySelectorAll('input[name="extras"]:checked').forEach(function (el) {
+          price += Number(el.dataset.price || 0);
+        });
+        price += Math.max(0, shotCount - 2) * EXTRA_SHOT;
+        total.value = '$' + price.toFixed(2);
+      }
+
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      // Reset restores defaults after the event finishes
+      form.addEventListener('reset', function () { setTimeout(update); });
+
+      // Preselect drink when a Seasonal Favorites card is clicked
+      document.querySelectorAll('.menu-layout .card').forEach(function (card) {
+        const name = card.querySelector('h3').textContent.trim();
+        const opt = Array.from(drink.options).find(function (o) { return o.text === name; });
+        if (!opt) return;
+        card.querySelector('.btn').insertAdjacentHTML('afterend',
+          ' <a href="#order-heading" class="btn customize-btn">Customize</a>');
+        card.querySelector('.customize-btn').addEventListener('click', function (e) {
+          e.preventDefault();
+          drink.value = opt.value;
+          update();
+          document.getElementById('order-heading').scrollIntoView({ behavior: 'smooth', block: 'start' });
+          drink.focus({ preventScroll: true });
+        });
+      });
+
+      update();
+    })();
+  </script>
+
