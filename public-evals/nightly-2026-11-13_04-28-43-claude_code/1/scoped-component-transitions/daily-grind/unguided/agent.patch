+        ids.forEach(id => {
+          cards.get(id)?.animate(
+            [{ opacity: 0, transform: 'scale(0.85)' }, { opacity: 1, transform: 'none' }],
+            { duration: DURATION, easing: EASE }
+          );
+        });
+      }
+
+      function restore() {
+        const ids = removed.splice(0);
+        order.push(...ids);
+        addCards(ids);
+        announce(`Restored ${ids.length} drink${ids.length === 1 ? '' : 's'}.`);
+      }
+
+      function reset() {
+        const before = snapshot();
+        const restored = removed.splice(0);
+        order = DRINKS.map(d => d.id);
+        DRINKS.forEach(d => options.set(d.id, freshOptions()));
+        cards.forEach((el, id) => updateCardAnimated(el, id));
+        renderOrder();
+        playFlip(before);
+        if (motionOK()) {
+          restored.forEach(id => cards.get(id)?.animate(
+            [{ opacity: 0, transform: 'scale(0.85)' }, { opacity: 1, transform: 'none' }],
+            { duration: DURATION, easing: EASE }
+          ));
+        }
+        announce('Lineup reset.');
+      }
+
+      /* ---------- Events (delegated, scoped to the section) ---------- */
+
+      section.addEventListener('click', e => {
+        const btn = e.target.closest('button[data-action]');
+        if (!btn || !section.contains(btn)) return;
+        const action = btn.dataset.action;
+        if (action === 'restore') return restore();
+        if (action === 'reset') return reset();
+
+        const card = btn.closest('.card');
+        if (!card || card.classList.contains('is-leaving')) return;
+        const id = card.dataset.id;
+        const o = options.get(id);
+
+        switch (action) {
+          case 'move':
+            move(id, Number(btn.dataset.dir));
+            break;
+          case 'remove':
+            remove(id);
+            break;
+          case 'size':
+            if (o.size === btn.dataset.size) return;
+            o.size = btn.dataset.size;
+            updateCardAnimated(card, id);
+            break;
+          case 'addon': {
+            const a = btn.dataset.addon;
+            o.addons.has(a) ? o.addons.delete(a) : o.addons.add(a);
+            updateCardAnimated(card, id);
+            break;
+          }
+        }
+      });
+
+      renderOrder();
+    })();
+  </script>
+
 </body>
 
