+  <script>
+    (() => {
+      const section = document.querySelector('[aria-labelledby="seasonal-heading"]');
+      const grid = document.getElementById('seasonal-grid');
+      const status = document.getElementById('seasonal-status');
+      const restoreBtn = section.querySelector('[data-action="restore"]');
+      const removed = []; // detached drink nodes, kept so restore reuses identity
+
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+
+      // Scoped to a single element: the sticky nav and the rest of the page stay
+      // interactive, and different cards can transition at the same time.
+      function transition(scopeEl, update) {
+        if (!supportsScoped) {
+          update();
+          return;
+        }
+        const t = scopeEl.startViewTransition(update);
+        t.ready.catch(() => {});
+      }
+
+      const canMoveBefore = Object.hasOwn(Element.prototype, 'moveBefore');
+      function move(container, node, ref) {
+        if (canMoveBefore) container.moveBefore(node, ref);
+        else container.insertBefore(node, ref);
+      }
+
+      const nameOf = (wrapper) => wrapper.querySelector('h3').textContent;
+      const announce = (msg) => { status.textContent = msg; };
+
+      function refreshControls() {
+        const items = [...grid.children];
+        items.forEach((w, i) => {
+          w.querySelector('[data-dir="-1"]').setAttribute('aria-disabled', String(i === 0));
+          w.querySelector('[data-dir="1"]').setAttribute('aria-disabled', String(i === items.length - 1));
+        });
+        restoreBtn.setAttribute('aria-disabled', String(removed.length === 0));
+        restoreBtn.textContent = removed.length
+          ? `Restore removed drinks (${removed.length})`
+          : 'Restore removed drinks';
+      }
+
+      function keepFocus(el, fn) {
+        const focused = document.activeElement;
+        fn();
+        if (focused && el.contains(focused) && document.activeElement !== focused) focused.focus();
+      }
+
+      function moveDrink(wrapper, dir) {
+        const items = [...grid.children];
+        const i = items.indexOf(wrapper);
+        const j = i + dir;
+        if (j < 0 || j >= items.length) return;
+        transition(grid, () => {
+          keepFocus(wrapper, () => {
+            move(grid, wrapper, dir < 0 ? items[j] : items[j].nextElementSibling);
+          });
+          refreshControls();
+        });
+        announce(`${nameOf(wrapper)} moved to position ${j + 1} of ${items.length}.`);
+      }
+
+      function removeDrink(wrapper) {
+        const hadFocus = wrapper.contains(document.activeElement);
+        const next = wrapper.nextElementSibling ?? wrapper.previousElementSibling;
+        const focusTarget = next?.querySelector('[data-action="remove-drink"]') ?? restoreBtn;
+        transition(grid, () => {
+          wrapper.remove();
+          removed.push(wrapper);
+          refreshControls();
+          if (hadFocus) focusTarget.focus();
+        });
+        announce(`${nameOf(wrapper)} removed. ${grid.children.length} drinks shown.`);
+      }
+
+      function restoreDrinks() {
+        if (!removed.length) return;
+        const count = removed.length;
+        transition(grid, () => {
+          while (removed.length) grid.append(removed.shift());
+          refreshControls();
+        });
+        announce(`${count} drink${count > 1 ? 's' : ''} restored. ${grid.children.length} drinks shown.`);
+      }
+
+      function sortDrinks() {
+        const sorted = [...grid.children].sort((a, b) => nameOf(a).localeCompare(nameOf(b)));
+        transition(grid, () => {
+          keepFocus(grid, () => {
+            for (const node of sorted) move(grid, node, null);
+          });
+          refreshControls();
+        });
+        announce(`Sorted by name, A to Z, ${sorted.length} drinks.`);
+      }
+
+      function makeItem(label) {
+        const li = document.createElement('li');
+        li.className = 'custom-item';
+        const span = document.createElement('span');
+        span.textContent = label;
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        btn.dataset.action = 'remove-item';
+        btn.setAttribute('aria-label', `Remove ${label}`);
+        btn.innerHTML = '&times;';
+        li.append(span, btn);
+        return li;
+      }
+
+      function addItem(card, label) {
+        const list = card.querySelector('.custom-list');
+        const drink = card.querySelector('h3').textContent;
+        const exists = [...list.querySelectorAll('.custom-item span')].some((s) => s.textContent === label);
+        if (exists) {
+          announce(`${label} is already on ${drink}.`);
+          return;
+        }
+        // Scope to the card itself so it animates its own height change too
+        transition(card, () => list.append(makeItem(label)));
+        announce(`${label} added to ${drink}.`);
+      }
+
+      function removeItem(card, li) {
+        const hadFocus = li.contains(document.activeElement);
+        const label = li.querySelector('span').textContent;
+        const drink = card.querySelector('h3').textContent;
+        const focusTarget =
+          li.nextElementSibling?.querySelector('button') ??
+          li.previousElementSibling?.querySelector('button') ??
+          card.querySelector('.add-form select');
+        transition(card, () => {
+          li.remove();
+          if (hadFocus) focusTarget.focus();
+        });
+        announce(`${label} removed from ${drink}.`);
+      }
+
+      section.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-action]');
+        if (!btn || btn.getAttribute('aria-disabled') === 'true') return;
+        const wrapper = btn.closest('.drink-wrapper');
+        switch (btn.dataset.action) {
+          case 'move': moveDrink(wrapper, Number(btn.dataset.dir)); break;
+          case 'remove-drink': removeDrink(wrapper); break;
+          case 'remove-item': removeItem(btn.closest('.drink-card'), btn.closest('.custom-item')); break;
+          case 'restore': restoreDrinks(); break;
+          case 'sort': sortDrinks(); break;
+        }
+      });
+
+      grid.addEventListener('submit', (e) => {
+        const form = e.target.closest('.add-form');
+        if (!form) return;
+        e.preventDefault();
+        addItem(form.closest('.drink-card'), form.elements.custom.value);
+      });
+
+      refreshControls();
+    })();
+  </script>
+
 </body>
 
 </html>
