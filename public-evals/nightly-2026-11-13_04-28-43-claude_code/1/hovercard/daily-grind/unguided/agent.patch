+  <!-- Shared hovercard: populated from DRINK_PREVIEWS for whichever link is hovered/focused -->
+  <div class="hovercard" id="drink-hovercard" role="dialog" aria-labelledby="hovercard-title" aria-hidden="true">
+    <div class="hovercard-arrow"></div>
+    <div class="hovercard-inner">
+      <div class="hovercard-media">
