+        <div class="hovercard-header">
+          <h4 class="hovercard-title" id="hovercard-title" data-field="name"></h4>
+          <span class="hovercard-price" data-field="price" aria-live="polite"></span>
+        </div>
+        <div class="hovercard-rating"><span class="stars" data-field="stars" aria-hidden="true"></span> <span data-field="rating"></span></div>
+        <p class="hovercard-desc" data-field="description"></p>
+        <dl class="hovercard-facts" data-field="facts"></dl>
+        <ul class="hovercard-notes" data-field="notes" aria-label="Tasting notes"></ul>
+        <fieldset class="hovercard-sizes" data-field="sizes">
+          <legend>Size</legend>
+        </fieldset>
+        <div class="hovercard-actions">
+          <button type="button" data-action="add">Add to order</button>
+          <a data-field="link">Full details &rarr;</a>
+        </div>
+      </div>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      // Structured preview data for each drink detail page linked from Seasonal Favorites.
+      const DRINK_PREVIEWS = {
+        '/menu/seasonal': {
+          name: 'Maple Oat Latte',
+          badge: 'Seasonal',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=640&q=70',
+          rating: 4.8,
+          reviews: 312,
+          description: 'Double-shot espresso, steamed oat milk and real Vermont maple syrup, finished with a dusting of cinnamon.',
+          facts: [['Caffeine', '150 mg'], ['Calories', '210'], ['Milk', 'Oat']],
+          notes: ['Maple', 'Toasted oat', 'Cinnamon', 'Caramel'],
+          sizes: [['Small', 4.75], ['Medium', 5.25], ['Large', 5.95]]
+        },
+        '/menu/espresso': {
+          name: 'Dark Roast Espresso',
+          badge: 'House Favorite',
+          image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=640&q=70',
+          rating: 4.7,
+          reviews: 528,
+          description: 'Our signature Sumatra and Brazil blend, roasted dark in-house for a syrupy body and lingering smoky finish.',
+          facts: [['Caffeine', '130 mg'], ['Calories', '5'], ['Roast', 'Dark']],
+          notes: ['Dark chocolate', 'Smoke', 'Molasses'],
+          sizes: [['Single', 2.75], ['Double', 3.50], ['Triple', 4.25]]
+        },
+        '/menu/cold-brew': {
+          name: 'Cold Brew',
+          badge: 'Small Batch',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=640&q=70',
+          rating: 4.9,
+          reviews: 401,
+          description: 'Single-origin Colombian beans steeped in cold filtered water for 18 hours, served over ice for a naturally sweet, low-acid cup.',
+          facts: [['Caffeine', '200 mg'], ['Calories', '5'], ['Steep', '18 hrs']],
+          notes: ['Cocoa', 'Brown sugar', 'Hazelnut', 'Low acid'],
+          sizes: [['Small', 4.25], ['Medium', 4.75], ['Large', 5.45]]
+        }
+      };
+
+      const SHOW_DELAY = 250;
+      const HIDE_DELAY = 200;
+      const GAP = 12;
+
+      const card = document.getElementById('drink-hovercard');
+      const field = (name) => card.querySelector(`[data-field="${name}"]`);
+      const addBtn = card.querySelector('[data-action="add"]');
+      const triggers = document.querySelectorAll('a[data-hovercard]');
+      const canHover = window.matchMedia('(hover: hover)');
+
+      let activeTrigger = null;
+      let showTimer = null;
+      let hideTimer = null;
+      let currentDrink = null;
+
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      function render(href, drink) {
+        currentDrink = drink;
+        const img = field('image');
+        img.src = drink.image;
+        img.alt = drink.name;
+        img.style.visibility = '';
+        field('badge').textContent = drink.badge;
+        field('url').textContent = href;
+        field('name').textContent = drink.name;
+        const full = Math.round(drink.rating);
+        field('stars').textContent = '\u2605'.repeat(full) + '\u2606'.repeat(5 - full);
+        field('rating').textContent = `${drink.rating.toFixed(1)} (${drink.reviews} reviews)`;
+        field('description').textContent = drink.description;
+
+        const facts = field('facts');
+        facts.replaceChildren(...drink.facts.map(([label, value]) => {
+          const wrap = document.createElement('div');
+          const dt = document.createElement('dt');
+          const dd = document.createElement('dd');
+          dt.textContent = label;
+          dd.textContent = value;
+          wrap.append(dt, dd);
+          return wrap;
+        }));
+
+        field('notes').replaceChildren(...drink.notes.map((note) => {
+          const li = document.createElement('li');
+          li.textContent = note;
+          return li;
+        }));
+
+        const sizes = field('sizes');
+        sizes.querySelectorAll('label').forEach((el) => el.remove());
+        drink.sizes.forEach(([label, price], i) => {
+          const lab = document.createElement('label');
+          const input = document.createElement('input');
+          input.type = 'radio';
+          input.name = 'hovercard-size';
+          input.value = String(i);
+          input.checked = i === 1 || drink.sizes.length === 1;
+          const span = document.createElement('span');
+          span.textContent = label;
+          lab.append(input, span);
+          sizes.appendChild(lab);
+        });
+        updatePrice();
+
+        const link = field('link');
+        link.href = href;
+        link.setAttribute('aria-label', `View full details for ${drink.name}`);
+
+        addBtn.classList.remove('is-added');
+        addBtn.textContent = 'Add to order';
+      }
+
+      function selectedSize() {
+        const checked = card.querySelector('input[name="hovercard-size"]:checked');
+        return currentDrink.sizes[checked ? Number(checked.value) : 0];
+      }
+
+      function updatePrice() {
+        field('price').textContent = money(selectedSize()[1]);
+      }
+
+      function position(trigger) {
+        const r = trigger.getBoundingClientRect();
+        const cw = card.offsetWidth;
+        const ch = card.offsetHeight;
+        const vw = document.documentElement.clientWidth;
+
+        let left = r.left + r.width / 2 - cw / 2;
+        left = Math.max(12, Math.min(left, vw - cw - 12));
+
+        const spaceBelow = window.innerHeight - r.bottom;
+        const above = spaceBelow < ch + GAP && r.top > ch + GAP;
+        const top = above ? r.top - ch - GAP : r.bottom + GAP;
+
+        card.classList.toggle('is-above', above);
+        card.style.left = `${left + window.scrollX}px`;
+        card.style.top = `${top + window.scrollY}px`;
+        const arrowX = Math.max(18, Math.min(r.left + r.width / 2 - left, cw - 18));
+        card.style.setProperty('--arrow-x', `${arrowX}px`);
+      }
+
+      function open(trigger) {
+        const href = trigger.dataset.hovercard;
+        const drink = DRINK_PREVIEWS[href];
+        if (!drink) return;
+        if (activeTrigger && activeTrigger !== trigger) {
+          activeTrigger.setAttribute('aria-expanded', 'false');
+        }
+        if (activeTrigger !== trigger || !card.classList.contains('is-open')) {
+          render(href, drink);
+        }
+        activeTrigger = trigger;
+        trigger.setAttribute('aria-expanded', 'true');
+        trigger.setAttribute('aria-controls', card.id);
+        card.setAttribute('aria-hidden', 'false');
+        position(trigger);
+        card.classList.add('is-open');
+      }
+
+      function close({ restoreFocus = false } = {}) {
+        clearTimeout(showTimer);
+        clearTimeout(hideTimer);
+        if (!activeTrigger) return;
+        const trigger = activeTrigger;
+        card.classList.remove('is-open');
+        card.setAttribute('aria-hidden', 'true');
+        trigger.setAttribute('aria-expanded', 'false');
+        activeTrigger = null;
+        if (restoreFocus) trigger.focus();
+      }
+
+      function scheduleOpen(trigger, delay = SHOW_DELAY) {
+        clearTimeout(hideTimer);
+        clearTimeout(showTimer);
+        // If a card is already open, switch instantly for a snappier feel.
+        if (card.classList.contains('is-open')) delay = 0;
+        showTimer = setTimeout(() => open(trigger), delay);
+      }
+
+      function scheduleClose() {
+        clearTimeout(showTimer);
+        clearTimeout(hideTimer);
+        hideTimer = setTimeout(() => close(), HIDE_DELAY);
+      }
+
+      triggers.forEach((trigger) => {
+        trigger.addEventListener('pointerenter', (e) => {
+          if (e.pointerType === 'mouse' || canHover.matches) scheduleOpen(trigger);
+        });
+        trigger.addEventListener('pointerleave', scheduleClose);
+        trigger.addEventListener('focus', () => {
+          if (trigger.matches(':focus-visible')) scheduleOpen(trigger, 0);
+        });
+        trigger.addEventListener('blur', (e) => {
+          if (!card.contains(e.relatedTarget)) scheduleClose();
+        });
+        trigger.addEventListener('keydown', (e) => {
+          // ArrowDown moves focus into the open card so its controls are reachable.
+          if (e.key === 'ArrowDown' && activeTrigger === trigger) {
+            e.preventDefault();
+            card.querySelector('input:checked, button, a').focus();
+          }
+        });
+      });
+
+      // Keep the card open while the pointer or focus is inside it.
+      card.addEventListener('pointerenter', () => clearTimeout(hideTimer));
+      card.addEventListener('pointerleave', scheduleClose);
+      card.addEventListener('focusin', () => clearTimeout(hideTimer));
+      card.addEventListener('focusout', (e) => {
+        if (!card.contains(e.relatedTarget) && e.relatedTarget !== activeTrigger) scheduleClose();
+      });
+
+      card.addEventListener('change', (e) => {
+        if (e.target.name === 'hovercard-size') {
+          updatePrice();
+          addBtn.classList.remove('is-added');
+          addBtn.textContent = 'Add to order';
+        }
+      });
+
+      addBtn.addEventListener('click', () => {
+        const [size, price] = selectedSize();
+        addBtn.classList.add('is-added');
+        addBtn.textContent = `Added ${size} \u2713`;
+        document.dispatchEvent(new CustomEvent('dailygrind:add-to-order', {
+          detail: { drink: currentDrink.name, size, price }
+        }));
+      });
+
+      field('image').addEventListener('error', (e) => {
+        // Fall back to the gradient background if the stock photo fails to load.
+        e.target.style.visibility = 'hidden';
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && activeTrigger) {
+          close({ restoreFocus: card.contains(document.activeElement) });
+        }
+      });
+
+      window.addEventListener('resize', () => activeTrigger && position(activeTrigger));
+      window.addEventListener('scroll', () => activeTrigger && position(activeTrigger), { passive: true });
+    })();
+  </script>
+
