+  <script type="module">
+    // Wire hint popovers for assistive tech up front (before any polyfill),
+    // since browsers/screen readers don't yet expose interestfor consistently.
+    const ownedExpanded = new WeakSet();
+    const norm = (text) => (text || "").replace(/\s+/g, " ").trim();
+
+    function accessibleName(el) {
+      const labelledby = el.getAttribute("aria-labelledby");
+      if (labelledby) {
+        return norm(labelledby.split(/\s+/)
+          .map((id) => document.getElementById(id)?.textContent || "")
+          .join(" "));
+      }
+      const label = norm(el.getAttribute("aria-label"));
+      if (label) return label;
+      const clone = el.cloneNode(true);
+      clone.querySelectorAll("img[alt]").forEach((img) => img.replaceWith(img.alt));
+      return norm(clone.textContent) || norm(el.getAttribute("title"));
+    }
+
+    function wireHints(root = document) {
+      root.querySelectorAll("[interestfor]").forEach((trigger) => {
+        const hint = document.getElementById(trigger.getAttribute("interestfor"));
+        if (!hint || hint.getAttribute("popover") !== "hint") return;
+
+        const name = accessibleName(trigger);
+        if (norm(hint.textContent) === name) return;
+        if (!hint.hasAttribute("role")) hint.setAttribute("role", "tooltip");
+
+        if (!name) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", hint.id);
+          }
+          return;
+        }
+
+        const opensOnActivation =
+          trigger.getAttribute("popovertarget") === hint.id ||
+          trigger.getAttribute("commandfor") === hint.id;
+
+        if (opensOnActivation) {
+          if (!trigger.hasAttribute("aria-expanded")) {
+            let open = false;
+            try { open = hint.matches(":popover-open"); } catch { /* unsupported */ }
+            trigger.setAttribute("aria-expanded", String(open));
+            ownedExpanded.add(trigger);
+          }
+        } else if (!trigger.hasAttribute("aria-describedby")) {
+          trigger.setAttribute("aria-describedby", hint.id);
+        }
+      });
+    }
+
+    // `toggle` doesn't bubble, so listen in the capture phase.
+    document.addEventListener("toggle", (event) => {
+      const hint = event.target;
+      if (!(hint instanceof HTMLElement) || !hint.id) return;
+      document.querySelectorAll(`[interestfor="${CSS.escape(hint.id)}"]`).forEach((trigger) => {
+        if (ownedExpanded.has(trigger)) {
+          trigger.setAttribute("aria-expanded", String(event.newState === "open"));
+        }
+      });
+    }, true);
+
+    window.wireHints = wireHints;
+    wireHints();
+
+    // Conditionally load polyfills only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
