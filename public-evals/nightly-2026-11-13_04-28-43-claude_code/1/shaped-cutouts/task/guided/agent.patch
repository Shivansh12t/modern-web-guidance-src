+    }
+
+    .card-accent {
+      flex: 0 0 80px;
+      background-color: var(--primary);
+      border-top-right-radius: 16px;
+      border-bottom-right-radius: 16px;
+      -webkit-mask-image: url(#accent-stencil);
+      mask-image: url(#accent-stencil);
+    }
+
+    /* Promo card – circular top notch via a CSS gradient mask */
+    .gradient-masked-card {
+      max-width: 420px;
+      margin: 60px auto 0;
+      background: linear-gradient(135deg, var(--accent), #e65100);
+      color: var(--text);
+      padding: 48px 28px 28px; /* extra top padding keeps content clear of the notch */
+      border-radius: 16px;
+      text-align: center;
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent 24px, black 25px);
+      mask-image: radial-gradient(circle at 50% 0%, transparent 24px, black 25px);
+    }
+
+    .gradient-masked-card h3 {
+      margin-bottom: 8px;
+    }
+
+    .promo-code {
+      display: inline-block;
+      margin-top: 12px;
+      padding: 4px 14px;
+      border: 2px dashed var(--text);
+      border-radius: 6px;
+      font-weight: bold;
+      letter-spacing: 2px;
+    }
