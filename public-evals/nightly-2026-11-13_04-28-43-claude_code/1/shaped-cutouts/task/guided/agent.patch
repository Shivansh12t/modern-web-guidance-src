+      width: min(280px, 70vw);
+      aspect-ratio: 1;
+      height: auto;
+      object-fit: cover;
+      background: var(--secondary);
+      /* SVG mask uses objectBoundingBox units, so it scales with the image */
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
