+    /* ---------- Shaped Elements ---------- */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section h2 {
+      text-align: center;
+      margin-bottom: 30px;
+    }
+
+    /* 1) Barista profile: paint-splat clip that scales with the image box
+       (clipPathUnits="objectBoundingBox" => coordinates are 0..1 fractions) */
+    .barista-feature {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      flex-wrap: wrap;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(320px, 80vw);
+      aspect-ratio: 5 / 6;
+      height: auto;
+      object-fit: cover;
+      clip-path: url(#paint-splat);
+    }
+
+    .barista-bio {
+      max-width: 420px;
+    }
+
+    .barista-bio h3 {
+      color: var(--primary);
+      font-size: 1.6rem;
+    }
+
+    .barista-bio .role {
+      color: #8d6e63;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      font-size: 0.8rem;
+      margin-bottom: 10px;
+    }
+
+    /* 2) Loyalty banner: two pieces that read as one card.
+       drop-shadow (not box-shadow) follows the masked silhouette of the children. */
+    .unified-card {
+      display: flex;
+      align-items: stretch;
+      max-width: 760px;
+      margin: 50px auto 0;
+      filter: drop-shadow(0 10px 14px rgba(62, 39, 35, 0.25)) drop-shadow(0 2px 3px rgba(62, 39, 35, 0.15));
+    }
+
+    .card-body {
+      flex: 1 1 auto;
+      background: var(--primary);
+      color: white;
+      padding: 30px 32px;
+      border-radius: 14px 0 0 14px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 6px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .card-accent {
+      --curve: 34px;
+      flex: 0 0 130px;
+      /* Overlap by 1px to avoid a hairline seam between the two pieces */
+      margin-left: -1px;
+      background:
+        repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.12) 0 8px, transparent 8px 16px),
+        linear-gradient(160deg, var(--accent), #ff8f00);
+      border-radius: 0 14px 14px 0;
+      /* Concave curve bitten out of the outer (right) side */
+      -webkit-mask: radial-gradient(var(--curve) 50% at 100% 50%, transparent 98%, #000 100%);
+      mask: radial-gradient(var(--curve) 50% at 100% 50%, transparent 98%, #000 100%);
+    }
+
+    /* 3) Promo card with a circular notch on its top edge via a gradient mask */
+    .promo-wrap {
+      display: flex;
+      justify-content: center;
+      margin-top: 60px;
+      /* Shadow lives on the wrapper so the mask doesn't clip it */
+      filter: drop-shadow(0 8px 12px rgba(62, 39, 35, 0.2));
+    }
+
+    .gradient-masked-card {
+      --notch: 28px;
+      position: relative;
+      width: min(420px, 100%);
+      padding: calc(var(--notch) + 24px) 28px 28px;
+      text-align: center;
+      color: white;
+      border-radius: 14px;
+      background: linear-gradient(135deg, #6d4c41, var(--primary));
+      -webkit-mask: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+      mask: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+    }
+
+    .gradient-masked-card h3 {
+      color: var(--accent);
+      font-size: 1.4rem;
+    }
+
+    .gradient-masked-card .promo-code {
+      display: inline-block;
+      margin-top: 12px;
+      padding: 6px 14px;
+      border: 2px dashed var(--accent);
+      border-radius: 6px;
+      font-family: monospace;
+      font-size: 1.1rem;
+      letter-spacing: 2px;
+    }
+
+    @media (max-width: 560px) {
+      .card-accent {
+        flex-basis: 70px;
+      }
+    }
+
     footer {
