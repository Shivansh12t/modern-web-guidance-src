diff --git a/src/hooks/useModalDialog.ts b/src/hooks/useModalDialog.ts
new file mode 100644
index 0000000..5c565e7
--- /dev/null
+++ b/src/hooks/useModalDialog.ts
@@ -0,0 +1,50 @@
+import { useEffect, useRef } from 'react';
+
+/**
+ * Opens a native <dialog> as a modal as soon as it mounts and reports when it closes.
+ *
+ * The browser handles focus containment, the inert page, Esc / back-gesture dismissal
+ * and returning focus to the invoking control, so no manual focus trap is needed.
+ * Light dismiss comes from `closedby="any"`; browsers without it get a small fallback.
+ */
+export function useModalDialog(onClose: () => void) {
+  const ref = useRef<HTMLDialogElement>(null);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    const dialog = ref.current;
+    if (!dialog) return;
+
+    if (!dialog.open) dialog.showModal();
+
+    const handleClose = () => onCloseRef.current();
+    dialog.addEventListener('close', handleClose);
+
+    // Fallback for browsers without <dialog closedby>: close on press + release outside the dialog box.
+    let cleanupFallback = () => {};
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e: PointerEvent) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      const down = (e: PointerEvent) => { pressedOutside = outside(e); };
+      const up = (e: PointerEvent) => { if (pressedOutside && outside(e)) dialog.close(); };
+      dialog.addEventListener('pointerdown', down);
+      dialog.addEventListener('pointerup', up);
+      cleanupFallback = () => {
+        dialog.removeEventListener('pointerdown', down);
+        dialog.removeEventListener('pointerup', up);
+      };
+    }
+
+    return () => {
+      dialog.removeEventListener('close', handleClose);
+      cleanupFallback();
+      if (dialog.open) dialog.close();
+    };
+  }, []);
+
+  return ref;
+}
