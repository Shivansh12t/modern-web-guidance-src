+}
+/* ---------- Native modal dialogs ---------- */
+
+/* Without these, scrolling over the backdrop or inside the dialog scrolls the page behind it. */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+/* ---------- Header mega-menu (popover) ---------- */
+
+.main-nav {
+  anchor-name: --main-nav;
+}
+
+/* Reset the UA popover centering and tether the flyout directly under the nav. */
+.flyout-menu {
+  inset: auto;
+  margin: 0;
+  max-height: calc(100dvh - 8rem);
+  overflow: auto;
+  position-anchor: --main-nav;
+  top: anchor(bottom);
+  left: anchor(left);
+  width: anchor-size(width);
+}
+
+/* Fallback: geometry is passed in from JS via custom properties. */
+@supports not (anchor-name: --a) {
+  .flyout-menu {
+    top: var(--flyout-top, 0);
+    left: var(--flyout-left, 0);
+    width: var(--flyout-width, 100%);
+  }
+}
+
+/* ---------- Focus management ---------- */
+
+/* The skip-link target receives programmatic focus only; don't draw a ring around the whole page. */
+#main-content:focus {
+  outline: none;
+}
