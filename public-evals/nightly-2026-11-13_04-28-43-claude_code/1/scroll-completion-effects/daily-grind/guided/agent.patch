+  <script>
+    (() => {
+      const links = document.querySelectorAll('nav a[href^="#"], nav a[data-scroll-target]');
+      const announcer = document.getElementById('scroll-announcer');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let currentScrollId = 0;
+
+      function getTargetId(link) {
+        return link.dataset.scrollTarget || decodeURIComponent(link.hash.slice(1));
+      }
+
+      // Resolves once the scroll has finished. Uses the Promise returned by
+      // scrollIntoView() where supported, otherwise falls back to scrollend
+      // plus an idle timeout (covers "already in view" and no-scrollend browsers).
+      function scrollIntoViewAsync(element, options, scroller = window) {
+        const result = element.scrollIntoView(options);
+        if (result instanceof Promise) return result;
+
+        return new Promise((resolve) => {
+          let timeoutId;
+          const finish = () => {
+            clearTimeout(timeoutId);
+            scroller.removeEventListener('scrollend', finish);
+            scroller.removeEventListener('scroll', onScroll);
+            resolve();
+          };
+          const onScroll = () => {
+            clearTimeout(timeoutId);
+            timeoutId = setTimeout(finish, 100);
+          };
+          scroller.addEventListener('scrollend', finish, { once: true });
+          scroller.addEventListener('scroll', onScroll, { passive: true });
+          timeoutId = setTimeout(finish, 100);
+        });
+      }
+
+      async function scrollToSection(target, { updateHistory = true } = {}) {
+        const scrollId = ++currentScrollId;
+        document.querySelectorAll('.page-section.is-arrived')
+          .forEach((sec) => sec.classList.remove('is-arrived'));
+
+        links.forEach((link) => {
+          if (getTargetId(link) === target.id) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+
+        if (updateHistory && location.hash !== '#' + target.id) {
+          history.pushState(null, '', '#' + target.id);
+        }
+
+        await scrollIntoViewAsync(target, {
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+
+        // A newer navigation superseded this one; skip the follow-up effects.
+        if (scrollId !== currentScrollId) return;
+
+        // Post-scroll effects: restart the arrival animation and move focus.
+        void target.offsetWidth; // reflow so the animation replays on repeat clicks
+        target.classList.add('is-arrived');
+
+        const heading = target.querySelector('h2, h1, [tabindex="-1"]') || target;
+        if (!heading.hasAttribute('tabindex') && heading === target) target.setAttribute('tabindex', '-1');
+        heading.focus({ preventScroll: true });
+
+        announcer.textContent = '';
+        announcer.textContent = `Moved to ${heading.textContent.trim()}`;
+      }
+
+      document.querySelectorAll('.page-section').forEach((sec) => {
+        sec.addEventListener('animationend', (e) => {
+          if (e.target === sec) sec.classList.remove('is-arrived');
+        });
+      });
+
+      links.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const target = document.getElementById(getTargetId(link));
+          if (!target) return; // let the browser handle it normally
+          event.preventDefault();
+          scrollToSection(target);
+        });
+      });
+
+      // Back/forward between section hashes
+      window.addEventListener('popstate', () => {
+        const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
+        if (target) scrollToSection(target, { updateHistory: false });
+      });
+    })();
+  </script>
+
