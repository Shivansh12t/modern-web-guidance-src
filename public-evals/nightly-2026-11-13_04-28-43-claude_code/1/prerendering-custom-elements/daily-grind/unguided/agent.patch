+// Server-renders the Seasonal Favorites <drink-card> elements (with their
+// declarative shadow roots) into index.html between the DRINK-CARDS markers.
+// Usage: npm run build
+import { readFile, writeFile } from 'node:fs/promises';
+import { renderDrinkCard } from '../components/drink-card.js';
+
+const root = new URL('../', import.meta.url);
+const indexUrl = new URL('index.html', root);
+const drinks = JSON.parse(await readFile(new URL('data/seasonal-drinks.json', root), 'utf8'));
+
+const START = '<!-- DRINK-CARDS:START -->';
+const END = '<!-- DRINK-CARDS:END -->';
+
+const html = await readFile(indexUrl, 'utf8');
+const start = html.indexOf(START);
+const end = html.indexOf(END);
+if (start === -1 || end === -1 || end < start) {
+  throw new Error(`index.html must contain ${START} ... ${END}`);
+}
+
+const indent = '        ';
+const cards = drinks
+  .map(renderDrinkCard)
+  .join('\n')
+  .split('\n')
+  .map((line) => (line ? indent + line : line))
+  .join('\n');
+
+await writeFile(
+  indexUrl,
+  `${html.slice(0, start + START.length)}\n${cards}\n${indent}${html.slice(end)}`,
+);
+console.log(`Rendered ${drinks.length} drink cards into index.html`);
