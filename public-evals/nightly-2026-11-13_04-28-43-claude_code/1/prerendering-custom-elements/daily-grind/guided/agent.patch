+  <script type="module">
+    const STORAGE_KEY = 'daily-grind:favorites';
+    const readFavorites = () => {
+      try { return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []); } catch { return new Set(); }
+    };
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorite'];
+      #button;
+
+      constructor() {
+        super();
+        // Hydrate the server-rendered (declarative) shadow root; only build one if the
+        // browser didn't parse <template shadowrootmode> (pre-DSD engines).
+        if (!this.shadowRoot) {
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          if (tpl) {
+            this.attachShadow({ mode: 'open' }).append(tpl.content.cloneNode(true));
+            tpl.remove();
+          }
+        }
+        this.#button = this.shadowRoot?.querySelector('.fav');
+        if (!this.#button) return;
+        this.#button.addEventListener('click', () => {
+          this.favorite = !this.favorite;
+          const favorites = readFavorites();
+          this.favorite ? favorites.add(this.drinkId) : favorites.delete(this.drinkId);
+          try { localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites])); } catch {}
+          this.dispatchEvent(new CustomEvent('favorite-change', {
+            bubbles: true, detail: { id: this.drinkId, favorite: this.favorite },
+          }));
+        });
+        // Label the button with the light-DOM drink name (cross-tree, so use element refs).
+        const title = this.querySelector('[slot="title"]');
+        if (title && 'ariaDescribedByElements' in Element.prototype) {
+          this.#button.ariaDescribedByElements = [title];
+        } else if (title) {
+          this.#button.setAttribute('aria-label', `Favorite ${title.textContent.trim()}`);
+        }
+      }
+
+      connectedCallback() {
+        if (!this.#button) return;
+        // Restore persisted state without re-rendering: just flip the attribute.
+        if (readFavorites().has(this.drinkId)) this.setAttribute('favorite', '');
+        this.#sync();
+        this.#button.disabled = false;
+      }
+
+      attributeChangedCallback() {
+        if (!this.#button) return;
+        this.#sync();
+      }
+
+      get drinkId() { return this.getAttribute('drink-id'); }
+      get favorite() { return this.hasAttribute('favorite'); }
+      set favorite(v) { this.toggleAttribute('favorite', Boolean(v)); }
+
+      #sync() { this.#button.setAttribute('aria-pressed', String(this.favorite)); }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
