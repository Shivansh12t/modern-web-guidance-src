+  <!-- Toast notifications: one consistent, named region for all toasts -->
+  <div class="toast-region" role="region" aria-label="Notifications">
+    <div class="toast" id="toast-maple" popover="manual">
+      <span class="toast-icon" aria-hidden="true">☕</span>
+      <p class="toast-message"><strong>Maple Oat Latte</strong> was added to your order.</p>
+      <button type="button" class="toast-close" popovertarget="toast-maple" popovertargetaction="hide" aria-label="Close notification">&times;</button>
+    </div>
+    <div class="toast" id="toast-espresso" popover="manual">
+      <span class="toast-icon" aria-hidden="true">☕</span>
+      <p class="toast-message"><strong>Dark Roast Espresso</strong> was added to your order.</p>
+      <button type="button" class="toast-close" popovertarget="toast-espresso" popovertargetaction="hide" aria-label="Close notification">&times;</button>
+    </div>
+    <div class="toast" id="toast-cold-brew" popover="manual">
+      <span class="toast-icon" aria-hidden="true">☕</span>
+      <p class="toast-message"><strong>Cold Brew</strong> was added to your order.</p>
+      <button type="button" class="toast-close" popovertarget="toast-cold-brew" popovertargetaction="hide" aria-label="Close notification">&times;</button>
+    </div>
+  </div>
+
+  <!-- Live region fallback for browsers without document.ariaNotify() -->
+  <p class="visually-hidden">Screen reader announcements</p>
+  <div class="visually-hidden" id="toast-announcer" aria-live="polite"></div>
+
+  <script type="module">
+    // Load the Popover polyfill only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const DURATION = 6000; // ms before a toast auto-dismisses
+    const GAP = 12;        // px between stacked toasts
+
+    const announcer = document.getElementById("toast-announcer");
+    const stack = [];               // open toasts, oldest first
+    const timers = new Map();       // toast -> { id, start, remaining, paused }
+    const returnFocus = new Map();  // toast -> trigger that opened it
+    const hadFocus = new WeakSet(); // toasts that contained focus when closing
+
+    // Newest toast sits in the corner; older ones are pushed upward.
+    function layout() {
+      let offset = 0;
+      for (let i = stack.length - 1; i >= 0; i--) {
+        stack[i].style.setProperty("--toast-offset", `${offset}px`);
+        offset += stack[i].offsetHeight + GAP;
+      }
+    }
+
+    // Announce only the visible message text, not control names.
+    function announce(toast) {
+      const msg = toast.querySelector(".toast-message")?.textContent.replace(/\s+/g, " ").trim();
+      if (!msg) return;
+      if (typeof document.ariaNotify === "function") {
+        document.ariaNotify(msg);
+      } else {
+        announcer.textContent = "";
+        setTimeout(() => { announcer.textContent = msg; }, 50);
+      }
+    }
+
+    function clearTimer(toast) {
+      const t = timers.get(toast);
+      if (t) clearTimeout(t.id);
+      timers.delete(toast);
+    }
+
+    function startTimer(toast, ms = DURATION) {
+      clearTimer(toast);
+      timers.set(toast, {
+        id: setTimeout(() => toast.hidePopover(), ms),
+        start: Date.now(),
+        remaining: ms,
+        paused: false,
+      });
+    }
+
+    // Never dismiss while the user is hovering or focused inside the toast.
+    function pauseTimer(toast) {
+      const t = timers.get(toast);
+      if (!t || t.paused) return;
+      clearTimeout(t.id);
+      t.remaining -= Date.now() - t.start;
+      t.paused = true;
+    }
+
+    function resumeTimer(toast) {
+      const t = timers.get(toast);
+      if (!t?.paused) return;
+      startTimer(toast, Math.max(t.remaining, 2000));
+    }
+
+    function bringToFront(toast) {
+      const i = stack.indexOf(toast);
+      if (i !== -1) stack.splice(i, 1);
+      stack.push(toast);
+      layout();
+    }
+
+    for (const toast of document.querySelectorAll(".toast")) {
+      toast.addEventListener("beforetoggle", (e) => {
+        if (e.newState === "closed" && toast.contains(document.activeElement)) {
+          hadFocus.add(toast);
+        }
+      });
+
+      toast.addEventListener("toggle", (e) => {
+        if (e.newState === "open") {
+          bringToFront(toast);
+          announce(toast);
+          startTimer(toast);
+          return;
+        }
+
+        clearTimer(toast);
+        const i = stack.indexOf(toast);
+        if (i !== -1) stack.splice(i, 1);
+        layout();
+
+        // If the user dismissed a focused toast, move focus to the next
+        // remaining toast, or back to the control that triggered it.
+        if (hadFocus.has(toast)) {
+          hadFocus.delete(toast);
+          const next = stack.at(-1)?.querySelector(".toast-close") ?? returnFocus.get(toast);
+          next?.focus();
+        }
+      });
+
+      toast.addEventListener("pointerenter", () => pauseTimer(toast));
+      toast.addEventListener("pointerleave", () => {
+        if (!toast.contains(document.activeElement)) resumeTimer(toast);
+      });
+      toast.addEventListener("focusin", () => pauseTimer(toast));
+      toast.addEventListener("focusout", (e) => {
+        if (!toast.contains(e.relatedTarget) && !toast.matches(":hover")) resumeTimer(toast);
+      });
+      toast.addEventListener("keydown", (e) => {
+        if (e.key === "Escape") toast.hidePopover();
+      });
+    }
+
+    // Triggers: native popovertarget opens the toast; non-button triggers can
+    // use data-toast-target="<toast id>" instead.
+    for (const trigger of document.querySelectorAll(".toast-trigger")) {
+      trigger.addEventListener("click", () => {
+        const id = trigger.getAttribute("popovertarget") ?? trigger.dataset.toastTarget;
+        const toast = id && document.getElementById(id);
+        if (!toast) return;
+        returnFocus.set(toast, trigger);
+
+        if (stack.includes(toast)) {
+          // Already showing: move it to the front and restart its timer.
+          bringToFront(toast);
+          announce(toast);
+          startTimer(toast);
+        } else if (!trigger.hasAttribute("popovertarget")) {
+          toast.showPopover();
+        }
+      });
+    }
+
+    // Keep the order count in the nav so the toast's info is available elsewhere.
+    const orderCount = document.getElementById("order-count");
+    let count = 0;
+    for (const btn of document.querySelectorAll("[data-add-item]")) {
+      btn.addEventListener("click", () => {
+        orderCount.textContent = String(++count);
+      });
+    }
+
+    // Re-measure stack if text size / viewport changes.
+    addEventListener("resize", layout);
+  </script>
+
