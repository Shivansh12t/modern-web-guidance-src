+  <script type="module">
+    // Load the popover polyfill only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Collapse the navigation into a popover only when the inline row doesn't fit.
+    const header = document.querySelector(".site-header");
+    const inner = header.querySelector(".header-inner");
+    const menu = header.querySelector("#site-menu");
+    let lastWidth = 0;
+
+    function updateLayout() {
+      const width = inner.clientWidth;
+      const isWide = header.classList.contains("is-wide");
+      // While collapsed, only re-measure when the header has grown (avoids thrashing).
+      if (!isWide && width <= lastWidth) {
+        lastWidth = width;
+        return;
+      }
+      lastWidth = width;
+
+      const wasOpen = menu.matches(":is(:popover-open, .\\:popover-open)");
+      header.classList.add("is-measuring", "is-wide");
+      const fits = inner.scrollWidth <= inner.clientWidth;
+      header.classList.toggle("is-wide", fits);
+
+      if (fits) {
+        menu.removeAttribute("popover");
+      } else {
+        menu.setAttribute("popover", "auto");
+        if (wasOpen) menu.showPopover();
+      }
+      requestAnimationFrame(() => header.classList.remove("is-measuring"));
+    }
+
+    const observer = new ResizeObserver(updateLayout);
+    observer.observe(header);
+    observer.observe(menu);
+  </script>
+
