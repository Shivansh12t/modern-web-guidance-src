@@ -0,0 +1,238 @@
+'use strict';
+
+const http = require('node:http');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+
+const PORT = Number(process.env.PORT) || 11222;
+const HOST = process.env.HOST || '0.0.0.0';
+const PUBLIC_DIR = path.join(__dirname, 'public');
+const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.json');
+const MAX_BODY_BYTES = 2 * 1024;
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+// The page may only talk to this origin and load photos from Unsplash.
+// No 'unsafe-inline' / 'unsafe-eval', so injected inline scripts and styles don't run,
+// and connect-src/form-action keep fetch, XHR, beacons, WebSockets and form posts on our own server.
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "font-src 'self'",
+  "manifest-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  "object-src 'none'",
+  "worker-src 'none'",
+  "frame-src 'none'",
+  "media-src 'none'",
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CSP,
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'X-DNS-Prefetch-Control': 'off',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()',
+};
+
+// Explicit allowlist of static files: nothing else on disk is reachable.
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/app.js': { file: 'app.js', type: 'text/javascript; charset=utf-8' },
+};
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, payload, headers = {}) {
+  send(res, status, JSON.stringify(payload), {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+    ...headers,
+  });
+}
+
+function escapeHtml(s) {
+  return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+}
+
+// Minimal page for browsers without JavaScript that submit the form directly.
+function sendHtmlMessage(res, status, message) {
+  const html = `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Newsletter | The Daily Grind</title><link rel="stylesheet" href="/styles.css"></head>
+<body><main class="container"><section class="newsletter"><h2>The Daily Grind Newsletter</h2>
+<p>${escapeHtml(message)}</p><a class="btn" href="/">Back to homepage</a></section></main></body></html>`;
+  send(res, status, html, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
+}
+
+// --- Simple in-memory rate limiting (per IP, sliding window) ---
+const RATE_WINDOW_MS = 60 * 1000;
+const RATE_MAX = 5;
+const hits = new Map();
+
+function rateLimited(ip) {
+  const now = Date.now();
+  const recent = (hits.get(ip) || []).filter((t) => now - t < RATE_WINDOW_MS);
+  recent.push(now);
+  hits.set(ip, recent);
+  return recent.length > RATE_MAX;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [ip, times] of hits) {
+    if (times.every((t) => now - t >= RATE_WINDOW_MS)) hits.delete(ip);
+  }
+}, RATE_WINDOW_MS).unref();
+
+// --- Subscriber storage (serialised writes to a JSON file) ---
+let writeQueue = Promise.resolve();
+
+function addSubscriber(email) {
+  const task = writeQueue.then(async () => {
+    await fsp.mkdir(DATA_DIR, { recursive: true });
+    let list = [];
+    try {
+      list = JSON.parse(await fsp.readFile(SUBSCRIBERS_FILE, 'utf8'));
+    } catch (err) {
+      if (err.code !== 'ENOENT') throw err;
+    }
+    if (list.some((s) => s.email === email)) return false;
+    list.push({ email, subscribedAt: new Date().toISOString() });
+    const tmp = `${SUBSCRIBERS_FILE}.${process.pid}.tmp`;
+    await fsp.writeFile(tmp, JSON.stringify(list, null, 2));
+    await fsp.rename(tmp, SUBSCRIBERS_FILE);
+    return true;
+  });
+  writeQueue = task.catch(() => {});
+  return task;
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+async function handleNewsletter(req, res) {
+  const contentType = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  const isJson = contentType === 'application/json';
+  const isForm = contentType === 'application/x-www-form-urlencoded';
+  const reply = (status, message) =>
+    isForm ? sendHtmlMessage(res, status, message) : sendJson(res, status, { ok: status < 300, message });
+
+  if (!isJson && !isForm) return reply(415, 'Unsupported content type.');
+
+  // Reject cross-site submissions (CSRF) when the browser tells us the origin.
+  const origin = req.headers.origin;
+  if (origin && origin !== 'null') {
+    try {
+      if (new URL(origin).host !== req.headers.host) return reply(403, 'Forbidden.');
+    } catch {
+      return reply(403, 'Forbidden.');
+    }
+  }
+
+  const ip = req.socket.remoteAddress || 'unknown';
+  if (rateLimited(ip)) return reply(429, 'Too many attempts. Please wait a minute and try again.');
+
+  let email;
+  try {
+    const raw = await readBody(req);
+    email = isJson ? JSON.parse(raw).email : new URLSearchParams(raw).get('email');
+  } catch (err) {
+    return reply(err.status || 400, err.status === 413 ? 'Request too large.' : 'Invalid request.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_PATTERN.test(email)) {
+    return reply(400, 'Please enter a valid email address.');
+  }
+
+  try {
+    const added = await addSubscriber(email);
+    return reply(
+      added ? 201 : 200,
+      added ? "Thanks for subscribing! Watch your inbox for our next brew." : "You're already on the list. Thanks!",
+    );
+  } catch (err) {
+    console.error('Failed to save subscriber:', err);
+    return reply(500, 'Something went wrong on our end. Please try again later.');
+  }
+}
+
+function handleStatic(req, res, pathname) {
+  const entry = STATIC_FILES[pathname];
+  if (!entry) return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+
+  const filePath = path.join(PUBLIC_DIR, entry.file);
+  fs.stat(filePath, (err, stat) => {
+    if (err) return send(res, 500, 'Server error', { 'Content-Type': 'text/plain; charset=utf-8' });
+    const headers = {
+      'Content-Type': entry.type,
+      'Content-Length': stat.size,
+      'Cache-Control': entry.file === 'index.html' ? 'no-cache' : 'public, max-age=3600',
+    };
+    if (req.method === 'HEAD') return send(res, 200, undefined, headers);
+    res.writeHead(200, { ...SECURITY_HEADERS, ...headers });
+    fs.createReadStream(filePath).on('error', () => res.destroy()).pipe(res);
+  });
+}
+
+const server = http.createServer((req, res) => {
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    return send(res, 400, 'Bad request', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') {
+      return sendJson(res, 405, { ok: false, message: 'Method not allowed.' }, { Allow: 'POST' });
+    }
+    return handleNewsletter(req, res).catch((err) => {
+      console.error(err);
+      if (!res.headersSent) sendJson(res, 500, { ok: false, message: 'Server error.' });
+    });
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, 'Method not allowed', { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  return handleStatic(req, res, pathname);
+});
+
+if (require.main === module) {
+  server.listen(PORT, HOST, () => {
+    console.log(`The Daily Grind running at http://localhost:${PORT}`);
+  });
+}
+
+module.exports = { server, CSP };
