--- /dev/null
+++ b/server.js
@@ -0,0 +1,226 @@
+// Minimal, dependency-free server for the Daily Grind homepage.
+// Serves the static homepage with strict outbound-connection headers and
+// accepts newsletter signups at POST /api/newsletter.
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const DATA_DIR = path.join(ROOT, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const PORT = Number(process.env.PORT) || 11222;
+const MAX_BODY_BYTES = 4 * 1024;
+
+// The only third-party origin the page may contact.
+const PHOTO_HOST = 'https://images.unsplash.com';
+const REPORT_ENDPOINT = '/api/security-reports';
+
+// Explicit allowlist of static files — nothing else on disk is reachable.
+const STATIC_FILES = new Map([
+  ['/', { file: 'index.html', type: 'text/html; charset=utf-8' }],
+  ['/index.html', { file: 'index.html', type: 'text/html; charset=utf-8' }],
+  ['/styles.css', { file: 'styles.css', type: 'text/css; charset=utf-8' }],
+  ['/app.js', { file: 'app.js', type: 'text/javascript; charset=utf-8' }],
+]);
+
+// Connection-Allowlist: one network-layer allowlist covering fetch, XHR, beacons,
+// subresources, navigations, resource hints, WebSocket, and WebRTC (Chrome/Edge 152+).
+// Must be an RFC 9651 inner list; a malformed value fails closed and blocks everything.
+const CONNECTION_ALLOWLIST = `(response-origin "${PHOTO_HOST}/*"); report-to=security`;
+
+// CSP fallback for browsers without Connection-Allowlist (Firefox, Safari), and
+// defense in depth everywhere: no inline/third-party script, and every fetch
+// directive locked to our origin plus the Unsplash image host.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${PHOTO_HOST}`,
+  "connect-src 'self'",
+  "font-src 'self'",
+  "manifest-src 'self'",
+  "media-src 'none'",
+  "object-src 'none'",
+  "frame-src 'none'",
+  "worker-src 'none'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  'report-to security',
+].join('; ');
+
+function documentSecurityHeaders() {
+  return {
+    'Reporting-Endpoints': `security="${REPORT_ENDPOINT}"`,
+    'Connection-Allowlist': CONNECTION_ALLOWLIST,
+    'Content-Security-Policy': CONTENT_SECURITY_POLICY,
+  };
+}
+
+function baseHeaders(extra = {}) {
+  return {
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Cross-Origin-Opener-Policy': 'same-origin',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+    ...extra,
+  };
+}
+
+function send(req, res, status, body, headers) {
+  const buf = Buffer.isBuffer(body) ? body : Buffer.from(body);
+  res.writeHead(status, baseHeaders({ 'Content-Length': buf.length, ...headers }));
+  res.end(req.method === 'HEAD' ? undefined : buf);
+}
+
+function sendJson(req, res, status, data) {
+  send(req, res, status, JSON.stringify(data), {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+// Plain HTML result page for the no-JavaScript form submission. A 200 page is used
+// instead of a redirect because Connection-Allowlist blocks 3xx redirects by default.
+function sendResultPage(req, res, status, message) {
+  const html = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Newsletter | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container">
+    <h1>${escapeHtml(message)}</h1>
+    <p><a class="btn" href="/">Back to the homepage</a></p>
+  </main>
+</body>
+</html>`;
+  send(req, res, status, html, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+    ...documentSecurityHeaders(),
+  });
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      // Keep draining (so we can still reply) but stop buffering once over the limit.
+      if (size <= MAX_BODY_BYTES) chunks.push(chunk);
+    });
+    req.on('end', () => {
+      if (size > MAX_BODY_BYTES) reject(Object.assign(new Error('Body too large'), { status: 413 }));
+      else resolve(Buffer.concat(chunks).toString('utf8'));
+    });
+    req.on('error', reject);
+  });
+}
+
+const EMAIL_RE = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;
+
+async function handleNewsletter(req, res) {
+  const wantsJson = (req.headers['content-type'] || '').startsWith('application/json');
+  const reply = (status, message, key = status < 400 ? 'message' : 'error') =>
+    wantsJson ? sendJson(req, res, status, { [key]: message }) : sendResultPage(req, res, status, message);
+
+  // Same-origin check: reject cross-site form posts / fetches (CSRF).
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') {
+    return reply(403, 'Signups must come from our website.');
+  }
+
+  let email;
+  try {
+    const raw = await readBody(req);
+    if (wantsJson) {
+      email = JSON.parse(raw)?.email;
+    } else {
+      email = new URLSearchParams(raw).get('email');
+    }
+  } catch (err) {
+    return reply(err.status || 400, 'Sorry, we couldn’t read that request. Please try again.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return reply(422, 'Please enter a valid email address, like name@example.com.');
+  }
+
+  try {
+    await mkdir(DATA_DIR, { recursive: true });
+    await appendFile(SUBSCRIBERS_FILE, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n');
+  } catch (err) {
+    console.error('Failed to store subscriber:', err);
+    return reply(500, 'Sorry, we couldn’t sign you up right now. Please try again in a moment.');
+  }
+
+  return reply(201, 'Thanks! You’re on the list for the Grind Gazette.');
+}
+
+async function handleSecurityReport(req, res) {
+  try {
+    const raw = await readBody(req);
+    console.warn('[security report]', raw);
+  } catch {
+    // Ignore malformed or oversized reports.
+  }
+  res.writeHead(204, baseHeaders());
+  res.end();
+}
+
+async function handleStatic(req, res, pathname) {
+  const entry = STATIC_FILES.get(pathname);
+  if (!entry) {
+    return send(req, res, 404, 'Not found', {
+      'Content-Type': 'text/plain; charset=utf-8',
+      ...documentSecurityHeaders(),
+    });
+  }
+  const body = await readFile(path.join(ROOT, entry.file));
+  const isDocument = entry.type.startsWith('text/html');
+  send(req, res, 200, body, {
+    'Content-Type': entry.type,
+    'Cache-Control': isDocument ? 'no-cache' : 'public, max-age=300',
+    // Every HTML response carries the policy (not just some Sec-Fetch-Dest values),
+    // so no cache can ever serve the page without it.
+    ...(isDocument ? documentSecurityHeaders() : {}),
+  });
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') return sendJson(req, res, 405, { error: 'Method not allowed' });
+      return await handleNewsletter(req, res);
+    }
+    if (pathname === REPORT_ENDPOINT) {
+      if (req.method !== 'POST') return sendJson(req, res, 405, { error: 'Method not allowed' });
+      return await handleSecurityReport(req, res);
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      return send(req, res, 405, 'Method not allowed', { 'Content-Type': 'text/plain; charset=utf-8', Allow: 'GET, HEAD' });
+    }
+    return await handleStatic(req, res, pathname);
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) send(req, res, 500, 'Internal server error', { 'Content-Type': 'text/plain; charset=utf-8' });
+    else res.destroy();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind is serving on http://localhost:${PORT}`);
+});
