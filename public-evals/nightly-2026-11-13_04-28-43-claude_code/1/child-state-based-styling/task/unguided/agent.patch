     }
+    /* "Make it iced" option */
+    .card {
+      position: relative;
+      border: 2px solid transparent;
+      transition: background 0.3s, border-color 0.3s, box-shadow 0.3s, transform 0.3s;
+    }
+
+    .iced-option {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+      margin-top: 12px;
+      font-size: 0.9rem;
+      cursor: pointer;
+      user-select: none;
+    }
+
+    .iced-option input {
+      width: 1.1rem;
+      height: 1.1rem;
+      accent-color: #0288d1;
+      cursor: pointer;
+    }
+
+    .card .iced-badge {
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      background: #0288d1;
+      color: white;
+      font-size: 0.75rem;
+      font-weight: bold;
+      padding: 2px 8px;
+      border-radius: 999px;
+      opacity: 0;
+      transform: scale(0.8);
+      transition: opacity 0.3s, transform 0.3s;
+      pointer-events: none;
+    }
+
+    .card:has(.iced-option input:checked) {
+      background: linear-gradient(160deg, #e1f5fe 0%, #b3e5fc 100%);
+      border-color: #4fc3f7;
+      box-shadow: 0 4px 14px rgba(2, 136, 209, 0.3);
+      transform: translateY(-2px);
+    }
+
+    .card:has(.iced-option input:checked) h3 {
+      color: #01579b;
+    }
+
+    .card:has(.iced-option input:checked) .iced-badge {
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    .card:has(.iced-option input:checked) .btn {
+      background: #0277bd;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card,
+      .card .iced-badge {
+        transition: none;
+      }
+
+      .card:has(.iced-option input:checked) {
+        transform: none;
+      }
+    }
   </style>
