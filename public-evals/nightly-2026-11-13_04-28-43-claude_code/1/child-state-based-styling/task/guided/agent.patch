       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Seasonal drink cards: "Make it iced" toggle restyles the whole card via :has() */
+    .drink-card {
+      --card-bg: white;
+      --card-border: transparent;
+      --card-heading: var(--primary);
+      --card-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+
+      position: relative;
+      background: var(--card-bg);
+      border: 2px solid var(--card-border);
+      box-shadow: var(--card-shadow);
+      transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
+    }
+
+    .drink-card h3 {
+      color: var(--card-heading);
+      transition: color 0.3s;
+    }
+
+    .iced-toggle {
+      display: flex;
+      justify-content: center;
+      width: fit-content;
+      margin-inline: auto;
+      align-items: center;
+      gap: 0.5rem;
+      margin-top: 12px;
+      font-size: 0.9rem;
+      font-weight: 600;
+      cursor: pointer;
+      accent-color: #0277bd;
+    }
+
+    .iced-toggle input {
+      width: 1.1rem;
+      height: 1.1rem;
+      cursor: pointer;
+    }
+
+    .iced-toggle input:focus-visible {
+      outline: 2px solid #01579b;
+      outline-offset: 2px;
+    }
+
+    .drink-card::after {
+      content: "❄ Iced";
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: #0277bd;
+      color: white;
+      font-size: 0.75rem;
+      font-weight: bold;
+      opacity: 0;
+      transform: scale(0.8);
+      transition: opacity 0.3s, transform 0.3s;
+    }
+
+    .drink-card:has(.iced-toggle input:checked) {
+      --card-bg: linear-gradient(160deg, #e1f5fe, #b3e5fc);
+      --card-border: #4fc3f7;
+      --card-heading: #01579b;
+      --card-shadow: 0 4px 14px rgba(2, 119, 189, 0.3);
+    }
+
+    .drink-card:has(.iced-toggle input:checked)::after {
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    /* Fallback for browsers without :has() (class toggled by script below) */
+    @supports not selector(:has(*)) {
+      .drink-card.is-iced {
+        --card-bg: linear-gradient(160deg, #e1f5fe, #b3e5fc);
+        --card-border: #4fc3f7;
+        --card-heading: #01579b;
+        --card-shadow: 0 4px 14px rgba(2, 119, 189, 0.3);
+      }
+
+      .drink-card.is-iced::after {
+        opacity: 1;
+        transform: scale(1);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .drink-card,
+      .drink-card h3,
+      .drink-card::after {
+        transition: none;
+      }
+    }
+
