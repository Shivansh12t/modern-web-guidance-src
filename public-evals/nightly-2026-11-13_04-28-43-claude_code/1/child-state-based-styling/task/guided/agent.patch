+  <script>
+    // Fallback for browsers without :has(): mirror checkbox state onto the card.
+    if (!CSS.supports('selector(:has(*))')) {
+      document.querySelectorAll('.drink-card').forEach((card) => {
+        const toggle = card.querySelector('.iced-toggle input');
+        toggle?.addEventListener('change', () => {
+          card.classList.toggle('is-iced', toggle.checked);
+        });
+      });
+    }
+  </script>
