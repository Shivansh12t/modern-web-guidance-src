+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          meta: 'Seasonal · 190 cal (medium) · Contains: oats',
+          price: 5.25,
+          milk: true,
+          defaultMilk: 'oat',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=900&q=80'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost. Pulled from our signature dark roast blend.',
+          meta: 'Classic · 5 cal · Single-origin blend',
+          price: 3.25,
+          milk: false,
+          defaultMilk: 'none',
+          image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=900&q=80'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness, served over ice.',
+          meta: 'Iced · 5 cal · Steeped 18 hours',
+          price: 4.50,
+          milk: true,
+          defaultMilk: 'none',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=900&q=80'
+        }
+      };
+      const SIZE_PRICE = { small: 0, medium: 0.5, large: 1 };
+      const MILK_PRICE = { oat: 0.6, almond: 0.6 };
+      const EXTRA_PRICE = { shot: 0.75, vanilla: 0.5, cream: 0.5 };
+
+      const dialog = document.getElementById('order-dialog');
+      const form = document.getElementById('order-form');
+      const drinkSelect = document.getElementById('order-drink');
+      const milkField = document.getElementById('milk-field');
+      const milkSelect = document.getElementById('order-milk');
+      const qtyInput = document.getElementById('order-qty');
+      const totalEl = document.getElementById('order-total');
+      const orderView = document.getElementById('order-view');
+      const successView = document.getElementById('order-success');
+      const discardPanel = document.getElementById('discard-panel');
+      const discardConfirm = document.getElementById('discard-confirm');
+      const discardCancel = document.getElementById('discard-cancel');
+
+      let initialState = '';
+      let allowClose = false;
+      let opener = null;
+
+      Object.entries(DRINKS).forEach(([id, d]) => {
+        drinkSelect.add(new Option(d.name + ' — $' + d.price.toFixed(2), id));
+      });
+
+      function serialize() {
+        const data = new FormData(form);
+        return JSON.stringify([...data.entries()]);
+      }
+
+      function isDirty() {
+        return !successView.hidden ? false : serialize() !== initialState;
+      }
+
+      function renderDrink(id, resetMilk) {
+        const d = DRINKS[id];
+        document.getElementById('order-dialog-title').textContent = d.name;
+        document.getElementById('order-dialog-meta').textContent = d.meta;
+        document.getElementById('order-dialog-description').textContent = d.description;
+        const img = document.getElementById('order-dialog-image');
+        img.hidden = false;
+        img.src = d.image;
+        img.alt = d.name;
+        milkField.hidden = !d.milk;
+        milkSelect.disabled = !d.milk;
+        if (resetMilk) milkSelect.value = d.defaultMilk;
+      }
+
+      function updateTotal() {
+        const d = DRINKS[drinkSelect.value];
+        const data = new FormData(form);
+        let unit = d.price + (SIZE_PRICE[data.get('size')] || 0);
+        if (d.milk) unit += MILK_PRICE[data.get('milk')] || 0;
+        data.getAll('extras').forEach(e => { unit += EXTRA_PRICE[e] || 0; });
+        const qty = Math.min(20, Math.max(1, parseInt(qtyInput.value, 10) || 1));
+        totalEl.textContent = '$' + (unit * qty).toFixed(2);
+        return { unit, qty, total: unit * qty };
+      }
+
+      function openOrder(drinkId, trigger) {
+        opener = trigger || null;
+        form.reset();
+        drinkSelect.value = DRINKS[drinkId] ? drinkId : Object.keys(DRINKS)[0];
+        renderDrink(drinkSelect.value, true);
+        updateTotal();
+        initialState = serialize();
+        orderView.hidden = false;
+        successView.hidden = true;
+        hideDiscardPrompt();
+        allowClose = false;
+        dialog.showModal();
+        document.body.classList.add('dialog-open');
+      }
+
+      function closeDialog() {
+        allowClose = true;
+        dialog.close();
+      }
+
+      function showDiscardPrompt() {
+        discardPanel.hidden = false;
+        discardPanel.scrollIntoView({ block: 'nearest' });
+        discardConfirm.focus();
+      }
+
+      function hideDiscardPrompt() {
+        discardPanel.hidden = true;
+      }
+
+      // Any attempt to dismiss (close button, Cancel, Escape, backdrop click) goes through here.
+      function requestClose() {
+        if (isDirty()) {
+          showDiscardPrompt();
+        } else {
+          closeDialog();
+        }
+      }
+
+      document.querySelectorAll('[data-open-order]').forEach(btn => {
+        btn.addEventListener('click', () => openOrder(btn.dataset.openOrder, btn));
+      });
+
+      dialog.querySelectorAll('[data-request-close]').forEach(btn => {
+        btn.addEventListener('click', requestClose);
+      });
+
+      discardConfirm.addEventListener('click', closeDialog);
+      discardCancel.addEventListener('click', () => {
+        hideDiscardPrompt();
+        drinkSelect.focus();
+      });
+
+      // Handle Escape ourselves so the browser never closes a dirty dialog.
+      dialog.addEventListener('keydown', e => {
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          e.stopPropagation();
+          if (!discardPanel.hidden) {
+            hideDiscardPrompt();
+            drinkSelect.focus();
+          } else {
+            requestClose();
+          }
+        }
+      });
+
+      // Other close requests (e.g. platform back gesture) fire "cancel".
+      dialog.addEventListener('cancel', e => {
+        e.preventDefault();
+        requestClose();
+      });
+
+      // Backdrop click = light dismiss attempt.
+      let pointerDownOnBackdrop = false;
+      dialog.addEventListener('pointerdown', e => { pointerDownOnBackdrop = e.target === dialog; });
+      dialog.addEventListener('click', e => {
+        if (e.target === dialog && pointerDownOnBackdrop) requestClose();
+        pointerDownOnBackdrop = false;
+      });
+
+      // Safety net: if something closed the dialog without going through requestClose, reopen it.
+      dialog.addEventListener('close', () => {
+        if (!allowClose && isDirty()) {
+          dialog.showModal();
+          showDiscardPrompt();
+          return;
+        }
+        allowClose = false;
+        document.body.classList.remove('dialog-open');
+        if (opener) opener.focus();
+      });
+
+      drinkSelect.addEventListener('change', () => renderDrink(drinkSelect.value, true));
+      form.addEventListener('input', () => { hideDiscardPrompt(); updateTotal(); });
+      form.addEventListener('change', updateTotal);
+
+      document.getElementById('order-dialog-image').addEventListener('error', e => { e.target.hidden = true; });
+
+      form.addEventListener('submit', e => {
+        e.preventDefault();
+        const { qty, total } = updateTotal();
+        qtyInput.value = qty;
+        const d = DRINKS[drinkSelect.value];
+        const size = new FormData(form).get('size');
+        document.getElementById('order-success-summary').textContent =
+          qty + ' × ' + size.charAt(0).toUpperCase() + size.slice(1) + ' ' + d.name + ' — $' + total.toFixed(2);
+        hideDiscardPrompt();
+        orderView.hidden = true;
+        successView.hidden = false;
+        successView.querySelector('button').focus();
+      });
+    })();
+  </script>
+
 </body>
 
