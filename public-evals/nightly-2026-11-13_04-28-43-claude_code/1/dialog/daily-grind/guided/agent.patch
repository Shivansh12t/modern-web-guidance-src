+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+        meta: 'Hot · Medium roast · 150 mg caffeine (medium)',
+        price: 5.25,
+        milk: 'Oat milk',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1280&q=70',
+        alt: 'A latte with leaf-shaped foam art in a ceramic cup',
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Notes of dark chocolate and toasted walnut.',
+        meta: 'Hot · Dark roast · 130 mg caffeine per double shot',
+        price: 3.5,
+        milk: 'No milk',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1280&q=70',
+        alt: 'A shot of espresso with golden crema in a small cup',
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness. Low acidity with a naturally sweet finish.',
+        meta: 'Iced · Single origin · 200 mg caffeine (medium)',
+        price: 4.75,
+        milk: 'No milk',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1280&q=70',
+        alt: 'A glass of iced coffee with milk swirling through it',
+      },
+    };
+    const SIZE_DELTA = { Small: -0.5, Medium: 0, Large: 0.75 };
+    const SHOT_PRICE = 0.75;
+    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('order-form');
+    const drinkSelect = document.getElementById('opt-drink');
+    const discardBtn = document.getElementById('discard-btn');
+    const warning = document.getElementById('discard-warning');
+    const status = document.getElementById('order-status');
+    const $ = (id) => document.getElementById(id);
+
+    for (const [slug, d] of Object.entries(DRINKS)) {
+      drinkSelect.add(new Option(`${d.name} — ${money.format(d.price)}`, slug));
+    }
+
+    let snapshot = '';
+    const serialize = () => new URLSearchParams(new FormData(form)).toString();
+    const isDirty = () => serialize() !== snapshot;
+
+    function renderDrink() {
+      const d = DRINKS[drinkSelect.value];
+      $('drink-title').textContent = d.name;
+      $('drink-price').textContent = `from ${money.format(d.price + SIZE_DELTA.Small)}`;
+      $('drink-meta').textContent = d.meta;
+      $('drink-description').textContent = d.description;
+      $('drink-image').src = d.image;
+      $('drink-image').alt = d.alt;
+    }
+
+    function renderTotal() {
+      const data = new FormData(form);
+      const d = DRINKS[data.get('drink')];
+      const qty = Math.max(1, Number(data.get('quantity')) || 1);
+      const each = d.price + SIZE_DELTA[data.get('size')] + SHOT_PRICE * Number(data.get('shots'));
+      $('order-total').textContent = `Total: ${money.format(each * qty)}`;
+    }
+
+    function hideDiscardPrompt() {
+      warning.classList.remove('is-visible');
+      discardBtn.hidden = true;
+    }
+
+    function showDiscardPrompt() {
+      warning.classList.add('is-visible');
+      discardBtn.hidden = false;
+      discardBtn.focus();
+    }
+
+    // While the order has unsaved changes, only our own buttons may close the dialog.
+    function syncDismissal() {
+      const dirty = isDirty();
+      dialog.setAttribute('closedby', dirty ? 'none' : 'any');
+      if (!dirty) hideDiscardPrompt();
+    }
+
+    function requestDismiss() {
+      if (isDirty()) showDiscardPrompt();
+      else dialog.close('');
+    }
+
+    // Populate the dialog for the drink of whichever button opened it.
+    dialog.addEventListener('command', (event) => {
+      if (event.command !== 'show-modal') return;
+      form.reset();
+      const slug = event.source?.dataset.drink;
+      drinkSelect.value = slug in DRINKS ? slug : Object.keys(DRINKS)[0];
+      $('opt-milk').value = DRINKS[drinkSelect.value].milk;
+      renderDrink();
+      renderTotal();
+      snapshot = serialize();
+      hideDiscardPrompt();
+      dialog.setAttribute('closedby', 'any');
+      dialog.returnValue = '';
+    });
+
+    drinkSelect.addEventListener('change', () => {
+      $('opt-milk').value = DRINKS[drinkSelect.value].milk;
+      renderDrink();
+    });
+
+    form.addEventListener('input', () => { renderTotal(); syncDismissal(); });
+    form.addEventListener('change', () => { renderTotal(); syncDismissal(); });
+
+    // Esc / back gesture / light dismiss (and browsers without closedby support).
+    dialog.addEventListener('cancel', (event) => {
+      if (isDirty()) {
+        event.preventDefault();
+        showDiscardPrompt();
+      }
+    });
+
+    form.addEventListener('click', (event) => {
+      const action = event.target.closest('[data-action]')?.dataset.action;
+      if (action === 'dismiss') requestDismiss();
+      if (action === 'discard') dialog.close('');
+    });
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'order') {
+        const data = new FormData(form);
+        const d = DRINKS[data.get('drink')];
+        const milk = data.get('milk') === 'No milk' ? '' : `, ${data.get('milk')}`;
+        status.textContent = `Added ${data.get('quantity')} × ${data.get('size')} ${d.name}${milk} to your order.`;
+      }
+      dialog.returnValue = '';
+      hideDiscardPrompt();
+    });
+
+    // Light-dismiss fallback where closedby is unsupported (e.g. Safari).
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e)) requestDismiss();
+        pressedOutside = false;
+      });
+    }
+  </script>
+
