--- /dev/null
+++ b/reorder.js
@@ -0,0 +1,381 @@
+// Drag-to-reorder for the Seasonal Favorites cards.
+// Cards move left/right within their visual grid row, by pointer (drag the
+// handle) or keyboard (Space to grab, arrows to move, Space to drop, Esc to
+// cancel). The real DOM nodes are reordered so visual, tab and reading order
+// stay in sync, and the order is remembered in localStorage.
+(() => {
+  const grid = document.querySelector('.grid[data-reorder]');
+  if (!grid) return;
+
+  const status = document.getElementById('reorder-status');
+  const STORAGE_KEY = 'daily-grind:seasonal-order';
+  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+  const hasMoveBefore = 'moveBefore' in Element.prototype;
+  const HINT_IDLE = 'Space to reorder';
+  const HINT_GRABBED = 'Arrows to move · Space to drop · Esc to cancel';
+
+  const cards = () => [...grid.children].filter((el) => el.matches('.card'));
+  const nameOf = (card) => card.querySelector('h3').textContent.trim();
+  const isRTL = () => getComputedStyle(grid).direction === 'rtl';
+  const positionOf = (card) => `${cards().indexOf(card) + 1} of ${cards().length}`;
+
+  // Cards that share the given card's visual row (same layout top edge).
+  const rowOf = (card) => {
+    const top = card.offsetTop;
+    return cards().filter((el) => Math.abs(el.offsetTop - top) < 1);
+  };
+
+  // Move the existing node, preserving its state where moveBefore() exists.
+  function move(card, ref) {
+    if (hasMoveBefore) grid.moveBefore(card, ref);
+    else if (ref) ref.before(card);
+    else grid.append(card);
+  }
+
+  // ---- Persistence ---------------------------------------------------------
+  function save() {
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(cards().map((c) => c.dataset.id)));
+    } catch { /* storage unavailable: order just won't persist */ }
+  }
+
+  (function restore() {
+    let saved;
+    try {
+      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
+    } catch { return; }
+    if (!Array.isArray(saved)) return;
+    const all = cards();
+    const byId = new Map(all.map((c) => [c.dataset.id, c]));
+    const ordered = saved.map((id) => byId.get(id)).filter(Boolean);
+    for (const c of all) if (!ordered.includes(c)) ordered.push(c);
+    for (const c of ordered) move(c, null);
+  })();
+
+  // ---- Announcements -------------------------------------------------------
+  let announceTimer;
+  function announce(message) {
+    clearTimeout(announceTimer);
+    status.textContent = '';
+    // Delay so a focus re-announcement (after a before() fallback move)
+    // doesn't swallow the message.
+    announceTimer = setTimeout(() => { status.textContent = message; }, hasMoveBefore ? 100 : 500);
+  }
+
+  // ---- FLIP animation ------------------------------------------------------
+  function snapshot() {
+    return {
+      x: scrollX,
+      y: scrollY,
+      rects: new Map(cards().map((c) => [c, c.getBoundingClientRect()])),
+    };
+  }
+
+  // Animate every card from its recorded position to its current one.
+  // Returns the animation for `focusCard`, if one was started.
+  function flip(before, focusCard) {
+    if (reduceMotion.matches) return null;
+    const scrollDX = scrollX - before.x;
+    const scrollDY = scrollY - before.y;
+    let focusAnim = null;
+    for (const [card, old] of before.rects) {
+      const now = card.getBoundingClientRect();
+      const dx = old.left - now.left - scrollDX;
+      const dy = old.top - now.top - scrollDY;
+      if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) continue;
+      const anim = card.animate(
+        { translate: [`${dx}px ${dy}px`, '0 0'] },
+        { duration: 240, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)' },
+      );
+      if (card === focusCard) focusAnim = anim;
+    }
+    return focusAnim;
+  }
+
+  function revealCard(card) {
+    card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  }
+
+  // ---- Drop-spot detection & marker ---------------------------------------
+  // Returns the node the card should be inserted before (null = end).
+  function dropRef(card, clientX) {
+    const row = rowOf(card);
+    const others = row.filter((el) => el !== card);
+    if (!others.length) return card.nextElementSibling;
+
+    const gridRect = grid.getBoundingClientRect();
+    const raw = clientX - gridRect.left - grid.clientLeft + grid.scrollLeft;
+    const x = Math.min(Math.max(raw, 0), grid.clientWidth + grid.scrollLeft);
+    const rtl = isRTL();
+
+    for (const el of others) {
+      const mid = el.offsetLeft + el.offsetWidth / 2;
+      if (rtl ? x > mid : x < mid) return el;
+    }
+    // Past the last card in the row: insert right after it.
+    return others[others.length - 1].nextElementSibling;
+  }
+
+  const isNoop = (card, ref) => ref === card || ref === card.nextElementSibling;
+
+  function clearMarker() {
+    grid.removeAttribute('data-drop');
+    for (const p of ['--drop-x', '--drop-y', '--drop-h']) grid.style.removeProperty(p);
+  }
+
+  function placeMarker(card, ref) {
+    if (isNoop(card, ref)) { clearMarker(); return; }
+    const row = rowOf(card).filter((el) => el !== card);
+    const idx = ref ? row.indexOf(ref) : -1;
+    const next = idx === -1 ? null : ref;
+    const prev = idx === -1 ? row[row.length - 1] : row[idx - 1];
+    const gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
+    const rtl = isRTL();
+    const anchor = (next ?? prev).getBoundingClientRect();
+
+    let x;
+    if (prev && next) {
+      const a = prev.getBoundingClientRect();
+      const b = next.getBoundingClientRect();
+      x = rtl ? (a.left + b.right) / 2 : (a.right + b.left) / 2;
+    } else if (next) {
+      x = rtl ? anchor.right + gap / 2 : anchor.left - gap / 2;
+    } else {
+      x = rtl ? anchor.left - gap / 2 : anchor.right + gap / 2;
+    }
+
+    grid.style.setProperty('--drop-x', `${x}px`);
+    grid.style.setProperty('--drop-y', `${anchor.top}px`);
+    grid.style.setProperty('--drop-h', `${anchor.height}px`);
+    grid.setAttribute('data-drop', '');
+  }
+
+  // ---- Pointer dragging ----------------------------------------------------
+  let drag = null;
+  let dragToken = 0;
+
+  // Drop the lifted look once the release animation is done, unless the
+  // card has been grabbed again in the meantime.
+  function settle(card, anim, token) {
+    const done = () => {
+      if (card.dataset.dragToken !== String(token)) return;
+      if (drag && drag.card === card) return;
+      card.classList.remove('is-dragging');
+    };
+    if (anim) anim.finished.then(done, done);
+    else done();
+  }
+
+  function updateDrop() {
+    if (!drag) return;
+    drag.ref = dropRef(drag.card, drag.lastX);
+    placeMarker(drag.card, drag.ref);
+  }
+
+  function onScroll() { updateDrop(); }
+
+  grid.addEventListener('pointerdown', (event) => {
+    const handle = event.target.closest('.drag-handle');
+    if (!handle || drag || event.button !== 0 || !event.isPrimary) return;
+    if (keyboard) dropKeyboard();
+
+    const card = handle.closest('.card');
+    card.getAnimations().forEach((a) => a.finish());
+    handle.setPointerCapture(event.pointerId);
+
+    const token = ++dragToken;
+    card.dataset.dragToken = String(token);
+    drag = {
+      card,
+      handle,
+      token,
+      pointerId: event.pointerId,
+      startX: event.clientX,
+      lastX: event.clientX,
+      startRect: card.getBoundingClientRect(),
+      gridRect: grid.getBoundingClientRect(),
+      startScrollX: scrollX,
+      ref: card.nextElementSibling,
+      moved: false,
+    };
+    card.classList.add('is-dragging');
+    document.documentElement.classList.add('is-reordering');
+    addEventListener('scroll', onScroll, { passive: true });
+  });
+
+  document.addEventListener('pointermove', (event) => {
+    if (!drag || event.pointerId !== drag.pointerId) return;
+    drag.lastX = event.clientX;
+    const scrollDX = scrollX - drag.startScrollX;
+    // Keep the card horizontally within the grid.
+    const min = drag.gridRect.left - drag.startRect.left;
+    const max = drag.gridRect.right - drag.startRect.right;
+    const dx = Math.min(Math.max(event.clientX - drag.startX + scrollDX, min), max);
+    if (Math.abs(dx) > 2) drag.moved = true;
+    drag.card.style.translate = `${dx}px 0`;
+    updateDrop();
+  });
+
+  document.addEventListener('pointerup', (event) => {
+    if (drag && event.pointerId === drag.pointerId) endPointerDrag(true);
+  });
+
+  document.addEventListener('pointercancel', (event) => {
+    if (drag && event.pointerId === drag.pointerId) endPointerDrag(false);
+  });
+
+  grid.addEventListener('lostpointercapture', (event) => {
+    if (drag && event.pointerId === drag.pointerId && !drag.handle.hasPointerCapture(event.pointerId)) {
+      endPointerDrag(false);
+    }
+  });
+
+  document.addEventListener('keydown', (event) => {
+    if (drag && event.key === 'Escape') {
+      event.preventDefault();
+      endPointerDrag(false);
+    }
+  });
+
+  function endPointerDrag(commit) {
+    const { card, handle, ref, token, moved } = drag;
+    drag = null;
+    clearMarker();
+    document.documentElement.classList.remove('is-reordering');
+    removeEventListener('scroll', onScroll);
+
+    const willMove = commit && !isNoop(card, ref);
+    const hadFocus = document.activeElement === handle;
+    const before = snapshot(); // includes the card's current drag offset
+    card.style.translate = '';
+
+    if (willMove) {
+      move(card, ref);
+      if (hadFocus && document.activeElement !== handle) handle.focus({ preventScroll: true });
+      revealCard(card);
+    }
+    settle(card, flip(before, card), token);
+
+    if (willMove) {
+      save();
+      announce(`${nameOf(card)} moved to position ${positionOf(card)}.`);
+    } else if (!commit && moved) {
+      announce(`Reorder cancelled. ${nameOf(card)} stays at position ${positionOf(card)}.`);
+    }
+  }
+
+  // ---- Keyboard: grab, move, drop -----------------------------------------
+  let keyboard = null;
+
+  function setHint(card, text) {
+    const hint = card.querySelector('.reorder-hint');
+    if (hint) hint.textContent = text;
+  }
+
+  function grabKeyboard(card, handle) {
+    keyboard = {
+      card,
+      handle,
+      originalNext: card.nextElementSibling,
+      originalIndex: cards().indexOf(card),
+    };
+    handle.setAttribute('aria-pressed', 'true');
+    card.classList.add('is-grabbed');
+    setHint(card, HINT_GRABBED);
+    announce(
+      `${nameOf(card)} grabbed, position ${positionOf(card)}. ` +
+      'Use the left and right arrow keys to move it within its row, Space to drop, Escape to cancel.',
+    );
+  }
+
+  function releaseKeyboardState() {
+    const { card, handle } = keyboard;
+    keyboard = null;
+    handle.setAttribute('aria-pressed', 'false');
+    card.classList.remove('is-grabbed');
+    setHint(card, HINT_IDLE);
+    return card;
+  }
+
+  function dropKeyboard() {
+    const { originalIndex } = keyboard;
+    const card = releaseKeyboardState();
+    if (cards().indexOf(card) !== originalIndex) {
+      save();
+      announce(`${nameOf(card)} dropped at position ${positionOf(card)}.`);
+    }
+  }
+
+  function moveKeyboard(card, ref) {
+    const { handle } = keyboard;
+    const before = snapshot();
+    move(card, ref);
+    if (document.activeElement !== handle) handle.focus({ preventScroll: true });
+    revealCard(card);
+    flip(before, card);
+  }
+
+  function cancelKeyboard() {
+    const { card, originalNext, originalIndex } = keyboard;
+    if (cards().indexOf(card) !== originalIndex) moveKeyboard(card, originalNext);
+    releaseKeyboardState();
+    announce(`Reorder cancelled. ${nameOf(card)} returned to position ${positionOf(card)}.`);
+  }
+
+  function stepKeyboard(key) {
+    const { card } = keyboard;
+    const later = (key === 'ArrowRight') !== isRTL();
+    const row = rowOf(card);
+    const i = row.indexOf(card);
+    const target = later ? row[i + 1] : row[i - 1];
+    const direction = key === 'ArrowRight' ? 'right' : 'left';
+    if (!target) {
+      announce(`${nameOf(card)} can't move further ${direction} in its row.`);
+      return;
+    }
+    moveKeyboard(card, later ? target.nextElementSibling : target);
+    announce(`${nameOf(card)} moved ${direction} to position ${positionOf(card)}.`);
+  }
+
+  grid.addEventListener('keydown', (event) => {
+    const handle = event.target.closest('.drag-handle');
+    if (!handle || drag) return;
+    const card = handle.closest('.card');
+
+    if (event.key === ' ' || event.key === 'Enter') {
+      event.preventDefault();
+      if (event.repeat) return;
+      if (keyboard) dropKeyboard();
+      else grabKeyboard(card, handle);
+      return;
+    }
+    if (!keyboard || keyboard.handle !== handle) return;
+
+    if (event.key === 'Escape') {
+      event.preventDefault();
+      cancelKeyboard();
+    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+      event.preventDefault();
+      stepKeyboard(event.key);
+    } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
+      event.preventDefault(); // moves are limited to the row
+    }
+  });
+
+  // Drop when the grabbed handle loses focus. Check after the event so a
+  // blur caused by our own DOM move (and immediate refocus) is ignored.
+  grid.addEventListener('focusout', (event) => {
+    if (!keyboard || event.target !== keyboard.handle) return;
+    setTimeout(() => {
+      if (keyboard && document.activeElement !== keyboard.handle) dropKeyboard();
+    });
+  });
+
+  // Reveal the whole card (not just the handle) when keyboard focus enters it.
+  grid.addEventListener('focusin', (event) => {
+    const card = event.target.closest('.card');
+    if (!card || !event.target.matches(':focus-visible')) return;
+    if (card.getAnimations().length) return;
+    revealCard(card);
+  });
+})();
