+  <script>
+    // Flavor-profile pies: drawn from the legend data so the legend doubles as the table view.
+    (function () {
+      var COLORS = { sweet: '#d98a1f', roast: '#8a4a22', smooth: '#008fa3', bright: '#b8452f' };
+      var NS = 'http://www.w3.org/2000/svg';
+      var C = 52, R = 48;
+
+      function pt(a) { return [C + R * Math.sin(a), C - R * Math.cos(a)]; }
+
+      document.querySelectorAll('.flavor').forEach(function (box) {
+        var items = Array.prototype.slice.call(box.querySelectorAll('li'));
+        var total = items.reduce(function (s, li) { return s + Number(li.dataset.value); }, 0);
+        var svg = document.createElementNS(NS, 'svg');
+        svg.setAttribute('viewBox', '0 0 104 104');
+        svg.setAttribute('aria-hidden', 'true');
+        var tip = document.createElement('div');
+        tip.className = 'flavor-tip';
+        var start = 0;
+
+        items.forEach(function (li) {
+          var v = Number(li.dataset.value), color = COLORS[li.dataset.key];
+          li.querySelector('.swatch').style.background = color;
+          if (!v) return;
+          var end = start + (v / total) * Math.PI * 2;
+          var path = document.createElementNS(NS, 'path');
+          var d;
+          if (v === total) {
+            d = 'M' + C + ' ' + (C - R) + ' A' + R + ' ' + R + ' 0 1 1 ' + (C - 0.01) + ' ' + (C - R) + 'Z';
+          } else {
+            var a = pt(start), b = pt(end), large = end - start > Math.PI ? 1 : 0;
+            d = 'M' + C + ' ' + C + ' L' + a[0] + ' ' + a[1] + ' A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + b[0] + ' ' + b[1] + 'Z';
+          }
+          path.setAttribute('d', d);
+          path.setAttribute('fill', color);
+          var label = li.firstChild.nextSibling.textContent.trim() + ': ' + v + '%';
+          var mid = pt((start + end) / 2);
+          path.addEventListener('mouseenter', function () {
+            tip.textContent = label;
+            var bx = box.getBoundingClientRect(), sx = svg.getBoundingClientRect();
+            tip.style.left = (sx.left - bx.left + (mid[0] / 104) * sx.width) + 'px';
+            tip.style.top = (sx.top - bx.top + (mid[1] / 104) * sx.height) + 'px';
+            tip.classList.add('show');
+          });
+          path.addEventListener('mouseleave', function () { tip.classList.remove('show'); });
+          svg.appendChild(path);
+          start = end;
+        });
+
+        box.insertBefore(svg, box.firstChild);
+        box.appendChild(tip);
+      });
+    })();
+  </script>
+
