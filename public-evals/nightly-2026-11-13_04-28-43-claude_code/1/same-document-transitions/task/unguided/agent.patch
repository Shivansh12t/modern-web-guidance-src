+  <script>
+    (() => {
+      const items = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1600&q=80',
+          alt: 'Barista pouring steamed milk into a latte, forming latte art.',
+          size: '12 oz / 16 oz',
+          price: '$5.25',
+          notes: 'A double shot of our house espresso, steamed oat milk and real Grade A maple syrup, finished with a pinch of cinnamon. Available through the end of winter.'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1600&q=80',
+          alt: 'Top-down view of a cup of black coffee on a wooden table.',
+          size: 'Single / Double',
+          price: '$3.50',
+          notes: 'Our darkest roast, pulled short for notes of bittersweet chocolate, toasted walnut and a hint of smoke. Best enjoyed straight, or as the base for an Americano.'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1600&q=80',
+          alt: 'Glass of iced cold brew coffee swirled with cream.',
+          size: '16 oz / 24 oz',
+          price: '$4.75',
+          notes: 'Coarse-ground beans steeped cold for 18 hours, producing a low-acid, naturally sweet brew. Served over ice, black or with a splash of cream.'
+        }
+      };
+
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+      const hero = document.getElementById('hero');
+      const title = document.getElementById('title');
+      const backButton = document.getElementById('back-button');
+      const banner = document.querySelector('.banner');
+      const baseTitle = document.title;
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      let currentId = null;
+      let listScrollY = 0;
+
+      const cardFor = (id) => document.querySelector(`.thumbnail[data-id="${CSS.escape(id)}"]`);
+
+      // Give (or remove) the shared-element names on a card's image and title.
+      function tagCard(card, on) {
+        if (!card) return;
+        card.querySelector('img').style.viewTransitionName = on ? 'hero' : '';
+        card.querySelector('.title').style.viewTransitionName = on ? 'title' : '';
+      }
+
+      function fillDetail(item) {
+        hero.src = item.image;
+        hero.alt = item.alt;
+        title.textContent = item.title;
+        document.getElementById('description').textContent = item.description;
+        document.getElementById('detail-size').textContent = item.size;
+        document.getElementById('detail-price').textContent = item.price;
+        document.getElementById('detail-notes').textContent = item.notes;
+      }
+
+      // Wait (briefly) for the hero to be decoded so the "new" snapshot isn't blank.
+      function heroReady() {
+        if (hero.complete && hero.naturalWidth) return Promise.resolve();
+        return Promise.race([
+          hero.decode().catch(() => { }),
+          new Promise((r) => setTimeout(r, 400))
+        ]);
+      }
+
+      function showDetail(id) {
+        const card = cardFor(id);
+        listScrollY = window.scrollY;
+        tagCard(card, false);
+        fillDetail(items[id]);
+        listPage.hidden = true;
+        banner.hidden = true;
+        detailPage.hidden = false;
+        currentId = id;
+        document.title = `${items[id].title} | ${baseTitle}`;
+        window.scrollTo(0, 0);
+        return heroReady();
+      }
+
+      function showList() {
+        const card = currentId && cardFor(currentId);
+        detailPage.hidden = true;
+        banner.hidden = false;
+        listPage.hidden = false;
+        document.title = baseTitle;
+        tagCard(card, true);
+        window.scrollTo(0, listScrollY);
+        currentId = null;
+        return card;
+      }
+
+      function transition(update) {
+        if (!document.startViewTransition || reduceMotion.matches) {
+          update();
+          return Promise.resolve();
+        }
+        return document.startViewTransition(update).finished.catch(() => { });
+      }
+
+      async function route() {
+        const id = location.hash.slice(1);
+        const target = items[id] ? id : null;
+        if (target === currentId) return;
+
+        if (target) {
+          // Name the clicked card *before* the old snapshot is taken.
+          if (currentId) tagCard(cardFor(currentId), false);
+          tagCard(cardFor(target), true);
+          await transition(() => showDetail(target));
+          title.focus();
+        } else {
+          let card;
+          await transition(() => { card = showList(); });
+          tagCard(card, false);
+          if (card) card.focus({ preventScroll: true });
+        }
+      }
+
+      backButton.addEventListener('click', () => {
+        // If we came from the list, go back in history; otherwise navigate to the list.
+        if (history.state && history.state.fromList) {
+          history.back();
+        } else {
+          history.pushState(null, '', location.pathname + location.search);
+          route();
+        }
+      });
+
+      document.querySelectorAll('.thumbnail').forEach((card) => {
+        card.addEventListener('click', (e) => {
+          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+          e.preventDefault();
+          history.pushState({ fromList: true }, '', card.getAttribute('href'));
+          route();
+        });
+      });
+
+      window.addEventListener('popstate', route);
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && currentId) backButton.click();
+      });
+
+      // Deep link support (no animation on first load).
+      if (items[location.hash.slice(1)]) {
+        showDetail(location.hash.slice(1));
+      }
+    })();
+  </script>
+
 </body>
 
