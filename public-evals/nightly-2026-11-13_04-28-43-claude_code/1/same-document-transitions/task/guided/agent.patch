+  <script>
+    const listPage = document.getElementById("list-page");
+    const detailPage = document.getElementById("detail-page");
+    const hero = document.getElementById("hero");
+    const title = document.getElementById("title");
+    const description = document.getElementById("detail-description");
+    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
+    let transitioning = false;
+
+    // Run a DOM update, morphing it with a view transition when supported and motion is allowed.
+    function transition(update, after) {
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        after();
+        return;
+      }
+      transitioning = true;
+      const vt = document.startViewTransition(update);
+      vt.finished.finally(() => {
+        transitioning = false;
+        after();
+      });
+    }
+
+    function showDetail(card) {
+      if (transitioning) return;
+      document.querySelectorAll(".thumbnail.selected").forEach((el) => el.classList.remove("selected"));
+      // Name the clicked card/title before the "old" snapshot is captured.
+      card.classList.add("selected");
+      const img = card.querySelector("img");
+
+      transition(() => {
+        hero.src = img.currentSrc || img.src;
+        hero.alt = img.alt;
+        title.textContent = card.querySelector(".title").textContent.trim();
+        description.textContent = card.querySelector(".description").textContent.trim();
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        title.scrollIntoView({ block: "start" });
+      }, () => title.focus({ preventScroll: true }));
+    }
+
+    function showList() {
+      if (transitioning || detailPage.hidden) return;
+      const listHeading = document.getElementById("list-heading");
+      const selected = document.querySelector(".thumbnail.selected");
+
+      transition(() => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        (selected ?? listHeading).scrollIntoView({ block: "center" });
+      }, () => {
+        listHeading.focus({ preventScroll: true });
+        // Remove temporary names so the next navigation starts clean.
+        document.querySelectorAll(".thumbnail.selected").forEach((el) => el.classList.remove("selected"));
+      });
+    }
+
+    listPage.addEventListener("click", (e) => {
+      const card = e.target.closest(".thumbnail");
+      if (card) showDetail(card);
+    });
+    document.getElementById("back-button").addEventListener("click", showList);
+    document.addEventListener("keydown", (e) => {
+      if (e.key === "Escape") showList();
+    });
+  </script>
+
