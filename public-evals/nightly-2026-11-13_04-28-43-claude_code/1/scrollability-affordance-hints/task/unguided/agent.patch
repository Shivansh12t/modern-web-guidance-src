+  <script>
+    document.querySelectorAll('.reviews-wrapper').forEach(function (wrapper) {
+      var list = wrapper.querySelector('.reviews-scroll');
+      var THRESHOLD = 1; // tolerate sub-pixel rounding
+
+      function update() {
+        var canUp = list.scrollTop > THRESHOLD;
+        var canDown = list.scrollHeight - list.clientHeight - list.scrollTop > THRESHOLD;
+        wrapper.classList.toggle('can-scroll-up', canUp);
+        wrapper.classList.toggle('can-scroll-down', canDown);
+      }
+
+      list.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(update).observe(list);
+      }
+      update();
+    });
+  </script>
+
