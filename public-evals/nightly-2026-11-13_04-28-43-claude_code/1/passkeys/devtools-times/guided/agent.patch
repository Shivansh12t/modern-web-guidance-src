+
+/** Update account details. Sensitive: requires a recent reauthentication. */
+export const PUT: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return error('Please sign in.', 401);
+  if (!(await isRecentlyReauthenticated(context))) {
+    return error('Please confirm it’s you to continue.', 403, 'REAUTH_REQUIRED');
+  }
+
+  const { displayName } = await readJson<{ displayName?: string }>(context.request);
+  const name = displayName?.trim();
+  if (!name) return error('Display name is required.');
