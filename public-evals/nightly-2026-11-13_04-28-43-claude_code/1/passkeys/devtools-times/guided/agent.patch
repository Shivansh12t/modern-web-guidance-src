+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { SESSION, error, getRelyingParty, getSessionUser, isRecentlyReauthenticated, json, readJson } from '../../../../lib/auth/server';
+import { listCredentials } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return error('Please sign in.', 401);
+  if (!(await isRecentlyReauthenticated(context))) {
+    return error('Please confirm it’s you to continue.', 403, 'REAUTH_REQUIRED');
+  }
+
+  // promotion: offered right after sign-in/sign-up → platform authenticators only.
+  // conditional: silent post-password-login creation (conditional create).
+  const { promotion = false, conditional = false } = await readJson<{ promotion?: boolean; conditional?: boolean }>(
+    context.request,
+  );
+  const { rpID, rpName } = getRelyingParty(context);
+  const existing = await listCredentials(user.passkeyUserId);
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userID: Buffer.from(user.passkeyUserId, 'base64url'),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...((promotion || conditional) && { authenticatorAttachment: 'platform' as const }),
+    },
+  });
+
+  context.session?.set(SESSION.registration, {
+    challenge: options.challenge,
+    conditional: Boolean(conditional),
+  });
+  return json(options);
+};
