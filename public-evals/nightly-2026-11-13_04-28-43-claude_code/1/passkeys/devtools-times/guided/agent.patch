+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,448 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import {
+  api,
+  ApiError,
+  getCapabilities,
+  registerPasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  type Capabilities,
+  type PasskeyInfo,
+  type SessionUser,
+} from '../lib/passkeys';
+import { useReauth } from './auth/ReauthDialog';
+import {
+  Alert,
+  PasskeyIcon,
+  dangerButtonClass,
+  inputClass,
+  primaryButtonClass,
+  secondaryButtonClass,
+  withBase,
+} from './auth/ui';
+
+type Status = { kind: 'error' | 'success'; text: string } | null;
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const dateTimeFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+export default function AccountSettings() {
+  const [user, setUser] = useState<SessionUser | null>(null);
+  const [loaded, setLoaded] = useState(false);
+  const [passkeys, setPasskeys] = useState<PasskeyInfo[]>([]);
+  const [capabilities, setCapabilities] = useState<Capabilities>({});
+  const [status, setStatus] = useState<Status>(null);
+  const [creating, setCreating] = useState(false);
+  const [renaming, setRenaming] = useState<PasskeyInfo | null>(null);
+  const [deleting, setDeleting] = useState<PasskeyInfo | null>(null);
+
+  // getCapabilities() resolves to {} when WebAuthn is unavailable.
+  const passkeysSupported = Object.keys(capabilities).length > 0;
+  const canCreatePasskey = Boolean(capabilities.passkeyPlatformAuthenticator);
+  const { withReauth, dialog: reauthDialog } = useReauth({ hasPasskeys: passkeys.length > 0, passkeysSupported });
+
+  /** Loads the passkey list and syncs it to the user's passkey provider. */
+  const refreshPasskeys = useCallback(async () => {
+    const { rpId, userId, credentials } = await api<{ rpId: string; userId: string; credentials: PasskeyInfo[] }>(
+      'passkeys',
+    );
+    setPasskeys(credentials);
+    // Keep password managers in sync with what the server still accepts.
+    signalAllAcceptedCredentials(rpId, userId, credentials.map((c) => c.id));
+    return credentials;
+  }, []);
+
+  useEffect(() => {
+    (async () => {
+      getCapabilities().then(setCapabilities);
+      try {
+        const { user } = await api<{ user: SessionUser | null }>('session');
+        setUser(user);
+        if (user) await refreshPasskeys();
+      } catch (e) {
+        setStatus({ kind: 'error', text: e instanceof ApiError ? e.message : 'Could not load your account.' });
+      } finally {
+        setLoaded(true);
+      }
+    })();
+  }, [refreshPasskeys]);
+
+  const report = (e: unknown, fallback: string) =>
+    setStatus({ kind: 'error', text: e instanceof ApiError ? e.message : fallback });
+
+  const createPasskey = async () => {
+    setStatus(null);
+    setCreating(true);
+    try {
+      // Adding a sign-in method is sensitive: the server may ask for a fresh verification.
+      const result = await withReauth('Verify your identity before adding a new passkey.', async () => {
+        const r = await registerPasskey();
+        if (r.status === 'error' && r.code === 'REAUTH_REQUIRED') throw new ApiError(r.message, 403, r.code);
+        return r;
+      });
+      if (!result) return;
+      if (result.status === 'created') {
+        await refreshPasskeys();
+        setStatus({ kind: 'success', text: `Passkey “${result.credential.name}” created.` });
+      } else if (result.status === 'exists') {
+        setStatus({ kind: 'error', text: 'A passkey for this account already exists in that password manager.' });
+      } else if (result.status === 'error') {
+        setStatus({ kind: 'error', text: result.message });
+      } else if (result.status === 'unsupported') {
+        setStatus({ kind: 'error', text: 'Passkeys aren’t supported in this browser.' });
+      }
+    } catch (e) {
+      report(e, 'Could not create a passkey.');
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const renamePasskey = async (passkey: PasskeyInfo, name: string) => {
+    setStatus(null);
+    try {
+      // Nickname is a server-side label only; no Signal API call needed.
+      await api(`passkeys/${encodeURIComponent(passkey.id)}`, { method: 'PATCH', body: { name } });
+      await refreshPasskeys();
+      setStatus({ kind: 'success', text: 'Passkey renamed.' });
+    } catch (e) {
+      report(e, 'Could not rename the passkey.');
+    }
+  };
+
+  const deletePasskey = async (passkey: PasskeyInfo) => {
+    setStatus(null);
+    try {
+      const done = await withReauth('Verify your identity before removing a passkey.', () =>
+        api(`passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' }),
+      );
+      if (!done) return;
+      await refreshPasskeys(); // also signals the remaining accepted credentials
+      setStatus({
+        kind: 'success',
+        text: `Passkey “${passkey.name}” removed. You may also remove it from your password manager.`,
+      });
+    } catch (e) {
+      report(e, 'Could not remove the passkey.');
+    }
+  };
+
+  const signOut = async () => {
+    await api('logout', { body: {} }).catch(() => {});
+    window.location.assign(withBase(''));
+  };
+
+  if (!loaded) {
+    return <p className="max-w-2xl mx-auto mt-10 text-gray-600" role="status">Loading your account…</p>;
+  }
+
+  if (!user) {
+    return (
+      <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <h1 className="text-2xl font-bold mb-2 text-gray-800">Account settings</h1>
+        <p className="text-sm text-gray-600 mb-6">Sign in to manage your account and passkeys.</p>
+        {status && <Alert kind={status.kind}>{status.text}</Alert>}
+        <a href={`${withBase('signin')}?next=${encodeURIComponent(withBase('account'))}`} className={primaryButtonClass}>
+          Sign in
+        </a>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex flex-wrap items-baseline justify-between gap-4">
+        <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+        <button type="button" onClick={signOut} className={secondaryButtonClass}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">{status && <Alert kind={status.kind}>{status.text}</Alert>}</div>
+
+      <ProfileSection
+        user={user}
+        onSave={async (displayName) => {
+          setStatus(null);
+          try {
+            const res = await withReauth('Verify your identity before changing your account details.', () =>
+              api<{ user: SessionUser }>('user', { method: 'PUT', body: { displayName } }),
+            );
+            if (!res) return false;
+            setUser(res.user);
+            // Update the name shown in the user's passkey provider.
+            signalCurrentUserDetails(res.user);
+            setStatus({ kind: 'success', text: 'Account details updated.' });
+            return true;
+          } catch (e) {
+            report(e, 'Could not update your account.');
+            return false;
+          }
+        }}
+      />
+
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">
+              Passkeys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1 max-w-prose">
+              Passkeys let you sign in with your fingerprint, face, screen lock or a security key — no password needed.
+            </p>
+          </div>
+          {canCreatePasskey && (
+            <button type="button" onClick={createPasskey} disabled={creating} className={primaryButtonClass}>
+              <PasskeyIcon />
+              {creating ? 'Creating…' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!canCreatePasskey && (
+          <Alert kind="info">
+            This browser or device can’t create passkeys. You can keep signing in with your password, or add a passkey
+            from another device.
+          </Alert>
+        )}
+
+        {passkeys.length === 0 ? (
+          <p className="text-sm text-gray-600 py-6 text-center border border-dashed border-gray-300 rounded-md">
+            No passkeys found.
+          </p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {passkeys.map((p) => (
+              <li key={p.id} className="flex flex-wrap items-center gap-4 p-4">
+                <ProviderIcon passkey={p} />
+                <div className="min-w-0 flex-1">
+                  <p className="font-medium text-gray-900 truncate">
+                    {p.name}
+                    {p.credentialBackedUp && (
+                      <span className="ml-2 align-middle rounded bg-gray-100 px-1.5 py-0.5 text-xs font-normal text-gray-600">
+                        Synced
+                      </span>
+                    )}
+                  </p>
+                  <p className="text-xs text-gray-500">
+                    Created <time dateTime={new Date(p.registeredAt).toISOString()}>{dateFormat.format(p.registeredAt)}</time>
+                    {' · '}
+                    {p.lastUsedAt ? (
+                      <>
+                        Last used{' '}
+                        <time dateTime={new Date(p.lastUsedAt).toISOString()}>{dateTimeFormat.format(p.lastUsedAt)}</time>
+                      </>
+                    ) : (
+                      'Never used to sign in'
+                    )}
+                  </p>
+                </div>
+                <div className="flex gap-2">
+                  <button type="button" className={secondaryButtonClass} onClick={() => setRenaming(p)}>
+                    Rename<span className="sr-only"> {p.name}</span>
+                  </button>
+                  <button type="button" className={secondaryButtonClass} onClick={() => setDeleting(p)}>
+                    Delete<span className="sr-only"> {p.name}</span>
+                  </button>
+                </div>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {renaming && (
+        <RenameDialog
+          passkey={renaming}
+          onClose={(name) => {
+            const target = renaming;
+            setRenaming(null);
+            if (name && name !== target.name) renamePasskey(target, name);
+          }}
+        />
+      )}
+
+      {deleting && (
+        <ConfirmDeleteDialog
+          passkey={deleting}
+          isLast={passkeys.length === 1}
+          onClose={(confirmed) => {
+            const target = deleting;
+            setDeleting(null);
+            if (confirmed) deletePasskey(target);
+          }}
+        />
+      )}
+
+      {reauthDialog}
+    </div>
+  );
+}
+
+function ProviderIcon({ passkey }: { passkey: PasskeyInfo }) {
+  const { light, dark } = passkey.providerIcon ?? {};
+  if (!light && !dark) {
+    return (
+      <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700">
+        <PasskeyIcon />
+      </span>
+    );
+  }
+  return (
+    <picture className="shrink-0">
+      {dark && <source srcSet={dark} media="(prefers-color-scheme: dark)" />}
+      <img src={light ?? dark} alt="" width={40} height={40} className="h-10 w-10 rounded" />
+    </picture>
+  );
+}
+
+function ProfileSection({ user, onSave }: { user: SessionUser; onSave: (displayName: string) => Promise<boolean> }) {
+  const [displayName, setDisplayName] = useState(user.displayName);
+  const [saving, setSaving] = useState(false);
+  useEffect(() => setDisplayName(user.displayName), [user.displayName]);
+
+  return (
+    <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 id="profile-heading" className="text-xl font-bold text-gray-900 mb-4">
+        Profile
+      </h2>
+      <form
+        className="space-y-4"
+        onSubmit={async (e) => {
+          e.preventDefault();
+          setSaving(true);
+          await onSave(displayName.trim());
+          setSaving(false);
+        }}
+      >
+        <div>
+          <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+            Username
+          </label>
+          <input id="account-username" value={user.username} readOnly className={`${inputClass} bg-gray-50 text-gray-600`} />
+        </div>
+        <div>
+          <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+            Display name
+          </label>
+          <input
+            id="account-display-name"
+            autoComplete="name"
+            maxLength={64}
+            required
+            value={displayName}
+            onChange={(e) => setDisplayName(e.target.value)}
+            aria-describedby="display-name-hint"
+            className={inputClass}
+          />
+          <p id="display-name-hint" className="text-xs text-gray-500 mt-1">
+            Shown in your password manager next to your passkeys.
+          </p>
+        </div>
+        <button
+          type="submit"
+          className={primaryButtonClass}
+          disabled={saving || !displayName.trim() || displayName.trim() === user.displayName}
+        >
+          {saving ? 'Saving…' : 'Save changes'}
+        </button>
+      </form>
+    </section>
+  );
+}
+
+/** Opens a native modal <dialog> on mount and reports its returnValue on close. */
+function useModal(onClose: (returnValue: string) => void) {
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    const dialog = ref.current!;
+    dialog.returnValue = '';
+    dialog.showModal();
+    const handle = () => {
+      const value = dialog.returnValue;
+      dialog.returnValue = '';
+      onClose(value);
+    };
+    dialog.addEventListener('close', handle);
+    return () => dialog.removeEventListener('close', handle);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+  return ref;
+}
+
+const dialogClass = 'm-auto w-[min(28rem,calc(100vw-2rem))] rounded-lg bg-white p-6 shadow-xl';
+
+function RenameDialog({ passkey, onClose }: { passkey: PasskeyInfo; onClose: (name?: string) => void }) {
+  const [name, setName] = useState(passkey.name);
+  const ref = useModal((value) => onClose(value === 'save' ? name.trim() : undefined));
+  const titleId = useId();
+  const inputId = useId();
+
+  return (
+    <dialog ref={ref} aria-labelledby={titleId} {...({ closedby: 'any' } as any)} className={dialogClass}>
+      <h2 id={titleId} className="text-xl font-bold text-gray-800 mb-4">
+        Rename passkey
+      </h2>
+      <form method="dialog" className="space-y-4">
+        <div>
+          <label htmlFor={inputId} className="block text-sm font-medium text-gray-700 mb-1">
+            Name
+          </label>
+          <input
+            id={inputId}
+            autoFocus
+            required
+            maxLength={64}
+            autoComplete="off"
+            value={name}
+            onChange={(e) => setName(e.target.value)}
+            className={inputClass}
+          />
+        </div>
+        <div className="flex justify-end gap-2">
+          {/* type="button" so pressing Enter in the field submits "save", the default button. */}
+          <button type="button" onClick={() => ref.current?.close('cancel')} className={secondaryButtonClass}>
+            Cancel
+          </button>
+          <button value="save" className={primaryButtonClass}>
+            Save
+          </button>
+        </div>
+      </form>
+    </dialog>
+  );
+}
+
+function ConfirmDeleteDialog({
+  passkey,
+  isLast,
+  onClose,
+}: {
+  passkey: PasskeyInfo;
+  isLast: boolean;
+  onClose: (confirmed: boolean) => void;
+}) {
+  const ref = useModal((value) => onClose(value === 'delete'));
+  const titleId = useId();
+  const descId = useId();
+
+  return (
+    <dialog ref={ref} aria-labelledby={titleId} aria-describedby={descId} {...({ closedby: 'any' } as any)} className={dialogClass}>
+      <h2 id={titleId} className="text-xl font-bold text-gray-800 mb-2">
+        Delete “{passkey.name}”?
+      </h2>
+      <p id={descId} className="text-sm text-gray-600 mb-6">
+        You won’t be able to sign in with this passkey anymore.
+        {isLast && ' It’s your only passkey, so you’ll need your password to sign in.'}
+      </p>
+      <form method="dialog" className="flex justify-end gap-2">
+        <button value="cancel" autoFocus className={secondaryButtonClass}>
+          Cancel
+        </button>
+        <button value="delete" className={dangerButtonClass}>
+          Delete passkey
+        </button>
+      </form>
+    </dialog>
+  );
+}
