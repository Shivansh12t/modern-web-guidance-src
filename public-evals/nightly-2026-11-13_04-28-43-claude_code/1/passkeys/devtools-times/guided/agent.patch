+import type { APIRoute } from 'astro';
+import { error, getSessionUser, isRecentlyReauthenticated, json, publicCredential, readJson } from '../../../../lib/auth/server';
+import { deleteCredential, getCredential, updateCredential } from '../../../../lib/auth/store';
+
+async function ownedCredential(context: Parameters<APIRoute>[0]) {
+  const user = await getSessionUser(context);
+  if (!user) return { response: error('Please sign in.', 401) };
+  const cred = context.params.id ? await getCredential(context.params.id) : null;
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return { response: error('Passkey not found.', 404) };
+  }
+  return { cred };
+}
+
+/** Rename a passkey (server-side label only). */
+export const PATCH: APIRoute = async (context) => {
+  const { cred, response } = await ownedCredential(context);
+  if (!cred) return response;
+  const { name } = await readJson<{ name?: string }>(context.request);
+  const trimmed = name?.trim();
+  if (!trimmed) return error('Name is required.');
+  if (trimmed.length > 64) return error('Name must be 64 characters or fewer.');
+  const updated = await updateCredential(cred.id, { name: trimmed });
+  return json({ credential: publicCredential(updated!) });
+};
+
+/** Delete a passkey. Sensitive: requires a recent reauthentication. */
+export const DELETE: APIRoute = async (context) => {
+  const { cred, response } = await ownedCredential(context);
+  if (!cred) return response;
+  if (!(await isRecentlyReauthenticated(context))) {
+    return error('Please confirm it’s you to continue.', 403, 'REAUTH_REQUIRED');
+  }
+  await deleteCredential(cred.id);
+  return json({ success: true });
+};
