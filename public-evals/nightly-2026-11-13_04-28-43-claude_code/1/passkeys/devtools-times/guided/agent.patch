--- /dev/null
+++ b/src/lib/auth/aaguid.ts
@@ -0,0 +1,45 @@
+/**
+ * Resolves passkey provider names/icons from the community AAGUID registry.
+ * AAGUIDs are used for UX hints only — never for security decisions.
+ */
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+type Registry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+
+let registry: Promise<Registry> | null = null;
+
+function loadRegistry(): Promise<Registry> {
+  registry ??= fetch(REGISTRY_URL, { signal: AbortSignal.timeout(4000) })
+    .then((r) => (r.ok ? (r.json() as Promise<Registry>) : {}))
+    .catch(() => {
+      registry = null; // retry next time
+      return {};
+    });
+  return registry;
+}
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+export async function lookupProvider(aaguid: string, userAgent = '') {
+  if (aaguid && aaguid !== ZERO_AAGUID) {
+    const provider = (await loadRegistry())[aaguid];
+    if (provider) {
+      return {
+        name: provider.name,
+        providerIcon: { light: provider.icon_light, dark: provider.icon_dark },
+      };
+    }
+  }
+  return { name: guessDeviceName(userAgent), providerIcon: undefined };
+}
+
+function guessDeviceName(ua: string) {
+  if (/iPhone|iPad/.test(ua)) return 'Passkey on iOS';
+  if (/Android/.test(ua)) return 'Passkey on Android';
+  if (/Mac OS X/.test(ua)) return 'Passkey on macOS';
+  if (/Windows/.test(ua)) return 'Passkey on Windows';
+  if (/CrOS/.test(ua)) return 'Passkey on ChromeOS';
+  if (/Linux/.test(ua)) return 'Passkey on Linux';
+  return 'Unknown passkey provider';
+}
diff --git a/src/lib/auth/server.ts b/src/lib/auth/server.ts
new file mode 100644
index 0000000..105eff0
--- /dev/null
+++ b/src/lib/auth/server.ts
@@ -0,0 +1,104 @@
+import type { APIContext } from 'astro';
+import { ensureUser, getUser, type StoredPasskeyCredential, type StoredUser } from './store';
+
+export const RP_NAME = 'The DevTools Times';
+/** How long a successful reauthentication unlocks sensitive account actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+export const UPSTREAM_AUTH_URL =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/**
+ * Relying Party configuration. Set PASSKEY_RP_ID / PASSKEY_ORIGIN in production so
+ * the RP ID is a fixed constant; otherwise it falls back to the serving host.
+ * Clients always read the RP ID from server-provided options, never from location.
+ */
+export function getRelyingParty(context: APIContext) {
+  const rpID = process.env.PASSKEY_RP_ID ?? context.url.hostname;
+  const origins = (process.env.PASSKEY_ORIGIN ?? context.url.origin)
+    .split(',')
+    .map((o: string) => o.trim())
+    .filter(Boolean);
+  return { rpID, rpName: RP_NAME, expectedOrigin: origins };
+}
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export const error = (message: string, status = 400, code?: string) =>
+  json({ error: message, ...(code && { code }) }, status);
+
+/** Session keys used by the auth flows. */
+export const SESSION = {
+  user: 'authUser',
+  registration: 'passkeyRegistration',
+  authentication: 'passkeyAuthentication',
+  reauth: 'passkeyReauth',
+  reauthAt: 'reauthenticatedAt',
+} as const;
+
+export async function getSessionUser(context: APIContext): Promise<StoredUser | null> {
+  const username = await context.session?.get(SESSION.user);
+  if (typeof username !== 'string') return null;
+  return getUser(username);
+}
+
+export async function signIn(context: APIContext, username: string) {
+  const user = await ensureUser(username);
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await context.session?.regenerate();
+  context.session?.set(SESSION.user, user.username);
+  // A fresh primary sign-in counts as a recent verification.
+  context.session?.set(SESSION.reauthAt, Date.now());
+  return user;
+}
+
+export async function isRecentlyReauthenticated(context: APIContext) {
+  const at = await context.session?.get(SESSION.reauthAt);
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export function publicUser(user: StoredUser, rpID: string) {
+  return {
+    username: user.username,
+    displayName: user.displayName,
+    userId: user.passkeyUserId,
+    rpId: rpID,
+  };
+}
+
+export function publicCredential(c: StoredPasskeyCredential) {
+  return {
+    id: c.id,
+    name: c.name,
+    aaguid: c.aaguid,
+    providerIcon: c.providerIcon,
+    credentialDeviceType: c.credentialDeviceType,
+    credentialBackedUp: c.credentialBackedUp,
+    transports: c.transports,
+    registeredAt: c.registeredAt,
+    lastUsedAt: c.lastUsedAt,
+  };
+}
+
+/** Verifies a username/password pair against the upstream Times auth service. */
+export async function verifyPasswordUpstream(username: string, password: string) {
+  const res = await fetch(`${UPSTREAM_AUTH_URL}/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await res.json().catch(() => ({}));
+  return { ok: res.ok, status: res.status, data };
+}
+
+export async function readJson<T = any>(request: Request): Promise<T> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return {} as T;
+  }
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..2e3b2c0
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,146 @@
+/**
+ * Minimal file-backed store for local account profiles and passkey credentials.
+ *
+ * Passwords are verified by the upstream Times auth service; this store only keeps
+ * the data the passkey flows need (stable WebAuthn user handle, display name and
+ * registered credentials). Swap this module for a real database in production.
+ */
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+export interface StoredUser {
+  /** Account username (also the WebAuthn `user.name`). */
+  username: string;
+  /** Human-friendly name shown by passkey providers. */
+  displayName: string;
+  /** Unpadded Base64URL WebAuthn user handle (`user.id`). Never changes. */
+  passkeyUserId: string;
+  createdAt: number;
+}
+
+export interface StoredPasskeyCredential {
+  /** Base64URL-encoded credential ID (unique lookup key). */
+  id: string;
+  /** Associated application user handle. */
+  passkeyUserId: string;
+  /** Base64URL-encoded COSE public key. */
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: { light?: string; dark?: string };
+  /** Provider name derived from the AAGUID registry, or a user-chosen nickname. */
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Database {
+  users: Record<string, StoredUser>;
+  credentials: StoredPasskeyCredential[];
+}
+
+const DB_PATH = resolve(process.env.AUTH_DATA_FILE ?? '.data/auth.json');
+
+let cache: Database | null = null;
+let writeQueue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Database> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DB_PATH, 'utf8')) as Database;
+  } catch {
+    cache = { users: {}, credentials: [] };
+  }
+  cache.users ??= {};
+  cache.credentials ??= [];
+  return cache;
+}
+
+function persist(db: Database) {
+  // Serialize writes and replace the file atomically.
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(dirname(DB_PATH), { recursive: true });
+    const tmp = `${DB_PATH}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(db, null, 2));
+    await rename(tmp, DB_PATH);
+  });
+  return writeQueue;
+}
+
+const userKey = (username: string) => username.trim().toLowerCase();
+
+export async function getUser(username: string) {
+  const db = await load();
+  return db.users[userKey(username)] ?? null;
+}
+
+export async function getUserByPasskeyUserId(passkeyUserId: string) {
+  const db = await load();
+  return Object.values(db.users).find((u) => u.passkeyUserId === passkeyUserId) ?? null;
+}
+
+/** Returns the local profile for a username, creating it on first sign-in. */
+export async function ensureUser(username: string) {
+  const db = await load();
+  const key = userKey(username);
+  if (!db.users[key]) {
+    db.users[key] = {
+      username: username.trim(),
+      displayName: username.trim(),
+      passkeyUserId: randomBytes(32).toString('base64url'),
+      createdAt: Date.now(),
+    };
+    await persist(db);
+  }
+  return db.users[key];
+}
+
+export async function updateUser(username: string, changes: Pick<StoredUser, 'displayName'>) {
+  const db = await load();
+  const user = db.users[userKey(username)];
+  if (!user) return null;
+  user.displayName = changes.displayName;
+  await persist(db);
+  return user;
+}
+
+export async function listCredentials(passkeyUserId: string) {
+  const db = await load();
+  return db.credentials
+    .filter((c) => c.passkeyUserId === passkeyUserId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export async function getCredential(id: string) {
+  const db = await load();
+  return db.credentials.find((c) => c.id === id) ?? null;
+}
+
+export async function addCredential(credential: StoredPasskeyCredential) {
+  const db = await load();
+  db.credentials.push(credential);
+  await persist(db);
+}
+
+export async function updateCredential(
+  id: string,
+  changes: Partial<Pick<StoredPasskeyCredential, 'name' | 'counter' | 'lastUsedAt' | 'credentialBackedUp'>>,
+) {
+  const db = await load();
+  const cred = db.credentials.find((c) => c.id === id);
+  if (!cred) return null;
+  Object.assign(cred, changes);
+  await persist(db);
+  return cred;
+}
+
+export async function deleteCredential(id: string) {
+  const db = await load();
+  db.credentials = db.credentials.filter((c) => c.id !== id);
+  await persist(db);
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..b9a03d7
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,255 @@
+/**
+ * Browser-side WebAuthn helpers. Uses the native WebAuthn APIs directly, with
+ * `webauthn-polyfills` loaded lazily for getClientCapabilities / JSON parsing.
+ * The RP ID is always taken from server responses, never window.location.
+ */
+const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+
+export type Capabilities = Partial<Record<
+  | 'conditionalCreate'
+  | 'conditionalGet'
+  | 'passkeyPlatformAuthenticator'
+  | 'userVerifyingPlatformAuthenticator'
+  | 'signalAllAcceptedCredentials'
+  | 'signalCurrentUserDetails'
+  | 'signalUnknownCredential',
+  boolean
+>>;
+
+export interface SessionUser {
+  username: string;
+  displayName: string;
+  userId: string;
+  rpId: string;
+}
+
+export interface PasskeyInfo {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: { light?: string; dark?: string };
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  transports: string[];
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+// The WebAuthn JSON/Signal statics are not in every TS DOM lib yet.
+type PKC = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<Record<string, boolean>>;
+  parseCreationOptionsFromJSON: (json: unknown) => PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON: (json: unknown) => PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (o: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+type JSONCredential = PublicKeyCredential & { toJSON(): { id: string; [k: string]: unknown } };
+
+const pkc = () => (globalThis as any).PublicKeyCredential as PKC | undefined;
+
+let polyfills: Promise<unknown> | null = null;
+
+/** Loads WebAuthn polyfills in the browser. Resolves false if WebAuthn is unavailable. */
+export async function loadWebAuthn() {
+  if (typeof window === 'undefined' || !pkc() || !window.isSecureContext) return false;
+  polyfills ??= import('webauthn-polyfills').catch((e) => console.warn('webauthn-polyfills failed to load', e));
+  await polyfills;
+  return true;
+}
+
+export async function getCapabilities(): Promise<Capabilities> {
+  if (!(await loadWebAuthn())) return {};
+  try {
+    return (await pkc()!.getClientCapabilities?.()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+// ---------------------------------------------------------------------------
+// HTTP
+// ---------------------------------------------------------------------------
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) {
+    super(message);
+  }
+}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const res = await fetch(`${BASE}api/auth/${path}`, {
+    method: init.method ?? (init.body === undefined ? 'GET' : 'POST'),
+    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+    credentials: 'same-origin',
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(data.error || `Request failed (${res.status})`, res.status, data.code);
+  return data as T;
+}
+
+// ---------------------------------------------------------------------------
+// Signal API (progressive enhancement; failures are non-fatal)
+// ---------------------------------------------------------------------------
+
+export function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function signalUnknownCredential(rpId: string | undefined, credentialId: string) {
+  const P = pkc();
+  if (!P?.signalUnknownCredential || !rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    await P.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  const P = pkc();
+  if (!P?.signalAllAcceptedCredentials) return;
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    await P.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function signalCurrentUserDetails(user: SessionUser) {
+  const P = pkc();
+  if (!P?.signalCurrentUserDetails) return;
+  if (!user.rpId || !isValidBase64Url(user.userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await P.signalCurrentUserDetails({
+      rpId: user.rpId,
+      userId: user.userId,
+      name: user.username,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+export type RegisterResult =
+  | { status: 'created'; credential: PasskeyInfo }
+  | { status: 'cancelled' | 'exists' | 'unsupported' }
+  | { status: 'error'; message: string; code?: string };
+
+/**
+ * Creates a passkey for the signed-in user.
+ * - `promotion`: offered right after sign-in/up → platform authenticators only.
+ * - `conditional`: silent conditional create after password sign-in (no error UI).
+ */
+export async function registerPasskey({ promotion = false, conditional = false } = {}): Promise<RegisterResult> {
+  if (!(await loadWebAuthn())) return { status: 'unsupported' };
+  const P = pkc()!;
+
+  let publicKey: PublicKeyCredentialCreationOptions;
+  try {
+    publicKey = P.parseCreationOptionsFromJSON(await api('passkeys/register-options', { body: { promotion, conditional } }));
+  } catch (e) {
+    return e instanceof ApiError
+      ? { status: 'error', message: e.message, code: e.code }
+      : { status: 'error', message: 'Could not start passkey creation.' };
+  }
+
+  let credential: JSONCredential;
+  try {
+    credential = (await navigator.credentials.create({
+      publicKey,
+      ...(conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as JSONCredential;
+  } catch (e) {
+    const name = (e as DOMException).name;
+    if (name === 'InvalidStateError') return { status: 'exists' };
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    if (name === 'SecurityError') {
+      return { status: 'error', message: 'Passkeys aren’t available on this site’s current address (security error).' };
+    }
+    return { status: 'error', message: (e as Error).message || 'Passkey creation failed.' };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const { credential: saved } = await api<{ credential: PasskeyInfo }>('passkeys/register-verify', { body: encoded });
+    return { status: 'created', credential: saved };
+  } catch (e) {
+    // The provider saved a passkey the server rejected — tell the provider to drop it.
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    return { status: 'error', message: e instanceof ApiError ? e.message : 'Could not save your passkey.' };
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Authentication (sign-in) & reauthentication
+// ---------------------------------------------------------------------------
+
+export type AuthResult =
+  | { status: 'success'; user?: SessionUser }
+  | { status: 'cancelled' | 'unsupported' }
+  | { status: 'error'; message: string };
+
+async function getAndVerify(
+  optionsPath: string,
+  verifyPath: string,
+  { mediation, signal }: { mediation?: CredentialMediationRequirement; signal?: AbortSignal },
+): Promise<AuthResult> {
+  if (!(await loadWebAuthn())) return { status: 'unsupported' };
+  const P = pkc()!;
+
+  let publicKey: PublicKeyCredentialRequestOptions;
+  try {
+    publicKey = P.parseRequestOptionsFromJSON(await api(optionsPath, { body: {} }));
+  } catch (e) {
+    return { status: 'error', message: e instanceof ApiError ? e.message : 'Could not start passkey sign-in.' };
+  }
+
+  let credential: JSONCredential | null;
+  try {
+    credential = (await navigator.credentials.get({ publicKey, signal, ...(mediation && { mediation }) })) as JSONCredential | null;
+  } catch (e) {
+    const name = (e as DOMException).name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    return { status: 'error', message: (e as Error).message || 'Passkey sign-in failed.' };
+  }
+  if (!credential) return { status: 'cancelled' };
+
+  const encoded = credential.toJSON();
+  try {
+    const data = await api<{ user?: SessionUser }>(verifyPath, { body: encoded });
+    return { status: 'success', user: data.user };
+  } catch (e) {
+    if (e instanceof ApiError && e.status === 404) {
+      // The server doesn't know this credential; let the passkey provider hide it.
+      await signalUnknownCredential(publicKey.rpId, encoded.id);
+    }
+    return { status: 'error', message: e instanceof ApiError ? e.message : 'Passkey sign-in failed.' };
+  }
+}
+
+/** Primary sign-in with a discoverable passkey (button or autofill). */
+export function authenticateWithPasskey(opts: { conditional?: boolean; signal?: AbortSignal } = {}) {
+  return getAndVerify('passkeys/login-options', 'passkeys/login-verify', {
+    mediation: opts.conditional ? 'conditional' : undefined,
+    signal: opts.signal,
+  });
+}
+
+/** Step-up verification restricted to the signed-in user's passkeys. */
+export function reauthenticateWithPasskey(signal?: AbortSignal) {
+  return getAndVerify('reauth/options', 'reauth/verify', { signal });
+}
