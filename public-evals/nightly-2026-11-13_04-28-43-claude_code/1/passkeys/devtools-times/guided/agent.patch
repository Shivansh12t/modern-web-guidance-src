diff --git a/src/components/auth/PasskeyPromotion.tsx b/src/components/auth/PasskeyPromotion.tsx
new file mode 100644
index 0000000..8b37018
--- /dev/null
+++ b/src/components/auth/PasskeyPromotion.tsx
@@ -0,0 +1,60 @@
+import React, { useState } from 'react';
+import { registerPasskey } from '../../lib/passkeys';
+import { Alert, PasskeyIcon, primaryButtonClass, secondaryButtonClass } from './ui';
+
+/**
+ * Post sign-in / sign-up upsell to create a passkey on this device.
+ * Uses the promotion flow (platform authenticator only).
+ */
+export default function PasskeyPromotion({ onDone, heading }: { onDone: () => void; heading: string }) {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [created, setCreated] = useState(false);
+
+  const create = async () => {
+    setBusy(true);
+    setError(null);
+    const result = await registerPasskey({ promotion: true });
+    setBusy(false);
+    if (result.status === 'created' || result.status === 'exists') {
+      setCreated(true);
+      setTimeout(onDone, 1200);
+    } else if (result.status === 'error') {
+      setError(result.message);
+    } else if (result.status === 'unsupported') {
+      onDone();
+    }
+    // 'cancelled': stay on the prompt so the user can retry or skip.
+  };
+
+  return (
+    <section aria-labelledby="passkey-promo-title" className="text-center">
+      <div className="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-900">
+        <PasskeyIcon className="w-7 h-7" />
+      </div>
+      <h2 id="passkey-promo-title" className="text-2xl font-bold mb-2 text-gray-800">
+        {heading}
+      </h2>
+      {created ? (
+        <Alert kind="success">Passkey created. Next time, just use your fingerprint, face or screen lock.</Alert>
+      ) : (
+        <>
+          <p className="text-sm text-gray-600 mb-6">
+            Sign in to The DevTools Times with your fingerprint, face or screen lock instead of a password. Passkeys are
+            phishing-resistant and sync across your devices.
+          </p>
+          {error && <Alert kind="error">{error}</Alert>}
+          <div className="flex flex-col gap-3">
+            <button type="button" className={`${primaryButtonClass} w-full`} onClick={create} disabled={busy}>
+              <PasskeyIcon />
+              {busy ? 'Creating passkey…' : 'Create a passkey'}
+            </button>
+            <button type="button" className={`${secondaryButtonClass} w-full`} onClick={onDone} disabled={busy}>
+              Not now
+            </button>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
diff --git a/src/components/auth/ReauthDialog.tsx b/src/components/auth/ReauthDialog.tsx
new file mode 100644
index 0000000..237a011
--- /dev/null
+++ b/src/components/auth/ReauthDialog.tsx
@@ -0,0 +1,170 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { api, ApiError, reauthenticateWithPasskey } from '../../lib/passkeys';
+import { Alert, PasskeyIcon, inputClass, primaryButtonClass, secondaryButtonClass } from './ui';
+
+type Pending = { reason: string; resolve: (ok: boolean) => void };
+
+/**
+ * Promise-based step-up verification. `confirm(reason)` opens a modal dialog that
+ * verifies the user with one of their passkeys (or their password as a fallback)
+ * and resolves to true once the server has recorded a fresh verification.
+ */
+export function useReauth({ hasPasskeys, passkeysSupported }: { hasPasskeys: boolean; passkeysSupported: boolean }) {
+  const [pending, setPending] = useState<Pending | null>(null);
+
+  const confirm = useCallback(
+    (reason: string) => new Promise<boolean>((resolve) => setPending({ reason, resolve })),
+    [],
+  );
+
+  /** Runs `action`; if the server demands reauthentication, asks for it and retries once. */
+  const withReauth = useCallback(
+    async <T,>(reason: string, action: () => Promise<T>): Promise<T | undefined> => {
+      try {
+        return await action();
+      } catch (e) {
+        if (!(e instanceof ApiError && e.code === 'REAUTH_REQUIRED')) throw e;
+        if (!(await confirm(reason))) return undefined;
+        return action();
+      }
+    },
+    [confirm],
+  );
+
+  const dialog = pending ? (
+    <ReauthDialog
+      reason={pending.reason}
+      usePasskey={hasPasskeys && passkeysSupported}
+      onClose={(ok) => {
+        pending.resolve(ok);
+        setPending(null);
+      }}
+    />
+  ) : null;
+
+  return { confirm, withReauth, dialog };
+}
+
+function ReauthDialog({
+  reason,
+  usePasskey,
+  onClose,
+}: {
+  reason: string;
+  usePasskey: boolean;
+  onClose: (ok: boolean) => void;
+}) {
+  const ref = useRef<HTMLDialogElement>(null);
+  const abortRef = useRef<AbortController | null>(null);
+  const result = useRef(false);
+  const titleId = useId();
+  const descId = useId();
+  const [mode, setMode] = useState<'passkey' | 'password'>(usePasskey ? 'passkey' : 'password');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    dialog.showModal();
+    const handleClose = () => {
+      abortRef.current?.abort();
+      onClose(result.current);
+    };
+    dialog.addEventListener('close', handleClose);
+    return () => dialog.removeEventListener('close', handleClose);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const succeed = () => {
+    result.current = true;
+    ref.current?.close();
+  };
+
+  const verifyWithPasskey = async () => {
+    setBusy(true);
+    setError(null);
+    abortRef.current?.abort();
+    abortRef.current = new AbortController();
+    const res = await reauthenticateWithPasskey(abortRef.current.signal);
+    setBusy(false);
+    if (res.status === 'success') succeed();
+    else if (res.status === 'error') setError(res.message);
+    else if (res.status === 'unsupported') setMode('password');
+  };
+
+  const verifyWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      await api('reauth/password', { body: { password } });
+      succeed();
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'Verification failed.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <dialog
+      ref={ref}
+      aria-labelledby={titleId}
+      aria-describedby={descId}
+      className="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-lg bg-white p-6 shadow-xl"
+    >
+      <h2 id={titleId} className="text-xl font-bold text-gray-800 mb-2">
+        Confirm it’s you
+      </h2>
+      <p id={descId} className="text-sm text-gray-600 mb-4">
+        {reason}
+      </p>
+      {error && <Alert kind="error">{error}</Alert>}
+
+      {mode === 'passkey' ? (
+        <div className="flex flex-col gap-3">
+          <button type="button" autoFocus className={`${primaryButtonClass} w-full`} onClick={verifyWithPasskey} disabled={busy}>
+            <PasskeyIcon />
+            {busy ? 'Waiting for your passkey…' : 'Verify with passkey'}
+          </button>
+          <button type="button" className="text-sm text-gray-600 underline hover:text-gray-900" onClick={() => setMode('password')}>
+            Use your password instead
+          </button>
+        </div>
+      ) : (
+        <form onSubmit={verifyWithPassword} className="space-y-4">
+          <div>
+            <label htmlFor={`${titleId}-pw`} className="block text-sm font-medium text-gray-700 mb-1">
+              Password
+            </label>
+            <input
+              id={`${titleId}-pw`}
+              type="password"
+              autoComplete="current-password"
+              autoFocus
+              required
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              className={inputClass}
+            />
+          </div>
+          <button type="submit" className={`${primaryButtonClass} w-full`} disabled={busy}>
+            {busy ? 'Verifying…' : 'Verify'}
+          </button>
+          {usePasskey && (
+            <button type="button" className="block mx-auto text-sm text-gray-600 underline hover:text-gray-900" onClick={() => setMode('passkey')}>
+              Use a passkey instead
+            </button>
+          )}
+        </form>
+      )}
+
+      <form method="dialog" className="mt-4 text-right">
+        <button className={secondaryButtonClass} value="cancel">
+          Cancel
+        </button>
+      </form>
+    </dialog>
+  );
+}
