@@ -0,0 +1,47 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { SESSION, error, getRelyingParty, json, publicUser, readJson, signIn } from '../../../../lib/auth/server';
+import { getCredential, getUserByPasskeyUserId, updateCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const pending = await context.session?.get(SESSION.authentication);
+  if (!pending?.challenge) return error('Sign-in session expired. Please try again.');
+
+  const response = await readJson(context.request);
+  const stored = typeof response?.id === 'string' ? await getCredential(response.id) : null;
+  // 404 lets the client tell the passkey provider this credential is gone.
+  if (!stored) return error('This passkey is no longer registered with The DevTools Times.', 404);
+
+  const user = await getUserByPasskeyUserId(stored.passkeyUserId);
+  if (!user) return error('This passkey is no longer registered with The DevTools Times.', 404);
+
+  const { rpID, expectedOrigin } = getRelyingParty(context);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin,
+      expectedRPID: rpID,
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (e) {
+    return error(`Passkey sign-in failed: ${(e as Error).message}`, 401);
+  }
+  context.session?.delete(SESSION.authentication);
+  if (!verification.verified) return error('Passkey sign-in failed.', 401);
+
+  await updateCredential(stored.id, {
+    counter: verification.authenticationInfo.newCounter,
+    credentialBackedUp: verification.authenticationInfo.credentialBackedUp,
+    lastUsedAt: Date.now(),
+  });
+  await signIn(context, user.username);
+  return json({ user: publicUser(user, rpID) });
+};
