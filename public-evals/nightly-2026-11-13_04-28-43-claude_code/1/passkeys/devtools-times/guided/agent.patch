+import type { APIRoute } from 'astro';
+import { error, getRelyingParty, json, publicUser, readJson, signIn, verifyPasswordUpstream } from '../../../lib/auth/server';
+
+/** Password sign-in, verified by the upstream service, then bound to the local session. */
+export const POST: APIRoute = async (context) => {
+  const { username, password } = await readJson<{ username?: string; password?: string }>(context.request);
+  if (!username || !password) return error('Username and password are required.');
+
+  let result;
+  try {
+    result = await verifyPasswordUpstream(username, password);
+  } catch {
+    return error('The sign-in service is unavailable. Please try again later.', 502);
+  }
+  if (!result.ok) {
+    return error(result.data?.error || 'Incorrect username or password.', result.status === 400 ? 400 : 401);
+  }
+
+  const user = await signIn(context, username);
+  return json({ user: publicUser(user, getRelyingParty(context).rpID) });
+};
