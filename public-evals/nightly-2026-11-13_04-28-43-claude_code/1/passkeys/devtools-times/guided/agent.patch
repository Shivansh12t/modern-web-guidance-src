@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { SESSION, error, getRelyingParty, getSessionUser, json, readJson } from '../../../../lib/auth/server';
+import { getCredential, updateCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return error('Please sign in.', 401);
+
+  const pending = await context.session?.get(SESSION.reauth);
+  context.session?.delete(SESSION.reauth);
+  if (!pending?.challenge) return error('Verification expired. Please try again.');
+
+  const response = await readJson(context.request);
+  const stored = typeof response?.id === 'string' ? await getCredential(response.id) : null;
+  if (!stored) return error('This passkey is no longer registered.', 404);
+  // Reject a valid passkey that belongs to a different account.
+  if (stored.passkeyUserId !== user.passkeyUserId) {
+    return error('That passkey belongs to a different account.', 403);
+  }
+
+  const { rpID, expectedOrigin } = getRelyingParty(context);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin,
+      expectedRPID: rpID,
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+      requireUserVerification: true,
+    });
+  } catch (e) {
+    return error(`Verification failed: ${(e as Error).message}`, 401);
+  }
+  if (!verification.verified) return error('Verification failed.', 401);
+
+  await updateCredential(stored.id, {
+    counter: verification.authenticationInfo.newCounter,
+    lastUsedAt: Date.now(),
+  });
+  context.session?.set(SESSION.reauthAt, Date.now());
+  return json({ success: true });
+};
