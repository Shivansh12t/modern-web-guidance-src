+import type { APIRoute } from 'astro';
+import { UPSTREAM_AUTH_URL, error, getRelyingParty, json, publicUser, readJson, signIn } from '../../../lib/auth/server';
+import { updateUser } from '../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const { username, password, displayName } = await readJson<{
+    username?: string;
+    password?: string;
+    displayName?: string;
+  }>(context.request);
+  if (!username || !password) return error('Username and password are required.');
+
+  let res: Response;
+  try {
+    res = await fetch(`${UPSTREAM_AUTH_URL}/register`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return error('The registration service is unavailable. Please try again later.', 502);
+  }
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) return error(data?.error || 'Registration failed.', res.status >= 500 ? 502 : 400);
+
+  // Sign the new member in right away so we can offer to create a passkey.
+  let user = await signIn(context, username);
+  const name = displayName?.trim();
+  if (name) user = (await updateUser(user.username, { displayName: name.slice(0, 64) })) ?? user;
+
+  return json({ user: publicUser(user, getRelyingParty(context).rpID) }, 201);
+};
