@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { lookupProvider } from '../../../../lib/auth/aaguid';
+import { SESSION, error, getRelyingParty, getSessionUser, json, publicCredential, readJson } from '../../../../lib/auth/server';
+import { addCredential, type StoredPasskeyCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return error('Please sign in.', 401);
+
+  const pending = await context.session?.get(SESSION.registration);
+  context.session?.delete(SESSION.registration); // single use
+  if (!pending?.challenge) return error('Registration session expired. Please try again.');
+
+  const response = await readJson(context.request);
+  const { rpID, expectedOrigin } = getRelyingParty(context);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin,
+      expectedRPID: rpID,
+      // Options requested userVerification: 'preferred', so don't require UV here.
+      requireUserVerification: false,
+      // Conditional create may not involve a user gesture; only relax UP for it.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (e) {
+    return error(`Passkey verification failed: ${(e as Error).message}`);
+  }
+  if (!verification.verified) return error('Passkey verification failed.');
+
+  const info = verification.registrationInfo;
+  const provider = await lookupProvider(info.aaguid, context.request.headers.get('user-agent') ?? '');
+  const credential: StoredPasskeyCredential = {
+    id: info.credential.id,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType: info.credentialDeviceType,
+    credentialBackedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    providerIcon: provider.providerIcon,
+    name: provider.name,
+    transports: info.credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: info.credential.counter,
+  };
+  await addCredential(credential);
+  return json({ credential: publicCredential(credential) }, 201);
+};
