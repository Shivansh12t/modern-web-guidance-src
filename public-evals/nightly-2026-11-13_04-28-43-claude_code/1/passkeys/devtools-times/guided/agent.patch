+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { SESSION, getRelyingParty, json } from '../../../../lib/auth/server';
+
+/** Discoverable-credential sign-in options (used by autofill and the button). */
+export const POST: APIRoute = async (context) => {
+  const { rpID } = getRelyingParty(context);
+  const userVerification = 'preferred' as const;
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials: [],
+    userVerification,
+  });
+  // Persist the expected UV level server-side rather than trusting the client.
+  context.session?.set(SESSION.authentication, { challenge: options.challenge, userVerification });
+  return json(options);
+};
