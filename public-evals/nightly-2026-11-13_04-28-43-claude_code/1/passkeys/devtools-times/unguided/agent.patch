@@ -0,0 +1,76 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { findUserByUsername, generateUserHandle, listPasskeys } from '../../../../lib/auth/store';
+import {
+  errorResponse,
+  getAuthState,
+  getCurrentUser,
+  getRelyingParty,
+  isRecentlyAuthenticated,
+  json,
+  readJson,
+  reauthRequired,
+  saveChallenge,
+  validateUsername,
+} from '../../../../lib/auth/session';
+
+/**
+ * Begin passkey registration.
+ * - Signed out: creates options for a brand-new passkey-only account (`username` required).
+ * - Signed in: creates options to add a passkey to the current account (requires a recent sign-in).
+ */
+export const POST: APIRoute = async (context) => {
+  const { session, url, request } = context;
+  const body = (await readJson<{ username?: string; conditional?: boolean }>(request)) ?? {};
+  const { rpID, rpName } = getRelyingParty(url);
+
+  const user = await getCurrentUser(context);
+
+  if (user) {
+    if (!isRecentlyAuthenticated(await getAuthState(session))) return reauthRequired();
+
+    const existing = await listPasskeys(user.id);
+    const options = await generateRegistrationOptions({
+      rpName,
+      rpID,
+      userID: isoBase64URL.toBuffer(user.id),
+      userName: user.username,
+      userDisplayName: user.username,
+      attestationType: 'none',
+      excludeCredentials: existing.map((p) => ({ id: p.id, transports: p.transports })),
+      authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+    });
+    saveChallenge(session, {
+      challenge: options.challenge,
+      purpose: 'add-passkey',
+      userId: user.id,
+      conditional: !!body.conditional,
+    });
+    return json(options);
+  }
+
+  const username = body.username?.trim();
+  const invalid = validateUsername(username);
+  if (invalid) return errorResponse('INVALID_USERNAME', invalid);
+  if (await findUserByUsername(username!)) {
+    return errorResponse('USERNAME_TAKEN', 'That username is already taken.', 409);
+  }
+
+  const userId = generateUserHandle();
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userID: isoBase64URL.toBuffer(userId),
+    userName: username!,
+    userDisplayName: username!,
+    attestationType: 'none',
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+  saveChallenge(session, {
+    challenge: options.challenge,
+    purpose: 'signup',
+    pendingUser: { id: userId, username: username! },
+  });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/registration-verify.ts b/src/pages/api/auth/passkey/registration-verify.ts
new file mode 100644
index 0000000..6c5ff96
--- /dev/null
+++ b/src/pages/api/auth/passkey/registration-verify.ts
@@ -0,0 +1,108 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { reserveUsername } from '../../../../lib/auth/external';
+import { getProviderName } from '../../../../lib/auth/providers';
+import { addPasskey, createUser, findUserById, type PasskeyRecord, type UserRecord } from '../../../../lib/auth/store';
+import {
+  consumeChallenge,
+  errorResponse,
+  getAuthState,
+  getRelyingParty,
+  json,
+  readJson,
+  signIn,
+  toPublicPasskey,
+  toPublicUser,
+} from '../../../../lib/auth/session';
+
+/** Finish passkey registration (new account or additional passkey). */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await readJson<{ response?: RegistrationResponseJSON; name?: string }>(request);
+  if (!body?.response) return errorResponse('INVALID_REQUEST', 'Missing registration response.');
+
+  const { rpID, origins } = getRelyingParty(url);
+  const state = await consumeChallenge(session, ['signup', 'add-passkey']);
+  if (!state) return errorResponse('CHALLENGE_EXPIRED', 'This request expired. Please try again.', 400);
+
+  // Lets the client tell the passkey provider to drop a credential we didn't keep.
+  const orphan = { credentialId: body.response.id, rpID };
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      // Conditional create (automatic upgrade) may legitimately skip user verification.
+      requireUserVerification: !state.conditional,
+    });
+  } catch (err: any) {
+    console.warn('[auth] Registration verification failed:', err?.message);
+    return errorResponse('VERIFICATION_FAILED', 'We couldn’t verify that passkey. Please try again.', 400, orphan);
+  }
+  if (!verification.verified) {
+    return errorResponse('VERIFICATION_FAILED', 'We couldn’t verify that passkey. Please try again.', 400, orphan);
+  }
+
+  const info = verification.registrationInfo;
+  const providerName =
+    info.passkeyProviderMetadata?.friendlyNames?.['en-US'] ?? getProviderName(info.aaguid);
+  const requestedName = body.name?.trim().slice(0, 64);
+
+  let user: UserRecord | null;
+  const isSignup = state.purpose === 'signup';
+
+  if (isSignup) {
+    const pending = state.pendingUser!;
+    // Reserve the username with the password service so nobody can claim it there.
+    const reservation = await reserveUsername(pending.username);
+    if (!reservation.ok) {
+      const code = reservation.data.error || 'REGISTRATION_FAILED';
+      return errorResponse(code, `Registration failed: ${code}`, reservation.status || 400, orphan);
+    }
+    try {
+      user = await createUser({
+        id: pending.id,
+        username: pending.username,
+        hasPassword: false,
+        createdAt: new Date().toISOString(),
+      });
+    } catch {
+      return errorResponse('USERNAME_TAKEN', 'That username is already taken.', 409, orphan);
+    }
+  } else {
+    const auth = await getAuthState(session);
+    if (!auth || auth.userId !== state.userId) {
+      return errorResponse('UNAUTHENTICATED', 'Your session changed. Please sign in again.', 401, orphan);
+    }
+    user = await findUserById(state.userId!);
+    if (!user) return errorResponse('UNAUTHENTICATED', 'Account not found.', 401, orphan);
+  }
+
+  const now = new Date().toISOString();
+  const record: PasskeyRecord = {
+    id: info.credential.id,
+    userId: user.id,
+    publicKey: isoBase64URL.fromBuffer(info.credential.publicKey),
+    counter: info.credential.counter,
+    transports: info.credential.transports,
+    deviceType: info.credentialDeviceType,
+    backedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    name: requestedName || providerName || 'Passkey',
+    createdAt: now,
+    lastUsedAt: isSignup ? now : null,
+  };
+
+  try {
+    await addPasskey(record);
+  } catch {
+    return errorResponse('CREDENTIAL_EXISTS', 'This passkey is already registered.', 409);
+  }
+
+  if (isSignup) await signIn(session, user, 'passkey');
+
+  return json({ ok: true, user: toPublicUser(user), passkey: toPublicPasskey(record) });
+};
diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
new file mode 100644
index 0000000..1f59744
--- /dev/null
+++ b/src/pages/api/auth/passkeys/[id].ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { deletePasskey, listPasskeys, updatePasskey } from '../../../../lib/auth/store';
+import {
+  errorResponse,
+  getAuthState,
+  getCurrentUser,
+  getRelyingParty,
+  isRecentlyAuthenticated,
+  json,
+  readJson,
+  reauthRequired,
+  toPublicPasskey,
+  unauthenticated,
+} from '../../../../lib/auth/session';
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async (context) => {
+  const user = await getCurrentUser(context);
+  if (!user) return unauthenticated();
+
+  const body = await readJson<{ name?: string }>(context.request);
+  const name = body?.name?.trim();
+  if (!name) return errorResponse('INVALID_NAME', 'Please enter a name.');
+  if (name.length > 64) return errorResponse('INVALID_NAME', 'Names can be at most 64 characters.');
+
+  const updated = await updatePasskey(context.params.id!, user.id, { name });
+  if (!updated) return errorResponse('NOT_FOUND', 'Passkey not found.', 404);
+  return json({ ok: true, passkey: toPublicPasskey(updated) });
+};
+
+/** Delete a passkey. Requires a recent (re)authentication. */
+export const DELETE: APIRoute = async (context) => {
+  const user = await getCurrentUser(context);
+  if (!user) return unauthenticated();
+  if (!isRecentlyAuthenticated(await getAuthState(context.session))) return reauthRequired();
+
+  const result = await deletePasskey(context.params.id!, user.id);
+  if (result === 'not_found') return errorResponse('NOT_FOUND', 'Passkey not found.', 404);
+  if (result === 'last_credential') {
+    return errorResponse(
+      'LAST_CREDENTIAL',
+      'This is the only way to sign in to your account. Add another passkey before removing this one.',
+      409,
+    );
+  }
+
+  const remaining = await listPasskeys(user.id);
+  return json({
+    ok: true,
+    rpID: getRelyingParty(context.url).rpID,
+    acceptedCredentialIds: remaining.map((p) => p.id),
+  });
+};
