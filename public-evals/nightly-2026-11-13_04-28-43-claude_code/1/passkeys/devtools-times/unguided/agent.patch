+/**
+ * Friendly names for common passkey providers, keyed by AAGUID.
+ * Source: https://github.com/passkeydeveloper/passkey-authenticator-aaguids
+ */
+const PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  '891494da-2c90-4d31-a9cd-4eab0aed1309': 'Sésame',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'cc45f64e-52a2-451b-831a-4edd8022a202': 'ToothPic Passkey Provider',
+};
+
+export function getProviderName(aaguid: string | undefined | null): string | null {
+  if (!aaguid) return null;
+  return PROVIDERS[aaguid.toLowerCase()] ?? null;
+}
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..5b1ed15
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,160 @@
+import type { APIContext, AstroGlobal } from 'astro';
+import { findUserById, type PasskeyRecord, type UserRecord } from './store';
+import { getProviderName } from './providers';
+
+type Session = NonNullable<APIContext['session']>;
+type Ctx = Pick<APIContext, 'session' | 'url'> | Pick<AstroGlobal, 'session' | 'url'>;
+
+/** How long a sign-in counts as "recent" for sensitive account changes. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+/** How long a WebAuthn challenge stays valid. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export type AuthMethod = 'password' | 'passkey';
+
+export interface AuthState {
+  userId: string;
+  method: AuthMethod;
+  /** Epoch ms of the last successful (re)authentication. */
+  authenticatedAt: number;
+}
+
+export type ChallengePurpose = 'signup' | 'add-passkey' | 'signin' | 'reauth';
+
+export interface ChallengeState {
+  challenge: string;
+  purpose: ChallengePurpose;
+  expiresAt: number;
+  /** For signup: the user handle + username that will be created on success. */
+  pendingUser?: { id: string; username: string };
+  /** For add-passkey / reauth: the signed-in user the ceremony is bound to. */
+  userId?: string;
+  /** Registration started via conditional create (automatic passkey upgrade). */
+  conditional?: boolean;
+}
+
+const USERNAME_PATTERN = /^[A-Za-z0-9._-]{3,32}$/;
+export function validateUsername(username: string | undefined): string | null {
+  if (!username) return 'Please choose a username.';
+  if (!USERNAME_PATTERN.test(username)) {
+    return 'Usernames must be 3–32 characters: letters, numbers, dots, dashes or underscores.';
+  }
+  return null;
+}
+
+/** Relying Party configuration derived from the incoming request (overridable via env). */
+export function getRelyingParty(url: URL) {
+  const rpID = process.env.PASSKEY_RP_ID || url.hostname;
+  const origins = process.env.PASSKEY_ORIGINS
+    ? process.env.PASSKEY_ORIGINS.split(',').map((o) => o.trim()).filter(Boolean)
+    : [url.origin];
+  return { rpID, rpName: 'The DevTools Times', origins };
+}
+
+export async function getAuthState(session: Session | undefined): Promise<AuthState | null> {
+  return ((await session?.get('auth')) as AuthState | undefined) ?? null;
+}
+
+export async function getCurrentUser(ctx: Ctx): Promise<UserRecord | null> {
+  const auth = await getAuthState(ctx.session);
+  if (!auth) return null;
+  return findUserById(auth.userId);
+}
+
+export function isRecentlyAuthenticated(auth: AuthState | null) {
+  return !!auth && Date.now() - auth.authenticatedAt < REAUTH_WINDOW_MS;
+}
+
+/** Start a fresh authenticated session (regenerating the ID to prevent fixation). */
+export async function signIn(session: Session | undefined, user: UserRecord, method: AuthMethod) {
+  if (!session) throw new Error('Sessions are not configured');
+  await session.regenerate();
+  const auth: AuthState = { userId: user.id, method, authenticatedAt: Date.now() };
+  session.set('auth', auth);
+  session.delete('webauthnChallenge');
+}
+
+/** Bump the last-authenticated timestamp after a successful reauthentication. */
+export async function markReauthenticated(session: Session | undefined, method: AuthMethod) {
+  const auth = await getAuthState(session);
+  if (!auth || !session) return;
+  session.set('auth', { ...auth, method, authenticatedAt: Date.now() } satisfies AuthState);
+}
+
+export function signOut(session: Session | undefined) {
+  session?.delete('auth');
+  session?.delete('webauthnChallenge');
+}
+
+export function saveChallenge(session: Session | undefined, state: Omit<ChallengeState, 'expiresAt'>) {
+  if (!session) throw new Error('Sessions are not configured');
+  session.set('webauthnChallenge', { ...state, expiresAt: Date.now() + CHALLENGE_TTL_MS } satisfies ChallengeState);
+}
+
+/** Retrieve and consume (single-use) the pending challenge for a given purpose. */
+export async function consumeChallenge(
+  session: Session | undefined,
+  purposes: ChallengePurpose[],
+): Promise<ChallengeState | null> {
+  const state = (await session?.get('webauthnChallenge')) as ChallengeState | undefined;
+  session?.delete('webauthnChallenge');
+  if (!state || !purposes.includes(state.purpose) || state.expiresAt < Date.now()) return null;
+  return state;
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function errorResponse(code: string, message: string, status = 400, extra: Record<string, unknown> = {}) {
+  return json({ error: code, message, ...extra }, status);
+}
+
+export const reauthRequired = () =>
+  errorResponse('REAUTH_REQUIRED', 'Please confirm it’s you to continue.', 401);
+
+export const unauthenticated = () => errorResponse('UNAUTHENTICATED', 'You need to sign in first.', 401);
+
+/** Shape of a passkey as exposed to the browser. */
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  provider: string | null;
+  synced: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export function toPublicPasskey(p: PasskeyRecord): PublicPasskey {
+  return {
+    id: p.id,
+    name: p.name,
+    provider: getProviderName(p.aaguid),
+    synced: p.backedUp,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+export interface PublicUser {
+  id: string;
+  username: string;
+  hasPassword: boolean;
+}
+
+export const toPublicUser = (u: UserRecord): PublicUser => ({
+  id: u.id,
+  username: u.username,
+  hasPassword: u.hasPassword,
+});
+
+export async function readJson<T = any>(request: Request): Promise<T | null> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..6dba075
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,178 @@
+/**
+ * Minimal file-backed account + passkey store.
+ *
+ * Password verification for The DevTools Times lives in an external service,
+ * so this store only keeps what the passkey layer needs: a stable WebAuthn
+ * user handle per username and the public-key credentials registered to it.
+ *
+ * Data is persisted as JSON under AUTH_DATA_DIR (default: ./.data). Writes are
+ * serialized and written atomically (temp file + rename).
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface UserRecord {
+  /** WebAuthn user handle (base64url, 32 random bytes). Never shown to users. */
+  id: string;
+  username: string;
+  /** Whether the user knows a password for the external auth service. */
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface PasskeyRecord {
+  /** Credential ID (base64url). */
+  id: string;
+  userId: string;
+  /** COSE public key (base64url). */
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  aaguid: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface Database {
+  users: UserRecord[];
+  passkeys: PasskeyRecord[];
+}
+
+const DATA_DIR = process.env.AUTH_DATA_DIR || path.join(process.cwd(), '.data');
+const DB_FILE = path.join(DATA_DIR, 'auth.json');
+
+let cache: Database | null = null;
+let writeQueue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Database> {
+  if (cache) return cache;
+  try {
+    const raw = await fs.readFile(DB_FILE, 'utf8');
+    const parsed = JSON.parse(raw) as Partial<Database>;
+    cache = { users: parsed.users ?? [], passkeys: parsed.passkeys ?? [] };
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') console.error('[auth] Failed to read store, starting empty:', err);
+    cache = { users: [], passkeys: [] };
+  }
+  return cache;
+}
+
+async function persist(db: Database) {
+  await fs.mkdir(DATA_DIR, { recursive: true });
+  const tmp = `${DB_FILE}.${process.pid}.${Date.now()}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(db, null, 2), 'utf8');
+  await fs.rename(tmp, DB_FILE);
+}
+
+/** Run a read-modify-write transaction; transactions are serialized. */
+function mutate<T>(fn: (db: Database) => T | Promise<T>): Promise<T> {
+  const run = writeQueue.then(async () => {
+    const db = await load();
+    const result = await fn(db);
+    await persist(db);
+    return result;
+  });
+  // Keep the queue alive even if this transaction fails.
+  writeQueue = run.catch(() => undefined);
+  return run;
+}
+
+export function generateUserHandle(): string {
+  return randomBytes(32).toString('base64url');
+}
+
+const usernameKey = (username: string) => username.trim().toLowerCase();
+
+export async function findUserByUsername(username: string) {
+  const db = await load();
+  const key = usernameKey(username);
+  return db.users.find((u) => usernameKey(u.username) === key) ?? null;
+}
+
+export async function findUserById(id: string) {
+  const db = await load();
+  return db.users.find((u) => u.id === id) ?? null;
+}
+
+export function createUser(user: UserRecord) {
+  return mutate((db) => {
+    if (db.users.some((u) => usernameKey(u.username) === usernameKey(user.username))) {
+      throw new Error('USERNAME_TAKEN');
+    }
+    db.users.push(user);
+    return user;
+  });
+}
+
+/** Find the local record for a password-authenticated user, creating it if needed. */
+export function upsertPasswordUser(username: string) {
+  return mutate((db) => {
+    const key = usernameKey(username);
+    let user = db.users.find((u) => usernameKey(u.username) === key);
+    if (!user) {
+      user = {
+        id: generateUserHandle(),
+        username: username.trim(),
+        hasPassword: true,
+        createdAt: new Date().toISOString(),
+      };
+      db.users.push(user);
+    } else if (!user.hasPassword) {
+      user.hasPassword = true;
+    }
+    return user;
+  });
+}
+
+export async function listPasskeys(userId: string) {
+  const db = await load();
+  return db.passkeys
+    .filter((p) => p.userId === userId)
+    .sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+}
+
+export async function findPasskey(credentialId: string) {
+  const db = await load();
+  return db.passkeys.find((p) => p.id === credentialId) ?? null;
+}
+
+export function addPasskey(passkey: PasskeyRecord) {
+  return mutate((db) => {
+    if (db.passkeys.some((p) => p.id === passkey.id)) throw new Error('CREDENTIAL_EXISTS');
+    db.passkeys.push(passkey);
+    return passkey;
+  });
+}
+
+export function updatePasskey(
+  credentialId: string,
+  userId: string,
+  patch: Partial<Pick<PasskeyRecord, 'name' | 'counter' | 'backedUp' | 'deviceType' | 'lastUsedAt'>>,
+) {
+  return mutate((db) => {
+    const passkey = db.passkeys.find((p) => p.id === credentialId && p.userId === userId);
+    if (!passkey) return null;
+    Object.assign(passkey, patch);
+    return passkey;
+  });
+}
+
+/**
+ * Delete a passkey. Refuses to remove a passkey-only account's last passkey,
+ * since that would lock the user out.
+ */
+export function deletePasskey(credentialId: string, userId: string) {
+  return mutate((db): 'deleted' | 'not_found' | 'last_credential' => {
+    const index = db.passkeys.findIndex((p) => p.id === credentialId && p.userId === userId);
+    if (index === -1) return 'not_found';
+    const user = db.users.find((u) => u.id === userId);
+    const remaining = db.passkeys.filter((p) => p.userId === userId).length;
+    if (!user?.hasPassword && remaining <= 1) return 'last_credential';
+    db.passkeys.splice(index, 1);
+    return 'deleted';
+  });
+}
