index 0000000..6bf227a
--- /dev/null
+++ b/src/components/auth/AccountSettings.tsx
@@ -0,0 +1,403 @@
+import React, { useEffect, useRef, useState } from 'react';
+import {
+  CheckIcon,
+  CloudIcon,
+  DevicePhoneMobileIcon,
+  FingerPrintIcon,
+  KeyIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import ReauthDialog from './ReauthDialog';
+import {
+  api,
+  ApiError,
+  appUrl,
+  CeremonyCancelled,
+  registerPasskey,
+  signalAccountState,
+  supportsPasskeys,
+  type PublicPasskey,
+  type PublicUser,
+} from './passkeyClient';
+
+interface Props {
+  user: PublicUser;
+  passkeys: PublicPasskey[];
+  reauthExpiresAt: number;
+  rpID: string;
+}
+
+interface PendingAction {
+  label: string;
+  requireContinue?: boolean;
+  run: () => Promise<void>;
+}
+
+const dateFormat = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+const relativeFormat = new Intl.RelativeTimeFormat('en-US', { numeric: 'auto' });
+
+function formatRelative(iso: string) {
+  const diffSeconds = Math.round((new Date(iso).getTime() - Date.now()) / 1000);
+  const units: [Intl.RelativeTimeFormatUnit, number][] = [
+    ['day', 86400],
+    ['hour', 3600],
+    ['minute', 60],
+  ];
+  for (const [unit, seconds] of units) {
+    if (Math.abs(diffSeconds) >= seconds) return relativeFormat.format(Math.round(diffSeconds / seconds), unit);
+  }
+  return 'just now';
+}
+
+export default function AccountSettings({ user, passkeys: initialPasskeys, reauthExpiresAt: initialExpiry, rpID }: Props) {
+  const [passkeys, setPasskeys] = useState(initialPasskeys);
+  const [reauthExpiresAt, setReauthExpiresAt] = useState(initialExpiry);
+  const [pending, setPending] = useState<PendingAction | null>(null);
+  const [message, setMessage] = useState<{ kind: 'success' | 'error'; text: string } | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [confirmDelete, setConfirmDelete] = useState<PublicPasskey | null>(null);
+  const [browserSupport, setBrowserSupport] = useState(true);
+  const [signingOut, setSigningOut] = useState(false);
+  const renameInput = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    setBrowserSupport(supportsPasskeys());
+    // Keep the user's passkey providers in sync with what this account actually accepts.
+    signalAccountState(rpID, user, initialPasskeys.map((p) => p.id));
+  }, []);
+
+  useEffect(() => {
+    if (editingId) renameInput.current?.focus();
+  }, [editingId]);
+
+  const isPasskeyOnly = !user.hasPassword;
+
+  /** Run a sensitive action, asking the user to reauthenticate first if needed. */
+  const guarded = async (action: PendingAction) => {
+    if (Date.now() >= reauthExpiresAt - 5000) {
+      setPending(action);
+      return;
+    }
+    try {
+      await action.run();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'REAUTH_REQUIRED') setPending(action);
+      else throw err;
+    }
+  };
+
+  const reportError = (err: unknown) => {
+    if (err instanceof CeremonyCancelled) return;
+    setMessage({ kind: 'error', text: (err as Error).message || 'Something went wrong. Please try again.' });
+  };
+
+  const addPasskey = async () => {
+    setMessage(null);
+    const action: PendingAction = {
+      label: 'add a passkey',
+      requireContinue: true,
+      run: async () => {
+        setAdding(true);
+        try {
+          const { passkey } = await registerPasskey();
+          const next = [...passkeys.filter((p) => p.id !== passkey.id), passkey];
+          setPasskeys(next);
+          setMessage({ kind: 'success', text: `Passkey “${passkey.name}” added.` });
+          signalAccountState(rpID, user, next.map((p) => p.id));
+        } finally {
+          setAdding(false);
+        }
+      },
+    };
+    guarded(action).catch(reportError);
+  };
+
+  const startRename = (passkey: PublicPasskey) => {
+    setMessage(null);
+    setEditingId(passkey.id);
+    setEditName(passkey.name);
+  };
+
+  const saveRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!editingId) return;
+    try {
+      const { passkey } = await api<{ passkey: PublicPasskey }>(`passkeys/${encodeURIComponent(editingId)}`, {
+        method: 'PATCH',
+        body: { name: editName },
+      });
+      setPasskeys((list) => list.map((p) => (p.id === passkey.id ? passkey : p)));
+      setEditingId(null);
+      setMessage({ kind: 'success', text: 'Passkey renamed.' });
+    } catch (err) {
+      reportError(err);
+    }
+  };
+
+  const deletePasskey = (passkey: PublicPasskey) => {
+    setConfirmDelete(null);
+    setMessage(null);
+    guarded({
+      label: 'remove this passkey',
+      run: async () => {
+        const result = await api<{ acceptedCredentialIds: string[]; rpID: string }>(
+          `passkeys/${encodeURIComponent(passkey.id)}`,
+          { method: 'DELETE' },
+        );
+        setPasskeys((list) => list.filter((p) => p.id !== passkey.id));
+        setMessage({
+          kind: 'success',
+          text: `Passkey “${passkey.name}” removed. You may also want to delete it from your password manager.`,
+        });
+        signalAccountState(result.rpID || rpID, user, result.acceptedCredentialIds);
+      },
+    }).catch(reportError);
+  };
+
+  const signOut = async () => {
+    setSigningOut(true);
+    try {
+      await api('logout', { method: 'POST', body: {} });
+    } finally {
+      window.location.assign(appUrl());
+    }
+  };
+
+  const lastPasskeyLocked = isPasskeyOnly && passkeys.length <= 1;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div>
+        <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+        <p className="mt-1 text-sm text-gray-600">
+          Signed in as <span className="font-semibold text-gray-900">{user.username}</span>
+        </p>
+      </div>
+
+      {message && (
+        <div
+          className={`p-3 text-sm rounded-lg ${
+            message.kind === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'
+          }`}
+          role={message.kind === 'error' ? 'alert' : 'status'}
+        >
+          {message.text}
+        </div>
+      )}
+
+      {/* Passkeys */}
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-semibold text-gray-900 flex items-center gap-2">
+              <FingerPrintIcon className="w-6 h-6" aria-hidden="true" />
+              Passkeys
+            </h2>
+            <p className="mt-1 text-sm text-gray-600 max-w-md">
+              Passkeys let you sign in with your fingerprint, face, or device screen lock. They’re stored in your
+              password manager and can’t be phished or leaked.
+            </p>
+          </div>
+          <button
+            type="button"
+            onClick={addPasskey}
+            disabled={adding || !browserSupport}
+            className="flex items-center gap-1.5 py-2 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+          >
+            <PlusIcon className="w-4 h-4" aria-hidden="true" />
+            {adding ? 'Creating…' : 'Add a passkey'}
+          </button>
+        </div>
+
+        {!browserSupport && (
+          <p className="mt-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            This browser doesn’t support passkeys. You can still manage existing passkeys here.
+          </p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <div className="mt-6 p-6 text-center border border-dashed border-gray-300 rounded-lg">
+            <KeyIcon className="w-8 h-8 mx-auto text-gray-400" aria-hidden="true" />
+            <p className="mt-2 text-sm text-gray-600">You haven’t created any passkeys yet.</p>
+          </div>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-t border-b border-gray-200">
+            {passkeys.map((passkey) => (
+              <li key={passkey.id} className="py-4 flex flex-wrap items-center gap-4">
+                <div className="flex-shrink-0 w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center">
+                  {passkey.synced ? (
+                    <CloudIcon className="w-5 h-5 text-gray-700" aria-hidden="true" />
+                  ) : (
+                    <DevicePhoneMobileIcon className="w-5 h-5 text-gray-700" aria-hidden="true" />
+                  )}
+                </div>
+
+                <div className="flex-grow min-w-0">
+                  {editingId === passkey.id ? (
+                    <form onSubmit={saveRename} className="flex items-center gap-2">
+                      <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        ref={renameInput}
+                        id={`rename-${passkey.id}`}
+                        value={editName}
+                        maxLength={64}
+                        required
+                        onChange={(e) => setEditName(e.target.value)}
+                        onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                        className="flex-grow min-w-0 px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button
+                        type="submit"
+                        className="p-1.5 rounded-md text-gray-700 hover:bg-gray-100"
+                        aria-label="Save name"
+                      >
+                        <CheckIcon className="w-5 h-5" aria-hidden="true" />
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="p-1.5 rounded-md text-gray-700 hover:bg-gray-100"
+                        aria-label="Cancel rename"
+                      >
+                        <XMarkIcon className="w-5 h-5" aria-hidden="true" />
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-medium text-gray-900 truncate">{passkey.name}</p>
+                  )}
+                  <p className="mt-0.5 text-xs text-gray-500">
+                    {passkey.provider && passkey.provider !== passkey.name && <>{passkey.provider} · </>}
+                    {passkey.synced ? 'Synced across your devices' : 'Saved on one device'}
+                  </p>
+                  <p className="mt-0.5 text-xs text-gray-500">
+                    Created {dateFormat.format(new Date(passkey.createdAt))} ·{' '}
+                    {passkey.lastUsedAt ? `Last used ${formatRelative(passkey.lastUsedAt)}` : 'Never used'}
+                  </p>
+                </div>
+
+                {editingId !== passkey.id && (
+                  <div className="flex items-center gap-1">
+                    <button
+                      type="button"
+                      onClick={() => startRename(passkey)}
+                      className="p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100"
+                      aria-label={`Rename ${passkey.name}`}
+                      title="Rename"
+                    >
+                      <PencilSquareIcon className="w-5 h-5" aria-hidden="true" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setConfirmDelete(passkey)}
+                      disabled={lastPasskeyLocked}
+                      className="p-2 rounded-md text-gray-600 hover:text-red-700 hover:bg-red-50 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-gray-600"
+                      aria-label={`Remove ${passkey.name}`}
+                      title={
+                        lastPasskeyLocked
+                          ? 'This is the only way to sign in to your account. Add another passkey first.'
+                          : 'Remove'
+                      }
+                    >
+                      <TrashIcon className="w-5 h-5" aria-hidden="true" />
+                    </button>
+                  </div>
+                )}
+
+                {confirmDelete?.id === passkey.id && (
+                  <div
+                    className="basis-full p-3 bg-red-50 border border-red-200 rounded-lg text-sm"
+                    role="group"
+                    aria-label="Confirm removal"
+                  >
+                    <p className="text-red-800">
+                      Remove “{passkey.name}”? You won’t be able to sign in with it anymore.
+                    </p>
+                    <div className="mt-2 flex gap-2">
+                      <button
+                        type="button"
+                        onClick={() => deletePasskey(passkey)}
+                        className="py-1.5 px-3 rounded-md text-sm font-medium text-white bg-red-700 hover:bg-red-800"
+                      >
+                        Remove passkey
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setConfirmDelete(null)}
+                        className="py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 hover:bg-white"
+                      >
+                        Cancel
+                      </button>
+                    </div>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {lastPasskeyLocked && passkeys.length === 1 && (
+          <p className="mt-3 text-xs text-gray-500">
+            Your account uses passkeys only. Add a second passkey (for example on another device or password
+            manager) as a backup before removing this one.
+          </p>
+        )}
+      </section>
+
+      {/* Sign-in methods */}
+      <section aria-labelledby="methods-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="methods-heading" className="text-xl font-semibold text-gray-900">
+          Sign-in methods
+        </h2>
+        <dl className="mt-4 divide-y divide-gray-200 text-sm">
+          <div className="py-3 flex justify-between gap-4">
+            <dt className="text-gray-600">Username</dt>
+            <dd className="font-medium text-gray-900">{user.username}</dd>
+          </div>
+          <div className="py-3 flex justify-between gap-4">
+            <dt className="text-gray-600">Password</dt>
+            <dd className="font-medium text-gray-900">{user.hasPassword ? 'Set' : 'Not used — passkey-only account'}</dd>
+          </div>
+          <div className="py-3 flex justify-between gap-4">
+            <dt className="text-gray-600">Passkeys</dt>
+            <dd className="font-medium text-gray-900">
+              {passkeys.length === 0 ? 'None' : `${passkeys.length} passkey${passkeys.length === 1 ? '' : 's'}`}
+            </dd>
+          </div>
+        </dl>
+      </section>
+
+      <div className="flex justify-end pb-12">
+        <button
+          type="button"
+          onClick={signOut}
+          disabled={signingOut}
+          className="py-2 px-4 rounded-md text-sm font-medium text-gray-700 border border-gray-300 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+        >
+          {signingOut ? 'Signing out…' : 'Sign out'}
+        </button>
+      </div>
+
+      <ReauthDialog
+        open={!!pending}
+        actionLabel={pending?.label ?? 'continue'}
+        requireContinue={pending?.requireContinue}
+        canUsePasskey={passkeys.length > 0 && browserSupport}
+        canUsePassword={user.hasPassword}
+        onCancel={() => setPending(null)}
+        onSuccess={(expiresAt) => {
+          setReauthExpiresAt(expiresAt);
+          const action = pending;
+          setPending(null);
+          action?.run().catch(reportError);
+        }}
+      />
+    </div>
+  );
+}
