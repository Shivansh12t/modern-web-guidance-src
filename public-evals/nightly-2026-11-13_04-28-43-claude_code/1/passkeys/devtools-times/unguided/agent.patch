+import React, { useEffect, useRef, useState } from 'react';
+import { FingerPrintIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { api, ApiError, authenticateWithPasskey, CeremonyCancelled } from './passkeyClient';
+
+interface Props {
+  open: boolean;
+  /** Short description of what the user is about to do, e.g. "remove this passkey". */
+  actionLabel: string;
+  canUsePasskey: boolean;
+  canUsePassword: boolean;
+  /**
+   * If true, show a "Continue" step after confirming so the follow-up action runs inside a fresh
+   * user gesture (required by some browsers before creating a passkey).
+   */
+  requireContinue?: boolean;
+  onSuccess: (reauthExpiresAt: number) => void;
+  onCancel: () => void;
+}
+
+/** Modal that asks the signed-in user to confirm their identity before a sensitive change. */
+export default function ReauthDialog({
+  open,
+  actionLabel,
+  canUsePasskey,
+  canUsePassword,
+  requireContinue,
+  onSuccess,
+  onCancel,
+}: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState<'passkey' | 'password' | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [confirmedUntil, setConfirmedUntil] = useState<number | null>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      setPassword('');
+      setError(null);
+      setBusy(null);
+      setConfirmedUntil(null);
+      dialog.showModal();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open]);
+
+  const confirmed = (expiresAt: number) => {
+    if (requireContinue) setConfirmedUntil(expiresAt);
+    else onSuccess(expiresAt);
+  };
+
+  const withPasskey = async () => {
+    setBusy('passkey');
+    setError(null);
+    try {
+      const result = await authenticateWithPasskey({ purpose: 'reauth' });
+      confirmed(result.reauthExpiresAt);
+    } catch (err) {
+      if (!(err instanceof CeremonyCancelled)) setError((err as Error).message);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const withPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setBusy('password');
+    setError(null);
+    try {
+      const result = await api<{ reauthExpiresAt: number }>('reauth-password', { body: { password } });
+      setPassword('');
+      confirmed(result.reauthExpiresAt);
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'An unexpected error occurred. Please try again.');
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      onCancel={(e) => {
+        e.preventDefault();
+        if (!busy) onCancel();
+      }}
+      aria-labelledby="reauth-title"
+      className="m-auto w-full max-w-sm rounded-lg p-0 shadow-xl backdrop:bg-black/50"
+    >
+      <div className="p-6">
+        <ShieldCheckIcon className="w-10 h-10 mx-auto text-gray-800" aria-hidden="true" />
+        <h2 id="reauth-title" className="mt-3 text-center text-lg font-semibold text-gray-900">
+          {confirmedUntil ? 'Identity confirmed' : 'Confirm it’s you'}
+        </h2>
+
+        {confirmedUntil ? (
+          <>
+            <p className="mt-2 text-center text-sm text-gray-600">Thanks! You can now {actionLabel}.</p>
+            <button
+              type="button"
+              autoFocus
+              onClick={() => onSuccess(confirmedUntil)}
+              className="mt-5 w-full py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+            >
+              Continue
+            </button>
+          </>
+        ) : (
+          <>
+            <p className="mt-2 text-center text-sm text-gray-600">
+              For your security, please verify your identity to {actionLabel}.
+            </p>
+
+            {error && (
+              <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+                {error}
+              </div>
+            )}
+
+            {canUsePasskey && (
+              <button
+                type="button"
+                onClick={withPasskey}
+                disabled={!!busy}
+                className="mt-5 w-full flex items-center justify-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75"
+              >
+                <FingerPrintIcon className="w-5 h-5" aria-hidden="true" />
+                {busy === 'passkey' ? 'Waiting for passkey…' : 'Use your passkey'}
+              </button>
+            )}
+
+            {canUsePasskey && canUsePassword && (
+              <div className="flex items-center my-4" aria-hidden="true">
+                <div className="flex-grow border-t border-gray-200" />
+                <span className="px-3 text-xs uppercase tracking-wide text-gray-500">or</span>
+                <div className="flex-grow border-t border-gray-200" />
+              </div>
+            )}
+
+            {canUsePassword && (
+              <form onSubmit={withPassword} className={canUsePasskey ? 'space-y-3' : 'mt-5 space-y-3'}>
+                <div>
+                  <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700 mb-1">
+                    Password
+                  </label>
+                  <input
+                    id="reauth-password"
+                    type="password"
+                    autoComplete="current-password"
+                    value={password}
+                    onChange={(e) => setPassword(e.target.value)}
+                    required
+                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                  />
+                </div>
+                <button
+                  type="submit"
+                  disabled={!!busy}
+                  className={`w-full py-2 px-4 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 ${
+                    canUsePasskey
+                      ? 'border border-gray-300 text-gray-900 bg-white hover:bg-gray-50'
+                      : 'text-white bg-gray-900 hover:bg-gray-800'
+                  }`}
+                >
+                  {busy === 'password' ? 'Checking…' : 'Confirm with password'}
+                </button>
+              </form>
+            )}
+          </>
+        )}
+
+        <button
+          type="button"
+          onClick={onCancel}
+          disabled={!!busy}
+          className="mt-3 w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-400"
+        >
+          Cancel
+        </button>
+      </div>
+    </dialog>
+  );
+}
diff --git a/src/components/auth/passkeyClient.ts b/src/components/auth/passkeyClient.ts
new file mode 100644
index 0000000..82d3791
--- /dev/null
+++ b/src/components/auth/passkeyClient.ts
@@ -0,0 +1,204 @@
+/**
+ * Browser-side helpers for passkey ceremonies against the /api/auth endpoints.
+ */
+import {
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  getBrowserCapabilities,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+  WebAuthnAbortService,
+  WebAuthnError,
+} from '@simplewebauthn/browser';
+
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  provider: string | null;
+  synced: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface PublicUser {
+  id: string;
+  username: string;
+  hasPassword: boolean;
+}
+
+export class ApiError extends Error {
+  constructor(
+    public code: string,
+    message: string,
+    public status: number,
+    public data: Record<string, any> = {},
+  ) {
+    super(message);
+  }
+}
+
+/** Raised when the user dismisses the passkey dialog; usually not worth an error message. */
+export class CeremonyCancelled extends Error {}
+
+const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
+export const appUrl = (path = '') => `${BASE}${path.replace(/^\//, '')}`;
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const response = await fetch(appUrl(`api/auth/${path}`), {
+    method: init.method ?? (init.body === undefined ? 'GET' : 'POST'),
+    headers: init.body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: init.body === undefined ? undefined : JSON.stringify(init.body),
+    credentials: 'same-origin',
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new ApiError(data.error || 'UNKNOWN_ERROR', data.message || data.error || 'Something went wrong.', response.status, data);
+  }
+  return data as T;
+}
+
+export const supportsPasskeys = () => typeof window !== 'undefined' && browserSupportsWebAuthn();
+export const supportsAutofill = () => browserSupportsWebAuthnAutofill();
+export const cancelCeremony = () => WebAuthnAbortService.cancelCeremony();
+
+export async function supportsConditionalCreate() {
+  try {
+    const caps = await getBrowserCapabilities();
+    return caps.conditionalCreate === 'supported';
+  } catch {
+    return false;
+  }
+}
+
+/** Normalize WebAuthn errors into user-facing messages / cancellation. */
+function translateCeremonyError(err: unknown, kind: 'register' | 'authenticate'): never {
+  if (err instanceof WebAuthnError) {
+    switch (err.code) {
+      case 'ERROR_CEREMONY_ABORTED':
+        throw new CeremonyCancelled('Aborted');
+      case 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED':
+        throw new Error('A passkey for this account already exists in this password manager or device.');
+      case 'ERROR_INVALID_DOMAIN':
+      case 'ERROR_INVALID_RP_ID':
+        throw new Error('Passkeys aren’t available on this domain. Make sure you are using HTTPS (or localhost).');
+    }
+  }
+  const name = (err as any)?.name ?? (err as any)?.cause?.name;
+  if (name === 'NotAllowedError' || name === 'AbortError') {
+    throw new CeremonyCancelled(kind === 'register' ? 'Passkey creation was cancelled.' : 'Sign-in was cancelled.');
+  }
+  throw new Error(
+    kind === 'register'
+      ? 'Your device couldn’t create a passkey. Please try again.'
+      : 'Your device couldn’t use a passkey. Please try again.',
+  );
+}
+
+/** Tell the passkey provider to forget a credential the server doesn't recognize. */
+export async function signalUnknownCredential(rpID: string | undefined, credentialId: string | undefined) {
+  if (!rpID || !credentialId) return;
+  try {
+    await sendSignal({ signalName: 'unknownCredential', rpID, credentialID: credentialId });
+  } catch {
+    /* Signal API unsupported — best effort only. */
+  }
+}
+
+/** Keep the provider's view of this account's passkeys and username in sync with ours. */
+export async function signalAccountState(rpID: string, user: PublicUser, acceptedCredentialIds: string[]) {
+  try {
+    await sendSignal({
+      signalName: 'allAcceptedCredentials',
+      rpID,
+      userID: user.id,
+      allAcceptedCredentialIDs: acceptedCredentialIds,
+    });
+  } catch {
+    /* unsupported */
+  }
+  try {
+    await sendSignal({
+      signalName: 'currentUserDetails',
+      rpID,
+      userID: user.id,
+      userName: user.username,
+      userDisplayName: user.username,
+    });
+  } catch {
+    /* unsupported */
+  }
+}
+
+/**
+ * Create a passkey. Pass `username` to sign up for a new account (when signed out);
+ * omit it to add a passkey to the signed-in account. `conditional` attempts a silent
+ * automatic upgrade (conditional create) and throws CeremonyCancelled if the browser declines.
+ */
+export async function registerPasskey(opts: { username?: string; conditional?: boolean; name?: string } = {}) {
+  const optionsJSON = await api('passkey/registration-options', {
+    body: { username: opts.username, conditional: opts.conditional },
+  });
+
+  let response;
+  try {
+    response = await startRegistration({ optionsJSON, useAutoRegister: !!opts.conditional });
+  } catch (err) {
+    translateCeremonyError(err, 'register');
+  }
+
+  try {
+    return await api<{ ok: true; user: PublicUser; passkey: PublicPasskey }>('passkey/registration-verify', {
+      body: { response, name: opts.name },
+    });
+  } catch (err) {
+    if (err instanceof ApiError) await signalUnknownCredential(err.data.rpID, err.data.credentialId);
+    throw err;
+  }
+}
+
+export interface AuthResult {
+  ok: true;
+  user: PublicUser;
+  reauthExpiresAt: number;
+  acceptedCredentialIds: string[];
+}
+
+/**
+ * Sign in (or reauthenticate) with a passkey. With `autofill`, the request is attached to the
+ * username field's autofill suggestions and resolves only when the user picks a passkey.
+ */
+export async function authenticateWithPasskey(opts: { purpose?: 'signin' | 'reauth'; autofill?: boolean } = {}) {
+  const purpose = opts.purpose ?? 'signin';
+  const optionsJSON = await api('passkey/authentication-options', { body: { purpose } });
+
+  let response;
+  try {
+    response = await startAuthentication({ optionsJSON, useBrowserAutofill: !!opts.autofill });
+  } catch (err) {
+    translateCeremonyError(err, 'authenticate');
+  }
+
+  try {
+    return await api<AuthResult>('passkey/authentication-verify', { body: { response } });
+  } catch (err) {
+    if (err instanceof ApiError && err.code === 'UNKNOWN_CREDENTIAL') {
+      await signalUnknownCredential(err.data.rpID, err.data.credentialId);
+    }
+    throw err;
+  }
+}
+
+/** Read and validate a same-site `next` redirect target from the current URL. */
+export function getNextUrl(fallback = appUrl()) {
+  if (typeof window === 'undefined') return fallback;
+  const next = new URLSearchParams(window.location.search).get('next');
+  if (!next) return fallback;
+  try {
+    const target = new URL(next, window.location.origin);
+    if (target.origin !== window.location.origin) return fallback;
+    return target.pathname + target.search + target.hash;
+  } catch {
+    return fallback;
+  }
+}
diff --git a/src/lib/auth/external.ts b/src/lib/auth/external.ts
new file mode 100644
index 0000000..2e7424a
--- /dev/null
+++ b/src/lib/auth/external.ts
@@ -0,0 +1,43 @@
+/**
+ * Thin server-side client for the existing (external) password auth service.
+ * Proxying through the Astro server lets us establish a trusted session once
+ * the password has been verified.
+ */
+import { randomBytes } from 'node:crypto';
+
+const AUTH_API = process.env.AUTH_API_BASE || 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface ExternalResult {
+  ok: boolean;
+  status: number;
+  data: Record<string, any>;
+}
+
+async function call(endpoint: 'login' | 'register', username: string, password: string): Promise<ExternalResult> {
+  try {
+    const response = await fetch(`${AUTH_API}/${endpoint}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+    const data = await response.json().catch(() => ({}));
+    return { ok: response.ok, status: response.status, data };
+  } catch (err) {
+    console.error(`[auth] External ${endpoint} request failed:`, err);
+    return { ok: false, status: 502, data: { error: 'AUTH_SERVICE_UNAVAILABLE' } };
+  }
+}
+
+export const externalLogin = (username: string, password: string) => call('login', username, password);
+export const externalRegister = (username: string, password: string) => call('register', username, password);
+
+/**
+ * Reserve a username in the external service for a passkey-only account by
+ * registering it with a random, never-disclosed password. This prevents the
+ * same username from later being claimed by someone else via password sign-up.
+ */
+export function reserveUsername(username: string) {
+  // Satisfies the service's policy (≥ 8 chars, contains a number).
+  const secret = `${randomBytes(24).toString('base64url')}9`;
+  return externalRegister(username, secret);
+}
