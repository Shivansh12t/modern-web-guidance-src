+import type { APIRoute } from 'astro';
+import { externalLogin } from '../../../lib/auth/external';
+import {
+  errorResponse,
+  getCurrentUser,
+  json,
+  markReauthenticated,
+  readJson,
+  REAUTH_WINDOW_MS,
+  unauthenticated,
+} from '../../../lib/auth/session';
+
+/** Reauthenticate the signed-in user with their password before a sensitive action. */
+export const POST: APIRoute = async (context) => {
+  const user = await getCurrentUser(context);
+  if (!user) return unauthenticated();
+  if (!user.hasPassword) return errorResponse('NO_PASSWORD', 'This account doesn’t use a password.', 400);
+
+  const body = await readJson<{ password?: string }>(context.request);
+  if (!body?.password) return errorResponse('INVALID_REQUEST', 'Password is required.');
+
+  const result = await externalLogin(user.username, body.password);
+  if (!result.ok) {
+    return errorResponse(result.data.error || 'INVALID_CREDENTIALS', 'That password didn’t work. Try again.', 401);
+  }
+
+  await markReauthenticated(context.session, 'password');
+  return json({ ok: true, reauthExpiresAt: Date.now() + REAUTH_WINDOW_MS });
+};
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
new file mode 100644
index 0000000..51f9b6a
--- /dev/null
+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,25 @@
+import type { APIRoute } from 'astro';
+import { externalRegister } from '../../../lib/auth/external';
+import { findUserByUsername, upsertPasswordUser } from '../../../lib/auth/store';
+import { errorResponse, json, readJson, signIn, toPublicUser } from '../../../lib/auth/session';
+
+/** Password sign-up: registered with the external auth service, then signed in locally. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson<{ username?: string; password?: string }>(request);
+  const username = body?.username?.trim();
+  const password = body?.password;
+  if (!username || !password) return errorResponse('INVALID_REQUEST', 'Username and password are required.');
+
+  if (await findUserByUsername(username)) {
+    return errorResponse('USERNAME_TAKEN', 'That username is already taken.', 409);
+  }
+
+  const result = await externalRegister(username, password);
+  if (!result.ok) {
+    return json({ error: result.data.error || 'Unknown error', message: result.data.message }, result.status || 400);
+  }
+
+  const user = await upsertPasswordUser(username);
+  await signIn(session, user, 'password');
+  return json({ ok: true, user: toPublicUser(user) });
+};
