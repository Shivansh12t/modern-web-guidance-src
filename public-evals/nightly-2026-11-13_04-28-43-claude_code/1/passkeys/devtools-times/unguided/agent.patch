+import type { APIRoute } from 'astro';
+import { externalLogin } from '../../../lib/auth/external';
+import { listPasskeys, upsertPasswordUser } from '../../../lib/auth/store';
+import { errorResponse, json, readJson, signIn, toPublicUser } from '../../../lib/auth/session';
+
+/** Password sign-in: verified by the external auth service, then a local session is established. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson<{ username?: string; password?: string }>(request);
+  const username = body?.username?.trim();
+  const password = body?.password;
+  if (!username || !password) return errorResponse('INVALID_REQUEST', 'Username and password are required.');
+
+  const result = await externalLogin(username, password);
+  if (!result.ok) {
+    return json({ error: result.data.error || 'Unknown error', message: result.data.message }, result.status || 401);
+  }
+
+  const user = await upsertPasswordUser(username);
+  await signIn(session, user, 'password');
+  const passkeys = await listPasskeys(user.id);
+  return json({ ok: true, user: toPublicUser(user), passkeyCount: passkeys.length });
+};
