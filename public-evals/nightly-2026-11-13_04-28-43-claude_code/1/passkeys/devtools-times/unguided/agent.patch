+import React, { useState } from 'react';
+import { FingerPrintIcon } from '@heroicons/react/24/outline';
+import { CeremonyCancelled, registerPasskey } from './passkeyClient';
+
+interface Props {
+  title?: string;
+  onDone: (created: boolean) => void;
+}
+
+/** Offer to create a passkey right after a password-based sign-in or sign-up. */
+export default function PasskeyUpgradePrompt({ title = 'Sign in faster next time', onDone }: Props) {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const create = async () => {
+    setBusy(true);
+    setError(null);
+    try {
+      await registerPasskey();
+      onDone(true);
+    } catch (err) {
+      if (!(err instanceof CeremonyCancelled)) setError((err as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="text-center" role="region" aria-labelledby="passkey-upgrade-title">
+      <FingerPrintIcon className="w-12 h-12 mx-auto text-gray-800" aria-hidden="true" />
+      <h3 id="passkey-upgrade-title" className="mt-3 text-lg font-semibold text-gray-900">
+        {title}
+      </h3>
+      <p className="mt-2 text-sm text-gray-600">
+        Create a passkey to sign in with your fingerprint, face, or screen lock — no password to remember, and it
+        can’t be phished.
+      </p>
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <div className="mt-5 space-y-2">
+        <button
+          type="button"
+          onClick={create}
+          disabled={busy}
+          className="w-full py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+        >
+          {busy ? 'Creating passkey…' : 'Create a passkey'}
+        </button>
+        <button
+          type="button"
+          onClick={() => onDone(false)}
+          disabled={busy}
+          className="w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-400"
+        >
+          Not now
+        </button>
+      </div>
+    </div>
+  );
+}
