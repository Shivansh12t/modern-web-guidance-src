+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { listPasskeys } from '../../../../lib/auth/store';
+import {
+  errorResponse,
+  getCurrentUser,
+  getRelyingParty,
+  json,
+  readJson,
+  saveChallenge,
+  unauthenticated,
+} from '../../../../lib/auth/session';
+
+/**
+ * Begin passkey authentication.
+ * - `purpose: "signin"` (default): discoverable-credential sign-in (modal or autofill).
+ * - `purpose: "reauth"`: confirm the signed-in user's identity before a sensitive action.
+ */
+export const POST: APIRoute = async (context) => {
+  const body = (await readJson<{ purpose?: string }>(context.request)) ?? {};
+  const purpose = body.purpose === 'reauth' ? 'reauth' : 'signin';
+  const { rpID } = getRelyingParty(context.url);
+
+  if (purpose === 'reauth') {
+    const user = await getCurrentUser(context);
+    if (!user) return unauthenticated();
+    const passkeys = await listPasskeys(user.id);
+    if (passkeys.length === 0) return errorResponse('NO_PASSKEYS', 'This account has no passkeys yet.');
+
+    const options = await generateAuthenticationOptions({
+      rpID,
+      allowCredentials: passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+      userVerification: 'required',
+    });
+    saveChallenge(context.session, { challenge: options.challenge, purpose, userId: user.id });
+    return json(options);
+  }
+
+  const options = await generateAuthenticationOptions({ rpID, userVerification: 'preferred' });
+  saveChallenge(context.session, { challenge: options.challenge, purpose });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/authentication-verify.ts b/src/pages/api/auth/passkey/authentication-verify.ts
new file mode 100644
index 0000000..266cd52
--- /dev/null
+++ b/src/pages/api/auth/passkey/authentication-verify.ts
@@ -0,0 +1,99 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { findPasskey, findUserById, listPasskeys, updatePasskey } from '../../../../lib/auth/store';
+import {
+  consumeChallenge,
+  errorResponse,
+  getAuthState,
+  getRelyingParty,
+  json,
+  markReauthenticated,
+  readJson,
+  REAUTH_WINDOW_MS,
+  signIn,
+  toPublicUser,
+} from '../../../../lib/auth/session';
+
+/** Finish passkey authentication (sign-in or reauthentication). */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await readJson<{ response?: AuthenticationResponseJSON }>(request);
+  const response = body?.response;
+  if (!response?.id) return errorResponse('INVALID_REQUEST', 'Missing authentication response.');
+
+  const { rpID, origins } = getRelyingParty(url);
+  const state = await consumeChallenge(session, ['signin', 'reauth']);
+  if (!state) return errorResponse('CHALLENGE_EXPIRED', 'This request expired. Please try again.', 400);
+
+  const passkey = await findPasskey(response.id);
+  if (!passkey) {
+    // Let the browser tell the passkey provider this credential no longer exists here.
+    return errorResponse(
+      'UNKNOWN_CREDENTIAL',
+      'This passkey isn’t registered with The DevTools Times anymore. Try another sign-in method.',
+      404,
+      { credentialId: response.id, rpID },
+    );
+  }
+
+  const userHandle = response.response.userHandle;
+  if (userHandle && userHandle !== passkey.userId) {
+    return errorResponse('VERIFICATION_FAILED', 'We couldn’t verify that passkey.', 400);
+  }
+
+  if (state.purpose === 'reauth') {
+    const auth = await getAuthState(session);
+    if (!auth || auth.userId !== state.userId || passkey.userId !== auth.userId) {
+      return errorResponse('WRONG_ACCOUNT', 'That passkey belongs to a different account.', 403);
+    }
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: isoBase64URL.toBuffer(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: state.purpose === 'reauth',
+    });
+  } catch (err: any) {
+    console.warn('[auth] Authentication verification failed:', err?.message);
+    return errorResponse('VERIFICATION_FAILED', 'We couldn’t verify that passkey. Please try again.', 400);
+  }
+  if (!verification.verified) {
+    return errorResponse('VERIFICATION_FAILED', 'We couldn’t verify that passkey. Please try again.', 400);
+  }
+
+  const { newCounter, credentialBackedUp, credentialDeviceType } = verification.authenticationInfo;
+  await updatePasskey(passkey.id, passkey.userId, {
+    counter: newCounter,
+    backedUp: credentialBackedUp,
+    deviceType: credentialDeviceType,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  const user = await findUserById(passkey.userId);
+  if (!user) return errorResponse('UNKNOWN_CREDENTIAL', 'Account not found.', 404, { credentialId: response.id, rpID });
+
+  if (state.purpose === 'reauth') {
+    await markReauthenticated(session, 'passkey');
+  } else {
+    await signIn(session, user, 'passkey');
+  }
+
+  const passkeys = await listPasskeys(user.id);
+  return json({
+    ok: true,
+    user: toPublicUser(user),
+    reauthExpiresAt: Date.now() + REAUTH_WINDOW_MS,
+    // For PublicKeyCredential.signalAllAcceptedCredentials()
+    acceptedCredentialIds: passkeys.map((p) => p.id),
+  });
+};
diff --git a/src/pages/api/auth/passkey/registration-options.ts b/src/pages/api/auth/passkey/registration-options.ts
new file mode 100644
index 0000000..47adbed
--- /dev/null
