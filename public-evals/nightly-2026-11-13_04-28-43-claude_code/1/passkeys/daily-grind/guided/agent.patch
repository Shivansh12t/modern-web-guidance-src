diff --git a/js/account.js b/js/account.js
new file mode 100644
index 0000000..98f1331
--- /dev/null
+++ b/js/account.js
@@ -0,0 +1,687 @@
+// The Daily Grind — "My Account" passkey flows.
+//
+// Covers: customer registration with a passkey, passkey sign-in (button +
+// conditional/autofill UI), saved passkey management (list / rename / delete /
+// create), profile updates, and passkey reauthentication before sensitive
+// actions. All WebAuthn calls use the native browser APIs; the server contract
+// is documented in /docs/passkeys-api.md.
+
+// Load the JSON-serialization / getClientCapabilities polyfill (self-hosted)
+// only when WebAuthn exists but those newer helpers are missing.
+if (
+  window.PublicKeyCredential &&
+  (!PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.prototype.toJSON)
+) {
+  try {
+    await import("../vendor/webauthn-polyfills-0.1.7.mjs");
+  } catch (e) {
+    console.warn("WebAuthn polyfill failed to load:", e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// DOM references
+// ---------------------------------------------------------------------------
+const $ = (id) => document.getElementById(id);
+
+const accountDialog = $("account-dialog");
+const accountLink = $("account-link");
+const logoutLink = $("logout-link");
+const statusEl = $("account-status");
+
+const signedOutView = $("signed-out-view");
+const signedInView = $("signed-in-view");
+
+const signinForm = $("signin-form");
+const signinButton = $("signin-button");
+const registerForm = $("register-form");
+const registerButton = $("register-button");
+const unsupportedNote = $("passkey-unsupported");
+
+const profileForm = $("profile-form");
+const profileGreeting = $("profile-greeting");
+const passkeyList = $("passkey-list");
+const passkeyEmpty = $("passkey-empty");
+const createPasskeyButton = $("create-passkey");
+
+const renameDialog = $("rename-dialog");
+const renameInput = $("rename-input");
+const deleteDialog = $("delete-dialog");
+const deleteName = $("delete-name");
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+const ZERO_AAGUID = "00000000-0000-0000-0000-000000000000";
+const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: "medium" });
+
+function setStatus(message, tone = "info") {
+  statusEl.textContent = message;
+  statusEl.dataset.tone = tone;
+}
+
+function clearStatus() {
+  statusEl.textContent = "";
+  delete statusEl.dataset.tone;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=', length % 4 !== 1
+function isValidBase64Url(value) {
+  return (
+    typeof value === "string" &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+async function api(path, { method = "GET", body } = {}) {
+  return fetch(path, {
+    method,
+    credentials: "same-origin",
+    headers: body !== undefined ? { "Content-Type": "application/json" } : undefined,
+    body: body !== undefined ? JSON.stringify(body) : undefined,
+  });
+}
+
+async function readError(response, fallback) {
+  try {
+    const data = await response.clone().json();
+    return data.message || data.error || fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function withBusy(button, fn) {
+  return async (...args) => {
+    if (button) button.disabled = true;
+    try {
+      return await fn(...args);
+    } finally {
+      if (button) button.disabled = false;
+    }
+  };
+}
+
+let capabilities = {};
+async function loadCapabilities() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return {};
+  try {
+    return await PublicKeyCredential.getClientCapabilities();
+  } catch {
+    return {};
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Signal API (progressive enhancement — never fatal)
+// ---------------------------------------------------------------------------
+async function signalUnknownCredential(rpId, credentialId) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalUnknownCredential) return;
+  if (!rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    // rpId always comes from the server-provided options, never location.hostname
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn("signalUnknownCredential sync warning:", e);
+  }
+}
+
+async function signalAllAcceptedCredentials(rpId, userId, credentials) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn("signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.");
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn("signalAllAcceptedCredentials sync warning:", e);
+  }
+}
+
+async function signalCurrentUserDetails(rpId, userId, name, displayName) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn("signalCurrentUserDetails skipped: invalid rpId or userId.");
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn("signalCurrentUserDetails sync warning:", e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Sign-in (conditional autofill + explicit button)
+// ---------------------------------------------------------------------------
+let autofillAbortController = new AbortController();
+
+function abortAutofill() {
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+}
+
+async function fetchSigninOptions() {
+  const response = await api("/api/signin/options", { method: "POST" });
+  if (!response.ok) throw new Error(await readError(response, "Couldn't start passkey sign-in."));
+  return PublicKeyCredential.parseRequestOptionsFromJSON(await response.json());
+}
+
+async function verifySignin(publicKey, credential) {
+  const encoded = credential.toJSON();
+  let response;
+  try {
+    response = await api("/api/signin/verify", { method: "POST", body: encoded });
+  } catch (e) {
+    console.error("Sign-in verification request failed:", e);
+    setStatus("We couldn't reach the server. Please try again.", "error");
+    return false;
+  }
+
+  if (response.ok) {
+    const { user } = await response.json();
+    setStatus(`Welcome back, ${user.displayName}!`, "success");
+    await showSignedIn(user);
+    return true;
+  }
+
+  if (response.status === 404) {
+    // Passkey isn't recognized by the server (deleted / never registered).
+    // We're unauthenticated here, so it's safe to tell the passkey provider.
+    await signalUnknownCredential(publicKey.rpId, encoded.id);
+    setStatus(
+      "That passkey is no longer registered with The Daily Grind. Try another passkey or create an account.",
+      "error",
+    );
+  } else {
+    setStatus(await readError(response, "Sign-in failed. Please try again."), "error");
+  }
+  return false;
+}
+
+async function startConditionalSignin() {
