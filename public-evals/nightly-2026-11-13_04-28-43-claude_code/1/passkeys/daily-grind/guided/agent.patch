+  let response;
+  try {
+    response = await withReauth(() => api("/api/user", { method: "PUT", body: { name, displayName } }));
+  } catch (e) {
+    console.error("Profile update failed:", e);
+    setStatus("We couldn't reach the server. Please try again.", "error");
+    return;
+  }
