index 0000000..8bbe039
--- /dev/null
+++ b/js/passkeys.js
@@ -0,0 +1,128 @@
+// Browser-side WebAuthn helpers: feature detection, option decoding,
+// credential serialization, and the Signal API.
+import { base64urlToBuffer, bufferToBase64url } from './encoding.js';
+
+export function isWebAuthnSupported() {
+  return typeof window.PublicKeyCredential === 'function' && !!navigator.credentials?.create;
+}
+
+export async function isConditionalMediationAvailable() {
+  try {
+    return isWebAuthnSupported() && typeof PublicKeyCredential.isConditionalMediationAvailable === 'function'
+      && (await PublicKeyCredential.isConditionalMediationAvailable());
+  } catch {
+    return false;
+  }
+}
+
+export async function isPlatformAuthenticatorAvailable() {
+  try {
+    return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+  } catch {
+    return false;
+  }
+}
+
+function decodeDescriptors(list = []) {
+  return list.map((d) => ({ ...d, id: base64urlToBuffer(d.id) }));
+}
+
+function decodeCreationOptions(json) {
+  return {
+    ...json,
+    challenge: base64urlToBuffer(json.challenge),
+    user: { ...json.user, id: base64urlToBuffer(json.user.id) },
+    excludeCredentials: decodeDescriptors(json.excludeCredentials),
+  };
+}
+
+function decodeRequestOptions(json) {
+  return {
+    ...json,
+    challenge: base64urlToBuffer(json.challenge),
+    allowCredentials: decodeDescriptors(json.allowCredentials),
+  };
+}
+
+// Serialized manually rather than with credential.toJSON(): some providers
+// have shipped broken toJSON() implementations.
+function serializeCredential(credential) {
+  const { response } = credential;
+  const json = {
+    id: credential.id,
+    rawId: bufferToBase64url(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment ?? null,
+    clientExtensionResults: credential.getClientExtensionResults?.() ?? {},
+    response: { clientDataJSON: bufferToBase64url(response.clientDataJSON) },
+  };
+  if (response.attestationObject) {
+    json.response.attestationObject = bufferToBase64url(response.attestationObject);
+    json.response.transports = response.getTransports?.() ?? [];
+  } else {
+    json.response.authenticatorData = bufferToBase64url(response.authenticatorData);
+    json.response.signature = bufferToBase64url(response.signature);
+    json.response.userHandle = response.userHandle ? bufferToBase64url(response.userHandle) : null;
+  }
+  return json;
+}
+
+export async function createPasskey(optionsJSON) {
+  const credential = await navigator.credentials.create({ publicKey: decodeCreationOptions(optionsJSON) });
+  return serializeCredential(credential);
+}
+
+/**
+ * Runs navigator.credentials.get(). Pass mediation: 'conditional' for autofill UI.
+ * Resolves null if aborted.
+ */
+export async function getPasskey(optionsJSON, { mediation, signal } = {}) {
+  try {
+    const credential = await navigator.credentials.get({
+      publicKey: decodeRequestOptions(optionsJSON),
+      ...(mediation ? { mediation } : {}),
+      ...(signal ? { signal } : {}),
+    });
+    return credential ? serializeCredential(credential) : null;
+  } catch (err) {
+    if (err?.name === 'AbortError') return null;
+    throw err;
+  }
+}
+
+/** Maps WebAuthn DOMExceptions to friendly copy. Returns null when no message should be shown. */
+export function describeWebAuthnError(err, ceremony) {
+  switch (err?.name) {
+    case 'NotAllowedError':
+      return ceremony === 'create'
+        ? 'Passkey creation was cancelled or timed out.'
+        : 'Sign-in was cancelled or timed out.';
+    case 'InvalidStateError':
+      return 'This device or password manager already has a passkey for your account.';
+    case 'AbortError':
+      return null;
+    case 'SecurityError':
+      return 'Passkeys need a secure (HTTPS) connection on this domain.';
+    case 'NotSupportedError':
+      return 'This device doesn’t support the required passkey features.';
+    default:
+      return null;
+  }
+}
+
+// --- Signal API: keep passkey providers in sync with the server's view. -----
+
+export function signalUnknownCredential(rpId, credentialId) {
+  if (typeof PublicKeyCredential?.signalUnknownCredential !== 'function') return;
+  PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }).catch(() => {});
+}
+
+export function signalAcceptedCredentials(rpId, userId, credentialIds) {
+  if (typeof PublicKeyCredential?.signalAllAcceptedCredentials !== 'function') return;
+  PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds }).catch(() => {});
+}
+
+export function signalCurrentUserDetails(rpId, userId, name, displayName) {
+  if (typeof PublicKeyCredential?.signalCurrentUserDetails !== 'function') return;
+  PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName }).catch(() => {});
+}
diff --git a/js/relying-party.js b/js/relying-party.js
new file mode 100644
index 0000000..75c12ea
--- /dev/null
+++ b/js/relying-party.js
@@ -0,0 +1,512 @@
+/**
+ * Daily Grind demo relying party (RP).
+ *
+ * The Daily Grind site is a static bundle with no backend, so this module plays
+ * the role of the account server. It exposes the same request/response shape a
+ * real backend would (JSON in, JSON out, base64url for binary) and performs the
+ * full server-side WebAuthn verification: challenge binding, origin and RP ID
+ * checks, flag checks, signature verification with WebCrypto, and signature
+ * counter checks.
+ *
+ * Data is persisted in localStorage. To move to production, port `handlers`
+ * to server routes with the same names and swap `callApi` in api.js for fetch().
+ */
+import {
+  AUTH_FLAGS,
+  base64urlToBuffer,
+  bufferToBase64url,
+  bytesEqual,
+  concatBytes,
+  decodeCbor,
+  parseAuthenticatorData,
+  randomBase64url,
+  sha256,
+} from './encoding.js';
+
+const DB_KEY = 'dailyGrind.rp.v1';
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const RP_NAME = 'The Daily Grind';
+const SUPPORTED_ALGS = [-8, -7, -257]; // EdDSA, ES256, RS256
+
+// Known passkey providers (https://github.com/passkeydeveloper/passkey-authenticator-aaguids).
+const AAGUID_NAMES = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+};
+
+export class RpError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.code = code;
+    this.details = details;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Persistence
+// ---------------------------------------------------------------------------
+
+function emptyDb() {
+  return { users: {}, credentials: {}, challenges: {}, sessions: {} };
+}
+
+function loadDb() {
+  try {
+    const raw = localStorage.getItem(DB_KEY);
+    const db = raw ? JSON.parse(raw) : emptyDb();
+    return { ...emptyDb(), ...db };
+  } catch {
+    return emptyDb();
+  }
+}
+
+function saveDb(db) {
+  const now = Date.now();
+  for (const [key, c] of Object.entries(db.challenges)) if (c.expiresAt < now) delete db.challenges[key];
+  for (const [key, s] of Object.entries(db.sessions)) if (s.expiresAt < now) delete db.sessions[key];
+  localStorage.setItem(DB_KEY, JSON.stringify(db));
+}
+
+function rpId() {
+  return location.hostname;
+}
+
+function expectedOrigin() {
+  return location.origin;
+}
+
+function normalizeEmail(email) {
+  return String(email || '').trim().toLowerCase();
+}
+
+function validateProfile({ email, displayName }) {
+  const cleanEmail = normalizeEmail(email);
+  const cleanName = String(displayName || '').trim();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
+    throw new RpError('invalid_email', 'Please enter a valid email address.');
+  }
+  if (!cleanName) throw new RpError('invalid_name', 'Please enter your name.');
+  if (cleanName.length > 64) throw new RpError('invalid_name', 'Names can be at most 64 characters.');
+  return { email: cleanEmail, displayName: cleanName };
+}
+
+function findUserByEmail(db, email) {
+  return Object.values(db.users).find((u) => u.email === email);
+}
+
+function userCredentials(db, userId) {
+  return Object.values(db.credentials).filter((c) => c.userId === userId);
+}
+
+function requireSession(db, token) {
+  const session = token && db.sessions[token];
+  if (!session || session.expiresAt < Date.now() || !db.users[session.userId]) {
+    throw new RpError('unauthenticated', 'Your session has expired. Please sign in again.');
+  }
+  return session;
+}
+
+function requireRecentAuth(session) {
+  if (!session.authenticatedAt || Date.now() - session.authenticatedAt > REAUTH_WINDOW_MS) {
+    throw new RpError('reauth_required', 'Please confirm it’s you to continue.');
+  }
+}
+
+function createSession(db, userId) {
+  const token = randomBase64url(32);
+  const now = Date.now();
+  db.sessions[token] = { userId, createdAt: now, authenticatedAt: now, expiresAt: now + SESSION_TTL_MS };
+  return token;
+}
+
+function issueChallenge(db, data) {
+  const challenge = randomBase64url(32);
+  db.challenges[challenge] = { ...data, expiresAt: Date.now() + CHALLENGE_TTL_MS };
+  return challenge;
+}
+
+/** Looks up and consumes a challenge (single use). */
+function consumeChallenge(db, clientData, expectedPurpose) {
+  const record = db.challenges[clientData.challenge];
+  if (record) delete db.challenges[clientData.challenge];
+  if (!record || record.expiresAt < Date.now()) {
+    throw new RpError('challenge_expired', 'This request has expired. Please try again.');
+  }
+  if (record.purpose !== expectedPurpose) {
+    throw new RpError('verification_failed', 'Unexpected challenge purpose.');
+  }
+  return record;
+}
+
+function publicUser(user) {
+  return { id: user.id, email: user.email, displayName: user.displayName, createdAt: user.createdAt };
+}
+
+function publicCredential(c) {
+  return {
+    id: c.id,
+    name: c.name,
+    provider: c.provider,
+    createdAt: c.createdAt,
+    lastUsedAt: c.lastUsedAt,
+    backupEligible: c.backupEligible,
+    backedUp: c.backedUp,
+    transports: c.transports,
+    deviceType: c.backupEligible ? 'multiDevice' : 'singleDevice',
+  };
+}
+
+function accountResponse(db, user) {
+  return {
+    user: publicUser(user),
+    credentials: userCredentials(db, user.id)
+      .sort((a, b) => a.createdAt - b.createdAt)
+      .map(publicCredential),
+    rpId: rpId(),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// WebAuthn verification
+// ---------------------------------------------------------------------------
+
+function coseToJwk(cose) {
+  const kty = cose.get(1);
+  const alg = cose.get(3);
+  if (kty === 2 && alg === -7 && cose.get(-1) === 1) {
+    return {
+      alg,
+      jwk: { kty: 'EC', crv: 'P-256', x: bufferToBase64url(cose.get(-2)), y: bufferToBase64url(cose.get(-3)), ext: true },
+    };
+  }
+  if (kty === 3 && alg === -257) {
+    return {
+      alg,
+      jwk: { kty: 'RSA', n: bufferToBase64url(cose.get(-1)), e: bufferToBase64url(cose.get(-2)), alg: 'RS256', ext: true },
+    };
+  }
+  if (kty === 1 && alg === -8 && cose.get(-1) === 6) {
+    return { alg, jwk: { kty: 'OKP', crv: 'Ed25519', x: bufferToBase64url(cose.get(-2)), ext: true } };
+  }
+  throw new RpError('unsupported_algorithm', 'This passkey uses an unsupported algorithm.');
+}
+
+/** Converts an ASN.1 DER ECDSA signature to the raw r||s form WebCrypto expects. */
+function derToRawSignature(der, size = 32) {
+  const bytes = new Uint8Array(der);
+  if (bytes[0] !== 0x30) throw new Error('Invalid DER signature');
+  let offset = bytes[1] & 0x80 ? 2 + (bytes[1] & 0x7f) : 2;
+  const readInt = () => {
+    if (bytes[offset++] !== 0x02) throw new Error('Invalid DER integer');
+    const len = bytes[offset++];
+    let value = bytes.subarray(offset, offset + len);
+    offset += len;
+    while (value.length > size && value[0] === 0) value = value.subarray(1);
+    if (value.length > size) throw new Error('Invalid DER integer length');
+    const out = new Uint8Array(size);
+    out.set(value, size - value.length);
+    return out;
+  };
+  return concatBytes(readInt(), readInt());
+}
+
+async function verifySignature({ alg, jwk }, signature, data) {
+  try {
+    if (alg === -7) {
+      const key = await crypto.subtle.importKey('jwk', jwk, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+      return crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, derToRawSignature(signature), data);
+    }
+    if (alg === -257) {
+      const key = await crypto.subtle.importKey('jwk', jwk, { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, false, ['verify']);
+      return crypto.subtle.verify('RSASSA-PKCS1-v1_5', key, signature, data);
+    }
+    if (alg === -8) {
+      const key = await crypto.subtle.importKey('jwk', jwk, { name: 'Ed25519' }, false, ['verify']);
+      return crypto.subtle.verify('Ed25519', key, signature, data);
+    }
+  } catch (err) {
+    console.warn('[rp] signature verification error', err);
+  }
+  return false;
+}
+
+function parseClientData(clientDataJSON, expectedType) {
+  let clientData;
+  try {
+    clientData = JSON.parse(new TextDecoder().decode(base64urlToBuffer(clientDataJSON)));
+  } catch {
+    throw new RpError('verification_failed', 'Malformed client data.');
+  }
+  if (clientData.type !== expectedType) throw new RpError('verification_failed', 'Unexpected ceremony type.');
+  if (clientData.origin !== expectedOrigin()) throw new RpError('verification_failed', 'Origin mismatch.');
+  if (clientData.crossOrigin === true) throw new RpError('verification_failed', 'Cross-origin requests are not allowed.');
+  return clientData;
+}
+
+async function checkAuthData(authData, { requireUV }) {
+  if (!bytesEqual(authData.rpIdHash, await sha256(rpId()))) {
+    throw new RpError('verification_failed', 'RP ID mismatch.');
+  }
+  if (!authData.userPresent) throw new RpError('verification_failed', 'User presence was not confirmed.');
+  if (requireUV && !authData.userVerified) {
+    throw new RpError('verification_failed', 'Your device did not verify your identity (PIN, fingerprint, or face).');
+  }
+  if (!authData.backupEligible && authData.backedUp) {
+    throw new RpError('verification_failed', 'Invalid backup flags.');
+  }
+}
+
+function defaultPasskeyName(provider, existingCount) {
+  const base = provider || 'Passkey';
+  return existingCount ? `${base} (${existingCount + 1})` : base;
+}
+
+// ---------------------------------------------------------------------------
+// Route handlers
+// ---------------------------------------------------------------------------
+
+const handlers = {
+  /** Begin registration for a new account (no session) or add a passkey to the signed-in account. */
+  async 'registration/options'(db, { session: token, email, displayName }) {
+    let user;
+    let pending;
+    if (token) {
+      const session = requireSession(db, token);
+      user = db.users[session.userId];
+      pending = { purpose: 'registration', userId: user.id, sessionToken: token };
+    } else {
+      const profile = validateProfile({ email, displayName });
+      if (findUserByEmail(db, profile.email)) {
+        throw new RpError('email_taken', 'An account with that email already exists. Try signing in with your passkey.');
+      }
+      // The account is only created once the passkey is verified.
+      user = { id: randomBase64url(32), ...profile };
+      pending = { purpose: 'registration', userId: user.id, newUser: profile };
+    }
+    const challenge = issueChallenge(db, pending);
+    return {
+      publicKey: {
+        rp: { id: rpId(), name: RP_NAME },
+        user: { id: user.id, name: user.email, displayName: user.displayName },
+        challenge,
+        pubKeyCredParams: SUPPORTED_ALGS.map((alg) => ({ type: 'public-key', alg })),
+        timeout: CHALLENGE_TTL_MS,
+        attestation: 'none',
+        authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+        excludeCredentials: userCredentials(db, user.id).map((c) => ({ type: 'public-key', id: c.id, transports: c.transports })),
+        extensions: { credProps: true },
+      },
+    };
+  },
+
+  async 'registration/verify'(db, { credential }) {
+    const clientData = parseClientData(credential.response.clientDataJSON, 'webauthn.create');
+    const pending = consumeChallenge(db, clientData, 'registration');
+    if (pending.sessionToken) requireSession(db, pending.sessionToken);
+
+    const attestation = decodeCbor(base64urlToBuffer(credential.response.attestationObject)).value;
+    const authData = parseAuthenticatorData(attestation.get('authData'));
+    await checkAuthData(authData, { requireUV: false });
+    if (!authData.credentialId) throw new RpError('verification_failed', 'No credential data returned.');
+    const credentialId = bufferToBase64url(authData.credentialId);
+    if (credentialId !== credential.id || credential.id !== credential.rawId) {
+      throw new RpError('verification_failed', 'Credential ID mismatch.');
+    }
+    if (db.credentials[credentialId]) {
+      throw new RpError('credential_exists', 'This passkey is already registered.');
+    }
+    const key = coseToJwk(authData.credentialPublicKey);
+    if (!SUPPORTED_ALGS.includes(key.alg)) throw new RpError('unsupported_algorithm', 'Unsupported algorithm.');
+
+    let user = db.users[pending.userId];
+    if (pending.newUser) {
+      if (findUserByEmail(db, pending.newUser.email)) {
+        throw new RpError('email_taken', 'An account with that email already exists.');
+      }
+      user = { id: pending.userId, ...pending.newUser, createdAt: Date.now() };
+      db.users[user.id] = user;
+    }
+    if (!user) throw new RpError('unauthenticated', 'Account not found.');
+
+    const provider = AAGUID_NAMES[authData.aaguid] || null;
+    const now = Date.now();
+    db.credentials[credentialId] = {
+      id: credentialId,
+      userId: user.id,
+      alg: key.alg,
+      jwk: key.jwk,
+      signCount: authData.signCount,
+      aaguid: authData.aaguid,
+      provider,
+      name: defaultPasskeyName(provider, userCredentials(db, user.id).filter((c) => c.provider === provider).length),
+      transports: credential.response.transports || [],
+      backupEligible: authData.backupEligible,
+      backedUp: authData.backedUp,
+      createdAt: now,
+      lastUsedAt: now,
+    };
+
+    const sessionToken = pending.sessionToken || createSession(db, user.id);
+    if (pending.sessionToken) db.sessions[sessionToken].authenticatedAt = now;
+    return { session: sessionToken, credentialId, ...accountResponse(db, user) };
+  },
+
+  /** Begin sign-in (discoverable, no session) or reauthentication of the signed-in user. */
+  async 'authentication/options'(db, { session: token, purpose = 'signin' }) {
+    if (purpose === 'reauth') {
+      const session = requireSession(db, token);
+      const creds = userCredentials(db, session.userId);
+      const challenge = issueChallenge(db, { purpose: 'reauth', userId: session.userId, sessionToken: token });
+      return {
+        publicKey: {
+          challenge,
+          rpId: rpId(),
+          timeout: CHALLENGE_TTL_MS,
+          userVerification: 'required',
+          allowCredentials: creds.map((c) => ({ type: 'public-key', id: c.id, transports: c.transports })),
+        },
+      };
+    }
+    const challenge = issueChallenge(db, { purpose: 'signin' });
+    return {
+      publicKey: { challenge, rpId: rpId(), timeout: CHALLENGE_TTL_MS, userVerification: 'preferred', allowCredentials: [] },
+    };
+  },
+
+  async 'authentication/verify'(db, { credential, purpose = 'signin' }) {
+    const clientData = parseClientData(credential.response.clientDataJSON, 'webauthn.get');
+    const pending = consumeChallenge(db, clientData, purpose);
+
+    const stored = db.credentials[credential.id];
+    if (!stored) {
+      throw new RpError('unknown_credential', 'That passkey is no longer linked to a Daily Grind account. It may have been removed.', {
+        credentialId: credential.id,
+        rpId: rpId(),
+      });
+    }
+    const user = db.users[stored.userId];
+    if (!user) throw new RpError('unknown_credential', 'Account not found.', { credentialId: credential.id, rpId: rpId() });
+
+    if (credential.response.userHandle && credential.response.userHandle !== user.id) {
+      throw new RpError('verification_failed', 'Passkey does not belong to this account.');
+    }
+    if (purpose === 'reauth') {
+      const session = requireSession(db, pending.sessionToken);
+      if (session.userId !== user.id) {
+        throw new RpError('wrong_account', 'That passkey belongs to a different account.');
+      }
+    }
+
+    const authDataBytes = base64urlToBuffer(credential.response.authenticatorData);
+    const authData = parseAuthenticatorData(authDataBytes);
+    await checkAuthData(authData, { requireUV: purpose === 'reauth' });
+
+    const signedData = concatBytes(authDataBytes, await sha256(base64urlToBuffer(credential.response.clientDataJSON)));
+    const valid = await verifySignature(stored, base64urlToBuffer(credential.response.signature), signedData);
+    if (!valid) throw new RpError('verification_failed', 'Passkey signature could not be verified.');
+
+    if ((authData.signCount !== 0 || stored.signCount !== 0) && authData.signCount <= stored.signCount) {
+      throw new RpError('verification_failed', 'This passkey may have been cloned. Please contact support.');
+    }
+
+    stored.signCount = authData.signCount;
+    stored.backedUp = authData.backedUp;
+    stored.lastUsedAt = Date.now();
+
+    let sessionToken = pending.sessionToken;
+    if (purpose === 'reauth') {
+      db.sessions[sessionToken].authenticatedAt = Date.now();
+    } else {
+      sessionToken = createSession(db, user.id);
+    }
+    return { session: sessionToken, ...accountResponse(db, user) };
+  },
+
+  async 'account'(db, { session: token }) {
+    const session = requireSession(db, token);
+    return {
+      ...accountResponse(db, db.users[session.userId]),
+      recentlyAuthenticated: Date.now() - session.authenticatedAt <= REAUTH_WINDOW_MS,
+    };
+  },
+
+  async 'account/update'(db, { session: token, email, displayName }) {
+    const session = requireSession(db, token);
+    const user = db.users[session.userId];
+    const profile = validateProfile({ email, displayName });
+    if (profile.email !== user.email) {
+      requireRecentAuth(session); // changing the sign-in identifier is sensitive
+      const other = findUserByEmail(db, profile.email);
+      if (other && other.id !== user.id) throw new RpError('email_taken', 'That email is already used by another account.');
+    }
+    user.email = profile.email;
+    user.displayName = profile.displayName;
+    return accountResponse(db, user);
+  },
+
+  async 'credentials/rename'(db, { session: token, credentialId, name }) {
+    const session = requireSession(db, token);
+    const cred = db.credentials[credentialId];
+    if (!cred || cred.userId !== session.userId) throw new RpError('not_found', 'Passkey not found.');
+    const clean = String(name || '').trim();
+    if (!clean) throw new RpError('invalid_name', 'Please give your passkey a name.');
+    if (clean.length > 48) throw new RpError('invalid_name', 'Passkey names can be at most 48 characters.');
+    cred.name = clean;
+    return accountResponse(db, db.users[session.userId]);
+  },
+
+  async 'credentials/delete'(db, { session: token, credentialId }) {
+    const session = requireSession(db, token);
+    const cred = db.credentials[credentialId];
+    if (!cred || cred.userId !== session.userId) throw new RpError('not_found', 'Passkey not found.');
+    if (userCredentials(db, session.userId).length <= 1) {
+      throw new RpError('last_credential', 'You can’t remove your only passkey — add another one first so you don’t get locked out.');
+    }
+    requireRecentAuth(session);
+    delete db.credentials[credentialId];
+    return { removedCredentialId: credentialId, ...accountResponse(db, db.users[session.userId]) };
+  },
+
+  async 'session/delete'(db, { session: token }) {
+    if (token) delete db.sessions[token];
+    return { ok: true };
+  },
+};
+
+/**
+ * Simulated network boundary: deep-copies input/output through JSON so the
+ * client can never share object references with "server" state.
+ */
+export async function handleRequest(route, body = {}) {
+  const handler = handlers[route];
+  if (!handler) throw new RpError('not_found', `Unknown route: ${route}`);
+  const db = loadDb();
+  try {
+    const result = await handler(db, JSON.parse(JSON.stringify(body)));
+    return JSON.parse(JSON.stringify(result));
+  } catch (err) {
+    if (err instanceof RpError) throw err;
+    console.error('[rp]', err);
+    throw new RpError('verification_failed', 'We couldn’t verify that passkey. Please try again.');
+  } finally {
+    // Persist even on failure so consumed challenges stay consumed.
+    saveDb(db);
+  }
+}
