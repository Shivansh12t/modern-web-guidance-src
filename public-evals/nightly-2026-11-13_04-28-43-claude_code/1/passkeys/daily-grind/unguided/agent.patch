diff --git a/css/account.css b/css/account.css
new file mode 100644
index 0000000..a3f544e
--- /dev/null
+++ b/css/account.css
@@ -0,0 +1,366 @@
+/* My Account dialog — passkey sign-in and account management */
+
+.acct {
+  width: min(520px, calc(100vw - 32px));
+  max-height: calc(100vh - 48px);
+  margin: auto;
+  padding: 0;
+  border: none;
+  border-radius: 12px;
+  color: var(--text);
+  background: var(--light);
+  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
+  overflow-y: auto;
+}
+
+.acct::backdrop {
+  background: rgba(30, 18, 14, 0.6);
+  backdrop-filter: blur(2px);
+}
+
+.acct-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 18px 24px;
+  background: var(--primary);
+  color: white;
+  position: sticky;
+  top: 0;
+  z-index: 1;
+}
+
+.acct-header h2 {
+  font-size: 1.25rem;
+  letter-spacing: 0.5px;
+}
+
+.acct-close {
+  background: none;
+  border: none;
+  color: white;
+  font-size: 1.8rem;
+  line-height: 1;
+  cursor: pointer;
+  padding: 0 4px;
+}
+
+.acct-close:hover,
+.acct-close:focus-visible {
+  color: var(--accent);
+}
+
+.acct-view {
+  padding: 20px 24px 24px;
+}
+
+.acct-lead {
+  font-size: 1.02rem;
+  margin-bottom: 16px;
+}
+
+.acct-muted,
+.acct-hint {
+  color: #6d4c41;
+  font-size: 0.85rem;
+}
+
+.acct-hint {
+  margin-top: -4px;
+}
+
+.acct-status {
+  margin: 16px 24px 0;
+  padding: 10px 14px;
+  border-radius: 6px;
+  font-size: 0.9rem;
+  border-left: 4px solid #8d6e63;
+  background: #efebe9;
+}
+
+.acct-status[data-kind="success"] {
+  border-color: #2e7d32;
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.acct-status[data-kind="error"] {
+  border-color: #c62828;
+  background: #ffebee;
+  color: #b71c1c;
+}
+
+.acct-form {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.acct-form label {
+  font-weight: 600;
+  font-size: 0.85rem;
+}
+
+.acct input {
+  font: inherit;
+  padding: 10px 12px;
+  border: 1px solid #bcaaa4;
+  border-radius: 6px;
+  background: white;
+  color: var(--text);
+  width: 100%;
+}
+
+.acct input:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+  border-color: var(--primary);
+}
+
+.acct-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  font: inherit;
+  font-size: 0.95rem;
+  padding: 10px 18px;
+  border-radius: 6px;
+  border: 1px solid var(--primary);
+  background: white;
+  color: var(--primary);
+  cursor: pointer;
+  transition: background 0.2s, color 0.2s, opacity 0.2s;
+}
+
+.acct-btn:hover {
+  background: var(--secondary);
+}
+
+.acct-btn:focus-visible,
+.acct-link:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.acct-btn-primary {
+  background: var(--primary);
+  color: white;
+  margin-top: 8px;
+}
+
+.acct-btn-primary:hover {
+  background: #3e2723;
+}
+
+.acct-btn-danger {
+  background: #c62828;
+  border-color: #c62828;
+  color: white;
+}
+
+.acct-btn-danger:hover {
+  background: #b71c1c;
+}
+
+.acct-btn-small {
+  padding: 6px 12px;
+  font-size: 0.85rem;
+  margin-top: 0;
+}
+
+.acct-btn-block {
+  width: 100%;
+  margin-top: 8px;
+}
+
+.acct-btn[aria-busy="true"] {
+  opacity: 0.65;
+  cursor: progress;
+}
+
+.acct-btn:disabled {
+  cursor: not-allowed;
+}
+
+.acct-icon {
+  width: 20px;
+  height: 20px;
+  fill: currentColor;
+  flex-shrink: 0;
+}
+
+.acct-link {
+  background: none;
+  border: none;
+  font: inherit;
+  font-size: 0.9rem;
+  color: var(--primary);
+  text-decoration: underline;
+  cursor: pointer;
+  padding: 2px;
+}
+
+.acct-link:disabled {
+  color: #a1887f;
+  text-decoration: none;
+  cursor: not-allowed;
+}
+
+.acct-danger {
+  color: #c62828;
+}
+
+.acct-switch {
+  margin-top: 18px;
+  text-align: center;
+  font-size: 0.9rem;
+}
+
+.acct-faq {
+  margin-top: 16px;
+  font-size: 0.88rem;
+}
+
+.acct-faq summary {
+  cursor: pointer;
+  font-weight: 600;
+}
+
+.acct-faq p {
+  margin-top: 6px;
+  color: #5d4037;
+}
+
+.acct-card {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
+  padding: 16px 18px;
+  margin-bottom: 16px;
+}
+
+.acct-card-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 10px;
+}
+
+.acct-card-head h3 {
+  color: var(--primary);
+  font-size: 1.05rem;
+}
+
+.acct-profile {
+  display: grid;
+  grid-template-columns: max-content 1fr;
+  gap: 6px 16px;
+  font-size: 0.92rem;
+}
+
+.acct-profile dt {
+  color: #6d4c41;
+}
+
+.acct-profile dd {
+  overflow-wrap: anywhere;
+}
+
+.acct-row {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.acct-row .acct-btn {
+  margin-top: 8px;
+}
+
+.acct-passkeys {
+  list-style: none;
+  margin-top: 12px;
+}
+
+.acct-passkey {
+  border-top: 1px solid #efebe9;
+  padding: 12px 0;
+}
+
+.acct-passkey:first-child {
+  border-top: none;
+}
+
+.acct-passkey-main {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+}
+
+.acct-passkey-icon {
+  margin-top: 2px;
+  color: var(--primary);
+}
+
+.acct-passkey-text {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.acct-passkey-text strong {
+  overflow-wrap: anywhere;
+}
+
+.acct-passkey-text small {
+  color: #6d4c41;
+}
+
+.acct-badge {
+  align-self: flex-start;
+  font-size: 0.72rem;
+  padding: 1px 8px;
+  margin: 2px 0;
+  border-radius: 999px;
+  background: var(--secondary);
+}
+
+.acct-passkey-actions {
+  display: flex;
+  gap: 8px;
+  flex-shrink: 0;
+}
+
+.acct-inline {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.88rem;
+}
+
+.acct-inline input {
+  flex: 1;
+  min-width: 160px;
+  padding: 6px 10px;
+}
+
+.acct-inline span {
+  flex-basis: 100%;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+@media (max-width: 480px) {
+  .acct-passkey-main {
+    flex-wrap: wrap;
+  }
+
+  .acct-passkey-actions {
+    width: 100%;
+    padding-left: 32px;
+  }
+}
