diff --git a/js/account.js b/js/account.js
new file mode 100644
index 0000000..93e28ac
--- /dev/null
+++ b/js/account.js
@@ -0,0 +1,449 @@
+// "My Account" UI: passkey registration, sign-in (modal + autofill),
+// passkey management, profile updates, and reauthentication.
+import { ApiError, callApi, session } from './api.js';
+import {
+  createPasskey,
+  describeWebAuthnError,
+  getPasskey,
+  isConditionalMediationAvailable,
+  isWebAuthnSupported,
+  signalAcceptedCredentials,
+  signalCurrentUserDetails,
+  signalUnknownCredential,
+} from './passkeys.js';
+
+const dialog = document.getElementById('account-dialog');
+const statusEl = dialog.querySelector('.acct-status');
+const views = dialog.querySelectorAll('[data-view]');
+const passkeyList = dialog.querySelector('[data-passkey-list]');
+const passkeyTemplate = document.getElementById('passkey-item');
+const profileForm = dialog.querySelector('[data-form="profile"]');
+const profileDisplay = dialog.querySelector('[data-profile-display]');
+
+const state = {
+  account: null, // { user, credentials, rpId }
+  view: null,
+  conditional: null, // AbortController for the autofill request
+};
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const relativeFormat = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function timeAgo(ts) {
+  const seconds = Math.round((ts - Date.now()) / 1000);
+  const units = [['year', 31536000], ['month', 2592000], ['day', 86400], ['hour', 3600], ['minute', 60]];
+  for (const [unit, size] of units) {
+    if (Math.abs(seconds) >= size) return relativeFormat.format(Math.round(seconds / size), unit);
+  }
+  return 'just now';
+}
+
+// ---------------------------------------------------------------------------
+// Status + busy helpers
+// ---------------------------------------------------------------------------
+
+function setStatus(message, kind = 'info') {
+  if (!message) {
+    statusEl.hidden = true;
+    statusEl.textContent = '';
+    return;
+  }
+  statusEl.hidden = false;
+  statusEl.dataset.kind = kind;
+  statusEl.textContent = message;
+}
+
+/** Disables `button` while `task` runs so ceremonies can't be double-started. */
+async function busy(button, task) {
+  if (button?.disabled) return;
+  if (button) {
+    button.disabled = true;
+    button.setAttribute('aria-busy', 'true');
+  }
+  try {
+    return await task();
+  } finally {
+    if (button) {
+      button.disabled = false;
+      button.removeAttribute('aria-busy');
+    }
+  }
+}
+
+function handleError(err, ceremony) {
+  if (err instanceof ApiError) {
+    if (err.code === 'unknown_credential') {
+      // Tell the passkey provider so it can hide/remove the stale passkey.
+      signalUnknownCredential(err.details.rpId, err.details.credentialId);
+    }
+    if (err.code === 'unauthenticated') {
+      setAccount(null);
+      showView('signin');
+    }
+    setStatus(err.message, 'error');
+    return;
+  }
+  if (err instanceof DOMException) {
+    const message = describeWebAuthnError(err, ceremony);
+    if (message) setStatus(message, ceremony === 'get' && err.name === 'NotAllowedError' ? 'info' : 'error');
+    return;
+  }
+  console.error(err);
+  setStatus('Something went wrong. Please try again.', 'error');
+}
+
+// ---------------------------------------------------------------------------
+// Views
+// ---------------------------------------------------------------------------
+
+function showView(name) {
+  state.view = name;
+  views.forEach((v) => { v.hidden = v.dataset.view !== name; });
+  if (name === 'signin') startConditionalSignIn();
+  else abortConditionalSignIn();
+}
+
+function openDialog() {
+  if (!dialog.open) dialog.showModal();
+  setStatus('');
+  if (!isWebAuthnSupported()) showView('unsupported');
+  else showView(state.account ? 'account' : 'signin');
+}
+
+function updateNav() {
+  const toggle = document.querySelector('[data-auth-toggle]');
+  const accountLink = document.querySelector('[data-account-open]');
+  if (state.account) {
+    toggle.textContent = 'Logout';
+    accountLink.textContent = `Hi, ${state.account.user.displayName.split(/\s+/)[0]}`;
+    accountLink.setAttribute('aria-label', 'My Account');
+  } else {
+    toggle.textContent = 'Sign in';
+    accountLink.textContent = 'My Account';
+    accountLink.removeAttribute('aria-label');
+  }
+}
+
+function setAccount(data) {
+  state.account = data ? { user: data.user, credentials: data.credentials, rpId: data.rpId } : null;
+  updateNav();
+  if (state.account) renderAccount();
+}
+
+function renderAccount() {
+  const { user, credentials } = state.account;
+  profileDisplay.querySelector('[data-field="displayName"]').textContent = user.displayName;
+  profileDisplay.querySelector('[data-field="email"]').textContent = user.email;
+  profileDisplay.querySelector('[data-field="createdAt"]').textContent = dateFormat.format(user.createdAt);
+
+  passkeyList.replaceChildren(...credentials.map((cred) => renderPasskey(cred, credentials.length)));
+}
+
+function renderPasskey(cred, total) {
+  const item = passkeyTemplate.content.firstElementChild.cloneNode(true);
+  item.dataset.id = cred.id;
+  item.querySelector('[data-field="name"]').textContent = cred.name;
+  const sync = item.querySelector('[data-field="sync"]');
+  sync.textContent = cred.backedUp ? 'Synced' : cred.backupEligible ? 'Syncable' : 'This device only';
+  sync.title = cred.backedUp
+    ? 'Backed up and available on your other signed-in devices'
+    : 'Stored only on the device or security key that created it';
+  item.querySelector('[data-field="meta"]').textContent =
+    `Created ${dateFormat.format(cred.createdAt)} · Last used ${timeAgo(cred.lastUsedAt)}`;
+
+  const removeBtn = item.querySelector('[data-action="remove"]');
+  if (total <= 1) {
+    removeBtn.disabled = true;
+    removeBtn.title = 'Add another passkey before removing this one';
+  }
+  return item;
+}
+
+// ---------------------------------------------------------------------------
+// Sign in
+// ---------------------------------------------------------------------------
+
+function abortConditionalSignIn() {
+  state.conditional?.abort();
+  state.conditional = null;
+}
+
+/** Offers passkeys in the email field's autofill (conditional mediation). */
+async function startConditionalSignIn() {
+  abortConditionalSignIn();
+  if (!(await isConditionalMediationAvailable())) return;
+  if (state.view !== 'signin' || !dialog.open) return;
+  const controller = new AbortController();
+  state.conditional = controller;
+  try {
+    const options = await callApi('authentication/options', { purpose: 'signin', session: null });
+    if (controller.signal.aborted) return;
+    const credential = await getPasskey(options.publicKey, { mediation: 'conditional', signal: controller.signal });
+    if (!credential || controller.signal.aborted) return;
+    state.conditional = null;
+    await completeSignIn(credential);
+  } catch (err) {
+    if (controller.signal.aborted) return;
+    handleError(err, 'get');
+    if (state.view === 'signin') startConditionalSignIn();
+  }
+}
+
+async function signInWithPasskey() {
+  abortConditionalSignIn();
+  setStatus('');
+  try {
+    const options = await callApi('authentication/options', { purpose: 'signin', session: null });
+    const credential = await getPasskey(options.publicKey);
+    if (credential) await completeSignIn(credential);
+  } catch (err) {
+    handleError(err, 'get');
+  } finally {
+    if (state.view === 'signin' && !state.account) startConditionalSignIn();
+  }
+}
+
+async function completeSignIn(credential) {
+  const result = await callApi('authentication/verify', { credential, purpose: 'signin', session: null });
+  setAccount(result);
+  signalAcceptedCredentials(result.rpId, result.user.id, result.credentials.map((c) => c.id));
+  showView('account');
+  setStatus(`Welcome back, ${result.user.displayName}!`, 'success');
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+async function register(form) {
+  setStatus('');
+  const data = Object.fromEntries(new FormData(form));
+  if (!form.reportValidity()) return;
+  try {
+    const options = await callApi('registration/options', {
+      email: data.email,
+      displayName: data.displayName,
+      session: null,
+    });
+    const credential = await createPasskey(options.publicKey);
+    const result = await callApi('registration/verify', { credential });
+    form.reset();
+    setAccount(result);
+    showView('account');
+    setStatus('Your account is ready and secured with a passkey. Welcome to The Daily Grind!', 'success');
+  } catch (err) {
+    handleError(err, 'create');
+  }
+}
+
+async function addPasskey() {
+  setStatus('');
+  try {
+    const options = await callApi('registration/options', {});
+    const credential = await createPasskey(options.publicKey);
+    const result = await callApi('registration/verify', { credential });
+    setAccount(result);
+    signalAcceptedCredentials(result.rpId, result.user.id, result.credentials.map((c) => c.id));
+    const added = result.credentials.find((c) => c.id === result.credentialId);
+    setStatus(`Passkey “${added?.name ?? 'Passkey'}” added.`, 'success');
+  } catch (err) {
+    handleError(err, 'create');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Reauthentication
+// ---------------------------------------------------------------------------
+
+/** Asks the signed-in user to verify with one of their passkeys (UV required). */
+async function reauthenticate() {
+  setStatus('For your security, please confirm it’s you with your passkey.', 'info');
+  const options = await callApi('authentication/options', { purpose: 'reauth' });
+  const credential = await getPasskey(options.publicKey);
+  if (!credential) throw new DOMException('Reauthentication cancelled', 'NotAllowedError');
+  const result = await callApi('authentication/verify', { credential, purpose: 'reauth' });
+  setAccount(result);
+  setStatus('');
+}
+
+/** Runs a sensitive action, reauthenticating first if the server requires it. */
+async function withReauth(action) {
+  try {
+    return await action();
+  } catch (err) {
+    if (!(err instanceof ApiError) || err.code !== 'reauth_required') throw err;
+    await reauthenticate();
+    return action();
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Profile
+// ---------------------------------------------------------------------------
+
+function toggleProfileEdit(editing) {
+  profileForm.hidden = !editing;
+  profileDisplay.hidden = editing;
+  dialog.querySelector('[data-action="edit-profile"]').hidden = editing;
+  if (editing) {
+    profileForm.elements.displayName.value = state.account.user.displayName;
+    profileForm.elements.email.value = state.account.user.email;
+    profileForm.elements.displayName.focus();
+  }
+}
+
+async function saveProfile(form) {
+  setStatus('');
+  if (!form.reportValidity()) return;
+  const { displayName, email } = Object.fromEntries(new FormData(form));
+  try {
+    const result = await withReauth(() => callApi('account/update', { displayName, email }));
+    setAccount(result);
+    // Let passkey providers update the account name/email they display.
+    signalCurrentUserDetails(result.rpId, result.user.id, result.user.email, result.user.displayName);
+    toggleProfileEdit(false);
+    setStatus('Profile updated.', 'success');
+  } catch (err) {
+    handleError(err, 'get');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Passkey management
+// ---------------------------------------------------------------------------
+
+function resetPasskeyItem(item) {
+  item.querySelector('.acct-passkey-main').hidden = false;
+  item.querySelector('[data-form="rename"]').hidden = true;
+  item.querySelector('[data-confirm="remove"]').hidden = true;
+}
+
+async function renamePasskey(item, form) {
+  setStatus('');
+  if (!form.reportValidity()) return;
+  try {
+    const result = await callApi('credentials/rename', { credentialId: item.dataset.id, name: form.elements.name.value });
+    setAccount(result);
+    setStatus('Passkey renamed.', 'success');
+  } catch (err) {
+    handleError(err);
+  }
+}
+
+async function removePasskey(item) {
+  setStatus('');
+  try {
+    const result = await withReauth(() => callApi('credentials/delete', { credentialId: item.dataset.id }));
+    setAccount(result);
+    // Ask the provider to drop the passkey so it stops being offered at sign-in.
+    signalUnknownCredential(result.rpId, result.removedCredentialId);
+    setStatus('Passkey removed. You may also delete it from your device or password manager.', 'success');
+  } catch (err) {
+    handleError(err, 'get');
+  }
+}
+
+async function signOut() {
+  try {
+    await callApi('session/delete', {});
+  } catch {
+    // Signing out locally is enough if the server call fails.
+  }
+  session.clear();
+  setAccount(null);
+  toggleProfileEdit(false);
+  setStatus('You’ve been signed out.', 'info');
+  if (dialog.open) showView('signin');
+}
+
+// ---------------------------------------------------------------------------
+// Wiring
+// ---------------------------------------------------------------------------
+
+dialog.addEventListener('click', (event) => {
+  if (event.target === dialog) {
+    // Clicks on the ::backdrop target the dialog itself; ignore clicks on its padding.
+    const r = dialog.getBoundingClientRect();
+    const inside = event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom;
+    if (!inside) dialog.close();
+    return;
+  }
+  const button = event.target.closest('[data-action]');
+  if (!button) return;
+  const item = button.closest('.acct-passkey');
+
+  switch (button.dataset.action) {
+    case 'close': dialog.close(); break;
+    case 'show-register': setStatus(''); showView('register'); dialog.querySelector('#register-name').focus(); break;
+    case 'show-signin': setStatus(''); showView('signin'); break;
+    case 'add-passkey': busy(button, addPasskey); break;
+    case 'signout': busy(button, signOut); break;
+    case 'edit-profile': toggleProfileEdit(true); break;
+    case 'cancel-profile': toggleProfileEdit(false); break;
+    case 'rename': {
+      resetPasskeyItem(item);
+      const form = item.querySelector('[data-form="rename"]');
+      item.querySelector('.acct-passkey-main').hidden = true;
+      form.hidden = false;
+      form.elements.name.value = item.querySelector('[data-field="name"]').textContent;
+      form.elements.name.select();
+      break;
+    }
+    case 'remove':
+      resetPasskeyItem(item);
+      item.querySelector('[data-confirm="remove"]').hidden = false;
+      item.querySelector('[data-action="confirm-remove"]').focus();
+      break;
+    case 'confirm-remove': busy(button, () => removePasskey(item)); break;
+    case 'cancel': resetPasskeyItem(item); break;
+    default: break;
+  }
+});
+
+dialog.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const form = event.target;
+  const submit = form.querySelector('[type="submit"]');
+  switch (form.dataset.form) {
+    case 'signin': busy(submit, signInWithPasskey); break;
+    case 'register': busy(submit, () => register(form)); break;
+    case 'profile': busy(submit, () => saveProfile(form)); break;
+    case 'rename': busy(submit, () => renamePasskey(form.closest('.acct-passkey'), form)); break;
+    default: break;
+  }
+});
+
+dialog.addEventListener('close', () => {
+  abortConditionalSignIn();
+  if (location.hash === '#account') history.replaceState(null, '', location.pathname + location.search);
+});
+
+document.querySelector('[data-account-open]').addEventListener('click', (event) => {
+  event.preventDefault();
+  openDialog();
+});
+
+document.querySelector('[data-auth-toggle]').addEventListener('click', (event) => {
+  event.preventDefault();
+  if (state.account) signOut();
+  else openDialog();
+});
+
+window.addEventListener('hashchange', () => {
+  if (location.hash === '#account') openDialog();
+});
+
+async function init() {
+  if (session.get()) {
+    try {
+      setAccount(await callApi('account', {}));
+      signalAcceptedCredentials(state.account.rpId, state.account.user.id, state.account.credentials.map((c) => c.id));
+    } catch {
+      setAccount(null);
+    }
+  }
+  updateNav();
+  if (location.hash === '#account') openDialog();
+}
+
+init();
