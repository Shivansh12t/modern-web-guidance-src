--- /dev/null
+++ b/js/api.js
@@ -0,0 +1,31 @@
+// Client API layer. Today it calls the in-browser demo relying party; to use a
+// real backend, replace `callApi` with fetch(`/api/${route}`, …) and send the
+// session as an HttpOnly cookie instead of a body field.
+import { handleRequest } from './relying-party.js';
+
+const SESSION_KEY = 'dailyGrind.session';
+
+export class ApiError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.code = code;
+    this.details = details;
+  }
+}
+
+export const session = {
+  get: () => localStorage.getItem(SESSION_KEY),
+  set: (token) => localStorage.setItem(SESSION_KEY, token),
+  clear: () => localStorage.removeItem(SESSION_KEY),
+};
+
+export async function callApi(route, body = {}) {
+  try {
+    const result = await handleRequest(route, { session: session.get() ?? undefined, ...body });
+    if (result?.session) session.set(result.session);
+    return result;
+  } catch (err) {
+    if (err?.code === 'unauthenticated') session.clear();
+    throw new ApiError(err?.code || 'error', err?.message || 'Something went wrong.', err?.details);
+  }
+}
diff --git a/js/encoding.js b/js/encoding.js
new file mode 100644
index 0000000..c7b8876
--- /dev/null
+++ b/js/encoding.js
@@ -0,0 +1,164 @@
+// Shared binary helpers used by both the WebAuthn client and the demo relying party.
+
+export function bufferToBase64url(buffer) {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64urlToBuffer(value) {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+}
+
+export function randomBase64url(byteLength = 32) {
+  return bufferToBase64url(crypto.getRandomValues(new Uint8Array(byteLength)));
+}
+
+export function concatBytes(...parts) {
+  const arrays = parts.map((p) => (p instanceof Uint8Array ? p : new Uint8Array(p)));
+  const out = new Uint8Array(arrays.reduce((n, a) => n + a.length, 0));
+  let offset = 0;
+  for (const a of arrays) {
+    out.set(a, offset);
+    offset += a.length;
+  }
+  return out;
+}
+
+export function bytesEqual(a, b) {
+  const x = new Uint8Array(a);
+  const y = new Uint8Array(b);
+  if (x.length !== y.length) return false;
+  let diff = 0;
+  for (let i = 0; i < x.length; i++) diff |= x[i] ^ y[i];
+  return diff === 0;
+}
+
+export async function sha256(data) {
+  const input = typeof data === 'string' ? new TextEncoder().encode(data) : data;
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', input));
+}
+
+/**
+ * Minimal CBOR decoder (RFC 8949) covering what WebAuthn attestation objects
+ * and COSE keys use. Returns { value, offset } so trailing data can be detected.
+ */
+export function decodeCbor(input, start = 0) {
+  const bytes = input instanceof Uint8Array ? input : new Uint8Array(input);
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  let offset = start;
+
+  function readLength(info) {
+    if (info < 24) return info;
+    if (info === 24) return view.getUint8(offset++);
+    if (info === 25) { const v = view.getUint16(offset); offset += 2; return v; }
+    if (info === 26) { const v = view.getUint32(offset); offset += 4; return v; }
+    if (info === 27) {
+      const hi = view.getUint32(offset);
+      const lo = view.getUint32(offset + 4);
+      offset += 8;
+      return hi * 2 ** 32 + lo;
+    }
+    throw new Error('Unsupported CBOR length encoding');
+  }
+
+  function readItem() {
+    if (offset >= bytes.length) throw new Error('Unexpected end of CBOR data');
+    const initial = view.getUint8(offset++);
+    const major = initial >> 5;
+    const info = initial & 0x1f;
+    switch (major) {
+      case 0: return readLength(info);
+      case 1: return -1 - readLength(info);
+      case 2: {
+        const len = readLength(info);
+        const v = bytes.slice(offset, offset + len);
+        offset += len;
+        return v;
+      }
+      case 3: {
+        const len = readLength(info);
+        const v = new TextDecoder().decode(bytes.subarray(offset, offset + len));
+        offset += len;
+        return v;
+      }
+      case 4: {
+        const len = readLength(info);
+        const arr = [];
+        for (let i = 0; i < len; i++) arr.push(readItem());
+        return arr;
+      }
+      case 5: {
+        const len = readLength(info);
+        const map = new Map();
+        for (let i = 0; i < len; i++) {
+          const k = readItem();
+          map.set(k, readItem());
+        }
+        return map;
+      }
+      case 6: readLength(info); return readItem(); // ignore tags
+      case 7:
+        if (info === 20) return false;
+        if (info === 21) return true;
+        if (info === 22) return null;
+        if (info === 23) return undefined;
+        throw new Error('Unsupported CBOR simple/float value');
+      default:
+        throw new Error('Invalid CBOR major type');
+    }
+  }
+
+  const value = readItem();
+  return { value, offset };
+}
+
+export const AUTH_FLAGS = {
+  UP: 0x01, // user present
+  UV: 0x04, // user verified
+  BE: 0x08, // backup eligible (multi-device / syncable)
+  BS: 0x10, // backed up (currently synced)
+  AT: 0x40, // attested credential data included
+  ED: 0x80, // extension data included
+};
+
+function formatAaguid(bytes) {
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+/** Parses authenticator data (WebAuthn §6.1). */
+export function parseAuthenticatorData(buffer) {
+  const bytes = new Uint8Array(buffer);
+  if (bytes.length < 37) throw new Error('Authenticator data is too short');
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const flags = bytes[32];
+  const result = {
+    rpIdHash: bytes.slice(0, 32),
+    flags,
+    userPresent: !!(flags & AUTH_FLAGS.UP),
+    userVerified: !!(flags & AUTH_FLAGS.UV),
+    backupEligible: !!(flags & AUTH_FLAGS.BE),
+    backedUp: !!(flags & AUTH_FLAGS.BS),
+    signCount: view.getUint32(33),
+  };
+  if (flags & AUTH_FLAGS.AT) {
+    let offset = 37;
+    result.aaguid = formatAaguid(bytes.subarray(offset, offset + 16));
+    offset += 16;
+    const idLength = view.getUint16(offset);
+    offset += 2;
+    result.credentialId = bytes.slice(offset, offset + idLength);
+    offset += idLength;
+    const { value, offset: end } = decodeCbor(bytes, offset);
+    result.credentialPublicKey = value;
+    result.credentialPublicKeyBytes = bytes.slice(offset, end);
+  }
+  return result;
+}
