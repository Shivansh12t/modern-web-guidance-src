+  <script>
+    (() => {
+      const STORAGE_KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+      const toggle = document.querySelector(".theme-toggle");
+
+      const apply = (value) => {
+        meta.content = value === "light" || value === "dark" ? value : "light dark";
+      };
+
+      const renderedScheme = () => {
+        const content = meta.content;
+        if (content === "light" || content === "dark") return content;
+        return systemDark.matches ? "dark" : "light";
+      };
+
+      toggle.addEventListener("click", () => {
+        const target = renderedScheme() === "dark" ? "light" : "dark";
+        const system = systemDark.matches ? "dark" : "light";
+        // Toggling back to the system scheme reverts to "follow system" rather than pinning it.
+        const stored = target === system ? null : target;
+        try {
+          if (stored) localStorage.setItem(STORAGE_KEY, stored);
+          else localStorage.removeItem(STORAGE_KEY);
+        } catch (e) { }
+        apply(stored);
+      });
+
+      // Keep other open tabs in sync.
+      addEventListener("storage", (event) => {
+        if (event.key === STORAGE_KEY || event.key === null) apply(event.newValue);
+      });
+
+      toggle.hidden = false;
+    })();
+  </script>
+
