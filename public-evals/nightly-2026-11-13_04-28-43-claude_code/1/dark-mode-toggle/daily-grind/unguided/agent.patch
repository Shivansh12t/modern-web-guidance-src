+  <script>
+    (function () {
+      var root = document.documentElement;
+      var toggle = document.getElementById('theme-toggle');
+      var icon = toggle.querySelector('.theme-toggle-icon');
+      var text = toggle.querySelector('.theme-toggle-text');
+      var media = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function currentTheme() {
+        var manual = root.getAttribute('data-theme');
+        if (manual === 'light' || manual === 'dark') return manual;
+        return media.matches ? 'dark' : 'light';
+      }
+
+      function render() {
+        var isDark = currentTheme() === 'dark';
+        toggle.setAttribute('aria-pressed', String(isDark));
+        toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
+        icon.innerHTML = isDark ? '&#9728;' : '&#9790;';
+        text.textContent = isDark ? 'Light' : 'Dark';
+      }
+
+      toggle.addEventListener('click', function () {
+        var next = currentTheme() === 'dark' ? 'light' : 'dark';
+        root.setAttribute('data-theme', next);
+        try { localStorage.setItem('theme', next); } catch (e) { }
+        render();
+      });
+
+      // Keep the button label in sync if the system theme changes while no manual choice is set.
+      if (media.addEventListener) {
+        media.addEventListener('change', render);
+      } else if (media.addListener) {
+        media.addListener(render);
+      }
+
+      render();
+    })();
+  </script>
+
 </body>
 
