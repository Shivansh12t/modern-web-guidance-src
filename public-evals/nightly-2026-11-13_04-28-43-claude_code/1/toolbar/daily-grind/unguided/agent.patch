+  <script>
+    (function () {
+      var toolbar = document.getElementById('favorites-actions');
+      var list = document.getElementById('favorites-list');
+      var filters = document.getElementById('favorites-filters');
+      var status = document.getElementById('favorites-status');
+      var empty = document.getElementById('favorites-empty');
+      if (!toolbar || !list) return;
+
+      var buttons = Array.prototype.slice.call(toolbar.querySelectorAll('.tool-btn'));
+      var statusTimer;
+
+      function announce(msg) {
+        clearTimeout(statusTimer);
+        status.textContent = '';
+        // Small delay so repeated identical messages are still announced.
+        statusTimer = setTimeout(function () { status.textContent = msg; }, 50);
+      }
+
+      function setLabel(btn, label) {
+        btn.setAttribute('aria-label', label);
+        btn.setAttribute('data-tooltip', label);
+      }
+
+      // Roving tabindex: one tab stop for the whole toolbar, arrows move between buttons.
+      function focusButton(index) {
+        buttons.forEach(function (b, i) { b.tabIndex = i === index ? 0 : -1; });
+        buttons[index].focus();
+      }
+
+      toolbar.addEventListener('keydown', function (e) {
+        var current = buttons.indexOf(document.activeElement);
+        if (current === -1) return;
+        var next = null;
+        switch (e.key) {
+          case 'ArrowRight': case 'ArrowDown': next = (current + 1) % buttons.length; break;
+          case 'ArrowLeft': case 'ArrowUp': next = (current - 1 + buttons.length) % buttons.length; break;
+          case 'Home': next = 0; break;
+          case 'End': next = buttons.length - 1; break;
+        }
+        if (next !== null) {
+          e.preventDefault();
+          focusButton(next);
+        }
+      });
+
+      toolbar.addEventListener('focusin', function (e) {
+        var i = buttons.indexOf(e.target);
+        if (i !== -1) buttons.forEach(function (b, j) { b.tabIndex = j === i ? 0 : -1; });
+      });
+
+      function setView(view) {
+        list.classList.toggle('is-list', view === 'list');
+        toolbar.querySelectorAll('[data-action="view"]').forEach(function (b) {
+          b.setAttribute('aria-pressed', String(b.dataset.view === view));
+        });
+        announce(view === 'list' ? 'List view' : 'Grid view');
+      }
+
+      function toggleDetails(btn) {
+        var on = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(on));
+        list.classList.toggle('hide-details', !on);
+        announce(on ? 'Drink details shown' : 'Drink details hidden');
+      }
+
+      function toggleFilters(btn) {
+        var on = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(on));
+        filters.hidden = !on;
+        if (!on) applyFilter('all', true);
+        announce(on ? 'Filters shown' : 'Filters hidden, showing all drinks');
+      }
+
+      function applyFilter(filter, silent) {
+        var visible = 0;
+        list.querySelectorAll('.card').forEach(function (card) {
+          var tags = (card.dataset.tags || '').split(/\s+/);
+          var show = filter === 'all' || tags.indexOf(filter) !== -1;
+          card.hidden = !show;
+          if (show) visible++;
+        });
+        filters.querySelectorAll('.filter-chip').forEach(function (c) {
+          c.setAttribute('aria-pressed', String(c.dataset.filter === filter));
+        });
+        empty.hidden = visible !== 0;
+        if (!silent) announce(visible + (visible === 1 ? ' drink' : ' drinks') + ' shown');
+      }
+
+      function getDrinksText() {
+        var lines = [];
+        list.querySelectorAll('.card').forEach(function (card) {
+          if (card.hidden) return;
+          var name = card.querySelector('h3').textContent.trim();
+          var desc = card.querySelector('.card-details');
+          lines.push('- ' + name + (desc ? ': ' + desc.textContent.trim() : ''));
+        });
+        return 'Seasonal Favorites at The Daily Grind\n' + lines.join('\n');
+      }
+
+      function fallbackCopy(text) {
+        var ta = document.createElement('textarea');
+        ta.value = text;
+        ta.setAttribute('readonly', '');
+        ta.style.position = 'fixed';
+        ta.style.opacity = '0';
+        document.body.appendChild(ta);
+        ta.select();
+        var ok = false;
+        try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
+        document.body.removeChild(ta);
+        return ok ? Promise.resolve() : Promise.reject(new Error('copy failed'));
+      }
+
+      function copyDrinks(btn) {
+        var text = getDrinksText();
+        var p = (navigator.clipboard && window.isSecureContext)
+          ? navigator.clipboard.writeText(text).catch(function () { return fallbackCopy(text); })
+          : fallbackCopy(text);
+        var original = 'Copy featured drinks list';
+        p.then(function () {
+          btn.classList.add('is-success');
+          setLabel(btn, 'Copied!');
+          announce('Featured drinks list copied to clipboard');
+        }, function () {
+          setLabel(btn, 'Copy failed');
+          announce('Could not copy the featured drinks list');
+        }).then(function () {
+          setTimeout(function () {
+            btn.classList.remove('is-success');
+            setLabel(btn, original);
+          }, 2000);
+        });
+      }
+
+      toolbar.addEventListener('click', function (e) {
+        var btn = e.target.closest('.tool-btn');
+        if (!btn) return;
+        switch (btn.dataset.action) {
+          case 'view': setView(btn.dataset.view); break;
+          case 'details': toggleDetails(btn); break;
+          case 'filters': toggleFilters(btn); break;
+          case 'copy': copyDrinks(btn); break;
+        }
+      });
+
+      filters.addEventListener('click', function (e) {
+        var chip = e.target.closest('.filter-chip');
+        if (chip) applyFilter(chip.dataset.filter);
+      });
+    })();
+  </script>
+
 </body>
 
