+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const list = document.getElementById('favorites-list');
+      const status = document.getElementById('favorites-status');
+      const filters = document.getElementById('favorites-filters');
+      const empty = document.getElementById('favorites-empty');
+      const viewButtons = [...bar.querySelectorAll('button[data-view]')];
+      const detailsBtn = document.getElementById('toggle-details');
+      const filtersBtn = document.getElementById('toggle-filters');
+      const copyBtn = document.getElementById('copy-favorites');
+      const cards = [...list.querySelectorAll('.card')];
+
+      // Layout: mutually exclusive grid/list toggles, exactly one pressed
+      viewButtons.forEach((btn) => btn.addEventListener('click', () => {
+        viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+        list.dataset.view = btn.dataset.view;
+      }));
+
+      // Details on/off
+      detailsBtn.addEventListener('click', () => {
+        const on = detailsBtn.getAttribute('aria-pressed') !== 'true';
+        detailsBtn.setAttribute('aria-pressed', String(on));
+        list.dataset.details = on ? 'shown' : 'hidden';
+      });
+
+      // Filters on/off: filters only apply while the panel is shown
+      function applyFilters() {
+        const active = !filters.hidden;
+        const temps = new Set([...filters.querySelectorAll('input:checked')].map((i) => i.value));
+        let visible = 0;
+        cards.forEach((card) => {
+          card.hidden = active && !temps.has(card.dataset.temp);
+          if (!card.hidden) visible++;
+        });
+        empty.hidden = visible > 0;
+      }
+
+      filtersBtn.addEventListener('click', () => {
+        const on = filtersBtn.getAttribute('aria-pressed') !== 'true';
+        filtersBtn.setAttribute('aria-pressed', String(on));
+        filters.hidden = !on;
+        applyFilters();
+      });
+      filters.addEventListener('change', applyFilters);
+
+      // Copy the featured drinks list (currently visible drinks)
+      let timer;
+      let lastMessage = '';
+      function report(ok) {
+        clearTimeout(timer);
+        copyBtn.toggleAttribute('data-copied', ok);
+        let message = ok ? 'Featured drinks copied' : 'Copy failed';
+        if (message === lastMessage) message += '\u00A0'; // so repeats are announced
+        lastMessage = message;
+        status.textContent = message;
+        timer = setTimeout(() => {
+          copyBtn.removeAttribute('data-copied');
+          status.textContent = '';
+        }, 2000);
+      }
+
+      copyBtn.addEventListener('click', async () => {
+        const lines = cards
+          .filter((card) => !card.hidden)
+          .map((card) => `- ${card.querySelector('h3').innerText.trim()}: ${card.querySelector('p').textContent.trim()}`);
+        const text = `The Daily Grind – Seasonal Favorites\n${lines.join('\n')}`;
+        try {
+          await navigator.clipboard.writeText(text);
+          report(true);
+        } catch {
+          report(false);
+        }
+      });
+
+      // Roving tabindex fallback where native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        const items = [...bar.querySelectorAll('button')];
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener('keydown', (event) => {
+          const index = items.indexOf(document.activeElement);
+          if (index === -1) return;
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          let next;
+          if (event.key in steps) next = (index + steps[event.key] + items.length) % items.length;
+          else if (event.key === 'Home') next = 0;
+          else if (event.key === 'End') next = items.length - 1;
+          else return;
+          event.preventDefault();
+          items[next].focus();
+        });
+      }
+    })();
+  </script>
 </body>
 
