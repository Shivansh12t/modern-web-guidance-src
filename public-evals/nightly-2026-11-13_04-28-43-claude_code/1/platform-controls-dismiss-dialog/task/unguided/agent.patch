+  <script>
+    (function () {
+      // Native <dialog> + showModal() provides the modal semantics: focus is moved
+      // into the dialog, the rest of the page is inert, and Escape (or the Android
+      // back gesture in browsers with CloseWatcher support) fires "cancel" and closes it.
+      // We additionally push a history entry while a dialog is open so the back
+      // button / back gesture closes the dialog on every mobile browser instead
+      // of navigating away from the page.
+      var STATE_KEY = 'productDialog';
+      var active = null;
+      var opener = null;
+
+      function isOurState(state) {
+        return !!(state && state[STATE_KEY]);
+      }
+
+      function openDialog(dialog, trigger, fromHistory) {
+        if (!dialog || active) return;
+        opener = trigger || document.activeElement;
+        active = dialog;
+        dialog.showModal();
+        if (!fromHistory) {
+          var state = {};
+          state[STATE_KEY] = dialog.id;
+          history.pushState(state, '');
+        }
+      }
+
+      function handleClose(event) {
+        var dialog = event.currentTarget;
+        if (dialog !== active) return;
+        active = null;
+
+        // If the dialog was closed by Escape, the close button or the backdrop,
+        // drop the history entry we pushed so Back doesn't become a no-op.
+        if (isOurState(history.state) && history.state[STATE_KEY] === dialog.id) {
+          history.back();
+        }
+
+        if (opener && typeof opener.focus === 'function' && document.contains(opener)) {
+          opener.focus();
+        }
+        opener = null;
+      }
+
+      document.querySelectorAll('[data-dialog]').forEach(function (trigger) {
+        trigger.addEventListener('click', function () {
+          openDialog(document.getElementById(trigger.dataset.dialog), trigger);
+        });
+      });
+
+      document.querySelectorAll('dialog.product-dialog').forEach(function (dialog) {
+        dialog.addEventListener('close', handleClose);
+
+        dialog.querySelectorAll('[data-close]').forEach(function (btn) {
+          btn.addEventListener('click', function () {
+            dialog.close();
+          });
+        });
+
+        // Clicking the backdrop (outside the dialog box) dismisses it.
+        dialog.addEventListener('click', function (event) {
+          if (event.target !== dialog) return;
+          var rect = dialog.getBoundingClientRect();
+          var inside = event.clientX >= rect.left && event.clientX <= rect.right &&
+            event.clientY >= rect.top && event.clientY <= rect.bottom;
+          if (!inside) dialog.close();
+        });
+      });
+
+      // Back button / back gesture: close the open dialog instead of leaving the page.
+      // Forward into a dialog entry re-opens it.
+      window.addEventListener('popstate', function (event) {
+        if (active && active.open) {
+          active.close();
+        } else if (isOurState(event.state)) {
+          openDialog(document.getElementById(event.state[STATE_KEY]), null, true);
+        }
+      });
+
+      // Returning to this page (e.g. after following "Full menu page" from a dialog)
+      // restores the dialog the user came from, keeping history consistent.
+      window.addEventListener('pageshow', function () {
+        if (!active && isOurState(history.state)) {
+          openDialog(document.getElementById(history.state[STATE_KEY]), null, true);
+        }
+      });
+    })();
+  </script>
+
