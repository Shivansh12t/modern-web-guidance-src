+    /* Active nav indicator: one underline tethered to the current item via
+       anchor positioning, so it slides between items when the selection changes. */
+    nav li:has(> a[aria-current="page"]) {
+      anchor-name: --active-nav;
+    }
+
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav;
+      inset-block-start: calc(anchor(bottom) + 0.15lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      border-block-end: 2px solid var(--accent);
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: inset 0.3s ease;
+      }
+    }
+
+    nav a[aria-current="page"] {
+      color: var(--accent);
+    }
+
+    /* Without anchor positioning, fall back to a static (non-animated) underline. */
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        display: none;
+      }
+
+      nav a[aria-current="page"] {
+        border-block-end: 2px solid var(--accent);
+      }
+    }
