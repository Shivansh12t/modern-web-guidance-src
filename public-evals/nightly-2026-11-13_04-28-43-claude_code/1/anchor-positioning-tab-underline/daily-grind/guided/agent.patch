+  <script>
+    // Move the active indicator (aria-current) between primary nav items.
+    // Logout is excluded so it keeps its normal link behavior.
+    const navLinks = [...document.querySelectorAll('nav ul a:not(.logout-link)')];
+
+    function setActive(link) {
+      for (const a of navLinks) {
+        if (a === link) a.setAttribute('aria-current', 'page');
+        else a.removeAttribute('aria-current');
+      }
+    }
+
+    function linkForPath(path) {
+      return navLinks.find((a) => new URL(a.href).pathname === path);
+    }
+
+    // Reflect the current URL on load (defaults to Menu, set in the markup).
+    const initial = linkForPath(location.pathname);
+    if (initial) setActive(initial);
+
+    for (const link of navLinks) {
+      link.addEventListener('click', (event) => {
+        // Let modified clicks (new tab/window) behave normally.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        if (link.getAttribute('aria-current') === 'page') return;
+        setActive(link);
+        history.pushState(null, '', link.href);
+      });
+    }
+
+    window.addEventListener('popstate', () => {
+      const link = linkForPath(location.pathname);
+      if (link) setActive(link);
+    });
+  </script>
+
 </body>
 
