+  <script>
+    (function () {
+      var list = document.querySelector('nav ul');
+      var indicator = list.querySelector('.nav-indicator');
+      var items = Array.prototype.slice.call(list.querySelectorAll('a.nav-item'));
+      var STORAGE_KEY = 'navActiveIndex';
+      var NAV_DELAY = 350; // matches CSS transition duration
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      var active = null;
+
+      function moveTo(link, animate) {
+        if (!link) {
+          indicator.style.opacity = '0';
+          return;
+        }
+        if (!animate) indicator.classList.add('no-transition');
+        indicator.style.width = link.offsetWidth + 'px';
+        indicator.style.transform = 'translateX(' + link.offsetLeft + 'px)';
+        indicator.style.opacity = '1';
+        if (!animate) {
+          void indicator.offsetWidth; // flush styles before re-enabling transitions
+          indicator.classList.remove('no-transition');
+        }
+      }
+
+      function setActive(link, animate) {
+        items.forEach(function (a) {
+          a.classList.toggle('active', a === link);
+          if (a === link) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+        active = link;
+        moveTo(link, animate);
+      }
+
+      function itemForPath(path) {
+        return items.find(function (a) {
+          var href = a.getAttribute('href');
+          return path === href || path.indexOf(href + '/') === 0;
+        }) || null;
+      }
+
+      // Initial state: highlight the item matching the current URL. If the user
+      // just clicked from another item, start from that item's position and slide over.
+      var current = itemForPath(window.location.pathname);
+      var prevIndex = parseInt(sessionStorage.getItem(STORAGE_KEY), 10);
+      sessionStorage.removeItem(STORAGE_KEY);
+      var prev = items[prevIndex];
+
+      if (current && prev && prev !== current) {
+        setActive(prev, false);
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () { setActive(current, true); });
+        });
+      } else {
+        setActive(current, false);
+      }
+
+      items.forEach(function (link, index) {
+        link.addEventListener('click', function (e) {
+          // Let modified clicks (new tab/window) behave normally.
+          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          e.preventDefault();
+          setActive(link, true);
+          // Navigate after the indicator finishes sliding.
+          var href = link.href;
+          setTimeout(function () {
+            sessionStorage.setItem(STORAGE_KEY, String(index));
+            window.location.href = href;
+          }, reduceMotion ? 0 : NAV_DELAY);
+        });
+      });
+
+      // Keep indicator aligned on resize / font load.
+      window.addEventListener('resize', function () { moveTo(active, false); });
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(function () { moveTo(active, false); });
+      }
+    })();
+  </script>
+
