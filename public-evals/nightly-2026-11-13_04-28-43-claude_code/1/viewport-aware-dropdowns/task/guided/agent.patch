+    /* Options dropdown */
+    .options-trigger {
+      /* Explicit anchor name so the polyfill (no implicit-anchor support) can tether the panel. */
+      anchor-name: --options-trigger;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      background: transparent;
+      color: white;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      border-radius: 4px;
+      padding: 5px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger:hover,
+    .options-trigger:focus-visible,
+    .options-trigger[aria-expanded="true"] {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .options-trigger .caret {
+      font-size: 0.7em;
+      transition: rotate 0.2s;
+    }
+
+    .options-trigger[aria-expanded="true"] .caret {
+      rotate: 180deg;
+    }
+
+    /* The popover lives in the top layer, so no ancestor overflow or z-index can clip it. */
+    .action-panel {
+      position-anchor: --options-trigger;
+      /* Anchor below the trigger, aligned to its left edge.
+         anchor() insets (not position-area) so the polyfill also supports the fallbacks. */
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 0;
+      margin-block-start: 6px;
+      /* Flip vertically, horizontally, or both when the panel would overflow the viewport. */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    .action-panel:is(:popover-open, .\:popover-open) {
