+  <script type="module">
+    // Load polyfills only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    const trigger = document.getElementById("trigger-btn");
+    const panel = document.getElementById("action-panel");
+
+    // Keep the trigger's expanded state in sync however the panel opens or closes.
+    panel.addEventListener("toggle", (event) => {
+      trigger.setAttribute("aria-expanded", String(event.newState === "open"));
+    });
+
+    // Activating an action closes the panel and navigates.
+    panel.addEventListener("click", (event) => {
+      const item = event.target.closest(".action-item");
+      if (!item) return;
+      trigger.focus();
+      panel.hidePopover();
+      if (item.dataset.href) window.location.assign(item.dataset.href);
+    });
+  </script>
+
