+    /* Scroll container: the page scrolls inside .scroller (not the window) so
+       the initial offset can be set synchronously before first paint. */
+    html,
     body {
+      height: 100%;
+      overflow: hidden;
+    }
+
+    body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      overflow-x: hidden;
+      -webkit-overflow-scrolling: touch;
+      overscroll-behavior-y: contain;
+      /* Settle on either "search revealed" or "search tucked away" when the
+         user stops scrolling near the top. */
+      scroll-snap-type: y proximity;
+    }
+
+    /* Everything below the search bar is at least one viewport tall, so the
+       container can always scroll far enough to hide the search bar. */
+    .page {
+      min-height: 100%;
+      scroll-snap-align: start;
+    }
+
+    /* Search bar (hidden above the nav on load) */
+    .search-bar {
