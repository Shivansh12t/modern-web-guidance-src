+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const nameInput = document.getElementById('sub-name');
+      const emailInput = document.getElementById('sub-email');
+      const roast = document.getElementById('roast-level');
+      const roastOut = document.getElementById('roast-value');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const status = document.getElementById('form-status');
+      const roastLabels = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      let roastChosen = false;
+
+      function updateRoast() {
+        const label = roastLabels[roast.value - 1];
+        roastOut.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      function updateProgress() {
+        const steps = [
+          nameInput.value.trim() !== '',
+          emailInput.value.trim() !== '' && emailInput.validity.valid,
+          !!form.querySelector('input[name="frequency"]:checked'),
+          roastChosen
+        ];
+        const pct = Math.round((steps.filter(Boolean).length / steps.length) * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progressText.textContent = pct + '% complete';
+      }
+
+      roast.addEventListener('input', function () {
+        roastChosen = true;
+        updateRoast();
+        updateProgress();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        roastChosen = true; // default roast is an acceptable choice on submit
+        updateProgress();
+        if (!form.checkValidity()) {
+          status.textContent = 'Please add your name, a valid email, and a delivery frequency.';
+          const firstInvalid = form.querySelector(':invalid');
+          if (firstInvalid) firstInvalid.focus();
+          return;
+        }
+        status.textContent = 'Thanks, ' + nameInput.value.trim() + '! Your subscription is set up.';
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
 </body>
 
