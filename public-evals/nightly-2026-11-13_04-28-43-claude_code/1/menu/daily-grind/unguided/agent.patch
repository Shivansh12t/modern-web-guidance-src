+  <script>
+    /* =====================================================================
+       Accessible menu button component (WAI-ARIA APG "Menu Button" pattern)
+       Item definitions:
+         { type: 'action',   label, id?, href?, hint?, disabled? }
+         { type: 'checkbox', label, key, hint?, disabled? }          on/off
+         { type: 'radio',    label, key, options: [{label, value, hint?}] }  pick-one
+         { type: 'submenu',  label, hint?, items: [...] }            nested
+         { type: 'separator' }
+       ===================================================================== */
+    const uid = (() => { let n = 0; return p => `${p}-${++n}`; })();
+    const openMenus = new Set();
+
+    class MenuButton {
+      constructor(button, items, { label, state = {}, onChange = () => { }, onAction = () => { } } = {}) {
+        this.button = button;
+        this.wrapper = button.parentElement;
+        this.state = state;
+        this.onChange = onChange;
+        this.onAction = onAction;
+        this.itemMap = new WeakMap();
+        this.allItems = [];
+        this.timer = null;
+        this.typeBuf = '';
+        this.typeTimer = null;
+
+        button.id ||= uid('dm-btn');
+        button.setAttribute('aria-haspopup', 'menu');
+        button.setAttribute('aria-expanded', 'false');
+
+        this.root = this.buildMenu(items, null);
+        if (label) this.root.el.setAttribute('aria-label', label);
+        else this.root.el.setAttribute('aria-labelledby', button.id);
+        button.setAttribute('aria-controls', this.root.el.id);
+        button.after(this.root.el);
+        this.bind();
+      }
+
+      /* ---------- DOM construction ---------- */
+      buildMenu(defs, parentItem) {
+        const el = document.createElement('ul');
+        el.className = 'dm-menu';
+        el.id = uid('dm-menu');
+        el.setAttribute('role', 'menu');
+        el.hidden = true;
+        const menu = { el, items: [], parentItem, openChild: null };
+        defs.forEach(def => this.buildEntry(def, menu));
+        return menu;
+      }
+
+      buildEntry(def, menu) {
+        const li = document.createElement('li');
+        li.setAttribute('role', 'none');
+        menu.el.append(li);
+
+        if (def.type === 'separator') {
+          li.setAttribute('role', 'separator');
+          li.className = 'dm-sep';
+          return;
+        }
+
+        if (def.type === 'radio') {
+          const labelEl = document.createElement('div');
+          labelEl.className = 'dm-group-label';
+          labelEl.id = uid('dm-grp');
+          labelEl.setAttribute('aria-hidden', 'true');
+          labelEl.textContent = def.label;
