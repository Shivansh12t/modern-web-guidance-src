+            oli.setAttribute('role', 'none');
+            const el = this.makeItem('menuitemradio', opt);
+            const rec = { el, menu, type: 'radio', def, value: opt.value, groupItems };
+            groupItems.push(rec);
+            oli.append(el);
+            group.append(oli);
+            this.register(rec, opt.label);
+          });
+          li.append(labelEl, group);
+          return;
+        }
+
+        if (def.type === 'submenu') {
