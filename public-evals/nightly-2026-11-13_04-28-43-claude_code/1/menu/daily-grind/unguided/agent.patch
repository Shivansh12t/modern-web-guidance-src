+            else handled = false;
+        }
+        if (handled) {
+          e.preventDefault();
+          e.stopPropagation();
+        }
+      }
+
+      onHover(rec) {
+        if (document.activeElement !== rec.el) rec.el.focus({ preventScroll: true });
+        clearTimeout(this.timer);
+        const { menu } = rec;
+        if (rec.type === 'submenu' && !this.isDisabled(rec)) {
+          if (menu.openChild !== rec) this.timer = setTimeout(() => this.openSub(rec, false), 150);
+        } else if (menu.openChild) {
+          // small grace period so diagonal mouse movement toward a submenu doesn't close it
+          this.timer = setTimeout(() => menu.openChild && this.closeSub(menu.openChild), 250);
+        }
+      }
+
+      typeahead(ch, menu, i) {
+        clearTimeout(this.typeTimer);
+        this.typeBuf += ch.toLowerCase();
+        this.typeTimer = setTimeout(() => { this.typeBuf = ''; }, 500);
+        const items = menu.items;
+        const start = this.typeBuf.length === 1 ? i + 1 : i;
+        for (let k = 0; k < items.length; k++) {
+          const r = items[(start + k) % items.length];
+          if (r.label.startsWith(this.typeBuf)) { this.focusItem(r); return; }
+        }
+      }
+
+      activate(rec, e) {
+        if (this.isDisabled(rec)) { e.preventDefault(); return; }
+        const { def } = rec;
+        switch (rec.type) {
+          case 'submenu':
+            e.preventDefault();
+            clearTimeout(this.timer);
+            this.openSub(rec, true);
+            break;
+          case 'checkbox':
+            this.state[def.key] = !this.state[def.key];
+            this.syncItem(rec);
+            this.onChange(this.state, def.key, this);
+            break;
+          case 'radio':
+            if (this.state[def.key] === rec.value) break;
+            this.state[def.key] = rec.value;
+            rec.groupItems.forEach(r => this.syncItem(r));
+            this.onChange(this.state, def.key, this);
+            break;
+          default:
+            // Plain actions close the whole menu. Links navigate natively.
+            this.close(!def.href);
+            if (def.id) {
+              if (!def.href) e.preventDefault();
+              this.onAction(def.id, this);
+            }
+        }
+      }
+
+      /* ---------- Open / close ---------- */
+      isOpen() { return !this.root.el.hidden; }
+      isDisabled(rec) { return rec.el.getAttribute('aria-disabled') === 'true'; }
+
+      open(focus) {
+        openMenus.forEach(m => m !== this && m.close(false));
+        this.root.el.hidden = false;
+        this.button.setAttribute('aria-expanded', 'true');
+        this.wrapper.classList.add('dm-open');
+        openMenus.add(this);
+        this.positionRoot();
+        const items = this.root.items;
+        if (focus) this.focusItem(focus === 'last' ? items[items.length - 1] : items[0]);
+      }
+
+      close(returnFocus) {
+        if (!this.isOpen()) return;
+        clearTimeout(this.timer);
+        this.closeChildren(this.root);
+        this.root.el.hidden = true;
+        this.button.setAttribute('aria-expanded', 'false');
+        this.wrapper.classList.remove('dm-open');
+        openMenus.delete(this);
+        if (returnFocus) this.button.focus();
+      }
+
+      openSub(rec, focusFirst) {
+        const { menu } = rec;
+        if (menu.openChild && menu.openChild !== rec) this.closeSub(menu.openChild);
+        if (menu.openChild !== rec) {
+          rec.submenu.el.hidden = false;
+          rec.el.setAttribute('aria-expanded', 'true');
+          menu.openChild = rec;
+          this.positionSub(rec.submenu.el);
+        }
+        if (focusFirst) this.focusItem(rec.submenu.items[0]);
+      }
+
+      closeSub(rec) {
+        this.closeChildren(rec.submenu);
+        rec.submenu.el.hidden = true;
+        rec.el.setAttribute('aria-expanded', 'false');
+        if (rec.menu.openChild === rec) rec.menu.openChild = null;
+      }
+
+      closeChildren(menu) {
+        if (menu.openChild) this.closeSub(menu.openChild);
+      }
+
+      backToParent(menu) {
+        const parent = menu.parentItem;
+        this.closeSub(parent);
+        parent.el.focus();
+      }
+
+      focusItem(rec) {
+        if (!rec) return;
+        const { menu } = rec;
+        if (menu.openChild && menu.openChild !== rec) this.closeSub(menu.openChild);
+        rec.el.focus();
+      }
+
+      /* ---------- Positioning (keep menus inside the viewport) ---------- */
+      positionRoot() {
+        const m = this.root.el;
+        m.classList.remove('dm-align-end', 'dm-up');
+        const r = m.getBoundingClientRect();
+        if (r.right > innerWidth - 8) m.classList.add('dm-align-end');
+        if (r.bottom > innerHeight - 8) {
+          const b = this.button.getBoundingClientRect();
+          if (b.top > innerHeight - b.bottom) m.classList.add('dm-up');
+        }
+      }
+
+      positionSub(el) {
+        el.classList.remove('dm-flip-x');
+        el.style.top = '';
+        if (getComputedStyle(el).position === 'static') return;
+        const r = el.getBoundingClientRect();
+        if (r.right > innerWidth - 8) {
+          el.classList.add('dm-flip-x');
+          const f = el.getBoundingClientRect();
+          if (f.left < 8 && 8 - f.left > r.right - (innerWidth - 8)) el.classList.remove('dm-flip-x');
+        }
+        const r2 = el.getBoundingClientRect();
+        const overflow = r2.bottom - (innerHeight - 8);
+        if (overflow > 0) el.style.top = `${-6 - Math.min(overflow, Math.max(0, r2.top - 8))}px`;
+      }
+    }
+
+    document.addEventListener('pointerdown', e => {
+      openMenus.forEach(m => !m.wrapper.contains(e.target) && m.close(false));
+    });
+    window.addEventListener('resize', () => openMenus.forEach(m => m.close(false)));
+
+    /* =====================================================================
+       Site wiring
+       ===================================================================== */
+    const money = n => `$${n.toFixed(2)}`;
+
+    const toastEl = document.getElementById('toast');
+    let toastTimer;
+    function toast(msg) {
+      toastEl.textContent = msg;
+      toastEl.classList.add('show');
+      clearTimeout(toastTimer);
+      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3000);
+    }
+
+    const cart = { count: 0, total: 0 };
+    function addToCart(name, price, summary) {
+      cart.count += 1;
+      cart.total += price;
+      document.getElementById('cart-count').textContent = cart.count;
+      document.getElementById('cart-link').setAttribute('aria-label',
+        `Your order, ${cart.count} item${cart.count === 1 ? '' : 's'}, ${money(cart.total)}`);
+      toast(`Added ${name} (${summary}) — ${money(price)}. Order total ${money(cart.total)}`);
+    }
+
+    /* ---------- Navigation: drink categories (multi-level) ---------- */
+    new MenuButton(document.getElementById('nav-menu-btn'), [
+      { type: 'action', label: 'Full menu', href: '/menu', icon: '☰' },
+      { type: 'separator' },
+      {
+        type: 'submenu', label: 'Coffee', icon: '☕', items: [
+          {
+            type: 'submenu', label: 'Espresso drinks', items: [
+              { type: 'action', label: 'Latte', href: '/menu/espresso/latte' },
+              { type: 'action', label: 'Cappuccino', href: '/menu/espresso/cappuccino' },
+              { type: 'action', label: 'Flat White', href: '/menu/espresso/flat-white' },
+              { type: 'action', label: 'Americano', href: '/menu/espresso/americano' },
+              { type: 'action', label: 'Mocha', href: '/menu/espresso/mocha' },
+            ]
+          },
+          {
+            type: 'submenu', label: 'Brewed coffee', items: [
+              { type: 'action', label: 'House Drip', href: '/menu/brewed/drip' },
+              { type: 'action', label: 'Pour Over', href: '/menu/brewed/pour-over' },
+              { type: 'action', label: 'French Press', href: '/menu/brewed/french-press' },
+            ]
+          },
+          { type: 'action', label: 'Dark Roast Espresso', href: '/menu/espresso' },
+        ]
+      },
+      {
+        type: 'submenu', label: 'Cold drinks', icon: '🧊', items: [
+          { type: 'action', label: 'Cold Brew', href: '/menu/cold-brew' },
+          { type: 'action', label: 'Nitro Cold Brew', hint: 'Sold out', disabled: true },
+          { type: 'action', label: 'Iced Latte', href: '/menu/cold/iced-latte' },
+          {
+            type: 'submenu', label: 'Frozen blends', items: [
+              { type: 'action', label: 'Mocha Frappé', href: '/menu/cold/mocha-frappe' },
+              { type: 'action', label: 'Caramel Frappé', href: '/menu/cold/caramel-frappe' },
+            ]
+          },
+        ]
+      },
+      {
+        type: 'submenu', label: 'Tea', icon: '🍵', items: [
+          {
+            type: 'submenu', label: 'Black tea', items: [
+              { type: 'action', label: 'Earl Grey', href: '/menu/tea/earl-grey' },
+              { type: 'action', label: 'English Breakfast', href: '/menu/tea/english-breakfast' },
+            ]
+          },
+          {
+            type: 'submenu', label: 'Green tea', items: [
+              { type: 'action', label: 'Sencha', href: '/menu/tea/sencha' },
+              { type: 'action', label: 'Jasmine Pearl', href: '/menu/tea/jasmine' },
+              { type: 'action', label: 'Matcha Latte', href: '/menu/tea/matcha' },
+            ]
+          },
+          { type: 'action', label: 'Chai Latte', href: '/menu/tea/chai' },
+        ]
+      },
+      {
+        type: 'submenu', label: 'Seasonal', icon: '🍁', items: [
+          { type: 'action', label: 'Maple Oat Latte', href: '/menu/seasonal' },
+          { type: 'action', label: 'Pumpkin Spice Cortado', href: '/menu/seasonal/pumpkin-cortado' },
+          { type: 'action', label: 'Gingerbread Chai', hint: 'Coming Dec 1', disabled: true },
+        ]
+      },
+      { type: 'action', label: 'Bakery', href: '/menu/bakery', icon: '🥐' },
+      { type: 'separator' },
+      { type: 'action', label: 'Order online', href: '/order-online', icon: '🛍' },
+    ], { label: 'Drink menu' });
+
+    /* ---------- Navigation: account ---------- */
+    const PREFS_KEY = 'dailyGrindPrefs';
+    let prefs = { emailOffers: true, store: 'downtown' };
+    try { Object.assign(prefs, JSON.parse(localStorage.getItem(PREFS_KEY)) || {}); } catch { /* ignore */ }
+
+    new MenuButton(document.getElementById('nav-account-btn'), [
+      { type: 'action', label: 'Profile', href: '/account' },
+      { type: 'action', label: 'Order history', href: '/account/orders' },
+      { type: 'action', label: 'Rewards', hint: '320 pts', href: '/rewards' },
+      {
+        type: 'submenu', label: 'Preferences', items: [
+          { type: 'checkbox', key: 'emailOffers', label: 'Email me offers' },
+          {
+            type: 'submenu', label: 'Pickup store', items: [
+              {
+                type: 'radio', key: 'store', label: 'Pickup store', options: [
+                  { label: 'Downtown', value: 'downtown' },
+                  { label: 'Riverside', value: 'riverside' },
+                  { label: 'Uptown', value: 'uptown' },
+                ]
+              },
+            ]
+          },
+        ]
+      },
+      { type: 'separator' },
+      { type: 'action', label: 'Logout', href: '/logout' },
+    ], {
+      label: 'Account',
+      state: prefs,
+      onChange(state) {
+        try { localStorage.setItem(PREFS_KEY, JSON.stringify(state)); } catch { /* ignore */ }
+        toast('Preferences saved');
+      },
+    });
+
+    /* ---------- Seasonal favorite cards: order customization ---------- */
+    const SIZES = [
+      { value: 'small', label: 'Small (12 oz)', delta: -0.5 },
+      { value: 'medium', label: 'Medium (16 oz)', delta: 0 },
+      { value: 'large', label: 'Large (20 oz)', delta: 0.75 },
+    ];
+    const MILKS = [
+      { value: 'none', label: 'No milk' },
+      { value: 'whole', label: 'Whole milk' },
+      { value: 'two', label: '2% milk' },
+      { value: 'oat', label: 'Oat milk', plant: true },
+      { value: 'almond', label: 'Almond milk', plant: true },
+    ];
+    const SWEETNESS = [
+      { value: 'none', label: 'Unsweetened' },
+      { value: 'half', label: 'Half sweet' },
+      { value: 'regular', label: 'Regular' },
+      { value: 'extra', label: 'Extra sweet' },
+    ];
+    const EXTRAS = { shot: 0.9, foam: 1.25, whip: 0.5 };
+    const PLANT_MILK = 0.7;
+
+    const DRINKS = {
+      maple: {
+        name: 'Maple Oat Latte', base: 5.75, href: '/menu/seasonal',
+        defaults: { size: 'medium', milk: 'oat', sweet: 'regular', shot: false, iced: false, foam: false, whip: false },
+      },
+      espresso: {
+        name: 'Dark Roast Espresso', base: 3.5, href: '/menu/espresso', sizes: false,
+        defaults: { size: 'medium', milk: 'none', sweet: 'none', shot: false, iced: false, foam: false, whip: false },
+      },
+      coldbrew: {
+        name: 'Cold Brew', base: 4.75, href: '/menu/cold-brew', alwaysIced: true,
+        defaults: { size: 'medium', milk: 'none', sweet: 'none', shot: false, iced: true, foam: false, whip: false },
+      },
+    };
+
+    const label = (list, v) => list.find(o => o.value === v).label;
+
+    function priceOf(d, s) {
+      let p = d.base;
+      if (d.sizes !== false) p += SIZES.find(o => o.value === s.size).delta;
+      if (s.milk !== d.defaults.milk && MILKS.find(o => o.value === s.milk).plant) p += PLANT_MILK;
+      for (const [k, v] of Object.entries(EXTRAS)) if (s[k]) p += v;
+      return p;
+    }
+
+    function summaryOf(d, s) {
+      const parts = [];
+      parts.push(d.sizes === false ? 'Double shot' : label(SIZES, s.size).split(' ')[0]);
+      if (s.iced) parts.push('Iced');
+      parts.push(label(MILKS, s.milk));
+      if (s.sweet !== d.defaults.sweet) parts.push(label(SWEETNESS, s.sweet));
+      if (s.shot) parts.push('Extra shot');
+      if (s.foam) parts.push('Cold foam');
+      if (s.whip) parts.push('Whip');
+      return parts.join(' · ');
+    }
+
+    function drinkMenuItems(d) {
+      const customize = [];
+      if (d.sizes !== false) {
+        customize.push({
+          type: 'submenu', label: 'Size', items: [{
+            type: 'radio', key: 'size', label: 'Cup size',
+            options: SIZES.map(o => ({ ...o, hint: o.delta ? `${o.delta > 0 ? '+' : '−'}${money(Math.abs(o.delta))}` : '' })),
+          }]
+        });
+      }
+      customize.push(
+        {
+          type: 'submenu', label: 'Milk', items: [{
+            type: 'radio', key: 'milk', label: 'Milk',
+            options: MILKS.map(o => ({ ...o, hint: o.plant && o.value !== d.defaults.milk ? `+${money(PLANT_MILK)}` : '' })),
+          }]
+        },
+        {
+          type: 'submenu', label: 'Sweetness', items: [{
+            type: 'radio', key: 'sweet', label: 'Sweetness', options: SWEETNESS,
+          }]
+        },
+        { type: 'separator' },
+        { type: 'checkbox', key: 'iced', label: d.alwaysIced ? 'Served iced' : 'Make it iced', disabled: d.alwaysIced },
+        { type: 'checkbox', key: 'shot', label: 'Extra espresso shot', hint: `+${money(EXTRAS.shot)}` },
+        { type: 'checkbox', key: 'foam', label: 'Sweet cream cold foam', hint: `+${money(EXTRAS.foam)}` },
+        { type: 'checkbox', key: 'whip', label: 'Whipped cream', hint: `+${money(EXTRAS.whip)}` },
+      );
+      return [
+        { type: 'action', id: 'add', label: 'Add to order', icon: '＋' },
+        { type: 'submenu', label: 'Customize', icon: '⚙', items: customize },
+        { type: 'separator' },
+        { type: 'checkbox', key: 'favorite', label: 'Save as favorite' },
+        { type: 'action', id: 'reset', label: 'Reset customizations', icon: '↺' },
+        { type: 'action', label: 'View details', href: d.href, icon: 'ⓘ' },
+      ];
+    }
+
+    document.querySelectorAll('.card[data-drink]').forEach(card => {
+      const d = DRINKS[card.dataset.drink];
+      const state = { ...d.defaults, favorite: false };
+      const priceEl = card.querySelector('[data-price]');
+      const summaryEl = card.querySelector('[data-summary]');
+      const title = card.querySelector('h3');
+      const button = card.querySelector('.dm-trigger');
+      button.id = uid('card-btn');
+      button.setAttribute('aria-labelledby', `${button.id} ${title.id}`);
+
+      const render = () => {
+        priceEl.textContent = money(priceOf(d, state));
+        summaryEl.textContent = summaryOf(d, state);
+        let badge = title.querySelector('.fav-badge');
+        if (state.favorite && !badge) {
+          badge = document.createElement('span');
+          badge.className = 'fav-badge';
+          badge.textContent = '★ Favorite';
+          title.append(badge);
+        } else if (!state.favorite && badge) {
+          badge.remove();
+        }
+      };
+
+      new MenuButton(button, drinkMenuItems(d), {
+        label: `${d.name} options`,
+        state,
+        onChange(s, key) {
+          render();
+          if (key === 'favorite') toast(s.favorite ? `${d.name} saved to favorites` : `${d.name} removed from favorites`);
+        },
+        onAction(id, menu) {
+          if (id === 'add') {
+            addToCart(d.name, priceOf(d, state), summaryOf(d, state));
+          } else if (id === 'reset') {
+            Object.assign(state, d.defaults);
+            menu.sync();
+            render();
+            toast(`${d.name} reset to default`);
+          }
+        },
+      });
+      render();
+    });
+  </script>
+
