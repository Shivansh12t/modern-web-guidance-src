+    const rootMenu = menu => { while (isSubmenu(menu)) menu = menu.parentElement.parentElement; return menu; };
+    const rootMenus = menus.filter(m => !isSubmenu(m));
+    const isOpen = menu => {
+      try { return menu.matches(':popover-open'); } catch { return menu.classList.contains(':popover-open'); }
+    };
+    const itemsOf = group => [...group.querySelectorAll('a[href], button')]
+      .filter(item => item.closest('[focusgroup]') === group)
+      .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+    const firstItem = menu => itemsOf(groupOf(menu))[0];
+
+    const enterOnOpen = new WeakSet();
+    let pointerTrigger = null;
+    let activationKey = null;
+    let pointerFocusing = false;
+    let previewTimer;
+    let windowBlurred = false;
+
+    function closeAndRestore(menu, { fromPointer = false } = {}) {
+      triggerFor(menu).focus(fromPointer ? { focusVisible: false } : undefined);
+      if (isOpen(menu)) menu.hidePopover();
+    }
+
+    function openSubmenu(trigger) {
+      const sub = menuFor(trigger);
+      if (!isOpen(sub)) sub.showPopover({ source: trigger });
+    }
+
+    function pointerFocus(item) {
+      pointerFocusing = true;
+      item.focus({ focusVisible: false, preventScroll: true });
+      pointerFocusing = false;
+    }
+
+    // Script positioning for browsers without CSS anchor positioning.
+    function placeMenu(menu, trigger) {
+      const t = trigger.getBoundingClientRect();
+      const m = menu.getBoundingClientRect();
+      let left, top;
+      if (isSubmenu(menu)) {
+        left = t.right; top = t.top;
+        if (left + m.width > innerWidth) left = t.left - m.width;
+      } else {
+        left = t.left; top = t.bottom + 6;
+        if (top + m.height > innerHeight) top = t.top - m.height - 6;
+      }
+      menu.style.left = `${Math.max(0, Math.min(left, innerWidth - m.width))}px`;
+      menu.style.top = `${Math.max(0, Math.min(top, innerHeight - m.height))}px`;
+    }
+
+    /* ---------- Setup per menu ---------- */
+    if (!supportsFocusgroup) {
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.setAttribute('role', 'menu');
+        group.querySelectorAll('a[href]:not([role]), button:not([role])').forEach(item => {
+          if (item.closest('[focusgroup]') === group) item.setAttribute('role', 'menuitem');
+        });
+      });
+    }
+
+    triggers.forEach((trigger, i) => {
+      const menu = menus[i];
+      if (supportsAnchor && !supportsSource) {
+        trigger.style.anchorName = `--menu-anchor-${i}`;
+        menu.style.positionAnchor = `--menu-anchor-${i}`;
+      }
+
+      menu.addEventListener('toggle', event => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', String(open));
+        if (open) {
+          if (!supportsAnchor) placeMenu(menu, trigger);
+          if (enterOnOpen.has(menu)) firstItem(menu)?.focus();
+          else if (pointerTrigger === trigger && !isSubmenu(menu)) trigger.focus({ focusVisible: false });
+        }
+        enterOnOpen.delete(menu);
+        if (pointerTrigger === trigger) pointerTrigger = null;
+      });
+
+      // Pointer press toggles without moving focus.
+      trigger.addEventListener('pointerdown', event => {
+        if (event.button !== 0) return;
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      if (isSubmenuTrigger(trigger)) {
+        trigger.addEventListener('pointerleave', event => startBridge(menu, event));
+      }
+    });
+
+    /* ---------- Safe triangle ---------- */
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      const left = event.clientX < rect.left;
+      if (!left && event.clientX <= rect.right) return; // --below: no side edge
+      submenu.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
+      submenu.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
+      submenu.dataset.bridge = '';
+      let timer;
+      let lastX = event.clientX;
+      const stop = () => {
+        clearTimeout(timer);
+        submenu.removeEventListener('pointermove', extend);
+        submenu.removeAttribute('data-bridge');
+      };
+      const extend = ({ target, clientX }) => {
+        if (target !== submenu || (left ? clientX < lastX : clientX > lastX)) return stop();
+        lastX = clientX;
+        clearTimeout(timer);
+        timer = setTimeout(stop, 300);
+      };
+      timer = setTimeout(stop, 300);
+      submenu.addEventListener('pointermove', extend);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    /* ---------- Focus ---------- */
+    addEventListener('blur', () => { windowBlurred = true; });
+    addEventListener('focus', () => setTimeout(() => { windowBlurred = false; }));
+
+    document.addEventListener('focusin', event => {
+      const target = event.target;
+
+      // Focus outside a menu system closes it.
+      for (const menu of rootMenus) {
+        if (isOpen(menu) && !menu.contains(target) && triggerFor(menu) !== target) menu.hidePopover();
+      }
+
+      // Moving to another item closes sibling submenus.
+      const group = target.closest?.('[focusgroup~="menu"]');
+      if (group) {
+        for (const sub of group.querySelectorAll(':scope > [popover]')) {
+          if (isOpen(sub) && !sub.contains(target) && triggerFor(sub) !== target) sub.hidePopover();
+        }
+      }
+
+      // Submenu preview on focus.
+      clearTimeout(previewTimer);
+      if (isSubmenuTrigger(target) && !windowBlurred && !menuFor(target).contains(event.relatedTarget)) {
+        if (pointerFocusing) {
+          previewTimer = setTimeout(() => { if (document.activeElement === target) openSubmenu(target); }, 150);
+        } else {
+          openSubmenu(target);
+        }
+      }
+    });
+
+    /* ---------- Hover follows focus ---------- */
+    document.addEventListener('pointermove', event => {
+      if (event.pointerType === 'touch') return;
+      const item = event.target.closest?.('[focusgroup~="menu"] :is(a[href], button)');
+      if (!item || item === document.activeElement) return;
+      if (!itemsOf(item.closest('[focusgroup~="menu"]')).includes(item)) return;
+      if (!item.contains(document.elementFromPoint(event.clientX, event.clientY))) return;
+      pointerFocus(item);
+    });
+
+    document.addEventListener('pointerdown', () => { activationKey = null; }, true);
+
+    /* ---------- Keyboard ---------- */
+    document.addEventListener('keydown', event => {
+      const target = event.target;
+      if (event.key === ' ' || event.key === 'Enter') activationKey = event.key;
+
+      // Top-level trigger: ArrowDown opens (if needed) and enters the menu.
+      if (isTrigger(target) && !isSubmenuTrigger(target)) {
+        if (event.key !== 'ArrowDown') return;
+        event.preventDefault();
+        const menu = menuFor(target);
+        if (isOpen(menu)) firstItem(menu)?.focus();
+        else { enterOnOpen.add(menu); target.click(); }
+        return;
+      }
+
+      const group = target.closest?.('[focusgroup~="menu"]');
+      if (!group) return;
+      const menu = group.parentElement;
+      const items = itemsOf(group);
+      const index = items.indexOf(target);
+      if (index < 0) return;
+
+      switch (event.key) {
+        case 'ArrowDown':
+        case 'ArrowUp':
+          if (supportsFocusgroup) return;
+          items[(index + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length].focus();
+          break;
+        case 'Home':
+          items[0].focus();
+          break;
+        case 'End':
+          items.at(-1).focus();
+          break;
+        case 'ArrowRight': {
+          if (!isSubmenuTrigger(target)) return;
+          const sub = menuFor(target);
+          if (isOpen(sub)) firstItem(sub)?.focus();
+          else { enterOnOpen.add(sub); sub.showPopover({ source: target }); }
+          break;
+        }
+        case 'ArrowLeft':
+          if (!isSubmenu(menu)) return;
+          closeAndRestore(menu);
+          break;
+        case 'Escape':
+          closeAndRestore(menu);
+          break;
+        case 'Tab':
+          // Leave the menu system: Tab continues from the root trigger.
+          closeAndRestore(rootMenu(menu));
+          return;
+        case ' ':
+          if (target.tagName !== 'A') return;
+          target.click();
+          break;
+        default:
+          return;
+      }
+      event.preventDefault();
+      event.stopPropagation();
+    });
+
+    /* ---------- Activation ---------- */
+    document.addEventListener('click', event => {
+      const target = event.target.closest('a[href], button');
+      if (!target) return;
+      const key = activationKey;
+      activationKey = null;
+      const fromPointer = event.detail > 0;
+
+      if (isTrigger(target)) {
+        const menu = menuFor(target);
+        if (!supportsInvokers) {
+          event.preventDefault();
+          if (isOpen(menu)) closeAndRestore(menu, { fromPointer });
+          else {
+            if (!fromPointer) enterOnOpen.add(menu);
+            menu.showPopover({ source: target });
+          }
+        } else if (!fromPointer && !isOpen(menu)) {
+          enterOnOpen.add(menu);
+        }
+        return;
+      }
+
+      const group = target.closest('[focusgroup~="menu"]');
+      if (!group || !itemsOf(group).includes(target)) return;
+      const root = rootMenu(group.parentElement);
+      const card = target.closest('.card');
+      const role = target.getAttribute('role');
+      const closeLater = () => setTimeout(() => { if (isOpen(root)) closeAndRestore(root, { fromPointer }); }, 300);
+
+      if (role === 'menuitemcheckbox') {
+        target.setAttribute('aria-checked', String(target.getAttribute('aria-checked') !== 'true'));
+        if (card) updateSummary(card);
+        if (key !== ' ') closeLater(); // Space toggles and stays open
+        return;
+      }
+
+      if (role === 'menuitemradio') {
+        target.closest('[role="group"]').querySelectorAll('[role="menuitemradio"]')
+          .forEach(radio => radio.setAttribute('aria-checked', String(radio === target)));
+        if (card) updateSummary(card);
+        closeLater();
+        return;
+      }
+
+      if (target.dataset.action && card) runAction(target.dataset.action, card);
+      closeAndRestore(root, { fromPointer });
+    });
+
+    /* ---------- Order state (lives in aria-checked) ---------- */
+    function applyDefaults(card) {
+      card.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+        const wanted = card.dataset[radio.dataset.option];
+        const checked = wanted ? radio.dataset.value === wanted : radio.hasAttribute('data-default');
+        radio.setAttribute('aria-checked', String(checked));
+      });
+      card.querySelectorAll('[role="menuitemcheckbox"]').forEach(box => {
+        box.setAttribute('aria-checked', String(card.dataset[box.dataset.option] === 'true'));
+      });
+      updateSummary(card);
+    }
+
+    function describe(card) {
+      const pick = option => card.querySelector(`[data-option="${option}"][aria-checked="true"]`)?.dataset.value;
+      const parts = [pick('size')];
+      const milk = pick('milk');
+      if (milk && milk !== 'None') parts.push(`${milk} milk`);
+      const syrup = pick('syrup');
+      if (syrup && syrup !== 'None') parts.push(`${syrup} syrup`);
+      card.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]')
+        .forEach(box => parts.push(box.dataset.label));
+      return parts.filter(Boolean).join(' · ');
+    }
+
+    function updateSummary(card) {
+      card.querySelector('[data-selection]').textContent = describe(card);
+    }
+
+    const announcer = document.getElementById('announcer');
+    const bagCount = document.getElementById('bag-count');
+    let announceTimer;
+    function announce(message) {
+      announcer.textContent = message;
+      clearTimeout(announceTimer);
+      announceTimer = setTimeout(() => { announcer.textContent = ''; }, 4000);
+    }
+
+    function runAction(action, card) {
+      const title = card.querySelector('h3').textContent;
+      if (action === 'add') {
+        bagCount.textContent = String(Number(bagCount.textContent) + 1);
+        announce(`Added ${title} (${describe(card)}) to your order.`);
+      } else if (action === 'reset') {
+        applyDefaults(card);
+        announce(`${title} reset to default options.`);
+      }
+    }
+  </script>
+
 </body>
 
