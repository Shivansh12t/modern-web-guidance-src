+  <script>
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    // Chromium animates block-size to/from `auto` natively via interpolate-size.
+    // Elsewhere, measure both ends and animate between pixel values instead.
+    const nativeSizeAnimation = CSS.supports('interpolate-size', 'allow-keywords');
+
+    function changeSize(el, applyChange) {
+      const from = el.getBoundingClientRect().height;
+      applyChange();
+      if (nativeSizeAnimation || reducedMotion.matches) return;
+      el.getAnimations().forEach((a) => { if (!(a instanceof CSSTransition)) a.cancel(); });
+      const to = el.getBoundingClientRect().height;
+      el.animate({ blockSize: [`${from}px`, `${to}px`] }, { duration: 400, easing: 'ease-in-out' });
+    }
+
+    // FAQ accordion
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    faqTrigger.addEventListener('click', () => {
+      const open = faqTrigger.getAttribute('aria-expanded') !== 'true';
+      faqTrigger.setAttribute('aria-expanded', String(open));
+      changeSize(faqContent, () => faqContent.classList.toggle('is-open', open));
+    });
+
+    // Dismissible promo alert
+    const promoAlert = document.getElementById('promo-alert');
+    document.getElementById('alert-dismiss').addEventListener('click', () => {
+      changeSize(promoAlert, () => promoAlert.classList.add('is-dismissed'));
+      // Remove from the accessibility tree once the collapse finishes
+      Promise.allSettled(promoAlert.getAnimations().map((a) => a.finished)).then(() => {
+        if (promoAlert.classList.contains('is-dismissed')) promoAlert.hidden = true;
+      });
+    });
+  </script>
+
 </body>
 
