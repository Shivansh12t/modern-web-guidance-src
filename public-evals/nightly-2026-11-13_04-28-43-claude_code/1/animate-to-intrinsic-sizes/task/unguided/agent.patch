+  <script>
+    (function () {
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Animate an element's height between two pixel values. When the
+      // transition finishes, `done` runs so the caller can release the
+      // height (to `auto`) or remove the element.
+      function animateHeight(el, from, to, done) {
+        if (el._finishAnim) el._finishAnim(false);
+
+        var finished = false;
+        function finish(runDone) {
+          if (finished) return;
+          finished = true;
+          el.removeEventListener('transitionend', onEnd);
+          clearTimeout(timer);
+          el._finishAnim = null;
+          if (runDone !== false && done) done();
+        }
+        function onEnd(e) {
+          if (e.target === el && e.propertyName === 'height') finish();
+        }
+
+        el._finishAnim = finish;
+        el.style.height = from + 'px';
+
+        if (reduceMotion.matches || from === to) {
+          el.style.height = to + 'px';
+          finish();
+          return;
+        }
+
+        el.offsetHeight; // force reflow so the start height is committed
+        el.style.height = to + 'px';
+        el.addEventListener('transitionend', onEnd);
+        var timer = setTimeout(finish, 600); // safety net if transitionend never fires
+      }
+
+      // FAQ accordion
+      var trigger = document.getElementById('faq-trigger');
+      var content = document.getElementById('faq-content');
+
+      if (trigger && content) {
+        content.setAttribute('hidden', '');
+
+        trigger.addEventListener('click', function () {
+          var opening = trigger.getAttribute('aria-expanded') !== 'true';
+          var start = content.getBoundingClientRect().height;
+          trigger.setAttribute('aria-expanded', String(opening));
+
+          if (opening) {
+            content.removeAttribute('hidden');
+            content.classList.add('is-open');
+            content.style.height = 'auto';
+            var target = content.scrollHeight;
+            animateHeight(content, start, target, function () {
+              content.style.height = 'auto'; // follow content on resize
+            });
+          } else {
+            content.classList.remove('is-open');
+            animateHeight(content, start, 0, function () {
+              content.style.height = '';
+              content.setAttribute('hidden', '');
+            });
+          }
+        });
+      }
+
+      // Dismissible promo alert
+      var alertEl = document.getElementById('promo-alert');
+      var dismiss = document.getElementById('alert-dismiss');
+
+      if (alertEl && dismiss) {
+        dismiss.addEventListener('click', function () {
+          var start = alertEl.getBoundingClientRect().height;
+          alertEl.classList.add('is-dismissing');
+          alertEl.setAttribute('aria-hidden', 'true');
+          dismiss.disabled = true;
+          animateHeight(alertEl, start, 0, function () {
+            alertEl.hidden = true;
+          });
+          // Move focus somewhere sensible since the button is going away.
+          var nextFocus = document.querySelector('nav a');
+          if (nextFocus) nextFocus.focus({ preventScroll: true });
+        });
+      }
+    })();
+  </script>
+
