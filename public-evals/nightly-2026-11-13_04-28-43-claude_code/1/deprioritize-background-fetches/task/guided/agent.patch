diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,35 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Load</title>
+</head>
+<body>
+  <button type="button" id="load">Load data</button>
+  <pre id="out" aria-live="polite"></pre>
+  <script>
+    const out = document.getElementById('out');
+
+    document.getElementById('load').addEventListener('click', () => {
+      // Mission-critical: high priority.
+      fetch('/api/data', { priority: 'high' })
+        .then((r) => {
+          if (!r.ok) throw new Error(`HTTP ${r.status}`);
+          return r.text();
+        })
+        .then((text) => { out.textContent = text; })
+        .catch((err) => { out.textContent = `Error: ${err.message}`; });
+
+      // Analytics: low priority so it doesn't compete with /api/data.
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+        keepalive: true,
+      }).catch(() => {});
+    });
+  </script>
+</body>
+</html>
