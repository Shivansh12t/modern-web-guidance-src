+
+  <script type="module">
+    /*
+     * In-place sign-in for returning customers.
+     *
+     * 1. Clicking an account-gated link ("Rewards", "My Account", "Order Now", "Sign in") first tries
+     *    Immediate UI mode: the browser shows its account chooser right away if the device has a saved
+     *    passkey or password for this site. The user taps once and continues where they were going.
+     * 2. If there's no saved credential (or the browser doesn't support Immediate UI), an inline
+     *    sign-in dialog opens on top of the current page. It offers passkey autofill (Conditional UI),
+     *    password autofill, and an explicit "Sign in with a passkey" button.
+     * 3. After signing in, the user either goes on to the page they clicked or, for "Sign in", stays put
+     *    while the header updates in place.
+     *
+     * Expected server endpoints:
+     *   POST /api/login/options   -> WebAuthn request options JSON (challenge, rpId, userVerification)
+     *   POST /api/login/verify    -> verifies a passkey assertion (404 if the credential is unknown)
+     *   POST /api/login/password  -> verifies { username, password }
+     *   GET  /api/session         -> { signedIn: boolean, name?: string } (optional)
+     */
+
+    // Load the WebAuthn JSON/capabilities polyfill only where it's missing.
+    if (
+      window.PublicKeyCredential &&
+      (!PublicKeyCredential.getClientCapabilities || !PublicKeyCredential.parseRequestOptionsFromJSON)
+    ) {
+      try {
+        await import('webauthn-polyfills');
+      } catch (err) {
+        console.warn('WebAuthn polyfill failed to load:', err);
+      }
+    }
+
+    // Invoker Commands polyfill for the dialog close button, only where needed.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
+    }
+
+    const statusEl = document.getElementById('auth-status');
+    const dialog = document.getElementById('signin-dialog');
+    const form = document.getElementById('signin-form');
+    const emailInput = document.getElementById('signin-email');
+    const passwordInput = document.getElementById('signin-password');
+    const showPassword = document.getElementById('signin-show-password');
+    const passkeyBtn = document.getElementById('signin-passkey-btn');
+    const errorEl = document.getElementById('signin-error');
+    const returnToInput = document.getElementById('signin-return-to');
+    const signinLink = document.getElementById('signin-link');
+    const signinItem = signinLink.closest('li');
+    const logoutItem = document.getElementById('logout-item');
+    const logoutLink = document.getElementById('logout-link');
+
+    // What the user was trying to do when sign-in was needed.
+    let pendingIntent = null; // { href, signinOnly, trigger }
+    let isAuthenticating = false;
+    let conditionalAbort = null;
+
+    const isSignedIn = () => document.body.dataset.signedIn === 'true';
+
+    function announce(message) {
+      statusEl.textContent = '';
+      // Defer so repeat messages are still announced.
+      requestAnimationFrame(() => { statusEl.textContent = message; });
+    }
+
+    function setSignedIn(user) {
+      document.body.dataset.signedIn = 'true';
+      signinItem.hidden = true;
+      logoutItem.hidden = false;
+      const name = user?.name || user?.displayName;
+      announce(name ? `Signed in as ${name}.` : 'You are signed in.');
+    }
+
+    // ---------- Capability checks ----------
+
+    async function getCapabilities() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return {};
+      try {
+        return (await PublicKeyCredential.getClientCapabilities()) || {};
+      } catch {
+        return {};
+      }
+    }
+
+    // ---------- Server helpers ----------
+
+    async function fetchRequestOptions() {
+      const res = await fetch('/api/login/options', { method: 'POST', credentials: 'same-origin' });
+      if (!res.ok) throw new Error('Failed to fetch authentication options');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    async function verifyPasskey(cred, publicKey) {
+      const encoded = cred.toJSON();
+      const res = await postJSON('/api/login/verify', encoded);
+      if (res.status === 404) {
+        // The passkey was deleted server-side; ask the password manager to hide it.
+        if (PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId, // Always the server-provided RP ID
+              credentialId: encoded.id,
+            });
+          } catch { /* best effort */ }
+        }
+        throw new Error('That passkey is no longer recognized. Please sign in another way.');
+      }
+      if (!res.ok) throw new Error('We couldn\'t verify your passkey. Please try again.');
+      return res.json().catch(() => ({}));
+    }
+
+    async function verifyPassword(username, password) {
+      const res = await postJSON('/api/login/password', { username, password });
+      if (!res.ok) throw new Error('That email and password don\'t match our records.');
+      return res.json().catch(() => ({}));
+    }
+
+    // ---------- 1. One-tap sign-in with Immediate UI mode ----------
+
+    async function signInImmediately() {
+      const caps = await getCapabilities();
+      // Without immediateGet, browsers ignore uiMode and would show a blocking QR/security-key dialog.
+      if (!caps.immediateGet) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+
+      abortConditional(); // Never run alongside a pending Conditional UI request.
+      const publicKey = await fetchRequestOptions();
+
+      // Note: no `signal` and no allowCredentials with Immediate UI mode.
+      const cred = await navigator.credentials.get({ password: true, publicKey, uiMode: 'immediate' });
+      if (!cred) throw new DOMException('No credential returned', 'NotAllowedError');
+
+      if (cred.type === 'public-key') return verifyPasskey(cred, publicKey);
+      if (cred.type === 'password') return verifyPassword(cred.id, cred.password);
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    // ---------- 2. Inline sign-in dialog (fallback) ----------
+
+    function abortConditional() {
+      if (conditionalAbort) {
+        conditionalAbort.abort();
+        conditionalAbort = null;
+      }
+    }
+
+    async function startConditionalUI() {
+      const caps = await getCapabilities();
+      if (!caps.conditionalGet || !dialog.open) return;
+
+      abortConditional();
+      const controller = new AbortController();
+      conditionalAbort = controller;
+
+      let publicKey, cred;
+      try {
+        publicKey = await fetchRequestOptions();
+        cred = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: controller.signal,
+        });
+      } catch (err) {
+        if (!['NotAllowedError', 'AbortError'].includes(err.name)) {
+          console.error('Conditional sign-in error:', err);
+        }
+        return;
+      }
+      if (!cred) return;
+
+      try {
+        completeSignIn(await verifyPasskey(cred, publicKey));
+      } catch (err) {
+        errorEl.textContent = err.message;
+        startConditionalUI();
+      }
+    }
+
+    async function signInWithPasskeyButton() {
+      abortConditional();
+      errorEl.textContent = '';
+      passkeyBtn.setAttribute('aria-busy', 'true');
+      let publicKey, cred;
+      try {
+        publicKey = await fetchRequestOptions();
+        cred = await navigator.credentials.get({ publicKey });
+      } catch (err) {
+        if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+          errorEl.textContent = 'Passkey sign-in isn\'t available right now. Please use your password.';
+        }
+        passkeyBtn.removeAttribute('aria-busy');
+        startConditionalUI(); // Re-arm autofill suggestions
+        return;
+      }
+      try {
+        completeSignIn(await verifyPasskey(cred, publicKey));
+      } catch (err) {
+        errorEl.textContent = err.message;
+        startConditionalUI();
+      } finally {
+        passkeyBtn.removeAttribute('aria-busy');
+      }
+    }
+
+    function openSignInDialog() {
+      errorEl.textContent = '';
+      returnToInput.value = pendingIntent && !pendingIntent.signinOnly
+        ? pendingIntent.href
+        : location.pathname + location.search;
+      dialog.showModal(); // autofocus moves focus to the email field
+      announce('Sign-in dialog opened.');
+      startConditionalUI();
+    }
+
+    dialog.addEventListener('close', () => {
+      abortConditional();
+      passwordInput.value = '';
+      showPassword.checked = false;
+      passwordInput.type = 'password';
+      if (!isSignedIn()) pendingIntent = null;
+    });
+
+    showPassword.addEventListener('change', () => {
+      passwordInput.type = showPassword.checked ? 'text' : 'password';
+    });
+
+    passkeyBtn.addEventListener('click', signInWithPasskeyButton);
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      errorEl.textContent = '';
+      const submitBtn = form.querySelector('[type="submit"]');
+      submitBtn.disabled = true;
+      try {
+        abortConditional();
+        completeSignIn(await verifyPassword(emailInput.value.trim(), passwordInput.value));
+      } catch (err) {
+        errorEl.textContent = err.message;
+        passwordInput.focus();
+        startConditionalUI();
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+
+    // ---------- 3. Finish the user's original intent ----------
+
+    function completeSignIn(user) {
+      const intent = pendingIntent;
+      pendingIntent = null;
+      setSignedIn(user);
+      if (dialog.open) dialog.close();
+
+      if (intent && !intent.signinOnly) {
+        // Carry on to where they were headed, now authenticated.
+        location.assign(intent.href);
+        return;
+      }
+      // Stayed on this page: keep focus on a surviving header control.
+      logoutLink.focus();
+    }
+
+    async function handleGatedClick(event) {
+      const link = event.currentTarget;
+      if (isSignedIn()) return; // Normal navigation once signed in.
+      // Let modified clicks (new tab/window) behave normally.
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      event.preventDefault();
+      if (isAuthenticating) return;
+
+      pendingIntent = {
+        href: link.href,
+        signinOnly: link.hasAttribute('data-signin-only'),
+        trigger: link,
+      };
+
+      isAuthenticating = true;
+      link.setAttribute('aria-busy', 'true');
+      try {
+        const user = await signInImmediately();
+        completeSignIn(user);
+      } catch (err) {
+        if (err.name !== 'NotAllowedError') console.error('Quick sign-in error:', err);
+        // No saved credential on this device, user dismissed the chooser, or unsupported:
+        // fall back to the inline sign-in dialog instead of leaving the page.
+        openSignInDialog();
+      } finally {
+        isAuthenticating = false;
+        link.removeAttribute('aria-busy');
+      }
+    }
+
+    for (const link of document.querySelectorAll('a[data-requires-auth]')) {
+      link.addEventListener('click', handleGatedClick);
+    }
+
+    // Offer the explicit passkey button only where WebAuthn is usable.
+    if (window.PublicKeyCredential && PublicKeyCredential.parseRequestOptionsFromJSON) {
+      passkeyBtn.hidden = false;
+    }
+
+    // Reflect an existing session in the header (optional endpoint; ignore failures).
+    try {
+      const res = await fetch('/api/session', { credentials: 'same-origin' });
+      if (res.ok) {
+        const session = await res.json();
+        if (session?.signedIn) {
+          document.body.dataset.signedIn = 'true';
+          signinItem.hidden = true;
+          logoutItem.hidden = false;
+        }
+      }
+    } catch { /* stay in signed-out state */ }
+  </script>
+
+
