+      if (e.target.matches('input, textarea')) {
+        e.target.setCustomValidity('');
+        e.target.removeAttribute('aria-invalid');
+      }
+    });
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+
+      const nameInput = form.elements.name;
+      const bodyInput = form.elements.review;
+      nameInput.value = nameInput.value.trim();
+      if (!bodyInput.value.trim()) bodyInput.value = '';
+
+      const invalid = [...form.elements].filter((el) => el.willValidate && !el.checkValidity());
+      for (const el of form.querySelectorAll('input, textarea')) {
+        if (invalid.includes(el)) el.setAttribute('aria-invalid', 'true');
+        else el.removeAttribute('aria-invalid');
+      }
+      if (invalid.length) {
+        status.textContent = 'Please fill in your name and review before posting.';
+        invalid[0].focus();
+        return;
+      }
+
+      const data = new FormData(form);
+      const review = {
+        drink: data.get('drink'),
+        name: data.get('name'),
+        rating: Number(data.get('rating')),
+        date: new Date().toISOString(),
+        // Stored raw; always sanitized at render time.
+        html: data.get('review')
+      };
+
+      const submitBtn = form.querySelector('button[type="submit"]');
+      submitBtn.disabled = true;
+      reviews.push(review);
+      saveReviews(reviews);
+      await renderAll();
+      form.elements.review.value = '';
+      submitBtn.disabled = false;
+      status.textContent = `Thanks, ${review.name}! Your review of the ${review.drink} has been posted.`;
+    });
+
+    renderAll();
+  </script>
+
