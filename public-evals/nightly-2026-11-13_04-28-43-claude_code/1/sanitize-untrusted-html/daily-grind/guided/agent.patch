+  <script type="module">
+    // ---- Safe rendering of untrusted review HTML -------------------------
+    // Allowlist shared by the native Sanitizer API and the DOMPurify fallback.
+    const ALLOWED_ELEMENTS = [
+      'p', 'br', 'b', 'strong', 'i', 'em', 'u', 's', 'mark', 'small',
+      'ul', 'ol', 'li', 'blockquote', 'code', 'pre', 'a'
+    ];
+    const ALLOWED_LINK_ATTRIBUTES = ['href', 'title'];
+
+    const nativeSanitizerConfig = {
+      elements: ALLOWED_ELEMENTS.map((name) =>
+        name === 'a' ? { name, attributes: ALLOWED_LINK_ATTRIBUTES } : name
+      ),
+      attributes: []
+    };
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      // Only downloaded in browsers without the native Sanitizer API.
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // setHTML() always strips XSS-unsafe content (scripts, on* handlers,
+        // javascript: URLs); our config narrows it further to the allowlist.
+        el.setHTML(html, { sanitizer: nativeSanitizerConfig });
+      } else {
+        try {
+          const DOMPurify = await loadDOMPurify();
+          el.innerHTML = DOMPurify.sanitize(html, {
+            ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+            ALLOWED_ATTR: ALLOWED_LINK_ATTRIBUTES,
+            ALLOW_ARIA_ATTR: false,
+            ALLOW_DATA_ATTR: false,
+            KEEP_CONTENT: false
+          });
+        } catch {
+          // Sanitizer unavailable (e.g. offline): never inject markup, show plain text.
+          el.textContent = html;
+          return;
+        }
+      }
+      // Harden any surviving links (user-generated content).
+      for (const a of el.querySelectorAll('a[href]')) {
+        a.rel = 'nofollow ugc noopener noreferrer';
+        a.target = '_blank';
+      }
+    }
+
+    // ---- Review storage --------------------------------------------------
+    const STORAGE_KEY = 'daily-grind-reviews';
+    const seedReviews = [
+      {
+        drink: 'Maple Oat Latte',
+        name: 'Priya S.',
+        rating: 5,
+        date: '2026-10-28T09:12:00Z',
+        html: '<p>Honestly the <strong>best fall drink</strong> in town. Not too sweet, and the oat milk is <em>so</em> creamy.</p>'
+      },
+      {
+        drink: 'Dark Roast Espresso',
+        name: 'Marco',
+        rating: 4,
+        date: '2026-11-02T07:45:00Z',
+        html: '<p>Bold and smoky, exactly as advertised.</p><ul><li>Great crema</li><li>A little bitter on its own</li></ul>'
+      },
+      {
+        drink: 'Cold Brew',
+        name: 'Jordan',
+        rating: 5,
+        date: '2026-11-08T15:30:00Z',
+        // Demonstrates sanitization: the onerror handler, <img> and <script> are stripped.
+        html: '<blockquote>Smooth as silk.</blockquote><p>18 hours well spent <img src="x" onerror="alert(1)"><script>alert("xss")<\/script></p>'
+      }
+    ];
+
+    function loadReviews() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (Array.isArray(stored)) return stored;
+      } catch { /* ignore corrupt storage */ }
+      return [...seedReviews];
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch { /* storage may be unavailable; keep in memory */ }
+    }
+
+    let reviews = loadReviews();
+
+    // ---- Rendering -------------------------------------------------------
+    const list = document.getElementById('review-list');
+    const emptyMsg = document.getElementById('empty-reviews');
+    const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+    async function renderReview(review) {
+      const li = document.createElement('li');
+      li.className = 'review';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const drink = document.createElement('span');
+      drink.className = 'review-drink';
+      drink.textContent = review.drink;
+
+      const rating = Math.min(5, Math.max(1, Number(review.rating) || 0));
+      const stars = document.createElement('span');
+      stars.className = 'review-rating';
+      stars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
+      stars.setAttribute('role', 'img');
+      stars.setAttribute('aria-label', `${rating} out of 5 stars`);
+
+      const byline = document.createElement('span');
+      const time = document.createElement('time');
+      time.dateTime = review.date;
+      time.textContent = dateFormat.format(new Date(review.date));
+      byline.append(`${review.name} · `, time);
+
+      meta.append(drink, stars, byline);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, review.html);
+
+      li.append(meta, body);
+      return li;
+    }
+
+    function updateCardCounts() {
+      for (const card of document.querySelectorAll('.card[data-drink]')) {
+        const count = reviews.filter((r) => r.drink === card.dataset.drink).length;
+        let badge = card.querySelector('.review-count');
+        if (!badge) {
+          badge = document.createElement('span');
+          badge.className = 'review-count';
+          card.querySelector('p').after(badge);
+        }
+        badge.textContent = `${count} review${count === 1 ? '' : 's'}`;
+      }
+    }
+
+    async function renderAll() {
+      const sorted = [...reviews].sort((a, b) => new Date(b.date) - new Date(a.date));
+      const items = await Promise.all(sorted.map(renderReview));
+      list.replaceChildren(...items);
+      emptyMsg.hidden = items.length > 0;
+      updateCardCounts();
+    }
+
+    // ---- Form handling ---------------------------------------------------
+    const form = document.getElementById('review-form');
+    const status = document.getElementById('form-status');
+
