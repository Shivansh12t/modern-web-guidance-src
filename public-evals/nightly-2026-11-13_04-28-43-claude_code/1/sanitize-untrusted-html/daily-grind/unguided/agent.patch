+          li.appendChild(body);
+          listEl.appendChild(li);
+        });
+      }
+
+      filterEl.addEventListener('click', function (e) {
+        var btn = e.target.closest('button[data-drink]');
+        if (!btn) return;
+        activeFilter = btn.getAttribute('data-drink');
+        var buttons = filterEl.querySelectorAll('button[data-drink]');
+        for (var i = 0; i < buttons.length; i++) {
+          buttons[i].setAttribute('aria-pressed', String(buttons[i] === btn));
+        }
