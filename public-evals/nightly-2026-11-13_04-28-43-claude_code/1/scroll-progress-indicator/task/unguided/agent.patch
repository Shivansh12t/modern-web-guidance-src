diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,44 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Scroll progress indicator
+       Baseline: bar sits at scaleX(0) (invisible) so nothing breaks if neither
+       enhancement is available. Enhancement 1: CSS scroll-driven animations.
+       Enhancement 2: small JS fallback for browsers without them. */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform-origin: 0 50%;
+      transform: scaleX(var(--scroll-progress, 0));
+      z-index: 1001;
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    @supports (animation-timeline: scroll()) {
+      .scroll-progress {
+        animation: scroll-progress-grow linear both;
+        animation-timeline: scroll(root block);
+      }
+
+      @keyframes scroll-progress-grow {
+        from { transform: scaleX(0); }
+        to { transform: scaleX(1); }
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroll-progress" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +237,40 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without CSS scroll-driven animations.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('animation-timeline', 'scroll()')) return;
+      var bar = document.querySelector('.scroll-progress');
+      if (!bar) return;
+      var root = document.documentElement;
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var max = root.scrollHeight - root.clientHeight;
+        var scrollTop = window.pageYOffset || root.scrollTop || document.body.scrollTop || 0;
+        var progress = max > 0 ? Math.min(Math.max(scrollTop / max, 0), 1) : 0;
+        bar.style.setProperty('--scroll-progress', progress);
+        // Older browsers without custom property support.
+        bar.style.transform = 'scaleX(' + progress + ')';
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          (window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); })(update);
+        }
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      window.addEventListener('load', requestUpdate);
+      update();
+    })();
+  </script>
+
 </body>
 
 </html>
