+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const card = document.getElementById('export_element');
+      const form = document.getElementById('designer_form');
+      const hint = document.getElementById('gc_hint');
+      const inputs = {
+        to: document.getElementById('gc_to_input'),
+        message: document.getElementById('gc_message_input'),
+        amount: document.getElementById('gc_amount_input'),
+        color: document.getElementById('gc_color_input'),
+      };
+      const out = {
+        to: document.getElementById('gc_to'),
+        message: document.getElementById('gc_message'),
+        amount: document.getElementById('gc_amount'),
+      };
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function';
+
+      // Pick white or dark text for readable contrast on the chosen background.
+      function textColorFor(hex) {
+        const [r, g, b] = [1, 3, 5].map((i) => {
+          const c = parseInt(hex.slice(i, i + 2), 16) / 255;
+          return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+        });
+        const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+        return (1.05 / (lum + 0.05)) >= ((lum + 0.05) / 0.05) ? '#ffffff' : '#3e2723';
+      }
+
+      function state() {
+        return {
+          to: inputs.to.value.trim() || 'Coffee Lover',
+          message: inputs.message.value.trim(),
+          amount: inputs.amount.value,
+          bg: inputs.color.value,
+          fg: textColorFor(inputs.color.value),
+        };
+      }
+
+      // Sync form values into the HTML card (#export_element).
+      function updateCard() {
+        const s = state();
+        out.to.textContent = s.to;
+        out.message.textContent = s.message;
+        out.amount.textContent = s.amount;
+        card.style.setProperty('--card-bg', s.bg);
+        card.style.setProperty('--card-fg', s.fg);
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint();
+        } else {
+          canvas.setAttribute('aria-label',
+            `Gift card for ${s.to}, ${s.amount}${s.message ? `: ${s.message}` : ''}`);
+          drawFallback();
+        }
+      }
+
+      // HTML-in-Canvas: the browser paints the real card element into the canvas.
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+      };
+
+      // Fallback for browsers without HTML-in-Canvas: redraw the same card with 2D canvas APIs.
+      function wrapLines(text, maxWidth) {
+        const words = text.split(/\s+/).filter(Boolean);
+        const lines = [];
+        let line = '';
+        for (const word of words) {
+          const test = line ? `${line} ${word}` : word;
+          if (ctx.measureText(test).width > maxWidth && line) {
+            lines.push(line);
+            line = word;
+          } else {
+            line = test;
+          }
+        }
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      function drawFallback() {
+        const s = state();
+        const w = canvas.clientWidth || 520;
+        const h = canvas.clientHeight || 325;
+        const font = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
+        const padX = w * 0.08;
+        const padY = h * 0.07;
+
+        ctx.reset();
+        ctx.scale(canvas.width / w, canvas.height / h);
+
+        ctx.save();
+        ctx.beginPath();
+        ctx.roundRect(0, 0, w, h, 16);
+        ctx.clip();
+        ctx.fillStyle = s.bg;
+        ctx.fillRect(0, 0, w, h);
+        const maxSide = Math.hypot(w, h);
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.18)';
+        ctx.beginPath();
+        ctx.arc(w * 0.92, h * 0.08, maxSide / Math.SQRT2 * 0.22, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
+        ctx.beginPath();
+        ctx.arc(w, h, maxSide / Math.SQRT2 * 0.30, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.restore();
+
+        ctx.fillStyle = s.fg;
+        ctx.textBaseline = 'top';
+        ctx.letterSpacing = '3px';
+        ctx.font = `700 15px ${font}`;
+        ctx.fillText('THE DAILY GRIND', padX, padY);
+        ctx.letterSpacing = '2px';
+        ctx.globalAlpha = 0.85;
+        ctx.font = `12px ${font}`;
+        ctx.fillText('COFFEE GIFT CARD', padX, padY + 22);
+
+        const maxText = w - padX * 2;
+        ctx.font = `italic 16px ${font}`;
+        ctx.letterSpacing = '0px';
+        const msgLines = s.message ? wrapLines(s.message, maxText).slice(0, 3) : [];
+        ctx.font = `700 26px ${font}`;
+        const toLines = wrapLines(s.to, maxText).slice(0, 2);
+        const blockH = 18 + toLines.length * 31 + msgLines.length * 24;
+        let y = (h - blockH) / 2;
+
+        ctx.letterSpacing = '2px';
+        ctx.font = `12px ${font}`;
+        ctx.fillText('FOR', padX, y);
+        ctx.globalAlpha = 1;
+        ctx.letterSpacing = '0px';
+        y += 18;
+        ctx.font = `700 26px ${font}`;
+        for (const l of toLines) { ctx.fillText(l, padX, y); y += 31; }
+        ctx.font = `italic 16px ${font}`;
+        for (const l of msgLines) { ctx.fillText(l, padX, y + 4); y += 24; }
+
+        ctx.textBaseline = 'alphabetic';
+        ctx.font = `13px ${font}`;
+        ctx.fillText('\u2615 Redeem in store or online', padX, h - padY);
+        ctx.textAlign = 'right';
+        ctx.fillStyle = '#ffab40';
+        ctx.font = `700 29px ${font}`;
+        ctx.fillText(s.amount, w - padX, h - padY);
+        ctx.textAlign = 'left';
+      }
+
+      // Keep the canvas backing store matched to device pixels to avoid blurriness.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        if (supportsHtmlInCanvas) canvas.requestPaint(); else drawFallback();
+      });
+      const supportsDpcBox = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDpcBox ? { box: 'device-pixel-content-box' } : {});
+
+      form.addEventListener('input', updateCard);
+
+      // Export the canvas design as a PNG download.
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        canvas.toBlob((blob) => {
+          if (!blob) {
+            hint.textContent = 'Sorry, the image could not be created. Please try again.';
+            return;
+          }
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          const slug = state().to.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'gift';
+          link.href = url;
+          link.download = `daily-grind-gift-card-${slug}.png`;
+          link.click();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          hint.textContent = 'Your gift card image has been downloaded.';
+        }, 'image/png');
+      });
+
+      if (!supportsHtmlInCanvas) canvas.setAttribute('role', 'img');
+      updateCard();
+    })();
+  </script>
 </body>
 
