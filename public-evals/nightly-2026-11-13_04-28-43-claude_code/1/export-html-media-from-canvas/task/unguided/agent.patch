+  <script>
+    (function () {
+      var card = document.getElementById('export_element');
+      var canvas = document.getElementById('gift_canvas');
+      var ctx = canvas.getContext('2d');
+      var nameIn = document.getElementById('gc_name');
+      var msgIn = document.getElementById('gc_msg');
+      var amountIn = document.getElementById('gc_amount');
+      var colorIn = document.getElementById('gc_color');
+      var countOut = document.getElementById('gc_msg_count');
+      var exportBtn = document.getElementById('gc_export');
+      var swatches = Array.prototype.slice.call(document.querySelectorAll('.swatch'));
+      var EXPORT_WIDTH = 1400; // output image width in px
+
+      function hexToRgb(hex) {
+        var h = hex.replace('#', '');
+        if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
+        var n = parseInt(h, 16);
+        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+      }
+
+      function isLight(hex) {
+        var rgb = hexToRgb(hex).map(function (v) {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        var lum = 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2];
+        return lum > 0.35;
+      }
+
+      function setColor(hex) {
+        card.style.setProperty('--card-bg', hex);
+        card.style.setProperty('--card-fg', isLight(hex) ? '#3e2723' : '#fafafa');
+        colorIn.value = hex;
+        swatches.forEach(function (s) {
+          s.setAttribute('aria-checked', String(s.dataset.color.toLowerCase() === hex.toLowerCase()));
+        });
+        render();
+      }
+
+      function syncText() {
+        var name = nameIn.value.trim();
+        document.getElementById('gc_out_name').textContent = name ? 'For ' + name : 'A Gift For You';
+        document.getElementById('gc_out_msg').textContent = msgIn.value.trim() || 'Enjoy a cup on us!';
+        document.getElementById('gc_out_amount').textContent = amountIn.value;
+        countOut.textContent = msgIn.value.length + ' / ' + msgIn.maxLength;
+        render();
+      }
+
+      // Break text into lines that fit maxWidth using the current ctx font.
+      function wrapText(text, maxWidth) {
+        var lines = [];
+        text.split(/\n/).forEach(function (para) {
+          var words = para.split(/\s+/).filter(Boolean);
+          var line = '';
+          words.forEach(function (word) {
+            // Hard-break words longer than the line.
+            while (ctx.measureText(word).width > maxWidth && word.length > 1) {
+              var i = word.length - 1;
+              while (i > 1 && ctx.measureText((line ? line + ' ' : '') + word.slice(0, i)).width > maxWidth) i--;
+              if (line && ctx.measureText(line + ' ' + word.slice(0, i)).width > maxWidth) {
+                lines.push(line);
+                line = '';
+                continue;
+              }
+              lines.push((line ? line + ' ' : '') + word.slice(0, i));
+              line = '';
+              word = word.slice(i);
+            }
+            var test = line ? line + ' ' + word : word;
+            if (ctx.measureText(test).width > maxWidth && line) {
+              lines.push(line);
+              line = word;
+            } else {
+              line = test;
+            }
+          });
+          lines.push(line);
+        });
+        return lines;
+      }
+
+      function ellipsize(text, maxWidth) {
+        if (ctx.measureText(text).width <= maxWidth) return text;
+        while (text.length && ctx.measureText(text + '…').width > maxWidth) text = text.slice(0, -1);
+        return text + '…';
+      }
+
+      function roundRectPath(x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.moveTo(x + r, y);
+        ctx.arcTo(x + w, y, x + w, y + h, r);
+        ctx.arcTo(x + w, y + h, x, y + h, r);
+        ctx.arcTo(x, y + h, x, y, r);
+        ctx.arcTo(x, y, x + w, y, r);
+        ctx.closePath();
+      }
+
+      // Paint the HTML card (#export_element) into the canvas by reading the
+      // live layout + computed styles of each of its child elements.
+      function render() {
+        var cardRect = card.getBoundingClientRect();
+        if (!cardRect.width) return;
+        var scale = EXPORT_WIDTH / cardRect.width;
+        var w = Math.round(cardRect.width * scale);
+        var h = Math.round(cardRect.height * scale);
+        if (canvas.width !== w || canvas.height !== h) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+
+        var cardStyle = getComputedStyle(card);
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, w, h);
+        ctx.save();
+        roundRectPath(0, 0, w, h, (parseFloat(cardStyle.borderTopLeftRadius) || 0) * scale);
+        ctx.clip();
+        ctx.fillStyle = cardStyle.backgroundColor;
+        ctx.fillRect(0, 0, w, h);
+        ctx.scale(scale, scale);
+
+        Array.prototype.forEach.call(card.children, function (el) {
+          var r = el.getBoundingClientRect();
+          var cs = getComputedStyle(el);
+          var x = r.left - cardRect.left;
+          var y = r.top - cardRect.top;
+          ctx.save();
+          ctx.globalAlpha = parseFloat(cs.opacity);
+
+          if (el.classList.contains('gc-deco')) {
+            ctx.fillStyle = cs.backgroundColor;
+            ctx.beginPath();
+            ctx.ellipse(x + r.width / 2, y + r.height / 2, r.width / 2, r.height / 2, 0, 0, Math.PI * 2);
+            ctx.fill();
+          } else if (el.hasAttribute('data-render')) {
+            var fontSize = parseFloat(cs.fontSize);
+            ctx.font = [cs.fontStyle, cs.fontWeight, cs.fontSize, cs.fontFamily].join(' ');
+            ctx.fillStyle = cs.color;
+            ctx.textBaseline = 'middle';
+            if ('letterSpacing' in ctx) ctx.letterSpacing = cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing;
+            var lineHeight = cs.lineHeight === 'normal' ? fontSize * 1.2 : parseFloat(cs.lineHeight);
+            var text = cs.textTransform === 'uppercase' ? el.textContent.toUpperCase() : el.textContent;
+            var alignRight = cs.textAlign === 'right' || cs.textAlign === 'end';
+            ctx.textAlign = alignRight ? 'right' : 'left';
+            var tx = alignRight ? x + r.width : x;
+            var lines = el.hasAttribute('data-single-line')
+              ? [ellipsize(text, r.width)]
+              : wrapText(text, r.width);
+            lines.forEach(function (line, i) {
+              ctx.fillText(line, tx, y + lineHeight * i + lineHeight / 2);
+            });
+          }
+          ctx.restore();
+        });
+        ctx.restore();
+      }
+
+      function exportCard() {
+        render();
+        exportBtn.disabled = true;
+        var name = nameIn.value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+        var filename = 'daily-grind-gift-card' + (name ? '-' + name : '') + '.png';
+        var done = function () { exportBtn.disabled = false; };
+        var download = function (url, revoke) {
+          var a = document.createElement('a');
+          a.href = url;
+          a.download = filename;
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+          if (revoke) setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+          done();
+        };
+        if (canvas.toBlob) {
+          canvas.toBlob(function (blob) {
+            if (blob) download(URL.createObjectURL(blob), true);
+            else download(canvas.toDataURL('image/png'), false);
+          }, 'image/png');
+        } else {
+          download(canvas.toDataURL('image/png'), false);
+        }
+      }
+
+      swatches.forEach(function (s) {
+        s.addEventListener('click', function () { setColor(s.dataset.color); });
+      });
+      colorIn.addEventListener('input', function () { setColor(colorIn.value); });
+      nameIn.addEventListener('input', syncText);
+      msgIn.addEventListener('input', syncText);
+      amountIn.addEventListener('change', syncText);
+      exportBtn.addEventListener('click', exportCard);
+      window.addEventListener('resize', render);
+      if ('ResizeObserver' in window) new ResizeObserver(render).observe(card);
+
+      setColor(colorIn.value);
+      syncText();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(render);
+    })();
+  </script>
 </body>
 
