+  <script>
+    // Fit each lockup line's font-size so its text exactly spans the heading width.
+    (function () {
+      var REF = 100; // reference size in px used for measuring
+      function fit(heading) {
+        var target = heading.clientWidth;
+        if (!target) return;
+        heading.querySelectorAll('.lockup-line').forEach(function (line) {
+          var inner = line.firstElementChild;
+          line.style.fontSize = REF + 'px';
+          var w = inner.getBoundingClientRect().width;
+          if (w) line.style.fontSize = (REF * target / w) + 'px';
+        });
+      }
+      function fitAll() {
+        document.querySelectorAll('h1.lockup').forEach(fit);
+      }
+      if ('ResizeObserver' in window) {
+        var ro = new ResizeObserver(fitAll);
+        document.querySelectorAll('h1.lockup').forEach(function (h) { ro.observe(h); });
+      } else {
+        window.addEventListener('resize', fitAll);
+      }
+      fitAll();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitAll);
+    })();
+  </script>
