+  <script>
+    (() => {
+      const strengths = [
+        { name: 'Mild', desc: 'Light and bright, with gentle citrus and floral notes.' },
+        { name: 'Medium', desc: 'Balanced body with smooth caramel notes.' },
+        { name: 'Bold', desc: 'Rich and full-bodied, with dark chocolate depth.' },
+        { name: 'Extra Bold', desc: 'Intense, smoky, and built for serious mornings.' },
+      ];
+      const slider = document.getElementById('brew-strength');
+      const nameEl = document.getElementById('strength-name');
+      const descEl = document.getElementById('strength-desc');
+      const ticks = document.querySelectorAll('.strength-ticks li');
+
+      function sync() {
+        const i = Number(slider.value);
+        const { name, desc } = strengths[i];
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', slider.value);
+        slider.setAttribute('aria-valuetext', name);
+        nameEl.textContent = name;
+        descEl.textContent = desc;
+        ticks.forEach((t) => {
+          if (Number(t.dataset.value) === i) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      ticks.forEach((t) => t.addEventListener('click', () => {
+        slider.value = t.dataset.value;
+        slider.dispatchEvent(new Event('input', { bubbles: true }));
+        slider.focus();
+      }));
+
+      slider.addEventListener('input', sync);
+      sync();
+    })();
+  </script>
+
 </body>
 
