+
+    /* Track (WebKit) — fill is painted so it ends exactly at the thumb centre */
+    .strength-range::-webkit-slider-runnable-track {
+      height: var(--track);
+      border-radius: 999px;
+      background:
+        linear-gradient(90deg, #ffcc80, var(--fill)) 0 / calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--pct)) 100% no-repeat,
+        var(--secondary);
+      box-shadow: inset 0 1px 3px rgba(62, 39, 35, 0.25);
+    }
+
+    /* Track (Firefox) */
+    .strength-range::-moz-range-track {
