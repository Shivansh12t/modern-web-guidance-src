+  <script>
+    (function () {
+      var strengths = [
+        { name: 'Mild', color: '#ffcc80', desc: 'Light and mellow with bright, fruity notes. Easy sipping any time of day.' },
+        { name: 'Medium', color: '#ffab40', desc: 'Balanced and smooth, with caramel sweetness and a clean finish.' },
+        { name: 'Bold', color: '#e65100', desc: 'Full-bodied and rich, with deep chocolate and toasted nut flavors.' },
+        { name: 'Extra Bold', color: '#6d2c00', desc: 'Intense, smoky, and robust. For those who mean business before 7am.' }
+      ];
+
+      var range = document.getElementById('brew-strength');
+      var slider = document.getElementById('strength-slider');
+      var nameEl = document.getElementById('strength-name');
+      var beansEl = document.getElementById('strength-beans');
+      var descEl = document.getElementById('strength-desc');
+      var buttons = slider.querySelectorAll('.strength-ticks button');
+      var max = Number(range.max);
+
+      function update() {
+        var i = Number(range.value);
+        var s = strengths[i];
+        slider.style.setProperty('--pct', i / max);
+        slider.style.setProperty('--fill', s.color);
+        range.setAttribute('aria-valuetext', s.name);
+        nameEl.textContent = s.name;
+        nameEl.style.color = i === 0 ? 'var(--primary)' : s.color;
+        beansEl.textContent = '☕'.repeat(i + 1);
+        descEl.textContent = s.desc;
+        buttons.forEach(function (b) {
+          b.setAttribute('aria-pressed', String(Number(b.dataset.value) === i));
+        });
+      }
+
+      range.addEventListener('input', update);
+      buttons.forEach(function (b) {
+        b.addEventListener('click', function () {
+          range.value = b.dataset.value;
+          update();
+          range.dispatchEvent(new Event('change', { bubbles: true }));
+        });
+      });
+
+      update();
+    })();
+  </script>
+
