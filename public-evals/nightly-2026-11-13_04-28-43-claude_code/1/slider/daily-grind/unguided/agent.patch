+      border-radius: 999px;
+      background: var(--secondary);
+      box-shadow: inset 0 1px 3px rgba(62, 39, 35, 0.25);
+    }
+
+    .strength-range::-moz-range-progress {
+      height: var(--track);
+      border-radius: 999px;
+      background: linear-gradient(90deg, #ffcc80, var(--fill));
+    }
+
+    /* Thumb (WebKit) */
+    .strength-range::-webkit-slider-thumb {
