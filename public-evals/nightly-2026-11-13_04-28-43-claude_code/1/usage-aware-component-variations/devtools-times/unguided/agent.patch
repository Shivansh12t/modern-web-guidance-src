+}
+/*
+ * Context-aware teaser presentation
+ * ---------------------------------
+ * Teaser cards never receive a "featured" prop. Instead, the section that
+ * contains them declares its semantic context via `data-teaser-context`, and
+ * the presentation is derived from inherited custom properties. Because custom
+ * properties inherit, the *nearest* context ancestor always wins, so nesting a
+ * default section inside a featured one (or vice versa) behaves as expected.
+ *
+ *   featured -> promotional badge visible, filled action button
+ *   default  -> badge hidden, outlined action button (also used when no
+ *               context is declared at all)
+ */
+@layer components {
+  [data-teaser-context="featured"] {
+    --teaser-badge-display: inline-flex;
+    --teaser-action-bg: var(--color-amber-400, #fbbf24);
+    --teaser-action-fg: var(--color-gray-900, #111827);
+    --teaser-action-border: var(--color-amber-400, #fbbf24);
+    --teaser-action-hover-bg: var(--color-amber-500, #f59e0b);
+    --teaser-action-hover-fg: var(--color-gray-900, #111827);
+    --teaser-action-hover-border: var(--color-amber-500, #f59e0b);
+    --teaser-card-ring: var(--color-amber-200, #fde68a);
+  }
+
+  [data-teaser-context="default"] {
+    --teaser-badge-display: none;
+    --teaser-action-bg: transparent;
+    --teaser-action-fg: var(--color-gray-700, #374151);
+    --teaser-action-border: var(--color-gray-300, #d1d5db);
+    --teaser-action-hover-bg: transparent;
+    --teaser-action-hover-fg: var(--color-amber-800, #92400e);
+    --teaser-action-hover-border: var(--color-amber-400, #fbbf24);
+    --teaser-card-ring: transparent;
+  }
+
+  .teaser-badge {
+    display: var(--teaser-badge-display, none);
+    align-items: center;
+    gap: 0.25rem;
+    width: fit-content;
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    background-color: var(--color-amber-100, #fef3c7);
+    color: var(--color-amber-900, #78350f);
+    font-size: 0.6875rem;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    line-height: 1.25rem;
+    text-transform: uppercase;
+  }
+
+  .teaser-action {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.375rem;
+    padding: 0.375rem 0.875rem;
+    border: 1px solid var(--teaser-action-border, var(--color-gray-300, #d1d5db));
+    border-radius: 0.375rem;
+    background-color: var(--teaser-action-bg, transparent);
+    color: var(--teaser-action-fg, var(--color-gray-700, #374151));
+    font-size: 0.875rem;
+    font-weight: 600;
+    line-height: 1.25rem;
+    transition: background-color 150ms, border-color 150ms, color 150ms;
+  }
+
+  .teaser-action:hover {
+    border-color: var(--teaser-action-hover-border, var(--color-amber-400, #fbbf24));
+    background-color: var(--teaser-action-hover-bg, transparent);
+    color: var(--teaser-action-hover-fg, var(--color-amber-800, #92400e));
+  }
+
+  .teaser-action:focus-visible {
+    outline: 2px solid var(--color-amber-500, #f59e0b);
+    outline-offset: 2px;
+  }
+
+  .teaser-card {
+    box-shadow: 0 0 0 1px var(--teaser-card-ring, transparent);
+  }
+}
