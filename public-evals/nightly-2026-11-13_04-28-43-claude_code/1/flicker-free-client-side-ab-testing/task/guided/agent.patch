diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,224 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Lumen — Ship faster with less stress</title>
+  <meta name="description" content="Lumen helps teams plan, build, and ship products without the chaos.">
+
+  <!-- Warm up the connection to the experiment CDN as early as possible,
+       since first paint waits on this script. -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="preconnect" href="https://images.unsplash.com">
+
+  <!--
+    Anti-flicker FALLBACK — only for browsers without `blocking="render"`
+    support (e.g. Firefox). It must run before the SDK script tag so the
+    reveal hook exists when the SDK's load/error events fire.
+    Browsers that support `blocking` skip this entirely.
+  -->
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var reveal = function () { root.classList.remove('ab-loading'); };
+      // Hook the SDK can call when variants are applied; also wired to the
+      // script's load/error events below so we never stay hidden.
+      window.onExperimentReady = reveal;
+      if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+        root.classList.add('ab-loading');
+        // Safety net: never leave the page blank on a slow/failed CDN.
+        setTimeout(reveal, 4000);
+      }
+    })();
+  </script>
+  <style>
+    .ab-loading { opacity: 0 !important; }
+  </style>
+
+  <!--
+    Experiment SDK.
+    - `async`: does not block HTML parsing; the DOM is built in parallel.
+    - `blocking="render"`: the browser will not paint until this script has
+      executed, so the original content never flashes before the variant.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+    onload="window.onExperimentReady && window.onExperimentReady()"
+    onerror="window.onExperimentReady && window.onExperimentReady()"
+  ></script>
+
+  <style>
+    :root {
+      color-scheme: light dark;
+      --bg: light-dark(#f8fafc, #0b1020);
+      --fg: light-dark(#0f172a, #e2e8f0);
+      --muted: light-dark(#475569, #94a3b8);
+      --accent: #4f46e5;
+      --accent-hover: #4338ca;
+      --radius: 0.75rem;
+    }
+
+    *, *::before, *::after { box-sizing: border-box; }
+
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+    }
+
+    .site-header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 1.25rem clamp(1rem, 5vw, 4rem);
+    }
+
+    .logo {
+      font-weight: 800;
+      font-size: 1.25rem;
+      color: inherit;
+      text-decoration: none;
+    }
+
+    .site-header nav a {
+      color: var(--muted);
+      text-decoration: none;
+      margin-inline-start: 1.5rem;
+    }
+    .site-header nav a:hover { color: var(--fg); }
+
+    .hero {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
+      align-items: center;
+      gap: clamp(2rem, 5vw, 4rem);
+      padding: clamp(2rem, 8vw, 6rem) clamp(1rem, 5vw, 4rem);
+      max-width: 80rem;
+      margin-inline: auto;
+    }
+
+    .eyebrow {
+      display: inline-block;
+      font-size: 0.875rem;
+      font-weight: 600;
+      color: var(--accent);
+      background: color-mix(in srgb, var(--accent) 12%, transparent);
+      padding: 0.25rem 0.75rem;
+      border-radius: 999px;
+      margin: 0 0 1rem;
+    }
+
+    .hero h1 {
+      font-size: clamp(2.25rem, 5vw + 1rem, 4rem);
+      line-height: 1.1;
+      letter-spacing: -0.02em;
+      margin: 0 0 1rem;
+      text-wrap: balance;
+    }
+
+    .hero p.lede {
+      font-size: clamp(1.05rem, 1vw + 0.8rem, 1.25rem);
+      color: var(--muted);
+      margin: 0 0 2rem;
+      max-width: 36rem;
+      text-wrap: pretty;
+    }
+
+    .cta-group {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 1rem;
+      align-items: center;
+    }
+
+    .cta-button {
+      display: inline-block;
+      background: var(--accent);
+      color: #fff;
+      font-weight: 600;
+      font-size: 1.05rem;
+      padding: 0.9rem 1.75rem;
+      border-radius: var(--radius);
+      text-decoration: none;
+      box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--accent) 70%, transparent);
+      transition: background-color 0.2s, transform 0.2s;
+    }
+    .cta-button:hover { background: var(--accent-hover); transform: translateY(-1px); }
+    .cta-button:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }
+
+    .secondary-link {
+      color: var(--fg);
+      font-weight: 500;
+      text-decoration: none;
+    }
+    .secondary-link:hover { text-decoration: underline; }
+
+    .hero-media img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: calc(var(--radius) * 2);
+      box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.35);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .cta-button { transition: none; }
+      .cta-button:hover { transform: none; }
+    }
+
+    /*
+      Variant styling hooks. The experiment SDK can either rewrite DOM nodes
+      directly (they carry data-experiment ids) or simply set
+      <html data-variant="b"> and let these rules do the work.
+    */
+    [data-variant="b"] .cta-button { --accent: #059669; --accent-hover: #047857; }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a class="logo" href="/">Lumen</a>
+    <nav aria-label="Primary">
+      <a href="#features">Features</a>
+      <a href="#pricing">Pricing</a>
+      <a href="#login">Log in</a>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-title" data-experiment="hero">
+      <div class="hero-copy">
+        <p class="eyebrow" data-experiment="hero-eyebrow">New: AI-assisted planning</p>
+        <h1 id="hero-title" data-experiment="hero-headline">Ship faster, with less stress.</h1>
+        <p class="lede" data-experiment="hero-subhead">
+          Lumen brings your roadmap, tasks, and team updates into one calm
+          workspace — so you can spend less time coordinating and more time building.
+        </p>
+        <div class="cta-group">
+          <a class="cta-button" href="#signup" data-experiment="hero-cta">Start free trial</a>
+          <a class="secondary-link" href="#demo">Watch a 2-min demo →</a>
+        </div>
+      </div>
+      <div class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80"
+          srcset="
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80 600w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80 1200w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1800&q=80 1800w"
+          sizes="(min-width: 50rem) 50vw, 100vw"
+          width="1200" height="900"
+          alt="A team collaborating around laptops at a shared table"
+          fetchpriority="high"
+          data-experiment="hero-image"
+        >
+      </div>
+    </section>
+  </main>
+</body>
+</html>
