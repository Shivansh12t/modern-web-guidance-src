+  <script>
+    (function () {
+      var table = document.getElementById('seasonal-drinks');
+      if (!table) return;
+      var headers = table.querySelectorAll('thead th');
+      var tbody = table.tBodies[0];
+
+      function cellValue(row, index, type) {
+        var cell = row.cells[index];
+        var raw = cell.getAttribute('data-value') || cell.textContent.trim();
+        if (type === 'number') {
+          var n = parseFloat(raw.replace(/[^0-9.\-]/g, ''));
+          return isNaN(n) ? 0 : n;
+        }
+        return raw.toLowerCase();
+      }
+
+      headers.forEach(function (th, index) {
+        th.querySelector('button').addEventListener('click', function () {
+          var type = th.getAttribute('data-type');
+          var direction = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+          var factor = direction === 'ascending' ? 1 : -1;
+
+          var rows = Array.prototype.slice.call(tbody.rows);
+          rows.sort(function (a, b) {
+            var va = cellValue(a, index, type);
+            var vb = cellValue(b, index, type);
+            if (type === 'number') return (va - vb) * factor;
+            return va.localeCompare(vb) * factor;
+          });
+          rows.forEach(function (row) { tbody.appendChild(row); });
+
+          headers.forEach(function (other) { other.setAttribute('aria-sort', 'none'); });
+          th.setAttribute('aria-sort', direction);
+        });
+      });
+    })();
+  </script>
+
