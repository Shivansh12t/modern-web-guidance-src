+  <script>
+    (() => {
+      const container = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const toggleCard = document.getElementById('toggleCard');
+
+      const promos = [
+        { title: '20% Off Cold Brew', text: 'Beat the heat with our 18-hour steeped cold brew.', img: 'photo-1461023058943-07fcbe16d735', alt: 'Iced coffee in a glass' },
+        { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink on Fridays.', img: 'photo-1555507036-ab1f4038808a', alt: 'Fresh croissants on a tray' },
+        { title: 'Double Reward Stars', text: 'Earn twice the stars on every espresso drink this week.', img: 'photo-1510707577719-ae7c14805e3a', alt: 'Espresso being pulled from a machine' },
+        { title: 'Beans Bundle Deal', text: 'Buy two bags of whole beans, get the third half off.', img: 'photo-1447933601403-0c6688de566e', alt: 'Roasted coffee beans' },
+        { title: 'Morning Commuter Pass', text: 'Any small drip coffee for $1 before 8am.', img: 'photo-1495474472287-4d71bcdd2085', alt: 'Cup of black coffee on a table' }
+      ];
+      let promoIndex = 0;
+
+      function createCard({ title, text, img, alt }) {
+        const card = document.createElement('article');
+        card.className = 'card';
+        const image = document.createElement('img');
+        image.src = `https://images.unsplash.com/${img}?auto=format&fit=crop&w=600&q=80`;
+        image.alt = alt;
+        image.width = 600;
+        image.height = 400;
+        image.loading = 'lazy';
+        const badge = document.createElement('span');
+        badge.className = 'promo-badge';
+        badge.textContent = 'Promo';
+        const h3 = document.createElement('h3');
+        h3.textContent = title;
+        const p = document.createElement('p');
+        p.textContent = text;
+        card.append(image, badge, h3, p);
+        return card;
+      }
+
+      async function waitForTransitions(el) {
+        const animations = el.getAnimations();
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000))
+          ]);
+        }
+      }
+
+      // Animate the visual exit via [data-closing] (works even where display
+      // can't be transitioned), then apply display: none via [hidden].
+      async function hideElement(el) {
+        el.setAttribute('data-closing', '');
+        await waitForTransitions(el);
+        // Skipped if showElement() cancelled the close mid-animation.
+        if (el.hasAttribute('data-closing')) {
+          el.removeAttribute('data-closing');
+          el.hidden = true;
+          return true;
+        }
+        return false;
+      }
+
+      function showElement(el) {
+        el.removeAttribute('data-closing');
+        el.hidden = false; // @starting-style drives the entry transition
+      }
+
+      async function removeElement(el) {
+        if (await hideElement(el)) el.remove();
+      }
+
+      addBtn.addEventListener('click', () => {
+        const promo = promos[promoIndex++ % promos.length];
+        container.append(createCard(promo));
+      });
+
+      removeBtn.addEventListener('click', () => {
+        // Last added promo card that isn't already leaving; the default card is controlled by the toggle.
+        const cards = container.querySelectorAll('.card:not(#toggleCard):not([data-closing]):not([hidden])');
+        const last = cards[cards.length - 1];
+        if (last) removeElement(last);
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        const isVisible = !toggleCard.hidden && !toggleCard.hasAttribute('data-closing');
+        if (isVisible) {
+          hideElement(toggleCard);
+        } else {
+          showElement(toggleCard);
+        }
+        toggleBtn.setAttribute('aria-expanded', String(!isVisible));
+        toggleBtn.textContent = isVisible ? 'Show Featured Promo' : 'Hide Featured Promo';
+      });
+    })();
+  </script>
+
 </body>
 
