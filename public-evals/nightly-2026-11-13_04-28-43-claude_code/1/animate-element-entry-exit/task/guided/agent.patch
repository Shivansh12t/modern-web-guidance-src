+
+    /* Exit: fade + scale out before being hidden/removed */
+    #domContainer .card:where([hidden], [data-closing]) {
+      opacity: 0;
+      scale: 0.8;
+    }
+
+    #domContainer .card[hidden] {
+      display: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #domContainer .card {
+        scale: none;
+        transition-duration: 0.1s;
+      }
+
+      @starting-style {
+        #domContainer .card {
+          scale: none;
+        }
+      }
+
+      #domContainer .card:where([hidden], [data-closing]) {
