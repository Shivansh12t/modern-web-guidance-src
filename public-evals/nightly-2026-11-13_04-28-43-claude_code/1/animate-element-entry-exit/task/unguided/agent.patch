+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var addBtn = document.getElementById('addBtn');
+      var removeBtn = document.getElementById('removeBtn');
+      var toggleBtn = document.getElementById('toggleBtn');
+      var toggleCard = document.getElementById('toggleCard');
+      var emptyMsg = document.getElementById('promoEmpty');
+      var EXIT_MS = 350;
+
+      var promos = [
+        { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink every Friday.', badge: 'Weekly',
+          img: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80', alt: 'Fresh croissants' },
+        { title: 'Cold Brew Club', text: 'Buy 5 cold brews, get the 6th on the house.', badge: 'Rewards',
+          img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80', alt: 'Iced coffee in a glass' },
+        { title: '20% Off Whole Beans', text: 'Take our house roast home &mdash; this week only.', badge: 'Sale',
+          img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80', alt: 'Roasted coffee beans' },
+        { title: 'Early Bird Espresso', text: 'Half-price espresso shots before 8 AM.', badge: 'Morning',
+          img: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80', alt: 'Espresso shot being pulled' }
+      ];
+      var promoIndex = 0;
+
+      function isActive(card) {
+        return !card.hidden && !card.classList.contains('is-exiting');
+      }
+
+      function updateEmpty() {
+        var any = Array.prototype.some.call(container.querySelectorAll('.card'), isActive);
+        emptyMsg.hidden = any;
+      }
+
+      // Play the exit animation, then run `done` once it finishes (with a timeout fallback).
+      function animateOut(card, done) {
+        if (card.classList.contains('is-exiting')) return;
+        card.classList.add('is-exiting');
+        updateEmpty();
+        var finished = false;
+        function finish() {
+          if (finished) return;
+          finished = true;
+          card.removeEventListener('animationend', onEnd);
+          card.classList.remove('is-exiting');
+          done(card);
+          updateEmpty();
+        }
+        function onEnd(e) { if (e.target === card) finish(); }
+        card.addEventListener('animationend', onEnd);
+        setTimeout(finish, EXIT_MS + 100);
+      }
+
+      function restartEnter(card) {
+        // Re-trigger the CSS entry animation.
+        card.style.animation = 'none';
+        void card.offsetWidth;
+        card.style.animation = '';
+      }
+
+      function createCard(p) {
+        var card = document.createElement('div');
+        card.className = 'card promo-card';
+        card.innerHTML =
+          '<img loading="lazy">' +
+          '<div class="promo-body"><span class="promo-badge"></span><h3></h3><p></p></div>';
+        var img = card.querySelector('img');
+        img.src = p.img;
+        img.alt = p.alt;
+        card.querySelector('.promo-badge').textContent = p.badge;
+        card.querySelector('h3').textContent = p.title;
+        card.querySelector('p').innerHTML = p.text;
+        return card;
+      }
+
+      function showToggleCard() {
+        if (toggleCard.classList.contains('is-exiting')) {
+          // Cancel an in-progress exit.
+          toggleCard.classList.remove('is-exiting');
+        }
+        toggleCard.hidden = false;
+        restartEnter(toggleCard);
+        toggleBtn.setAttribute('aria-pressed', 'true');
+        updateEmpty();
+      }
+
+      function hideToggleCard() {
+        toggleBtn.setAttribute('aria-pressed', 'false');
+        animateOut(toggleCard, function (c) {
+          if (toggleBtn.getAttribute('aria-pressed') === 'false') c.hidden = true;
+        });
+      }
+
+      addBtn.addEventListener('click', function () {
+        var card = createCard(promos[promoIndex % promos.length]);
+        promoIndex++;
+        container.appendChild(card);
+        updateEmpty();
+      });
+
+      removeBtn.addEventListener('click', function () {
+        var cards = Array.prototype.filter.call(container.querySelectorAll('.card'), isActive);
+        var last = cards[cards.length - 1];
+        if (!last) return;
+        if (last === toggleCard) {
+          // Keep the default card in the DOM so it can be toggled back.
+          hideToggleCard();
+        } else {
+          animateOut(last, function (c) { c.remove(); });
+        }
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        if (isActive(toggleCard)) hideToggleCard();
+        else showToggleCard();
+      });
+
+      updateEmpty();
+    })();
+  </script>
+
 </body>
 
