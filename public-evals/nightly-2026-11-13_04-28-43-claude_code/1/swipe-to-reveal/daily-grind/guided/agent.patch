+  <script>
+    // Swipe-to-reveal: native scroll snap handles the gesture; JS only keeps
+    // accessibility state (aria-expanded, tabindex) in sync and wires the buttons.
+    // No action is ever performed by the swipe itself.
+    for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+      const content = reveal.querySelector('.SwipeReveal-content');
+      const panel = reveal.querySelector('.SwipeReveal-panel');
+      const trigger = reveal.querySelector('.SwipeReveal-trigger');
+      const actions = panel.querySelectorAll('.SwipeReveal-action');
+
+      const setOpen = (open) => {
+        trigger.setAttribute('aria-expanded', String(open));
+        for (const action of actions) action.tabIndex = open ? 0 : -1;
+      };
+
+      const isPanelVisible = () =>
+        Math.abs(reveal.scrollLeft) > panel.offsetWidth / 2;
+
+      const open = () => {
+        reveal.scrollTo({ left: reveal.scrollWidth });
+        setOpen(true);
+      };
+
+      const close = () => {
+        reveal.scrollTo({ left: 0 });
+        setOpen(false);
+      };
+
+      trigger.addEventListener('click', () => {
+        trigger.getAttribute('aria-expanded') === 'true' ? close() : open();
+      });
+
+      // Keep state in sync when the user swipes instead of using the trigger.
+      if ('onscrollsnapchange' in Element.prototype) {
+        reveal.addEventListener('scrollsnapchange', (event) => {
+          setOpen(event.snapTargetInline === panel);
+        });
+      } else {
+        let timeout;
+        const sync = () => {
+          clearTimeout(timeout);
+          setOpen(isPanelVisible());
+        };
+        reveal.addEventListener('scroll', () => {
+          clearTimeout(timeout);
+          timeout = setTimeout(sync, 100);
+        }, { passive: true });
+        reveal.addEventListener('scrollend', sync);
+      }
+
+      // Keyboard users tabbing back into the card content close the strip.
+      content.addEventListener('focusin', (event) => {
+        if (event.target !== trigger && event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+
+      // Escape closes the revealed actions and returns focus to the trigger.
+      reveal.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
+          close();
+          trigger.focus();
+        }
+      });
+
+      for (const action of actions) {
+        action.addEventListener('click', async () => {
+          const drink = reveal.dataset.drink;
+          if (action.dataset.action === 'favorite') {
+            const pressed = action.getAttribute('aria-pressed') === 'true';
+            action.setAttribute('aria-pressed', String(!pressed));
+          } else if (action.dataset.action === 'share') {
+            const url = new URL(action.dataset.url, location.href).href;
+            try {
+              if (navigator.share) {
+                await navigator.share({ title: drink, url });
+              } else {
+                await navigator.clipboard.writeText(url);
+              }
+            } catch {
+              /* Share dismissed or clipboard unavailable. */
+            }
+          }
+        });
+      }
+    }
+  </script>
+
