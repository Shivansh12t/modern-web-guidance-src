+  <script>
+    (function () {
+      var FAVORITES_KEY = 'dailyGrindFavorites';
+      var OPEN_THRESHOLD = 0.4; // fraction of tray width needed to snap open
+      var INTENT_SLOP = 8;      // px before deciding horizontal vs vertical
+      var cards = Array.prototype.slice.call(document.querySelectorAll('.swipe-card'));
+      var openCard = null;
+
+      function loadFavorites() {
+        try { return JSON.parse(localStorage.getItem(FAVORITES_KEY)) || []; }
+        catch (e) { return []; }
+      }
+
+      function saveFavorites(list) {
+        try { localStorage.setItem(FAVORITES_KEY, JSON.stringify(list)); } catch (e) { }
+      }
+
+      function trayWidth(card) {
+        return card.querySelector('.swipe-actions').offsetWidth;
+      }
+
+      function setOffset(card, x) {
+        card.querySelector('.swipe-content').style.transform = 'translateX(' + x + 'px)';
+      }
+
+      function setOpen(card, open, focusActions) {
+        var actions = card.querySelector('.swipe-actions');
+        var toggle = card.querySelector('.swipe-toggle');
+        card.classList.toggle('is-open', open);
+        setOffset(card, open ? -trayWidth(card) : 0);
+        toggle.setAttribute('aria-expanded', String(open));
+        toggle.querySelector('.sr-only').textContent =
+          (open ? 'Hide actions for ' : 'Show actions for ') + card.querySelector('h3').textContent;
+        // Keep hidden actions out of the tab order / accessibility tree.
+        if (open) { actions.removeAttribute('inert'); actions.removeAttribute('aria-hidden'); }
+        else { actions.setAttribute('inert', ''); actions.setAttribute('aria-hidden', 'true'); }
+
+        if (open) {
+          if (openCard && openCard !== card) setOpen(openCard, false);
+          openCard = card;
+          if (focusActions) actions.querySelector('.swipe-action').focus();
+        } else if (openCard === card) {
+          openCard = null;
+        }
+      }
+
+      cards.forEach(function (card) {
+        var content = card.querySelector('.swipe-content');
+        var toggle = card.querySelector('.swipe-toggle');
+        var startX = 0, startY = 0, baseX = 0, currentX = 0;
+        var pointerId = null, axis = null, didDrag = false;
+
+        setOpen(card, false);
+
+        content.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseX = card.classList.contains('is-open') ? -trayWidth(card) : 0;
+          currentX = baseX;
+          axis = null;
+          didDrag = false;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var dx = e.clientX - startX;
+          var dy = e.clientY - startY;
+
+          if (!axis) {
+            if (Math.abs(dx) < INTENT_SLOP && Math.abs(dy) < INTENT_SLOP) return;
+            axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
+            if (axis === 'y') { pointerId = null; return; } // let the page scroll
+            didDrag = true;
+            card.classList.add('dragging');
+            try { content.setPointerCapture(e.pointerId); } catch (err) { }
+          }
+
+          var max = trayWidth(card);
+          var x = baseX + dx;
+          // Clamp with light rubber-banding past the edges.
+          if (x > 0) x = x * 0.2;
+          if (x < -max) x = -max + (x + max) * 0.2;
+          currentX = x;
+          setOffset(card, x);
+        });
+
+        function endDrag(e) {
+          if (e.pointerId !== pointerId) return;
+          pointerId = null;
+          if (axis !== 'x') return;
+          card.classList.remove('dragging');
+          // Swiping only reveals or hides the tray; it never triggers an action.
+          setOpen(card, -currentX > trayWidth(card) * OPEN_THRESHOLD, false);
+        }
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+
+        // Suppress the click that follows a drag so "View Details" isn't followed.
+        content.addEventListener('click', function (e) {
+          if (didDrag) {
+            e.preventDefault();
+            e.stopPropagation();
+            didDrag = false;
+            return;
+          }
+          // Tapping the card body while open simply closes the tray.
+          if (card.classList.contains('is-open') && !e.target.closest('.swipe-toggle')) {
+            e.preventDefault();
+            setOpen(card, false);
+          }
+        }, true);
+
+        content.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        // Button fallback for mouse and keyboard users.
+        toggle.addEventListener('click', function () {
+          setOpen(card, !card.classList.contains('is-open'), true);
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && card.classList.contains('is-open')) {
+            setOpen(card, false);
+            toggle.focus();
+          }
+        });
+      });
+
+      // Favorite toggles (persisted locally).
+      var favorites = loadFavorites();
+      document.querySelectorAll('[data-favorite]').forEach(function (btn) {
+        var slug = btn.getAttribute('data-favorite');
+        function render() {
+          var on = favorites.indexOf(slug) !== -1;
+          btn.setAttribute('aria-pressed', String(on));
+          btn.querySelector('.icon').innerHTML = on ? '&#9829;' : '&#9825;';
+          btn.querySelector('.fav-label').textContent = on ? 'Favorited' : 'Favorite';
+        }
+        render();
+        btn.addEventListener('click', function () {
+          var i = favorites.indexOf(slug);
+          if (i === -1) favorites.push(slug); else favorites.splice(i, 1);
+          saveFavorites(favorites);
+          render();
+        });
+      });
+
+      // Close an open tray when interacting elsewhere.
+      document.addEventListener('pointerdown', function (e) {
+        if (openCard && !openCard.contains(e.target)) setOpen(openCard, false);
+      });
+
+      window.addEventListener('resize', function () {
+        if (openCard) setOffset(openCard, -trayWidth(openCard));
+      });
+    })();
+  </script>
+
