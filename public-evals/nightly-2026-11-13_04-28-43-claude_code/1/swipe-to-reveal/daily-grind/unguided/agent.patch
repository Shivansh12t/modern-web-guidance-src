+
+    .swipe-content {
+      position: relative;
+      z-index: 1;
+      background: white;
+      padding: 20px;
+      text-align: center;
+      transform: translateX(0);
+      transition: transform 0.25s ease;
+      will-change: transform;
+      user-select: none;
+      -webkit-user-select: none;
+    }
+
+    .swipe-card.dragging .swipe-content {
+      transition: none;
+    }
+
+    .swipe-toggle {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      width: 32px;
+      height: 32px;
+      border: 0;
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .swipe-toggle:hover,
+    .swipe-toggle:focus-visible {
+      background: var(--secondary);
+    }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 10px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .swipe-content { transition: none; }
+    }
+
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
