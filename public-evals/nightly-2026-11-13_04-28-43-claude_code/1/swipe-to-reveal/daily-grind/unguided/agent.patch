+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      width: 84px;
+      border: 0;
+      padding: 0 8px;
+      font: inherit;
+      font-size: 0.8rem;
+      font-weight: 600;
+      color: white;
+      text-decoration: none;
+      cursor: pointer;
+      background: var(--primary);
+      transition: filter 0.2s;
+    }
+
+    .swipe-action:hover,
