+  <script>
+    // Detect whether the page was opened in a background tab during initial load.
+    (() => {
+      if ('VisibilityStateEntry' in window) {
+        // Preferred: the performance timeline records visibility history from
+        // navigation start, regardless of when this script executes.
+        const entries = performance.getEntriesByType('visibility-state');
+        const firstHidden = entries.find((entry) => entry.name === 'hidden');
+        console.log({
+          backgrounded: entries.length > 0 && entries[0].name === 'hidden',
+          // High-resolution time (ms since navigation start) the page was first
+          // hidden, or null if it has not been hidden.
+          timestamp: firstHidden ? firstHidden.startTime : null,
+        });
+        return;
+      }
+
+      // Fallback for browsers without VisibilityStateEntry (e.g. Firefox, Safari).
+      const backgrounded = document.visibilityState === 'hidden';
+      console.log({
+        backgrounded,
+        // Approximate: assume hidden since load (0) if hidden right now.
+        timestamp: backgrounded ? 0 : null,
+        note:
+          'VisibilityStateEntry is unsupported; fell back to document.visibilityState, ' +
+          'which is unreliable for async scripts: if the tab was foregrounded before ' +
+          'this script ran, an initial background load will be missed, and timestamps ' +
+          'are approximate.',
+      });
+    })();
+  </script>
+
 </body>
 
