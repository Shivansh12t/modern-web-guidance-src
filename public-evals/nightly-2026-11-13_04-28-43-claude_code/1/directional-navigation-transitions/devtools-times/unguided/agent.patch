+import { useState } from 'react';
+import type { KeyboardEvent } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStory {
+  id: string;
+  title: string;
+  summary?: string;
+  date: string;
+  href: string;
+}
+
+interface Props {
+  stories: TopStory[];
+}
+
+type Direction = 'next' | 'prev';
+
+export default function TopStoriesCarousel({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  // null until the first interaction so the initial render isn't animated.
+  const [direction, setDirection] = useState<Direction | null>(null);
+  // Bumped on every change so the slide remounts and the animation replays.
+  const [changeCount, setChangeCount] = useState(0);
+
+  const count = stories.length;
+  if (count === 0) return null;
+
+  const go = (dir: Direction) => {
+    setDirection(dir);
+    setIndex((i) => (dir === 'next' ? (i + 1) % count : (i - 1 + count) % count));
+    setChangeCount((c) => c + 1);
+  };
+
+  const onKeyDown = (e: KeyboardEvent<HTMLElement>) => {
+    if (count < 2) return;
+    if (e.key === 'ArrowRight') {
+      e.preventDefault();
+      go('next');
+    } else if (e.key === 'ArrowLeft') {
+      e.preventDefault();
+      go('prev');
+    }
+  };
+
+  const story = stories[index];
+  const animationClass =
+    direction === 'next' ? 'top-story-slide-from-right' : direction === 'prev' ? 'top-story-slide-from-left' : '';
+
+  const buttonClass =
+    'shrink-0 rounded-full border border-gray-300 p-2 text-gray-700 hover:border-amber-400 hover:text-amber-400 ' +
+    'focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 transition-colors';
+
+  return (
+    <section
+      aria-roledescription="carousel"
+      aria-label="Top stories"
+      onKeyDown={onKeyDown}
+      className="flex items-center gap-4"
+    >
+      {count > 1 && (
+        <button type="button" onClick={() => go('prev')} className={buttonClass} aria-label="Previous story">
+          <ChevronLeftIcon className="h-5 w-5" />
+        </button>
+      )}
+
+      <div className="relative flex-1 min-w-0 overflow-hidden" aria-live="polite" aria-atomic="true">
+        <div
+          key={changeCount}
+          className={animationClass}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${index + 1} of ${count}`}
+        >
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer truncate">{story.title}</h3>
+          </a>
+          <div className="flex items-center gap-2 text-xs text-gray-500">
+            <span>{story.date}</span>
+            {count > 1 && (
+              <>
+                <span aria-hidden="true">·</span>
+                <span>
+                  {index + 1} / {count}
+                </span>
+              </>
+            )}
+          </div>
+        </div>
+      </div>
+
+      {count > 1 && (
+        <button type="button" onClick={() => go('next')} className={buttonClass} aria-label="Next story">
+          <ChevronRightIcon className="h-5 w-5" />
+        </button>
+      )}
+    </section>
+  );
+}
