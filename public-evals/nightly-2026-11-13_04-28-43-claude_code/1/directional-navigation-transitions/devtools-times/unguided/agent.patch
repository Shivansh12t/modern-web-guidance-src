+/* Top Stories carousel: slide direction mirrors navigation direction */
+@keyframes top-story-in-from-right {
+  from { transform: translateX(100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+@keyframes top-story-in-from-left {
+  from { transform: translateX(-100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+.top-story-slide-from-right {
+  animation: top-story-in-from-right 350ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+.top-story-slide-from-left {
+  animation: top-story-in-from-left 350ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .top-story-slide-from-right,
+  .top-story-slide-from-left {
+    animation-duration: 1ms;
+  }
+}
