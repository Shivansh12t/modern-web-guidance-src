index 0000000..85227e8
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,188 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+const total = articles.length;
+---
+
+<section
+    class="top-stories bg-white border-b border-gray-300"
+    aria-roledescription="carousel"
+    aria-label="Top stories"
+    data-top-stories
+>
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-3">
+        <button
+            type="button"
+            class="shrink-0 rounded-full border border-gray-300 w-9 h-9 grid place-items-center text-gray-700 hover:text-amber-400 hover:border-amber-400 transition-colors focus-visible:outline-2 focus-visible:outline-amber-400"
+            aria-label="Previous story"
+            data-carousel-prev
+        >
+            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
+                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
+            </svg>
+        </button>
+
+        <!-- The viewport clips its overflow and is the scope of the slide transition -->
+        <div class="top-stories-viewport relative flex-1 min-w-0 overflow-clip" aria-live="polite">
+            {articles.map((article, index) => (
+                <div
+                    class="top-stories-slide"
+                    role="group"
+                    aria-roledescription="slide"
+                    aria-label={`${index + 1} of ${total}`}
+                    data-carousel-slide
+                    hidden={index !== 0}
+                >
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer truncate">{article.data.title}</h3>
+                    </a>
+                    <span class="text-xs text-gray-500">
+                        {article.data.date.toLocaleDateString()}
+                        <span class="ml-2 text-gray-400">{index + 1} / {total}</span>
+                    </span>
+                </div>
+            ))}
+        </div>
+
+        <button
+            type="button"
+            class="shrink-0 rounded-full border border-gray-300 w-9 h-9 grid place-items-center text-gray-700 hover:text-amber-400 hover:border-amber-400 transition-colors focus-visible:outline-2 focus-visible:outline-amber-400"
+            aria-label="Next story"
+            data-carousel-next
+        >
+            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
+                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
+            </svg>
+        </button>
+    </div>
+</section>
+
+<style is:global>
+    @keyframes top-stories-slide-to-left {
+        to { transform: translateX(-100%); }
+    }
+    @keyframes top-stories-slide-from-right {
+        from { transform: translateX(100%); }
+    }
+    @keyframes top-stories-slide-to-right {
+        to { transform: translateX(100%); }
+    }
+    @keyframes top-stories-slide-from-left {
+        from { transform: translateX(-100%); }
+    }
+
+    /* Element-scoped view transition: the viewport is the scope and is captured as `root`. */
+    @media (prefers-reduced-motion: no-preference) {
+        .top-stories-viewport::view-transition-old(root),
+        .top-stories-viewport::view-transition-new(root) {
+            animation-duration: 0.4s;
+            animation-timing-function: ease-in-out;
+            animation-fill-mode: both;
+        }
+
+        .top-stories-viewport:active-view-transition-type(next)::view-transition-old(root) {
+            animation-name: top-stories-slide-to-left;
+        }
+        .top-stories-viewport:active-view-transition-type(next)::view-transition-new(root) {
+            animation-name: top-stories-slide-from-right;
+        }
+
+        .top-stories-viewport:active-view-transition-type(previous)::view-transition-old(root) {
+            animation-name: top-stories-slide-to-right;
+        }
+        .top-stories-viewport:active-view-transition-type(previous)::view-transition-new(root) {
+            animation-name: top-stories-slide-from-left;
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .top-stories-viewport::view-transition-group(*),
+        .top-stories-viewport::view-transition-old(*),
+        .top-stories-viewport::view-transition-new(*) {
+            animation: none !important;
+        }
+    }
+</style>
+
+<script>
+    type Direction = 'next' | 'previous';
+
+    const supportsScopedTransition =
+        typeof Element !== 'undefined' && 'startViewTransition' in Element.prototype;
+
+    function initCarousel(root: HTMLElement) {
+        if (root.dataset.carouselReady) return;
+        root.dataset.carouselReady = 'true';
+
+        const viewport = root.querySelector<HTMLElement>('.top-stories-viewport');
+        const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
+        const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
+        const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
+        if (!viewport || slides.length === 0 || !prev || !next) return;
+
+        let current = Math.max(0, slides.findIndex((s) => !s.hidden));
+
+        const show = (index: number) => {
+            slides.forEach((slide, i) => {
+                slide.hidden = i !== index;
+            });
+            current = index;
+        };
+
+        // Fallback for browsers without element-scoped view transitions:
+        // slide the incoming story in with the Web Animations API.
+        const fallbackAnimate = (index: number, direction: Direction) => {
+            show(index);
+            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+            slides[index].animate(
+                [
+                    { transform: `translateX(${direction === 'next' ? '100%' : '-100%'})` },
+                    { transform: 'translateX(0)' },
+                ],
+                { duration: 400, easing: 'ease-in-out' },
+            );
+        };
+
+        const go = (direction: Direction) => {
+            const offset = direction === 'next' ? 1 : -1;
+            const index = (current + offset + slides.length) % slides.length;
+
+            if (!supportsScopedTransition) {
+                fallbackAnimate(index, direction);
+                return;
+            }
+
+            const transition = (viewport as any).startViewTransition({
+                update: () => show(index),
+                types: [direction],
+            });
+            // Rapid clicks skip the running transition and reject `ready`.
+            transition.ready.catch(() => {});
+        };
+
+        prev.addEventListener('click', () => go('previous'));
+        next.addEventListener('click', () => go('next'));
+
+        root.addEventListener('keydown', (event) => {
+            if (event.key === 'ArrowRight') {
+                event.preventDefault();
+                go('next');
+            } else if (event.key === 'ArrowLeft') {
+                event.preventDefault();
+                go('previous');
+            }
+        });
+    }
+
+    const initAll = () => {
+        document.querySelectorAll<HTMLElement>('[data-top-stories]').forEach(initCarousel);
+    };
+
+    // ClientRouter swaps pages without a full reload, so re-init on every page load.
+    document.addEventListener('astro:page-load', initAll);
+</script>
