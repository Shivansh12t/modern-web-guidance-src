+  <script>
+    (function () {
+      var root = document.getElementById('seasonal-carousel');
+      if (!root) return;
+
+      var cards = Array.prototype.slice.call(root.querySelectorAll('.carousel-track .card'));
+      var status = root.querySelector('.carousel-status');
+      var ANIM_CLASSES = ['slide-in-from-right', 'slide-in-from-left', 'slide-out-to-left', 'slide-out-to-right'];
+      var current = 0;
+
+      function clearAnimation(card) {
+        ANIM_CLASSES.forEach(function (c) { card.classList.remove(c); });
+        card.classList.remove('is-leaving');
+      }
+
+      function setActive(index) {
+        cards.forEach(function (card, i) {
+          var active = i === index;
+          card.classList.toggle('is-active', active);
+          card.setAttribute('aria-hidden', active ? 'false' : 'true');
+          card.setAttribute('aria-label', (i + 1) + ' of ' + cards.length);
+          card.setAttribute('role', 'group');
+          card.setAttribute('aria-roledescription', 'slide');
+        });
+        status.textContent = (index + 1) + ' / ' + cards.length;
+      }
+
+      // direction: 1 = next (enter from right), -1 = previous (enter from left)
+      function go(direction) {
+        if (cards.length < 2) return;
+        var next = (current + direction + cards.length) % cards.length;
+        var outgoing = cards[current];
+        var incoming = cards[next];
+
+        // If the user clicks mid-animation, snap any in-flight slides to their end state.
+        cards.forEach(clearAnimation);
+        void root.offsetWidth; // force reflow so re-applied animation classes restart
+
+        outgoing.classList.add('is-leaving', direction > 0 ? 'slide-out-to-left' : 'slide-out-to-right');
+        incoming.classList.add(direction > 0 ? 'slide-in-from-right' : 'slide-in-from-left');
+
+        current = next;
+        setActive(current);
+      }
+
+      cards.forEach(function (card) {
+        card.addEventListener('animationend', function () { clearAnimation(card); });
+      });
+
+      root.querySelector('[data-dir="next"]').addEventListener('click', function () { go(1); });
+      root.querySelector('[data-dir="prev"]').addEventListener('click', function () { go(-1); });
+
+      root.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowRight') { go(1); }
+        else if (e.key === 'ArrowLeft') { go(-1); }
+      });
+
+      setActive(current);
+    })();
+  </script>
+
