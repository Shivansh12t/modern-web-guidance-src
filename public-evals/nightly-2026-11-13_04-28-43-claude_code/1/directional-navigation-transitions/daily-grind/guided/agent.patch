+    /* Seasonal carousel */
+    .carousel {
+      max-width: 480px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      overflow: clip;
+      border-radius: 8px;
+      padding: 6px; /* room for the card shadow inside the clip */
+    }
+
+    .carousel-viewport .card {
+      view-transition-name: seasonal-card;
+    }
+
+    .carousel-viewport .card[hidden] {
+      display: none;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-top: 12px;
+    }
+
+    .carousel-controls[hidden] {
+      display: none;
+    }
+
+    .carousel-btn {
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding: 8px 18px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .carousel-btn:hover {
+      background: #3e2723;
+    }
+
+    .carousel-btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+    }
+
+    @keyframes slide-to-left {
+      to { transform: translateX(-100%); opacity: 0; }
+    }
+
+    @keyframes slide-from-right {
+      from { transform: translateX(100%); opacity: 0; }
+    }
+
+    @keyframes slide-to-right {
+      to { transform: translateX(100%); opacity: 0; }
+    }
+
+    @keyframes slide-from-left {
+      from { transform: translateX(-100%); opacity: 0; }
+    }
+
+    ::view-transition-group(seasonal-card) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+    }
+
+    ::view-transition-old(seasonal-card),
+    ::view-transition-new(seasonal-card) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+    }
+
+    /* Matches the transition scope (the viewport, or html in the document fallback) */
+    :active-view-transition-type(forward)::view-transition-old(seasonal-card) {
+      animation-name: slide-to-left;
+    }
+
+    :active-view-transition-type(forward)::view-transition-new(seasonal-card) {
+      animation-name: slide-from-right;
+    }
+
+    :active-view-transition-type(backward)::view-transition-old(seasonal-card) {
+      animation-name: slide-to-right;
+    }
+
+    :active-view-transition-type(backward)::view-transition-new(seasonal-card) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
