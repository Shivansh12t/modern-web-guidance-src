+  <script>
+    (() => {
+      const carousel = document.getElementById('seasonal-carousel');
+      const viewport = carousel.querySelector('.carousel-viewport');
+      const slides = [...viewport.querySelectorAll('.card')];
+      const controls = carousel.querySelector('.carousel-controls');
+      const status = carousel.querySelector('.carousel-status');
+      let index = 0;
+
+      const render = () => {
+        slides.forEach((slide, i) => { slide.hidden = i !== index; });
+        status.textContent = `${index + 1} of ${slides.length}: ${slides[index].querySelector('h3').textContent}`;
+      };
+
+      const go = (direction) => {
+        const step = direction === 'forward' ? 1 : -1;
+        const update = () => {
+          index = (index + step + slides.length) % slides.length;
+          render();
+        };
+
+        let transition;
+        if ('startViewTransition' in Element.prototype) {
+          // Scoped to the carousel so the rest of the page stays interactive and the slide is clipped
+          transition = viewport.startViewTransition({ update, types: [direction] });
+        } else if (document.startViewTransition) {
+          transition = document.startViewTransition({ update, types: [direction] });
+        } else {
+          update();
+          return;
+        }
+        // Rapid clicks skip the in-flight transition; swallow the resulting rejection
+        transition.ready.catch(() => {});
+      };
+
+      controls.addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-dir]');
+        if (btn) go(btn.dataset.dir);
+      });
+
+      controls.hidden = false;
+      render();
+    })();
+  </script>
