@@ -114,8 +114,56 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Cards with an image automatically switch to a side-by-side layout */
+    .card:has(> img) {
+      display: grid;
+      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
+      align-items: center;
+      gap: 20px;
+      padding: 0;
+      overflow: hidden;
+      text-align: left;
+    }
+
+    .card > img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      min-height: 220px;
+      object-fit: cover;
+    }
+
+    .card:has(> img) > .card-body {
+      padding: 20px 20px 20px 0;
+    }
+
+    /* Give image cards extra room when the grid has space for it */
+    @media (min-width: 640px) {
+      .grid > .card:has(> img) {
+        grid-column: span 2;
+      }
+    }
+
+    /* Stack image and text on very narrow screens */
+    @media (max-width: 480px) {
+      .card:has(> img) {
+        grid-template-columns: 1fr;
+        gap: 0;
+        text-align: center;
+      }
+
+      .card > img {
+        height: 200px;
+        min-height: 0;
+      }
+
+      .card:has(> img) > .card-body {
+        padding: 20px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
