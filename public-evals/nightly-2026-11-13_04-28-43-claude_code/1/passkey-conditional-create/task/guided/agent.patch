+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const statusEl = document.getElementById('signin-status');
+    const submitBtn = form.querySelector('[data-testid="signin-button"]');
+    const passwordInput = document.getElementById('current-password');
+
+    document.getElementById('show-password').addEventListener('change', (e) => {
+      passwordInput.type = e.target.checked ? 'text' : 'password';
+    });
+
+    function setStatus(message, isError = false) {
+      statusEl.textContent = message;
+      statusEl.classList.toggle('error', isError);
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      setStatus('');
+      submitBtn.disabled = true;
+
+      try {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({
+            email: form.email.value.trim(),
+            password: form.password.value,
+          }),
+        });
+
+        if (!response.ok) {
+          setStatus('Incorrect email or password. Please try again.', true);
+          return;
+        }
+
+        // Full password sign-in succeeded and the session is active.
+        // If the server requires more factors, it should indicate it and we stop here.
+        const result = await response.json().catch(() => ({}));
+        if (result?.mfaRequired) {
+          setStatus('Additional verification required.');
+          return;
+        }
+
+        setStatus('Signed in. Welcome back!');
+        form.reset();
+
+        // Fire-and-forget: never block or surface UI for passkey upgrade.
+        silentlyRegisterPasskey().catch(() => {});
+      } catch {
+        setStatus('Unable to sign in right now. Please try again.', true);
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+
+    /**
+     * Ensures getClientCapabilities / parseCreationOptionsFromJSON / toJSON exist
+     * in browsers that support WebAuthn but not these newer helpers.
+     */
+    async function ensureWebAuthnHelpers() {
+      if (
+        typeof PublicKeyCredential.getClientCapabilities === 'function' &&
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function' &&
+        typeof PublicKeyCredential.prototype.toJSON === 'function'
+      ) {
+        return;
+      }
+      await import('webauthn-polyfills');
+    }
+
+    async function signalOrphanedCredential(rpId, credentialId) {
+      if (!rpId || typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch {
+        // Best-effort cleanup only.
+      }
+    }
+
+    /**
+     * Conditional Create: silently register a passkey after a successful password sign-in.
+     * No dialogs, no error UI — every failure path returns quietly.
+     */
+    async function silentlyRegisterPasskey() {
+      if (!window.isSecureContext || typeof window.PublicKeyCredential === 'undefined') return;
+
+      try {
+        await ensureWebAuthnHelpers();
+      } catch {
+        return;
+      }
+
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch {
+        return;
+      }
+      if (capabilities?.conditionalCreate !== true) return;
+
+      // Fetch creation options; the server should include rp.id and excludeCredentials,
+      // and remember this is a conditional request so verification can relax user presence.
+      let publicKey;
+      try {
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ conditional: true }),
+        });
+        if (!optionsResponse.ok) return;
+        const creationOptionsJSON = await optionsResponse.json();
+        publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      } catch {
+        return;
+      }
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+      } catch (e) {
+        if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e?.name)) {
+          console.debug('Conditional passkey creation failed:', e);
+        }
+        return;
+      }
+      if (!credential) return;
+
+      const encodedResponse = credential.toJSON();
+      // Always use the server-provided RP ID, never window.location.hostname.
+      const rpId = publicKey.rp?.id;
+
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(encodedResponse),
+        });
+        if (!verifyResponse.ok) {
+          await signalOrphanedCredential(rpId, encodedResponse.id);
+        }
+      } catch {
+        await signalOrphanedCredential(rpId, encodedResponse.id);
+      }
+    }
+  </script>
+
