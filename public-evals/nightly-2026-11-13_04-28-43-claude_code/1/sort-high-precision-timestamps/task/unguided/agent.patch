+    { "id": "evt-1001", "service": "mobile-app",       "orderId": "ORD-5521", "type": "order.placed",         "timestamp": "2026-11-13T08:15:02.481203550Z" },
+    { "id": "evt-1006", "service": "barista-station",  "orderId": "ORD-5522", "type": "drink.started",        "timestamp": "2026-11-13T08:15:09.000000001Z" },
+    { "id": "evt-1002", "service": "pos-terminal",     "orderId": "ORD-5522", "type": "order.placed",         "timestamp": "2026-11-13T08:15:02.481203551Z" },
+    { "id": "evt-1008", "service": "barista-station",  "orderId": "ORD-5521", "type": "drink.completed",      "timestamp": "2026-11-13T08:15:31.274000000Z" },
+    { "id": "evt-1005", "service": "barista-station",  "orderId": "ORD-5521", "type": "drink.started",        "timestamp": "2026-11-13T08:15:09.000000000Z" },
+    { "id": "evt-1004", "service": "payment-gateway",  "orderId": "ORD-5522", "type": "payment.authorized",   "timestamp": "2026-11-13T08:15:02.482000250Z" },
+    { "id": "evt-1010", "service": "barista-station",  "orderId": "ORD-5522", "type": "drink.completed",      "timestamp": "2026-11-13T08:15:47.902114387Z" },
+    { "id": "evt-1007", "service": "inventory-service","orderId": "ORD-5521", "type": "inventory.reserved",   "timestamp": "2026-11-13T08:15:09.000000000Z" },
+    { "id": "evt-1011", "service": "pickup-service",   "orderId": "ORD-5522", "type": "order.picked_up",      "timestamp": "2026-11-13T08:16:05.5Z" },
+    { "id": "evt-1000", "service": "loyalty-service",  "orderId": "ORD-5521", "type": "rewards.session_open", "timestamp": "2026-11-13T08:14:59.999999999Z" }
+  ]
+  </script>
+
+  <script>
+    (function () {
+      'use strict';
+
+      const NS_PER_SECOND = 1000000000n;
+      const NS_PER_MS = 1000000n;
+      const NS_PER_US = 1000n;
+
+      // RFC 3339 timestamp with up to 9 fractional digits; "Z" or a numeric offset.
+      const RFC3339 = /^(\d{4})-(\d{2})-(\d{2})[Tt ](\d{2}):(\d{2}):(\d{2})(?:\.(\d{1,9}))?([Zz]|[+-]\d{2}:\d{2})$/;
+
+      /**
+       * Parse a timestamp into BigInt nanoseconds since the Unix epoch.
+       * JS Date / Number only hold millisecond (and ~microsecond) precision, so the
+       * whole-second part and the fractional nanoseconds are combined as BigInt.
+       * Also accepts an all-digit string of epoch nanoseconds.
+       */
+      function parseTimestampNs(value) {
+        if (typeof value === 'bigint') return value;
+        if (typeof value !== 'string') {
+          throw new Error('Timestamp must be a string to preserve nanosecond precision: ' + value);
+        }
+        const trimmed = value.trim();
+        if (/^-?\d+$/.test(trimmed)) return BigInt(trimmed);
+
+        const m = RFC3339.exec(trimmed);
+        if (!m) throw new Error('Unrecognized timestamp format: ' + value);
+        const [, y, mo, d, h, mi, s, frac = '', tz] = m;
+
+        const month = Number(mo), day = Number(d), hour = Number(h), minute = Number(mi), second = Number(s);
+        if (month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 || second > 60) {
+          throw new Error('Out-of-range timestamp field: ' + value);
+        }
+        // Leap second (":60") is folded onto the next second's start, matching most clock libraries.
+        const epochMs = Date.UTC(Number(y), month - 1, day, hour, minute, 0) + second * 1000;
+        if (!Number.isFinite(epochMs)) throw new Error('Invalid timestamp: ' + value);
+
+        let ns = BigInt(epochMs) * NS_PER_MS + BigInt(frac.padEnd(9, '0') || '0');
+
+        if (tz !== 'Z' && tz !== 'z') {
+          const sign = tz[0] === '-' ? -1n : 1n;
+          const offsetMinutes = BigInt(Number(tz.slice(1, 3)) * 60 + Number(tz.slice(4, 6)));
+          ns -= sign * offsetMinutes * 60n * NS_PER_SECOND;
+        }
+        return ns;
+      }
+
+      /** Format BigInt epoch nanoseconds as an RFC 3339 UTC string with 9 fractional digits. */
+      function formatTimestampNs(ns) {
+        let seconds = ns / NS_PER_SECOND;
+        let nanos = ns % NS_PER_SECOND;
+        if (nanos < 0n) { nanos += NS_PER_SECOND; seconds -= 1n; }
+        const iso = new Date(Number(seconds) * 1000).toISOString(); // YYYY-MM-DDTHH:MM:SS.000Z
+        return iso.slice(0, 19) + '.' + nanos.toString().padStart(9, '0') + 'Z';
+      }
+
+      /** Exact human-readable duration from BigInt nanoseconds (no floating-point rounding). */
+      function formatDurationNs(ns) {
+        const neg = ns < 0n;
+        let abs = neg ? -ns : ns;
+        let unit, divisor;
+        if (abs >= NS_PER_SECOND) { unit = 's'; divisor = NS_PER_SECOND; }
+        else if (abs >= NS_PER_MS) { unit = 'ms'; divisor = NS_PER_MS; }
+        else if (abs >= NS_PER_US) { unit = 'µs'; divisor = NS_PER_US; }
+        else return (neg ? '-' : '') + abs.toString() + ' ns';
+
+        const whole = abs / divisor;
+        const digits = divisor.toString().length - 1;
+        const frac = (abs % divisor).toString().padStart(digits, '0').replace(/0+$/, '');
+        return (neg ? '-' : '') + whole.toString() + (frac ? '.' + frac : '') + ' ' + unit;
+      }
+
+      function groupDigits(ns) {
+        return ns.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+      }
+
+      /**
+       * Sort events chronologically by BigInt nanosecond timestamp and compute the
+       * interval to the previous event. Ties keep their original arrival order
+       * (stable sort), then fall back to event id for determinism.
+       */
+      function sortAndMeasure(rawEvents) {
+        const parsed = rawEvents.map((event, index) => ({
+          ...event,
+          index,
+          ns: parseTimestampNs(event.timestamp),
+        }));
+
+        parsed.sort((a, b) => {
+          if (a.ns < b.ns) return -1;
+          if (a.ns > b.ns) return 1;
+          return a.index - b.index;
+        });
+
+        let prev = null;
+        const intervals = [];
+        for (const event of parsed) {
+          event.deltaNs = prev ? event.ns - prev.ns : null;
+          if (event.deltaNs !== null) intervals.push(event.deltaNs);
+          prev = event;
+        }
+
+        const stats = { count: parsed.length };
+        if (parsed.length) {
+          stats.spanNs = parsed[parsed.length - 1].ns - parsed[0].ns;
+        }
+        if (intervals.length) {
+          stats.minNs = intervals.reduce((m, v) => (v < m ? v : m));
+          stats.maxNs = intervals.reduce((m, v) => (v > m ? v : m));
+          stats.meanNs = intervals.reduce((s, v) => s + v, 0n) / BigInt(intervals.length);
+          stats.ties = intervals.filter((v) => v === 0n).length;
+          stats.subMs = intervals.filter((v) => v > 0n && v < NS_PER_MS).length;
+        }
+        return { events: parsed, stats };
+      }
+
+      function loadBatch() {
+        const node = document.getElementById('order-events-batch');
+        const data = JSON.parse(node.textContent);
+        if (!Array.isArray(data)) throw new Error('Event batch must be an array');
+        return data;
+      }
+
+      function el(tag, props, children) {
+        const node = document.createElement(tag);
+        if (props) Object.assign(node, props);
+        (children || []).forEach((c) => node.append(c));
+        return node;
+      }
+
+      function statCard(label, value, title) {
+        return el('div', { className: 'card' }, [
+          el('h3', { textContent: label }),
+          el('div', { className: 'stat', textContent: value, title: title || '' }),
+        ]);
+      }
+
+      function render(result, output) {
+        const { events, stats } = result;
+        output.replaceChildren();
+
+        if (!events.length) {
+          output.append(el('p', { textContent: 'No events in this batch.' }));
+          return;
+        }
+
+        const summary = el('div', { className: 'events-summary' }, [
+          statCard('Events', String(stats.count)),
+          statCard('Total Span', formatDurationNs(stats.spanNs), groupDigits(stats.spanNs) + ' ns'),
+        ]);
+        if (stats.minNs !== undefined) {
+          summary.append(
+            statCard('Shortest Gap', formatDurationNs(stats.minNs), groupDigits(stats.minNs) + ' ns'),
+            statCard('Longest Gap', formatDurationNs(stats.maxNs), groupDigits(stats.maxNs) + ' ns'),
+            statCard('Mean Gap', formatDurationNs(stats.meanNs), groupDigits(stats.meanNs) + ' ns (truncated)'),
+            statCard('Sub-ms Gaps / Ties', stats.subMs + ' / ' + stats.ties)
+          );
+        }
+
+        const headers = ['#', 'Timestamp (UTC, ns)', 'Interval', 'Interval (ns)', 'Service', 'Order', 'Event', 'Arrived'];
+        const thead = el('thead', null, [el('tr', null, headers.map((h) => el('th', { textContent: h, scope: 'col' })))]);
+        const tbody = el('tbody');
+        events.forEach((event, i) => {
+          const tie = event.deltaNs === 0n;
+          const row = el('tr', { className: tie ? 'tie' : '' }, [
+            el('td', { textContent: String(i + 1) }),
+            el('td', { className: 'mono', textContent: formatTimestampNs(event.ns), title: 'Original: ' + event.timestamp }),
+            el('td', { className: 'mono num delta', textContent: event.deltaNs === null ? '—' : (tie ? '0 ns (tie)' : formatDurationNs(event.deltaNs)) }),
+            el('td', { className: 'mono num', textContent: event.deltaNs === null ? '—' : groupDigits(event.deltaNs) }),
+            el('td', { textContent: event.service }),
+            el('td', { textContent: event.orderId }),
+            el('td', { className: 'mono', textContent: event.type }),
+            el('td', { className: 'num', textContent: '#' + (event.index + 1) }),
+          ]);
+          tbody.append(row);
+        });
+
+        output.append(summary, el('div', { className: 'table-wrap' }, [el('table', { className: 'events-table' }, [thead, tbody])]));
+      }
+
+      const button = document.getElementById('load-events-btn');
+      const output = document.getElementById('events-output');
+
+      button.addEventListener('click', function () {
+        button.disabled = true;
+        try {
+          render(sortAndMeasure(loadBatch()), output);
+          button.textContent = 'Reload & Sort Order Events';
+        } catch (err) {
+          output.replaceChildren(el('p', { className: 'events-error', textContent: 'Could not process events: ' + err.message }));
+        } finally {
+          button.disabled = false;
+        }
+      });
+
+      // Exposed for testing / console use.
+      window.DailyGrindEvents = { parseTimestampNs, formatTimestampNs, formatDurationNs, sortAndMeasure };
+    })();
+  </script>
+
