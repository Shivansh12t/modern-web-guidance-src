+  <!-- Batch of order events as collected from backend services (unordered, nanosecond UTC timestamps). -->
+  <script type="application/json" id="order-events-batch">
+  [
+    { "id": "evt-1009", "service": "pickup-service",   "orderId": "ORD-5521", "type": "order.picked_up",      "timestamp": "2026-11-13T08:15:47.902114387Z" },
