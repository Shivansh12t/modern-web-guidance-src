+  <script type="module">
+    // Temporal fallback: load the polyfill only when the browser lacks native support.
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal === 'undefined') {
+        const mod = await import('https://esm.sh/temporal-polyfill@1.0.8');
+        globalThis.Temporal = mod.Temporal;
+      }
+      return globalThis.Temporal;
+    }
+
+    // Duration.toLocaleString() uses Intl.DurationFormat. If that's missing, build a
+    // compact label from the Duration's own fields, which never turns it into a lossy Number.
+    function formatDuration(duration) {
+      if (duration.blank) return '0ns';
+      if (typeof Intl.DurationFormat === 'function') {
+        return duration.toLocaleString(undefined, { style: 'narrow' });
+      }
+      const units = [
+        ['hours', 'h'], ['minutes', 'm'], ['seconds', 's'],
+        ['milliseconds', 'ms'], ['microseconds', 'μs'], ['nanoseconds', 'ns'],
+      ];
+      return units.filter(([u]) => duration[u] !== 0).map(([u, l]) => `${duration[u]}${l}`).join(' ');
+    }
+
+    const btn = document.getElementById('load-events-btn');
+    const status = document.getElementById('timeline-status');
+    const output = document.getElementById('timeline-output');
+
+    function cell(row, text, className) {
+      const td = row.insertCell();
+      td.textContent = text;
+      if (className) td.className = className;
+      return td;
+    }
+
+    function render(batchId, sorted) {
+      const table = document.createElement('table');
+      table.className = 'timeline-table';
+      table.createCaption().textContent = `Batch ${batchId}: ${sorted.length} events in chronological order`;
+
+      const headRow = table.createTHead().insertRow();
+      for (const label of ['#', 'Timestamp (UTC, ns)', 'Service', 'Event', 'Order', 'Since previous']) {
+        const th = document.createElement('th');
+        th.scope = 'col';
+        th.textContent = label;
+        headRow.append(th);
+      }
+
+      const tbody = table.createTBody();
+      sorted.forEach((evt, i) => {
+        const row = tbody.insertRow();
+        if (evt.tie) row.className = 'tie';
+        cell(row, String(i + 1));
+        cell(row, evt.instant.toString({ fractionalSecondDigits: 9 }), 'mono');
+        cell(row, evt.service);
+        cell(row, evt.type);
+        cell(row, evt.orderId);
+        cell(row, evt.gap ? (evt.tie ? '0ns (same instant)' : formatDuration(evt.gap)) : '—', 'mono');
+      });
+
+      output.replaceChildren(table);
+    }
+
+    btn.addEventListener('click', async () => {
+      btn.disabled = true;
+      status.classList.remove('error');
+      status.textContent = 'Loading order events…';
+      try {
+        const [Temporal, res] = await Promise.all([ensureTemporal(), fetch('data/order-events.json')]);
+        if (!res.ok) throw new Error(`HTTP ${res.status}`);
+        const { batchId, events } = await res.json();
+
+        // Parse with Temporal.Instant, not Date: Date drops everything below the millisecond.
+        const parsed = events.map(evt => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }));
+
+        // Sort by the full nanosecond value. Break exact ties by event id so the order is deterministic.
+        const sorted = parsed.toSorted((a, b) =>
+          Temporal.Instant.compare(a.instant, b.instant) || a.id.localeCompare(b.id));
+
+        // Interval between consecutive events, kept as an exact Temporal.Duration.
+        for (let i = 1; i < sorted.length; i++) {
+          const prev = sorted[i - 1].instant;
+          const curr = sorted[i];
+          curr.tie = curr.instant.equals(prev);
+          curr.gap = curr.instant.since(prev, { largestUnit: 'hours' });
+        }
+
+        render(batchId, sorted);
+        const total = sorted.at(-1).instant.since(sorted[0].instant, { largestUnit: 'hours' });
+        const ties = sorted.filter(e => e.tie).length;
+        status.textContent = `Sequenced ${sorted.length} events spanning ${formatDuration(total)}` +
+          (ties ? ` (${ties} with an identical timestamp, highlighted).` : '.');
+      } catch (err) {
+        status.classList.add('error');
+        status.textContent = `Could not load order events: ${err.message}`;
+      } finally {
+        btn.disabled = false;
+      }
+    });
+  </script>
+
