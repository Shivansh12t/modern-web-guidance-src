+  <script>
+    // Web App Origin Migration: the browser moves the *installation* (shortcuts,
+    // icons) via manifest `migrate_to` / `migrate_from`, but origin-bound storage
+    // is NOT transferred. User configuration is handed over here explicitly.
+    (() => {
+      const OLD_ORIGIN = 'https://dailygrind.example.com';
+      const NEW_ORIGIN = 'https://app.dailygrind.example.com';
+      const PREF_PREFIX = 'dg:';          // localStorage keys holding user preferences
+      const HANDOFF_KEY = 'dg-migrate';   // URL fragment parameter (never sent to servers)
+      const DISMISS_KEY = 'dg:migration-dismissed';
+
+      const collectPrefs = () => {
+        const prefs = {};
+        for (let i = 0; i < localStorage.length; i++) {
+          const key = localStorage.key(i);
+          if (key.startsWith(PREF_PREFIX) && key !== DISMISS_KEY) prefs[key] = localStorage.getItem(key);
+        }
+        return prefs;
+      };
+
+      if (location.origin === OLD_ORIGIN) {
+        // Old origin: point users to the new origin, carrying their preferences.
+        const banner = document.getElementById('migration-banner');
+        const link = document.getElementById('migration-link');
+        const target = new URL(location.pathname + location.search, NEW_ORIGIN);
+        const prefs = collectPrefs();
+        if (Object.keys(prefs).length) {
+          target.hash = new URLSearchParams({ [HANDOFF_KEY]: JSON.stringify(prefs) }).toString();
+        }
+        link.href = target.href;
+        if (!sessionStorage.getItem(DISMISS_KEY)) banner.hidden = false;
+        document.getElementById('migration-dismiss').addEventListener('click', () => {
+          banner.hidden = true;
+          sessionStorage.setItem(DISMISS_KEY, '1');
+        });
+      } else if (location.hash.includes(HANDOFF_KEY)) {
+        // New origin: import handed-over preferences without overwriting newer local values.
+        const params = new URLSearchParams(location.hash.slice(1));
+        try {
+          const prefs = JSON.parse(params.get(HANDOFF_KEY) || '{}');
+          for (const [key, value] of Object.entries(prefs)) {
+            if (key.startsWith(PREF_PREFIX) && typeof value === 'string' && localStorage.getItem(key) === null) {
+              localStorage.setItem(key, value);
+            }
+          }
+        } catch (err) {
+          console.warn('Could not import migrated preferences', err);
+        }
+        // Strip the handoff payload from the address bar and history.
+        params.delete(HANDOFF_KEY);
+        const rest = params.toString();
+        history.replaceState(null, '', location.pathname + location.search + (rest ? '#' + rest : ''));
+      }
+    })();
+  </script>
+
