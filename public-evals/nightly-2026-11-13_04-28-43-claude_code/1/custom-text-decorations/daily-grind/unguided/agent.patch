+    /* ===========================================================
+       Decorative text lines
+       - text-decoration-skip-ink keeps lines clear of descenders
+       - text-underline-offset sets the vertical offset
+       - text-decoration-inset trims the line's horizontal ends
+         (progressively enhanced; color/offset animate everywhere)
+       =========================================================== */
+    :root {
+      --line-ease: cubic-bezier(0.22, 1, 0.36, 1);
+      --line-speed: 0.45s;
+      /* inset large enough to fully collapse the line on short words */
+      --line-hidden-inset: 3em;
+    }
+
+    .deco-line {
+      text-decoration-line: underline;
+      text-decoration-style: solid;
+      text-decoration-thickness: 0.09em;
+      text-decoration-skip-ink: auto;
+      text-underline-position: from-font;
+      text-underline-offset: 0.3em;
+      text-decoration-color: transparent;
+      transition:
+        text-decoration-color var(--line-speed) var(--line-ease),
+        text-underline-offset var(--line-speed) var(--line-ease),
+        text-decoration-thickness var(--line-speed) var(--line-ease),
+        text-decoration-inset var(--line-speed) var(--line-ease);
+    }
+
+    @supports (text-decoration-inset: 0) {
+      .deco-line {
+        text-decoration-inset: var(--line-hidden-inset);
+      }
+    }
+
+    /* Nav: accent underline rises into place and grows outward */
+    nav a.deco-line {
+      text-underline-offset: 0.55em;
+    }
+
+    nav a.deco-line:hover,
+    nav a.deco-line:focus-visible,
+    nav a.deco-line[aria-current="page"] {
+      text-decoration-color: var(--accent);
+      text-underline-offset: 0.25em;
+      text-decoration-inset: 0.1em;
+    }
+
+    /* Logout keeps its bordered pill, so use an inset overline instead */
+    nav a.logout-link.deco-line {
+      text-decoration-line: overline;
+    }
+
+    /* Footer: subtle dotted rest state, solid line revealed on hover */
+    .footer-links a.deco-line {
+      text-decoration-style: dotted;
+      text-decoration-color: rgba(62, 39, 35, 0.35);
+      text-decoration-inset: 0.15em;
+      text-underline-offset: 0.35em;
+    }
+
+    .footer-links a.deco-line:hover,
+    .footer-links a.deco-line:focus-visible {
+      text-decoration-style: solid;
+      text-decoration-color: var(--primary);
+      text-decoration-thickness: 0.12em;
+      text-underline-offset: 0.2em;
+      text-decoration-inset: 0;
+    }
+
+    /* Section heading: framed by over + underline, revealed on load */
+    .section-title.deco-line {
+      text-decoration-line: underline overline;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 0.06em;
+      text-underline-offset: 0.22em;
+      text-decoration-inset: -0.4em;
+      margin-bottom: 0.5rem;
+      animation: line-reveal 1.1s var(--line-ease) 0.2s both;
+    }
+
+    /* Card titles: wavy underline revealed as cards scroll in,
+       then tightened on card hover */
+    .card h3.deco-line {
+      text-decoration-style: wavy;
+      text-decoration-thickness: 0.06em;
+      text-decoration-color: var(--accent);
+      text-underline-offset: 0.3em;
+      text-decoration-inset: 0.6em;
+      animation: line-reveal 0.9s var(--line-ease) both;
+    }
+
+    .card:nth-child(2) h3.deco-line { animation-delay: 0.15s; }
+    .card:nth-child(3) h3.deco-line { animation-delay: 0.3s; }
+
+    .card:hover h3.deco-line,
+    .card:focus-within h3.deco-line {
+      text-decoration-style: solid;
+      text-decoration-thickness: 0.1em;
+      text-decoration-color: var(--primary);
+      text-underline-offset: 0.15em;
+      text-decoration-inset: 0;
+    }
+
+    @supports (animation-timeline: view()) {
+      .card h3.deco-line {
+        animation-delay: 0s;
+        animation-timeline: view();
+        animation-range: entry 10% cover 35%;
+      }
+    }
+
+    /* Animates from collapsed/transparent to each element's own
+       resting values (no `to` keyframe => uses element styles) */
+    @keyframes line-reveal {
+      from {
+        text-decoration-color: transparent;
+        text-underline-offset: 0.8em;
+        text-decoration-inset: var(--line-hidden-inset);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .deco-line {
+        transition: none;
+        animation: none !important;
+      }
+    }
