+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const beans = [...scroller.querySelectorAll('.bean')];
+      let scrolling = false;
+
+      // Cheap work only while moving: one DOM write at the start of a scroll.
+      function onScroll() {
+        if (scrolling) return;
+        scrolling = true;
+        status.dataset.state = 'scrolling';
+        status.textContent = 'Scrolling…';
+      }
+
+      // Layout reads deferred until the scroll has settled.
+      function findVisibleBean() {
+        const box = scroller.getBoundingClientRect();
+        const center = box.left + box.width / 2;
+        let best = beans[0];
+        let bestDist = Infinity;
+        for (const bean of beans) {
+          const r = bean.getBoundingClientRect();
+          const dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = bean;
+          }
+        }
+        return best;
+      }
+
+      function onScrollEnd() {
+        scrolling = false;
+        const bean = findVisibleBean();
+        status.dataset.state = 'idle';
+        status.textContent = `Viewing: ${bean.dataset.name}`;
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      scroller.addEventListener('scrollend', onScrollEnd);
+
+      // Fallback for browsers without scrollend: debounce scroll to dispatch it.
+      if (!('onscrollend' in window)) {
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 150);
+        }, { passive: true });
+      }
+    })();
+  </script>
