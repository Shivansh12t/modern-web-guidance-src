+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = scroller.querySelectorAll('.bean');
+      var IDLE_DELAY = 150;
+      var isScrolling = false;
+      var idleTimer = null;
+      var current = null;
+
+      // Find the bean whose center is closest to the scroller's center.
+      // Only runs once scrolling stops, so no layout reads happen mid-scroll.
+      function findVisibleBean() {
+        var box = scroller.getBoundingClientRect();
+        var center = box.left + box.width / 2;
+        var best = null;
+        var bestDist = Infinity;
+        for (var i = 0; i < beans.length; i++) {
+          var r = beans[i].getBoundingClientRect();
+          var dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = beans[i];
+          }
+        }
+        return best;
+      }
+
+      function settle() {
+        clearTimeout(idleTimer);
+        idleTimer = null;
+        isScrolling = false;
+        var bean = findVisibleBean();
+        if (current && current !== bean) current.classList.remove('is-visible');
+        if (bean) {
+          bean.classList.add('is-visible');
+          status.textContent = 'Showing: ' + bean.dataset.bean;
+        }
+        current = bean;
+        status.dataset.state = 'idle';
+      }
+
+      function onScroll() {
+        // Touch the DOM only on the idle -> scrolling transition.
+        if (!isScrolling) {
+          isScrolling = true;
+          status.dataset.state = 'scrolling';
+          status.textContent = 'Scrolling\u2026';
+        }
+        // Fallback debounce for browsers without the scrollend event.
+        clearTimeout(idleTimer);
+        idleTimer = setTimeout(settle, IDLE_DELAY);
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      if ('onscrollend' in window) {
+        scroller.addEventListener('scrollend', function () {
+          if (isScrolling) settle();
+        });
+      }
+
+      // Keyboard support: arrow keys move one bean at a time.
+      scroller.addEventListener('keydown', function (e) {
+        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
+        e.preventDefault();
+        var idx = Array.prototype.indexOf.call(beans, current || beans[0]);
+        idx += e.key === 'ArrowRight' ? 1 : -1;
+        idx = Math.max(0, Math.min(beans.length - 1, idx));
+        beans[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
+      });
+
+      settle();
+    })();
+  </script>
+
