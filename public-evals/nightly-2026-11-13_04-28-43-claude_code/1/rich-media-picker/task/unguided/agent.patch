+    /* Roast picker (customizable select with rich options) */
+    .roast-picker {
+      margin-top: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+    }
+
+    .roast-picker label {
+      font-size: 0.85rem;
+      text-transform: uppercase;
+      letter-spacing: 1.5px;
+      color: var(--secondary);
+    }
+
+    .roast-select {
+      width: min(340px, 90vw);
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background: rgba(255, 255, 255, 0.95);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    .roast-icon {
+      flex: 0 0 auto;
+      width: 32px;
+      height: 32px;
+      color: var(--primary);
+    }
+
+    .roast-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.25;
+    }
+
+    .roast-title {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .roast-desc {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        border: none;
+        border-radius: 10px;
+        background: white;
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select > button {
+        display: flex;
+        align-items: center;
+        width: 100%;
+      }
+
+      .roast-select option {
+        padding: 8px 10px;
+        border-radius: 6px;
+        text-align: left;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: #efebe9;
+      }
+
+      .roast-select option:checked {
+        background: #ffe0b2;
+      }
+
+      .roast-select option::checkmark {
+        order: 1;
+        margin-left: auto;
+        color: var(--primary);
+      }
+
+      /* Description is shown in the list, but kept off the closed button for compactness */
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      /* Plain-text separator only used by browsers without rich select support */
+      .roast-sep {
+        display: none;
+      }
+    }
+
+    .hero .roast-picker + .btn {
+      margin-top: 1rem;
+    }
+
