+  <script>
+    (() => {
+      const viewport = document.querySelector('.map-viewport');
+      if (!viewport) return;
+
+      // Start centered on Downtown
+      viewport.scrollLeft = 1180 - viewport.clientWidth / 2;
+      viewport.scrollTop = 880 - viewport.clientHeight / 2;
+
+      // Mouse drag-to-pan everywhere; touch/wheel are handled natively when
+      // scroll-axis-lock is supported, otherwise by the fallback below.
+      const nativeFreePan = CSS.supports('scroll-axis-lock', 'none');
+      let last = null;
+      let moved = 0;
+
+      if (!nativeFreePan) {
+        viewport.addEventListener('wheel', (e) => {
+          if (e.ctrlKey) return; // let pinch / ctrl+wheel zoom the page
+          e.preventDefault();
+          const scale = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? viewport.clientHeight : 1;
+          viewport.scrollLeft += e.deltaX * scale;
+          viewport.scrollTop += e.deltaY * scale;
+        }, { passive: false });
+      }
+
+      viewport.addEventListener('pointerdown', (e) => {
+        if (nativeFreePan && e.pointerType !== 'mouse') return;
+        const rect = viewport.getBoundingClientRect();
+        if (
+          !e.isPrimary || e.button !== 0 ||
+          e.clientX - rect.left - viewport.clientLeft >= viewport.clientWidth ||
+          e.clientY - rect.top - viewport.clientTop >= viewport.clientHeight
+        ) return; // ignore secondary buttons and native scrollbar clicks
+        last = { x: e.clientX, y: e.clientY, id: e.pointerId };
+        moved = 0;
+      });
+
+      viewport.addEventListener('pointermove', (e) => {
+        if (!last || e.pointerId !== last.id) return;
+        const dx = e.clientX - last.x;
+        const dy = e.clientY - last.y;
+        moved += Math.abs(dx) + Math.abs(dy);
+        // Capture only once a real drag begins so taps on pins still navigate
+        if (moved > 4 && !viewport.hasPointerCapture(e.pointerId)) {
+          viewport.setPointerCapture(e.pointerId);
+          viewport.classList.add('is-panning');
+        }
+        viewport.scrollLeft -= dx;
+        viewport.scrollTop -= dy;
+        last.x = e.clientX;
+        last.y = e.clientY;
+      });
+
+      const endPan = () => {
+        last = null;
+        viewport.classList.remove('is-panning');
+      };
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+
+      // Suppress the click that ends a drag so pins don't open accidentally
+      viewport.addEventListener('click', (e) => {
+        if (moved > 4) {
+          e.preventDefault();
+          moved = 0;
+        }
+      }, true);
+
+      // Prevent native link/image dragging from hijacking mouse pans
+      viewport.addEventListener('dragstart', (e) => e.preventDefault());
+    })();
+  </script>
+
