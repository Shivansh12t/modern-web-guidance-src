+  <script type="module">
+    const WIDTH = 480;
+    const HEIGHT = 360;
+    const MAX_SPP = 256;
+
+    // Sphere indices in the smallpt scene.
+    const WALLS = [0, 1, 2, 4, 5]; // left, right, back, floor, ceiling
+    const MIRROR = 6;
+    const GLASS = 7;
+    const ORIGINAL_COLORS = {
+      0: [0.75, 0.25, 0.25], 1: [0.25, 0.25, 0.75], 2: [0.75, 0.75, 0.75],
+      4: [0.75, 0.75, 0.75], 5: [0.75, 0.75, 0.75],
+      [MIRROR]: [0.999, 0.999, 0.999], [GLASS]: [0.999, 0.999, 0.999],
+    };
+
+    const canvas = document.getElementById('pt-canvas');
+    const ctx = canvas.getContext('2d');
+    const status = document.getElementById('pt-status');
+    const progress = document.getElementById('pt-progress');
+    const button = document.getElementById('pt-rerun');
+
+    function hslToRgb(h, s, l) {
+      const k = (n) => (n + h / 30) % 12;
+      const a = s * Math.min(l, 1 - l);
+      const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+      return [f(0), f(8), f(4)];
+    }
+
+    function randomColors() {
+      const colors = {};
+      for (const i of WALLS) {
+        colors[i] = hslToRgb(Math.random() * 360, 0.35 + Math.random() * 0.5, 0.3 + Math.random() * 0.4);
+      }
+      // Tints for the mirror and glass balls stay bright so they still read as metal/glass.
+      colors[MIRROR] = hslToRgb(Math.random() * 360, 0.3 + Math.random() * 0.6, 0.65 + Math.random() * 0.2);
+      colors[GLASS] = hslToRgb(Math.random() * 360, 0.3 + Math.random() * 0.6, 0.7 + Math.random() * 0.2);
+      return colors;
+    }
+
+    let worker;
+    let startTime;
+
+    function render(colors) {
+      // Restarting is simplest by discarding the busy worker.
+      worker?.terminate();
+      worker = new Worker(new URL('./smallpt/worker.js', import.meta.url), { type: 'module' });
+      startTime = performance.now();
+      status.textContent = 'Rendering first pass…';
+      progress.value = 0;
+
+      worker.onmessage = ({ data }) => {
+        if (data.type === 'progress') {
+          progress.value = (data.spp + 4 * data.fraction) / MAX_SPP;
+        } else if (data.type === 'frame') {
+          ctx.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+          progress.value = data.spp / MAX_SPP;
+          status.textContent = `${data.spp} / ${MAX_SPP} samples per pixel`;
+        } else if (data.type === 'done') {
+          const secs = ((performance.now() - startTime) / 1000).toFixed(1);
+          status.textContent = `Done: ${data.spp} samples per pixel in ${secs}s`;
+        }
+      };
+      worker.onerror = (e) => {
+        status.textContent = 'Sorry, the renderer failed to load.';
+        console.error(e);
+      };
+      worker.postMessage({ width: WIDTH, height: HEIGHT, maxSpp: MAX_SPP, colors });
+    }
+
+    button.addEventListener('click', () => render(randomColors()));
+    render(ORIGINAL_COLORS);
+  </script>
