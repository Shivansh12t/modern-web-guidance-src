new file mode 100644
index 0000000..e1c309f
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,31 @@
+// Runs the smallpt WebAssembly module off the main thread and streams
+// progressively refined frames back to the page.
+import createSmallpt from './smallpt.js';
+
+const wasmReady = createSmallpt();
+const ROWS_PER_CHUNK = 24;
+
+self.onmessage = async ({ data }) => {
+  const { width, height, maxSpp, colors } = data;
+  const wasm = await wasmReady;
+
+  for (const [i, [r, g, b]] of Object.entries(colors)) {
+    wasm._set_sphere_color(Number(i), r, g, b);
+  }
+
+  const ptr = wasm._init(width, height);
+  const byteLength = width * height * 4;
+  let spp = 0;
+
+  while (spp < maxSpp) {
+    for (let y = 0; y < height; y += ROWS_PER_CHUNK) {
+      wasm._render_rows(y, Math.min(y + ROWS_PER_CHUNK, height));
+      self.postMessage({ type: 'progress', spp, fraction: Math.min(1, (y + ROWS_PER_CHUNK) / height) });
+    }
+    spp = wasm._finish_pass();
+    // Read HEAPU8 fresh: memory growth may have replaced the buffer.
+    const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, ptr, byteLength).slice();
+    self.postMessage({ type: 'frame', spp, pixels, width, height }, [pixels.buffer]);
+  }
+  self.postMessage({ type: 'done', spp });
+};
