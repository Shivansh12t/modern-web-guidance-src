+#!/bin/sh
+# Compile smallpt to WebAssembly. Output: ../wasm/smallpt.js + ../wasm/smallpt.wasm
+set -e
+cd "$(dirname "$0")"
+em++ -O3 smallpt.cpp -o ../wasm/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=worker,web \
+  -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 \
+  -sEXPORTED_FUNCTIONS=_init,_render_row,_finish_pass,_set_sphere_color,_reset_colors,_get_sphere_count,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
