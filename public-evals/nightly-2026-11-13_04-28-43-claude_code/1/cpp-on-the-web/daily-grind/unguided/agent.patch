+// smallpt, a Path Tracer by Kevin Beason, 2008  (http://www.kevinbeason.com/smallpt/)
+// Original MIT-licensed source, adapted for WebAssembly:
+//  - main() replaced by exported functions that render into an RGBA buffer
+//  - sphere colors can be set from JavaScript
+//  - rendering is done row by row so the caller can show progress
+#include <math.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <emscripten/emscripten.h>
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };
+struct Sphere {
+  double rad; Vec p, e, c; Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p-r.o;
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+static const int NUM_SPHERES = sizeof(spheres)/sizeof(Sphere);
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=NUM_SPHERES, d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t; int id=0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z;
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; }
+  if (depth>100) return obj.e; // guard against stack overflow (wasm has a small stack)
+  if (obj.refl == DIFF){
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));
+  bool into = n.dot(nl)>0;
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// ---------------------------------------------------------------------------
+// WebAssembly API (progressive version of smallpt's main loop)
+//
+// smallpt renders 2x2 subpixels per pixel, averages `samps` samples per
+// subpixel, clamps each subpixel and averages the four. Here we keep a running
+// sum per subpixel so the image can be refined one pass (1 sample/subpixel)
+// at a time; after N passes the result equals smallpt with samps = N.
+// ---------------------------------------------------------------------------
+static int W = 0, H = 0, PASSES = 0;
+static uint8_t *pixels = 0; // RGBA, top row first
+static double  *accum  = 0; // W*H*4 subpixels * 3 channels
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int get_sphere_count(){ return NUM_SPHERES; }
+
+// Set the color (albedo) of sphere i, components in [0,1).
+EMSCRIPTEN_KEEPALIVE void set_sphere_color(int i, double r, double g, double b){
+  if (i < 0 || i >= NUM_SPHERES) return;
+  spheres[i].c = Vec(r, g, b);
+}
+
+// Restore the classic Cornell-box colors.
+EMSCRIPTEN_KEEPALIVE void reset_colors(){
+  spheres[0].c = Vec(.75,.25,.25);
+  spheres[1].c = Vec(.25,.25,.75);
+  spheres[2].c = spheres[4].c = spheres[5].c = Vec(.75,.75,.75);
+  spheres[3].c = Vec();
+  spheres[6].c = spheres[7].c = Vec(1,1,1)*.999;
+  spheres[8].c = Vec();
+}
+
+// Allocate a w*h image and clear the accumulation buffer.
+// Returns a pointer to the RGBA output buffer in wasm memory.
+EMSCRIPTEN_KEEPALIVE uint8_t* init(int w, int h){
+  W = w; H = h; PASSES = 0;
+  free(pixels); free(accum);
+  pixels = (uint8_t*)calloc((size_t)w*h*4, 1);
+  accum  = (double*)calloc((size_t)w*h*12, sizeof(double));
+  for (int i = 0; i < w*h; i++) pixels[i*4+3] = 255;
+  return pixels;
+}
+
+// Add one sample per subpixel to image row y (0 = top) for pass `pass`.
+EMSCRIPTEN_KEEPALIVE void render_row(int y, int pass){
+  if (!accum || y < 0 || y >= H) return;
+  int w=W, h=H;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135;
+  int sy = h-1-y; // smallpt's y runs bottom-up
+  unsigned short Xi[3]={(unsigned short)(pass*7919),(unsigned short)pass,(unsigned short)(sy*sy*sy)};
+  for (int x=0; x<w; x++){
+    double *a = accum + ((size_t)y*w + x)*12;
+    for (int syy=0; syy<2; syy++)
+      for (int sx=0; sx<2; sx++, a+=3){
+        double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+        Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                cy*( ( (syy+.5 + dy)/2 + sy)/h - .5) + cam.d;
+        Vec r = radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        a[0]+=r.x; a[1]+=r.y; a[2]+=r.z;
+      }
+  }
+}
+
+// Mark a pass complete and convert the accumulated radiance to RGBA.
+EMSCRIPTEN_KEEPALIVE int finish_pass(){
+  if (!accum) return 0;
+  PASSES++;
+  double inv = 1.0 / PASSES;
+  for (int i = 0; i < W*H; i++){
+    double *a = accum + (size_t)i*12; Vec c;
+    for (int s = 0; s < 4; s++)
+      c = c + Vec(clamp(a[s*3]*inv), clamp(a[s*3+1]*inv), clamp(a[s*3+2]*inv))*.25;
+    uint8_t *p = pixels + (size_t)i*4;
+    p[0]=toInt(c.x); p[1]=toInt(c.y); p[2]=toInt(c.z); p[3]=255;
+  }
+  return PASSES;
+}
+
+} // extern "C"
diff --git a/wasm/smallpt-app.js b/wasm/smallpt-app.js
new file mode 100644
index 0000000..76e7834
--- /dev/null
+++ b/wasm/smallpt-app.js
@@ -0,0 +1,80 @@
+// Drives the smallpt WebAssembly path tracer across several Web Workers
+// and paints the progressively refined image onto a <canvas>.
+(() => {
+  const WIDTH = 320, HEIGHT = 240, PASSES = 64; // 64 passes x 4 subpixels = 256 spp
+  const canvas = document.getElementById('smallpt-canvas');
+  const status = document.getElementById('smallpt-status');
+  const btn = document.getElementById('smallpt-randomize');
+  const resetBtn = document.getElementById('smallpt-reset');
+  const swatches = document.getElementById('smallpt-swatches');
+  if (!canvas) return;
+  canvas.width = WIDTH; canvas.height = HEIGHT;
+  const ctx = canvas.getContext('2d');
+  const image = ctx.createImageData(WIDTH, HEIGHT);
+  const nWorkers = Math.max(1, Math.min(8, (navigator.hardwareConcurrency || 4) - 1));
+  let workers = [];
+  let startTime = 0;
+
+  // Sphere indices in smallpt's scene.
+  const WALLS = [[0, 'Left wall'], [1, 'Right wall'], [2, 'Back wall'], [4, 'Floor'], [5, 'Ceiling']];
+  const BALLS = [[6, 'Mirror ball'], [7, 'Glass ball']];
+
+  const rand = (lo, hi) => lo + Math.random() * (hi - lo);
+  function randomColors() {
+    const c = [];
+    for (const [i] of WALLS) c.push([i, rand(0.05, 0.95), rand(0.05, 0.95), rand(0.05, 0.95)]);
+    for (const [i] of BALLS) c.push([i, rand(0.35, 0.999), rand(0.35, 0.999), rand(0.35, 0.999)]);
+    return c;
+  }
+
+  function showSwatches(colors) {
+    swatches.innerHTML = '';
+    const names = Object.fromEntries([...WALLS, ...BALLS]);
+    const list = colors || [[0, .75, .25, .25], [1, .25, .25, .75], [2, .75, .75, .75],
+      [4, .75, .75, .75], [5, .75, .75, .75], [6, .999, .999, .999], [7, .999, .999, .999]];
+    for (const [i, r, g, b] of list) {
+      const s = document.createElement('span');
+      s.className = 'swatch';
+      s.title = names[i];
+      s.style.background = `rgb(${r * 255 | 0},${g * 255 | 0},${b * 255 | 0})`;
+      swatches.appendChild(s);
+    }
+  }
+
+  function stop() { workers.forEach((w) => w.terminate()); workers = []; }
+
+  function render(colors) {
+    stop();
+    image.data.fill(0);
+    for (let i = 3; i < image.data.length; i += 4) image.data[i] = 255;
+    ctx.putImageData(image, 0, 0);
+    showSwatches(colors);
+    startTime = performance.now();
+    const passDone = new Array(nWorkers).fill(0);
+    status.textContent = `Loading WebAssembly… (${nWorkers} worker${nWorkers > 1 ? 's' : ''})`;
+
+    for (let k = 0; k < nWorkers; k++) {
+      const w = new Worker('wasm/smallpt-worker.js');
+      w.onmessage = (e) => {
+        const { pass, rows, data } = e.data;
+        const rowBytes = WIDTH * 4;
+        rows.forEach((y, i) => image.data.set(data.subarray(i * rowBytes, (i + 1) * rowBytes), y * rowBytes));
+        passDone[k] = pass;
+        ctx.putImageData(image, 0, 0);
+        const minPass = Math.min(...passDone);
+        const secs = ((performance.now() - startTime) / 1000).toFixed(1);
+        status.textContent = minPass >= PASSES
+          ? `Done: ${PASSES * 4} samples/pixel in ${secs}s`
+          : `Rendering… pass ${minPass}/${PASSES} (${minPass * 4} spp, ${secs}s)`;
+        if (minPass >= PASSES) stop();
+      };
+      w.onerror = (err) => { status.textContent = 'Error: ' + (err.message || 'worker failed'); };
+      w.postMessage({ width: WIDTH, height: HEIGHT, passes: PASSES, offset: k, stride: nWorkers, colors });
+      workers.push(w);
+    }
+  }
+
+  btn.addEventListener('click', () => render(randomColors()));
+  resetBtn.addEventListener('click', () => render(null));
+  render(null);
+})();
diff --git a/wasm/smallpt-worker.js b/wasm/smallpt-worker.js
new file mode 100644
index 0000000..f25e38a
--- /dev/null
+++ b/wasm/smallpt-worker.js
@@ -0,0 +1,29 @@
+// Web Worker that runs the smallpt WebAssembly module.
+// Each worker renders an interleaved subset of rows (y % stride === offset)
+// and posts them back after every progressive pass.
+importScripts('smallpt.js');
+
+self.onmessage = async (e) => {
+  const { width, height, passes, offset, stride, colors } = e.data;
+  const m = await createSmallpt();
+  const ptr = m._init(width, height);
+  m._reset_colors();
+  if (colors) colors.forEach(([i, r, g, b]) => m._set_sphere_color(i, r, g, b));
+
+  const myRows = [];
+  for (let y = offset; y < height; y += stride) myRows.push(y);
+  const rowBytes = width * 4;
+
+  for (let pass = 0; pass < passes; pass++) {
+    for (const y of myRows) m._render_row(y, pass);
+    m._finish_pass();
+    // Copy this worker's rows out of wasm memory.
+    const out = new Uint8ClampedArray(myRows.length * rowBytes);
+    myRows.forEach((y, i) => {
+      out.set(m.HEAPU8.subarray(ptr + y * rowBytes, ptr + (y + 1) * rowBytes), i * rowBytes);
+    });
+    self.postMessage({ pass: pass + 1, rows: myRows, data: out }, [out.buffer]);
+    // Yield so the worker stays responsive.
+    await new Promise((r) => setTimeout(r, 0));
+  }
+};
