diff --git a/src/components/PathTracer.astro b/src/components/PathTracer.astro
new file mode 100644
index 0000000..fa84f8e
--- /dev/null
+++ b/src/components/PathTracer.astro
@@ -0,0 +1,171 @@
+---
+// Client-side path tracing demo: smallpt (Kevin Beason) compiled to WebAssembly.
+---
+<section class="p-4 md:p-6" data-path-tracer>
+  <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6">
+    Rendered in Your Browser
+  </h2>
+  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-6 items-start">
+    <figure class="m-0">
+      <canvas
+        width="320"
+        height="240"
+        class="w-full h-auto aspect-[4/3] bg-gray-900 shadow-sm"
+        role="img"
+        aria-label="Path-traced Cornell box with a mirror sphere and a glass sphere"
+        data-canvas
+      ></canvas>
+      <figcaption class="mt-2 text-xs text-gray-500" aria-live="polite" data-status>
+        Loading WebAssembly…
+      </figcaption>
+      <progress class="w-full h-1 mt-1 accent-amber-400" max="1" value="0" data-progress></progress>
+    </figure>
+    <div>
+      <p class="text-amber-400 font-semibold text-sm mb-2">Technology</p>
+      <h3 class="text-2xl font-brand mb-3 leading-tight">
+        A 99-line path tracer, running on your machine
+      </h3>
+      <p class="text-gray-700 mb-4">
+        This image is computed live by
+        <a class="underline hover:text-amber-400" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+        Kevin Beason's tiny global-illumination renderer, compiled from C++ to WebAssembly.
+        It runs in a background worker and refines the picture with every pass of
+        Monte Carlo sampling.
+      </p>
+      <button
+        type="button"
+        class="inline-flex items-center gap-2 bg-gray-900 text-white font-semibold px-4 py-2 hover:bg-amber-400 hover:text-gray-900 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400"
+        data-randomize
+      >
+        Render again with random colors
+      </button>
+      <ul class="flex flex-wrap gap-2 mt-4 p-0 list-none" aria-label="Current sphere colors" data-swatches></ul>
+    </div>
+  </div>
+</section>
+
+<script>
+  const WIDTH = 320;
+  const HEIGHT = 240;
+  const PASSES = 64; // 4 samples per pixel per pass → 256 spp
+
+  // Sphere indices in smallpt's scene (6 walls are huge spheres; 3 is the
+  // black front wall behind the camera and 8 is the light, both left as-is).
+  const SPHERES = [
+    { id: 0, name: 'Left wall', kind: 'wall' },
+    { id: 1, name: 'Right wall', kind: 'wall' },
+    { id: 2, name: 'Back wall', kind: 'wall' },
+    { id: 4, name: 'Floor', kind: 'wall' },
+    { id: 5, name: 'Ceiling', kind: 'wall' },
+    { id: 6, name: 'Mirror sphere', kind: 'tint' },
+    { id: 7, name: 'Glass sphere', kind: 'tint' },
+  ] as const;
+
+  const DEFAULT_COLORS: Record<number, [number, number, number]> = {
+    0: [0.75, 0.25, 0.25],
+    1: [0.25, 0.25, 0.75],
+    2: [0.75, 0.75, 0.75],
+    4: [0.75, 0.75, 0.75],
+    5: [0.75, 0.75, 0.75],
+    6: [0.999, 0.999, 0.999],
+    7: [0.999, 0.999, 0.999],
+  };
+
+  type Color = [number, number, number];
+
+  function hslToRgb(h: number, s: number, l: number): Color {
+    const k = (n: number) => (n + h / 30) % 12;
+    const a = s * Math.min(l, 1 - l);
+    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+    return [f(0), f(8), f(4)];
+  }
+
+  function randomColor(kind: 'wall' | 'tint'): Color {
+    const hue = Math.random() * 360;
+    // Walls: moderately saturated diffuse albedo (≤ ~0.85 keeps the scene lit
+    // but not blown out). Mirror/glass: bright tints so they stay reflective.
+    return kind === 'wall'
+      ? hslToRgb(hue, 0.35 + Math.random() * 0.5, 0.3 + Math.random() * 0.35)
+      : hslToRgb(hue, 0.3 + Math.random() * 0.6, 0.65 + Math.random() * 0.25);
+  }
+
+  const toCss = ([r, g, b]: Color) =>
+    `rgb(${[r, g, b].map((c) => Math.round(Math.pow(c, 1 / 2.2) * 255)).join(' ')})`;
+
+  let worker: Worker | undefined;
+
+  function setup() {
+    const root = document.querySelector<HTMLElement>('[data-path-tracer]');
+    if (!root || root.dataset.ready) return;
+    root.dataset.ready = 'true';
+
+    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
+    const ctx = canvas.getContext('2d')!;
+    const status = root.querySelector<HTMLElement>('[data-status]')!;
+    const progress = root.querySelector<HTMLProgressElement>('[data-progress]')!;
+    const button = root.querySelector<HTMLButtonElement>('[data-randomize]')!;
+    const swatches = root.querySelector<HTMLUListElement>('[data-swatches]')!;
+
+    worker?.terminate();
+    worker = new Worker(new URL('../smallpt/smallpt.worker.js', import.meta.url), {
+      type: 'module',
+    });
+    let job = 0;
+
+    worker.onmessage = ({ data }) => {
+      if (data.job !== job) return; // stale frame from a superseded render
+      if (data.type === 'error') {
+        status.textContent = `Rendering failed: ${data.message}`;
+        return;
+      }
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), data.width, data.height), 0, 0);
+      progress.value = data.spp / (PASSES * 4);
+      const secs = (data.elapsedMs / 1000).toFixed(1);
+      status.textContent = data.done
+        ? `Done: ${data.spp} samples per pixel in ${secs}s (smallpt / WebAssembly).`
+        : `Rendering… ${data.spp} / ${PASSES * 4} samples per pixel (${secs}s)`;
+    };
+    worker.onerror = () => {
+      status.textContent = 'Could not load the WebAssembly path tracer.';
+    };
+
+    function render(colors: Record<number, Color>) {
+      job++;
+      progress.value = 0;
+      status.textContent = 'Rendering…';
+      swatches.replaceChildren(
+        ...SPHERES.map(({ id, name }) => {
+          const li = document.createElement('li');
+          li.className = 'flex items-center gap-1.5 text-xs text-gray-600';
+          const chip = document.createElement('span');
+          chip.className = 'inline-block w-4 h-4 border border-gray-300';
+          chip.style.background = toCss(colors[id]);
+          li.append(chip, name);
+          return li;
+        }),
+      );
+      worker!.postMessage({
+        type: 'render',
+        job,
+        width: WIDTH,
+        height: HEIGHT,
+        passes: PASSES,
+        colors: SPHERES.map(({ id }) => [id, ...colors[id]]),
+      });
+    }
+
+    button.addEventListener('click', () => {
+      render(Object.fromEntries(SPHERES.map(({ id, kind }) => [id, randomColor(kind)])));
+    });
+
+    render(DEFAULT_COLORS);
+  }
+
+  // Works with Astro's ClientRouter (view transitions): re-init on each page load
+  // and stop the worker when navigating away.
+  document.addEventListener('astro:page-load', setup);
+  document.addEventListener('astro:before-swap', () => {
+    worker?.terminate();
+    worker = undefined;
+  });
+</script>
