--- /dev/null
+++ b/src/smallpt/build.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Compiles smallpt.cpp to an ES6 WebAssembly module for use in a Web Worker.
+# Requires Emscripten (emcc/em++) on PATH. Output: src/smallpt/generated/
+set -eu
+cd "$(dirname "$0")"
+mkdir -p generated
+em++ -c smallpt.cpp -o generated/smallpt.o -O3 -Wall -Werror
+em++ generated/smallpt.o -o generated/smallpt.js \
+  -O3 \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_render_pass,_set_sphere_color,_reset_sphere_colors,_sphere_count,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+rm generated/smallpt.o
