index 0000000..f310e65
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,65 @@
+/* Web Worker that drives the smallpt WebAssembly module.
+ *
+ * Messages in:  { type: 'render', id, width, height, passes, colors }
+ *                 colors: array of [r, g, b] per sphere index, or null for the
+ *                 original smallpt scene colors.
+ * Messages out: { type: 'ready' }
+ *               { type: 'rows', id, pass, passes, top, rows, pixels }  (RGBA8 slice)
+ *               { type: 'done', id, passes, ms }
+ *               { type: 'error', message }
+ * A new 'render' message cancels any render in progress.
+ */
+importScripts('smallpt.js');
+
+const ROWS_PER_CHUNK = 8;
+let M = null;
+let currentId = -1;
+let pending = null;
+
+const yieldToEventLoop = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+async function render({ id, width, height, passes, colors }) {
+  currentId = id;
+  M._smallpt_reset_colors();
+  if (colors) colors.forEach((c, i) => c && M._smallpt_set_color(i, c[0], c[1], c[2]));
+
+  const ptr = M._smallpt_init(width, height);
+  const start = performance.now();
+
+  for (let pass = 0; pass < passes; pass++) {
+    // smallpt's y=0 is the bottom row; go top-down so the image fills in naturally.
+    for (let y1 = height; y1 > 0; y1 -= ROWS_PER_CHUNK) {
+      const y0 = Math.max(0, y1 - ROWS_PER_CHUNK);
+      M._smallpt_render_rows(y0, y1, pass);
+
+      const top = height - y1; // first image row (top-first) covered by this chunk
+      const rows = y1 - y0;
+      const offset = ptr + top * width * 4;
+      const pixels = M.HEAPU8.slice(offset, offset + rows * width * 4);
+      self.postMessage({ type: 'rows', id, pass, passes, top, rows, pixels }, [pixels.buffer]);
+
+      await yieldToEventLoop(); // let a newer 'render' message in
+      if (currentId !== id) return;
+    }
+  }
+  self.postMessage({ type: 'done', id, passes, ms: performance.now() - start });
+}
+
+self.onmessage = (e) => {
+  const msg = e.data;
+  if (msg.type !== 'render') return;
+  if (!M) { pending = msg; return; }
+  render(msg).catch((err) => self.postMessage({ type: 'error', message: String(err) }));
+};
+
+createSmallpt()
+  .then((mod) => {
+    M = mod;
+    self.postMessage({ type: 'ready' });
+    if (pending) {
+      const msg = pending;
+      pending = null;
+      render(msg).catch((err) => self.postMessage({ type: 'error', message: String(err) }));
+    }
+  })
+  .catch((err) => self.postMessage({ type: 'error', message: 'Failed to load WebAssembly: ' + err }));
diff --git a/src/components/SmallptRenderer.astro b/src/components/SmallptRenderer.astro
new file mode 100644
index 0000000..60c784f
--- /dev/null
+++ b/src/components/SmallptRenderer.astro
@@ -0,0 +1,164 @@
+---
+// Client-side path tracing with smallpt (Kevin Beason, 2008) compiled to WebAssembly.
+// The wasm module + worker live in public/smallpt/ (built from wasm/smallpt/).
+const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+const workerUrl = `${base}smallpt/worker.js`;
+---
+<section class="p-4 md:p-6" id="smallpt" data-worker-url={workerUrl}>
+    <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Rendered in Your Browser</h2>
+    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
+        <figure class="lg:col-span-2">
+            <canvas
+                data-smallpt-canvas
+                width="320"
+                height="240"
+                class="w-full aspect-[4/3] bg-black rounded-sm"
+                aria-label="Path-traced Cornell box rendered by smallpt"
+            ></canvas>
+            <div class="mt-2 h-1 w-full bg-gray-200 rounded">
+                <div data-smallpt-progress class="h-1 bg-amber-400 rounded transition-[width] duration-150" style="width: 0%"></div>
+            </div>
+            <figcaption class="mt-2 text-xs text-gray-500" data-smallpt-status aria-live="polite">Loading WebAssembly…</figcaption>
+        </figure>
+        <div>
+            <p class="text-gray-700 mb-4">
+                This image is being path traced right now, on your device, by
+                <a class="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a>,
+                Kevin Beason's 99-line C++ global illumination renderer, compiled to WebAssembly and running in a Web Worker.
+                The image gets cleaner with every pass as more light paths are traced.
+            </p>
+            <button
+                type="button"
+                data-smallpt-randomize
+                class="inline-flex items-center gap-2 rounded bg-gray-900 px-4 py-2 font-semibold text-white hover:bg-amber-400 hover:text-gray-900 disabled:opacity-50 disabled:cursor-not-allowed"
+                disabled
+            >
+                Re-render with random colors
+            </button>
+            <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-gray-600" data-smallpt-legend></ul>
+        </div>
+    </div>
+</section>
+
+<script>
+    const WIDTH = 320;
+    const HEIGHT = 240;
+    const PASSES = 16; // 4 samples per pixel per pass -> 64 spp
+
+    // Sphere indices from smallpt's scene, with the original colors.
+    // 3 (front wall, behind the camera) and 8 (the light) are left untouched.
+    const SPHERES = [
+        { index: 0, name: 'Left wall', kind: 'wall', original: [0.75, 0.25, 0.25] },
+        { index: 1, name: 'Right wall', kind: 'wall', original: [0.25, 0.25, 0.75] },
+        { index: 2, name: 'Back wall', kind: 'wall', original: [0.75, 0.75, 0.75] },
+        { index: 4, name: 'Floor', kind: 'wall', original: [0.75, 0.75, 0.75] },
+        { index: 5, name: 'Ceiling', kind: 'wall', original: [0.75, 0.75, 0.75] },
+        { index: 6, name: 'Mirror ball', kind: 'ball', original: [0.999, 0.999, 0.999] },
+        { index: 7, name: 'Glass ball', kind: 'ball', original: [0.999, 0.999, 0.999] },
+    ] as const;
+
+    type RGB = [number, number, number];
+
+    function hslToRgb(h: number, s: number, l: number): RGB {
+        const k = (n: number) => (n + h * 12) % 12;
+        const a = s * Math.min(l, 1 - l);
+        const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+        return [f(0), f(8), f(4)];
+    }
+
+    function randomColors(): Map<number, RGB> {
+        const colors = new Map<number, RGB>();
+        for (const s of SPHERES) {
+            const h = Math.random();
+            const rgb =
+                s.kind === 'wall'
+                    ? hslToRgb(h, 0.35 + Math.random() * 0.5, 0.35 + Math.random() * 0.3)
+                    : hslToRgb(h, 0.4 + Math.random() * 0.6, 0.6 + Math.random() * 0.3); // tinted mirror/glass
+            // Keep reflectance below 1 so Russian roulette terminates paths.
+            colors.set(s.index, rgb.map((c) => Math.min(0.999, Math.max(0.02, c))) as RGB);
+        }
+        return colors;
+    }
+
+    const toCss = ([r, g, b]: RGB) =>
+        `rgb(${[r, g, b].map((c) => Math.round(Math.pow(c, 1 / 2.2) * 255)).join(',')})`;
+
+    function init() {
+        const root = document.getElementById('smallpt');
+        if (!root || root.dataset.initialized) return;
+        root.dataset.initialized = 'true';
+
+        const canvas = root.querySelector<HTMLCanvasElement>('[data-smallpt-canvas]')!;
+        const status = root.querySelector<HTMLElement>('[data-smallpt-status]')!;
+        const progress = root.querySelector<HTMLElement>('[data-smallpt-progress]')!;
+        const button = root.querySelector<HTMLButtonElement>('[data-smallpt-randomize]')!;
+        const legend = root.querySelector<HTMLElement>('[data-smallpt-legend]')!;
+        const ctx = canvas.getContext('2d')!;
+        canvas.width = WIDTH;
+        canvas.height = HEIGHT;
+
+        if (typeof WebAssembly !== 'object' || typeof Worker !== 'function') {
+            status.textContent = 'Sorry, your browser does not support WebAssembly workers.';
+            return;
+        }
+
+        const worker = new Worker(root.dataset.workerUrl!);
+        let renderId = 0;
+
+        const renderLegend = (colors: Map<number, RGB> | null) => {
+            legend.replaceChildren(
+                ...SPHERES.map((s) => {
+                    const li = document.createElement('li');
+                    li.className = 'flex items-center gap-2';
+                    const swatch = document.createElement('span');
+                    swatch.className = 'inline-block h-3 w-3 rounded-full border border-gray-300';
+                    swatch.style.background = toCss((colors?.get(s.index) ?? s.original) as RGB);
+                    li.append(swatch, s.name);
+                    return li;
+                }),
+            );
+        };
+
+        const startRender = (colors: Map<number, RGB> | null) => {
+            renderId++;
+            renderLegend(colors);
+            progress.style.width = '0%';
+            status.textContent = 'Rendering…';
+            const colorArray: (RGB | null)[] | null = colors
+                ? Array.from({ length: 9 }, (_, i) => colors.get(i) ?? null)
+                : null;
+            worker.postMessage({ type: 'render', id: renderId, width: WIDTH, height: HEIGHT, passes: PASSES, colors: colorArray });
+        };
+
+        worker.onmessage = (e: MessageEvent) => {
+            const msg = e.data;
+            if (msg.type === 'ready') {
+                button.disabled = false;
+            } else if (msg.type === 'rows' && msg.id === renderId) {
+                const image = new ImageData(new Uint8ClampedArray(msg.pixels.buffer), WIDTH, msg.rows);
+                ctx.putImageData(image, 0, msg.top);
+                const done = msg.pass + (msg.top + msg.rows) / HEIGHT;
+                progress.style.width = `${(100 * done) / msg.passes}%`;
+                status.textContent = `Rendering pass ${msg.pass + 1} of ${msg.passes} (${(msg.pass + 1) * 4} samples per pixel)…`;
+            } else if (msg.type === 'done' && msg.id === renderId) {
+                progress.style.width = '100%';
+                status.textContent = `Done: ${WIDTH}×${HEIGHT}, ${msg.passes * 4} samples per pixel, rendered in ${(msg.ms / 1000).toFixed(1)}s by smallpt (WebAssembly).`;
+            } else if (msg.type === 'error') {
+                status.textContent = `Render failed: ${msg.message}`;
+            }
+        };
+        worker.onerror = () => {
+            status.textContent = 'Render failed: could not start the smallpt worker.';
+        };
+
+        button.addEventListener('click', () => startRender(randomColors()));
+
+        // First render: smallpt's original scene.
+        startRender(null);
+
+        document.addEventListener('astro:before-swap', () => worker.terminate(), { once: true });
+    }
+
+    // Works with Astro's ClientRouter (view transitions) and plain page loads.
+    document.addEventListener('astro:page-load', init);
+</script>
