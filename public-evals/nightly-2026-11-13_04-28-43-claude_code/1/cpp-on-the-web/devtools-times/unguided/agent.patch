+++ b/wasm/smallpt/build.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env sh
+# Builds smallpt to WebAssembly. Requires Emscripten (emcc/em++) on PATH.
+# Output: public/smallpt/smallpt.js + smallpt.wasm (loaded by public/smallpt/worker.js)
+set -e
+HERE="$(cd "$(dirname "$0")" && pwd)"
+OUT="$HERE/../../public/smallpt"
+mkdir -p "$OUT"
+em++ "$HERE/smallpt.cpp" -O3 \
+  -s ENVIRONMENT=worker \
+  -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt \
+  -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=8388608 \
+  -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -s FILESYSTEM=0 \
+  -o "$OUT/smallpt.js"
+echo "Built $OUT/smallpt.js and smallpt.wasm"
diff --git a/wasm/smallpt/smallpt.cpp b/wasm/smallpt/smallpt.cpp
new file mode 100644
index 0000000..82cce12
--- /dev/null
+++ b/wasm/smallpt/smallpt.cpp
@@ -0,0 +1,161 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008 (http://www.kevinbeason.com/smallpt/)
+// WebAssembly port: the scene, camera and radiance() are unchanged from the
+// original (see smallpt.orig.cpp). main() is replaced by exported functions so
+// JavaScript can render progressively (row chunks, accumulating 4 spp per pass)
+// and change sphere colors between renders.
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <emscripten/emscripten.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+struct Vec {        // position, also color (r,g,b)
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+  Vec operator%(const Vec&b) const {return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };
+struct Sphere {
+  double rad; Vec p, e, c; Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p-r.o;
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+static const Sphere defaultSpheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+static const int NUM_SPHERES = sizeof(defaultSpheres)/sizeof(Sphere);
+static Sphere spheres[] = {
+  defaultSpheres[0], defaultSpheres[1], defaultSpheres[2],
+  defaultSpheres[3], defaultSpheres[4], defaultSpheres[5],
+  defaultSpheres[6], defaultSpheres[7], defaultSpheres[8]
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=NUM_SPHERES, d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t; int id=0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z;
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; }
+  if (obj.refl == DIFF){
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));
+  bool into = n.dot(nl)>0;
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// ---------------------------------------------------------------------------
+// Exported API
+// ---------------------------------------------------------------------------
+static int W = 0, H = 0;
+static Vec *accum = 0;            // unclamped radiance sums, 4 subpixels per pixel
+static unsigned char *rgba = 0;   // display buffer (W*H*4), top row first
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int smallpt_num_spheres() { return NUM_SPHERES; }
+
+EMSCRIPTEN_KEEPALIVE void smallpt_set_color(int i, double r, double g, double b) {
+  if (i >= 0 && i < NUM_SPHERES) spheres[i].c = Vec(r, g, b);
+}
+
+EMSCRIPTEN_KEEPALIVE void smallpt_reset_colors() {
+  for (int i = 0; i < NUM_SPHERES; i++) spheres[i].c = defaultSpheres[i].c;
+}
+
+// Allocates buffers for a w x h image and clears accumulation.
+// Returns a pointer to the RGBA8 output buffer.
+EMSCRIPTEN_KEEPALIVE unsigned char *smallpt_init(int w, int h) {
+  if (w != W || h != H) {
+    free(accum); free(rgba);
+    W = w; H = h;
+    accum = (Vec *)malloc(sizeof(Vec) * W * H * 4);
+    rgba = (unsigned char *)malloc(W * H * 4);
+  }
+  for (int i = 0; i < W * H * 4; i++) accum[i] = Vec();
+  memset(rgba, 0, W * H * 4);
+  return rgba;
+}
+
+// Renders image rows [y0, y1) for one pass (1 sample per 2x2 subpixel = 4 spp,
+// as in the original with samps=1), adds the unclamped radiance into the
+// per-subpixel accumulation buffer, and
+// updates the RGBA output for those rows from the average over `pass+1` passes.
+// Rows are in smallpt's convention: y=0 is the bottom of the image.
+EMSCRIPTEN_KEEPALIVE void smallpt_render_rows(int y0, int y1, int pass) {
+  const int w = W, h = H;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+  const double inv = 1.0 / (pass + 1);
+  for (int y = y0; y < y1 && y < h; y++) {
+    unsigned short Xi[3] = {0, (unsigned short)(pass * 7919u),
+                            (unsigned short)(y*y*y + pass * 104729u)};
+    for (int x = 0; x < w; x++) {
+      int i = (h-y-1)*w + x;
+      Vec c;
+      for (int sy = 0, k = 0; sy < 2; sy++)
+        for (int sx = 0; sx < 2; sx++, k++) {
+          double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+          Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                  cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+          Vec &acc = accum[i*4 + k];
+          acc = acc + radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+          // As in the original: average the subpixel's samples, then clamp.
+          r = acc * inv;
+          c = c + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+      Vec avg = c;
+      rgba[i*4+0] = (unsigned char)toInt(avg.x);
+      rgba[i*4+1] = (unsigned char)toInt(avg.y);
+      rgba[i*4+2] = (unsigned char)toInt(avg.z);
+      rgba[i*4+3] = 255;
+    }
+  }
+}
+
+} // extern "C"
