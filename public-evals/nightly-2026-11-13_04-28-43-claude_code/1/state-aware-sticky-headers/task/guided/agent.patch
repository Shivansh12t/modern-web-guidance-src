     .btn:hover {
       background: #3e2723;
     }
 
+    /* Sticky section headers (scroll-state container queries) */
+    .content-section {
+      margin-bottom: 60px;
+      /* Prevent scroll anchoring from fighting the stuck-state padding change */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick directly below the site nav rather than underneath it */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named container so it never collides with other (e.g. nav) containers */
+      container-type: scroll-state;
+      container-name: section-header;
+      margin-bottom: 20px;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 20px 24px;
+      border-radius: 8px;
+      text-align: center;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s, border-radius 0.3s;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--stuck-blue);
+        color: white;
+        padding: 8px 24px;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 4px 12px rgb(0 0 0 / 0.25);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .sticky-header {
+        transition: none;
+      }
+    }
+
+    .intro {
+      text-align: center;
+      max-width: 700px;
+      margin: 0 auto 60px;
+      font-size: 1.1rem;
+    }
+
+    .intro h2 {
