+  <script>
+    // Fallback for browsers lacking CSS scroll-state container queries:
+    // toggle .is-stuck when a .sticky-container reaches its sticky offset.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('container-type', 'scroll-state')) return;
+      var containers = document.querySelectorAll('.sticky-container');
+      function update() {
+        containers.forEach(function (el) {
+          var top = parseFloat(getComputedStyle(el).top) || 0;
+          var rect = el.getBoundingClientRect();
+          var parentRect = el.parentElement.getBoundingClientRect();
+          var stuck = rect.top <= top + 0.5 && parentRect.top < top && window.scrollY > 0;
+          el.classList.toggle('is-stuck', stuck);
+        });
+      }
+      window.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    })();
+  </script>
