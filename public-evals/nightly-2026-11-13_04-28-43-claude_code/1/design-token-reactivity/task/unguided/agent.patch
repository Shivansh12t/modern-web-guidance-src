     }
 
     .card {
       background: white;
+      /* Padding derives from the inherited --card-density custom property,
+         so updating it on an ancestor re-styles every descendant card. */
       padding: 20px;
+      padding: calc(20px * var(--card-density, 1));
+      transition: padding 0.3s;
       border-radius: 8px;
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
@@ -130,8 +134,41 @@
       margin-top: 15px;
       transition: background 0.3s;
     }
 
+    /* Layout density toggle */
+    #target-container {
+      --card-density: 1;
+    }
+
+    .density-controls {
+      text-align: center;
+      margin-top: 15px;
+    }
+
+    #toggle-spacious {
+      display: none;
+      border: 2px solid var(--primary);
+      background: white;
+      color: var(--primary);
+      padding: 8px 16px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    /* Only show the toggle where CSS custom properties are supported */
+    @supports (--card-density: 1) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
