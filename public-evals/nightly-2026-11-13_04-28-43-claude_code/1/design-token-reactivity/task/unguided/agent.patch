+  <script>
+    (function () {
+      var toggle = document.getElementById('toggle-spacious');
+      var container = document.getElementById('target-container');
+      if (!toggle || !container) return;
+      if (!(window.CSS && CSS.supports && CSS.supports('--card-density', '1'))) return;
+
+      // A single property change on the container; cards inherit it via CSS.
+      toggle.addEventListener('click', function () {
+        var spacious = toggle.getAttribute('aria-pressed') !== 'true';
+        container.style.setProperty('--card-density', spacious ? '2' : '1');
+        toggle.setAttribute('aria-pressed', String(spacious));
+      });
+    })();
+  </script>
