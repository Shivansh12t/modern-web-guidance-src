+    /* Card density: cards react to --card-density on their ancestor via container style queries */
+    #target-container {
+      --card-density: comfortable;
+    }
+
+    #target-container.is-spacious {
+      --card-density: spacious;
+    }
+
+    @container style(--card-density: comfortable) {
