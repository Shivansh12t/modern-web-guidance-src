diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,34 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Brand — Watch the film</title>
+<!-- LCP: the poster is only discoverable via the video's poster attribute, so preload it at high priority -->
+<link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+<!-- Critical header font: fonts are high priority by default -->
+<link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+<!-- Secondary UI font: start early, but don't compete with the poster/brand font -->
+<link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low">
+<style>
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-display:swap}
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:optional}
+*{box-sizing:border-box}
+body{margin:0;background:#000;color:#fff;font:1rem/1.5 Secondary,system-ui,sans-serif;font-size-adjust:from-font}
+header{padding:1.25rem 1.5rem}
+h1{margin:0;font:700 clamp(2rem,6vw,4rem)/1.1 Brand,system-ui,sans-serif;font-size-adjust:cap-height from-font;text-wrap:balance}
+video{display:block;width:100%;height:auto;aspect-ratio:16/9;background:#111;object-fit:cover}
+a{color:inherit}
+p{margin:1rem 1.5rem}
+</style>
+</head>
+<body>
+<header><h1>See it in motion</h1></header>
+<main>
+  <video controls playsinline preload="none" poster="poster.jpg" width="1600" height="900">
+    <source src="video.mp4" type="video/mp4">
+  </video>
+  <p><a href="#signup">Get early access</a></p>
+</main>
+</body>
+</html>
