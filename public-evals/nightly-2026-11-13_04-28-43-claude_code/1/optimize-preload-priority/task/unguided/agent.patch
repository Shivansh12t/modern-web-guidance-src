diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,31 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Watch</title>
+
+<!-- LCP element: fetch the poster first, at high priority -->
+<link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+<!-- Critical header font: preload (crossorigin is required for fonts, even same-origin) -->
+<link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+<!-- secondary-font.woff2 is intentionally NOT preloaded so it never competes with the above -->
+
+<style>
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-display:swap}
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:optional}
+*{box-sizing:border-box;margin:0}
+body{font:16px/1.5 Secondary,system-ui,sans-serif;background:#000;color:#fff;max-width:960px;margin:0 auto;padding:1rem}
+h1{font-family:Brand,system-ui,sans-serif;font-size:clamp(1.75rem,5vw,3rem);line-height:1.1;margin-bottom:1rem}
+video{display:block;width:100%;height:auto;aspect-ratio:16/9;background:#111}
+p{margin-top:1rem;opacity:.8}
+</style>
+</head>
+<body>
+<h1>Our Story in Motion</h1>
+<video controls playsinline preload="none" poster="poster.jpg" width="1280" height="720">
+  <source src="video.mp4" type="video/mp4">
+</video>
+<p>Press play to watch.</p>
+</body>
+</html>
