+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const textarea = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-btn');
+    const output = document.getElementById('feedback-result');
+
+    const languageNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+    let detectorPromise = null;
+
+    function show(message, isError = false) {
+      output.textContent = message;
+      output.classList.toggle('error', isError);
+    }
+
+    function disableDetection(message) {
+      button.disabled = true;
+      show(message, true);
+    }
+
+    const unsupportedMsg = 'Language detection is not supported in this browser.';
+
+    if (!('LanguageDetector' in self)) {
+      disableDetection(unsupportedMsg);
+    } else {
+      LanguageDetector.availability()
+        .then((availability) => {
+          if (availability === 'unavailable') disableDetection(unsupportedMsg);
+        })
+        .catch(() => disableDetection(unsupportedMsg));
+    }
+
+    // Must be created from a user gesture (model may need downloading).
+    function getDetector() {
+      detectorPromise ??= LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            show(`Downloading language model… ${Math.round(e.loaded * 100)}%`);
+          });
+        },
+      }).catch((err) => {
+        detectorPromise = null;
+        throw err;
+      });
+      return detectorPromise;
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = textarea.value.trim();
+      if (!text) {
+        show('Please enter a message first.', true);
+        textarea.focus();
+        return;
+      }
+
+      button.disabled = true;
+      show('Detecting…');
+      try {
+        const detector = await getDetector();
+        const [top] = await detector.detect(text);
+        if (!top || top.detectedLanguage === 'und') {
+          show('Sorry, we could not identify the language of this message.', true);
+          return;
+        }
+        let name;
+        try {
+          name = languageNames.of(top.detectedLanguage);
+        } catch {
+          name = top.detectedLanguage;
+        }
+        const confidence = Math.round(top.confidence * 100);
+        const hint = text.split(/\s+/).length < 3 ? ' (short messages may be less accurate)' : '';
+        show(`Detected language: ${name} (${top.detectedLanguage}), ${confidence}% confidence${hint}`);
+      } catch (err) {
+        console.error(err);
+        show('Language detection failed. Please try again.', true);
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
