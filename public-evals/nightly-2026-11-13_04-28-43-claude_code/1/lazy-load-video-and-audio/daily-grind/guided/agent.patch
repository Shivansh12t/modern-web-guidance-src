+  <script>
+    // Hero video: respect reduced motion and provide a pause control (WCAG 2.2.2).
+    (() => {
+      const video = document.querySelector('.hero-video');
+      const toggle = document.querySelector('.hero-toggle');
+      if (!video || !toggle) return;
+
+      const setPaused = (paused) => {
+        if (paused) video.pause(); else video.play().catch(() => {});
+        toggle.setAttribute('aria-pressed', String(paused));
+        toggle.textContent = paused ? 'Play background video' : 'Pause background video';
+      };
+
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      if (reducedMotion.matches) {
+        video.removeAttribute('autoplay');
+        setPaused(true);
+      }
+      reducedMotion.addEventListener('change', (e) => { if (e.matches) setPaused(true); });
+      toggle.addEventListener('click', () => setPaused(!video.paused));
+    })();
+
+    // Offscreen media: restore deferred poster/preload. Browsers with native
+    // <video>/<audio loading="lazy"> keep deferring them until near the viewport;
+    // other browsers fall back to an IntersectionObserver.
+    (() => {
+      const media = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]');
+
+      const activate = (el) => {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          delete el.dataset.poster;
+        }
+        if (el.dataset.preload) {
+          el.preload = el.dataset.preload;
+          delete el.dataset.preload;
+        }
+      };
+
+      if (Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+        media.forEach(activate);
+        return;
+      }
+
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          activate(entry.target);
+          observer.unobserve(entry.target);
+        }
+      }, { rootMargin: '300px 0px' });
+
+      media.forEach((el) => observer.observe(el));
+    })();
+  </script>
+
