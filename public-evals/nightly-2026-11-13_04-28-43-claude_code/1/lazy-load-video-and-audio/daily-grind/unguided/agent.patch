+  <script>
+    (function () {
+      var lazyMedia = document.querySelectorAll('.lazy-media');
+
+      // Swap deferred URLs into place, then let the browser fetch them.
+      function hydrate(el) {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          el.removeAttribute('data-poster');
+        }
+        var sources = el.querySelectorAll('source[data-src]');
+        for (var i = 0; i < sources.length; i++) {
+          sources[i].src = sources[i].dataset.src;
+          sources[i].removeAttribute('data-src');
+        }
+        if (el.dataset.src) {
+          el.src = el.dataset.src;
+          el.removeAttribute('data-src');
+        }
+        el.preload = el.dataset.preload || 'metadata';
+        el.load();
+        el.classList.remove('lazy-media');
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        for (var i = 0; i < lazyMedia.length; i++) hydrate(lazyMedia[i]);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            observer.unobserve(entry.target);
+            hydrate(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      lazyMedia.forEach(function (el) {
+        observer.observe(el);
+        // If a user somehow hits play before hydration (e.g. keyboard), load immediately.
+        el.addEventListener('play', function onPlay() {
+          el.removeEventListener('play', onPlay);
+          if (el.classList.contains('lazy-media')) {
+            observer.unobserve(el);
+            hydrate(el);
+            el.play();
+          }
+        });
+      });
+
+      // Pause the decorative hero loop for users who prefer reduced motion.
+      var hero = document.querySelector('.hero-video');
+      if (hero && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        hero.pause();
+        hero.removeAttribute('autoplay');
+        hero.preload = 'none';
+      }
+    })();
+  </script>
+
