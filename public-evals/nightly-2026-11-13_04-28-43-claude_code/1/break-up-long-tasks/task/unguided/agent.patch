+          statusText.textContent = 'Simulation failed: ' + (err.message || 'unknown error');
+          cleanup();
+        };
+
+        setProgress(0);
+        statusText.textContent = 'Starting simulation…';
+        setRunning(true);
+        worker.postMessage({ type: 'run', count: count, target: $('sim-target').value, seed: seed });
+      });
+
+      cancelBtn.addEventListener('click', function () {
+        if (!worker) return;
+        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
+        pendingRender = null;
+        worker.postMessage({ type: 'cancel' });
+        statusText.textContent = 'Cancelling…';
+        cancelBtn.disabled = true;
+        // Hard stop as a fallback if the worker doesn't respond promptly
+        var w = worker;
+        setTimeout(function () {
+          if (worker === w) { statusText.textContent = 'Cancelled.'; cleanup(); }
+        }, 500);
+      });
+
+      window.addEventListener('pagehide', cleanup);
+    })();
+  </script>
+
 </body>
 
