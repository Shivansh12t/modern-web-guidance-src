+        maple: { label: 'Maple', color: '#c26a1b', price: 0.6 },
+        vanilla: { label: 'Vanilla', color: '#f3e3b5', price: 0.6 },
+        caramel: { label: 'Caramel', color: '#a5521c', price: 0.6 },
+        hazelnut: { label: 'Hazelnut', color: '#7a4a2a', price: 0.6 }
