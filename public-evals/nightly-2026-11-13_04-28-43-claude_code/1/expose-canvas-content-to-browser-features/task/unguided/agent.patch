+      const BASE_PRICE = 4.25;
+
+      // HTML-in-Canvas: <canvas layoutsubtree> + ctx.drawElementImage().
+      // Older experimental builds exposed ctx.drawElement() instead.
+      const drawEl = typeof ctx.drawElementImage === 'function' ? 'drawElementImage'
