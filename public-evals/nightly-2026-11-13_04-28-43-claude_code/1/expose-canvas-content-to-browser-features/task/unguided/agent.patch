+
+      let cssW = 0, cssH = 0, dpr = 1, layout = null;
+
+      function computeLayout(w) {
+        const wide = w >= 620;
+        const pad = wide ? 28 : 18;
+        if (wide) {
+          const panelW = Math.min(320, w * 0.42);
+          const panelX = w - pad - panelW;
+          const fieldX = panelX + 22;
+          const fieldW = panelW - 44;
+          const top = pad + 62;
+          const rows = ['name', 'milk', 'syrup', 'summary'].map((k, i) =>
+            ({ key: k, x: fieldX, y: top + i * (FIELD_H + FIELD_GAP), w: fieldW, h: FIELD_H }));
+          const h = rows[3].y + FIELD_H + pad + 22;
+          return {
+            h, wide,
+            panel: { x: panelX, y: pad, w: panelW, h: h - pad * 2 },
+            cup: { cx: (pad + panelX) / 2, cy: h / 2 + 18, size: Math.min(panelX - pad * 2, h - 80) },
+            rows
+          };
+        }
+        const cupH = 290;
+        const panelY = cupH;
+        const fieldX = pad + 18;
+        const fieldW = w - pad * 2 - 36;
+        const top = panelY + 56;
+        const rows = ['name', 'milk', 'syrup', 'summary'].map((k, i) =>
+          ({ key: k, x: fieldX, y: top + i * (FIELD_H + FIELD_GAP - 4), w: fieldW, h: FIELD_H }));
+        const h = rows[3].y + FIELD_H + pad + 18;
