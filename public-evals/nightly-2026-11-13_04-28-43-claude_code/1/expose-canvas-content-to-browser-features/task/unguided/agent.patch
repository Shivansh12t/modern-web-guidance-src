+      const native = !!drawEl && 'layoutSubtree' in canvas;
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Fallback: lift the controls into an overlay positioned over the canvas,
+      // placed at exactly the same CSS-pixel coordinates the canvas draws at.
+      if (!native) {
