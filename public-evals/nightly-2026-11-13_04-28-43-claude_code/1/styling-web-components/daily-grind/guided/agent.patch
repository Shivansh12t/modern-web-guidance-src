+++ b/drink-card.js
@@ -0,0 +1,226 @@
+/**
+ * <drink-card> — encapsulated Seasonal Favorites card.
+ *
+ * Slots
+ *   (default)  description text
+ *   title      drink name (e.g. <h3 slot="title">)
+ *   media      optional image (<img slot="media">) — toggles :state(has-media)
+ *   price      optional price label
+ *   action     call-to-action link
+ *
+ * Attributes
+ *   variant    "classic" (default) | "featured" | "limited"
+ *   badge      optional badge text rendered in the card corner
+ *
+ * Parts (styleable from the page via ::part())
+ *   card, media, badge, body, title, price, actions
+ *
+ * Theme hooks (inherited custom properties; set anywhere above the card)
+ *   --primary, --secondary, --accent, --text, --light  (site palette, inherited from :root)
+ *   --drink-card-bg, --drink-card-radius, --drink-card-shadow,
+ *   --drink-card-accent, --drink-card-padding
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(/* css */ `
+  /* Priority tiers — later layers win. Unlayered page rules (::part, light DOM) beat all of these. */
+  @layer reset, tokens, base, layout, variants, states;
+
+  @layer reset {
+    *, *::before, *::after { box-sizing: border-box; margin: 0; }
+    img { display: block; max-inline-size: 100%; }
+  }
+
+  @layer tokens {
+    :host {
+      /* Private aliases: public props stay unset here so they inherit from anywhere above. */
+      --_bg: var(--drink-card-bg, white);
+      --_fg: var(--text, #3e2723);
+      --_primary: var(--primary, #4e342e);
+      --_secondary: var(--secondary, #d7ccc8);
+      --_accent: var(--drink-card-accent, var(--accent, #ffab40));
+      --_radius: var(--drink-card-radius, 8px);
+      --_shadow: var(--drink-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+      --_pad: var(--drink-card-padding, 20px);
+    }
+  }
+
+  @layer base {
+    :host {
+      display: block; /* custom elements default to inline; containment needs a box */
+      container: drink-card / inline-size;
+      color: var(--_fg);
+      border-radius: var(--_radius);
+    }
+    :host([hidden]) { display: none; }
+
+    .card {
+      block-size: 100%;
+      background: var(--_bg);
+      border-radius: inherit;
+      box-shadow: var(--_shadow);
+      overflow: clip;
+      position: relative;
+      text-align: center;
+      transition: box-shadow 0.3s, translate 0.3s;
+    }
+
+    .media { display: none; }
+    .media ::slotted(img) {
+      inline-size: 100%;
+      block-size: 100%;
+      object-fit: cover;
+    }
+
+    .badge {
+      position: absolute;
+      inset-block-start: 12px;
+      inset-inline-end: 12px;
+      z-index: 1;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: var(--_accent);
+      color: var(--_primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+    }
+    .badge:empty { display: none; }
+
+    .body { padding: var(--_pad); }
+
+    /* Slotted nodes keep UA margins (page reset skips them), so normalize here. */
+    .body > slot:not([name])::slotted(*) { margin: 0; }
+
+    .title ::slotted(*) {
+      margin: 0 0 10px;
+      color: var(--_primary);
+      font-size: 1.17em;
+    }
+
+    .price { color: var(--_primary); font-weight: 700; }
+    .price ::slotted(*) { display: block; margin: 8px 0 0; }
+
+    .actions ::slotted(a) {
+      display: inline-block;
+      margin-block-start: 15px;
+      padding: 10px 20px;
+      border-radius: 5px;
+      background: var(--_primary);
+      color: white;
+      text-decoration: none;
+      transition: background 0.3s;
+    }
+    .actions ::slotted(a:hover) { background: var(--_fg); }
+    .actions ::slotted(a:focus-visible) { outline: 3px solid var(--_accent); outline-offset: 2px; }
+  }
+
+  @layer layout {
+    /* Narrow card: stacked media on top. */
+    :host(:state(has-media)) .media {
+      display: block;
+      aspect-ratio: 16 / 9;
+    }
+
+    /* Roomy card: media beside the body. Responds to the card's own width, not the viewport. */
+    @container drink-card (min-width: 32rem) {
+      :host(:state(has-media)) .card {
+        display: grid;
+        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
+        text-align: start;
+      }
+      :host(:state(has-media)) .media { aspect-ratio: auto; min-block-size: 100%; }
+      .body {
+        display: flex;
+        flex-direction: column;
+        justify-content: center;
+        padding: calc(var(--_pad) * 1.5);
+      }
+      .title ::slotted(*) { font-size: 1.6em; }
+      .actions { margin-block-start: auto; }
+    }
+
+    /* Very narrow card: tighten everything. */
+    @container drink-card (max-width: 14rem) {
+      .body { padding: calc(var(--_pad) * 0.6); }
+      .badge { font-size: 0.65rem; }
+      .actions ::slotted(a) { display: block; padding-inline: 8px; }
+    }
+  }
+
+  @layer variants {
+    /* The host adjusts its own outer styling per variant. */
+    :host([variant="featured"]) {
+      --_bg: var(--drink-card-bg, linear-gradient(160deg, white 55%, var(--_secondary)));
+      --_shadow: var(--drink-card-shadow, 0 8px 24px rgb(78 52 46 / 0.25));
+      outline: 2px solid var(--_accent);
+      outline-offset: 4px;
+    }
+    :host([variant="limited"]) {
+      --_bg: var(--drink-card-bg, var(--_primary));
+      --_fg: var(--light, #fafafa);
+      --_radius: var(--drink-card-radius, 16px);
+    }
+    :host([variant="limited"]) .title ::slotted(*),
+    :host([variant="limited"]) .price { color: var(--_accent); }
+    :host([variant="limited"]) .actions ::slotted(a) {
+      background: var(--_accent);
+      color: var(--_primary);
+    }
+    :host([variant="limited"]) .card { border: 2px dashed var(--_accent); }
+  }
+
+  @layer states {
+    :host(:hover) .card,
+    :host(:focus-within) .card {
+      translate: 0 -3px;
+      box-shadow: 0 10px 24px rgb(0 0 0 / 0.18);
+    }
+    @media (prefers-reduced-motion: reduce) {
+      .card { transition: none; }
+      :host(:hover) .card, :host(:focus-within) .card { translate: none; }
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <span class="badge" part="badge"></span>
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <div class="body" part="body">
+      <div class="title" part="title"><slot name="title"></slot></div>
+      <slot></slot>
+      <div class="price" part="price"><slot name="price"></slot></div>
+      <div class="actions" part="actions"><slot name="action"></slot></div>
+    </div>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['badge'];
+  #internals = this.attachInternals();
+  #badge;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+    this.#badge = root.querySelector('.badge');
+
+    const mediaSlot = root.querySelector('slot[name="media"]');
+    mediaSlot.addEventListener('slotchange', () => {
+      const has = mediaSlot.assignedElements().length > 0;
+      if (has) this.#internals.states.add('has-media');
+      else this.#internals.states.delete('has-media');
+    });
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'badge') this.#badge.textContent = value ?? '';
+  }
+}
+
+if (!customElements.get('drink-card')) customElements.define('drink-card', DrinkCard);
