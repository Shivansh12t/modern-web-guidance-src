+  <!-- No load-time modals, interstitials, or promos: the page never opens overlays the user didn't ask for. -->
+  <script type="module">
+    // Load the popover polyfill only where the Popover API is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    // Hide-on-scroll-down fallback where scroll-state container queries aren't supported.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const bar = document.querySelector('.top-bar');
+      let lastY = scrollY;
+      addEventListener('scroll', () => {
+        const y = Math.max(0, Math.min(scrollY, document.documentElement.scrollHeight - innerHeight));
+        if (y === lastY) return;
+        bar?.classList.toggle('is-hidden', y > lastY && y > bar.offsetHeight);
+        lastY = y;
+      }, { passive: true });
+    }
+  </script>
