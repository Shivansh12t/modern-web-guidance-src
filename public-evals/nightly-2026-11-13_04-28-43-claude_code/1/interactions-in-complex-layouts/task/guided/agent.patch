diff --git a/board.css b/board.css
new file mode 100644
--- a/board.css
+++ b/board.css
@@ -0,0 +1,347 @@
+/* ==========================================================
+   Barista order-tracking board
+   ========================================================== */
+.board-section {
+  --drop-marker-color: var(--accent);
+  --drop-line-size: 3px;
+  --board-gap: 12px;
+  --lift-shadow: 0 12px 28px rgba(62, 39, 35, 0.28), 0 4px 8px rgba(62, 39, 35, 0.18);
+  margin-top: 60px;
+}
+
+.board-section > h2 {
+  text-align: center;
+}
+
+.board-intro {
+  text-align: center;
+  color: #6d4c41;
+  margin-bottom: 20px;
+}
+
+/* ---------- New order form ---------- */
+.order-form {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
+  gap: 10px 14px;
+  align-items: end;
+  background: white;
+  border-radius: 8px;
+  padding: 16px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-bottom: 24px;
+}
+
+.order-form label {
+  display: grid;
+  gap: 4px;
+  font-size: 0.8rem;
+  font-weight: 600;
+  color: var(--primary);
+}
+
+.order-form input,
+.order-form select {
+  width: 100%;
+  font: inherit;
+  font-size: 0.9rem;
+  padding: 7px 9px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+  background: var(--light);
+  color: var(--text);
+}
+
+.order-form input:focus-visible,
+.order-form select:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.order-form button {
+  font: inherit;
+  font-weight: 600;
+  border: 0;
+  border-radius: 5px;
+  padding: 9px 14px;
+  background: var(--primary);
+  color: white;
+  cursor: pointer;
+}
+
+.order-form button:hover,
+.order-form button:focus-visible {
+  background: var(--text);
+}
+
+/* ---------- Board ---------- */
+.board {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 18px;
+  align-items: start;
+}
+
+@media (max-width: 760px) {
+  .board {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+.board-column {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  min-height: 260px;
+  background: #efebe9;
+  border-radius: 10px;
+  border-top: 5px solid var(--column-color, var(--primary));
+
+  /* Isolate each column's rendering: changes inside one column
+     (card moves, timer updates) can't trigger layout/style/paint
+     work in the rest of the board. */
+  content-visibility: auto;
+  contain-intrinsic-size: auto 320px auto 480px;
+}
+
+@supports not (content-visibility: auto) {
+  .board-column {
+    contain: layout style paint;
+  }
+}
+
+/* While a card is lifted out of (or animating into) a column, drop
+   only the paint clip so the card can travel across columns.
+   Layout and style containment stay in place. */
+.board-column.is-drag-active {
+  content-visibility: visible;
+  contain: layout style;
+  z-index: 2;
+}
+
+.board-column[data-status="queued"] { --column-color: #8d6e63; }
+.board-column[data-status="brewing"] { --column-color: #ffab40; }
+.board-column[data-status="ready"] { --column-color: #43a047; }
+
+.board-column.is-drop-target {
+  background: #e7dfdb;
+  box-shadow: inset 0 0 0 2px var(--drop-marker-color);
+}
+
+.column-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 12px 14px 4px;
+}
+
+.column-header h3 {
+  font-size: 1rem;
+  color: var(--primary);
+  letter-spacing: 0.5px;
+  text-transform: uppercase;
+}
+
+.column-count {
+  min-width: 1.8em;
+  text-align: center;
+  font-size: 0.8rem;
+  font-weight: 700;
+  padding: 1px 8px;
+  border-radius: 999px;
+  background: var(--column-color);
+  color: white;
+}
+
+.board-column[data-status="brewing"] .column-count {
+  color: var(--text);
+}
+
+.card-list {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: var(--board-gap);
+  list-style: none;
+  padding: 10px 12px 14px;
+  flex: 1;
+}
+
+.column-empty {
+  display: none;
+  margin: 0 12px 14px;
+  padding: 18px 10px;
+  border: 2px dashed #d7ccc8;
+  border-radius: 8px;
+  text-align: center;
+  font-size: 0.85rem;
+  color: #8d6e63;
+}
+
+.board-column:not(:has(.card)) .column-empty {
+  display: block;
+}
+
+/* Drop marker: a line drawn in the gap where the card will land. */
+.card-list[data-drop]::after {
+  content: "";
+  position: absolute;
+  left: 10px;
+  right: 10px;
+  top: var(--drop-y, 0);
+  height: var(--drop-line-size);
+  translate: 0 -50%;
+  border-radius: var(--drop-line-size);
+  background: var(--drop-marker-color);
+  pointer-events: none;
+}
+
+@media (forced-colors: active) {
+  .card-list[data-drop]::after {
+    background: Highlight;
+  }
+}
+
+/* ---------- Order cards ---------- */
+.board .card {
+  position: relative;
+  text-align: start;
+  padding: 10px 12px 12px;
+  border-radius: 8px;
+  border-left: 4px solid var(--column-color, var(--primary));
+  scroll-margin: 16px;
+}
+
+.board .card:has(.card-handle:focus-visible) {
+  outline: 3px solid var(--primary);
+  outline-offset: 2px;
+}
+
+.board .card.is-lifted {
+  z-index: 10;
+  scale: 1.03;
+  box-shadow: var(--lift-shadow);
+  pointer-events: none;
+}
+
+.card-head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.78rem;
+  color: #8d6e63;
+}
+
+.card-handle {
+  display: inline-grid;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  margin-left: -4px;
+  border: 0;
+  border-radius: 5px;
+  background: transparent;
+  color: #a1887f;
+  font-size: 1.1rem;
+  line-height: 1;
+  cursor: grab;
+  touch-action: none;
+  -webkit-user-select: none;
+  user-select: none;
+}
+
+.card-handle:is(:hover, :focus-visible) {
+  background: var(--secondary);
+  color: var(--primary);
+  outline: none;
+}
+
+html.is-dragging,
+html.is-dragging * {
+  cursor: grabbing !important;
+}
+
+.card-number {
+  font-weight: 700;
+  color: var(--primary);
+}
+
+.card-age {
+  margin-left: auto;
+  font-variant-numeric: tabular-nums;
+}
+
+.card-age.is-late {
+  color: #c62828;
+  font-weight: 700;
+}
+
+.board .card h4 {
+  font-size: 1rem;
+  color: var(--primary);
+  margin-top: 4px;
+  line-height: 1.3;
+}
+
+.card-meta,
+.card-customer,
+.card-notes {
+  font-size: 0.85rem;
+}
+
+.card-meta {
+  color: #6d4c41;
+}
+
+.card-notes {
+  font-style: italic;
+  color: #795548;
+}
+
+.card-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 10px;
+}
+
+.card-actions button {
+  flex: 1 1 auto;
+  font: inherit;
+  font-size: 0.78rem;
+  font-weight: 600;
+  padding: 5px 8px;
+  border-radius: 5px;
+  border: 1px solid var(--secondary);
+  background: var(--light);
+  color: var(--primary);
+  cursor: pointer;
+}
+
+.card-actions button:is(:hover, :focus-visible) {
+  background: var(--secondary);
+}
+
+.card-actions button:focus-visible {
+  outline: 2px solid var(--primary);
+  outline-offset: 1px;
+}
+
+.card-actions .card-done {
+  background: #43a047;
+  border-color: #43a047;
+  color: white;
+}
+
+.card-actions .card-done:is(:hover, :focus-visible) {
+  background: #2e7d32;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
