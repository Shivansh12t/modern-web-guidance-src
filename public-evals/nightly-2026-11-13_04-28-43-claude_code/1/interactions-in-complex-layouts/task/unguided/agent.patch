+
+  <script>
+    (function () {
+      'use strict';
+
+      var STATUSES = ['queued', 'brewing', 'ready'];
+      var STORAGE_KEY = 'daily-grind-order-board-v1';
+
+      // ---- State: one independent order list per column ----
+      var columns = {};
+
+      function seedState() {
+        return {
+          queued: [
+            { id: 'A101', customer: 'Maya', drink: 'Maple Oat Latte', size: 'Medium' },
+            { id: 'A102', customer: 'Jordan', drink: 'Cold Brew', size: 'Large' }
+          ],
+          brewing: [
+            { id: 'A100', customer: 'Sam', drink: 'Dark Roast Espresso', size: 'Small' }
+          ],
+          ready: [
+            { id: 'A099', customer: 'Priya', drink: 'Cappuccino', size: 'Medium' }
+          ]
+        };
+      }
+
+      function loadState() {
+        try {
+          var raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            var parsed = JSON.parse(raw);
+            if (parsed && STATUSES.every(function (s) { return Array.isArray(parsed[s]); })) {
+              return parsed;
+            }
+          }
+        } catch (e) { /* ignore storage / parse errors */ }
+        return seedState();
+      }
+
+      function saveState() {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(columns)); } catch (e) { /* ignore */ }
+      }
+
+      var nextIdNum = 103;
+
+      function newId() {
+        var all = STATUSES.reduce(function (acc, s) { return acc.concat(columns[s]); }, []);
+        all.forEach(function (o) {
+          var n = parseInt(String(o.id).replace(/\D/g, ''), 10);
+          if (!isNaN(n) && n >= nextIdNum) nextIdNum = n + 1;
+        });
+        return 'A' + (nextIdNum++);
+      }
+
+      // ---- Isolated column rendering ----
+      // Each column owns its own DOM subtree and is re-rendered only when
+      // its own order list changes. A move touches at most two columns.
+      var columnEls = {};
+      document.querySelectorAll('#board .board-column').forEach(function (el) {
+        columnEls[el.dataset.status] = {
+          root: el,
+          list: el.querySelector('.card-list'),
+          count: el.querySelector('.column-count')
+        };
+      });
+
+      function createCard(order, status) {
+        var idx = STATUSES.indexOf(status);
+        var li = document.createElement('li');
+        li.className = 'card';
+        li.draggable = true;
+        li.tabIndex = 0;
+        li.dataset.orderId = order.id;
+        li.dataset.status = status;
+        li.setAttribute('aria-label', order.drink + ' for ' + order.customer + ', ' + status);
+
+        var top = document.createElement('div');
+        top.className = 'card-top';
+        var drink = document.createElement('span');
+        drink.className = 'card-drink';
+        drink.textContent = order.drink;
+        var id = document.createElement('span');
+        id.className = 'card-id';
+        id.textContent = '#' + order.id;
+        top.appendChild(drink);
+        top.appendChild(id);
+
+        var meta = document.createElement('div');
+        meta.className = 'card-meta';
+        meta.textContent = order.size + ' · ' + order.customer;
+
+        var actions = document.createElement('div');
+        actions.className = 'card-actions';
+
+        var back = document.createElement('button');
+        back.type = 'button';
+        back.dataset.action = 'back';
+        back.textContent = '←';
+        back.title = 'Move back';
+        back.setAttribute('aria-label', 'Move order back');
+        back.disabled = idx === 0;
+
+        var fwd = document.createElement('button');
+        fwd.type = 'button';
+        fwd.dataset.action = 'forward';
+        fwd.textContent = '→';
+        fwd.title = 'Move forward';
+        fwd.setAttribute('aria-label', 'Move order forward');
+        fwd.disabled = idx === STATUSES.length - 1;
+
+        actions.appendChild(back);
+        actions.appendChild(fwd);
+
+        if (status === 'ready') {
+          var done = document.createElement('button');
+          done.type = 'button';
+          done.dataset.action = 'complete';
+          done.textContent = 'Picked up';
+          done.setAttribute('aria-label', 'Mark order picked up');
+          actions.appendChild(done);
+        }
+
+        li.appendChild(top);
+        li.appendChild(meta);
+        li.appendChild(actions);
+        return li;
+      }
+
+      function renderColumn(status) {
+        var els = columnEls[status];
+        var orders = columns[status];
+        var frag = document.createDocumentFragment();
+        if (orders.length === 0) {
+          var empty = document.createElement('li');
+          empty.className = 'empty';
+          empty.textContent = 'No orders';
+          frag.appendChild(empty);
+        } else {
+          orders.forEach(function (o) { frag.appendChild(createCard(o, status)); });
+        }
+        els.list.replaceChildren(frag);
+        els.count.textContent = String(orders.length);
+      }
+
+      function commit(changed) {
+        // Deduplicate and render only the affected columns.
+        changed.filter(function (s, i) { return changed.indexOf(s) === i; }).forEach(renderColumn);
+        saveState();
+      }
+
+      // ---- Mutations ----
+      function findOrder(id) {
+        for (var i = 0; i < STATUSES.length; i++) {
+          var s = STATUSES[i];
+          var idx = columns[s].findIndex(function (o) { return o.id === id; });
+          if (idx !== -1) return { status: s, index: idx };
+        }
+        return null;
+      }
+
+      function moveOrder(id, toStatus, toIndex) {
+        var loc = findOrder(id);
+        if (!loc || STATUSES.indexOf(toStatus) === -1) return;
+        var order = columns[loc.status].splice(loc.index, 1)[0];
+        var target = columns[toStatus];
+        if (typeof toIndex !== 'number' || toIndex < 0 || toIndex > target.length) {
+          toIndex = target.length;
+        } else if (loc.status === toStatus && loc.index < toIndex) {
+          toIndex -= 1; // account for removal earlier in the same list
+        }
+        target.splice(toIndex, 0, order);
+        commit([loc.status, toStatus]);
+      }
+
+      function removeOrder(id) {
+        var loc = findOrder(id);
+        if (!loc) return;
+        columns[loc.status].splice(loc.index, 1);
+        commit([loc.status]);
+      }
+
+      function shiftOrder(id, delta, refocus) {
+        var loc = findOrder(id);
+        if (!loc) return;
+        var to = STATUSES.indexOf(loc.status) + delta;
+        if (to < 0 || to >= STATUSES.length) return;
+        moveOrder(id, STATUSES[to]);
+        if (refocus) {
+          var card = columnEls[STATUSES[to]].list.querySelector('[data-order-id="' + id + '"]');
+          if (card) card.focus();
+        }
+      }
+
+      // ---- Drag & drop (delegated per column, so re-renders need no rebinding) ----
+      var draggingId = null;
+
+      function clearIndicators() {
+        document.querySelectorAll('#board .drag-over').forEach(function (el) { el.classList.remove('drag-over'); });
+        document.querySelectorAll('#board .drop-before').forEach(function (el) { el.classList.remove('drop-before'); });
+      }
+
+      function cardAfterPointer(list, y) {
+        var cards = Array.prototype.slice.call(list.querySelectorAll('.card:not(.dragging)'));
+        for (var i = 0; i < cards.length; i++) {
+          var r = cards[i].getBoundingClientRect();
+          if (y < r.top + r.height / 2) return cards[i];
+        }
+        return null;
+      }
+
+      STATUSES.forEach(function (status) {
+        var els = columnEls[status];
+        var root = els.root;
+
+        root.addEventListener('dragstart', function (e) {
+          var card = e.target.closest && e.target.closest('.card');
+          if (!card) return;
+          draggingId = card.dataset.orderId;
+          card.classList.add('dragging');
+          if (e.dataTransfer) {
+            e.dataTransfer.effectAllowed = 'move';
+            try { e.dataTransfer.setData('text/plain', draggingId); } catch (err) { /* ignore */ }
+          }
+        });
+
+        root.addEventListener('dragend', function (e) {
+          var card = e.target.closest && e.target.closest('.card');
+          if (card) card.classList.remove('dragging');
+          draggingId = null;
+          clearIndicators();
+        });
+
+        root.addEventListener('dragover', function (e) {
+          e.preventDefault();
+          if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
+          if (!root.classList.contains('drag-over')) {
+            clearIndicators();
+            root.classList.add('drag-over');
+          }
+          root.querySelectorAll('.drop-before').forEach(function (el) { el.classList.remove('drop-before'); });
+          var after = cardAfterPointer(els.list, e.clientY);
+          if (after) after.classList.add('drop-before');
+        });
+
+        root.addEventListener('dragenter', function (e) { e.preventDefault(); });
+
+        root.addEventListener('dragleave', function (e) {
+          if (!root.contains(e.relatedTarget)) {
+            root.classList.remove('drag-over');
+            root.querySelectorAll('.drop-before').forEach(function (el) { el.classList.remove('drop-before'); });
+          }
+        });
+
+        root.addEventListener('drop', function (e) {
+          e.preventDefault();
+          var id = draggingId;
+          if (!id && e.dataTransfer) {
+            try { id = e.dataTransfer.getData('text/plain'); } catch (err) { /* ignore */ }
+          }
+          var after = cardAfterPointer(els.list, e.clientY);
+          clearIndicators();
+          draggingId = null;
+          if (!id) return;
+          var toIndex;
+          if (after) {
+            toIndex = columns[status].findIndex(function (o) { return o.id === after.dataset.orderId; });
+          }
+          moveOrder(id, status, toIndex === -1 ? undefined : toIndex);
+        });
+
+        // Button + keyboard controls
+        root.addEventListener('click', function (e) {
+          var btn = e.target.closest('button[data-action]');
+          if (!btn) return;
+          var card = btn.closest('.card');
+          if (!card) return;
+          var id = card.dataset.orderId;
+          if (btn.dataset.action === 'back') shiftOrder(id, -1, false);
+          else if (btn.dataset.action === 'forward') shiftOrder(id, 1, false);
+          else if (btn.dataset.action === 'complete') removeOrder(id);
+        });
+
+        root.addEventListener('keydown', function (e) {
+          var card = e.target;
+          if (!card.classList || !card.classList.contains('card')) return;
+          if (e.key === 'ArrowRight') { e.preventDefault(); shiftOrder(card.dataset.orderId, 1, true); }
+          else if (e.key === 'ArrowLeft') { e.preventDefault(); shiftOrder(card.dataset.orderId, -1, true); }
+        });
+      });
+
+      // ---- New order form ----
+      var form = document.getElementById('order-form');
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var customer = form.customer.value.trim();
+        if (!customer) return;
+        columns.queued.push({
+          id: newId(),
+          customer: customer,
+          drink: form.drink.value,
+          size: form.size.value
+        });
+        commit(['queued']);
+        form.customer.value = '';
+        form.customer.focus();
+      });
+
+      // ---- Init ----
+      columns = loadState();
+      STATUSES.forEach(renderColumn);
+    })();
+  </script>
+
 </body>
 
