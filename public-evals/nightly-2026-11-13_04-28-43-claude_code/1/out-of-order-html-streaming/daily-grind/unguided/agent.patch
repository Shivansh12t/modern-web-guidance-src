+  <!--
+    Real cards, streamed later in the same HTML response. With native
+    declarative partial updates, this template replaces the placeholder
+    range named "seasonal-cards" as soon as it is parsed.
+  -->
+  <template for="seasonal-cards">
+    <div class="card">
+      <img src="https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80" alt="Latte with latte art" loading="lazy" width="600" height="400">
