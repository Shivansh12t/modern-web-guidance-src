+  <script type="module">
+    // Seasonal Favorites: in-place updates using native browser APIs, with
+    // feature detection and conservative fallbacks.
+    //
+    // Trust levels:
+    //   cards   -> our server, trusted HTML, no scripts   (streamHTMLUnsafe / setHTMLUnsafe)
+    //   reviews -> customer content, UNTRUSTED            (streamHTML / setHTML — sanitized)
+    //   promo   -> our CMS, trusted, needs its <script>   (script-executing insertion)
+
+    const ENDPOINTS = {
+      cards: '/fragments/seasonal-favorites/cards',
+      reviews: '/fragments/seasonal-favorites/reviews',
+      promo: '/cms/fragments/seasonal-promo',
+      events: '/api/menu/events', // Server-Sent Events: emits "menu-changed"
+    };
+
+    const cardsEl = document.getElementById('seasonal-cards');
+    const reviewsEl = document.getElementById('seasonal-reviews');
+    const promoEl = document.getElementById('seasonal-promo');
+    const statusEl = document.getElementById('menu-status');
+
+    const proto = Element.prototype;
+    const has = (name) => typeof proto[name] === 'function';
+
+    // ---- Fallback for declarative <template for> patching ------------------
+    // Without native support, <?start ...?>/<?end ...?> parse as comments and
+    // <template for> stays inert, so apply it ourselves.
+    function applyPendingPatches() {
+      for (const tpl of document.querySelectorAll('template[for]')) {
+        const name = tpl.getAttribute('for');
+        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_COMMENT);
+        let start = null, end = null;
+        while (walker.nextNode()) {
+          const data = walker.currentNode.data.trim();
+          if (!start && data === `?start name="${name}"`) start = walker.currentNode;
+          else if (start && data === `?end name="${name}"`) { end = walker.currentNode; break; }
+        }
+        if (!start || !end || start.parentNode !== end.parentNode) continue;
+        const range = document.createRange();
+        range.setStartAfter(start);
+        range.setEndBefore(end);
+        range.deleteContents();
+        range.insertNode(tpl.content.cloneNode(true));
+        tpl.remove();
+      }
+    }
+    applyPendingPatches();
+    if (!cardsEl.querySelector('.skeleton')) cardsEl.removeAttribute('aria-busy');
+
+    // ---- Fetch helpers ------------------------------------------------------
+    async function fetchFragment(url, { signal } = {}) {
+      const res = await fetch(url, {
+        signal,
+        credentials: 'same-origin',
+        headers: { Accept: 'text/html' },
+        cache: 'no-store',
+      });
+      if (!res.ok) throw new Error(`${url} -> HTTP ${res.status}`);
+      const type = res.headers.get('content-type') || '';
+      if (!type.includes('text/html')) throw new Error(`${url} -> unexpected content-type ${type}`);
+      return res;
+    }
+
+    async function pipeInto(res, writable) {
+      await res.body.pipeThrough(new TextDecoderStream()).pipeTo(writable);
+    }
+
+    // Trusted server HTML (cards). No script execution needed.
+    async function renderTrusted(el, res) {
+      if (has('streamHTMLUnsafe') && res.body) return pipeInto(res, el.streamHTMLUnsafe());
+      const html = await res.text();
+      if (has('setHTMLUnsafe')) el.setHTMLUnsafe(html);
+      else el.innerHTML = html;
+    }
+
+    // Untrusted user HTML (reviews). Always sanitized; never an *Unsafe API.
+    async function renderUntrusted(el, res) {
+      if (has('streamHTML') && res.body) return pipeInto(res, el.streamHTML());
+      const html = await res.text();
+      if (has('setHTML')) {
+        el.setHTML(html); // Sanitizer API default config: drops script, on*, javascript: URLs
+        return;
+      }
+      // No Sanitizer API: parse inertly and render as plain text only.
+      const doc = new DOMParser().parseFromString(html, 'text/html');
+      const items = doc.querySelectorAll('.review');
+      const frag = document.createDocumentFragment();
+      for (const item of items.length ? items : [doc.body]) {
+        const p = document.createElement('blockquote');
+        p.className = 'review';
+        p.textContent = item.textContent.trim();
+        frag.append(p);
+      }
+      el.replaceChildren(frag);
+    }
+
+    // Trusted CMS HTML with its own widget <script> (promo).
+    async function renderTrustedWithScripts(el, res) {
+      const html = await res.text();
+      // Scripts parsed via createContextualFragment are executable on insertion
+      // (unlike innerHTML / setHTMLUnsafe, which leave them inert). This is used
+      // only for the same-origin CMS endpoint, never for user content.
+      const range = document.createRange();
+      range.selectNodeContents(el);
+      el.replaceChildren(range.createContextualFragment(html));
+    }
+
+    // ---- Refresh orchestration ---------------------------------------------
+    let inflight = null;
+
+    async function refresh(parts = ['cards', 'reviews', 'promo']) {
+      inflight?.abort();
+      const controller = new AbortController();
+      inflight = controller;
+      const { signal } = controller;
+
+      const jobs = {
+        cards: () => fetchFragment(ENDPOINTS.cards, { signal }).then((r) => renderTrusted(cardsEl, r)),
+        reviews: () => fetchFragment(ENDPOINTS.reviews, { signal }).then((r) => renderUntrusted(reviewsEl, r)),
+        promo: () => fetchFragment(ENDPOINTS.promo, { signal }).then((r) => renderTrustedWithScripts(promoEl, r)),
+      };
+      const targets = { cards: cardsEl, reviews: reviewsEl, promo: promoEl };
+
+      const results = await Promise.allSettled(parts.map(async (part) => {
+        const el = targets[part];
+        el.setAttribute('aria-busy', 'true');
+        try { await jobs[part](); }
+        finally { el.removeAttribute('aria-busy'); }
+      }));
+
+      if (signal.aborted) return;
+      const failed = results.filter((r) => r.status === 'rejected');
+      failed.forEach((r) => console.warn('[seasonal] refresh failed:', r.reason));
+      statusEl.textContent = failed.length
+        ? 'Some menu items could not be refreshed. Showing the last known menu.'
+        : '';
+      if (inflight === controller) inflight = null;
+    }
+
+    // Initial load of the runtime-only parts (cards were streamed in the document).
+    refresh(['reviews', 'promo']);
+
+    // Re-render whenever the menu changes on the server.
+    if ('EventSource' in window) {
+      const events = new EventSource(ENDPOINTS.events);
+      events.addEventListener('menu-changed', () => {
+        statusEl.textContent = 'Menu updated — refreshing…';
+        refresh();
+      });
+      events.addEventListener('reviews-changed', () => refresh(['reviews']));
+    }
+
+    // Catch up after the tab was hidden (SSE may have been throttled/dropped).
+    document.addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'visible') refresh();
+    });
+  </script>
+
