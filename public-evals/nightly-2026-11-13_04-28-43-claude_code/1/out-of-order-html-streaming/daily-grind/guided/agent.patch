+
+  <!--
+    Reviews are user-submitted. Declarative <template for> does NOT sanitize, so the
+    server MUST escape/sanitize review text before emitting this block (the client
+    refresh path below additionally sanitizes with the Sanitizer API).
+  -->
+  <template for="seasonal-reviews">
+    <h3>What customers are saying</h3>
+    <ul>
+      <li>
+        <blockquote>
+          <p>The Maple Oat Latte tastes like autumn in a cup. <strong>Obsessed.</strong></p>
+          <cite>— Priya S.</cite>
+        </blockquote>
+      </li>
+      <li>
+        <blockquote>
+          <p>Smoothest cold brew in town, no contest.</p>
+          <cite>— Marcus T.</cite>
+        </blockquote>
+      </li>
+    </ul>
+  </template>
+
+  <!-- Promo from our CMS. Its widget script runs when the template is patched in. -->
+  <template for="seasonal-promo">
+    <h3>Pumpkin Spice Week</h3>
+    <p>Members get a free size upgrade on any seasonal drink through Sunday.</p>
+    <div class="promo-widget" data-campaign="pumpkin-week-2026"></div>
+    <script src="https://cms.thedailygrind.example/widgets/promo-countdown.js" async></script>
+  </template>
+
+  <script>
+    // Mark the declaratively streamed regions as ready once the document has finished.
+    // (Templates may patch in any order; DOMContentLoaded fires after all have arrived.)
+    document.addEventListener('DOMContentLoaded', () => {
+      for (const id of ['seasonal-cards', 'seasonal-reviews', 'seasonal-promo']) {
+        document.getElementById(id)?.setAttribute('aria-busy', 'false');
+      }
+      const status = document.getElementById('seasonal-status');
+      if (status) status.textContent = 'Seasonal favorites loaded.';
+    });
+  </script>
+
+  <script type="module">
+    // ===================================================================
+    // Live refresh: whenever the menu changes, pull fresh HTML for each part
+    // of the Seasonal Favorites section from the server and update in place.
+    //   - Cards   -> streamHTML()      (safe; first-party but needs no scripts)
+    //   - Reviews -> streamHTML() with a strict Sanitizer (untrusted UGC)
+    //   - Promo   -> setHTMLUnsafe({ runScripts: true }) (trusted CMS + widget)
+    // ===================================================================
+
+    const section = document.getElementById('seasonal-favorites');
+    const base = section.dataset.refreshSrc;
+    const status = document.getElementById('seasonal-status');
+    const heading = document.getElementById('seasonal-heading');
+    const regions = {
+      cards: document.getElementById('seasonal-cards'),
+      reviews: document.getElementById('seasonal-reviews'),
+      promo: document.getElementById('seasonal-promo'),
+    };
+
+    // Strict allowlist for customer reviews. Elements outside `elements` are removed
+    // with their content; `div`/`span` wrappers are unwrapped so text survives.
+    const REVIEW_SANITIZER = {
+      elements: ['h3', 'ul', 'li', 'blockquote', 'p', 'cite', 'strong', 'em', 'b', 'i', 'br'],
+      attributes: [],
+      replaceWithChildrenElements: ['div', 'span'],
+    };
+    // Cards: default safe sanitizer + allow the attributes the card markup uses.
+    const CARD_SANITIZER = {
+      elements: ['article', 'img', 'h3', 'p', 'a', 'strong', 'em'],
+      attributes: ['class', 'href', 'src', 'alt', 'width', 'height', 'loading', 'decoding', 'data-item'],
+    };
+
+    // Load the HTML setters polyfill (streamHTML, setHTMLUnsafe runScripts, …) only
+    // where the native methods are missing.
+    function loadScript(src) {
+      return new Promise((resolve, reject) => {
+        const s = document.createElement('script');
+        s.src = src;
+        s.onload = resolve;
+        s.onerror = reject;
+        document.head.append(s);
+      });
+    }
+    if (!('streamHTML' in Element.prototype)) {
+      await loadScript('https://unpkg.com/html-setters-polyfill@0.1.1/index.js');
+    }
+
+    // Safari has no native Sanitizer, and the setters polyfill can't do safe parsing
+    // without it — fall back to DOMPurify (loaded on demand) with matching rules.
+    let domPurifyPromise;
+    const loadDOMPurify = () =>
+      (domPurifyPromise ??= import('https://esm.sh/dompurify@3').then((m) => m.default ?? m));
+
+    async function safeStreamInto(el, response, sanitizer, signal) {
+      if ('setHTML' in Element.prototype) {
+        await response.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(el.streamHTML({ sanitizer }), { signal });
+        return;
+      }
+      const html = await response.text();
+      signal.throwIfAborted();
+      const DOMPurify = await loadDOMPurify();
+      const fragment = DOMPurify.sanitize(html, {
+        ALLOWED_TAGS: [...sanitizer.elements, '#text'],
+        ALLOWED_ATTR: sanitizer.attributes,
+        ALLOW_ARIA_ATTR: false,
+        ALLOW_DATA_ATTR: false, // explicitly listed data-* attrs (e.g. data-item) still pass
+        KEEP_CONTENT: Boolean(sanitizer.replaceWithChildrenElements),
+        RETURN_DOM_FRAGMENT: true,
+      });
+      el.replaceChildren(fragment);
+    }
+
+    async function fetchPart(part, signal) {
+      const res = await fetch(`${base}/${part}`, {
+        signal,
+        headers: { Accept: 'text/html' },
+        cache: 'no-store',
+      });
+      if (!res.ok) throw new Error(`${part}: HTTP ${res.status}`);
+      return res;
+    }
+
+    // Keep focus from being lost if the focused element is inside a region we replace.
+    function captureFocus() {
+      const active = document.activeElement;
+      if (!active || !section.contains(active)) return null;
+      const item = active.closest('[data-item]')?.dataset.item;
+      return { item };
+    }
+    function restoreFocus(saved) {
+      if (!saved || section.contains(document.activeElement)) return;
+      const target = saved.item
+        ? regions.cards.querySelector(`[data-item="${CSS.escape(saved.item)}"] a`)
+        : null;
+      (target ?? heading).focus({ preventScroll: true });
+    }
+
+    let controller;
+    async function refreshSeasonal() {
+      controller?.abort(); // a newer menu change supersedes an in-flight refresh
+      controller = new AbortController();
+      const { signal } = controller;
+      const savedFocus = captureFocus();
+
+      for (const el of Object.values(regions)) el.setAttribute('aria-busy', 'true');
+      status.textContent = 'Updating seasonal favorites…';
+
+      const tasks = {
+        cards: fetchPart('cards', signal).then((res) =>
+          safeStreamInto(regions.cards, res, CARD_SANITIZER, signal)),
+        reviews: fetchPart('reviews', signal).then((res) =>
+          safeStreamInto(regions.reviews, res, REVIEW_SANITIZER, signal)),
+        // Trusted, first-party CMS markup only: unsafe setter so the widget <script> runs.
+        promo: fetchPart('promo', signal)
+          .then((res) => res.text())
+          .then((html) => {
+            signal.throwIfAborted();
+            regions.promo.setHTMLUnsafe(html, { runScripts: true });
+          }),
+      };
+
+      const names = Object.keys(tasks);
+      const results = await Promise.allSettled(Object.values(tasks));
+      if (signal.aborted) return;
+
+      results.forEach((r, i) => {
+        regions[names[i]].setAttribute('aria-busy', 'false');
+        if (r.status === 'rejected') console.error('Seasonal refresh failed:', r.reason);
+      });
+      restoreFocus(savedFocus);
+      status.textContent = results.every((r) => r.status === 'fulfilled')
+        ? 'Seasonal favorites updated.'
+        : 'Some seasonal favorites could not be updated.';
+    }
+
+    // The server pushes a "menu-changed" event whenever the menu is edited.
+    const events = new EventSource('/api/menu/events');
+    events.addEventListener('menu-changed', refreshSeasonal);
+
+    // Same-origin tabs (e.g. an admin editing the menu) can also trigger a refresh.
+    new BroadcastChannel('daily-grind-menu').addEventListener('message', (e) => {
+      if (e.data?.type === 'menu-changed') refreshSeasonal();
+    });
+  </script>
+
