+      /* ----- Expand each detail dialog out of the button that opened it ----- */
+      function setOriginFrom(trigger, dialog) {
+        const r = trigger.getBoundingClientRect();
+        const dx = r.left + r.width / 2 - window.innerWidth / 2;
+        const dy = r.top + r.height / 2 - window.innerHeight / 2;
+        // Approximate the button's size relative to the final dialog width.
+        const dialogWidth = Math.min(34 * 16, window.innerWidth - 32);
+        const scale = Math.max(0.08, Math.min(0.5, r.width / dialogWidth));
+        dialog.style.setProperty('--from-x', `${dx}px`);
+        dialog.style.setProperty('--from-y', `${dy}px`);
+        dialog.style.setProperty('--from-scale', scale.toFixed(3));
+      }
+
+      // Exit transitions of top-layer elements need `overlay` + discrete `display` transitions.
+      let displayTransitionSupport;
+      function canTransitionDisplay() {
+        if (displayTransitionSupport !== undefined) return displayTransitionSupport;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return (displayTransitionSupport = false);
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        displayTransitionSupport = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return displayTransitionSupport;
+      }
+      const supportsTopLayerExit = () => window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+
+      async function closeDialog(dialog) {
+        if (!dialog.open) return;
+        if (!supportsTopLayerExit()) {
+          dialog.setAttribute('data-closing', '');
+          const animations = dialog.getAnimations({ subtree: true });
+          if (animations.length) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 1000)),
+            ]);
+          }
+          if (!dialog.hasAttribute('data-closing')) return;
+          dialog.removeAttribute('data-closing');
+        }
+        dialog.close();
+      }
+
+      document.querySelectorAll('button[commandfor]').forEach((button) => {
+        const dialog = document.getElementById(button.getAttribute('commandfor'));
+        if (!(dialog instanceof HTMLDialogElement)) return;
+        const command = button.getAttribute('command');
+
+        button.addEventListener('click', (event) => {
