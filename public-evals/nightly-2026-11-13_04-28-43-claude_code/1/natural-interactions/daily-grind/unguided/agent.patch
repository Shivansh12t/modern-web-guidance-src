+          <a class="btn" href="/order-online" data-detail-order>Order this drink</a>
+          <a class="btn btn-ghost" href="#" data-detail-link>Full menu page</a>
+        </div>
+      </div>
+    </div>
+  </dialog>
+
+  <script>
+    (function () {
+      'use strict';
+
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      /* ================= Carousel ================= */
+      var track = document.getElementById('seasonal-track');
+      var prevBtn = document.querySelector('[data-carousel-prev]');
+      var nextBtn = document.querySelector('[data-carousel-next]');
+
+      function scrollBehavior() {
+        return reduceMotion.matches ? 'auto' : 'smooth';
+      }
+
+      function stepSize() {
+        var item = track.querySelector('li');
+        if (!item) return track.clientWidth;
+        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
+        return item.getBoundingClientRect().width + gap;
+      }
+
+      function updateControls() {
+        var max = track.scrollWidth - track.clientWidth - 1;
+        prevBtn.disabled = track.scrollLeft <= 1;
+        nextBtn.disabled = track.scrollLeft >= max;
+      }
+
+      // Keep focus on a usable control if the one just pressed becomes disabled.
+      function moveFocusIfDisabled(btn, other) {
+        if (btn.disabled && document.activeElement === btn) other.focus();
+      }
+
+      prevBtn.addEventListener('click', function () {
+        track.scrollBy({ left: -stepSize(), behavior: scrollBehavior() });
+      });
+      nextBtn.addEventListener('click', function () {
+        track.scrollBy({ left: stepSize(), behavior: scrollBehavior() });
+      });
+
+      var scrollTimer;
+      track.addEventListener('scroll', function () {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(function () {
+          updateControls();
+          moveFocusIfDisabled(prevBtn, nextBtn);
+          moveFocusIfDisabled(nextBtn, prevBtn);
+        }, 60);
+      }, { passive: true });
+      window.addEventListener('resize', updateControls);
+      updateControls();
+
+      // Arrow / Home / End keys when the track itself is focused.
+      track.addEventListener('keydown', function (e) {
+        if (e.target !== track) return;
+        var delta = null;
+        if (e.key === 'ArrowRight') delta = stepSize();
+        else if (e.key === 'ArrowLeft') delta = -stepSize();
+        if (delta !== null) {
+          e.preventDefault();
+          track.scrollBy({ left: delta, behavior: scrollBehavior() });
+        } else if (e.key === 'Home' || e.key === 'End') {
+          e.preventDefault();
+          track.scrollTo({ left: e.key === 'Home' ? 0 : track.scrollWidth, behavior: scrollBehavior() });
+        }
+      });
+
+      // Mouse drag-to-swipe (touch and trackpads use native scrolling).
+      var drag = null;
+      var suppressClick = false;
+
+      track.addEventListener('pointerdown', function (e) {
+        if (e.pointerType !== 'mouse' || e.button !== 0) return;
+        drag = { x: e.clientX, left: track.scrollLeft, moved: false, id: e.pointerId };
+      });
+
+      track.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        var dx = e.clientX - drag.x;
+        if (!drag.moved && Math.abs(dx) > 5) {
+          drag.moved = true;
+          track.classList.add('is-dragging');
+          track.setPointerCapture(e.pointerId);
+        }
+        if (drag.moved) track.scrollLeft = drag.left - dx;
+      });
+
+      function endDrag(e) {
+        if (!drag || (e && e.pointerId !== drag.id)) return;
+        if (drag.moved) {
+          suppressClick = true;
+          track.classList.remove('is-dragging');
+          // Re-enable snapping and settle on the nearest card.
+          var step = stepSize();
+          var target = Math.round(track.scrollLeft / step) * step;
+          track.scrollTo({ left: target, behavior: scrollBehavior() });
+          setTimeout(function () { suppressClick = false; }, 0);
+        }
+        drag = null;
+      }
+
+      track.addEventListener('pointerup', endDrag);
+      track.addEventListener('pointercancel', endDrag);
+      track.addEventListener('click', function (e) {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+        }
+      }, true);
+      track.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+      /* ================= Detail dialog ================= */
+      var dialog = document.getElementById('drink-detail');
+      var fields = {
+        title: dialog.querySelector('[data-detail-title]'),
+        long: dialog.querySelector('[data-detail-long]'),
+        price: dialog.querySelector('[data-detail-price]'),
+        size: dialog.querySelector('[data-detail-size]'),
+        caffeine: dialog.querySelector('[data-detail-caffeine]'),
+        notes: dialog.querySelector('[data-detail-notes]'),
+        media: dialog.querySelector('[data-detail-media]'),
+        link: dialog.querySelector('[data-detail-link]'),
+        order: dialog.querySelector('[data-detail-order]')
+      };
+      var supportsDialog = typeof dialog.showModal === 'function';
+      var trigger = null;
+      var currentAnim = null;
+      var DURATION = 420;
+      var EASING = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
+
+      function populate(card) {
+        var title = card.querySelector('h3').textContent;
+        fields.title.textContent = title;
+        fields.long.textContent = card.dataset.long || '';
+        fields.price.textContent = card.dataset.price || '';
+        fields.size.textContent = card.dataset.size || '';
+        fields.caffeine.textContent = card.dataset.caffeine || '';
+        fields.notes.textContent = card.dataset.notes || '';
+        fields.link.href = card.dataset.detailUrl || '/menu';
+        fields.order.href = '/order-online?item=' + encodeURIComponent(title);
+
+        fields.media.textContent = '';
+        var img = card.querySelector('.card-media img');
+        if (img) {
+          var clone = img.cloneNode();
+          clone.loading = 'eager';
+          clone.onerror = function () { this.remove(); };
+          fields.media.appendChild(clone);
+        }
+      }
+
+      // Transform that maps the dialog's final box onto the trigger button's box.
+      function originTransform(btnRect, dlgRect) {
+        var sx = btnRect.width / dlgRect.width;
+        var sy = btnRect.height / dlgRect.height;
+        var dx = (btnRect.left + btnRect.width / 2) - (dlgRect.left + dlgRect.width / 2);
+        var dy = (btnRect.top + btnRect.height / 2) - (dlgRect.top + dlgRect.height / 2);
+        return 'translate(' + dx + 'px, ' + dy + 'px) scale(' + sx + ', ' + sy + ')';
+      }
+
+      function animateFromButton(reverse) {
+        var inner = dialog.querySelector('.drink-detail-inner');
+        if (reduceMotion.matches || !dialog.animate || !trigger || !trigger.isConnected) {
+          return Promise.resolve();
+        }
+        var btnRect = trigger.getBoundingClientRect();
+        var dlgRect = dialog.getBoundingClientRect();
+        if (!btnRect.width || !dlgRect.width) return Promise.resolve();
+
+        var btnStyle = getComputedStyle(trigger);
+        var from = {
+          transform: originTransform(btnRect, dlgRect),
+          borderRadius: btnStyle.borderRadius,
+          backgroundColor: btnStyle.backgroundColor,
+          boxShadow: '0 4px 12px rgba(62, 39, 35, 0.3)'
+        };
+        var to = {
+          transform: 'none',
+          borderRadius: '14px',
+          backgroundColor: '#ffffff',
+          boxShadow: '0 24px 60px rgba(0, 0, 0, 0.35)'
+        };
+        var opts = { duration: DURATION, easing: EASING, fill: 'both' };
+        var shell = dialog.animate(reverse ? [to, from] : [from, to], opts);
+
+        // Content fades in once the shape has mostly grown (and out first when closing).
+        var contentFrames = reverse
+          ? [{ opacity: 1 }, { opacity: 0, offset: 0.35 }, { opacity: 0 }]
+          : [{ opacity: 0 }, { opacity: 0, offset: 0.45 }, { opacity: 1 }];
+        var content = inner.animate(contentFrames, opts);
+
+        var backdrop = dialog.animate(
+          reverse ? [{ opacity: 1 }, { opacity: 0 }] : [{ opacity: 0 }, { opacity: 1 }],
+          { duration: DURATION, easing: 'ease', fill: 'both', pseudoElement: '::backdrop' }
+        );
+
+        currentAnim = [shell, content, backdrop];
+        return shell.finished.then(function () {
+          currentAnim.forEach(function (a) { a.cancel(); });
+          currentAnim = null;
+        }, function () { /* cancelled */ });
+      }
+
+      function cancelRunning() {
+        if (currentAnim) {
+          currentAnim.forEach(function (a) { a.cancel(); });
+          currentAnim = null;
+        }
+      }
+
+      function openDetail(btn) {
+        var card = btn.closest('[data-drink]');
+        if (!card) return;
+        if (!supportsDialog) {
+          window.location.href = card.dataset.detailUrl || '/menu';
+          return;
+        }
+        cancelRunning();
+        trigger = btn;
+        populate(card);
+        dialog.showModal();
+        dialog.querySelector('[data-close-detail]').focus();
+        animateFromButton(false);
+      }
+
+      var closing = false;
+      function closeDetail() {
+        if (!dialog.open || closing) return;
+        closing = true;
+        cancelRunning();
+        animateFromButton(true).then(function () {
+          dialog.close();
+          closing = false;
+        });
+      }
+
+      dialog.addEventListener('close', function () {
+        closing = false;
+        cancelRunning();
+        if (trigger && trigger.isConnected) {
+          trigger.focus({ preventScroll: true });
+        }
+      });
+
+      // Escape key: run the collapse animation instead of closing instantly.
+      dialog.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        closeDetail();
+      });
+
+      // Click on the backdrop (outside the dialog box) closes it.
+      dialog.addEventListener('click', function (e) {
+        if (e.target !== dialog) return;
+        var r = dialog.getBoundingClientRect();
+        var inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDetail();
+      });
+
+      dialog.querySelector('[data-close-detail]').addEventListener('click', closeDetail);
+
+      document.querySelectorAll('[data-open-detail]').forEach(function (btn) {
+        btn.addEventListener('click', function () { openDetail(btn); });
+      });
+    })();
+  </script>
 </body>
 
 </html>
