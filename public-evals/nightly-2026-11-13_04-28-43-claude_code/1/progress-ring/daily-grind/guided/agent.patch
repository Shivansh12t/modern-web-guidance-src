+  <script>
+    // Keep the loyalty ring's CSS custom properties, accessible text and
+    // message in sync with the <progress> element's value/max attributes.
+    (() => {
+      const progress = document.getElementById('loyalty-progress');
+      const message = document.getElementById('loyalty-message');
+      const count = progress.parentElement.querySelector('.count');
+      const supportsAttr = CSS.supports('width: attr(value type(<number>))');
+
+      const sync = () => {
+        const max = Number(progress.getAttribute('max')) || 10;
+        const value = Math.min(Number(progress.getAttribute('value')) || 0, max);
+        const remaining = max - value;
+
+        if (!supportsAttr) {
+          progress.style.setProperty('--value', value);
+          progress.style.setProperty('--max', max);
+        }
+        progress.classList.toggle('is-complete', remaining === 0);
+        progress.setAttribute('aria-valuetext', `${value} of ${max} stamps collected`);
+        count.innerHTML = `${value}<small>/${max}</small>`;
+        message.textContent = remaining === 0
+          ? 'Your free drink is ready to redeem!'
+          : `Only ${remaining} more drink${remaining === 1 ? '' : 's'} until your next free drink!`;
+      };
+
+      sync();
+      new MutationObserver(sync).observe(progress, {
+        attributes: true,
+        attributeFilter: ['value', 'max'],
+      });
+    })();
+  </script>
+
