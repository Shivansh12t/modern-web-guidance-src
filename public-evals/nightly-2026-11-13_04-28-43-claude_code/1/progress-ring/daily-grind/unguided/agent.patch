+    /* Loyalty Rewards */
+    .rewards {
+      margin-top: 60px;
+    }
+
+    .rewards h2 {
+      text-align: center;
+    }
+
+    .rewards-card {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 20px;
+    }
+
+    .progress-ring {
+      position: relative;
+      width: 200px;
+      height: 200px;
+      flex-shrink: 0;
+    }
+
+    .progress-ring svg {
+      width: 100%;
+      height: 100%;
+      transform: rotate(-90deg);
+    }
+
+    .progress-ring-track,
+    .progress-ring-fill {
+      fill: none;
+      stroke-width: 12;
+    }
+
+    .progress-ring-track {
+      stroke: var(--secondary);
+    }
+
+    .progress-ring-fill {
+      stroke: var(--accent);
+      stroke-linecap: round;
+      /* pathLength="100" on the circle lets the offset map directly to percent */
+      stroke-dasharray: 100;
+      stroke-dashoffset: calc(100 - var(--progress));
+      animation: ring-fill 1.2s ease-out;
+    }
+
+    @keyframes ring-fill {
+      from {
+        stroke-dashoffset: 100;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-ring-fill {
+        animation: none;
+      }
+    }
+
+    .progress-ring-label {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      text-align: center;
+      line-height: 1.2;
+    }
+
+    .progress-ring-count {
+      font-size: 2.5rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .progress-ring-count span {
+      font-size: 1.25rem;
+      color: #8d6e63;
+    }
+
+    .progress-ring-caption {
+      font-size: 0.85rem;
+      color: var(--text);
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      margin-top: 4px;
+    }
+
+    .rewards-details {
+      max-width: 420px;
+    }
+
+    .rewards-details h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .rewards-details strong {
+      color: var(--primary);
+    }
+
+    .stamp-row {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 8px;
+      list-style: none;
+      margin-top: 15px;
+    }
+
+    .stamp {
+      width: 22px;
+      height: 22px;
+      border-radius: 50%;
+      border: 2px solid var(--secondary);
+    }
+
+    .stamp.earned {
+      background: var(--accent);
+      border-color: var(--accent);
+    }
+
