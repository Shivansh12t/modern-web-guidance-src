+  <button type="button" class="back-to-top" aria-label="Back to top">
+    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
+      stroke-linejoin="round" aria-hidden="true" focusable="false">
+      <path d="M12 19V5M5 12l7-7 7 7" />
+    </svg>
+  </button>
+  </div>
+
+  <script>
+    (() => {
+      const scroller = document.querySelector('.scroller');
+      const button = scroller.querySelector('.back-to-top');
+
+      button.addEventListener('click', () => {
+        // Hand focus to the scroll region first so it isn't lost to <body>
+        // when the button hides itself at the top.
+        scroller.focus({ preventScroll: true });
+        scroller.scrollTo({ top: 0 }); // smooth via CSS scroll-behavior
+      });
+
+      // If the button is focused and the region is scrolled to the top some
+      // other way (Home / Page Up), the button becomes visibility:hidden and
+      // drops focus. Keep focus inside the scroll region instead.
+      button.addEventListener('focusout', (event) => {
+        if (event.relatedTarget) return;
+        requestAnimationFrame(() => {
+          if (document.activeElement === document.body || !document.activeElement) {
+            scroller.focus({ preventScroll: true });
+          }
+        });
+      });
+
+      // Fallback: no scroll-state container queries -> one IntersectionObserver
+      // on a sentinel at the top of the scroller (no scroll listeners).
+      if (!CSS.supports('container-type', 'scroll-state')) {
+        const sentinel = scroller.querySelector('.scroll-sentinel');
+        new IntersectionObserver(([entry]) => {
+          scroller.classList.toggle('scrolled', !entry.isIntersecting);
+        }, { root: scroller }).observe(sentinel);
+      }
+    })();
+  </script>
+
 </body>
 
