+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var button = scroller && scroller.querySelector('.back-to-top');
+      var sentinel = scroller && scroller.querySelector('.scroll-sentinel');
+      if (!scroller || !button || !sentinel) return;
+
+      function setVisible(visible) {
+        button.classList.toggle('is-visible', visible);
+        // inert keeps the hidden button out of tab order and the a11y tree
+        // (visibility:hidden does too, but inert also covers the fade-out window).
+        button.inert = !visible;
+      }
+
+      if ('IntersectionObserver' in window) {
+        // Fires only when the sentinel crosses the scroller's edge,
+        // instead of on every scroll frame.
+        new IntersectionObserver(function (entries) {
+          var entry = entries[entries.length - 1];
+          setVisible(!entry.isIntersecting);
+        }, { root: scroller, threshold: 0 }).observe(sentinel);
+      } else {
+        // Fallback for very old browsers: passive, rAF-throttled scroll check.
+        var ticking = false;
+        scroller.addEventListener('scroll', function () {
+          if (ticking) return;
+          ticking = true;
+          requestAnimationFrame(function () {
+            setVisible(scroller.scrollTop > sentinel.offsetHeight);
+            ticking = false;
+          });
+        }, { passive: true });
+      }
+
+      button.addEventListener('click', function () {
+        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        scroller.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
+        // The button becomes inert once we reach the top, so move focus to the
+        // start of the content to keep keyboard users from losing their place.
+        scroller.focus({ preventScroll: true });
+      });
+    })();
+  </script>
