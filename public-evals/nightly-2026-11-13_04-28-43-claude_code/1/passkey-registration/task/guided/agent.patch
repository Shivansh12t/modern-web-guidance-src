+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs"
+      },
+      "integrity": {
+        "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs": "sha384-EBLK1vCYl7ILfHGSetlZN/n8TaV5nbYKx9JrMwcJvy5NTITz1Q9HDYqCG4NxzuR0"
+      }
+    }
+  </script>
+  <script type="module">
+    const button = document.getElementById('register-button');
+    const statusEl = document.getElementById('passkey-status');
+
+    function setStatus(message, state = 'info') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function signalUnknown(rpId, credentialId) {
+      if (!PublicKeyCredential.signalUnknownCredential) return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('signalUnknownCredential failed:', err);
+      }
+    }
+
+    // Gate the UI: only enable the button when passkeys are fully supported.
+    async function initPasskeyUI() {
+      if (!window.isSecureContext || !window.PublicKeyCredential) {
+        button.hidden = true;
+        return;
+      }
+
+      // Load the polyfill only when native JSON helpers are missing.
+      if (
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function' ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        try {
+          await import('webauthn-polyfills');
+        } catch (err) {
+          console.error('Failed to load WebAuthn polyfills:', err);
+          button.hidden = true;
+          return;
+        }
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+          button.hidden = true;
+          return;
+        }
+      } catch (err) {
+        console.error('Unable to determine passkey capabilities:', err);
+        button.hidden = true;
+        return;
+      }
+
+      button.disabled = false;
+      button.addEventListener('click', registerPasskey);
+    }
+
+    async function registerPasskey() {
+      button.disabled = true;
+      setStatus('Preparing passkey creation…');
+
+      try {
+        // 1. Fetch creation options from the server.
+        let creationOptionsJSON;
+        try {
+          const res = await fetch('/api/register/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({ promotion: true }),
+          });
+          if (!res.ok) throw new Error(`Options request failed (${res.status})`);
+          creationOptionsJSON = await res.json();
+        } catch (err) {
+          console.error(err);
+          setStatus('Could not start passkey creation. Please try again later.', 'error');
+          return;
+        }
+
+        // 2. Create the passkey.
+        let publicKey;
+        let credential;
+        try {
+          publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+          setStatus('Follow the prompt from your device to create a passkey.');
+          credential = await navigator.credentials.create({ publicKey });
+        } catch (err) {
+          switch (err.name) {
+            case 'InvalidStateError':
+              setStatus('A passkey for this account already exists on this device.', 'error');
+              break;
+            case 'NotAllowedError':
+              setStatus('Passkey creation was cancelled.');
+              break;
+            case 'AbortError':
+              setStatus('Passkey creation was aborted.');
+              break;
+            case 'SecurityError':
+              console.error('RP ID or secure context configuration error:', err);
+              setStatus('Passkeys are not available on this site right now.', 'error');
+              break;
+            default:
+              console.error('Passkey creation failed:', err);
+              setStatus('Something went wrong while creating your passkey.', 'error');
+          }
+          return; // Do not signal unknown credential for standard WebAuthn failures.
+        }
+
+        if (!credential) {
+          setStatus('Passkey creation was cancelled.');
+          return;
+        }
+
+        // 3. Verify the registration with the server.
+        const encodedResponse = credential.toJSON();
+        // Always use the server-provided RP ID, never window.location.hostname.
+        const rpId = publicKey.rp?.id ?? creationOptionsJSON.rp?.id;
+        setStatus('Verifying your passkey…');
+        try {
+          const res = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify(encodedResponse),
+          });
+          if (!res.ok) {
+            if (rpId) await signalUnknown(rpId, encodedResponse.id);
+            setStatus('We could not verify your passkey. Please try again.', 'error');
+            return;
+          }
+        } catch (err) {
+          console.error('Server verification network failure:', err);
+          if (rpId) await signalUnknown(rpId, encodedResponse.id);
+          setStatus('We could not verify your passkey. Please try again.', 'error');
+          return;
+        }
+
+        setStatus('Your passkey was created! You can use it next time you sign in.', 'success');
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    initPasskeyUI();
+  </script>
+
 </body>
 
 </html>
