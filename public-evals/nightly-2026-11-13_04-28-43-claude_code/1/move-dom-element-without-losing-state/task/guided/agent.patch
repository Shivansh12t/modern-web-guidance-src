+  <script>
+    (() => {
+      const hero = document.getElementById('hero');
+      const heroHeading = hero.querySelector('h1');
+      const slot = document.getElementById('video-slot');
+      const section = document.getElementById('video-section');
+      const placeholder = section.querySelector('.video-placeholder');
+      const videoPlayer = document.getElementById('video-player');
+      const iframe = document.getElementById('roasting-video');
+      const toggle = document.getElementById('theater-toggle');
+
+      // moveBefore() performs an atomic move, so the iframe keeps playing.
+      const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+      // Fallback (e.g. Safari): a classic insertBefore() reloads the iframe, so
+      // track playback via the YouTube IFrame API and resume where we left off.
+      let player = null;
+      if (!supportsMoveBefore) {
+        const attach = () => { player = new YT.Player(iframe); };
+        window.onYouTubeIframeAPIReady = attach;
+        const script = document.createElement('script');
+        script.src = 'https://www.youtube.com/iframe_api';
+        document.head.append(script);
+      }
+
+      function moveVideo(parent, before) {
+        if (supportsMoveBefore) {
+          parent.moveBefore(videoPlayer, before);
+          return;
+        }
+        const time = player?.getCurrentTime?.() ?? 0;
+        const wasPlaying = player?.getPlayerState?.() === 1; // YT.PlayerState.PLAYING
+        parent.insertBefore(videoPlayer, before);
+        if (time > 0 || wasPlaying) {
+          const url = new URL(iframe.src);
+          url.searchParams.set('start', Math.floor(time));
+          url.searchParams.set('autoplay', wasPlaying ? '1' : '0');
+          iframe.src = url.href;
+        }
+        if (window.YT?.Player) player = new YT.Player(iframe);
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = toggle.getAttribute('aria-pressed') !== 'true';
+        if (entering) {
+          moveVideo(hero, heroHeading);
+        } else {
+          moveVideo(slot, placeholder);
+        }
+        hero.classList.toggle('theater', entering);
+        section.classList.toggle('theater', entering);
+        toggle.setAttribute('aria-pressed', String(entering));
+        toggle.textContent = entering ? 'Exit theater mode' : 'Theater mode';
+        // The button travels with the video, so keep it focused in its new spot
+        // (insertBefore() in the fallback path drops focus) and bring it into view.
+        toggle.focus({ preventScroll: true });
+        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+        videoPlayer.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
+      });
+    })();
+  </script>
