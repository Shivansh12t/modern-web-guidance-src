+  <script>
+    (function () {
+      var wrapper = document.getElementById('video-wrapper');
+      var iframe = document.getElementById('roast-video');
+      var home = document.getElementById('video-home');
+      var theaterSlot = document.getElementById('theater-slot');
+      var hero = document.querySelector('.hero');
+      var toggle = document.getElementById('theater-toggle');
+      var toggleHome = toggle.parentNode;
+      var placeholder = document.getElementById('video-placeholder');
+      var isTheater = false;
+
+      // Element.moveBefore() (state-preserving move) keeps the iframe alive, so
+      // playback continues untouched. Older browsers reload an iframe whenever it is
+      // re-parented, so there we snapshot and restore the player state through the
+      // YouTube IFrame API.
+      var supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+      var player = null;
+      var playerReady = false;
+
+      function createPlayer(onReady) {
+        playerReady = false;
+        player = new YT.Player(iframe, {
+          events: {
+            onReady: function () {
+              playerReady = true;
+              if (onReady) onReady(player);
+            }
+          }
+        });
+      }
+
+      if (!supportsMoveBefore) {
+        var prevReady = window.onYouTubeIframeAPIReady;
+        window.onYouTubeIframeAPIReady = function () {
+          if (typeof prevReady === 'function') prevReady();
+          createPlayer();
+        };
+        var tag = document.createElement('script');
+        tag.src = 'https://www.youtube.com/iframe_api';
+        document.head.appendChild(tag);
+      }
+
+      function snapshot() {
+        if (!player || !playerReady) return null;
+        try {
+          var state = player.getPlayerState();
+          return {
+            time: player.getCurrentTime() || 0,
+            playing: state === YT.PlayerState.PLAYING || state === YT.PlayerState.BUFFERING,
+            started: state !== YT.PlayerState.UNSTARTED && state !== YT.PlayerState.CUED,
+            muted: player.isMuted(),
+            volume: player.getVolume()
+          };
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function restore(saved) {
+        if (!saved || !saved.started) {
+          if (window.YT && YT.Player) createPlayer();
+          return;
+        }
+        createPlayer(function (p) {
+          if (saved.muted) p.mute(); else p.unMute();
+          p.setVolume(saved.volume);
+          p.seekTo(saved.time, true);
+          if (saved.playing) p.playVideo(); else p.pauseVideo();
+        });
+      }
+
+      function moveInto(parent, node, before) {
+        before = before || null;
+        if (supportsMoveBefore) {
+          try {
+            parent.moveBefore(node, before);
+            return true;
+          } catch (e) {
+            // Fall through to a regular (state-resetting) insert.
+          }
+        }
+        parent.insertBefore(node, before);
+        return false;
+      }
+
+      function setTheater(on) {
+        if (on === isTheater) return;
+        var saved = supportsMoveBefore ? null : snapshot();
+        var preserved;
+
+        if (on) {
+          theaterSlot.hidden = false;
+          preserved = moveInto(theaterSlot, wrapper);
+          moveInto(theaterSlot, toggle);
+          placeholder.hidden = false;
+          hero.classList.add('theater-active');
+        } else {
+          preserved = moveInto(home, wrapper);
+          moveInto(toggleHome, toggle);
+          theaterSlot.hidden = true;
+          placeholder.hidden = true;
+          hero.classList.remove('theater-active');
+        }
+
+        isTheater = on;
+        toggle.setAttribute('aria-pressed', String(on));
+        toggle.textContent = on ? 'Exit Theater Mode' : 'Theater Mode';
+
+        if (!preserved) restore(saved);
+
+        (on ? hero : document.getElementById('roasting-video'))
+          .scrollIntoView({ behavior: 'smooth', block: 'start' });
+        toggle.focus({ preventScroll: true });
+      }
+
+      toggle.addEventListener('click', function () {
+        setTheater(!isTheater);
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && isTheater) setTheater(false);
+      });
+    })();
+  </script>
