       align-items: center;
       color: white;
       text-align: center;
       padding: 0 20px;
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
     }
 
     .hero h1 {
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    /* Hero content stays above the decorative layer */
+    .hero > :not(.shaped-element):not(.shape-defs) {
+      position: relative;
+      z-index: 1;
+    }
+
+    /* Decorative organic shape
+       - Absolutely positioned: removed from flow, so it never shifts hero content.
+       - Fixed aspect-ratio + clamp() width: its box size is known before the
+         image loads, so there is no layout shift (CLS).
+       - Clipped via an SVG clipPath in objectBoundingBox units, so the
+         free-form silhouette scales with the element at any size. */
+    .shaped-element {
+      position: absolute;
+      right: clamp(-60px, -2vw, 0px);
+      bottom: -8%;
+      width: clamp(160px, 26vw, 360px);
+      aspect-ratio: 1 / 1;
+      z-index: 0;
+      pointer-events: none;
+      background:
+        linear-gradient(135deg, rgba(255, 171, 64, 0.35), rgba(78, 52, 46, 0.55)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=720&q=80') center / cover no-repeat,
+        var(--primary);
+      /* Fallback silhouette for engines without url() clip support */
+      clip-path: polygon(50% 2%, 80% 10%, 97% 38%, 92% 72%, 66% 96%, 30% 94%, 6% 72%, 4% 36%, 22% 10%);
+      clip-path: url(#organic-blob);
+      opacity: 0.85;
+      contain: layout paint;
+    }
+
+    .shape-defs {
+      position: absolute;
+      width: 0;
+      height: 0;
+      overflow: hidden;
+    }
+
+    @media (max-width: 600px) {
+      .shaped-element {
+        opacity: 0.45;
+      }
+    }
+
