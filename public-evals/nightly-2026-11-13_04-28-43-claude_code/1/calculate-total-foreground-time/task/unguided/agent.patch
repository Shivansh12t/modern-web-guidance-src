+  <script>
+    /**
+     * Foreground time tracking.
+     *
+     * Adds up the time the page is actually visible to the user. Time spent in
+     * a background tab, a minimized window, or the back/forward cache is not
+     * counted. Uses performance.now() so changes to the system clock don't
+     * affect the result.
+     */
+    (function () {
+      let accumulatedMs = 0;
+      let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+      function startSegment() {
+        if (visibleSince === null) visibleSince = performance.now();
+      }
+
+      function endSegment() {
+        if (visibleSince !== null) {
+          accumulatedMs += performance.now() - visibleSince;
+          visibleSince = null;
+        }
+      }
+
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'visible') startSegment();
+        else endSegment();
+      });
+
+      // Pages restored from / saved to the back-forward cache.
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted && document.visibilityState === 'visible') startSegment();
+      });
+      window.addEventListener('pagehide', endSegment);
+
+      /**
+       * Total time (in milliseconds) the page has been in the foreground,
+       * including the current visible segment if there is one.
+       * @returns {number}
+       */
+      function getTotalForegroundTime() {
+        const current = visibleSince !== null ? performance.now() - visibleSince : 0;
+        return Math.round(accumulatedMs + current);
+      }
+
+      window.getTotalForegroundTime = getTotalForegroundTime;
+    })();
+  </script>
+
 </body>
 
