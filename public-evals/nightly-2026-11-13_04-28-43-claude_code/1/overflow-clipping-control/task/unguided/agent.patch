+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 32px;
+      align-items: stretch;
+    }
+
+    /* Card whose content is clipped to its content box, so the clip
+       edge gets an inner radius of (border-radius - padding) and child
+       corners follow the card's inner curve automatically. */
+    .nested-curve-parent {
+      --radius: 28px;
+      --pad: 12px;
+      background: white;
+      border-radius: var(--radius);
+      padding: var(--pad);
+      box-shadow: 0 6px 20px rgba(62, 39, 35, 0.15);
+      overflow: hidden; /* fallback */
+      overflow: clip;
+      overflow-clip-margin: content-box;
+      display: flex;
+      flex-direction: column;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-body {
+      background: var(--secondary);
+      padding: 20px;
+      flex: 1;
+    }
+
+    .nested-curve-body h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    /* Promo container: clips overflowing text, but extends the clip
+       edge outward far enough for the button's glow to render fully. */
+    .safety-zone-parent {
+      --glow: 24px;
+      position: relative;
+      background: linear-gradient(135deg, var(--primary), #6d4c41);
+      color: white;
+      border-radius: 16px;
+      padding: 40px 32px;
+      overflow: hidden; /* fallback */
+      overflow: clip;
+      overflow-clip-margin: var(--glow);
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: flex-start;
+      gap: 12px;
+    }
+
+    .safety-zone-parent .promo-backdrop {
+      position: absolute;
+      right: -40%;
+      bottom: -0.25em;
+      font-size: 9rem;
+      font-weight: 900;
+      line-height: 1;
+      white-space: nowrap;
+      color: rgba(255, 255, 255, 0.08);
+      pointer-events: none;
+      user-select: none;
+    }
+
+    .safety-zone-parent .promo-title {
+      position: relative;
+      font-size: 1.8rem;
+      max-width: 100%;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+
+    .safety-zone-parent p {
+      position: relative;
+    }
+
+    .glow-btn {
+      position: relative;
+      display: inline-block;
+      margin-top: 8px;
+      padding: 12px 28px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      text-decoration: none;
+      border-radius: 999px;
+      box-shadow: 0 0 var(--glow) 6px rgba(255, 171, 64, 0.65);
+      transition: box-shadow 0.3s, transform 0.3s;
+    }
+
+    .glow-btn:hover,
+    .glow-btn:focus-visible {
+      transform: translateY(-1px);
+      box-shadow: 0 0 var(--glow) 10px rgba(255, 171, 64, 0.85);
+    }
+
+    .glow-btn:focus-visible {
+      outline: 2px solid white;
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .glow-btn {
+        transition: none;
+      }
+    }
+
