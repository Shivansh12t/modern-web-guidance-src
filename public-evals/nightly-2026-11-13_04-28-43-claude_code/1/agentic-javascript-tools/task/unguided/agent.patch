@@ -206,7 +206,184 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // ---------------------------------------------------------------------
+    // WebMCP: expose a client-side "get_menu_item_details" tool to AI agents
+    // via navigator.modelContext. No-op in browsers without WebMCP support.
+    // ---------------------------------------------------------------------
+    (() => {
+      const MENU_ITEMS = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          aliases: ['maple latte', 'oat latte', 'maple oat'],
+          category: 'Seasonal',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          sizes: [
+            { size: 'Small (12 oz)', price: 4.75 },
+            { size: 'Medium (16 oz)', price: 5.25 },
+            { size: 'Large (20 oz)', price: 5.75 }
+          ],
+          temperature: ['hot', 'iced'],
+          ingredients: ['Espresso', 'Oat milk', 'Vermont maple syrup'],
+          dietary: ['vegan', 'dairy-free'],
+          allergens: ['oats (may contain gluten)'],
+          caffeineMg: 150,
+          calories: 210,
+          available: true,
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          aliases: ['espresso', 'dark roast', 'dark espresso'],
+          category: 'Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          sizes: [
+            { size: 'Single shot (1 oz)', price: 2.75 },
+            { size: 'Double shot (2 oz)', price: 3.50 }
+          ],
+          temperature: ['hot'],
+          ingredients: ['Dark roast espresso beans'],
+          dietary: ['vegan', 'dairy-free', 'gluten-free'],
+          allergens: [],
+          caffeineMg: 130,
+          calories: 5,
+          available: true,
+          url: '/menu/espresso'
+        },
+        {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          aliases: ['cold brew coffee', 'coldbrew', 'iced cold brew'],
+          category: 'Cold Coffee',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          sizes: [
+            { size: 'Medium (16 oz)', price: 4.50 },
+            { size: 'Large (20 oz)', price: 5.00 }
+          ],
+          temperature: ['iced'],
+          ingredients: ['Coarse-ground coffee', 'Filtered water'],
+          dietary: ['vegan', 'dairy-free', 'gluten-free'],
+          allergens: [],
+          caffeineMg: 200,
+          calories: 5,
+          available: true,
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      const normalize = (str) =>
+        String(str ?? '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
+
+      function findMenuItem(query) {
+        const q = normalize(query);
+        if (!q) return null;
+        const keys = (item) => [item.name, item.id, ...item.aliases].map(normalize);
+        // 1) exact name / id / alias match
+        let match = MENU_ITEMS.find((item) => keys(item).includes(q));
+        // 2) partial match in either direction (e.g. "maple" or "the cold brew please")
+        if (!match) {
+          match = MENU_ITEMS.find((item) =>
+            keys(item).some((k) => k.includes(q) || q.includes(k)));
+        }
+        return match || null;
+      }
+
+      function toPublicDetails(item) {
+        const { aliases, ...details } = item;
+        return { ...details, url: new URL(item.url, location.origin).href, currency: 'USD' };
+      }
+
+      const textResult = (data, isError = false) => ({
+        content: [{ type: 'text', text: JSON.stringify(data, null, 2) }],
+        ...(isError ? { isError: true } : {})
+      });
+
+      const menuItemTool = {
+        name: 'get_menu_item_details',
+        description:
+          'Look up full details for a single item on The Daily Grind coffee menu by its name. ' +
+          'Returns the description, category, available sizes with prices (USD), hot/iced options, ' +
+          'ingredients, dietary info, allergens, caffeine (mg), calories, availability, and a link ' +
+          'to the item page. Matching is case-insensitive and tolerates partial names ' +
+          '(e.g. "maple latte"). Current menu items: ' +
+          MENU_ITEMS.map((i) => i.name).join(', ') + '.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up, e.g. "Maple Oat Latte", ' +
+                '"Dark Roast Espresso", or "Cold Brew". Case-insensitive; partial names are accepted.',
+              minLength: 1
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        async execute({ name } = {}) {
+          if (typeof name !== 'string' || !name.trim()) {
+            return textResult({
+              error: 'The "name" parameter is required and must be a non-empty string.',
+              availableItems: MENU_ITEMS.map((i) => i.name)
+            }, true);
+          }
+          const item = findMenuItem(name);
+          if (!item) {
+            return textResult({
+              error: `No menu item found matching "${name}".`,
+              availableItems: MENU_ITEMS.map((i) => i.name)
+            }, true);
+          }
+          return textResult(toPublicDetails(item));
+        }
+      };
+
+      const modelContext = navigator.modelContext;
+      if (!modelContext || typeof modelContext.registerTool !== 'function') {
+        return; // WebMCP not available in this browser.
+      }
+
+      const controller = new AbortController();
+      let registration;
+      try {
+        // Newer spec drafts unregister via an AbortSignal; older ones return
+        // an object with unregister(). We support both.
+        registration = modelContext.registerTool(menuItemTool, { signal: controller.signal });
+      } catch (err) {
+        console.warn('[WebMCP] Failed to register get_menu_item_details:', err);
+        return;
+      }
+
+      let cleanedUp = false;
+      function unregisterMenuTool() {
+        if (cleanedUp) return;
+        cleanedUp = true;
+        try {
+          controller.abort();
+          if (registration && typeof registration.unregister === 'function') {
+            registration.unregister();
+          } else if (typeof modelContext.unregisterTool === 'function') {
+            modelContext.unregisterTool(menuItemTool.name);
+          }
+        } catch (err) {
+          // Tool may already be gone (e.g. aborted via signal); ignore.
+        }
+      }
+
+      // 'pagehide' fires reliably on navigation/close (and is bfcache-friendly,
+      // unlike 'unload'). 'beforeunload' is not used since it blocks bfcache.
+      window.addEventListener('pagehide', unregisterMenuTool, { once: true });
+
+      // Expose for manual teardown (e.g. tests or SPA route changes).
+      window.dailyGrindTools = { unregisterMenuTool, findMenuItem };
+    })();
+  </script>
+
 </body>
 
 </html>
