     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // Menu catalog used by the WebMCP "get_menu_item_details" tool.
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        sizes: [
+          { size: "Small (12 oz)", price: 4.75 },
+          { size: "Medium (16 oz)", price: 5.25 },
+          { size: "Large (20 oz)", price: 5.75 },
+        ],
+        temperature: ["hot", "iced"],
+        caffeineMg: 150,
+        calories: 210,
+        dietary: ["vegan", "dairy-free"],
+        allergens: ["oats"],
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        sizes: [
+          { size: "Single shot", price: 2.75 },
+          { size: "Double shot", price: 3.5 },
+        ],
+        temperature: ["hot"],
+        caffeineMg: 130,
+        calories: 5,
+        dietary: ["vegan", "dairy-free", "gluten-free"],
+        allergens: [],
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Drinks",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        sizes: [
+          { size: "Medium (16 oz)", price: 4.5 },
+          { size: "Large (24 oz)", price: 5.25 },
+        ],
+        temperature: ["iced"],
+        caffeineMg: 205,
+        calories: 5,
+        dietary: ["vegan", "dairy-free", "gluten-free"],
+        allergens: [],
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    const normalize = (value) =>
+      value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
+
+    function findMenuItem(query) {
+      const q = normalize(query);
+      if (!q) return undefined;
+      // Exact (normalized) match first, then a forgiving partial match.
+      return (
+        MENU_ITEMS.find((item) => normalize(item.name) === q) ??
+        MENU_ITEMS.find((item) => {
+          const name = normalize(item.name);
+          return name.includes(q) || q.includes(name);
+        })
+      );
+    }
+
+    const menuItemTool = {
+      name: "get_menu_item_details",
+      description:
+        "Looks up a drink on The Daily Grind menu by name and returns its details, including description, sizes and prices, caffeine, calories, dietary info, and allergens. Use when the user asks about a specific menu item.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          itemName: {
+            type: "string",
+            description:
+              'Name of the menu item as the user said it, e.g. "maple oat latte" or "cold brew". Matching ignores case and punctuation.',
+          },
+        },
+        required: ["itemName"],
+      },
+      execute({ itemName } = {}) {
+        const availableItems = MENU_ITEMS.map((item) => item.name);
+        if (typeof itemName !== "string" || !itemName.trim()) {
+          return { error: "Provide the name of a menu item to look up.", availableItems };
+        }
+        const item = findMenuItem(itemName);
+        if (!item) {
+          return { error: `Menu item "${itemName}" not found.`, availableItems };
+        }
+        return { ...item, url: new URL(item.url, location.href).href };
+      },
+      annotations: { readOnlyHint: true },
+    };
+
+    // Registration lifecycle: WebMCP has no unregisterTool(); aborting the
+    // signal passed at registration is how a tool is removed.
+    let toolController = null;
+
+    async function registerMenuTools() {
+      if (!("modelContext" in document) || toolController) return;
+      toolController = new AbortController();
+      try {
+        await document.modelContext.registerTool(menuItemTool, {
+          signal: toolController.signal,
+        });
+      } catch (err) {
+        console.warn("Failed to register WebMCP tool:", err);
+        toolController = null;
+      }
+    }
+
+    function unregisterMenuTools() {
+      toolController?.abort();
+      toolController = null;
+    }
+
+    registerMenuTools();
+
+    // Deactivate the tool when the page is unloaded. `pagehide` is used instead
+    // of `unload` (deprecated, and blocks the back/forward cache). If the page
+    // is later restored from the bfcache, register the tool again.
+    addEventListener("pagehide", unregisterMenuTools);
+    addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
+
 </body>
 
 </html>
