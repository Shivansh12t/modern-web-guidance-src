+  <!-- Polite live region so screen reader users hear the busy state -->
+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('loading-status');
+      var busyButtons = [];
+
+      function setBusy(btn) {
+        var label = btn.querySelector('.btn-label');
+        btn.dataset.originalText = label.textContent;
+        if (btn.hasAttribute('aria-label')) btn.dataset.originalAriaLabel = btn.getAttribute('aria-label');
+        label.textContent = btn.dataset.loadingText || 'Loading…';
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('aria-label', btn.dataset.loadingAnnouncement || 'Loading, please wait.');
+        status.textContent = btn.dataset.loadingAnnouncement || 'Loading, please wait.';
+        busyButtons.push(btn);
+      }
+
+      function resetAll() {
+        busyButtons.forEach(function (btn) {
+          btn.querySelector('.btn-label').textContent = btn.dataset.originalText;
+          btn.removeAttribute('aria-busy');
+          btn.removeAttribute('aria-disabled');
+          if (btn.dataset.originalAriaLabel) btn.setAttribute('aria-label', btn.dataset.originalAriaLabel);
+          else btn.removeAttribute('aria-label');
+        });
+        busyButtons = [];
+        status.textContent = '';
+      }
+
+      document.addEventListener('click', function (e) {
+        var btn = e.target.closest('a.btn[data-loading-announcement]');
+        if (!btn) return;
+        // Let new-tab / download style clicks behave normally without a stuck spinner.
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        if (btn.getAttribute('aria-busy') === 'true') {
+          e.preventDefault(); // ignore repeat activations while loading
+          return;
+        }
+        setBusy(btn);
+      });
+
+      // Restore buttons when returning via back/forward cache.
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted) resetAll();
+      });
+    })();
+  </script>
+
