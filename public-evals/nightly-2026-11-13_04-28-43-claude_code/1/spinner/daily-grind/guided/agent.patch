+  <script>
+    (() => {
+      const status = document.getElementById('loading-status');
+
+      function setBusy(link) {
+        const label = link.dataset.loadingLabel || 'Loading';
+        const spinner = document.createElement('progress');
+        spinner.className = 'loading-spinner';
+        spinner.setAttribute('aria-label', label);
+        link.prepend(spinner);
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        status.textContent = `${label}…`;
+      }
+
+      function resetAll() {
+        document.querySelectorAll('a[data-loading-label][aria-busy="true"]').forEach((link) => {
+          link.querySelector('progress.loading-spinner')?.remove();
+          link.removeAttribute('aria-busy');
+          link.removeAttribute('aria-disabled');
+        });
+        status.textContent = '';
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[data-loading-label]');
+        if (!link) return;
+        // Let new-tab/window and download clicks behave normally without a spinner
+        if (event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault(); // Ignore repeat clicks while navigating
+          return;
+        }
+        setBusy(link);
+      });
+
+      // Clear spinners when returning via back/forward cache
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) resetAll();
+      });
+    })();
+  </script>
+
