+  <script>
+    (function () {
+      const dialog = document.getElementById('logout-dialog');
+      const trigger = document.querySelector('.test-dialog-trigger');
+      if (!dialog || !trigger || typeof dialog.showModal !== 'function') return;
+
+      trigger.addEventListener('click', function (event) {
+        event.preventDefault();
+        dialog.showModal();
+      });
+
+      // Close when clicking the backdrop. The dialog has no padding and its
+      // content lives in .dialog-inner, so a click whose target is the
+      // <dialog> element itself can only have landed on the ::backdrop.
+      dialog.addEventListener('click', function (event) {
+        if (event.target === dialog) dialog.close();
+      });
+    })();
+  </script>
