diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -152,8 +152,31 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
   </style>
+
+  <!-- Speculative loading: prefetch same-origin links when the user hovers/starts
+       interacting. Logout (state-changing) links are explicitly excluded.
+       Browsers without Speculation Rules support simply ignore this. -->
+  <script type="speculationrules">
+    {
+      "prefetch": [{
+        "tag": "site-link-prefetch",
+        "where": {
+          "and": [
+            { "href_matches": "/*" },
+            { "not": { "href_matches": "/logout" } },
+            { "not": { "href_matches": "/logout/*" } },
+            { "not": { "href_matches": "/*\\?*(^|&)logout=*" } },
+            { "not": { "selector_matches": ".logout-link" } },
+            { "not": { "selector_matches": ".no-prefetch" } },
+            { "not": { "selector_matches": "[rel~=nofollow]" } }
+          ]
+        },
+        "eagerness": "moderate"
+      }]
+    }
+  </script>
 </head>
 
 <body>
 
