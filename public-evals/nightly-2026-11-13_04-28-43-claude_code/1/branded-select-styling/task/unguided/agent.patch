+  <script>
+    (function () {
+      const root = document.getElementById('roast-selector');
+      const trigger = document.getElementById('roast-trigger');
+      const list = document.getElementById('roast-list');
+      const valueEl = document.getElementById('roast-value');
+      const orderBtn = document.getElementById('order-btn');
+      const options = Array.from(list.querySelectorAll('[role="option"]'));
+      let activeIndex = options.findIndex(o => o.getAttribute('aria-selected') === 'true');
+
+      function setActive(i) {
+        options.forEach(o => o.classList.remove('active'));
+        activeIndex = (i + options.length) % options.length;
+        options[activeIndex].classList.add('active');
+        list.setAttribute('aria-activedescendant', options[activeIndex].id);
+      }
+
+      function open() {
+        list.hidden = false;
+        root.classList.add('open');
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(o => o.getAttribute('aria-selected') === 'true'));
+        list.focus();
+      }
+
+      function close(focusTrigger) {
+        list.hidden = true;
+        root.classList.remove('open');
+        trigger.setAttribute('aria-expanded', 'false');
+        if (focusTrigger) trigger.focus();
+      }
+
+      function select(i) {
+        options.forEach(o => o.setAttribute('aria-selected', 'false'));
+        const opt = options[i];
+        opt.setAttribute('aria-selected', 'true');
+        valueEl.textContent = opt.textContent.trim();
+        orderBtn.href = '/order-online?roast=' + encodeURIComponent(opt.dataset.value);
+        close(true);
+      }
+
+      trigger.addEventListener('click', () => (list.hidden ? open() : close(true)));
+      trigger.addEventListener('keydown', e => {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); }
+      });
+
+      list.addEventListener('keydown', e => {
+        switch (e.key) {
+          case 'ArrowDown': e.preventDefault(); setActive(activeIndex + 1); break;
+          case 'ArrowUp': e.preventDefault(); setActive(activeIndex - 1); break;
+          case 'Home': e.preventDefault(); setActive(0); break;
+          case 'End': e.preventDefault(); setActive(options.length - 1); break;
+          case 'Enter': case ' ': e.preventDefault(); select(activeIndex); break;
+          case 'Escape': e.preventDefault(); close(true); break;
+          case 'Tab': close(false); break;
+        }
+      });
+
+      options.forEach((o, i) => {
+        o.addEventListener('click', () => select(i));
+        o.addEventListener('mousemove', () => setActive(i));
+      });
+
+      document.addEventListener('click', e => {
+        if (!root.contains(e.target) && !list.hidden) close(false);
+      });
+    })();
+  </script>
+
