+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const number = document.getElementById('card-number');
+      const name = document.getElementById('card-name');
+      const expiry = document.getElementById('card-expiry');
+      const cvc = document.getElementById('card-cvc');
+
+      const digits = (v) => v.replace(/\D/g, '');
+
+      function luhn(num) {
+        let sum = 0;
+        let double = false;
+        for (let i = num.length - 1; i >= 0; i--) {
+          let d = parseInt(num[i], 10);
+          if (double) {
+            d *= 2;
+            if (d > 9) d -= 9;
+          }
+          sum += d;
+          double = !double;
+        }
+        return sum % 10 === 0;
+      }
+
+      // Formatting as the user types
+      number.addEventListener('input', () => {
+        const d = digits(number.value).slice(0, 19);
+        number.value = d.replace(/(\d{4})(?=\d)/g, '$1 ');
+      });
+
+      expiry.addEventListener('input', (e) => {
+        let d = digits(expiry.value).slice(0, 4);
+        if (d.length >= 3 || (d.length === 2 && e.inputType !== 'deleteContentBackward')) {
+          d = d.slice(0, 2) + '/' + d.slice(2);
+        }
+        expiry.value = d;
+      });
+
+      cvc.addEventListener('input', () => {
+        cvc.value = digits(cvc.value).slice(0, 4);
+      });
+
+      const validators = {
+        'card-number': () => {
+          const d = digits(number.value);
+          if (!d) return 'Card number is required.';
+          if (d.length < 13 || d.length > 19 || !luhn(d)) return 'Enter a valid card number.';
+          return '';
+        },
+        'card-name': () => {
+          const v = name.value.trim();
+          if (!v) return 'Name on card is required.';
+          if (!/^[\p{L} .'-]+$/u.test(v)) return 'Enter the name as it appears on the card.';
+          return '';
+        },
+        'card-expiry': () => {
+          const m = /^(\d{2})\/(\d{2})$/.exec(expiry.value);
+          if (!expiry.value) return 'Expiry date is required.';
+          if (!m) return 'Use MM/YY format.';
+          const month = parseInt(m[1], 10);
+          const year = 2000 + parseInt(m[2], 10);
+          if (month < 1 || month > 12) return 'Enter a valid month.';
+          const now = new Date();
+          const endOfMonth = new Date(year, month, 0, 23, 59, 59);
+          if (endOfMonth < now) return 'This card has expired.';
+          return '';
+        },
+        'card-cvc': () => {
+          const d = digits(cvc.value);
+          if (!d) return 'Security code is required.';
+          if (d.length < 3 || d.length > 4) return 'Enter a 3 or 4 digit code.';
+          return '';
+        }
+      };
+
+      function validate(input) {
+        const msg = validators[input.id]();
+        document.getElementById(input.id + '-error').textContent = msg;
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+        return !msg;
+      }
+
+      [number, name, expiry, cvc].forEach((input) => {
+        input.addEventListener('blur', () => validate(input));
+      });
+
+      form.addEventListener('submit', (e) => {
+        const fields = [number, name, expiry, cvc];
+        const results = fields.map(validate);
+        const firstInvalid = fields[results.indexOf(false)];
+        if (firstInvalid) {
+          e.preventDefault();
+          firstInvalid.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
