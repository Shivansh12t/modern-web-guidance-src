+  <!-- Floating Quick-Order Panel -->
+  <aside class="quick-order" id="quick-order" data-draggable aria-labelledby="qo-title">
+    <div class="qo-header" data-drag-handle tabindex="0" role="button"
+      aria-label="Move quick order panel. Drag, or use arrow keys when focused." aria-describedby="qo-title">
