+          <option value="Chai Latte" data-price="4.95">Chai Latte — $4.95</option>
+        </select>
+      </div>
+      <fieldset>
+        <legend class="qo-legend">Size</legend>
+        <div class="qo-sizes">
+          <label><input type="radio" name="qo-size" value="Small" data-extra="0"><span>S</span></label>
+          <label><input type="radio" name="qo-size" value="Medium" data-extra="0.50" checked><span>M +.50</span></label>
+          <label><input type="radio" name="qo-size" value="Large" data-extra="1.00"><span>L +1</span></label>
+        </div>
+      </fieldset>
+      <div class="qo-row">
+        <label class="qo-check"><input type="checkbox" id="qo-shot"> Extra shot (+$0.75)</label>
+      </div>
+      <div class="qo-row">
+        <span class="qo-legend" id="qo-qty-label" style="margin:0">Quantity</span>
+        <div class="qo-stepper" role="group" aria-labelledby="qo-qty-label">
+          <button type="button" id="qo-minus" aria-label="Decrease quantity">−</button>
+          <output id="qo-qty" aria-live="polite">1</output>
+          <button type="button" id="qo-plus" aria-label="Increase quantity">+</button>
+        </div>
+      </div>
+      <button type="submit" class="qo-add" id="qo-add">Add to Cart — $5.75</button>
+      <div class="qo-cart">
+        <ul id="qo-items" aria-label="Cart items"></ul>
+        <p class="qo-empty" id="qo-empty">Your cart is empty.</p>
+        <p class="qo-total">Total: <span id="qo-total">$0.00</span></p>
+        <button type="button" class="qo-checkout" id="qo-checkout" disabled>Checkout</button>
+        <p class="qo-status" id="qo-status" role="status" aria-live="polite"></p>
+      </div>
+    </form>
+  </aside>
+
+  <script>
+    (function () {
+      /* ---------- Draggable behaviour ---------- */
+      const STORAGE_POS = 'dailyGrind.quickOrder.pos';
+      const MARGIN = 8;
+
+      function clamp(panel, x, y) {
+        const maxX = window.innerWidth - panel.offsetWidth - MARGIN;
+        const maxY = window.innerHeight - panel.offsetHeight - MARGIN;
+        return {
+          x: Math.min(Math.max(MARGIN, x), Math.max(MARGIN, maxX)),
+          y: Math.min(Math.max(MARGIN, y), Math.max(MARGIN, maxY))
+        };
+      }
+
+      function place(panel, x, y) {
+        const p = clamp(panel, x, y);
+        panel.style.left = p.x + 'px';
+        panel.style.top = p.y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        return p;
+      }
+
+      function savePos(panel) {
+        try {
+          localStorage.setItem(STORAGE_POS, JSON.stringify({ x: panel.offsetLeft, y: panel.offsetTop }));
+        } catch (e) { /* storage unavailable */ }
+      }
+
+      function makeDraggable(panel) {
+        const handle = panel.querySelector('[data-drag-handle]');
+        if (!handle) return;
+        let start = null;
+
+        // Restore saved position
+        try {
+          const saved = JSON.parse(localStorage.getItem(STORAGE_POS));
+          if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) place(panel, saved.x, saved.y);
+        } catch (e) { /* ignore */ }
+
+        handle.addEventListener('pointerdown', function (e) {
+          if (e.button !== 0 || e.target.closest('button, a, input, select, textarea')) return;
+          const rect = panel.getBoundingClientRect();
+          start = { dx: e.clientX - rect.left, dy: e.clientY - rect.top, id: e.pointerId };
+          handle.setPointerCapture(e.pointerId);
+          panel.classList.add('is-dragging');
+          e.preventDefault();
+        });
+
+        handle.addEventListener('pointermove', function (e) {
+          if (!start || e.pointerId !== start.id) return;
+          place(panel, e.clientX - start.dx, e.clientY - start.dy);
+        });
+
+        function end(e) {
+          if (!start || e.pointerId !== start.id) return;
+          start = null;
+          panel.classList.remove('is-dragging');
+          if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+          savePos(panel);
+        }
+        handle.addEventListener('pointerup', end);
+        handle.addEventListener('pointercancel', end);
+
+        // Keyboard support: arrow keys move the panel (Shift = bigger steps)
+        handle.addEventListener('keydown', function (e) {
+          const step = e.shiftKey ? 40 : 10;
+          const moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
+          const m = moves[e.key];
+          if (!m) return;
+          e.preventDefault();
+          const rect = panel.getBoundingClientRect();
+          place(panel, rect.left + m[0], rect.top + m[1]);
+          savePos(panel);
+        });
+
+        // Keep panel on-screen when the viewport or panel size changes
+        function reclamp() {
+          if (panel.style.left) place(panel, panel.offsetLeft, panel.offsetTop);
+        }
+        window.addEventListener('resize', reclamp);
+        if ('ResizeObserver' in window) new ResizeObserver(reclamp).observe(panel);
+      }
+
+      document.querySelectorAll('[data-draggable]').forEach(makeDraggable);
+
+      /* ---------- Quick-order controls ---------- */
+      const $ = (id) => document.getElementById(id);
+      const panel = $('quick-order');
+      const form = $('qo-body');
+      const drink = $('qo-drink');
+      const shot = $('qo-shot');
+      const qtyOut = $('qo-qty');
+      const minus = $('qo-minus');
+      const plus = $('qo-plus');
+      const addBtn = $('qo-add');
+      const itemsEl = $('qo-items');
+      const emptyEl = $('qo-empty');
+      const totalEl = $('qo-total');
+      const badge = $('qo-badge');
+      const checkout = $('qo-checkout');
+      const status = $('qo-status');
+      const toggle = $('qo-toggle');
+      const MAX_QTY = 10;
+      const money = (n) => '$' + n.toFixed(2);
+
+      let qty = 1;
+      let cart = [];
+      try { cart = JSON.parse(sessionStorage.getItem('dailyGrind.cart')) || []; } catch (e) { cart = []; }
+
+      function selectedSize() {
+        return form.querySelector('input[name="qo-size"]:checked');
+      }
+
+      function unitPrice() {
+        const base = parseFloat(drink.selectedOptions[0].dataset.price);
+        const extra = parseFloat(selectedSize().dataset.extra);
+        return base + extra + (shot.checked ? 0.75 : 0);
+      }
+
+      function updateAddButton() {
+        qtyOut.textContent = qty;
+        minus.disabled = qty <= 1;
+        plus.disabled = qty >= MAX_QTY;
+        addBtn.textContent = 'Add to Cart — ' + money(unitPrice() * qty);
+      }
+
+      function renderCart() {
+        itemsEl.innerHTML = '';
+        let total = 0, count = 0;
+        cart.forEach(function (item, i) {
+          total += item.price * item.qty;
+          count += item.qty;
+          const li = document.createElement('li');
+          const name = document.createElement('span');
+          name.className = 'qo-item-name';
+          name.textContent = item.qty + '× ' + item.size + ' ' + item.name + (item.shot ? ' + shot' : '');
+          const price = document.createElement('span');
+          price.textContent = money(item.price * item.qty);
+          const rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'qo-remove';
+          rm.textContent = '×';
+          rm.setAttribute('aria-label', 'Remove ' + name.textContent);
+          rm.addEventListener('click', function () {
+            cart.splice(i, 1);
+            status.textContent = 'Item removed.';
+            renderCart();
+          });
+          li.append(name, price, rm);
+          itemsEl.appendChild(li);
+        });
+        emptyEl.hidden = cart.length > 0;
+        totalEl.textContent = money(total);
+        badge.textContent = count;
+        checkout.disabled = cart.length === 0;
+        try { sessionStorage.setItem('dailyGrind.cart', JSON.stringify(cart)); } catch (e) { /* ignore */ }
+      }
+
+      minus.addEventListener('click', function () { if (qty > 1) { qty--; updateAddButton(); } });
+      plus.addEventListener('click', function () { if (qty < MAX_QTY) { qty++; updateAddButton(); } });
+      form.addEventListener('change', updateAddButton);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const item = { name: drink.value, size: selectedSize().value, shot: shot.checked, price: unitPrice(), qty: qty };
+        const existing = cart.find(function (c) {
+          return c.name === item.name && c.size === item.size && c.shot === item.shot;
+        });
+        if (existing) existing.qty = Math.min(99, existing.qty + item.qty);
+        else cart.push(item);
+        status.textContent = 'Added ' + item.qty + '× ' + item.name + ' to your cart.';
+        qty = 1;
+        updateAddButton();
+        renderCart();
+      });
+
+      checkout.addEventListener('click', function () {
+        if (!cart.length) return;
+        window.location.href = '/order-online';
+      });
+
+      toggle.addEventListener('click', function () {
+        const collapsed = panel.classList.toggle('is-collapsed');
+        toggle.textContent = collapsed ? '+' : '−';
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', (collapsed ? 'Expand' : 'Collapse') + ' quick order panel');
+      });
+
+      updateAddButton();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
