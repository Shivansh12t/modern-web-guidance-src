+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      const grip = panel.querySelector('#qo-grip');
+      const announcer = document.getElementById('qo-announcer');
+      const EDGE = 12;
+      const STEP = 15;
+      const DRAG_THRESHOLD = 4;
+      panel.classList.add('js-ready');
+
+      /* ---------- Positioning ---------- */
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.classList.add('positioned');
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      function savePosition() {
+        try {
+          localStorage.setItem('dg-quick-order-pos', JSON.stringify({
+            left: panel.offsetLeft, top: panel.offsetTop
+          }));
+        } catch { /* storage unavailable */ }
+      }
+
+      let announceTimer;
+      function announce(msg) {
+        announcer.textContent = `Quick order panel ${msg}`;
+        clearTimeout(announceTimer);
+        announceTimer = setTimeout(() => { announcer.textContent = ''; }, 1000);
+      }
+
+      try {
+        const saved = JSON.parse(localStorage.getItem('dg-quick-order-pos'));
+        if (saved && Number.isFinite(saved.left) && Number.isFinite(saved.top)) moveTo(saved.left, saved.top);
+      } catch { /* ignore */ }
+
+      /* ---------- Pointer dragging ---------- */
+      let offsetX = 0, offsetY = 0, startX = 0, startY = 0, dragging = false;
+
+      handle.addEventListener('pointerdown', (event) => {
+        const control = event.target.closest('button, input, select, textarea, a');
+        if (event.button !== 0 || (control && control !== grip)) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        dragging = false;
+        panel.classList.remove('animate-position');
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!dragging) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < DRAG_THRESHOLD) return;
+          dragging = true;
+          handle.classList.add('dragging');
+          panel.classList.add('dragging-active');
+          closeMenu();
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+        panel.classList.remove('dragging-active');
+        if (dragging) {
+          savePosition();
+          announce('moved');
+        }
+        dragging = false;
+      });
+
+      /* ---------- Keyboard movement ---------- */
+      const KEY_DIRS = {
+        ArrowUp: [0, -1, 'up'], ArrowDown: [0, 1, 'down'],
+        ArrowLeft: [-1, 0, 'left'], ArrowRight: [1, 0, 'right']
+      };
+
+      function nudge(dx, dy, label, step = STEP) {
+        moveTo(panel.offsetLeft + dx * step, panel.offsetTop + dy * step);
+        savePosition();
+        announce(`moved ${label}`);
+      }
+
+      grip.addEventListener('keydown', (event) => {
+        const dir = KEY_DIRS[event.key];
+        if (!dir) return;
+        event.preventDefault();
+        panel.classList.remove('animate-position');
+        nudge(dir[0], dir[1], dir[2], event.shiftKey ? STEP * 4 : STEP);
+      });
+
+      /* ---------- Reposition menu (single-pointer alternative) ---------- */
+      const menuToggle = panel.querySelector('#qo-menu-toggle');
+      const menu = panel.querySelector('#qo-menu');
+
+      function openMenu() {
+        menu.hidden = false;
+        menuToggle.setAttribute('aria-expanded', 'true');
+        menu.querySelector('button').focus();
+      }
+      function closeMenu(returnFocus = false) {
+        if (menu.hidden) return;
+        menu.hidden = true;
+        menuToggle.setAttribute('aria-expanded', 'false');
+        if (returnFocus) menuToggle.focus();
+      }
+
+      menuToggle.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu()));
+      menu.addEventListener('keydown', (event) => {
+        const items = [...menu.querySelectorAll('button')];
+        const i = items.indexOf(document.activeElement);
+        if (event.key === 'Escape') { event.preventDefault(); closeMenu(true); }
+        else if (event.key === 'ArrowDown') { event.preventDefault(); items[(i + 1) % items.length].focus(); }
+        else if (event.key === 'ArrowUp') { event.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
+        else if (event.key === 'Home') { event.preventDefault(); items[0].focus(); }
+        else if (event.key === 'End') { event.preventDefault(); items.at(-1).focus(); }
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (!event.target.closest('.qo-menu-wrap')) closeMenu();
+      });
+
+      menu.addEventListener('click', (event) => {
+        const btn = event.target.closest('button');
+        if (!btn) return;
+        panel.classList.add('animate-position');
+        if (btn.dataset.dock) {
+          const [v, h] = btn.dataset.dock.split('-');
+          const navH = document.querySelector('nav')?.offsetHeight ?? 0;
+          const left = h === 'left' ? EDGE : window.innerWidth - panel.offsetWidth - EDGE;
+          const top = v === 'top' ? navH + EDGE : window.innerHeight - panel.offsetHeight - EDGE;
+          moveTo(left, top);
+          savePosition();
+          announce(`docked ${v} ${h}`);
+        } else {
+          const dir = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] }[btn.dataset.nudge];
+          nudge(dir[0], dir[1], btn.dataset.nudge, STEP * 4);
+        }
+        closeMenu(true);
+      });
+
+      /* ---------- Help & collapse ---------- */
+      const helpToggle = panel.querySelector('#qo-help-toggle');
+      const help = panel.querySelector('#qo-help');
+      helpToggle.addEventListener('click', () => {
+        help.hidden = !help.hidden;
+        helpToggle.setAttribute('aria-expanded', String(!help.hidden));
+      });
+
+      const collapseBtn = panel.querySelector('#qo-collapse');
+      collapseBtn.addEventListener('click', () => {
+        const collapsed = panel.classList.toggle('collapsed');
+        collapseBtn.setAttribute('aria-expanded', String(!collapsed));
+        collapseBtn.setAttribute('aria-label', `${collapsed ? 'Expand' : 'Collapse'} quick order panel`);
+        collapseBtn.querySelector('span').textContent = collapsed ? '+' : '–';
+        if (panel.classList.contains('positioned')) moveTo(panel.offsetLeft, panel.offsetTop);
+      });
+
+      /* Keep panel reachable after viewport/size changes */
+      const reclamp = () => {
+        if (panel.classList.contains('positioned')) moveTo(panel.offsetLeft, panel.offsetTop);
+      };
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      /* ---------- Cart logic ---------- */
+      const form = panel.querySelector('#qo-body');
+      const sizeSelect = form.querySelector('#qo-size');
+      const totalEl = form.querySelector('#qo-total');
+      const countEl = form.querySelector('#qo-count');
+      const submitBtn = form.querySelector('#qo-submit');
+      const statusEl = form.querySelector('#qo-status');
+      const items = [...form.querySelectorAll('.qo-item')];
+      const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const MAX_QTY = 9;
+
+      function update() {
+        const sizeExtra = parseFloat(sizeSelect.value);
+        let count = 0, total = 0;
+        for (const item of items) {
+          const qty = Number(item.querySelector('input').value);
+          count += qty;
+          total += qty * (parseFloat(item.dataset.price) + sizeExtra);
+          const [minus, plus] = item.querySelectorAll('button');
+          minus.disabled = qty <= 0;
+          plus.disabled = qty >= MAX_QTY;
+        }
+        countEl.textContent = count;
+        totalEl.textContent = fmt.format(total);
+        submitBtn.disabled = count === 0;
+      }
+
+      form.addEventListener('click', (event) => {
+        const btn = event.target.closest('[data-step]');
+        if (!btn) return;
+        const item = btn.closest('.qo-item');
+        const input = item.querySelector('input');
+        const qty = Math.max(0, Math.min(MAX_QTY, Number(input.value) + Number(btn.dataset.step)));
+        input.value = qty;
+        item.querySelector('output').textContent = qty;
+        statusEl.textContent = '';
+        update();
+      });
+      sizeSelect.addEventListener('change', update);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const count = countEl.textContent;
+        const total = totalEl.textContent;
+        statusEl.textContent = `Order placed! ${count} item${count === '1' ? '' : 's'} · ${total}. See you soon ☕`;
+        for (const item of items) {
+          item.querySelector('input').value = 0;
+          item.querySelector('output').textContent = 0;
+        }
+        update();
+      });
+
+      update();
+    })();
+  </script>
+
 </body>
 
