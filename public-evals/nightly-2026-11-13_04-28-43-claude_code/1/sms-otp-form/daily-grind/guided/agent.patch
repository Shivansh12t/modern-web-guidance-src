+
+  <script>
+    (() => {
+      const phoneStep = document.getElementById('phone-step');
+      const otpStep = document.getElementById('otp-step');
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const phoneError = document.getElementById('phone-error');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpError = document.getElementById('otp-error');
+      const otpPhone = document.getElementById('otp-phone');
+      const otpPurpose = document.getElementById('otp-purpose');
+      const otpPhoneDisplay = document.getElementById('otp-phone-display');
+      const resendBtn = document.getElementById('resend-btn');
+      const changeNumberBtn = document.getElementById('change-number-btn');
+      const status = document.getElementById('verify-status');
+
+      // JS takes over validation with inline, announced messages; without JS,
+      // native constraint validation and a normal POST still work.
+      phoneForm.noValidate = true;
+      otpForm.noValidate = true;
+
+      const MESSAGES = {
+        phone: {
+          valueMissing: 'Enter your mobile phone number.',
+          default: 'Enter a valid phone number using digits, spaces, dashes, or a leading +.',
+        },
+        otp: {
+          valueMissing: 'Enter the 6-digit code from the text message.',
+          default: 'The code must be exactly 6 digits.',
+        },
+      };
+
+      // ---- Validation helpers (validate on blur/submit, clear on input) ----
+      function messageFor(input) {
+        const set = MESSAGES[input.name];
+        return input.validity.valueMissing ? set.valueMissing : set.default;
+      }
+
+      function showError(input, errorEl, message) {
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = message;
+      }
+
+      function clearError(input, errorEl) {
+        input.removeAttribute('aria-invalid');
+        errorEl.textContent = '';
+      }
+
+      function validate(input, errorEl) {
+        if (input.checkValidity()) {
+          clearError(input, errorEl);
+          return true;
+        }
+        showError(input, errorEl, messageFor(input));
+        return false;
+      }
+
+      function wireValidation(input, errorEl) {
+        let edited = false;
+        input.addEventListener('input', () => {
+          edited = true;
+          if (input.getAttribute('aria-invalid') === 'true' && input.checkValidity()) {
+            clearError(input, errorEl);
+          }
+        });
+        input.addEventListener('blur', () => {
+          if (edited) validate(input, errorEl);
+        });
+      }
+
+      wireValidation(phoneInput, phoneError);
+      wireValidation(otpInput, otpError);
+
+      // Keep the OTP field digits-only (handles pasted "123 456" or "123-456").
+      otpInput.addEventListener('input', () => {
+        const digits = otpInput.value.replace(/\D/g, '').slice(0, 6);
+        if (digits !== otpInput.value) otpInput.value = digits;
+      });
+
+      async function post(form) {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          body: new FormData(form),
+          headers: { Accept: 'application/json' },
+          credentials: 'same-origin',
+        });
+        let data = {};
+        try { data = await response.json(); } catch { /* non-JSON body */ }
+        return { ok: response.ok, data };
+      }
+
+      // ---- WebOTP: automatic code extraction from the incoming SMS ----
+      let otpAbortController = null;
+
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        if (!('OTPCredential' in window)) return; // falls back to autocomplete="one-time-code" / manual entry
+
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+          if (!otp || ac.signal.aborted) return;
+          otpInput.value = otp.code;
+          clearError(otpInput, otpError);
+          otpForm.requestSubmit(); // runs the submit handler + constraint validation
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error('WebOTP error:', err);
+        }
+      }
+
+      // ---- Step transitions ----
+      function showOtpStep() {
+        const purpose = phoneForm.elements.purpose.value;
+        otpPhone.value = phoneInput.value.trim();
+        otpPurpose.value = purpose;
+        otpPhoneDisplay.textContent = phoneInput.value.trim();
+        otpForm.querySelector('button[type="submit"]').textContent =
+          purpose === 'order' ? 'Verify and continue to order' : 'Verify and sign in';
+
+        otpInput.value = '';
+        clearError(otpInput, otpError);
+        phoneStep.hidden = true;
+        otpStep.hidden = false;
+        document.getElementById('otp-heading').focus();
+        startSmsOtpListener();
+      }
+
+      function showPhoneStep() {
+        stopSmsOtpListener();
+        otpStep.hidden = true;
+        phoneStep.hidden = false;
+        status.textContent = '';
+        phoneInput.focus();
+      }
+
+      async function requestCode(form, button) {
+        button.disabled = true;
+        status.textContent = 'Sending your code…';
+        try {
+          const { ok, data } = await post(form);
+          if (!ok) {
+            const message = data.message || 'We couldn’t send a code to that number. Check it and try again.';
+            if (phoneStep.hidden) {
+              status.textContent = message; // resend failed while on the code step
+            } else {
+              status.textContent = '';
+              showError(phoneInput, phoneError, message);
+              phoneInput.focus();
+            }
+            return false;
+          }
+          status.textContent = `Code sent to ${phoneInput.value.trim()}.`;
+          return true;
+        } catch {
+          status.textContent = 'We couldn’t reach the server. Check your connection and try again.';
+          return false;
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      // ---- Phone form ----
+      phoneForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (!validate(phoneInput, phoneError)) {
+          phoneInput.focus();
+          return;
+        }
+        const button = phoneForm.querySelector('button[type="submit"]');
+        if (await requestCode(phoneForm, button)) showOtpStep();
+      });
+
+      // ---- OTP form ----
+      otpForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        stopSmsOtpListener();
+
+        if (!validate(otpInput, otpError)) {
+          otpInput.focus();
+          startSmsOtpListener(); // keep listening for the SMS while the user corrects the entry
+          return;
+        }
+
+        const button = otpForm.querySelector('button[type="submit"]');
+        button.disabled = true;
+        status.textContent = 'Verifying…';
+
+        try {
+          const { ok, data } = await post(otpForm);
+          if (!ok) {
+            status.textContent = '';
+            showError(otpInput, otpError, data.message || 'That code didn’t match or has expired. Try again or resend a new code.');
+            otpInput.select();
+            otpInput.focus();
+            startSmsOtpListener();
+            return;
+          }
+          status.textContent = 'Verified! Redirecting…';
+          const fallback = otpPurpose.value === 'order' ? '/order-online' : '/rewards';
+          const next = typeof data.redirect === 'string' && data.redirect.startsWith('/') && !data.redirect.startsWith('//')
+            ? data.redirect
+            : fallback;
+          window.location.assign(next);
+        } catch {
+          status.textContent = 'We couldn’t reach the server. Check your connection and try again.';
+          startSmsOtpListener();
+        } finally {
+          button.disabled = false;
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        stopSmsOtpListener();
+        otpInput.value = '';
+        clearError(otpInput, otpError);
+        await requestCode(phoneForm, resendBtn);
+        otpInput.focus();
+        startSmsOtpListener();
+      });
+
+      changeNumberBtn.addEventListener('click', showPhoneStep);
+
+      // Abort any pending WebOTP request when navigating away.
+      window.addEventListener('pagehide', stopSmsOtpListener);
+    })();
+  </script>
 </body>
 
