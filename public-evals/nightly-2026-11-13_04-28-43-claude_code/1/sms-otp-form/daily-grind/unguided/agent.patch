+  <script>
+    (() => {
+      // Backend endpoints. The SMS sent by /api/otp/send should end with a WebOTP origin-bound line, e.g.:
+      //   "Your Daily Grind code is 123456.\n\n@dailygrind.com #123456"
+      // so supporting browsers (Chrome on Android) can extract the code automatically.
+      const API = { send: '/api/otp/send', verify: '/api/otp/verify' };
+      const CODE_LENGTH = 6;
+      const RESEND_COOLDOWN = 30; // seconds
+
+      const $ = (id) => document.getElementById(id);
+      const phoneForm = $('phone-form');
+      const codeForm = $('code-form');
+      const phoneInput = $('phone');
+      const codeInput = $('otp-code');
+      const phoneError = $('phone-error');
+      const codeError = $('otp-error');
+      const sendBtn = $('send-btn');
+      const verifyBtn = $('verify-btn');
+      const resendBtn = $('resend-btn');
+      const changeBtn = $('change-phone-btn');
+      const status = $('otp-status');
+
+      let phoneE164 = '';
+      let purpose = 'rewards';
+      let webOtpAbort = null;
+      let cooldownTimer = null;
+      let verifying = false;
+
+      const setStatus = (msg, ok = false) => {
+        status.textContent = msg;
+        status.classList.toggle('success', ok);
+      };
+
+      const setError = (input, el, msg) => {
+        el.textContent = msg;
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      };
+
+      const normalizePhone = (raw) => {
+        let digits = raw.replace(/\D/g, '');
+        if (digits.length === 11 && digits.startsWith('1')) digits = digits.slice(1);
+        return digits.length === 10 ? '+1' + digits : null;
+      };
+
+      const formatPhone = (e164) => {
+        const d = e164.slice(2);
+        return `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
+      };
+
+      async function post(url, body) {
+        const res = await fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(body),
+        });
+        let data = {};
+        try { data = await res.json(); } catch { /* non-JSON response */ }
+        if (!res.ok) {
+          const err = new Error(data.message || 'Something went wrong. Please try again.');
+          err.status = res.status;
+          throw err;
+        }
+        return data;
+      }
+
+      function stopWebOtp() {
+        if (webOtpAbort) {
+          webOtpAbort.abort();
+          webOtpAbort = null;
+        }
+      }
+
+      // Listen for an incoming SMS via the WebOTP API and auto-fill/submit the code.
+      function startWebOtp() {
+        stopWebOtp();
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        webOtpAbort = new AbortController();
+        navigator.credentials
+          .get({ otp: { transport: ['sms'] }, signal: webOtpAbort.signal })
+          .then((otp) => {
+            if (!otp || !otp.code || codeForm.hidden) return;
+            codeInput.value = otp.code.replace(/\D/g, '').slice(0, CODE_LENGTH);
+            setStatus('Code received from your text message.');
+            codeForm.requestSubmit();
+          })
+          .catch(() => { /* aborted, timed out, or user dismissed — manual entry still works */ });
+      }
+
+      function startCooldown() {
+        clearInterval(cooldownTimer);
+        let remaining = RESEND_COOLDOWN;
+        resendBtn.disabled = true;
+        const tick = () => {
+          if (remaining <= 0) {
+            clearInterval(cooldownTimer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+            return;
+          }
+          resendBtn.textContent = `Resend code (${remaining}s)`;
+          remaining--;
+        };
+        tick();
+        cooldownTimer = setInterval(tick, 1000);
+      }
+
+      async function sendCode() {
+        await post(API.send, { phone: phoneE164, purpose });
+        startWebOtp();
+        startCooldown();
+      }
+
+      function showStep(step) {
+        const codeStep = step === 'code';
+        phoneForm.hidden = codeStep;
+        codeForm.hidden = !codeStep;
+        (codeStep ? codeInput : phoneInput).focus();
+      }
+
+      phoneForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        setStatus('');
+        const normalized = normalizePhone(phoneInput.value);
+        if (!normalized) {
+          setError(phoneInput, phoneError, 'Enter a valid 10-digit US mobile number.');
+          phoneInput.focus();
+          return;
+        }
+        setError(phoneInput, phoneError, '');
+        phoneE164 = normalized;
+        purpose = phoneForm.elements.purpose.value;
+
+        sendBtn.disabled = true;
+        sendBtn.textContent = 'Sending…';
+        try {
+          await sendCode();
+          $('sent-to').textContent = formatPhone(phoneE164);
+          codeInput.value = '';
+          setError(codeInput, codeError, '');
+          showStep('code');
+          setStatus(`We texted a ${CODE_LENGTH}-digit code to ${formatPhone(phoneE164)}.`);
+        } catch (err) {
+          setError(phoneInput, phoneError, err.status === 429
+            ? 'Too many requests. Please wait a few minutes and try again.'
+            : err.message || 'We couldn’t send a code. Please try again.');
+          phoneInput.focus();
+        } finally {
+          sendBtn.disabled = false;
+          sendBtn.textContent = 'Text me a code';
+        }
+      });
+
+      // Keep the code field digits-only (handles typing, paste, and autofill like "123 456").
+      codeInput.addEventListener('input', () => {
+        const clean = codeInput.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (clean !== codeInput.value) codeInput.value = clean;
+        if (codeError.textContent) setError(codeInput, codeError, '');
+        // Auto-submit once a full code is present (e.g. iOS/Android keyboard autofill).
+        if (clean.length === CODE_LENGTH && !verifying) codeForm.requestSubmit();
+      });
+
+      codeForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        if (verifying) return;
+        const code = codeInput.value.replace(/\D/g, '');
+        if (code.length !== CODE_LENGTH) {
+          setError(codeInput, codeError, `Enter the ${CODE_LENGTH}-digit code from your text message.`);
+          codeInput.focus();
+          return;
+        }
+        setError(codeInput, codeError, '');
+        verifying = true;
+        verifyBtn.disabled = true;
+        verifyBtn.textContent = 'Verifying…';
+        try {
+          const data = await post(API.verify, { phone: phoneE164, code, purpose });
+          stopWebOtp();
+          clearInterval(cooldownTimer);
+          codeInput.disabled = true;
+          resendBtn.disabled = true;
+          setStatus(purpose === 'order'
+            ? 'Phone verified! Taking you to your order…'
+            : 'Phone verified! Signing you in to Rewards…', true);
+          const fallback = purpose === 'order' ? '/order-online' : '/rewards';
+          const next = data.redirect && data.redirect.startsWith('/') && !data.redirect.startsWith('//')
+            ? data.redirect : fallback;
+          setTimeout(() => { window.location.assign(next); }, 800);
+          return;
+        } catch (err) {
+          const msg = err.status === 429
+            ? 'Too many attempts. Please request a new code.'
+            : err.status === 400 || err.status === 401
+              ? 'That code is incorrect or has expired. Check your text and try again.'
+              : err.message;
+          setError(codeInput, codeError, msg);
+          codeInput.select();
+          codeInput.focus();
+        } finally {
+          verifying = false;
+          if (!codeInput.disabled) {
+            verifyBtn.disabled = false;
+            verifyBtn.textContent = 'Verify code';
+          }
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        resendBtn.disabled = true;
+        setError(codeInput, codeError, '');
+        try {
+          await sendCode();
+          codeInput.value = '';
+          codeInput.focus();
+          setStatus(`A new code was sent to ${formatPhone(phoneE164)}.`);
+        } catch (err) {
+          resendBtn.disabled = false;
+          setError(codeInput, codeError, err.message || 'We couldn’t resend the code. Please try again.');
+        }
+      });
+
+      changeBtn.addEventListener('click', () => {
+        stopWebOtp();
+        clearInterval(cooldownTimer);
+        resendBtn.disabled = false;
+        resendBtn.textContent = 'Resend code';
+        setStatus('');
+        showStep('phone');
+      });
+    })();
+  </script>
 </body>
 
