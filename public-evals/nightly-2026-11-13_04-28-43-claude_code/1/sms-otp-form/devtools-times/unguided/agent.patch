+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LENGTH = 6;
+export const CODE_TTL_MS = 5 * 60 * 1000;
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+export const MAX_ATTEMPTS = 5;
+export const MAX_SENDS_PER_WINDOW = 5;
+export const SEND_WINDOW_MS = 60 * 60 * 1000;
+export const VERIFIED_TTL_MS = 15 * 60 * 1000;
+
+export interface PendingVerification {
+  phone: string;
+  codeHash: string;
+  expiresAt: number;
+  attempts: number;
+  lastSentAt: number;
+  sendHistory: number[];
+}
+
+export interface VerifiedPhone {
+  phone: string;
+  verifiedAt: number;
+}
+
+/** Normalize to E.164 (+ followed by 8–15 digits). Returns null if invalid. */
+export function normalizePhone(countryCode: unknown, national: unknown): string | null {
+  if (typeof countryCode !== 'string' || typeof national !== 'string') return null;
+  const cc = countryCode.replace(/[^\d]/g, '');
+  let nat = national.replace(/[\s().-]/g, '');
+  if (nat.startsWith('+')) {
+    // User typed a full international number; ignore the selector.
+    nat = nat.slice(1);
+    return /^[1-9]\d{7,14}$/.test(nat) ? `+${nat}` : null;
+  }
+  if (!/^\d+$/.test(nat) || !/^[1-9]\d{0,3}$/.test(cc)) return null;
+  nat = nat.replace(/^0+/, ''); // drop trunk prefix
+  const full = `${cc}${nat}`;
+  return /^[1-9]\d{7,14}$/.test(full) ? `+${full}` : null;
+}
+
+export function maskPhone(phone: string): string {
+  return phone.length <= 4 ? phone : `${phone.slice(0, 3)}${'•'.repeat(Math.max(0, phone.length - 5))}${phone.slice(-2)}`;
+}
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** CODE_LENGTH).toString().padStart(CODE_LENGTH, '0');
+}
+
+export function hashCode(phone: string, code: string): string {
+  const secret = process.env.OTP_SECRET ?? 'devtools-times-otp';
+  return createHash('sha256').update(`${secret}:${phone}:${code}`).digest('hex');
+}
+
+export function codeMatches(pending: PendingVerification, code: string): boolean {
+  const a = Buffer.from(pending.codeHash, 'hex');
+  const b = Buffer.from(hashCode(pending.phone, code), 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Build an SMS body compatible with the WebOTP API so supporting browsers can
+ * read the code automatically. The last line must be `@<origin host> #<code>`.
+ */
+export function buildSmsBody(code: string, host: string): string {
+  return `${code} is your DevTools Times verification code. It expires in 5 minutes.\n\n@${host} #${code}`;
+}
+
+/**
+ * Deliver the SMS. No SMS provider is configured in this project, so by
+ * default the message is logged on the server. Set SMS_WEBHOOK_URL to POST
+ * `{ to, body }` to a delivery service (e.g. a Twilio/Vonage relay).
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  const webhook = process.env.SMS_WEBHOOK_URL;
+  if (webhook) {
+    const res = await fetch(webhook, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        ...(process.env.SMS_WEBHOOK_TOKEN ? { Authorization: `Bearer ${process.env.SMS_WEBHOOK_TOKEN}` } : {}),
+      },
+      body: JSON.stringify({ to, body }),
+    });
+    if (!res.ok) throw new Error(`SMS delivery failed with status ${res.status}`);
+    return;
+  }
+  console.info(`[sms] to=${to}\n${body}`);
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
diff --git a/src/pages/api/phone/send-code.ts b/src/pages/api/phone/send-code.ts
new file mode 100644
index 0000000..951e7f6
--- /dev/null
+++ b/src/pages/api/phone/send-code.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_TTL_MS,
+  MAX_SENDS_PER_WINDOW,
+  RESEND_COOLDOWN_MS,
+  SEND_WINDOW_MS,
+  buildSmsBody,
+  generateCode,
+  hashCode,
+  json,
+  maskPhone,
+  normalizePhone,
+  sendSms,
+  type PendingVerification,
+} from '../../../lib/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { countryCode?: unknown; phone?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(body.countryCode, body.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid mobile number, including the country code.', field: 'phone' }, 400);
+  }
+
+  const now = Date.now();
+  const previous = (await session.get('phoneVerification')) as PendingVerification | undefined;
+  const sendHistory = (previous?.sendHistory ?? []).filter((t) => now - t < SEND_WINDOW_MS);
+
+  if (previous && now - previous.lastSentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - previous.lastSentAt)) / 1000);
+    return json({ error: `Please wait ${retryAfter} seconds before requesting another code.`, retryAfter }, 429, {
+      'Retry-After': String(retryAfter),
+    });
+  }
+  if (sendHistory.length >= MAX_SENDS_PER_WINDOW) {
+    return json({ error: 'Too many codes requested. Please try again later.' }, 429);
+  }
+
+  const code = generateCode();
+  const pending: PendingVerification = {
+    phone,
+    codeHash: hashCode(phone, code),
+    expiresAt: now + CODE_TTL_MS,
+    attempts: 0,
+    lastSentAt: now,
+    sendHistory: [...sendHistory, now],
+  };
+
+  try {
+    await sendSms(phone, buildSmsBody(code, url.host));
+  } catch (err) {
+    console.error(err);
+    return json({ error: 'We could not send a text message to that number. Please try again.' }, 502);
+  }
+
+  await session.set('phoneVerification', pending);
+  session.delete('verifiedPhone');
+
+  return json({
+    maskedPhone: maskPhone(phone),
+    expiresIn: CODE_TTL_MS / 1000,
+    resendIn: RESEND_COOLDOWN_MS / 1000,
+  });
+};
diff --git a/src/pages/api/phone/verify-code.ts b/src/pages/api/phone/verify-code.ts
new file mode 100644
index 0000000..56f6fb4
--- /dev/null
+++ b/src/pages/api/phone/verify-code.ts
@@ -0,0 +1,55 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_LENGTH,
+  MAX_ATTEMPTS,
+  codeMatches,
+  json,
+  type PendingVerification,
+  type VerifiedPhone,
+} from '../../../lib/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { code?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== CODE_LENGTH) {
+    return json({ error: `Enter the ${CODE_LENGTH}-digit code.` }, 400);
+  }
+
+  const pending = (await session.get('phoneVerification')) as PendingVerification | undefined;
+  if (!pending) return json({ error: 'No verification in progress. Request a new code.', expired: true }, 400);
+
+  if (Date.now() > pending.expiresAt) {
+    return json({ error: 'This code has expired. Request a new one.', expired: true }, 400);
+  }
+  if (pending.attempts >= MAX_ATTEMPTS) {
+    return json({ error: 'Too many incorrect attempts. Request a new code.', expired: true }, 429);
+  }
+
+  if (!codeMatches(pending, code)) {
+    const attempts = pending.attempts + 1;
+    // Invalidate the code outright once attempts are exhausted.
+    await session.set('phoneVerification', { ...pending, attempts, ...(attempts >= MAX_ATTEMPTS ? { expiresAt: 0 } : {}) });
+    const remaining = MAX_ATTEMPTS - attempts;
+    return json(
+      remaining > 0
+        ? { error: `That code is incorrect. ${remaining} ${remaining === 1 ? 'attempt' : 'attempts'} remaining.`, remaining }
+        : { error: 'Too many incorrect attempts. Request a new code.', expired: true, remaining: 0 },
+      400,
+    );
+  }
+
+  // Keep send history so rate limits survive a successful verification.
+  await session.set('phoneVerification', { ...pending, codeHash: '', expiresAt: 0 });
+  const verified: VerifiedPhone = { phone: pending.phone, verifiedAt: Date.now() };
+  await session.set('verifiedPhone', verified);
+
+  return json({ verified: true });
+};
diff --git a/src/pages/api/register.ts b/src/pages/api/register.ts
