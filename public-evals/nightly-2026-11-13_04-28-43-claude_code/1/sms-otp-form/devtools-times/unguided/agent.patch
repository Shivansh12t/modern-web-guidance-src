index 0000000..0e0c0a9
--- /dev/null
+++ b/src/pages/api/register.ts
@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+import { VERIFIED_TTL_MS, json, type VerifiedPhone } from '../../lib/phoneVerification';
+
+const REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+/** Proxies registration to the upstream API, but only once the phone number is verified. */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are not available.' }, 500);
+
+  let body: { username?: unknown; password?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+  const { username, password } = body;
+  if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || !password) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  const verified = (await session.get('verifiedPhone')) as VerifiedPhone | undefined;
+  if (!verified || Date.now() - verified.verifiedAt > VERIFIED_TTL_MS) {
+    return json({ error: 'Please verify your phone number before signing up.', needsVerification: true }, 403);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(REGISTER_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password, phone: verified.phone }),
+    });
+  } catch {
+    return json({ error: 'The registration service is unavailable. Please try again later.' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (upstream.ok) {
+    session.delete('verifiedPhone');
+    session.delete('phoneVerification');
+  }
+  return json(data, upstream.status);
+};
