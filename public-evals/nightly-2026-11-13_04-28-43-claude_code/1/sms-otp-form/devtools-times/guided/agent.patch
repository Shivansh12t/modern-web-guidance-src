+import type { APIRoute } from 'astro';
+import { normalizePhone, sendVerificationCode } from '../../../lib/phoneVerification';
+
+const json = (body: unknown, status = 200, headers: Record<string, string> = {}) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+
+export const POST: APIRoute = async ({ request, url }) => {
+  let body: { phone?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json(
+      { error: 'Enter a valid mobile number including the country code, e.g. +1 555 123 4567.' },
+      400,
+    );
+  }
+
+  // Host only (no scheme/port/path) for the `@domain #code` SMS binding line.
+  const result = await sendVerificationCode(phone, url.hostname);
+  if (!result.ok) {
+    return json(
+      { error: result.error, retryAfterSeconds: result.retryAfterSeconds },
+      result.status,
+      result.retryAfterSeconds ? { 'Retry-After': String(result.retryAfterSeconds) } : {},
+    );
+  }
+
+  return json({
+    phone,
+    expiresInSeconds: result.expiresInSeconds,
+    resendInSeconds: result.resendInSeconds,
+  });
+};
