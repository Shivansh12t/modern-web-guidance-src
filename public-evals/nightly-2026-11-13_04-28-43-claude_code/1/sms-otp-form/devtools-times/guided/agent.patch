index 0000000..ef2b4cd
--- /dev/null
+++ b/src/lib/phoneVerification.ts
@@ -0,0 +1,158 @@
+import { createHmac, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+
+/**
+ * Server-side SMS one-time passcode (OTP) verification.
+ *
+ * Codes are stored in memory (hashed) for a short time. In a multi-instance
+ * deployment, swap the Map for a shared store (e.g. Redis) and wire `sendSms`
+ * to a real SMS provider.
+ */
+
+export const OTP_LENGTH = 6;
+const OTP_TTL_MS = 5 * 60 * 1000;
+const RESEND_COOLDOWN_MS = 30 * 1000;
+const MAX_ATTEMPTS = 5;
+const TOKEN_TTL_MS = 15 * 60 * 1000;
+
+const SECRET =
+  process.env.PHONE_VERIFICATION_SECRET ?? randomBytes(32).toString('hex');
+
+interface PendingCode {
+  codeHash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+const pending = new Map<string, PendingCode>();
+
+function hmac(value: string): string {
+  return createHmac('sha256', SECRET).update(value).digest('hex');
+}
+
+function safeEqual(a: string, b: string): boolean {
+  const ab = Buffer.from(a);
+  const bb = Buffer.from(b);
+  return ab.length === bb.length && timingSafeEqual(ab, bb);
+}
+
+function prune(now: number) {
+  for (const [phone, entry] of pending) {
+    if (entry.expiresAt <= now) pending.delete(phone);
+  }
+}
+
+/** Normalizes user input to E.164 (`+15551234567`), or returns null if invalid. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  if (!/^\+?[\d\s().-]+$/.test(trimmed)) return null;
+  const digits = trimmed.replace(/\D/g, '');
+  const e164 = `+${digits}`;
+  return /^\+[1-9]\d{7,14}$/.test(e164) ? e164 : null;
+}
+
+/**
+ * Builds the SMS body. The last line MUST be `@<host> #<code>` so WebOTP and
+ * `autocomplete="one-time-code"` autofill can bind the code to our origin.
+ */
+export function buildSmsMessage(host: string, code: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+async function sendSms(phone: string, message: string): Promise<void> {
+  // TODO: Replace with a real SMS provider integration.
+  console.info(`[sms] to ${phone}:\n${message}`);
+}
+
+export type SendResult =
+  | { ok: true; expiresInSeconds: number; resendInSeconds: number }
+  | { ok: false; status: number; error: string; retryAfterSeconds?: number };
+
+export async function sendVerificationCode(phone: string, host: string): Promise<SendResult> {
+  const now = Date.now();
+  prune(now);
+
+  const existing = pending.get(phone);
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfterSeconds = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return {
+      ok: false,
+      status: 429,
+      error: `Please wait ${retryAfterSeconds} seconds before requesting a new code.`,
+      retryAfterSeconds,
+    };
+  }
+
+  const code = randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+  pending.set(phone, {
+    codeHash: hmac(`${phone}:${code}`),
+    expiresAt: now + OTP_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  });
+
+  await sendSms(phone, buildSmsMessage(host, code));
+
+  return {
+    ok: true,
+    expiresInSeconds: OTP_TTL_MS / 1000,
+    resendInSeconds: RESEND_COOLDOWN_MS / 1000,
+  };
+}
+
+export type VerifyResult =
+  | { ok: true; verificationToken: string }
+  | { ok: false; status: number; error: string };
+
+export function verifyCode(phone: string, code: unknown): VerifyResult {
+  if (typeof code !== 'string' || !new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return { ok: false, status: 400, error: `Enter the ${OTP_LENGTH}-digit code.` };
+  }
+
+  const now = Date.now();
+  const entry = pending.get(phone);
+  if (!entry || entry.expiresAt <= now) {
+    pending.delete(phone);
+    return { ok: false, status: 410, error: 'This code has expired. Request a new one.' };
+  }
+
+  if (entry.attempts >= MAX_ATTEMPTS) {
+    pending.delete(phone);
+    return { ok: false, status: 429, error: 'Too many incorrect attempts. Request a new code.' };
+  }
+
+  entry.attempts += 1;
+  if (!safeEqual(entry.codeHash, hmac(`${phone}:${code}`))) {
+    const remaining = MAX_ATTEMPTS - entry.attempts;
+    return {
+      ok: false,
+      status: 400,
+      error:
+        remaining > 0
+          ? `That code is incorrect. ${remaining} attempt${remaining === 1 ? '' : 's'} left.`
+          : 'Too many incorrect attempts. Request a new code.',
+    };
+  }
+
+  pending.delete(phone);
+  return { ok: true, verificationToken: issueToken(phone, now + TOKEN_TTL_MS) };
+}
+
+/** Signed, short-lived proof that `phone` was verified; checked at registration. */
+function issueToken(phone: string, expiresAt: number): string {
+  const payload = Buffer.from(JSON.stringify({ phone, exp: expiresAt })).toString('base64url');
+  return `${payload}.${hmac(payload)}`;
+}
+
+export function readVerificationToken(token: unknown): string | null {
+  if (typeof token !== 'string') return null;
+  const [payload, sig] = token.split('.');
+  if (!payload || !sig || !safeEqual(sig, hmac(payload))) return null;
+  try {
+    const { phone, exp } = JSON.parse(Buffer.from(payload, 'base64url').toString());
+    return typeof phone === 'string' && typeof exp === 'number' && exp > Date.now() ? phone : null;
+  } catch {
+    return null;
+  }
+}
