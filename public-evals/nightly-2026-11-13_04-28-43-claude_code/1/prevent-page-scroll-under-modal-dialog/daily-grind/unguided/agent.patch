+    (function () {
+      const noticeDialog = document.getElementById("notice-dialog");
+      const closeButton = document.getElementById("close-notice");
+      if (!noticeDialog || typeof noticeDialog.showModal !== "function") return;
+
+      const root = document.documentElement;
+
+      function lockScroll() {
+        // Compensate for the disappearing scrollbar to avoid layout shift.
+        const scrollbarWidth = window.innerWidth - root.clientWidth;
+        if (scrollbarWidth > 0) {
+          document.body.style.paddingRight = scrollbarWidth + "px";
+        }
+        root.classList.add("modal-open");
+      }
+
+      function unlockScroll() {
+        root.classList.remove("modal-open");
+        document.body.style.paddingRight = "";
+      }
+
+      // Fires for the Close button and for Escape, so scroll is always restored.
+      noticeDialog.addEventListener("close", unlockScroll);
+
+      closeButton.addEventListener("click", function () {
+        noticeDialog.close();
+      });
+
+      lockScroll();
+      noticeDialog.showModal();
+    })();
   </script>
