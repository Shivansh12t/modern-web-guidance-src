+
+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.getElementById('menu-grid');
+      const supportsHighlights = typeof CSS !== 'undefined' && 'highlights' in CSS && typeof Highlight === 'function';
+
+      function getTextNodes() {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: (n) => n.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT
+        });
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      }
+
+      // Card text is static, so cache the text nodes once (Highlight API path never mutates the DOM).
+      const cachedNodes = supportsHighlights ? getTextNodes() : null;
+
+      function clearMarks() {
+        const marks = grid.querySelectorAll('mark.search-hit');
+        const parents = new Set();
+        marks.forEach((m) => {
+          parents.add(m.parentNode);
+          m.replaceWith(document.createTextNode(m.textContent));
+        });
+        parents.forEach((p) => p.normalize());
+      }
+
+      function highlight(term) {
+        const needle = term.toLowerCase();
+
+        if (supportsHighlights) {
+          CSS.highlights.delete('menu-search');
+          if (!needle) return;
+          const ranges = [];
+          for (const node of cachedNodes) {
+            const text = node.nodeValue.toLowerCase();
+            let pos = text.indexOf(needle);
+            while (pos !== -1) {
+              const range = new Range();
+              range.setStart(node, pos);
+              range.setEnd(node, pos + needle.length);
+              ranges.push(range);
+              pos = text.indexOf(needle, pos + needle.length);
+            }
+          }
+          if (ranges.length) CSS.highlights.set('menu-search', new Highlight(...ranges));
+          return;
+        }
+
+        // Fallback: wrap matches in <mark> elements (removed again on every keystroke).
+        clearMarks();
+        if (!needle) return;
+        for (const node of getTextNodes()) {
+          const text = node.nodeValue;
+          const lower = text.toLowerCase();
+          let pos = lower.indexOf(needle);
+          if (pos === -1) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          while (pos !== -1) {
+            frag.append(text.slice(last, pos));
+            const mark = document.createElement('mark');
+            mark.className = 'search-hit';
+            mark.textContent = text.slice(pos, pos + needle.length);
+            frag.append(mark);
+            last = pos + needle.length;
+            pos = lower.indexOf(needle, last);
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      }
+
+      input.addEventListener('input', () => highlight(input.value.trim()));
+    })();
+  </script>
