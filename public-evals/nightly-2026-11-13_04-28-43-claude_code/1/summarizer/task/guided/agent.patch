+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const article = document.getElementById('journal-article');
+      const summary = document.getElementById('summary');
+      const status = document.getElementById('summary-status');
+      const progress = document.getElementById('summary-progress');
+      const list = document.getElementById('summary-list');
+
+      // Identical options must go to both availability() and create().
+      const options = {
+        sharedContext: 'A coffee roaster\'s blog post about how they source green coffee beans.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      let summarizerPromise = null;
+
+      // Turn plain-text key points ("* point" / "- point" per line) into list items.
+      const renderPoints = (text) => {
+        const points = text
+          .split('\n')
+          .map((line) => line.replace(/^\s*(?:[*\-\u2022]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        list.replaceChildren(...points.map((point) => {
+          const li = document.createElement('li');
+          li.textContent = point;
+          return li;
+        }));
+      };
+
+      const getSummarizer = () => {
+        summarizerPromise ??= Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              progress.hidden = false;
+              progress.value = e.loaded;
+              status.textContent = `Downloading on-device AI model… ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        }).catch((err) => {
+          summarizerPromise = null;
+          throw err;
+        });
+        return summarizerPromise;
+      };
+
+      const init = async () => {
+        if (!('Summarizer' in self)) return; // Unsupported: keep the button hidden.
+        let availability;
+        try {
+          availability = await Summarizer.availability(options);
+        } catch {
+          return;
+        }
+        if (availability === 'unavailable') return;
+        button.hidden = false;
+        if (availability !== 'available') {
+          button.title = 'The first summary downloads a small on-device AI model.';
+        }
+      };
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        summary.hidden = false;
+        list.replaceChildren();
+        status.textContent = 'Preparing summary…';
+        try {
+          // create() runs inside the click handler so the user gesture can start a model download.
+          const summarizer = await getSummarizer();
+          progress.hidden = true;
+          status.textContent = 'Summarizing…';
+          let text = '';
+          for await (const chunk of summarizer.summarizeStreaming(article.innerText.trim())) {
+            text += chunk;
+            renderPoints(text);
+          }
+          status.textContent = '';
+        } catch (err) {
+          console.error(err);
+          progress.hidden = true;
+          status.textContent = 'Sorry, we couldn\'t summarize this article right now. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+
+      init();
+    })();
+  </script>
+
