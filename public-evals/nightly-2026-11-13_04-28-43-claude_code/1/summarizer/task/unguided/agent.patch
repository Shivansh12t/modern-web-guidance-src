+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const panel = document.getElementById('journal-summary');
+      const status = document.getElementById('summary-status');
+      const list = document.getElementById('summary-list');
+      const source = document.getElementById('journal-text');
+
+      const OPTIONS = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        sharedContext: "An article from a specialty coffee shop's blog about how they source their coffee beans.",
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      let summarizerPromise = null;
+      let cachedSummary = null;
+
+      // Supports the standard Summarizer global and the older window.ai.summarizer shape.
+      function getApi() {
+        if ('Summarizer' in self) return { kind: 'standard', api: self.Summarizer };
+        if (self.ai && self.ai.summarizer) return { kind: 'legacy', api: self.ai.summarizer };
+        return null;
+      }
+
+      async function checkAvailability(entry) {
+        if (entry.kind === 'standard') return entry.api.availability(OPTIONS);
+        const caps = await entry.api.capabilities();
+        return { readily: 'available', 'after-download': 'downloadable', no: 'unavailable' }[caps.available] || 'unavailable';
+      }
+
+      function showStatus(text) {
+        panel.hidden = false;
+        status.textContent = text;
+        status.hidden = !text;
+      }
+
+      function renderBullets(markdown) {
+        list.replaceChildren();
+        const items = markdown
+          .split('\n')
+          .map(line => line.replace(/^\s*(?:[-*\u2022]|\d+\.)\s+/, '').trim())
+          .filter(Boolean)
+          .map(line => line.replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*(.+?)\*/g, '$1'));
+        for (const item of items) {
+          const li = document.createElement('li');
+          li.textContent = item;
+          list.appendChild(li);
+        }
+      }
+
+      async function getSummarizer(entry) {
+        if (!summarizerPromise) {
+          const monitor = m => m.addEventListener('downloadprogress', e => {
+            const pct = Math.round((e.total ? e.loaded / e.total : e.loaded) * 100);
+            showStatus(`Downloading on-device AI model… ${pct}%`);
+          });
+          summarizerPromise = entry.api.create({ ...OPTIONS, monitor }).catch(err => {
+            summarizerPromise = null;
+            throw err;
+          });
+        }
+        return summarizerPromise;
+      }
+
+      async function summarize() {
+        if (cachedSummary) {
+          panel.hidden = !panel.hidden;
+          button.textContent = panel.hidden ? '\u2728 Show Summary' : '\u2728 Hide Summary';
+          return;
+        }
+
+        const entry = getApi();
+        if (!entry) {
+          showStatus("Sorry, your browser doesn't support built-in AI summarization yet. Try a recent version of Chrome on desktop.");
+          return;
+        }
+
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        list.replaceChildren();
+        showStatus('Checking on-device AI…');
+
+        try {
+          const availability = await checkAvailability(entry);
+          if (availability === 'unavailable') {
+            showStatus("Sorry, built-in AI summarization isn't available on this device.");
+            button.textContent = '\u2728 Summarize';
+            return;
+          }
+
+          const summarizer = await getSummarizer(entry);
+          showStatus('Brewing your summary…');
+
+          const text = source.innerText.replace(/\s+\n/g, '\n').trim();
+          const result = await summarizer.summarize(text, {
+            context: 'Summarize for a coffee customer who wants the highlights.',
+          });
+
+          cachedSummary = result;
+          renderBullets(result);
+          showStatus('');
+          button.textContent = '\u2728 Hide Summary';
+        } catch (err) {
+          console.error('Summarization failed:', err);
+          showStatus('Something went wrong while summarizing. Please try again.');
+          button.textContent = '\u2728 Summarize';
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', summarize);
+    })();
+  </script>
+
 </body>
 
