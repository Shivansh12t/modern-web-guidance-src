+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const select = document.getElementById("theme-select");
+      const systemOption = select.querySelector('option[value="light dark"]');
+      const darkQuery = matchMedia("(prefers-color-scheme: dark)");
+
+      const updateSystemLabel = () => {
+        systemOption.textContent = `System (currently ${darkQuery.matches ? "dark" : "light"})`;
+      };
+
+      const apply = (value) => {
+        meta.content = value;
+        select.value = value;
+      };
+
+      const readStored = () => {
+        try { return localStorage.getItem("color-scheme") ?? "light dark"; } catch { return "light dark"; }
+      };
+
+      select.addEventListener("change", () => {
+        const value = select.value;
+        apply(value);
+        try {
+          if (value === "light dark") localStorage.removeItem("color-scheme");
+          else localStorage.setItem("color-scheme", value);
+        } catch {}
+      });
+
+      // Stay in sync with other tabs
+      addEventListener("storage", (e) => {
+        if (e.key === "color-scheme" || e.key === null) apply(readStored());
+      });
+
+      darkQuery.addEventListener("change", updateSystemLabel);
+      updateSystemLabel();
+      apply(meta.content);
+    })();
+  </script>
