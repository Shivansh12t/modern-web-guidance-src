+    // ---------- CSS 3D fallback ----------
+    function initCssMode() {
+      const box = document.createElement('div');
+      box.className = 'cbox';
+      const face = (name) => {
+        const el = document.createElement('div');
+        el.className = `cbox-face cbox-${name}`;
+        if (name !== 'front') el.setAttribute('aria-hidden', 'true');
+        return el;
+      };
+      const front = face('front');
+      front.append(form);
+      box.append(front, ...['back', 'right', 'left', 'top', 'bottom'].map(face));
+      stage.append(box);
+      stage.dataset.mode = 'css';
+
+      return {
+        dragTarget: stage,
+        canStartDrag: (e) => !e.target.closest('form'),
+        render(yaw, pitch) {
+          box.style.setProperty('--ry', `${yaw}deg`);
+          box.style.setProperty('--rx', `${pitch}deg`);
+        },
+      };
+    }
+
+    // ---------- Shared interaction ----------
+    const scene = initCanvasMode() ?? initCssMode();
+    controls.hidden = false;
+
+    function updatePauseLabel() {
+      pauseBtn.textContent = state.playing ? 'Pause' : 'Play';
+    }
+    updatePauseLabel();
+
+    pauseBtn.addEventListener('click', () => {
+      state.playing = !state.playing;
+      updatePauseLabel();
+    });
+    controls.querySelectorAll('[data-rotate]').forEach((btn) =>
+      btn.addEventListener('click', () => {
+        state.targetYaw += Number(btn.dataset.rotate);
+      }));
+    document.getElementById('box-reset').addEventListener('click', faceFront);
+
+    function faceFront() {
+      state.targetYaw = Math.round(state.baseYaw / 360) * 360;
+      state.targetPitch = 0;
+    }
+
+    // Keyboard users tabbing into the form always get the form turned toward them.
+    form.addEventListener('focusin', () => {
+      if (!isFrontFacing()) faceFront();
+    });
+
+    // Drag to rotate (only when the drag doesn't start on the form itself).
+    let drag = null;
+    scene.dragTarget.addEventListener('pointerdown', (e) => {
+      if (!scene.canStartDrag(e)) return;
+      drag = { x: e.clientX, y: e.clientY, id: e.pointerId };
+      scene.dragTarget.setPointerCapture(e.pointerId);
+    });
+    scene.dragTarget.addEventListener('pointermove', (e) => {
+      if (!drag || e.pointerId !== drag.id) return;
+      state.targetYaw += (e.clientX - drag.x) * 0.5;
+      state.targetPitch = Math.max(-60, Math.min(60, state.targetPitch - (e.clientY - drag.y) * 0.4));
+      state.baseYaw = state.targetYaw;
+      state.pitch = state.targetPitch;
+      drag.x = e.clientX;
+      drag.y = e.clientY;
+    });
+    const endDrag = (e) => {
+      if (drag && e.pointerId === drag.id) drag = null;
+    };
+    scene.dragTarget.addEventListener('pointerup', endDrag);
+    scene.dragTarget.addEventListener('pointercancel', endDrag);
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const data = new FormData(form);
+      const sizeLabel = form.elements.size.selectedOptions[0].text;
+      form.elements.status.value =
+        `Added ${data.get('qty')} × ${sizeLabel} ${data.get('roast')} roast to your cart!`;
+    });
+
+    let last = performance.now();
+    function tick(now) {
+      const dt = Math.min(0.05, (now - last) / 1000);
+      last = now;
+      if (state.playing) state.phase += dt * 0.9;
+      // Ease toward the target rotation; jump straight there under reduced motion.
+      const k = reduceMotion.matches ? 1 : 1 - Math.exp(-dt * 8);
+      state.baseYaw += (state.targetYaw - state.baseYaw) * k;
+      state.pitch += (state.targetPitch - state.pitch) * k;
+      scene.render(currentYaw(), state.pitch);
+      requestAnimationFrame(tick);
+    }
+    requestAnimationFrame(tick);
+  </script>
+
 </body>
 
