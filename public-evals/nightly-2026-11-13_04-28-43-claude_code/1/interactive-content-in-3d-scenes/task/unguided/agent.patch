+        btn.addEventListener('click', function () {
+          qty.value = clampQty() + parseInt(btn.getAttribute('data-step'), 10);
+          updateTotal();
+        });
+      });
+      roast.addEventListener('change', updateTotal);
+      qty.addEventListener('change', updateTotal);
+      wrap.addEventListener('change', updateTotal);
