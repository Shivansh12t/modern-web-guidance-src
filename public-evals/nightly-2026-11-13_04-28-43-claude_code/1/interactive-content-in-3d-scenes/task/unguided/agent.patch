+          // hidden face can never steal clicks meant for the visible one.
+          face.classList.toggle('is-away', z < 0.25);
+          if (z > bestZ) { bestZ = z; best = face.getAttribute('data-face'); }
+        });
+        stage.querySelectorAll('[data-goto]').forEach(function (b) {
+          b.setAttribute('aria-pressed', String(b.getAttribute('data-goto') === best && bestZ > 0.95));
+        });
+      }
+
+      // Pick the equivalent of `target` closest to the current angle so the box takes the short way round.
+      function nearest(target, current) {
+        return target + Math.round((current - target) / 360) * 360;
+      }
+
+      function goTo(name) {
+        ry = nearest(FACE_ANGLES[name], ry);
+        rx = 0;
+        render();
+      }
+
+      render();
+
+      /* ---------- Buttons ---------- */
+      stage.querySelectorAll('[data-goto]').forEach(function (b) {
+        b.addEventListener('click', function () { goTo(b.getAttribute('data-goto')); });
+      });
+      stage.querySelectorAll('[data-rotate]').forEach(function (b) {
+        b.addEventListener('click', function () {
+          ry = Math.round((ry + parseInt(b.getAttribute('data-rotate'), 10)) / 90) * 90;
+          rx = 0;
+          render();
+        });
+      });
+
+      /* ---------- Focus follows: turn the box to whichever face holds focus ---------- */
+      faces.forEach(function (face) {
+        face.addEventListener('focusin', function () {
+          var name = face.getAttribute('data-face');
+          if (FACE_ANGLES[name] === undefined) return;
+          if (facingZ(NORMALS[name]) < 0.95) goTo(name);
+        });
+      });
