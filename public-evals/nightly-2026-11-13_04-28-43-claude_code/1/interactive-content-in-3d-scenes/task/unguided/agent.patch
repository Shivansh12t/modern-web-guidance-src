+        var avail = stage.parentElement.clientWidth - 20;
+        var scale = Math.min(1, avail / 360);
+        stage.style.setProperty('--scale', scale.toFixed(3));
+      }
+      fit();
+      window.addEventListener('resize', fit);
+
+      /* ---------- Rotation state ---------- */
+      var rx = -10, ry = -24;
+      var FACE_ANGLES = { front: 0, right: -90, back: 180, left: 90 };
+      var DEG = Math.PI / 180;
+
+      // Face normals in box space, matching each face's CSS transform.
+      var NORMALS = {
+        front: [0, 0, 1], back: [0, 0, -1],
+        right: [1, 0, 0], left: [-1, 0, 0],
+        top: [0, -1, 0], bottom: [0, 1, 0]
+      };
+
+      // View-space z of a normal after rotateX(rx) rotateY(ry) (CSS: +z points to viewer).
+      function facingZ(n) {
+        var a = rx * DEG, b = ry * DEG;
+        var z1 = -n[0] * Math.sin(b) + n[2] * Math.cos(b);
+        return n[1] * Math.sin(a) + z1 * Math.cos(a);
+      }
+
+      function render() {
+        box.style.setProperty('--rx', rx + 'deg');
+        box.style.setProperty('--ry', ry + 'deg');
+        var best = null, bestZ = -2;
+        faces.forEach(function (face) {
+          var z = facingZ(NORMALS[face.getAttribute('data-face')]);
