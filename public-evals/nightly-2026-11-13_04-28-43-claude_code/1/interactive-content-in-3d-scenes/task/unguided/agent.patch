+      function clampQty() {
+        var n = parseInt(qty.value, 10);
+        if (isNaN(n)) n = 1;
+        n = Math.min(10, Math.max(1, n));
+        qty.value = n;
+        return n;
+      }
+
+      function updateTotal() {
+        var price = parseFloat(roast.options[roast.selectedIndex].getAttribute('data-price'));
