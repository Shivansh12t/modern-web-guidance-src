+  <script>
+    (() => {
+      'use strict';
+
+      // ---- Menu data -------------------------------------------------------
+      const MENU = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          sizes: { small: 4.75, medium: 5.25, large: 5.75 },
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          sizes: { single: 2.95, double: 3.75 },
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          sizes: { medium: 4.25, large: 4.95 },
+        },
+      };
+      const DRINK_IDS = Object.keys(MENU);
+      const ALL_SIZES = [...new Set(DRINK_IDS.flatMap((id) => Object.keys(MENU[id].sizes)))];
+      const MAX_QTY = 10;
+      const STORAGE_KEY = 'dailyGrind.order';
+
+      const fmt = (n) => `$${n.toFixed(2)}`;
+      const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
+
+      // ---- Order state -----------------------------------------------------
+      let order = loadOrder();
+
+      function loadOrder() {
+        try {
+          const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
+          return Array.isArray(saved)
+            ? saved.filter((i) => MENU[i.drinkId] && MENU[i.drinkId].sizes[i.size] && i.quantity > 0)
+            : [];
+        } catch {
+          return [];
+        }
+      }
+
+      function saveOrder() {
+        try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch { /* ignore */ }
+      }
+
+      function lineTotal(item) {
+        return MENU[item.drinkId].sizes[item.size] * item.quantity;
+      }
+
+      function orderSnapshot() {
+        const items = order.map((item) => ({
+          drinkId: item.drinkId,
+          name: MENU[item.drinkId].name,
+          size: item.size,
+          quantity: item.quantity,
+          unitPrice: MENU[item.drinkId].sizes[item.size],
+          lineTotal: +lineTotal(item).toFixed(2),
+        }));
+        const total = +items.reduce((sum, i) => sum + i.lineTotal, 0).toFixed(2);
+        return { items, itemCount: items.reduce((n, i) => n + i.quantity, 0), total };
+      }
+
+      // Core actions shared by the UI and the agent tools. Each throws on invalid input.
+      function addToOrder(drinkId, size, quantity = 1) {
+        const drink = MENU[drinkId];
+        if (!drink) throw new Error(`Unknown drink "${drinkId}". Valid ids: ${DRINK_IDS.join(', ')}.`);
+        if (size == null) size = Object.keys(drink.sizes)[0];
+        if (!(size in drink.sizes)) {
+          throw new Error(`${drink.name} is not available in size "${size}". Available: ${Object.keys(drink.sizes).join(', ')}.`);
+        }
+        quantity = Number(quantity);
+        if (!Number.isInteger(quantity) || quantity < 1) throw new Error('Quantity must be a positive whole number.');
+
+        const existing = order.find((i) => i.drinkId === drinkId && i.size === size);
+        const newQty = (existing ? existing.quantity : 0) + quantity;
+        if (newQty > MAX_QTY) throw new Error(`You can order at most ${MAX_QTY} of the same drink and size.`);
+        if (existing) existing.quantity = newQty;
+        else order.push({ drinkId, size, quantity });
+
+        setStatus('');
+        commit();
+        flashCard(drinkId);
+        return { drinkId, name: drink.name, size, quantity: newQty };
+      }
+
+      function removeFromOrder(drinkId, size) {
+        const before = order.length;
+        order = order.filter((i) => !(i.drinkId === drinkId && (size == null || i.size === size)));
+        if (order.length === before) throw new Error('That item is not in the current order.');
+        setStatus('');
+        commit();
+      }
+
+      function clearOrder() {
+        order = [];
+        setStatus('');
+        commit();
+      }
+
+      function placeOrder() {
+        if (!order.length) throw new Error('Cannot place an empty order.');
+        const summary = orderSnapshot();
+        const confirmation = {
+          orderNumber: 'DG-' + Date.now().toString(36).toUpperCase().slice(-6),
+          ...summary,
+          estimatedReadyMinutes: 5 + summary.itemCount * 2,
+        };
+        order = [];
+        commit();
+        setStatus(`Order ${confirmation.orderNumber} placed! ${fmt(confirmation.total)} — ready in about ${confirmation.estimatedReadyMinutes} minutes.`);
+        return confirmation;
+      }
+
+      // ---- Rendering -------------------------------------------------------
+      const els = {
+        items: document.getElementById('order-items'),
+        empty: document.getElementById('order-empty'),
+        total: document.getElementById('order-total'),
+        place: document.getElementById('place-order'),
+        clear: document.getElementById('clear-order'),
+        status: document.getElementById('order-status'),
+      };
+
+      function setStatus(msg, isError = false) {
+        els.status.textContent = msg;
+        els.status.style.color = isError ? '#b71c1c' : '';
+      }
+
+      function commit() {
+        saveOrder();
+        render();
+      }
+
+      function render() {
+        const snap = orderSnapshot();
+        els.items.replaceChildren(...snap.items.map((item) => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${item.quantity} × ${item.name} (${cap(item.size)})`;
+          const right = document.createElement('span');
+          right.textContent = fmt(item.lineTotal) + ' ';
+          const rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'remove-item';
+          rm.textContent = 'Remove';
+          rm.setAttribute('aria-label', `Remove ${item.name} (${item.size})`);
+          rm.addEventListener('click', () => removeFromOrder(item.drinkId, item.size));
+          right.appendChild(rm);
+          li.append(label, right);
+          return li;
+        }));
+        els.empty.hidden = snap.items.length > 0;
+        els.total.textContent = fmt(snap.total);
+        els.place.disabled = els.clear.disabled = snap.items.length === 0;
+      }
+
+      function flashCard(drinkId) {
+        const card = document.querySelector(`.card[data-drink-id="${drinkId}"]`);
+        if (!card) return;
+        card.classList.add('added');
+        setTimeout(() => card.classList.remove('added'), 800);
+      }
+
+      // ---- Wire up cards ---------------------------------------------------
+      document.querySelectorAll('.card[data-drink-id]').forEach((card) => {
+        const drinkId = card.dataset.drinkId;
+        const drink = MENU[drinkId];
+        const form = card.querySelector('.order-form');
+        const select = form.elements.size;
+        const priceEl = form.querySelector('[data-price]');
+
+        for (const [size, price] of Object.entries(drink.sizes)) {
+          select.add(new Option(`${cap(size)} – ${fmt(price)}`, size));
+        }
+        const updatePrice = () => {
+          const qty = Math.max(1, parseInt(form.elements.quantity.value, 10) || 1);
+          priceEl.textContent = fmt(drink.sizes[select.value] * qty);
+        };
+        select.addEventListener('change', updatePrice);
+        form.elements.quantity.addEventListener('input', updatePrice);
+        updatePrice();
+
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          try {
+            addToOrder(drinkId, select.value, parseInt(form.elements.quantity.value, 10));
+            form.elements.quantity.value = 1;
+            updatePrice();
+          } catch (err) {
+            setStatus(err.message, true);
+          }
+        });
+      });
+
+      els.clear.addEventListener('click', clearOrder);
+      els.place.addEventListener('click', () => {
+        try { placeOrder(); } catch (err) { setStatus(err.message, true); }
+      });
+
+      render();
+
+      // ---- WebMCP: expose ordering actions to browser AI agents -------------
+      const ok = (data) => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+      const fail = (err) => ({ content: [{ type: 'text', text: `Error: ${err.message}` }], isError: true });
+      const safe = (fn) => async (input = {}, agent) => {
+        try { return ok(await fn(input || {}, agent)); } catch (err) { return fail(err); }
+      };
+
+      const tools = [
+        {
+          name: 'list_seasonal_drinks',
+          description: 'List the Seasonal Favorites drinks that can be ordered on this page, with their ids, descriptions, available sizes and prices (USD).',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: safe(() => DRINK_IDS.map((id) => ({
+            drinkId: id,
+            name: MENU[id].name,
+            description: MENU[id].description,
+            sizes: Object.entries(MENU[id].sizes).map(([size, price]) => ({ size, price })),
+          }))),
+        },
+        {
+          name: 'add_drink_to_order',
+          description: 'Add a Seasonal Favorites drink to the customer\'s current order. Adding the same drink and size again increases its quantity. Sizes: maple-oat-latte = small|medium|large; dark-roast-espresso = single|double; cold-brew = medium|large. Returns the updated order.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drinkId: { type: 'string', enum: DRINK_IDS, description: 'Id of the drink to add.' },
+              size: { type: 'string', enum: ALL_SIZES, description: 'Drink size. Must be valid for the chosen drink; defaults to its smallest size.' },
+              quantity: { type: 'integer', minimum: 1, maximum: MAX_QTY, default: 1, description: 'How many to add.' },
+            },
+            required: ['drinkId'],
+          },
+          execute: safe(({ drinkId, size, quantity = 1 }) => {
+            const added = addToOrder(drinkId, size, quantity);
+            return { added, order: orderSnapshot() };
+          }),
+        },
+        {
+          name: 'remove_drink_from_order',
+          description: 'Remove a drink from the current order. If size is omitted, all sizes of that drink are removed. Returns the updated order.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drinkId: { type: 'string', enum: DRINK_IDS, description: 'Id of the drink to remove.' },
+              size: { type: 'string', enum: ALL_SIZES, description: 'Optional size to remove.' },
+            },
+            required: ['drinkId'],
+          },
+          execute: safe(({ drinkId, size }) => {
+            removeFromOrder(drinkId, size);
+            return orderSnapshot();
+          }),
+        },
+        {
+          name: 'get_current_order',
+          description: 'Get the items, quantities and total price of the customer\'s current (not yet placed) order.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: safe(() => orderSnapshot()),
+        },
+        {
+          name: 'clear_order',
+          description: 'Remove all items from the current (not yet placed) order.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: safe(() => { clearOrder(); return orderSnapshot(); }),
+        },
+        {
+          name: 'place_order',
+          description: 'Submit the current order for pickup. The user is asked to confirm before the order is placed. Returns an order number, the items, total and estimated ready time.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: safe(async (_input, agent) => {
+            if (!order.length) throw new Error('Cannot place an empty order.');
+            const { itemCount, total } = orderSnapshot();
+            const prompt = `Place your order of ${itemCount} drink(s) for ${fmt(total)}?`;
+            const confirmed = agent && typeof agent.requestUserInteraction === 'function'
+              ? await agent.requestUserInteraction(async () => window.confirm(prompt))
+              : window.confirm(prompt);
+            if (!confirmed) throw new Error('The user declined to place the order.');
+            return placeOrder();
+          }),
+        },
+      ];
+
+      const mc = navigator.modelContext;
+      if (mc) {
+        try {
+          if (typeof mc.provideContext === 'function') {
+            mc.provideContext({ tools });
+          } else if (typeof mc.registerTool === 'function') {
+            tools.forEach((tool) => mc.registerTool(tool));
+          }
+        } catch (err) {
+          console.warn('Daily Grind: unable to register WebMCP tools', err);
+        }
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
