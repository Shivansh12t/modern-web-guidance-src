+  <script type="module">
+    // ---- Menu & order state -------------------------------------------------
+    const MENU = {
+      "maple-oat-latte": { name: "Maple Oat Latte", basePrice: 5.75, description: "Creamy oat milk with a hint of Vermont maple syrup." },
+      "dark-roast-espresso": { name: "Dark Roast Espresso", basePrice: 3.5, description: "Bold, smokey, and perfect for a morning boost." },
+      "cold-brew": { name: "Cold Brew", basePrice: 4.95, description: "Steeped for 18 hours for maximum smoothness." },
+    };
+    const ITEM_IDS = Object.keys(MENU);
+    const SIZE_UPCHARGE = { small: 0, medium: 0.75, large: 1.5 };
+    const SIZES = Object.keys(SIZE_UPCHARGE);
+    const MAX_QTY = 10;
+    const STORAGE_KEY = "daily-grind-order";
+
+    const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+    const unitPrice = (itemId, size) => Math.round((MENU[itemId].basePrice + SIZE_UPCHARGE[size]) * 100) / 100;
+
+    let order = loadOrder();
+    let nextLineSeq = Date.now();
+
+    function loadOrder() {
+      try {
+        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (Array.isArray(saved)) {
+          return saved.filter((l) => MENU[l.itemId] && SIZES.includes(l.size) && Number.isInteger(l.quantity));
+        }
+      } catch { /* ignore corrupt storage */ }
+      return [];
+    }
+
+    function saveOrder() {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(order));
+    }
+
+    function orderSummary() {
+      const lines = order.map((l) => ({
+        lineId: l.lineId,
+        itemId: l.itemId,
+        name: MENU[l.itemId].name,
+        size: l.size,
+        quantity: l.quantity,
+        unitPrice: unitPrice(l.itemId, l.size),
+        lineTotal: Math.round(unitPrice(l.itemId, l.size) * l.quantity * 100) / 100,
+      }));
+      const total = Math.round(lines.reduce((sum, l) => sum + l.lineTotal, 0) * 100) / 100;
+      return { lines, itemCount: lines.reduce((n, l) => n + l.quantity, 0), total, totalFormatted: money.format(total) };
+    }
+
+    // ---- Validation (shared by UI and agent tools) ---------------------------
+    function validateItem({ itemId, size = "medium", quantity = 1 }) {
+      if (!MENU[itemId]) return { error: `Unknown item "${itemId}".`, availableItems: ITEM_IDS };
+      if (!SIZES.includes(size)) return { error: `Unknown size "${size}".`, availableSizes: SIZES };
+      if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QTY) {
+        return { error: `Quantity must be a whole number from 1 to ${MAX_QTY}.` };
+      }
+      return null;
+    }
+
+    function addToOrder({ itemId, size = "medium", quantity = 1 }) {
+      const invalid = validateItem({ itemId, size, quantity });
+      if (invalid) return invalid;
+      const existing = order.find((l) => l.itemId === itemId && l.size === size);
+      if (existing) {
+        if (existing.quantity + quantity > MAX_QTY) {
+          return { error: `You can order at most ${MAX_QTY} of the same drink and size; ${existing.quantity} already in the order.` };
+        }
+        existing.quantity += quantity;
+      } else {
+        order.push({ lineId: `L${(nextLineSeq++).toString(36)}${Math.random().toString(36).slice(2, 6)}`, itemId, size, quantity });
+      }
+      commit(`Added ${quantity} × ${size} ${MENU[itemId].name}.`);
+      return { added: { itemId, name: MENU[itemId].name, size, quantity }, order: orderSummary() };
+    }
+
+    function removeFromOrder(lineId) {
+      const line = order.find((l) => l.lineId === lineId);
+      if (!line) return { error: `No order line with id "${lineId}".`, order: orderSummary() };
+      order = order.filter((l) => l !== line);
+      commit(`Removed ${MENU[line.itemId].name}.`);
+      return { removed: lineId, order: orderSummary() };
+    }
+
+    function clearOrder() {
+      order = [];
+      commit("Order cleared.");
+      return { order: orderSummary() };
+    }
+
+    // ---- Rendering ----------------------------------------------------------
+    const els = {
+      lines: document.getElementById("order-lines"),
+      empty: document.getElementById("order-empty"),
+      total: document.getElementById("order-total"),
+      place: document.getElementById("place-order"),
+      clear: document.getElementById("clear-order"),
+      status: document.getElementById("order-status"),
+      dialog: document.getElementById("confirm-dialog"),
+      confirmLines: document.getElementById("confirm-lines"),
+      confirmTotal: document.getElementById("confirm-total"),
+    };
+
+    function commit(statusMessage) {
+      saveOrder();
+      render();
+      if (statusMessage) els.status.value = statusMessage;
+    }
+
+    function render() {
+      const summary = orderSummary();
+      els.lines.replaceChildren(...summary.lines.map((l) => {
+        const li = document.createElement("li");
+        const info = document.createElement("div");
+        const title = document.createElement("strong");
+        title.textContent = `${l.quantity} × ${l.name}`;
+        const meta = document.createElement("div");
+        meta.className = "line-meta";
+        meta.textContent = `${l.size[0].toUpperCase()}${l.size.slice(1)} · ${money.format(l.unitPrice)} each`;
+        info.append(title, meta);
+
+        const right = document.createElement("div");
+        const price = document.createElement("span");
+        price.textContent = money.format(l.lineTotal) + " ";
+        const remove = document.createElement("button");
+        remove.type = "button";
+        remove.className = "remove-line";
+        remove.textContent = "Remove";
+        remove.setAttribute("aria-label", `Remove ${l.name} (${l.size})`);
+        remove.addEventListener("click", () => removeFromOrder(l.lineId));
+        right.append(price, remove);
+
+        li.append(info, right);
+        return li;
+      }));
+      els.empty.hidden = summary.lines.length > 0;
+      els.total.textContent = summary.totalFormatted;
+      els.place.disabled = els.clear.disabled = summary.lines.length === 0;
+    }
+
+    // ---- Placing an order (always requires the user's own confirmation) -----
+    let pendingConfirmation = null;
+
+    function requestConfirmation(signal) {
+      if (pendingConfirmation) return pendingConfirmation;
+      const summary = orderSummary();
+      els.confirmLines.replaceChildren(...summary.lines.map((l) => {
+        const li = document.createElement("li");
+        li.textContent = `${l.quantity} × ${l.size} ${l.name} — ${money.format(l.lineTotal)}`;
+        return li;
+      }));
+      els.confirmTotal.textContent = summary.totalFormatted;
+      els.dialog.returnValue = "";
+      els.dialog.showModal();
+
+      pendingConfirmation = new Promise((resolve, reject) => {
+        const onAbort = () => {
+          els.dialog.close("cancel");
+          reject(signal.reason);
+        };
+        signal?.addEventListener("abort", onAbort, { once: true });
+        els.dialog.addEventListener("close", () => {
+          signal?.removeEventListener("abort", onAbort);
+          pendingConfirmation = null;
+          resolve(els.dialog.returnValue === "confirm");
+        }, { once: true });
+      });
+      return pendingConfirmation;
+    }
+
+    async function placeOrder(signal) {
+      if (order.length === 0) return { error: "The order is empty. Add drinks before placing it." };
+      const confirmed = await requestConfirmation(signal);
+      if (!confirmed) {
+        els.status.value = "Order not placed.";
+        return { status: "cancelled", message: "The customer declined to confirm the order.", order: orderSummary() };
+      }
+      // A concurrent call may already have placed this order while we awaited.
+      if (order.length === 0) return { error: "The order was already placed or is now empty." };
+      const placed = orderSummary();
+      const orderNumber = `DG-${Date.now().toString(36).toUpperCase().slice(-6)}`;
+      order = [];
+      commit(`Thanks! Order ${orderNumber} placed — ${placed.totalFormatted}. We'll have it ready shortly.`);
+      return { status: "placed", orderNumber, ...placed };
+    }
+
+    // ---- UI wiring ----------------------------------------------------------
+    for (const form of document.querySelectorAll(".order-form")) {
+      form.addEventListener("submit", (event) => {
+        event.preventDefault();
+        const data = new FormData(form);
+        const result = addToOrder({
+          itemId: form.dataset.item,
+          size: data.get("size"),
+          quantity: Number(data.get("quantity")),
+        });
+        if (result.error) els.status.value = result.error;
+      });
+    }
+    els.clear.addEventListener("click", clearOrder);
+    els.place.addEventListener("click", () => placeOrder());
+
+    render();
+
+    // ---- WebMCP: expose ordering actions to browser AI agents ---------------
+    if ("modelContext" in document) {
+      const mc = document.modelContext;
+      const register = (tool) =>
+        Promise.resolve(mc.registerTool(tool)).catch((err) =>
+          console.warn(`WebMCP: failed to register "${tool.name}"`, err));
+
+      register({
+        name: "get_seasonal_menu",
+        description: "Lists the seasonal coffee drinks that can be ordered on this page, with prices for each size. Use to look up item ids before adding drinks to the order.",
+        inputSchema: { type: "object", properties: {} },
+        execute() {
+          return ITEM_IDS.map((id) => ({
+            itemId: id,
+            name: MENU[id].name,
+            description: MENU[id].description,
+            prices: Object.fromEntries(SIZES.map((size) => [size, unitPrice(id, size)])),
+          }));
+        },
+        annotations: { readOnlyHint: true },
+      });
+
+      register({
+        name: "add_to_order",
+        description: "Adds a seasonal coffee drink to the customer's current order. Adding the same drink and size again increases its quantity.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            itemId: { type: "string", enum: ITEM_IDS, description: "The drink to add." },
+            size: { type: "string", enum: SIZES, default: "medium", description: "Cup size; larger sizes cost more." },
+            quantity: { type: "integer", minimum: 1, maximum: MAX_QTY, default: 1, description: "How many of this drink to add." },
+          },
+          required: ["itemId"],
+        },
+        execute({ itemId, size = "medium", quantity = 1 } = {}) {
+          return addToOrder({ itemId, size, quantity });
+        },
+        annotations: { readOnlyHint: false },
+      });
+
+      register({
+        name: "view_order",
+        description: "Returns the drinks currently in the customer's order, including line ids, prices, and the total.",
+        inputSchema: { type: "object", properties: {} },
+        execute() {
+          return orderSummary();
+        },
+        annotations: { readOnlyHint: true },
+      });
+
+      register({
+        name: "remove_from_order",
+        description: "Removes one line from the customer's current order.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            lineId: { type: "string", description: "The line id of the drink to remove, as returned by view_order." },
+          },
+          required: ["lineId"],
+        },
+        execute({ lineId } = {}) {
+          if (typeof lineId !== "string") return { error: "Pass the lineId of the line to remove.", order: orderSummary() };
+          return removeFromOrder(lineId);
+        },
+        annotations: { readOnlyHint: false },
+      });
+
+      register({
+        name: "clear_order",
+        description: "Removes all drinks from the customer's current order.",
+        inputSchema: { type: "object", properties: {} },
+        execute() {
+          return clearOrder();
+        },
+        annotations: { readOnlyHint: false },
+      });
+
+      register({
+        name: "place_order",
+        description: "Submits the current order for purchase. The customer is shown a confirmation dialog and must approve it on the page before the order is placed.",
+        inputSchema: { type: "object", properties: {} },
+        async execute(_input, { signal } = {}) {
+          return await placeOrder(signal);
+        },
+        annotations: { readOnlyHint: false, consequentialHint: true },
+      });
+    }
+  </script>
+
 </body>
 
