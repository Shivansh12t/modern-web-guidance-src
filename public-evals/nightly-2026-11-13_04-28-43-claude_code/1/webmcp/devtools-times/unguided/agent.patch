+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+export const apiUrl = (path: string) => `${BASE_URL}${path.replace(/^\//, '')}`;
+export const articleUrl = (slug: string) => apiUrl(`articles/${encodeURIComponent(slug)}`);
+export const absoluteArticleUrl = (slug: string) => new URL(articleUrl(slug), window.location.origin).href;
+
+let articlesPromise: Promise<ArticleSummary[]> | null = null;
+
+/** Fetches (and caches for the lifetime of the page) the full article index. */
+export function fetchArticles(): Promise<ArticleSummary[]> {
+  if (!articlesPromise) {
+    articlesPromise = fetch(apiUrl('api/articles.json'))
+      .then(response => {
+        if (!response.ok) throw new Error(`Failed to load articles (${response.status})`);
+        return response.json() as Promise<ArticleSummary[]>;
+      })
+      .catch(error => {
+        articlesPromise = null;
+        throw error;
+      });
+  }
+  return articlesPromise;
+}
+
+/** Case-insensitive match against title, summary, author, category and tags. */
+export function searchArticles(articles: ArticleSummary[], query: string, category?: string): ArticleSummary[] {
+  const term = query.trim().toLowerCase();
+  const cat = category?.trim().toLowerCase();
+  return articles.filter(article => {
+    if (cat && article.category?.toLowerCase() !== cat) return false;
+    if (!term) return true;
+    return [article.title, article.summary, article.author, article.category, ...(article.tags ?? [])]
+      .some(field => field?.toLowerCase().includes(term));
+  });
+}
+
+export async function fetchReadingList(): Promise<string[]> {
+  const response = await fetch(apiUrl('api/reading-list.json'));
+  if (!response.ok) throw new Error(`Failed to load reading list (${response.status})`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** The API only exposes a toggle, so this helper makes add/remove idempotent. */
+export async function setReadingListMembership(slug: string, saved: boolean): Promise<string[]> {
+  const current = await fetchReadingList();
+  if (current.includes(slug) === saved) return current;
+  const response = await fetch(apiUrl('api/reading-list.json'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  if (!response.ok) throw new Error(`Failed to update reading list (${response.status})`);
+  const data = await response.json();
+  const readingList: string[] = data.readingList ?? [];
+  window.dispatchEvent(new CustomEvent('readinglist:change', { detail: { readingList, slug, saved } }));
+  return readingList;
+}
