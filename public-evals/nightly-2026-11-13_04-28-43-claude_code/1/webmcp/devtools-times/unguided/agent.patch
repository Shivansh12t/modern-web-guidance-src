diff --git a/src/scripts/agent-tools.ts b/src/scripts/agent-tools.ts
new file mode 100644
index 0000000..057a088
--- /dev/null
+++ b/src/scripts/agent-tools.ts
@@ -0,0 +1,395 @@
+/**
+ * WebMCP imperative tools for The DevTools Times.
+ *
+ * Registers client-side tools with `navigator.modelContext` so that AI agents running in
+ * the browser can discover and invoke them. Site-wide tools are available on every page;
+ * article utilities are only registered while an article page is displayed.
+ *
+ * The search and reading-list forms are exposed separately as *declarative* WebMCP tools
+ * (`search_articles`, `update_reading_list`) via `toolname` attributes on their <form>s.
+ */
+import { navigate } from 'astro:transitions/client';
+import {
+  absoluteArticleUrl,
+  articleUrl,
+  fetchArticles,
+  fetchReadingList,
+  searchArticles,
+} from '../lib/articles-client';
+
+type ToolResult = { content: { type: 'text'; text: string }[]; isError?: boolean };
+
+const ok = (data: unknown): ToolResult => ({
+  content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }],
+});
+
+const fail = (message: string): ToolResult => ({
+  content: [{ type: 'text', text: message }],
+  isError: true,
+});
+
+/** Wraps a tool body so thrown errors are reported to the agent instead of rejecting. */
+const safe = <I>(fn: (input: I) => Promise<ToolResult> | ToolResult) => async (input: I) => {
+  try {
+    return await fn((input ?? {}) as I);
+  } catch (error) {
+    return fail(error instanceof Error ? error.message : String(error));
+  }
+};
+
+// ---------------------------------------------------------------------------
+// Current-article helpers (read from the DOM at call time, so they follow client-side navigation)
+// ---------------------------------------------------------------------------
+
+const WORDS_PER_MINUTE = 230;
+
+interface CurrentArticle {
+  root: HTMLElement;
+  body: HTMLElement;
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  category: string;
+  date: string;
+  tags: string[];
+}
+
+function getCurrentArticle(): CurrentArticle | null {
+  const root = document.querySelector<HTMLElement>('[data-article]');
+  const body = root?.querySelector<HTMLElement>('[data-article-body]');
+  if (!root || !body) return null;
+  const d = root.dataset;
+  return {
+    root,
+    body,
+    slug: d.articleSlug ?? '',
+    title: d.articleTitle ?? document.title,
+    summary: d.articleSummary ?? '',
+    author: d.articleAuthor ?? '',
+    category: d.articleCategory ?? '',
+    date: d.articleDate ?? '',
+    tags: (d.articleTags ?? '').split(',').filter(Boolean),
+  };
+}
+
+function requireArticle(): CurrentArticle {
+  const article = getCurrentArticle();
+  if (!article) throw new Error('No article is currently open. Use open_article first.');
+  return article;
+}
+
+/** Block-level text elements of the article body, in reading order. */
+function getBlocks(article: CurrentArticle): HTMLElement[] {
+  return Array.from(
+    article.body.querySelectorAll<HTMLElement>('p, h1, h2, h3, h4, h5, h6, li, blockquote, pre'),
+  ).filter(el => {
+    // Skip containers nested inside another collected block (e.g. <p> inside <li>/<blockquote>).
+    const parent = el.parentElement?.closest('li, blockquote');
+    return !(parent && article.body.contains(parent)) && (el.textContent ?? '').trim().length > 0;
+  });
+}
+
+const text = (el: Element) => (el.textContent ?? '').replace(/\s+/g, ' ').trim();
+const countWords = (s: string) => (s.match(/\S+/g) ?? []).length;
+const firstSentence = (s: string) => (s.match(/^.*?[.!?](\s|$)/)?.[0] ?? s).trim().slice(0, 200);
+
+function highlight(el: HTMLElement) {
+  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  const previous = { outline: el.style.outline, background: el.style.backgroundColor, transition: el.style.transition };
+  el.style.transition = 'background-color 0.6s ease';
+  el.style.outline = '2px solid rgb(251 191 36)';
+  el.style.backgroundColor = 'rgb(254 243 199)';
+  window.setTimeout(() => {
+    el.style.outline = previous.outline;
+    el.style.backgroundColor = previous.background;
+    window.setTimeout(() => (el.style.transition = previous.transition), 600);
+  }, 2500);
+}
+
+// ---------------------------------------------------------------------------
+// Tool definitions
+// ---------------------------------------------------------------------------
+
+const siteTools: ModelContextTool[] = [
+  {
+    name: 'list_articles',
+    description:
+      'List articles published on The DevTools Times, newest first. Optionally filter by category (e.g. "sports", "lifestyle", "politics") and/or a keyword. Returns slugs, titles, summaries, authors, categories, dates and URLs.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: { type: 'string', description: 'Only return articles in this category (case-insensitive).' },
+        keyword: { type: 'string', description: 'Optional keyword matched against title, summary, author and tags.' },
+        limit: { type: 'integer', minimum: 1, maximum: 50, description: 'Maximum number of articles to return (default 20).' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    execute: safe(async ({ category, keyword, limit }: { category?: string; keyword?: string; limit?: number }) => {
+      const articles = await fetchArticles();
+      const matches = searchArticles(articles, keyword ?? '', category)
+        .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
+      const categories = [...new Set(articles.map(a => a.category).filter(Boolean))].sort();
+      return ok({
+        total: matches.length,
+        availableCategories: categories,
+        articles: matches.slice(0, Math.min(Math.max(limit ?? 20, 1), 50)).map(a => ({
+          slug: a.slug,
+          title: a.title,
+          summary: a.summary,
+          author: a.author,
+          category: a.category,
+          date: a.date,
+          url: absoluteArticleUrl(a.slug),
+        })),
+      });
+    }),
+  },
+  {
+    name: 'get_reading_list',
+    description:
+      "Get the articles currently saved in the reader's reading list. Use the update_reading_list form tool to add or remove articles.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: safe(async () => {
+      const [slugs, articles] = await Promise.all([fetchReadingList(), fetchArticles()]);
+      return ok({
+        count: slugs.length,
+        articles: slugs.map(slug => {
+          const a = articles.find(item => item.slug === slug);
+          return { slug, title: a?.title ?? slug, summary: a?.summary, url: absoluteArticleUrl(slug) };
+        }),
+      });
+    }),
+  },
+  {
+    name: 'open_article',
+    description: 'Navigate the browser to an article on The DevTools Times by its slug.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', description: 'Article slug, as returned by list_articles or search_articles.' } },
+      required: ['slug'],
+    },
+    execute: safe(async ({ slug }: { slug: string }) => {
+      const articles = await fetchArticles();
+      const article = articles.find(a => a.slug === slug);
+      if (!article) return fail(`Unknown article "${slug}". Call list_articles to see valid slugs.`);
+      await navigate(articleUrl(slug));
+      return ok(`Opened "${article.title}" (${absoluteArticleUrl(slug)}).`);
+    }),
+  },
+];
+
+const articleTools: ModelContextTool[] = [
+  {
+    name: 'get_current_article',
+    description:
+      'Get the article currently open in the browser: slug, title, summary, author, category, date, tags, URL, word count and estimated reading time. Optionally includes the full article text.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        includeText: { type: 'boolean', description: 'Include the full plain-text body of the article (default true).' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    execute: safe(({ includeText = true }: { includeText?: boolean }) => {
+      const article = requireArticle();
+      const blocks = getBlocks(article).map(text);
+      const bodyText = blocks.join('\n\n');
+      const wordCount = countWords(bodyText);
+      return ok({
+        slug: article.slug,
+        title: article.title,
+        summary: article.summary,
+        author: article.author,
+        category: article.category,
+        date: article.date,
+        tags: article.tags,
+        url: absoluteArticleUrl(article.slug),
+        wordCount,
+        paragraphCount: blocks.length,
+        readingTimeMinutes: Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        ...(includeText ? { text: bodyText } : {}),
+      });
+    }),
+  },
+  {
+    name: 'get_article_outline',
+    description:
+      'Get a numbered outline of the open article: each section heading or paragraph with its index and lead sentence. Indexes can be passed to scroll_to_article_section.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: safe(() => {
+      const article = requireArticle();
+      return ok({
+        title: article.title,
+        outline: getBlocks(article).map((el, index) => ({
+          index,
+          type: /^H\d$/.test(el.tagName) ? 'heading' : 'paragraph',
+          lead: /^H\d$/.test(el.tagName) ? text(el) : firstSentence(text(el)),
+          words: countWords(text(el)),
+        })),
+      });
+    }),
+  },
+  {
+    name: 'find_in_article',
+    description:
+      'Find passages in the open article that mention a word or phrase (case-insensitive). Returns matching paragraph indexes with short excerpts.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: 'Word or phrase to look for.' },
+        maxResults: { type: 'integer', minimum: 1, maximum: 50, description: 'Maximum matches to return (default 10).' },
+      },
+      required: ['query'],
+    },
+    annotations: { readOnlyHint: true },
+    execute: safe(({ query, maxResults = 10 }: { query: string; maxResults?: number }) => {
+      const article = requireArticle();
+      const needle = (query ?? '').trim().toLowerCase();
+      if (!needle) return fail('Please provide a non-empty query.');
+      const matches = getBlocks(article)
+        .map((el, index) => ({ index, content: text(el) }))
+        .filter(({ content }) => content.toLowerCase().includes(needle));
+      return ok({
+        query,
+        totalMatches: matches.length,
+        matches: matches.slice(0, Math.min(Math.max(maxResults, 1), 50)).map(({ index, content }) => {
+          const at = content.toLowerCase().indexOf(needle);
+          const start = Math.max(0, at - 80);
+          const end = Math.min(content.length, at + needle.length + 80);
+          return { index, excerpt: `${start > 0 ? '…' : ''}${content.slice(start, end)}${end < content.length ? '…' : ''}` };
+        }),
+      });
+    }),
+  },
+  {
+    name: 'scroll_to_article_section',
+    description:
+      'Scroll the open article to a paragraph or heading and briefly highlight it for the reader. Identify the target by its outline index or by text it contains.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        index: { type: 'integer', minimum: 0, description: 'Index from get_article_outline or find_in_article.' },
+        text: { type: 'string', description: 'Alternatively, a word or phrase contained in the target paragraph.' },
+      },
+    },
+    execute: safe(({ index, text: phrase }: { index?: number; text?: string }) => {
+      const article = requireArticle();
+      const blocks = getBlocks(article);
+      let target: HTMLElement | undefined;
+      if (typeof index === 'number') {
+        target = blocks[index];
+        if (!target) return fail(`Index ${index} is out of range (0–${blocks.length - 1}).`);
+      } else if (phrase?.trim()) {
+        const needle = phrase.trim().toLowerCase();
+        target = blocks.find(el => text(el).toLowerCase().includes(needle));
+        if (!target) return fail(`No paragraph contains "${phrase}".`);
+      } else {
+        return fail('Provide either "index" or "text".');
+      }
+      highlight(target);
+      return ok({ scrolledTo: blocks.indexOf(target), excerpt: firstSentence(text(target)) });
+    }),
+  },
+  {
+    name: 'get_article_share_links',
+    description:
+      'Get ready-to-use share links (X, Facebook, WhatsApp, LinkedIn, email) and the canonical URL for the open article.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: safe(() => {
+      const article = requireArticle();
+      const url = absoluteArticleUrl(article.slug);
+      const u = encodeURIComponent(url);
+      const t = encodeURIComponent(article.title);
+      return ok({
+        url,
+        x: `https://x.com/intent/post?url=${u}&text=${t}`,
+        facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
+        whatsapp: `https://wa.me/?text=${encodeURIComponent(`${article.title} ${url}`)}`,
+        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
+        email: `mailto:?subject=${t}&body=${encodeURIComponent(`${article.summary}\n\n${url}`)}`,
+      });
+    }),
+  },
+  {
+    name: 'copy_article_link',
+    description: "Copy the open article's URL (optionally with its title) to the reader's clipboard.",
+    inputSchema: {
+      type: 'object',
+      properties: { includeTitle: { type: 'boolean', description: 'Prefix the link with the article title (default false).' } },
+    },
+    execute: safe(async ({ includeTitle = false }: { includeTitle?: boolean }) => {
+      const article = requireArticle();
+      const url = absoluteArticleUrl(article.slug);
+      const value = includeTitle ? `${article.title} — ${url}` : url;
+      if (!navigator.clipboard?.writeText) return fail(`Clipboard is unavailable. The link is: ${value}`);
+      try {
+        await navigator.clipboard.writeText(value);
+      } catch {
+        return fail(`The browser blocked clipboard access. The link is: ${value}`);
+      }
+      return ok(`Copied to clipboard: ${value}`);
+    }),
+  },
+];
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+/** Registers tools and returns a cleanup function that unregisters them. */
+function registerTools(tools: ModelContextTool[]): () => void {
+  const mc = navigator.modelContext;
+  if (!mc?.registerTool) return () => {};
+  const controller = new AbortController();
+  const registered: string[] = [];
+  for (const tool of tools) {
+    try {
+      mc.registerTool(tool, { signal: controller.signal });
+      registered.push(tool.name);
+    } catch (error) {
+      console.warn(`[WebMCP] Could not register tool "${tool.name}":`, error);
+    }
+  }
+  return () => {
+    controller.abort();
+    for (const name of registered) {
+      try {
+        mc.unregisterTool?.(name);
+      } catch {
+        /* already removed via the abort signal */
+      }
+    }
+  };
+}
+
+function init() {
+  const mc = navigator.modelContext;
+  if (!mc) return; // Browser has no WebMCP support; nothing to expose.
+
+  let unregisterArticleTools: (() => void) | null = null;
+
+  const sync = () => {
+    const onArticle = getCurrentArticle() !== null;
+    if (mc.registerTool) {
+      if (onArticle && !unregisterArticleTools) unregisterArticleTools = registerTools(articleTools);
+      if (!onArticle && unregisterArticleTools) {
+        unregisterArticleTools();
+        unregisterArticleTools = null;
+      }
+    } else if (mc.provideContext) {
+      // Older API shape: replace the whole tool set on each page.
+      mc.provideContext({ tools: onArticle ? [...siteTools, ...articleTools] : siteTools });
+    }
+  };
+
+  registerTools(siteTools);
+  sync();
+  // Fires after every client-side navigation performed by Astro's <ClientRouter />.
+  document.addEventListener('astro:page-load', sync);
+}
+
+init();
