diff --git a/src/components/ArticleAgentTools.tsx b/src/components/ArticleAgentTools.tsx
new file mode 100644
index 0000000..b019463
--- /dev/null
+++ b/src/components/ArticleAgentTools.tsx
@@ -0,0 +1,124 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { articleUrl, fetchReadingList, nextPaint, toggleReadingListEntry } from '../utils/agentTools';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  /** id of the element that wraps the rendered article body. */
+  bodyId: string;
+}
+
+const WORDS_PER_MINUTE = 230;
+
+/**
+ * Article-page WebMCP tools. Registered only while an article is on screen, so
+ * agents never see tools that don't apply to the current page.
+ */
+export default function ArticleAgentTools({ slug, title, summary, author, date, category, readingTime, bodyId }: Props) {
+  const getBody = () => document.getElementById(bodyId);
+
+  const getHeadings = () =>
+    Array.from(getBody()?.querySelectorAll<HTMLHeadingElement>('h2, h3, h4') ?? []).map((heading) => ({
+      element: heading,
+      level: Number(heading.tagName.slice(1)),
+      text: heading.textContent?.trim() ?? '',
+      id: heading.id,
+    }));
+
+  useWebMCP({
+    name: 'get_current_article',
+    description:
+      'Returns the article open in this tab: its metadata, full body text, word count and reading-list status. Use it to read, summarize or answer questions about the article.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal }) {
+      const text = getBody()?.innerText.trim() ?? '';
+      const wordCount = text ? text.split(/\s+/).length : 0;
+      const readingList = await fetchReadingList(signal).catch((error) => {
+        if (signal.aborted) throw error;
+        return null;
+      });
+      return {
+        slug,
+        title,
+        summary,
+        author,
+        publishedOn: date,
+        category,
+        url: articleUrl(slug),
+        wordCount,
+        readingTimeMinutes: readingTime ?? Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        isOnReadingList: readingList ? readingList.includes(slug) : 'unknown',
+        text,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_article_outline',
+    description: 'Lists the section headings of the article open in this tab, in reading order.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const sections = getHeadings().map(({ level, text, id }) => ({ level, heading: text, id }));
+      return sections.length > 0
+        ? { title, sections }
+        : { title, sections, message: 'This article has no section headings.' };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ heading?: string }>({
+    name: 'scroll_to_article_section',
+    description: 'Scrolls the article open in this tab to one of its sections so the user can see it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        heading: {
+          type: 'string',
+          description: 'Heading text of the section (or part of it), as listed by get_article_outline.',
+        },
+      },
+      required: ['heading'],
+    },
+    async execute({ heading }) {
+      const headings = getHeadings();
+      if (typeof heading !== 'string' || !heading.trim()) {
+        return { error: 'Provide the heading of the section to scroll to.', headings: headings.map((h) => h.text) };
+      }
+      const term = heading.trim().toLowerCase();
+      const match =
+        headings.find((h) => h.text.toLowerCase() === term || h.id === term) ??
+        headings.find((h) => h.text.toLowerCase().includes(term));
+      if (!match) {
+        return { error: `No section heading matches "${heading}".`, headings: headings.map((h) => h.text) };
+      }
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      match.element.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
+      await nextPaint();
+      return { message: `Scrolled to "${match.text}".` };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'save_current_article',
+    description: "Saves the article open in this tab to the user's reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal }) {
+      const readingList = await fetchReadingList(signal);
+      if (readingList.includes(slug)) {
+        return { message: `"${title}" is already on the reading list.` };
+      }
+      await toggleReadingListEntry(slug, signal);
+      return { message: `Saved "${title}" to the reading list.` };
+    },
+    annotations: { readOnlyHint: false },
+  });
+
+  return null;
+}
