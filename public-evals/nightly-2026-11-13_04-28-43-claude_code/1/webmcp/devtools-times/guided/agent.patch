diff --git a/src/components/SiteAgentTools.tsx b/src/components/SiteAgentTools.tsx
new file mode 100644
index 0000000..a84b537
--- /dev/null
+++ b/src/components/SiteAgentTools.tsx
@@ -0,0 +1,123 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { navigate } from 'astro:transitions/client';
+import {
+  OPEN_READING_LIST_EVENT,
+  OPEN_SEARCH_EVENT,
+  articleUrl,
+  fetchArticles,
+  fetchReadingList,
+  nextPaint,
+  toAgentArticle,
+  toggleReadingListEntry,
+  type OpenSearchDetail,
+} from '../utils/agentTools';
+
+/**
+ * Site-wide WebMCP tools for in-browser AI agents. Renders nothing; tools are
+ * registered while this island is mounted and feature-detected by the hook.
+ * The search and "save an article" forms are exposed declaratively from their panels.
+ */
+export default function SiteAgentTools() {
+  useWebMCP<{ query?: string }>({
+    name: 'open_search_panel',
+    description:
+      'Opens the article search panel, optionally prefilled with a query. The panel provides the search_articles tool.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: 'Text to prefill the search box with.' },
+      },
+    },
+    async execute({ query }) {
+      if (query !== undefined && typeof query !== 'string') {
+        return { error: 'query must be text.' };
+      }
+      window.dispatchEvent(
+        new CustomEvent<OpenSearchDetail>(OPEN_SEARCH_EVENT, { detail: { query: query?.trim() ?? '' } }),
+      );
+      await nextPaint();
+      return { message: 'The search panel is open. Use search_articles to run a search.' };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'open_reading_list_panel',
+    description:
+      "Opens the panel showing the user's reading list. The panel provides the add_to_reading_list tool.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_READING_LIST_EVENT));
+      await nextPaint();
+      return { message: 'The reading list panel is open.' };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_reading_list',
+    description: "Lists the articles the user has saved to their reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal }) {
+      const [readingList, articles] = await Promise.all([fetchReadingList(signal), fetchArticles(signal)]);
+      const saved = articles.filter((article) => readingList.includes(article.slug)).map(toAgentArticle);
+      return { count: saved.length, articles: saved };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ slug?: string }>({
+    name: 'remove_from_reading_list',
+    description: "Removes an article from the user's reading list.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Slug of the saved article, as returned by get_reading_list.' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string' || !slug.trim()) {
+        return { error: 'Provide the slug of an article on the reading list.' };
+      }
+      const readingList = await fetchReadingList(signal);
+      if (!readingList.includes(slug)) {
+        return { error: `"${slug}" is not on the reading list.`, savedSlugs: readingList };
+      }
+      const updated = await toggleReadingListEntry(slug, signal);
+      return { message: `Removed "${slug}" from the reading list.`, savedSlugs: updated };
+    },
+    annotations: { readOnlyHint: false },
+  });
+
+  useWebMCP<{ slug?: string }>({
+    name: 'open_article',
+    description: 'Navigates the current tab to an article so its article tools become available.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'Slug of the article, as returned by search_articles or get_reading_list.' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string' || !slug.trim()) {
+        return { error: 'Provide the slug of the article to open.' };
+      }
+      const articles = await fetchArticles(signal);
+      const article = articles.find((a) => a.slug === slug);
+      if (!article) {
+        return {
+          error: `No article has the slug "${slug}". Find one with search_articles.`,
+          availableSlugs: articles.map((a) => a.slug),
+        };
+      }
+      const url = articleUrl(slug);
+      await navigate(url);
+      return { message: `Opened "${article.title}".`, url };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
