diff --git a/src/utils/agentTools.ts b/src/utils/agentTools.ts
new file mode 100644
index 0000000..34917d1
--- /dev/null
+++ b/src/utils/agentTools.ts
@@ -0,0 +1,88 @@
+/**
+ * Shared client-side helpers for the WebMCP tools exposed to in-browser AI agents.
+ *
+ * Header islands (search, reading list) and the tool islands are separate React
+ * roots, so they talk to each other through window CustomEvents.
+ */
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const OPEN_SEARCH_EVENT = 'dtt:open-search';
+export const OPEN_READING_LIST_EVENT = 'dtt:open-reading-list';
+export const READING_LIST_CHANGE_EVENT = 'dtt:reading-list-change';
+
+export interface OpenSearchDetail {
+  query?: string;
+}
+
+export interface ReadingListChangeDetail {
+  readingList: string[];
+}
+
+/**
+ * Fields Chromium adds to `SubmitEvent` when an agent submits a WebMCP
+ * declarative form. They aren't covered by `webmcp-types` yet.
+ */
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+const base = import.meta.env.BASE_URL;
+
+export const articleUrl = (slug: string) => new URL(`${base}articles/${slug}`, location.origin).href;
+
+export async function fetchArticles(signal?: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${base}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load articles (HTTP ${response.status}).`);
+  return response.json();
+}
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${base}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load the reading list (HTTP ${response.status}).`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** The API toggles membership, so callers must check the current list first. */
+export async function toggleReadingListEntry(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${base}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Could not update the reading list (HTTP ${response.status}).`);
+  const data = await response.json();
+  const readingList: string[] = data.readingList ?? [];
+  window.dispatchEvent(
+    new CustomEvent<ReadingListChangeDetail>(READING_LIST_CHANGE_EVENT, { detail: { readingList } }),
+  );
+  return readingList;
+}
+
+export function searchArticles(articles: ArticleSummary[], query: string): ArticleSummary[] {
+  const term = query.trim().toLowerCase();
+  if (!term) return [];
+  return articles.filter(
+    (article) =>
+      article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term),
+  );
+}
+
+export const toAgentArticle = ({ slug, title, summary }: ArticleSummary) => ({
+  slug,
+  title,
+  summary,
+  url: articleUrl(slug),
+});
+
+/** Resolves after React has committed and the browser has painted the change. */
+export const nextPaint = () =>
+  new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
