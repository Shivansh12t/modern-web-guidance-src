+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var activeId = null;
+
+      function linkFor(id) {
+        return links.find(function (a) { return a.getAttribute('href') === '#' + id; });
+      }
+
+      // Offset of a section's snap target (its header) relative to the panel's scroll origin.
+      function offsetOf(section) {
+        var target = section.querySelector('header') || section;
+        return target.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+      }
+
+      function setActive(id) {
+        if (!id || id === activeId) return;
+        activeId = id;
+        links.forEach(function (a) {
+          var on = a.getAttribute('href') === '#' + id;
+          a.classList.toggle('is-active', on);
+          if (on) a.setAttribute('aria-current', 'true');
+          else a.removeAttribute('aria-current');
+        });
+        sections.forEach(function (s) {
+          if (s.id === id) s.setAttribute('data-active', '');
+          else s.removeAttribute('data-active');
+        });
+      }
+
+      // Section whose header is closest to the top of the panel (i.e. the snapped one).
+      function currentSection() {
+        var top = panel.scrollTop;
+        // At the very bottom, the last section may not be able to reach the top.
+        if (Math.ceil(top + panel.clientHeight) >= panel.scrollHeight - 1) {
+          return sections[sections.length - 1];
+        }
+        var best = sections[0];
+        var bestDist = Infinity;
+        sections.forEach(function (s) {
+          var d = Math.abs(offsetOf(s) - top);
+          if (d < bestDist) { bestDist = d; best = s; }
+        });
+        return best;
+      }
+
+      function onSettle() {
+        var s = currentSection();
+        if (s) setActive(s.id);
+      }
+
+      // Update only once scrolling (and snapping) has settled.
+      if ('onscrollend' in window) {
+        panel.addEventListener('scrollend', onSettle);
+      } else {
+        var timer;
+        panel.addEventListener('scroll', function () {
+          clearTimeout(timer);
+          timer = setTimeout(onSettle, 150);
+        }, { passive: true });
+      }
+
+      toc.addEventListener('click', function (e) {
+        var link = e.target.closest('a[href^="#"]');
+        if (!link) return;
+        var section = document.getElementById(link.getAttribute('href').slice(1));
+        if (!section || !panel.contains(section)) return;
+        e.preventDefault();
+
+        panel.scrollTo({
+          top: offsetOf(section),
+          behavior: reduceMotion.matches ? 'auto' : 'smooth'
+        });
+        setActive(section.id);
+        // Move focus for keyboard / screen reader users without causing a jump.
+        section.focus({ preventScroll: true });
+        if (history.replaceState) history.replaceState(null, '', '#' + section.id);
+      });
+
+      // Initial state: honour a deep link hash, otherwise the first section.
+      var initial = location.hash && document.getElementById(location.hash.slice(1));
+      if (initial && panel.contains(initial)) {
+        panel.scrollTop = offsetOf(initial);
+        setActive(initial.id);
+      } else {
+        onSettle();
+      }
+    })();
+  </script>
