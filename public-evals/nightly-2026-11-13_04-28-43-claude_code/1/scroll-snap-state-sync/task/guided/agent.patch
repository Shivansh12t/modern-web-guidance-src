+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a[href^="#"]')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const headers = sections.map((section) => section.querySelector('header'));
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Id of the section a TOC click is scrolling to; suppresses fallback
+    // updates for in-between sections until the scroll settles.
+    let pendingId = null;
+
+    function setActiveLink(id) {
+      for (const link of links) {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    function scrollToSection(section, { focus = true } = {}) {
+      const header = section.querySelector('header');
+      const top =
+        header.getBoundingClientRect().top -
+        panel.getBoundingClientRect().top -
+        panel.clientTop +
+        panel.scrollTop;
+      panel.scrollTo({ top, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
+      // Move focus for keyboard/AT users without causing a second (instant) scroll.
+      if (focus) section.focus({ preventScroll: true });
+    }
+
+    function clearPending() {
+      pendingId = null;
+    }
+
+    for (const link of links) {
+      link.addEventListener('click', (event) => {
+        const section = document.getElementById(link.hash.slice(1));
+        if (!section || !panel.contains(section)) return;
+        event.preventDefault();
+        pendingId = section.id;
+        setActiveLink(section.id);
+        history.replaceState(null, '', link.hash);
+        scrollToSection(section);
+        // Safety net in case scrollend never fires (no movement / unsupported).
+        setTimeout(() => pendingId === section.id && clearPending(), 1000);
+      });
+    }
+
+    panel.addEventListener('scrollend', clearPending);
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      // Fires once the scroller settles on a new snap target (an article header).
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const section = event.snapTargetBlock?.closest('.drink-section');
+        if (section) {
+          clearPending();
+          setActiveLink(section.id);
+        }
+      });
+    } else {
+      // Fallback: track which header is nearest the top of the scrollport.
+      const observer = new IntersectionObserver(
+        () => {
+          if (pendingId) return;
+          const scrollportTop = panel.getBoundingClientRect().top + panel.clientTop;
+          const topHeader = headers.reduce((current, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom <= scrollportTop + 1) return current;
+            if (!current) return header;
+            return bottom < current.getBoundingClientRect().bottom ? header : current;
+          }, undefined);
+          if (topHeader) setActiveLink(topHeader.closest('.drink-section').id);
+        },
+        { root: panel, rootMargin: '-1px 0px 0px 0px', threshold: [0, 0.9] },
+      );
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    // Honor a deep link like /#cold-brew on load.
+    const initial = location.hash && document.getElementById(location.hash.slice(1));
+    if (initial && sections.includes(initial)) {
+      setActiveLink(initial.id);
+      scrollToSection(initial, { focus: false });
+    }
+  </script>
+
