+  <script type="module">
+    // Seasonal promo countdown: computed once on page load, in the visitor's local time zone.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const el = document.getElementById('maple-promo-timer');
+    if (el) {
+      const tz = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(tz);
+      const start = Temporal.PlainDateTime.from(el.dataset.start).toZonedDateTime(tz);
+      const end = Temporal.PlainDateTime.from(el.dataset.end).toZonedDateTime(tz);
+
+      const remainingEl = el.querySelector('.promo-remaining');
+      const elapsedEl = el.querySelector('.promo-elapsed');
+      const fmt = (d) => d.toLocaleString(undefined, { style: 'long' });
+      const dateFmt = { dateStyle: 'medium', timeStyle: 'short' };
+      const opts = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'floor' };
+      const setStrong = (target, prefix, value, suffix = '') => {
+        const strong = document.createElement('strong');
+        strong.textContent = value;
+        target.replaceChildren(prefix, strong, suffix);
+      };
+
+      if (Temporal.ZonedDateTime.compare(now, start) < 0) {
+        el.dataset.state = 'upcoming';
+        setStrong(remainingEl, 'Starts in ', fmt(now.until(start, opts)));
+        elapsedEl.textContent = `Runs until ${end.toLocaleString(undefined, dateFmt)}`;
+      } else if (Temporal.ZonedDateTime.compare(now, end) < 0) {
+        el.dataset.state = 'active';
+        const remaining = now.until(end, opts);
+        setStrong(remainingEl, '', remaining.blank ? 'Less than an hour' : fmt(remaining), ' left');
+        const elapsed = now.since(start, opts);
+        elapsedEl.textContent = `Running for ${elapsed.blank ? 'less than an hour' : fmt(elapsed)}`;
+      } else {
+        el.dataset.state = 'ended';
+        setStrong(remainingEl, 'Offer ended ', end.toLocaleString(undefined, dateFmt));
+        const ran = end.since(start, opts);
+        const ago = now.since(end, opts);
+        elapsedEl.textContent = `Ran for ${fmt(ran)} · ended ${fmt(ago)} ago`;
+      }
+    }
+  </script>
+
 </body>
 
