+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const status = document.getElementById('newsletter-status');
+      const fields = () => [...form.elements].filter((el) => el.matches('input, select, textarea'));
+
+      // List the field's error message (the id in data-error) in aria-describedby only while
+      // it's shown: text that aria-describedby references is announced even when hidden.
+      const linkError = (el, shown) => {
+        const errorId = el.dataset.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+
+      // One polite live region announces an error that appears when the user leaves a field.
+      const announcer = document.createElement('div');
+      announcer.setAttribute('aria-live', 'polite');
+      announcer.classList.add('visually-hidden');
+      document.body.append(announcer);
+      let announceTimer;
+      let announcedField;
+
+      // Text as a screen reader reads it: icons' text alternatives in, aria-hidden text out.
+      const spokenText = (node) => {
+        const copy = node.cloneNode(true);
+        copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
+        copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
+        return copy.textContent.replace(/\s+/g, ' ').trim();
+      };
+
+      const clearAnnouncement = () => {
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announcedField = null;
+      };
+
+      const announceError = (el) => {
+        const error = document.getElementById(el.dataset.error);
+        if (!error) return;
+        const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
+        clearAnnouncement();
+        announcedField = el;
+        // Wait until the screen reader has announced whatever receives focus next.
+        announceTimer = setTimeout(() => { announcer.textContent = label + spokenText(error); }, 500);
+      };
+
+      // Keep aria-invalid / aria-describedby in lockstep with the visual :user-invalid state.
+      const flagged = new WeakSet();
+      const announced = new WeakSet();
+      const syncAria = (el, announce = false) => {
+        if (!el.matches?.('input, select, textarea')) return;
+        if (el.matches(':user-invalid')) {
+          if (announce && !announced.has(el)) {
+            announceError(el);
+            announced.add(el);
+          }
+          el.setAttribute('aria-invalid', 'true');
+          linkError(el, true);
+          flagged.add(el);
+        } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
+          el.setAttribute('aria-invalid', 'false');
+          linkError(el, false);
+          flagged.delete(el);
+          announced.delete(el);
+          // The email became valid: drop any pending or stale error announcement.
+          if (announcedField === el) clearAnnouncement();
+        }
+      };
+
+      // Start at aria-invalid="false" (Firefox/Safari otherwise expose empty required
+      // fields as invalid from page load).
+      fields().forEach((el) => syncAria(el));
+
+      // Blur shows and announces an error; input clears it as soon as the value is valid.
+      form.addEventListener('blur', (e) => syncAria(e.target, true), true);
+      form.addEventListener('change', (e) => syncAria(e.target, true), true);
+      form.addEventListener('input', (e) => {
+        status.textContent = '';
+        syncAria(e.target);
+      });
+
+      // A failed submit fires 'invalid' (doesn't bubble) on each failing field. The browser
+      // moves focus to the first one, which reads its error, so don't announce it twice.
+      form.addEventListener('invalid', (e) => {
+        announced.add(e.target);
+        clearAnnouncement();
+        syncAria(e.target);
+      }, true);
+
+      // Reset clears :user-invalid after the 'reset' event, so resync afterwards.
+      form.addEventListener('reset', () => {
+        setTimeout(() => fields().forEach((el) => syncAria(el)));
+      });
+
+      // Native validation blocks invalid submits; this only runs for a valid email.
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const email = form.elements.email.value.trim();
+        form.reset();
+        status.textContent = `Thanks! ${email} is now subscribed to the Grind Newsletter.`;
+      });
+    })();
+  </script>
+
