+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var status = document.getElementById('newsletter-status');
+      var touched = false; // becomes true after first blur or submit attempt
+
+      function getErrorMessage() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        // Rely on native constraint validation plus a stricter domain check.
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      // Single source of truth: visual message, aria-invalid, aria-describedby
+      // and the live-region text all change together in this one function.
+      function showError(message) {
+        if (error.textContent !== message) {
+          // Only touch the live region when the message actually changes, so
+          // screen readers are not re-announced on every keystroke.
+          error.textContent = message;
+        }
+        input.setAttribute('aria-invalid', 'true');
+        input.setAttribute('aria-describedby', error.id);
+      }
+
+      function clearError() {
+        if (error.textContent !== '') error.textContent = '';
+        input.setAttribute('aria-invalid', 'false');
+        input.removeAttribute('aria-describedby');
+      }
+
+      function validate() {
+        var message = getErrorMessage();
+        if (message) {
+          showError(message);
+          return false;
+        }
+        clearError();
+        return true;
+      }
+
+      input.addEventListener('blur', function () {
+        // Don't flag an untouched, empty field just because focus passed through.
+        if (!touched && input.value.trim() === '') return;
+        touched = true;
+        validate();
+      });
+
+      input.addEventListener('input', function () {
+        if (status.textContent) status.textContent = '';
+        if (!touched) return; // no errors before the user has interacted
+        if (!getErrorMessage()) {
+          clearError(); // clear immediately once the email becomes valid
+        } else if (error.textContent) {
+          showError(getErrorMessage()); // keep message accurate while still invalid
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        status.textContent = '';
+        if (!validate()) {
+          input.focus();
+          return;
+        }
+        // No backend in this static site; simulate a successful signup.
+        var email = input.value.trim();
+        form.reset();
+        clearError();
+        touched = false;
+        status.textContent = 'Thanks! ' + email + ' is now subscribed to The Daily Grind newsletter.';
+      });
+    })();
+  </script>
+
