+
+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const success = document.getElementById('newsletter-success');
+
+      // One polite live region announces an error shortly after the user leaves the field.
+      const announcer = document.createElement('div');
+      announcer.setAttribute('aria-live', 'polite');
+      announcer.className = 'visually-hidden';
+      document.body.append(announcer);
+      let announceTimer;
+      let announced = false;
+
+      // List the error in aria-describedby only while it's shown; hidden text that
+      // aria-describedby references is still announced.
+      const linkError = (shown) => {
+        const errorId = input.dataset.error;
+        const ids = (input.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        input.setAttribute('aria-describedby', ids.join(' '));
+      };
+
+      // Keep aria-invalid in step with the visual :user-invalid state.
+      const syncAria = (announce = false) => {
+        const invalid = input.matches(':user-invalid');
+        input.setAttribute('aria-invalid', String(invalid));
+        linkError(invalid);
+        if (invalid && announce && !announced) {
+          announced = true;
+          clearTimeout(announceTimer);
+          announcer.textContent = '';
+          announceTimer = setTimeout(() => {
+            announcer.textContent = 'Email address: Error: Enter an email address in the format you@example.com.';
+          }, 500);
+        } else if (!invalid) {
+          announced = false;
+          clearTimeout(announceTimer);
+          announcer.textContent = '';
+        }
+      };
+
+      syncAria();
+      input.addEventListener('blur', () => syncAria(true));
+      input.addEventListener('input', () => {
+        success.textContent = '';
+        syncAria();
+      });
+      // A failed submit focuses the field, which reads out its error, so don't announce twice.
+      input.addEventListener('invalid', () => {
+        announced = true;
+        syncAria();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        // TODO: send to the newsletter provider once one is chosen.
+        success.textContent = `Thanks! We'll send the newsletter to ${input.value}.`;
+        form.reset();
+        setTimeout(() => syncAria());
+      });
+    })();
+  </script>
