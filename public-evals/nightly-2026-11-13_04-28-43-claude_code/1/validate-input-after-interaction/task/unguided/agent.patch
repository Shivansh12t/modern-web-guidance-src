+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-error');
+      var success = document.getElementById('newsletter-success');
+      var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+      function getError(value) {
+        if (!value) return 'Please enter your email address.';
+        if (!EMAIL_RE.test(value)) return 'Please enter a valid email address.';
+        return '';
+      }
+
+      function showError(msg) {
+        error.textContent = msg;
+        input.classList.toggle('is-invalid', !!msg);
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+      }
+
+      // Validate only once the user leaves the field (and only if they typed something).
+      input.addEventListener('blur', function () {
+        var value = input.value.trim();
+        if (value) showError(getError(value));
+      });
+
+      // While typing, never add an error — only clear an existing one once it's fixed.
+      input.addEventListener('input', function () {
+        if (input.classList.contains('is-invalid') && !getError(input.value.trim())) {
+          showError('');
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var msg = getError(input.value.trim());
+        showError(msg);
+        if (msg) {
+          input.focus();
+          return;
+        }
+        form.hidden = true;
+        success.hidden = false;
+      });
+    })();
+  </script>
+
 </body>
 
