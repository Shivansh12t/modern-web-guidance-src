+      }
+
+      /**
+       * Checks availability with the same options we will create with.
+       * Returns 'unavailable' | 'downloadable' | 'downloading' | 'available'.
+       */
+      async function checkAvailability(options = {}) {
+        if (!isApiSupported()) return 'unsupported';
+        try {
+          return await LanguageModel.availability({ ...LANG_OPTIONS, ...options });
+        } catch (err) {
+          console.warn('LanguageModel.availability() failed:', err);
+          return 'unavailable';
+        }
+      }
+
+      /**
+       * Verifies availability, then creates a session while reporting download progress.
+       * Must be called from a user gesture when the model still needs downloading.
+       */
+      async function createSession({ statusEl, progressEl, signal, ...options }) {
+        const availability = await checkAvailability(options);
+        if (availability === 'unsupported') {
+          throw new Error('The built-in AI (Prompt API) is not supported in this browser. Try a recent version of Chrome with on-device AI enabled.');
+        }
+        if (availability === 'unavailable') {
+          throw new Error('The on-device model is unavailable on this device (check hardware requirements, disk space, or browser settings).');
+        }
+        if (availability !== 'available') {
+          setStatus(statusEl, availability === 'downloading'
+            ? 'The AI model is downloading…'
+            : 'Downloading the on-device AI model (one-time)…');
+          progressEl.hidden = false;
+          progressEl.removeAttribute('value'); // indeterminate until first event
+        }
+
+        try {
+          const session = await LanguageModel.create({
+            ...LANG_OPTIONS,
+            ...options,
+            signal,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                progressEl.hidden = false;
+                progressEl.value = e.loaded; // 0..1
+                setStatus(statusEl, `Downloading model… ${Math.round(e.loaded * 100)}%`);
