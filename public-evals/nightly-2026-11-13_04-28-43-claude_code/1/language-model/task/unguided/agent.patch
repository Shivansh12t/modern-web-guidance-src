+        } finally {
+          branching.controller = null;
+          setBranchBusy(false);
+        }
+      });
+
+      branching.resetBtn.addEventListener('click', () => {
+        branching.controller?.abort();
+        for (const b of [...branching.branches]) removeBranch(b);
+        setStatus(branching.status, 'All branches closed and their resources released.');
+      });
+
+      // ---------- Initial availability hint (no session created until a user gesture) ----------
+      (async () => {
+        const availability = await checkAvailability();
+        const hints = {
+          unsupported: 'Built-in AI is not supported in this browser.',
+          unavailable: 'The on-device model is unavailable on this device.',
+          downloadable: 'The AI model will download on first use.',
+          downloading: 'The AI model is currently downloading…',
+          available: '',
+        };
+        const msg = hints[availability] ?? '';
+        const isError = availability === 'unsupported' || availability === 'unavailable';
+        for (const el of [barista.status, sentiment.status, branching.status]) setStatus(el, msg, isError);
+        if (isError) {
+          for (const btn of [barista.askBtn, sentiment.btn, branching.sendBtn, branching.cloneBtn]) btn.disabled = true;
+        }
+      })();
+
+      // ---------- Resource cleanup ----------
+      function cleanupAll() {
+        barista.controller?.abort();
+        branching.controller?.abort();
+        for (const s of [...liveSessions]) destroySession(s);
+        barista.baseSession = null;
+        sentiment.baseSession = null;
+        branching.branches = [];
+        branching.activeId = null;
+        branching.list.replaceChildren();
+      }
+      window.addEventListener('pagehide', cleanupAll);
+    })();
+  </script>
+
 </body>
 
