+  <script type="module">
+    // Load Temporal polyfill only when the browser lacks native support.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const ZONES = [
+      { id: 'America/Los_Angeles', city: 'Los Angeles' },
+      { id: 'America/Denver', city: 'Denver' },
+      { id: 'America/Chicago', city: 'Chicago' },
+      { id: 'America/New_York', city: 'New York' },
+      { id: 'America/Bogota', city: 'Bogotá' },
+      { id: 'America/Sao_Paulo', city: 'São Paulo' },
+      { id: 'UTC', city: 'UTC' },
+      { id: 'Europe/London', city: 'London' },
+      { id: 'Europe/Paris', city: 'Paris' },
+      { id: 'Europe/Berlin', city: 'Berlin' },
+      { id: 'Africa/Addis_Ababa', city: 'Addis Ababa' },
+      { id: 'Africa/Nairobi', city: 'Nairobi' },
+      { id: 'Asia/Kolkata', city: 'Kolkata' },
+      { id: 'Asia/Jakarta', city: 'Jakarta' },
+      { id: 'Asia/Ho_Chi_Minh', city: 'Ho Chi Minh City' },
+      { id: 'Asia/Tokyo', city: 'Tokyo' },
+      { id: 'Australia/Sydney', city: 'Sydney' },
+      { id: 'Pacific/Auckland', city: 'Auckland' },
+    ];
+
+    // Cities shown as cards (Tokyo always included).
+    const TARGETS = [
+      'America/Los_Angeles', 'America/New_York', 'America/Bogota', 'America/Sao_Paulo',
+      'Europe/London', 'Europe/Paris', 'Africa/Addis_Ababa', 'Asia/Kolkata',
+      'Asia/Jakarta', 'Asia/Tokyo', 'Australia/Sydney', 'Pacific/Auckland',
+    ];
+
+    // Format an instant in its own zone via Intl (consistent across native Temporal and the polyfill).
+    const fmtIn = (zdt, opts) =>
+      new Intl.DateTimeFormat('en-US', { ...opts, timeZone: zdt.timeZoneId }).format(zdt.epochMilliseconds);
+
+    const cityOf = (id) => ZONES.find((z) => z.id === id)?.city ?? id;
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const statusEl = document.getElementById('status');
+
+    // Populate host select
+    for (const z of ZONES) {
+      hostTzSelect.add(new Option(`${z.city} (${z.id})`, z.id));
+    }
+    const localTz = Temporal.Now.timeZoneId();
+    hostTzSelect.value = ZONES.some((z) => z.id === localTz) ? localTz : 'America/New_York';
+
+    // Defaults: next day at 10:00 in the host zone
+    if (!dateInput.value) {
+      dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).add({ days: 1 }).toString();
+    }
+    if (!timeInput.value) timeInput.value = '10:00';
+
+    /**
+     * Resolve the host wall-clock time strictly. Returns { zdt } or { error }.
+     * Uses disambiguation: 'reject' so DST gaps (skipped) and overlaps (repeated) are refused.
+     */
+    function resolveHostTime(dateStr, timeStr, tz) {
+      let pdt;
+      try {
+        pdt = Temporal.PlainDateTime.from(`${dateStr}T${timeStr}`, { overflow: 'reject' });
+      } catch {
+        return { error: 'Please enter a valid date and time.' };
+      }
+      try {
+        return { zdt: pdt.toZonedDateTime(tz, { disambiguation: 'reject' }) };
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+        const earlier = pdt.toZonedDateTime(tz, { disambiguation: 'earlier' });
+        const later = pdt.toZonedDateTime(tz, { disambiguation: 'later' });
+        const fmt = (z) => fmtIn(z, { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
+        const wall = pdt.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
+        // In a gap the wall time is shifted; in an overlap both candidates keep the same wall time.
+        const isGap = !earlier.toPlainDateTime().equals(pdt);
+        if (isGap) {
+          return {
+            error: `${wall} does not exist in ${cityOf(tz)} — clocks spring forward for daylight saving time and skip this hour. ` +
+              `Try ${fmt(earlier)} or ${fmt(later)} instead.`,
+          };
+        }
+        return {
+          error: `${wall} occurs twice in ${cityOf(tz)} — clocks fall back for daylight saving time, so this time is ambiguous ` +
+            `(${fmt(earlier)} or ${fmt(later)}). Please pick a time outside the repeated hour.`,
+        };
+      }
+    }
+
+    // DST detection: zone is in DST if current offset exceeds its standard (smaller of Jan/Jul) offset.
+    function isDst(zdt) {
+      const y = zdt.year;
+      const jan = Temporal.PlainDate.from({ year: y, month: 1, day: 1 }).toZonedDateTime(zdt.timeZoneId);
+      const jul = Temporal.PlainDate.from({ year: y, month: 7, day: 1 }).toZonedDateTime(zdt.timeZoneId);
+      const standard = Math.min(jan.offsetNanoseconds, jul.offsetNanoseconds);
+      return jan.offsetNanoseconds !== jul.offsetNanoseconds && zdt.offsetNanoseconds > standard;
+    }
+
+    function badge(text, cls) {
+      const b = document.createElement('span');
+      b.className = `badge ${cls}`;
+      b.textContent = text;
+      return b;
+    }
+
+    function setStatus(msg, isError = false) {
+      statusEl.textContent = msg;
+      statusEl.classList.toggle('error', isError);
+    }
+
+    function render() {
+      const tz = hostTzSelect.value;
+      grid.replaceChildren();
+      dateInput.removeAttribute('aria-invalid');
+      timeInput.removeAttribute('aria-invalid');
+
+      if (!dateInput.value || !timeInput.value) {
+        setStatus('Choose a date and time to see converted times.', true);
+        grid.append(Object.assign(document.createElement('p'), { className: 'grid-empty', textContent: 'No event scheduled yet.' }));
+        return;
+      }
+
+      const { zdt: host, error } = resolveHostTime(dateInput.value, timeInput.value, tz);
+      if (error) {
+        timeInput.setAttribute('aria-invalid', 'true');
+        setStatus(error, true);
+        grid.append(Object.assign(document.createElement('p'), { className: 'grid-empty', textContent: 'Fix the event time to see conversions.' }));
+        return;
+      }
+
+      setStatus(
+        `Tasting hosted from ${cityOf(tz)} on ` +
+        fmtIn(host, { dateStyle: 'full', timeStyle: 'short' }) +
+        ` (${host.toInstant().toString({ smallestUnit: 'minute' })}).`
+      );
+
+      const targets = [tz, ...TARGETS.filter((t) => t !== tz)];
+      const hostDate = host.toPlainDate();
+
+      for (const id of targets) {
+        const local = host.withTimeZone(id);
+        const card = document.createElement('article');
+        card.className = 'card tz-card' + (id === tz ? ' is-host' : '');
+
+        const head = document.createElement('div');
+        head.className = 'city';
+        const h3 = document.createElement('h3');
+        h3.textContent = cityOf(id);
+        const zone = document.createElement('span');
+        zone.className = 'zone';
+        zone.textContent = id;
+        head.append(h3, zone);
+
+        const time = document.createElement('time');
+        time.className = 'time';
+        time.dateTime = local.toString({ timeZoneName: 'never' });
+        time.textContent = fmtIn(local, { hour: 'numeric', minute: '2-digit' });
+
+        const date = document.createElement('div');
+        date.className = 'date';
+        date.textContent = fmtIn(local, { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' });
+
+        const badges = document.createElement('div');
+        badges.className = 'badges';
+        if (id === tz) badges.append(badge('Host', 'host'));
+        badges.append(badge(`UTC${local.offset === '+00:00' ? '' : local.offset}`, ''));
+        const tzName = fmtIn(local, { timeZoneName: 'short' }).split(' ').pop();
+        badges.append(badge(tzName, ''));
+        if (isDst(local)) badges.append(badge('DST active', 'dst'));
+        const dayDiff = local.toPlainDate().since(hostDate).days;
+        if (dayDiff !== 0) badges.append(badge(`${dayDiff > 0 ? '+' : ''}${dayDiff} day vs host`, 'day'));
+        const h = local.hour;
+        badges.append(h >= 7 && h < 21 ? badge('☕ Good tasting hour', 'good') : badge('🌙 Off-hours', 'odd'));
+
+        card.append(head, time, date, badges);
+        grid.append(card);
+      }
+    }
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', render);
+      el.addEventListener('change', render);
+    }
+    document.getElementById('planner').addEventListener('submit', (e) => { e.preventDefault(); render(); });
+    render();
+  </script>
+
