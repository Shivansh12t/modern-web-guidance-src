diff --git a/equipment-panel.js b/equipment-panel.js
new file mode 100644
index 0000000..bd7161f
--- /dev/null
+++ b/equipment-panel.js
@@ -0,0 +1,398 @@
+/*
+ * Brew Station Connect
+ * --------------------
+ * Lets the browser talk to two kinds of local equipment:
+ *   - a Wi-Fi coffee brewer on the shop's private LAN (e.g. 192.168.1.x)
+ *   - the Daily Grind desktop Brew Helper running on this machine (127.0.0.1)
+ *
+ * Device protocol (JSON over HTTP, devices must send CORS headers for this
+ * origin and answer Private/Local Network Access preflights):
+ *   GET  /api/status   -> status object (fields below)
+ *   POST /api/brew     -> brewer only, body { recipe, sizeOz }
+ *   POST /api/recipe   -> helper only, body { recipe, strength }
+ *
+ * Safety rules enforced here:
+ *   - nothing is contacted until the user clicks Connect (no scanning)
+ *   - brewer host must be a private IPv4 address or an mDNS ".local" name
+ *   - helper host must be a loopback address
+ *   - requests never send cookies/credentials and time out quickly
+ *   - device responses are treated as untrusted and rendered with textContent
+ */
+(function () {
+  'use strict';
+
+  var REQUEST_TIMEOUT_MS = 5000;
+  var POLL_INTERVAL_MS = 5000;
+  var MAX_LOG_LINES = 50;
+  var MAX_FIELD_LENGTH = 40;
+  var STORAGE_PREFIX = 'dailygrind.equipment.';
+
+  /* ---------- address validation ---------- */
+
+  // Strict dotted-decimal parse (rejects octal/hex/short forms like "0177.1").
+  function parseIPv4(host) {
+    var parts = host.split('.');
+    if (parts.length !== 4) return null;
+    var octets = [];
+    for (var i = 0; i < 4; i++) {
+      var p = parts[i];
+      if (!/^(0|[1-9]\d{0,2})$/.test(p)) return null;
+      var n = Number(p);
+      if (n > 255) return null;
+      octets.push(n);
+    }
+    return octets;
+  }
+
+  function isPrivateIPv4(o) {
+    return o[0] === 10 ||
+      (o[0] === 172 && o[1] >= 16 && o[1] <= 31) ||
+      (o[0] === 192 && o[1] === 168);
+  }
+
+  function isMdnsName(host) {
+    return /^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+local$/i.test(host);
+  }
+
+  // Each validator returns { hostForUrl } on success or { error } on failure.
+  function validateBrewerHost(raw) {
+    var host = raw.trim().toLowerCase();
+    var ip = parseIPv4(host);
+    if (ip) {
+      if (!isPrivateIPv4(ip)) {
+        return { error: 'Brewer must be on a private network address (10.x, 172.16–31.x or 192.168.x).' };
+      }
+      return { hostForUrl: host };
+    }
+    if (isMdnsName(host)) return { hostForUrl: host };
+    return { error: 'Enter a private IPv4 address like 192.168.1.50 or a name ending in .local.' };
+  }
+
+  function validateHelperHost(raw) {
+    var host = raw.trim().toLowerCase();
+    if (host === 'localhost') return { hostForUrl: 'localhost' };
+    if (host === '::1' || host === '[::1]') return { hostForUrl: '[::1]' };
+    var ip = parseIPv4(host);
+    if (ip && ip[0] === 127) return { hostForUrl: host };
+    return { error: 'The Brew Helper must run on this computer: use 127.0.0.1, localhost or [::1].' };
+  }
+
+  function validatePort(raw) {
+    var s = String(raw).trim();
+    if (!/^\d{1,5}$/.test(s)) return null;
+    var n = Number(s);
+    return n >= 1 && n <= 65535 ? n : null;
+  }
+
+  /* ---------- formatting helpers ---------- */
+
+  function clean(value) {
+    if (value === null || value === undefined) return '—';
+    var s = String(value).replace(/[\u0000-\u001f\u007f]/g, '').trim();
+    if (!s) return '—';
+    return s.length > MAX_FIELD_LENGTH ? s.slice(0, MAX_FIELD_LENGTH - 1) + '…' : s;
+  }
+
+  function num(value, suffix, digits) {
+    var n = Number(value);
+    if (value === null || value === undefined || value === '' || !isFinite(n)) return '—';
+    return n.toFixed(digits || 0) + suffix;
+  }
+
+  function titleCase(value) {
+    var s = clean(value);
+    return s === '—' ? s : s.charAt(0).toUpperCase() + s.slice(1).replace(/[-_]/g, ' ');
+  }
+
+  /* ---------- device definitions ---------- */
+
+  var DEVICES = {
+    brewer: {
+      label: 'Brewer',
+      validateHost: validateBrewerHost,
+      // Chrome Local Network Access: "local" = private LAN address space.
+      addressSpace: 'local',
+      fields: [
+        { label: 'State', get: function (d) { return titleCase(d.state); } },
+        { label: 'Temp', get: function (d) { return num(d.temperatureC, '°C', 0); } },
+        { label: 'Water', get: function (d) { return num(d.waterLevelPct, '%', 0); } }
+      ],
+      command: {
+        path: '/api/brew',
+        build: function (form) {
+          return { recipe: form.recipe.value, sizeOz: Number(form.size.value) };
+        },
+        describe: function (body) { return 'Brew ' + body.sizeOz + ' oz ' + body.recipe; }
+      }
+    },
+    helper: {
+      label: 'Helper',
+      validateHost: validateHelperHost,
+      // Chrome Local Network Access: "loopback" = this machine.
+      addressSpace: 'loopback',
+      fields: [
+        { label: 'Version', get: function (d) { return clean(d.version); } },
+        { label: 'Status', get: function (d) { return titleCase(d.state); } },
+        { label: 'Recipe', get: function (d) { return titleCase(d.activeRecipe); } }
+      ],
+      command: {
+        path: '/api/recipe',
+        build: function (form) {
+          return { recipe: form.recipe.value, strength: form.strength.value };
+        },
+        describe: function (body) { return 'Send ' + body.strength + ' ' + body.recipe + ' recipe'; }
+      }
+    }
+  };
+
+  /* ---------- networking ---------- */
+
+  function request(device, baseUrl, path, options) {
+    var controller = new AbortController();
+    var timer = setTimeout(function () { controller.abort(); }, REQUEST_TIMEOUT_MS);
+    var init = {
+      method: options && options.method || 'GET',
+      mode: 'cors',
+      credentials: 'omit',
+      cache: 'no-store',
+      redirect: 'error',
+      referrerPolicy: 'no-referrer',
+      signal: controller.signal,
+      // Lets HTTPS pages reach local devices in browsers that implement
+      // Local Network Access; ignored elsewhere.
+      targetAddressSpace: device.addressSpace,
+      headers: { Accept: 'application/json' }
+    };
+    if (options && options.body !== undefined) {
+      init.headers['Content-Type'] = 'application/json';
+      init.body = JSON.stringify(options.body);
+    }
+
+    return fetch(baseUrl + path, init)
+      .then(function (res) {
+        if (!res.ok) throw new Error('Device replied HTTP ' + res.status);
+        var type = res.headers.get('Content-Type') || '';
+        if (type.indexOf('application/json') === -1) return {};
+        return res.json();
+      })
+      .then(function (data) {
+        return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
+      })
+      .catch(function (err) {
+        if (err && err.name === 'AbortError') {
+          throw new Error('Timed out after ' + REQUEST_TIMEOUT_MS / 1000 + 's');
+        }
+        if (err instanceof TypeError) {
+          throw new Error('Could not reach device (offline, blocked by CORS, or local network access denied)');
+        }
+        throw err;
+      })
+      .finally(function () { clearTimeout(timer); });
+  }
+
+  /* ---------- panel controller ---------- */
+
+  function storageGet(key) {
+    try { return localStorage.getItem(STORAGE_PREFIX + key); } catch (e) { return null; }
+  }
+
+  function storageSet(key, value) {
+    try { localStorage.setItem(STORAGE_PREFIX + key, value); } catch (e) { /* ignore */ }
+  }
+
+  function initCard(card) {
+    var kind = card.getAttribute('data-device');
+    var device = DEVICES[kind];
+    if (!device) return;
+
+    var $ = function (role) { return card.querySelector('[data-role="' + role + '"]'); };
+    var form = $('form');
+    var hostInput = form.elements.host;
+    var portInput = form.elements.port;
+    var connectBtn = $('connect');
+    var disconnectBtn = $('disconnect');
+    var statusPill = $('status');
+    var telemetry = $('telemetry');
+    var controls = $('controls');
+    var log = $('log');
+
+    var state = { baseUrl: null, pollTimer: null, session: 0, busy: false };
+
+    var savedHost = storageGet(kind + '.host');
+    var savedPort = storageGet(kind + '.port');
+    if (savedHost && !device.validateHost(savedHost).error) hostInput.value = savedHost;
+    if (savedPort && validatePort(savedPort)) portInput.value = savedPort;
+
+    function addLog(message, level) {
+      var li = document.createElement('li');
+      var time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+      li.textContent = '[' + time + '] ' + message;
+      if (level) li.setAttribute('data-level', level);
+      log.appendChild(li);
+      while (log.children.length > MAX_LOG_LINES) log.removeChild(log.firstChild);
+      log.scrollTop = log.scrollHeight;
+    }
+
+    function setStatus(stateName, text) {
+      statusPill.setAttribute('data-state', stateName);
+      statusPill.textContent = text;
+    }
+
+    function setFormLocked(locked) {
+      hostInput.disabled = locked;
+      portInput.disabled = locked;
+      connectBtn.disabled = locked;
+      disconnectBtn.disabled = !locked;
+    }
+
+    function renderTelemetry(data) {
+      telemetry.textContent = '';
+      device.fields.forEach(function (field) {
+        var wrap = document.createElement('div');
+        var dt = document.createElement('dt');
+        var dd = document.createElement('dd');
+        dt.textContent = field.label;
+        dd.textContent = field.get(data);
+        wrap.appendChild(dt);
+        wrap.appendChild(dd);
+        telemetry.appendChild(wrap);
+      });
+      telemetry.hidden = false;
+    }
+
+    function deviceName(data) {
+      var name = clean(data.name || data.model);
+      return name === '—' ? device.label : name;
+    }
+
+    function stopPolling() {
+      if (state.pollTimer) clearInterval(state.pollTimer);
+      state.pollTimer = null;
+    }
+
+    function disconnect(reason, level) {
+      state.session++;
+      stopPolling();
+      state.baseUrl = null;
+      setFormLocked(false);
+      controls.hidden = true;
+      telemetry.hidden = true;
+      if (level === 'error') setStatus('error', 'Error');
+      else setStatus('idle', 'Disconnected');
+      if (reason) addLog(reason, level);
+    }
+
+    function poll(session) {
+      if (!state.baseUrl || document.hidden) return;
+      request(device, state.baseUrl, '/api/status').then(function (data) {
+        if (session !== state.session) return;
+        renderTelemetry(data);
+      }).catch(function (err) {
+        if (session !== state.session) return;
+        disconnect('Connection lost: ' + err.message, 'error');
+      });
+    }
+
+    function clearFieldErrors() {
+      hostInput.removeAttribute('aria-invalid');
+      portInput.removeAttribute('aria-invalid');
+    }
+
+    hostInput.addEventListener('input', clearFieldErrors);
+    portInput.addEventListener('input', clearFieldErrors);
+
+    form.addEventListener('submit', function (event) {
+      event.preventDefault();
+      clearFieldErrors();
+
+      var hostCheck = device.validateHost(hostInput.value);
+      if (hostCheck.error) {
+        hostInput.setAttribute('aria-invalid', 'true');
+        hostInput.focus();
+        setStatus('error', 'Invalid address');
+        addLog(hostCheck.error, 'error');
+        return;
+      }
+      var port = validatePort(portInput.value);
+      if (!port) {
+        portInput.setAttribute('aria-invalid', 'true');
+        portInput.focus();
+        setStatus('error', 'Invalid port');
+        addLog('Port must be a number between 1 and 65535.', 'error');
+        return;
+      }
+
+      var baseUrl = 'http://' + hostCheck.hostForUrl + ':' + port;
+      var session = ++state.session;
+      setFormLocked(true);
+      disconnectBtn.disabled = false;
+      setStatus('connecting', 'Connecting…');
+      addLog('Connecting to ' + baseUrl + ' …');
+
+      request(device, baseUrl, '/api/status').then(function (data) {
+        if (session !== state.session) return;
+        state.baseUrl = baseUrl;
+        storageSet(kind + '.host', hostInput.value.trim());
+        storageSet(kind + '.port', String(port));
+        setStatus('connected', 'Connected');
+        addLog('Connected to ' + deviceName(data), 'ok');
+        renderTelemetry(data);
+        controls.hidden = false;
+        stopPolling();
+        state.pollTimer = setInterval(function () { poll(session); }, POLL_INTERVAL_MS);
+      }).catch(function (err) {
+        if (session !== state.session) return;
+        disconnect('Connection failed: ' + err.message, 'error');
+      });
+    });
+
+    disconnectBtn.addEventListener('click', function () {
+      disconnect('Disconnected by user.');
+    });
+
+    controls.addEventListener('submit', function (event) {
+      event.preventDefault();
+      if (!state.baseUrl || state.busy) return;
+
+      var session = state.session;
+      var body = device.command.build(controls);
+      var submitBtn = controls.querySelector('button[type="submit"]');
+      state.busy = true;
+      submitBtn.disabled = true;
+      addLog(device.command.describe(body) + ' …');
+
+      request(device, state.baseUrl, device.command.path, { method: 'POST', body: body })
+        .then(function (data) {
+          if (session !== state.session) return;
+          var msg = clean(data.message);
+          addLog(msg === '—' ? 'Command accepted.' : 'Device: ' + msg, 'ok');
+          poll(session);
+        })
+        .catch(function (err) {
+          if (session !== state.session) return;
+          addLog('Command failed: ' + err.message, 'error');
+        })
+        .finally(function () {
+          state.busy = false;
+          submitBtn.disabled = false;
+        });
+    });
+
+    document.addEventListener('visibilitychange', function () {
+      if (!document.hidden && state.baseUrl) poll(state.session);
+    });
+
+    addLog('Ready. Enter the ' + device.label.toLowerCase() + ' address and press Connect.');
+  }
+
+  function init() {
+    var cards = document.querySelectorAll('.equip-card[data-device]');
+    for (var i = 0; i < cards.length; i++) initCard(cards[i]);
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
