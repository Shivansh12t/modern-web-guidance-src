+  <script type="module">
+    // ---- Equipment connection panel (Local Network Access) ----
+    // Assumed device APIs (JSON over HTTP, CORS-enabled for this origin):
+    //   Brewer: GET http://<lan-host>/api/status
+    //   Helper: GET http://127.0.0.1:<port>/v1/status
+
+    const POLL_MS = 5000;
+    const TIMEOUT_MS = 4000;
+    const MAX_FIELDS = 12;
+
+    const DEVICES = {
+      brewer: {
+        permission: 'local-network',
+        addressSpace: 'local',
+        storageKey: 'dg.brewer.host',
+        label: 'brewer',
+        buildUrl(form) {
+          const host = normalizeLanHost(form.elements.host.value);
+          if (!host) return null;
+          return { url: `http://${host}/api/status`, save: host };
+        },
+        invalidMessage: 'Enter a private LAN address such as 192.168.1.50:8080 or brewer.local.',
+        failHelp: 'Make sure the brewer is powered on and that you are on the shop Wi-Fi.',
+      },
+      helper: {
+        permission: 'loopback-network',
+        addressSpace: 'loopback',
+        storageKey: 'dg.helper.port',
+        label: 'brewing helper',
+        buildUrl(form) {
+          const port = Number(form.elements.port.value);
+          if (!Number.isInteger(port) || port < 1024 || port > 65535) return null;
+          return { url: `http://127.0.0.1:${port}/v1/status`, save: String(port) };
+        },
+        invalidMessage: 'Enter a port between 1024 and 65535.',
+        failHelp: 'Make sure the Daily Grind Brewing Helper is running on this computer.',
+      },
+    };
+
+    // Accept only RFC 1918 / link-local IPv4 literals or .local mDNS names, with optional port.
+    function normalizeLanHost(raw) {
+      const value = raw.trim().replace(/^https?:\/\//i, '').replace(/\/.*$/, '').toLowerCase();
+      const m = value.match(/^([a-z0-9.-]+)(?::(\d{1,5}))?$/);
+      if (!m) return null;
+      const [, host, portStr] = m;
+      if (portStr !== undefined) {
+        const port = Number(portStr);
+        if (port < 1 || port > 65535) return null;
+      }
+      const isPrivateIp = (() => {
+        const parts = host.split('.');
+        if (parts.length !== 4 || !parts.every((p) => /^\d{1,3}$/.test(p) && Number(p) <= 255)) return false;
+        const [a, b] = parts.map(Number);
+        return a === 10 || (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168) || (a === 169 && b === 254);
+      })();
+      const isMdns = /^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+local$/.test(host);
+      if (!isPrivateIp && !isMdns) return null;
+      return portStr !== undefined ? `${host}:${portStr}` : host;
+    }
+
+    // Never query the legacy 'local-network-access' name — it can crash older Chrome renderers.
+    async function queryPermission(name) {
+      if (!navigator.permissions?.query) return { state: 'prompt', supported: false };
+      try {
+        const status = await navigator.permissions.query({ name });
+        return { state: status.state, status, supported: true };
+      } catch {
+        return { state: 'prompt', supported: false };
+      }
+    }
+
+    function humanize(key) {
+      return String(key).replace(/[_-]+/g, ' ').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase());
+    }
+
+    function formatValue(v) {
+      if (v === null || v === undefined) return '—';
+      if (typeof v === 'object') return JSON.stringify(v).slice(0, 120);
+      return String(v).slice(0, 120);
+    }
+
+    class DevicePanel {
+      constructor(card, config) {
+        this.card = card;
+        this.cfg = config;
+        this.form = card.querySelector('[data-connect-form]');
+        this.input = this.form.querySelector('input');
+        this.submitBtn = this.form.querySelector('button[type="submit"]');
+        this.permBadge = card.querySelector('[data-permission-status]');
+        this.connBadge = card.querySelector('[data-connection-status]');
+        this.remediation = card.querySelector('[data-remediation]');
+        this.statusEl = card.querySelector('[data-device-status]');
+        this.readout = card.querySelector('[data-readout]');
+        this.disconnectBtn = card.querySelector('[data-disconnect]');
+        this.timer = null;
+        this.target = null;
+        this.controller = null;
+
+        const saved = localStorage.getItem(config.storageKey);
+        if (saved) this.input.value = saved;
+
+        this.form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          this.connect();
+        });
+        this.input.addEventListener('input', () => this.input.setCustomValidity(''));
+        this.disconnectBtn.addEventListener('click', () => this.disconnect('Disconnected.'));
+      }
+
+      async init() {
+        const { state, status, supported } = await queryPermission(this.cfg.permission);
+        this.supported = supported;
+        this.setPermission(state);
+        status?.addEventListener('change', () => {
+          this.setPermission(status.state);
+          if (status.state === 'denied') this.disconnect('Permission was revoked in browser settings.');
+        });
+        // Only auto-connect when access has already been granted; otherwise wait for a click.
+        if (state === 'granted' && localStorage.getItem(this.cfg.storageKey)) this.connect();
+        return supported;
+      }
+
+      setPermission(state) {
+        this.permState = state;
+        const text = { granted: 'Allowed', denied: 'Blocked', prompt: 'Will ask' }[state] ?? state;
+        this.permBadge.textContent = `Permission: ${text}`;
+        this.permBadge.dataset.state = state;
+        this.remediation.hidden = state !== 'denied';
+      }
+
+      setConnection(state, text) {
+        this.connBadge.dataset.state = state;
+        this.connBadge.textContent = text;
+      }
+
+      async connect() {
+        const target = this.cfg.buildUrl(this.form);
+        if (!target) {
+          this.input.setCustomValidity(this.cfg.invalidMessage);
+          this.input.reportValidity();
+          return;
+        }
+        this.stopPolling();
+        this.target = target;
+        this.submitBtn.disabled = true;
+        this.setConnection('connecting', 'Connecting…');
+        this.statusEl.textContent =
+          this.permState === 'prompt' ? 'Your browser may ask for permission — choose Allow to continue.' : '';
+
+        const ok = await this.poll();
+        this.submitBtn.disabled = false;
+        if (ok) {
+          localStorage.setItem(this.cfg.storageKey, target.save);
+          this.disconnectBtn.hidden = false;
+          this.schedule();
+        }
+      }
+
+      schedule() {
+        this.timer = setTimeout(async () => {
+          if (document.hidden) return this.schedule();
+          if (await this.poll()) this.schedule();
+        }, POLL_MS);
+      }
+
+      async poll() {
+        if (!this.target) return false;
+        this.controller?.abort();
+        this.controller = new AbortController();
+        const signal = AbortSignal.any([this.controller.signal, AbortSignal.timeout(TIMEOUT_MS)]);
+        try {
+          const res = await fetch(this.target.url, {
+            method: 'GET',
+            mode: 'cors',
+            credentials: 'omit',
+            cache: 'no-store',
+            // Declares the private target up front: exempts http:// from mixed-content blocking once
+            // permission is granted, and makes the browser abort if DNS resolves to a public IP.
+            targetAddressSpace: this.cfg.addressSpace,
+            signal,
+          });
+          if (!res.ok) throw new Error(`The ${this.cfg.label} responded with HTTP ${res.status}.`);
+          const data = await res.json();
+          this.render(data);
+          this.setConnection('connected', 'Connected');
+          this.statusEl.textContent = `Last updated ${new Date().toLocaleTimeString()}.`;
+          return true;
+        } catch (err) {
+          if (this.controller.signal.aborted) return false; // superseded or disconnected
+          await this.refreshPermission();
+          this.setConnection('error', 'Not connected');
+          this.readout.hidden = true;
+          this.disconnectBtn.hidden = true;
+          if (this.permState === 'denied') {
+            this.statusEl.textContent = 'Your browser blocked the connection. See the steps above to allow it.';
+          } else if (err.name === 'TimeoutError') {
+            this.statusEl.textContent = `The ${this.cfg.label} didn't respond in time. ${this.cfg.failHelp}`;
+          } else if (err instanceof SyntaxError) {
+            this.statusEl.textContent = `The ${this.cfg.label} sent an unexpected response.`;
+          } else if (err instanceof TypeError) {
+            this.statusEl.textContent = `Couldn't reach the ${this.cfg.label}. ${this.cfg.failHelp}`;
+          } else {
+            this.statusEl.textContent = err.message;
+          }
+          this.target = null;
+          return false;
+        }
+      }
+
+      async refreshPermission() {
+        if (!this.supported) return;
+        const { state } = await queryPermission(this.cfg.permission);
+        this.setPermission(state);
+      }
+
+      // Device data is untrusted: render with textContent only, and cap the number of fields.
+      render(data) {
+        const entries = data && typeof data === 'object' && !Array.isArray(data)
+          ? Object.entries(data).slice(0, MAX_FIELDS)
+          : [['Response', data]];
+        const frag = document.createDocumentFragment();
+        for (const [k, v] of entries) {
+          const dt = document.createElement('dt');
+          dt.textContent = humanize(k);
+          const dd = document.createElement('dd');
+          dd.textContent = formatValue(v);
+          frag.append(dt, dd);
+        }
+        this.readout.replaceChildren(frag);
+        this.readout.hidden = false;
+      }
+
+      stopPolling() {
+        clearTimeout(this.timer);
+        this.timer = null;
+        this.controller?.abort();
+      }
+
+      disconnect(message) {
+        this.stopPolling();
+        this.target = null;
+        this.setConnection('idle', 'Not connected');
+        this.readout.hidden = true;
+        this.disconnectBtn.hidden = true;
+        this.submitBtn.disabled = false;
+        if (message) this.statusEl.textContent = message;
+      }
+    }
+
+    document.getElementById('lna-insecure').hidden = window.isSecureContext;
+
+    const panels = [...document.querySelectorAll('[data-device]')].map(
+      (card) => new DevicePanel(card, DEVICES[card.dataset.device]),
+    );
+    const support = await Promise.all(panels.map((p) => p.init()));
+    document.getElementById('lna-unsupported').hidden = support.every(Boolean);
+  </script>
+
 </body>
 
