@@ -0,0 +1,23 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Developer Diagnostics</h1>
+    <DiagnosticsConnect client:only="react" />
+    <div class="prose prose-sm max-w-none mt-8 text-gray-600">
+      <h2>How it works</h2>
+      <p>
+        Your browser connects directly to the addresses you enter. In Chromium-based browsers, you'll be asked
+        once for <strong>Local network</strong> access (for the test device) and <strong>Loopback network</strong>
+        access (for the companion CLI). You can change either choice later in this site's settings.
+      </p>
+      <p>
+        Both endpoints must reply with an <code>Access-Control-Allow-Origin</code> header that allows this site so
+        the browser can read the response.
+      </p>
+    </div>
+  </div>
+</Layout>
