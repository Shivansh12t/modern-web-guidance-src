@@ -0,0 +1,15 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 pb-2 border-b-2">Developer Diagnostics</h1>
+    <p class="text-gray-600 mb-8">
+      Check connectivity between your browser, a hardware test device on your local network, and the
+      DevTools Times companion CLI running on your machine.
+    </p>
+    <DiagnosticsConnect client:load />
+  </div>
+</Layout>
