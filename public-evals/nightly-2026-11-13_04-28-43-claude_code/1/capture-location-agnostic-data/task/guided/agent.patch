+  <script type="module">
+    // Pickup time and anniversary are location-agnostic values: stored and shown
+    // as Temporal.PlainTime / Temporal.PlainDate (no time zone, no Date instants),
+    // so travelling never shifts them.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrind.prefs';
+    const form = document.getElementById('prefs-form');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary-date');
+    const summary = document.getElementById('prefs-summary');
+
+    function load() {
+      try {
+        const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
+        return {
+          pickup: raw.pickupTime ? Temporal.PlainTime.from(raw.pickupTime) : null,
+          anniversary: raw.anniversaryDate ? Temporal.PlainDate.from(raw.anniversaryDate) : null,
+        };
+      } catch {
+        return { pickup: null, anniversary: null };
+      }
+    }
+
+    function nextAnniversary(anniversary) {
+      const today = Temporal.Now.plainDateISO();
+      const monthDay = anniversary.toPlainMonthDay();
+      // toPlainDate constrains Feb 29 to Feb 28 in non-leap years.
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+      return { next, days: today.until(next, { largestUnit: 'day' }).days };
+    }
+
+    function render({ pickup, anniversary }) {
+      const parts = [];
+      if (pickup) {
+        parts.push(`Pickup reminder: every day at ${pickup.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' })}.`);
+      }
+      if (anniversary) {
+        const { days } = nextAnniversary(anniversary);
+        const when = days === 0 ? 'Happy coffee anniversary! 🎉'
+          : `${days} day${days === 1 ? '' : 's'} to go.`;
+        parts.push(`Coffee anniversary: ${anniversary.toLocaleString(undefined, { dateStyle: 'long' })}. ${when}`);
+      }
+      summary.textContent = parts.join(' ');
+    }
+
+    const prefs = load();
+    if (prefs.pickup) timeInput.value = prefs.pickup.toString({ smallestUnit: 'minute' });
+    if (prefs.anniversary) dateInput.value = prefs.anniversary.toString();
+    render(prefs);
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      // Input values are already zone-free ISO strings ("HH:MM", "YYYY-MM-DD");
+      // parse them straight into Plain types, never through new Date().
+      const next = {
+        pickup: timeInput.value ? Temporal.PlainTime.from(timeInput.value) : null,
+        anniversary: dateInput.value ? Temporal.PlainDate.from(dateInput.value) : null,
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify({
+        pickupTime: next.pickup?.toString({ smallestUnit: 'minute' }) ?? null,
+        anniversaryDate: next.anniversary?.toString() ?? null,
+      }));
+      render(next);
+    });
+  </script>
+
