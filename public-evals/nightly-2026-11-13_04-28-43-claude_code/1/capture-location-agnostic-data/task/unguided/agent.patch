+  <script>
+    /*
+     * Location-agnostic ("floating") time & date handling.
+     *
+     * The pickup time ("HH:MM") and anniversary date ("YYYY-MM-DD") are stored as
+     * plain strings exactly as the inputs report them. They are never converted to
+     * timestamps, never passed through `new Date("YYYY-MM-DD")` (which parses as UTC),
+     * and never read via valueAsDate/valueAsNumber (also UTC-based). Display formatting
+     * is done from the raw components, so the value is identical in every time zone.
+     */
+    (function () {
+      const STORAGE_KEY = 'dailyGrind.prefs';
+      const TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      const DATE_RE = /^(\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+      const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      const timeInput = document.getElementById('pickup-time');
+      const dateInput = document.getElementById('anniversary-date');
+      const timeDisplay = document.getElementById('pickup-time-display');
+      const dateDisplay = document.getElementById('anniversary-display');
+
+      function isValidDate(value) {
+        const m = DATE_RE.exec(value);
+        if (!m) return false;
+        const y = +m[1], mo = +m[2], d = +m[3];
+        return d <= daysInMonth(y, mo);
+      }
+
+      function daysInMonth(year, month) {
+        // Pure calendar math in UTC: no local offset can affect it.
+        return new Date(Date.UTC(year, month, 0)).getUTCDate();
+      }
+
+      function load() {
+        try {
+          const data = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
+          return {
+            pickupTime: TIME_RE.test(data.pickupTime) ? data.pickupTime : '',
+            anniversaryDate: isValidDate(data.anniversaryDate) ? data.anniversaryDate : ''
+          };
+        } catch (e) {
+          return { pickupTime: '', anniversaryDate: '' };
+        }
+      }
+
+      function save(prefs) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+        } catch (e) { /* storage unavailable; ignore */ }
+      }
+
+      function formatTime(value) {
+        const m = TIME_RE.exec(value);
+        if (!m) return '';
+        const h = +m[1];
+        const suffix = h < 12 ? 'AM' : 'PM';
+        const h12 = h % 12 === 0 ? 12 : h % 12;
+        return h12 + ':' + m[2] + ' ' + suffix;
+      }
+
+      function formatDate(value) {
+        const m = DATE_RE.exec(value);
+        if (!m) return '';
+        return MONTHS[+m[2] - 1] + ' ' + (+m[3]) + ', ' + m[1];
+      }
+
+      // Today's calendar date wherever the user currently is.
+      function todayParts() {
+        const now = new Date();
+        return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
+      }
+
+      // Whole-day difference between two calendar dates, computed in UTC so DST is irrelevant.
+      function dayDiff(a, b) {
+        return Math.round((Date.UTC(b.y, b.m - 1, b.d) - Date.UTC(a.y, a.m - 1, a.d)) / 86400000);
+      }
+
+      function anniversaryInfo(value) {
+        const m = DATE_RE.exec(value);
+        if (!m) return '';
+        const start = { y: +m[1], m: +m[2], d: +m[3] };
+        const today = todayParts();
+        if (dayDiff(start, today) < 0) return 'Your coffee journey begins soon!';
+
+        // Feb 29 anniversaries fall on Feb 28 in non-leap years.
+        const onYear = (y) => ({ y, m: start.m, d: Math.min(start.d, daysInMonth(y, start.m)) });
+        let next = onYear(today.y);
+        if (dayDiff(today, next) < 0) next = onYear(today.y + 1);
+        const days = dayDiff(today, next);
+        const years = next.y - start.y;
+
+        if (days === 0) {
+          return years > 0
+            ? 'Happy ' + years + '-year coffee anniversary! ☕'
+            : 'Your coffee journey starts today! ☕';
+        }
+        return days + ' day' + (days === 1 ? '' : 's') + ' until your ' +
+          years + '-year coffee anniversary.';
+      }
+
+      function render(prefs) {
+        timeDisplay.textContent = prefs.pickupTime
+          ? 'We\'ll remind you every day at ' + formatTime(prefs.pickupTime) + ' (your local time, wherever you are).'
+          : '';
+        dateDisplay.textContent = prefs.anniversaryDate
+          ? formatDate(prefs.anniversaryDate) + ' — ' + anniversaryInfo(prefs.anniversaryDate)
+          : '';
+      }
+
+      const prefs = load();
+      timeInput.value = prefs.pickupTime;
+      dateInput.value = prefs.anniversaryDate;
+      render(prefs);
+
+      timeInput.addEventListener('change', function () {
+        // Read the raw string; some browsers append seconds ("HH:MM:SS"), trim to HH:MM.
+        const v = timeInput.value.slice(0, 5);
+        prefs.pickupTime = TIME_RE.test(v) ? v : '';
+        save(prefs);
+        render(prefs);
+      });
+
+      dateInput.addEventListener('change', function () {
+        const v = dateInput.value;
+        prefs.anniversaryDate = isValidDate(v) ? v : '';
+        save(prefs);
+        render(prefs);
+      });
+    })();
+  </script>
+
