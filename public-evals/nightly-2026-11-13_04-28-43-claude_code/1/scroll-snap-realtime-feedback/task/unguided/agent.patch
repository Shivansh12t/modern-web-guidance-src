+  <script>
+    (function () {
+      const track = document.getElementById('gallery');
+      if (!track) return;
+      const slides = Array.from(track.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.gallery-thumb'));
+      if (!slides.length) return;
+
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const nativeSnapEvents = 'onscrollsnapchanging' in window && 'onscrollsnapchange' in window;
+      const hasScrollEnd = 'onscrollend' in window;
+      track.dataset.snapMode = nativeSnapEvents ? 'native' : 'fallback';
+
+      let activeIndex = 0;
+      let pendingIndex = -1;
+      let settleTimer = 0;
+
+      function clamp(i) {
+        return Math.max(0, Math.min(slides.length - 1, i));
+      }
+
+      // Index of the slide whose center is closest to the scroller's center.
+      function nearestIndex() {
+        const center = track.scrollLeft + track.clientWidth / 2;
+        let best = 0;
+        let bestDist = Infinity;
+        slides.forEach(function (slide, i) {
+          const d = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
+          if (d < bestDist) { bestDist = d; best = i; }
+        });
+        return best;
+      }
+
+      function setPending(i) {
+        i = i < 0 ? -1 : clamp(i);
+        // A pending marker on the already-active slide adds no information.
+        if (i === activeIndex) i = -1;
+        if (i === pendingIndex) return;
+        pendingIndex = i;
+        thumbs.forEach(function (t, n) { t.classList.toggle('pending', n === i); });
+      }
+
+      function setActive(i) {
+        i = clamp(i);
+        activeIndex = i;
+        setPending(-1);
+        thumbs.forEach(function (t, n) {
+          const on = n === i;
+          t.classList.toggle('active', on);
+          if (on) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+        slides.forEach(function (s, n) { s.classList.toggle('active', n === i); });
+      }
+
+      function goTo(i) {
+        i = clamp(i);
+        const slide = slides[i];
+        const left = slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2;
+        setPending(i);
+        track.scrollTo({ left: left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        // If no scroll is needed (already in place), settle immediately.
+        if (Math.abs(track.scrollLeft - left) < 1) settle();
+      }
+
+      function settle() {
+        clearTimeout(settleTimer);
+        setActive(nearestIndex());
+      }
+
+      if (nativeSnapEvents) {
+        // Native: preview target while scrolling, promote when the snap is committed.
+        track.addEventListener('scrollsnapchanging', function (e) {
+          const idx = slides.indexOf(e.snapTargetInline);
+          if (idx !== -1) setPending(idx);
+        });
+        track.addEventListener('scrollsnapchange', function (e) {
+          const idx = slides.indexOf(e.snapTargetInline);
+          setActive(idx !== -1 ? idx : nearestIndex());
+        });
+        // Safety net: if a scroll ends without a snapchange (e.g. snapped back to the
+        // same slide), make sure no stale pending marker is left behind.
+        if (hasScrollEnd) {
+          track.addEventListener('scrollend', function () {
+            if (pendingIndex !== -1) settle();
+          });
+        }
+      } else {
+        // Fallback: derive the likely snap target from scroll position mid-scroll,
+        // then promote once scrolling settles (scrollend, or a debounce timer).
+        track.addEventListener('scroll', function () {
+          setPending(nearestIndex());
+          if (!hasScrollEnd) {
+            clearTimeout(settleTimer);
+            settleTimer = setTimeout(settle, 150);
+          }
+        }, { passive: true });
+        if (hasScrollEnd) track.addEventListener('scrollend', settle);
+      }
+
+      thumbs.forEach(function (thumb) {
+        thumb.addEventListener('click', function () {
+          goTo(Number(thumb.dataset.index));
+        });
+      });
+
+      track.addEventListener('keydown', function (e) {
+        let target = null;
+        if (e.key === 'ArrowRight') target = activeIndex + 1;
+        else if (e.key === 'ArrowLeft') target = activeIndex - 1;
+        else if (e.key === 'Home') target = 0;
+        else if (e.key === 'End') target = slides.length - 1;
+        if (target === null) return;
+        e.preventDefault();
+        goTo(target);
+      });
+
+      // Keep the active slide aligned when the layout width changes.
+      let resizeTimer = 0;
+      window.addEventListener('resize', function () {
+        clearTimeout(resizeTimer);
+        resizeTimer = setTimeout(function () {
+          const slide = slides[activeIndex];
+          track.scrollTo({ left: slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2, behavior: 'auto' });
+        }, 100);
+      });
+
+      setActive(nearestIndex());
+    })();
+  </script>
