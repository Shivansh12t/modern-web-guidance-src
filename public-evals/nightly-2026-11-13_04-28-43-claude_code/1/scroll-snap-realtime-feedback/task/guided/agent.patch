+  <script>
+    (() => {
+      const container = document.getElementById('gallery');
+      const items = [...container.querySelectorAll('.gallery-item')];
+      const thumbsGroup = document.querySelector('.gallery-thumbs');
+      const thumbnails = [...thumbsGroup.querySelectorAll('.gallery-thumb')];
+
+      const setPending = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+        // Already active: nothing to preview
+        if (!thumbnails[index].classList.contains('active')) {
+          thumbnails[index].classList.add('pending');
+        }
+      };
+
+      const setActive = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => {
+          thumb.classList.remove('pending', 'active');
+          thumb.removeAttribute('aria-current');
+        });
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+      };
+
+      // Geometric lookup (items use scroll-snap-align: center; container is offsetParent)
+      const findClosestItemIndex = () => {
+        const containerCenter = container.scrollLeft + container.clientWidth / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+        items.forEach((item, index) => {
+          const distance = Math.abs(containerCenter - (item.offsetLeft + item.offsetWidth / 2));
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+        return closestIndex;
+      };
+
+      // Thumbnail click scrolls the matching slide into view
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          items[index].scrollIntoView({ block: 'nearest', inline: 'center' });
+        });
+      });
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        // Native scroll snap events: preview mid-scroll, promote on settle
+        container.addEventListener('scrollsnapchanging', (event) => {
+          setPending(items.indexOf(event.snapTargetInline));
+        });
+        container.addEventListener('scrollsnapchange', (event) => {
+          setActive(items.indexOf(event.snapTargetInline));
+        });
+      } else {
+        // Fallback: scroll + rAF geometric detection, promote on scrollend / debounce
+        let scrollTimeout;
+        let rafId = null;
+        const promote = () => setActive(findClosestItemIndex());
+
+        container.addEventListener('scroll', () => {
+          if (rafId === null) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              setPending(findClosestItemIndex());
+            });
+          }
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(promote, 100);
+        }, { passive: true });
+
+        container.addEventListener('scrollend', () => {
+          clearTimeout(scrollTimeout);
+          promote();
+        });
+      }
+
+      // Sync with any restored scroll position
+      const initActiveItem = () => setActive(findClosestItemIndex());
+      if (document.readyState === 'complete') {
+        initActiveItem();
+      } else {
+        window.addEventListener('load', initActiveItem, { once: true });
+      }
+
+      // Roving tabindex fallback where native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        thumbsGroup.setAttribute('role', 'toolbar');
+
+        const syncTabIndex = () => {
+          let current = thumbnails.indexOf(document.activeElement);
+          if (current < 0) {
+            current = thumbnails.findIndex((t) => t.getAttribute('aria-current') === 'true');
+          }
+          thumbnails.forEach((thumb, index) => {
+            thumb.tabIndex = index === Math.max(current, 0) ? 0 : -1;
+          });
+        };
+
+        thumbsGroup.addEventListener('focusin', syncTabIndex);
+        thumbsGroup.addEventListener('focusout', (event) => {
+          if (!thumbsGroup.contains(event.relatedTarget)) {
+            // Next Tab into the group lands on the current slide's thumbnail
+            requestAnimationFrame(syncTabIndex);
+          }
+        });
+        thumbsGroup.addEventListener('keydown', (event) => {
+          if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
+          const current = thumbnails.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = (current + (event.key === 'ArrowLeft' ? -1 : 1) + thumbnails.length) % thumbnails.length;
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          thumbnails.forEach((thumb, index) => {
+            thumb.tabIndex = index === next ? 0 : -1;
+          });
+          thumbnails[next].focus({ preventScroll: true });
+        }, true);
+
+        syncTabIndex();
+      }
+    })();
+  </script>
+
