   </footer>
 
+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackInput = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const feedbackButton = feedbackForm.querySelector('button[type="submit"]');
+
+    feedbackInput.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        // Don't submit while an IME is composing (keyCode 229 covers Safari's event-order bug).
+        if (event.isComposing || event.keyCode === 229) return;
+        feedbackForm.requestSubmit(); // runs native validation, then fires submit
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!feedbackInput.value.trim()) {
+        feedbackStatus.textContent = 'Please enter some feedback before sending.';
+        feedbackInput.focus();
+        return;
+      }
+      feedbackButton.disabled = true;
+      feedbackStatus.textContent = 'Sending…';
+      try {
+        const res = await fetch(feedbackForm.action, {
+          method: 'POST',
+          body: new FormData(feedbackForm),
+        });
+        if (!res.ok) throw new Error(res.statusText);
+        feedbackForm.reset();
+        feedbackStatus.textContent = 'Thanks! Your feedback has been sent.';
+      } catch {
+        feedbackStatus.textContent = 'Sorry, we couldn\'t send your feedback. Please try again.';
+      } finally {
+        feedbackButton.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
