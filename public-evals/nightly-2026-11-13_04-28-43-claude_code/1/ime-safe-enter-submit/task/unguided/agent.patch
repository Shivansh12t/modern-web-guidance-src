+  <section class="feedback" aria-labelledby="feedback-title">
+    <h2 id="feedback-title">Share Your Feedback</h2>
+    <form id="feedback-form" action="/feedback" method="post">
+      <label for="feedback-message" class="hint">Press Enter to send, Shift+Enter for a new line.</label>
+      <textarea id="feedback-message" name="message" required maxlength="2000"
+        placeholder="Tell us what you think..."></textarea>
+      <button type="submit" class="btn">Send</button>
+      <p class="feedback-status" role="status" aria-live="polite"></p>
+    </form>
+  </section>
