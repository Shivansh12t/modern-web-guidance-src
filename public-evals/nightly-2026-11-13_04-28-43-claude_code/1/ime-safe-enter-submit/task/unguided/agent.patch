@@ -206,7 +274,52 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const button = form.querySelector('button[type="submit"]');
+      const status = form.querySelector('.feedback-status');
+
+      // Enter sends; Shift+Enter inserts a newline. Ignore Enter while an IME is composing.
+      textarea.addEventListener('keydown', function (e) {
+        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) {
+          e.preventDefault();
+          form.requestSubmit();
+        }
+      });
+
+      form.addEventListener('submit', async function (e) {
+        e.preventDefault();
+        const message = textarea.value.trim();
+        if (!message) {
+          status.textContent = 'Please enter some feedback before sending.';
+          textarea.focus();
+          return;
+        }
+        if (button.disabled) return;
+
+        button.disabled = true;
+        status.textContent = 'Sending...';
+        try {
+          const res = await fetch(form.action, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ message: message })
+          });
+          if (!res.ok) throw new Error('Request failed: ' + res.status);
+          form.reset();
+          status.textContent = 'Thanks for your feedback!';
+        } catch (err) {
+          status.textContent = 'Sorry, we couldn\'t send your feedback. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
