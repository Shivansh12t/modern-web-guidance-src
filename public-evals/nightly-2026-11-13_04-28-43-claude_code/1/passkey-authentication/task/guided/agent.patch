+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs"
+      },
+      "integrity": {
+        "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs": "sha384-EBLK1vCYl7ILfHGSetlZN/n8TaV5nbYKx9JrMwcJvy5NTITz1Q9HDYqCG4NxzuR0"
+      }
+    }
+  </script>
+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const button = document.getElementById('auth-button');
+    const statusEl = document.getElementById('auth-status');
+
+    let autofillController = null;
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function ensureWebAuthn() {
+      if (!window.PublicKeyCredential) return false;
+      // Polyfill getClientCapabilities / parseRequestOptionsFromJSON / toJSON where missing.
+      if (
+        typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+        typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        try {
+          await import('webauthn-polyfills');
+        } catch (err) {
+          console.error('Failed to load WebAuthn polyfills:', err);
+          return false;
+        }
+      }
+      return true;
+    }
+
+    async function fetchRequestOptions() {
+      const res = await fetch('/api/login/options', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { Accept: 'application/json' },
+      });
+      if (!res.ok) throw new Error(`Failed to fetch sign-in options (${res.status})`);
+      const json = await res.json();
+      // Accept either the options object directly or wrapped as { publicKey: {...} }.
+      return PublicKeyCredential.parseRequestOptionsFromJSON(json.publicKey ?? json);
+    }
+
+    async function verifyCredential(credential, publicKey) {
+      const encoded = credential.toJSON();
+      let res;
+      try {
+        res = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.', 'error');
+        return false;
+      }
+
+      if (res.ok) {
+        let data = {};
+        try { data = await res.json(); } catch { /* empty body is fine */ }
+        const name = data.username ?? data.user?.name ?? data.user?.username;
+        setStatus(name ? `Signed in as ${name}` : 'Signed in successfully', 'success');
+        return true;
+      }
+
+      if (res.status === 404) {
+        setStatus('This passkey is no longer registered. Please use another sign-in method.', 'error');
+        // Pre-authentication path: let the passkey provider drop the stale credential.
+        if (PublicKeyCredential.signalUnknownCredential && publicKey.rpId) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          } catch (err) {
+            console.warn('signalUnknownCredential failed:', err);
+          }
+        }
+      } else {
+        setStatus('Sign-in failed. Please try again.', 'error');
+      }
+      return false;
+    }
+
+    async function startConditionalAutofill() {
+      if (!(await ensureWebAuthn())) return;
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet !== true) return;
+
+      autofillController?.abort();
+      const controller = new AbortController();
+      autofillController = controller;
+
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: controller.signal,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError' || err.name === 'AbortError') return;
+        console.error('Conditional passkey request failed:', err);
+        return;
+      }
+      if (!credential) return;
+
+      setStatus('Verifying…');
+      const ok = await verifyCredential(credential, publicKey);
+      if (!ok) startConditionalAutofill();
+    }
+
+    async function signInWithButton() {
+      // Abort pending autofill request so the modal prompt doesn't collide with it.
+      autofillController?.abort();
+      autofillController = null;
+
+      if (!(await ensureWebAuthn())) {
+        setStatus('Passkeys are not supported in this browser.', 'error');
+        return;
+      }
+
+      button.disabled = true;
+      setStatus('');
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchRequestOptions();
+        credential = await navigator.credentials.get({ publicKey });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.', 'error');
+        } else if (err.name !== 'AbortError') {
+          console.error('Passkey sign-in failed:', err);
+          setStatus('Passkey sign-in failed. Please try again.', 'error');
+        }
+        button.disabled = false;
+        startConditionalAutofill(); // Re-arm autofill suggestions.
+        return;
+      }
+
+      setStatus('Verifying…');
+      const ok = await verifyCredential(credential, publicKey);
+      button.disabled = false;
+      if (!ok) startConditionalAutofill();
+    }
+
+    button.addEventListener('click', signInWithButton);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      signInWithButton();
+    });
+
+    startConditionalAutofill();
+  </script>
+
 </body>
 
