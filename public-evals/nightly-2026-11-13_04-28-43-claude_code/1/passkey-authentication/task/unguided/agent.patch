+  <script>
+    (function () {
+      'use strict';
+
+      var usernameField = document.querySelector('[data-testid="username-field"]');
+      var authButton = document.querySelector('[data-testid="auth-button"]');
+      var authStatus = document.querySelector('[data-testid="auth-status"]');
+      var form = document.getElementById('signin-form');
+
+      var conditionalAbort = null;   // AbortController for the pending autofill request
+      var conditionalPending = false;
+      var busy = false;
+
+      // ---------- base64url helpers ----------
+      function b64urlToBuffer(value) {
+        if (value instanceof ArrayBuffer) return value;
+        if (ArrayBuffer.isView(value)) return value.buffer;
+        var b64 = String(value).replace(/-/g, '+').replace(/_/g, '/');
+        while (b64.length % 4) b64 += '=';
+        var bin = atob(b64);
+        var bytes = new Uint8Array(bin.length);
+        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buf) {
+        if (!buf) return null;
+        var bytes = new Uint8Array(buf);
+        var bin = '';
+        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function setStatus(message, type) {
+        authStatus.textContent = message;
+        authStatus.className = 'auth-status' + (type ? ' ' + type : '');
+      }
+
+      // ---------- request options ----------
+      function toRequestOptions(json) {
+        var opts = json && json.publicKey ? json.publicKey : json;
+        if (!opts || !opts.challenge) throw new Error('Invalid authentication options from server.');
+        if (window.PublicKeyCredential &&
+            typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          try { return PublicKeyCredential.parseRequestOptionsFromJSON(opts); } catch (e) { /* fall back */ }
+        }
+        var out = Object.assign({}, opts);
+        out.challenge = b64urlToBuffer(opts.challenge);
+        if (Array.isArray(opts.allowCredentials)) {
+          out.allowCredentials = opts.allowCredentials.map(function (c) {
+            return Object.assign({}, c, { id: b64urlToBuffer(c.id) });
+          });
+        }
+        return out;
+      }
+
+      function fetchOptions() {
+        return fetch('/api/login/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify({ username: usernameField.value.trim() || undefined })
+        }).then(function (res) {
+          if (!res.ok) throw new Error('Could not start sign-in (' + res.status + ').');
+          return res.json();
+        }).then(toRequestOptions);
+      }
+
+      // ---------- credential serialisation ----------
+      function credentialToJSON(cred) {
+        if (typeof cred.toJSON === 'function') {
+          try { return cred.toJSON(); } catch (e) { /* fall back */ }
+        }
+        var r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null
+          }
+        };
+      }
+
+      function verify(cred) {
+        setStatus('Verifying…');
+        return fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(credentialToJSON(cred))
+        }).then(function (res) {
+          return res.json().catch(function () { return {}; }).then(function (data) {
+            if (!res.ok || data.verified === false || data.success === false) {
+              throw new Error(data.error || data.message || 'Passkey verification failed.');
+            }
+            var name = data.username || (data.user && (data.user.username || data.user.name)) || '';
+            setStatus(name ? 'Signed in as ' + name + '.' : 'Signed in successfully.', 'success');
+            return data;
+          });
+        });
+      }
+
+      function isAbort(err) {
+        return err && (err.name === 'AbortError' || err === 'superseded');
+      }
+
+      function describeError(err) {
+        if (err && err.name === 'NotAllowedError') return 'Sign-in was cancelled or timed out.';
+        if (err && err.name === 'SecurityError') return 'Passkeys are not allowed on this site.';
+        return (err && err.message) || 'Sign-in failed.';
+      }
+
+      // ---------- conditional UI (autofill) ----------
+      function cancelConditional() {
+        if (conditionalAbort) {
+          conditionalAbort.abort('superseded');
+          conditionalAbort = null;
+        }
+        conditionalPending = false;
+      }
+
+      function startConditional() {
+        if (conditionalPending || busy) return;
+        if (!window.PublicKeyCredential ||
+            typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+        conditionalPending = true;
+
+        PublicKeyCredential.isConditionalMediationAvailable().then(function (available) {
+          if (!available) { conditionalPending = false; return; }
+          return fetchOptions().then(function (publicKey) {
+            if (!conditionalPending || busy) return;
+            var controller = new AbortController();
+            conditionalAbort = controller;
+            return navigator.credentials.get({
+              mediation: 'conditional',
+              publicKey: publicKey,
+              signal: controller.signal
+            }).then(function (cred) {
+              if (conditionalAbort === controller) conditionalAbort = null;
+              conditionalPending = false;
+              if (!cred) return;
+              busy = true;
+              authButton.disabled = true;
+              return verify(cred).finally(function () {
+                busy = false;
+                authButton.disabled = false;
+              });
+            });
+          });
+        }).catch(function (err) {
+          conditionalPending = false;
+          conditionalAbort = null;
+          if (isAbort(err)) return;
+          setStatus(describeError(err), 'error');
+          // Re-arm autofill so the user can try again.
+          setTimeout(startConditional, 0);
+        });
+      }
+
+      // ---------- modal (button) flow ----------
+      function signInWithButton(event) {
+        if (event) event.preventDefault();
+        if (busy) return;
+        if (!window.PublicKeyCredential || !navigator.credentials) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+        cancelConditional();
+        busy = true;
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+
+        fetchOptions().then(function (publicKey) {
+          return navigator.credentials.get({ publicKey: publicKey });
+        }).then(function (cred) {
+          if (!cred) throw new Error('No passkey was selected.');
+          return verify(cred);
+        }).catch(function (err) {
+          setStatus(describeError(err), 'error');
+        }).finally(function () {
+          busy = false;
+          authButton.disabled = false;
+          startConditional();
+        });
+      }
+
+      form.addEventListener('submit', signInWithButton);
+      usernameField.addEventListener('focus', startConditional);
+      startConditional();
+    })();
+  </script>
+
 </body>
 
