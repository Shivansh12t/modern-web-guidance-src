+  <script>
+    (() => {
+      const supportsUntilFound = 'onbeforematch' in HTMLElement.prototype;
+
+      /* ---------- Wholesale / Catering tabs ---------- */
+      const services = document.querySelector('.services');
+      const tablist = services.querySelector('[role="tablist"]');
+      const tabs = [...services.querySelectorAll('.wholesale-tab')];
+      const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')));
+
+      if (supportsUntilFound) {
+        const selectTab = (tab, { focus = false } = {}) => {
+          tabs.forEach((t, i) => {
+            const selected = t === tab;
+            t.setAttribute('aria-selected', String(selected));
+            t.tabIndex = selected ? 0 : -1;
+            if (selected) panels[i].removeAttribute('hidden');
+            else panels[i].hidden = 'until-found';
+          });
+          if (focus) tab.focus();
+        };
+
+        tabs.forEach((tab) => tab.addEventListener('click', () => selectTab(tab)));
+
+        tablist.addEventListener('keydown', (e) => {
+          const i = tabs.indexOf(document.activeElement);
+          if (i < 0) return;
+          let next;
+          if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
+          else if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
+          else if (e.key === 'Home') next = tabs[0];
+          else if (e.key === 'End') next = tabs[tabs.length - 1];
+          if (!next) return;
+          e.preventDefault();
+          selectTab(next, { focus: true });
+        });
+
+        // Find-in-page / text-fragment match inside a hidden panel: switch tabs.
+        services.addEventListener('beforematch', (e) => {
+          const i = panels.indexOf(e.target.closest('.tab-panel'));
+          if (i >= 0) selectTab(tabs[i]);
+        });
+      } else {
+        // Fallback: show every panel linearly; tabs become jump links.
+        services.classList.add('is-linear');
+        tablist.removeAttribute('role');
+        tabs.forEach((tab, i) => {
+          tab.removeAttribute('role');
+          tab.removeAttribute('aria-selected');
+          tab.removeAttribute('tabindex');
+          panels[i].removeAttribute('hidden');
+          panels[i].setAttribute('role', 'region');
+          tab.addEventListener('click', () => panels[i].scrollIntoView({ behavior: 'smooth', block: 'start' }));
+        });
+      }
+
+      /* ---------- Reveal coupon ---------- */
+      const couponBtn = document.querySelector('.coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      const setCoupon = (open) => {
+        couponBtn.setAttribute('aria-expanded', String(open));
+        couponBtn.textContent = open ? 'Hide Coupon' : 'Reveal Coupon';
+        if (open) couponPanel.removeAttribute('hidden');
+        else couponPanel.hidden = supportsUntilFound ? 'until-found' : true;
+      };
+
+      couponBtn.addEventListener('click', () => {
+        setCoupon(couponBtn.getAttribute('aria-expanded') !== 'true');
+      });
+
+      // Browser reveals the panel on a search match; keep the button in sync.
+      couponPanel.addEventListener('beforematch', () => setCoupon(true));
+
+      if (!supportsUntilFound) setCoupon(true); // keep contents findable
+    })();
+  </script>
 </body>
 
