+// Daily Grind — digital signing & verification for receipts and gift vouchers.
+//
+// Signs with post-quantum ML-DSA-65 (FIPS 204) when the browser supports it,
+// falling back to Ed25519, then ECDSA P-256/SHA-256 for older browsers.
+// The store's private key is generated non-extractable and persisted in
+// IndexedDB, so it never leaves this browser as raw bytes.
+
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+const ENVELOPE_VERSION = 1;
+const CONTEXTS = {
+  receipt: 'daily-grind/receipt/v1',
+  voucher: 'daily-grind/voucher/v1',
+};
+
+// Every suite the verifier accepts. Anything else is rejected outright.
+const SUITES = {
+  'ML-DSA-65': {
+    keyFormat: 'raw-public',
+    importAlg: 'ML-DSA-65',
+    publicKeyLength: 1952,
+    nativeContext: true,
+  },
+  Ed25519: {
+    keyFormat: 'raw',
+    importAlg: 'Ed25519',
+    publicKeyLength: 32,
+    signAlg: 'Ed25519',
+  },
+  'ECDSA-P256': {
+    keyFormat: 'raw',
+    importAlg: { name: 'ECDSA', namedCurve: 'P-256' },
+    publicKeyLength: 65,
+    signAlg: { name: 'ECDSA', hash: 'SHA-256' },
+  },
+};
+
+/* ---------- encoding helpers ---------- */
+
+function toBase64Url(bytes) {
+  if (typeof bytes.toBase64 === 'function') {
+    return bytes.toBase64({ alphabet: 'base64url', omitPadding: true });
+  }
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function fromBase64Url(str) {
+  if (typeof str !== 'string') throw new TypeError('Expected base64url string');
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(str, { alphabet: 'base64url' });
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+}
+
+async function fingerprint(publicKeyBytes) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKeyBytes));
+  return Array.from(digest.subarray(0, 16), (b) => b.toString(16).padStart(2, '0'))
+    .join('')
+    .match(/.{4}/g)
+    .join(':')
+    .toUpperCase();
+}
+
+/* ---------- algorithm selection ---------- */
+
+function supportsMlDsa() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', 'ML-DSA-65') &&
+    SubtleCrypto.supports('generateKey', 'ML-DSA-65')
+  );
+}
+
+async function generateKeyPair() {
+  if (supportsMlDsa()) {
+    try {
+      const keyPair = await crypto.subtle.generateKey('ML-DSA-65', false, ['sign', 'verify']);
+      return { suite: 'ML-DSA-65', keyPair };
+    } catch {
+      /* fall through to classical */
+    }
+  }
+  try {
+    const keyPair = await crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']);
+    return { suite: 'Ed25519', keyPair };
+  } catch {
+    const keyPair = await crypto.subtle.generateKey(
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      false,
+      ['sign', 'verify'],
+    );
+    return { suite: 'ECDSA-P256', keyPair };
+  }
+}
+
+// Classical algorithms ignore a `context` member, so prepend a
+// length-prefixed context header to keep domain separation consistent.
+function frame(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const out = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  out[0] = contextBytes.byteLength;
+  out.set(contextBytes, 1);
+  out.set(payloadBytes, 1 + contextBytes.byteLength);
+  return out;
+}
+
+async function rawSign(suite, privateKey, payloadBytes, contextBytes) {
+  const s = SUITES[suite];
+  const sig = s.nativeContext
+    ? await crypto.subtle.sign({ name: suite, context: contextBytes }, privateKey, payloadBytes)
+    : await crypto.subtle.sign(s.signAlg, privateKey, frame(payloadBytes, contextBytes));
+  return new Uint8Array(sig);
+}
+
+async function rawVerify(suite, publicKey, signatureBytes, payloadBytes, contextBytes) {
+  const s = SUITES[suite];
+  return s.nativeContext
+    ? crypto.subtle.verify({ name: suite, context: contextBytes }, publicKey, signatureBytes, payloadBytes)
+    : crypto.subtle.verify(s.signAlg, publicKey, signatureBytes, frame(payloadBytes, contextBytes));
+}
+
+/* ---------- key persistence (IndexedDB) ---------- */
+
+const DB_NAME = 'daily-grind-signing';
+const STORE = 'keys';
+const KEY_ID = 'store-signing-key';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function idb(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const req = fn(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(req?.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+let signerPromise;
+
+async function loadOrCreateSigner() {
+  let record = null;
+  try {
+    record = await idb('readonly', (s) => s.get(KEY_ID));
+  } catch {
+    record = null;
+  }
+  if (!record || !SUITES[record.suite]) {
+    const { suite, keyPair } = await generateKeyPair();
+    record = { suite, privateKey: keyPair.privateKey, publicKey: keyPair.publicKey, created: new Date().toISOString() };
+    try {
+      await idb('readwrite', (s) => s.put(record, KEY_ID));
+    } catch {
+      /* IndexedDB unavailable (e.g. private mode) — key lives for this session only */
+    }
+  }
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey(SUITES[record.suite].keyFormat, record.publicKey),
+  );
+  return {
+    suite: record.suite,
+    created: record.created,
+    privateKey: record.privateKey,
+    publicKeyBytes,
+    fingerprint: await fingerprint(publicKeyBytes),
+  };
+}
+
+export function getSigner() {
+  signerPromise ??= loadOrCreateSigner();
+  return signerPromise;
+}
+
+/* ---------- public API ---------- */
+
+/**
+ * Sign a document. `type` is 'receipt' or 'voucher'; `data` is any JSON value.
+ * Returns a compact, portable token string (base64url-encoded JSON envelope).
+ */
+export async function signDocument(type, data) {
+  const context = CONTEXTS[type];
+  if (!context) throw new Error(`Unknown document type: ${type}`);
+  const signer = await getSigner();
+  const payload = {
+    type,
+    id: crypto.randomUUID(),
+    issuedAt: new Date().toISOString(),
+    issuer: 'The Daily Grind Coffee Co.',
+    data,
+  };
+  // The exact signed bytes travel with the token, so verifiers never need to
+  // re-serialize JSON (no canonicalization ambiguity).
+  const payloadBytes = enc.encode(JSON.stringify(payload));
+  const signature = await rawSign(signer.suite, signer.privateKey, payloadBytes, enc.encode(context));
+  const envelope = {
+    v: ENVELOPE_VERSION,
+    typ: type,
+    alg: signer.suite,
+    pub: toBase64Url(signer.publicKeyBytes),
+    payload: toBase64Url(payloadBytes),
+    sig: toBase64Url(signature),
+  };
+  return { token: toBase64Url(enc.encode(JSON.stringify(envelope))), payload, suite: signer.suite };
+}
+
+/**
+ * Verify a token. Returns
+ *   { valid, trusted, type, suite, payload, fingerprint, reason }
+ * `valid`   — signature matches payload under the embedded public key.
+ * `trusted` — that public key is the store's trusted key (authenticity).
+ */
+export async function verifyDocument(token, { trustedFingerprints } = {}) {
+  const fail = (reason, extra = {}) => ({ valid: false, trusted: false, reason, ...extra });
+
+  let envelope;
+  try {
+    envelope = JSON.parse(dec.decode(fromBase64Url(token.trim())));
+  } catch {
+    return fail('Not a Daily Grind signed document (could not decode).');
+  }
+  if (!envelope || envelope.v !== ENVELOPE_VERSION) return fail('Unsupported document version.');
+
+  const suite = envelope.alg;
+  const spec = Object.hasOwn(SUITES, suite) ? SUITES[suite] : null;
+  if (!spec) return fail(`Unsupported signature algorithm "${suite}".`);
+  const context = Object.hasOwn(CONTEXTS, envelope.typ) ? CONTEXTS[envelope.typ] : null;
+  if (!context) return fail('Unknown document type.');
+
+  let pubBytes, payloadBytes, sigBytes;
+  try {
+    pubBytes = fromBase64Url(envelope.pub);
+    payloadBytes = fromBase64Url(envelope.payload);
+    sigBytes = fromBase64Url(envelope.sig);
+  } catch {
+    return fail('Document is corrupted (invalid encoding).');
+  }
+  if (pubBytes.byteLength !== spec.publicKeyLength) return fail('Public key has the wrong length.');
+
+  if (suite === 'ML-DSA-65' && !supportsMlDsa()) {
+    return fail('This document uses post-quantum ML-DSA-65, which this browser cannot verify.', { suite });
+  }
+
+  let publicKey;
+  try {
+    publicKey = await crypto.subtle.importKey(spec.keyFormat, pubBytes, spec.importAlg, true, ['verify']);
+  } catch {
+    return fail('Public key could not be imported.', { suite });
+  }
+
+  const fp = await fingerprint(pubBytes);
+  let valid = false;
+  try {
+    valid = await rawVerify(suite, publicKey, sigBytes, payloadBytes, enc.encode(context));
+  } catch {
+    valid = false;
+  }
+  if (!valid) {
+    return fail('Signature does NOT match — the document was altered or forged.', { suite, fingerprint: fp });
+  }
+
+  let payload;
+  try {
+    payload = JSON.parse(dec.decode(payloadBytes));
+  } catch {
+    return fail('Signed payload is not valid JSON.', { suite, fingerprint: fp });
+  }
+  if (payload?.type !== envelope.typ) {
+    return fail('Document type mismatch.', { suite, fingerprint: fp });
+  }
+
+  const trusted = Array.isArray(trustedFingerprints) && trustedFingerprints.includes(fp);
+  return {
+    valid: true,
+    trusted,
+    type: envelope.typ,
+    suite,
+    payload,
+    fingerprint: fp,
+    reason: trusted
+      ? 'Authentic and unmodified — signed by The Daily Grind.'
+      : 'Signature is intact, but it was signed by an UNKNOWN key — do not honor.',
+  };
+}
+
+/** Flip one byte inside the signed payload to demonstrate tamper detection. */
+export function tamperToken(token) {
+  const envelope = JSON.parse(dec.decode(fromBase64Url(token.trim())));
+  const bytes = fromBase64Url(envelope.payload);
+  // Alter a digit in the payload if possible (e.g. bump a price), else flip a byte.
+  const text = dec.decode(bytes);
+  const m = /\d/.exec(text.slice(text.indexOf('"data"')));
+  let altered;
+  if (m) {
+    const idx = text.indexOf('"data"') + m.index;
+    const digit = (Number(text[idx]) + 1) % 10;
+    altered = enc.encode(text.slice(0, idx) + digit + text.slice(idx + 1));
+  } else {
+    altered = bytes.slice();
+    altered[altered.length - 2] ^= 0x01;
+  }
+  envelope.payload = toBase64Url(altered);
+  return toBase64Url(enc.encode(JSON.stringify(envelope)));
+}
+
+export const ALGORITHM_LABELS = {
+  'ML-DSA-65': 'ML-DSA-65 (post-quantum, FIPS 204)',
+  Ed25519: 'Ed25519 (classical)',
+  'ECDSA-P256': 'ECDSA P-256 / SHA-256 (classical)',
+};
