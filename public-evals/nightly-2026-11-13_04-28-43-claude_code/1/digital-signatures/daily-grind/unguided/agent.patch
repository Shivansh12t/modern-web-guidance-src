+
+/**
+ * Verifies a signed envelope.
+ * @param doc        parsed envelope object
+ * @param trusted    Map<keyId, {label, alg, publicKey}> of trusted signer keys
+ * @returns {{ ok, signatureValid, trusted, signerLabel, checks: {level, text}[] }}
+ *   `ok` is true only when the signature is valid, the signer is trusted and
+ *   no business-rule check failed.
+ */
+export async function verifyDocument(doc, trusted = new Map()) {
+  const checks = [];
+  const fail = (text) => checks.push({ level: 'error', text });
+  const warn = (text) => checks.push({ level: 'warn', text });
+  const pass = (text) => checks.push({ level: 'ok', text });
+  const result = { ok: false, signatureValid: false, trusted: false, signerLabel: null, checks };
+
+  if (!doc || typeof doc !== 'object' || Array.isArray(doc)) {
+    fail('Not a signed document (expected a JSON object).');
+    return result;
+  }
+  if (doc.format !== FORMAT) {
+    fail(`Unsupported format "${String(doc.format)}".`);
+    return result;
+  }
+  if (!KINDS.includes(doc.kind)) {
+    fail(`Unknown document kind "${String(doc.kind)}".`);
+    return result;
+  }
+  if (!doc.payload || typeof doc.payload !== 'object' || Array.isArray(doc.payload)) {
+    fail('Missing payload.');
+    return result;
+  }
+  const signer = doc.signer;
+  if (!signer || typeof signer !== 'object' || !ALGS[signer.alg]) {
+    fail(`Unknown or missing signature algorithm "${String(signer && signer.alg)}".`);
+    return result;
+  }
+  const spec = ALGS[signer.alg];
+
+  let pub, sig;
+  try {
+    pub = b64urlDecode(signer.publicKey);
+    sig = b64urlDecode(doc.signature);
+  } catch {
+    fail('Public key or signature is not valid base64url.');
+    return result;
+  }
+  if (pub.length !== spec.pubLen) {
+    fail(`Public key has wrong length for ${signer.alg} (${pub.length} ≠ ${spec.pubLen} bytes).`);
+    return result;
+  }
+  if (sig.length !== spec.sigLen) {
+    fail(`Signature has wrong length for ${signer.alg} (${sig.length} ≠ ${spec.sigLen} bytes).`);
+    return result;
+  }
+
+  const keyId = await computeKeyId(signer.alg, pub);
+  if (keyId !== signer.keyId) {
+    fail('Key fingerprint does not match the embedded public key.');
+    return result;
+  }
+
+  let valid = false;
+  try {
+    if (signer.alg.startsWith('Ed25519') && !(await supportsEd25519())) {
+      fail('This browser does not support Ed25519, so this signature cannot be checked.');
+      return result;
+    }
+    valid = await rawVerify(signer.alg, pub, sig, signingInput(doc));
+  } catch (e) {
+    fail(`Signature check error: ${e.message}`);
+    return result;
+  }
+  if (!valid) {
+    fail('Signature INVALID — the document was altered or was not signed by this key.');
+    return result;
+  }
+  result.signatureValid = true;
+  pass(`Signature valid (${spec.label}). Contents unchanged since signing.`);
+
+  const t = trusted.get(keyId);
+  if (t && t.alg === signer.alg && t.publicKey === signer.publicKey) {
+    result.trusted = true;
+    result.signerLabel = t.label;
+    pass(`Signer is trusted: “${t.label}” (key ${formatKeyId(keyId)}).`);
+  } else {
+    fail(
+      `Signer key ${formatKeyId(keyId)} is NOT in your trusted keyring. Anyone can create a valid ` +
+        'signature with their own key, so authenticity is not established. Import the Daily Grind ' +
+        'public key you trust to accept this document.',
+    );
+  }
+
+  for (const c of businessChecks(doc.kind, doc.payload)) checks.push(c);
+
+  result.ok = result.signatureValid && result.trusted && !checks.some((c) => c.level === 'error');
+  return result;
+}
+
+const isCents = (n) => Number.isSafeInteger(n) && n >= 0;
+
+/** Semantic checks on the (already authenticated) payload. */
+export function businessChecks(kind, p, now = new Date()) {
+  const out = [];
+  if (kind === 'receipt') {
+    if (!Array.isArray(p.items) || p.items.length === 0) {
+      out.push({ level: 'error', text: 'Receipt has no line items.' });
+      return out;
+    }
+    let sum = 0;
+    for (const it of p.items) {
+      if (!it || !isCents(it.unitCents) || !Number.isSafeInteger(it.qty) || it.qty <= 0) {
+        out.push({ level: 'error', text: 'Receipt contains a malformed line item.' });
+        return out;
+      }
+      sum += it.unitCents * it.qty;
+    }
+    if (sum !== p.subtotalCents || !isCents(p.taxCents) || p.subtotalCents + p.taxCents !== p.totalCents) {
+      out.push({ level: 'error', text: 'Receipt totals are inconsistent.' });
+    } else {
+      out.push({ level: 'ok', text: 'Receipt totals add up.' });
+    }
+  } else if (kind === 'voucher') {
+    if (!isCents(p.amountCents) || p.amountCents <= 0) {
+      out.push({ level: 'error', text: 'Voucher amount is invalid.' });
+    }
+    if (p.expires) {
+      const exp = new Date(p.expires);
+      if (Number.isNaN(exp.getTime())) out.push({ level: 'error', text: 'Voucher expiry date is invalid.' });
+      else if (exp < now) out.push({ level: 'error', text: `Voucher expired on ${exp.toLocaleDateString()}.` });
+      else out.push({ level: 'ok', text: `Voucher valid until ${exp.toLocaleDateString()}.` });
+    }
+  }
+  return out;
+}
+
+// ---------- public key export / import ----------
+
+export const PUBKEY_FORMAT = 'dailygrind-pubkey/v1';
+
+export function exportPublicKey(rec) {
+  return { format: PUBKEY_FORMAT, label: rec.label, alg: rec.alg, publicKey: rec.publicKey, keyId: rec.keyId };
+}
+
+/** Validates an exported public key object and returns a normalized record. */
+export async function parsePublicKey(obj) {
+  if (!obj || obj.format !== PUBKEY_FORMAT) throw new Error('Not a Daily Grind public key file.');
+  const spec = ALGS[obj.alg];
+  if (!spec) throw new Error(`Unknown algorithm ${obj.alg}`);
+  const pub = b64urlDecode(obj.publicKey);
+  if (pub.length !== spec.pubLen) throw new Error('Public key has wrong length.');
+  const keyId = await computeKeyId(obj.alg, pub);
+  if (obj.keyId && obj.keyId !== keyId) throw new Error('Key fingerprint does not match public key.');
+  const label = String(obj.label || 'Imported key').slice(0, 80);
+  return { label, alg: obj.alg, publicKey: obj.publicKey, keyId };
+}
