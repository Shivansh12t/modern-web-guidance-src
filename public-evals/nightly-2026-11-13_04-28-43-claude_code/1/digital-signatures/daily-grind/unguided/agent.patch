+// Daily Grind — signed receipts & vouchers: core crypto (no DOM).
+//
+// Envelope format ("dailygrind-signed/v1"):
+// {
+//   format:  "dailygrind-signed/v1",
+//   kind:    "receipt" | "voucher",
+//   payload: { ... },                       // money is always integer cents
+//   signer:  { alg, publicKey (base64url), keyId (hex) },
+//   signature: base64url
+// }
+//
+// The signature covers DOMAIN_TAG + canonicalJSON({format, kind, payload, signer}).
+// Including `signer` in the signed bytes binds the algorithm and public key to the
+// signature, preventing algorithm-substitution / key-swap tricks.
+
+import { ml_dsa65 } from '../vendor/noble-ml-dsa-0.7.1.mjs';
+
+export const FORMAT = 'dailygrind-signed/v1';
+export const KINDS = ['receipt', 'voucher'];
+const DOMAIN_TAG = 'DailyGrind/Signed-Document/v1\n';
+const PQ_CONTEXT = new TextEncoder().encode('DailyGrind/v1');
+
+const subtle = globalThis.crypto.subtle;
+const te = new TextEncoder();
+
+// ---------- algorithms ----------
+
+export const ALGS = {
+  'ECDSA-P256': {
+    label: 'ECDSA P-256 / SHA-256',
+    family: 'Classical',
+    pubLen: 65, // uncompressed SEC1 point
+    sigLen: 64, // IEEE P1363 r||s
+  },
+  'Ed25519': {
+    label: 'Ed25519',
+    family: 'Classical',
+    pubLen: 32,
+    sigLen: 64,
+  },
+  'ML-DSA-65': {
+    label: 'ML-DSA-65 (FIPS 204)',
+    family: 'Post-quantum',
+    pubLen: 1952,
+    sigLen: 3309,
+  },
+  'Ed25519+ML-DSA-65': {
+    label: 'Hybrid Ed25519 + ML-DSA-65',
+    family: 'Hybrid (classical + post-quantum)',
+    pubLen: 32 + 1952,
+    sigLen: 64 + 3309,
+  },
+};
+
+let ed25519Support;
+/** Whether this browser's WebCrypto implements Ed25519. */
+export async function supportsEd25519() {
+  if (ed25519Support !== undefined) return ed25519Support;
+  try {
+    await subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+    ed25519Support = true;
+  } catch {
+    ed25519Support = false;
+  }
+  return ed25519Support;
+}
+
+export async function availableAlgs() {
+  const ed = await supportsEd25519();
+  return Object.keys(ALGS).filter((a) => ed || !a.startsWith('Ed25519'));
+}
+
+// ---------- encoding helpers ----------
+
+export function b64urlEncode(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64urlDecode(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new Error('Invalid base64url encoding');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+const toHex = (bytes) => Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+
+function concat(...arrs) {
+  const out = new Uint8Array(arrs.reduce((n, a) => n + a.length, 0));
+  let off = 0;
+  for (const a of arrs) {
+    out.set(a, off);
+    off += a.length;
+  }
+  return out;
+}
+
+/**
+ * Deterministic JSON: object keys sorted, no whitespace. Rejects values that
+ * don't round-trip (non-finite numbers, undefined, functions, etc.).
+ */
+export function canonicalJSON(value) {
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return JSON.stringify(value);
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) throw new Error('Non-finite number in signed data');
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) return '[' + value.map(canonicalJSON).join(',') + ']';
+  if (typeof value === 'object') {
+    const keys = Object.keys(value).sort();
+    return '{' + keys.map((k) => JSON.stringify(k) + ':' + canonicalJSON(value[k])).join(',') + '}';
+  }
+  throw new Error(`Unsupported type in signed data: ${typeof value}`);
+}
+
+function signingInput(doc) {
+  const { format, kind, payload, signer } = doc;
+  return te.encode(
+    DOMAIN_TAG +
+      canonicalJSON({
+        format,
+        kind,
+        payload,
+        signer: { alg: signer.alg, publicKey: signer.publicKey, keyId: signer.keyId },
+      }),
+  );
+}
+
+/** Key fingerprint: first 16 bytes of SHA-256(alg || 0x00 || publicKey), hex. */
+export async function computeKeyId(alg, publicKeyBytes) {
+  const digest = await subtle.digest('SHA-256', concat(te.encode(alg), new Uint8Array([0]), publicKeyBytes));
+  return toHex(new Uint8Array(digest).subarray(0, 16));
+}
+
+export function formatKeyId(keyId) {
+  return keyId.match(/.{1,4}/g).join(' ');
+}
+
+// ---------- key generation ----------
+
+/**
+ * Generates a key pair. Returns a record suitable for IndexedDB storage:
+ * WebCrypto private keys are created NON-extractable (the browser never
+ * reveals the raw key material, even to this page). ML-DSA has no native
+ * WebCrypto support yet, so its 32-byte seed is stored as bytes.
+ */
+export async function generateKeyRecord(alg, label) {
+  if (!ALGS[alg]) throw new Error(`Unknown algorithm ${alg}`);
+  const rec = { alg, label: label || alg, created: new Date().toISOString() };
+  let pub;
+
+  if (alg === 'ECDSA-P256') {
+    const kp = await subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
+    rec.privateKey = kp.privateKey;
+    pub = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+  } else if (alg === 'Ed25519') {
+    const kp = await subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+    rec.privateKey = kp.privateKey;
+    pub = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+  } else if (alg === 'ML-DSA-65') {
+    const seed = crypto.getRandomValues(new Uint8Array(32));
+    rec.pqSeed = seed;
+    pub = ml_dsa65.keygen(seed).publicKey;
+  } else {
+    const kp = await subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+    rec.privateKey = kp.privateKey;
+    const edPub = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+    const seed = crypto.getRandomValues(new Uint8Array(32));
+    rec.pqSeed = seed;
+    pub = concat(edPub, ml_dsa65.keygen(seed).publicKey);
+  }
+
+  rec.publicKey = b64urlEncode(pub);
+  rec.keyId = await computeKeyId(alg, pub);
+  return rec;
+}
+
+// ---------- signing ----------
+
+async function rawSign(rec, msg) {
+  switch (rec.alg) {
+    case 'ECDSA-P256':
+      return new Uint8Array(await subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, rec.privateKey, msg));
+    case 'Ed25519':
+      return new Uint8Array(await subtle.sign({ name: 'Ed25519' }, rec.privateKey, msg));
+    case 'ML-DSA-65': {
+      const { secretKey } = ml_dsa65.keygen(rec.pqSeed);
+      try {
+        return ml_dsa65.sign(msg, secretKey, { context: PQ_CONTEXT });
+      } finally {
+        secretKey.fill(0);
+      }
+    }
+    case 'Ed25519+ML-DSA-65': {
+      const ed = new Uint8Array(await subtle.sign({ name: 'Ed25519' }, rec.privateKey, msg));
+      const { secretKey } = ml_dsa65.keygen(rec.pqSeed);
+      try {
+        return concat(ed, ml_dsa65.sign(msg, secretKey, { context: PQ_CONTEXT }));
+      } finally {
+        secretKey.fill(0);
+      }
+    }
+    default:
+      throw new Error(`Unknown algorithm ${rec.alg}`);
+  }
+}
+
+/** Signs a receipt/voucher payload with a stored key record. */
+export async function signDocument(kind, payload, rec) {
+  if (!KINDS.includes(kind)) throw new Error(`Unknown document kind ${kind}`);
+  const doc = {
+    format: FORMAT,
+    kind,
+    payload,
+    signer: { alg: rec.alg, publicKey: rec.publicKey, keyId: rec.keyId },
+  };
+  const sig = await rawSign(rec, signingInput(doc));
+  return { ...doc, signature: b64urlEncode(sig) };
+}
+
+// ---------- verification ----------
+
+async function rawVerify(alg, pub, sig, msg) {
+  switch (alg) {
+    case 'ECDSA-P256': {
+      const key = await subtle.importKey('raw', pub, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+      return subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, sig, msg);
+    }
+    case 'Ed25519': {
+      const key = await subtle.importKey('raw', pub, { name: 'Ed25519' }, false, ['verify']);
+      return subtle.verify({ name: 'Ed25519' }, key, sig, msg);
+    }
+    case 'ML-DSA-65':
+      return ml_dsa65.verify(sig, msg, pub, { context: PQ_CONTEXT });
+    case 'Ed25519+ML-DSA-65': {
+      // Both components must verify: the document stays authentic as long as
+      // EITHER algorithm remains unbroken.
