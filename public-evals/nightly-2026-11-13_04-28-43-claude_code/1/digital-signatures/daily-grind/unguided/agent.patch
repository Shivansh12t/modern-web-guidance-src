new file mode 100644
index 0000000..7d3e083
--- /dev/null
+++ b/tests/signing.test.mjs
@@ -0,0 +1,55 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as S from '../js/signing.js';
+
+const receipt = {
+  orderId: 'DG-TEST',
+  items: [{ name: 'Cold Brew', qty: 2, unitCents: 475 }],
+  subtotalCents: 950,
+  taxCents: 76,
+  totalCents: 1026,
+};
+
+for (const alg of await S.availableAlgs()) {
+  test(`${alg}: sign/verify, tamper, trust`, async () => {
+    const rec = await S.generateKeyRecord(alg, 'store');
+    const trusted = new Map([[rec.keyId, S.exportPublicKey(rec)]]);
+    const doc = JSON.parse(JSON.stringify(await S.signDocument('receipt', receipt, rec)));
+
+    assert.equal((await S.verifyDocument(doc, trusted)).ok, true);
+
+    const tampered = structuredClone(doc);
+    tampered.payload.items[0].qty = 1;
+    const t = await S.verifyDocument(tampered, trusted);
+    assert.equal(t.signatureValid, false);
+    assert.equal(t.ok, false);
+
+    const untrusted = await S.verifyDocument(doc, new Map());
+    assert.equal(untrusted.signatureValid, true);
+    assert.equal(untrusted.ok, false);
+
+    const attacker = await S.generateKeyRecord(alg, 'attacker');
+    const forged = await S.signDocument('receipt', { ...receipt, customer: 'evil' }, attacker);
+    assert.equal((await S.verifyDocument(forged, trusted)).ok, false);
+
+    const keySwap = structuredClone(doc);
+    keySwap.signer = { ...forged.signer };
+    assert.equal((await S.verifyDocument(keySwap, trusted)).signatureValid, false);
+
+    assert.deepEqual(await S.parsePublicKey(S.exportPublicKey(rec)), {
+      label: 'store', alg, publicKey: rec.publicKey, keyId: rec.keyId,
+    });
+  });
+}
+
+test('voucher expiry and amount checks', () => {
+  const now = new Date('2026-06-01T00:00:00Z');
+  assert.equal(S.businessChecks('voucher', { amountCents: 2500, expires: '2026-01-01T23:59:59Z' }, now)[0].level, 'error');
+  assert.equal(S.businessChecks('voucher', { amountCents: 2500, expires: '2027-01-01T23:59:59Z' }, now)[0].level, 'ok');
+  assert.equal(S.businessChecks('voucher', { amountCents: -1 }, now)[0].level, 'error');
+});
+
+test('canonical JSON is key-order independent', () => {
+  assert.equal(S.canonicalJSON({ b: 1, a: [2, { d: 3, c: 4 }] }), S.canonicalJSON({ a: [2, { c: 4, d: 3 }], b: 1 }));
+  assert.throws(() => S.canonicalJSON({ x: NaN }));
+});
