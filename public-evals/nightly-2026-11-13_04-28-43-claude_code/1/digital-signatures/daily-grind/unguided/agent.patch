+// Daily Grind — signed receipts & vouchers: UI controller.
+import {
+  ALGS,
+  availableAlgs,
+  generateKeyRecord,
+  signDocument,
+  verifyDocument,
+  exportPublicKey,
+  parsePublicKey,
+  formatKeyId,
+  canonicalJSON,
+  b64urlDecode,
+} from './signing.js';
+
+const $ = (id) => document.getElementById(id);
+
+/** Safe DOM builder — all text goes through textContent, never innerHTML. */
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === 'class') node.className = v;
+    else if (k === 'text') node.textContent = v;
+    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
+    else node.setAttribute(k, v);
+  }
+  for (const c of children.flat()) {
+    if (c == null || c === false) continue;
+    node.append(c instanceof Node ? c : document.createTextNode(String(c)));
+  }
+  return node;
+}
+
+const money = (cents) => `$${(cents / 100).toFixed(2)}`;
+
+function randomCode(groups, len = 4) {
+  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // 32 symbols, no 0/O/1/I
+  const bytes = crypto.getRandomValues(new Uint8Array(groups * len));
+  const chars = Array.from(bytes, (b) => alphabet[b & 31]);
+  const out = [];
+  for (let i = 0; i < groups; i++) out.push(chars.slice(i * len, (i + 1) * len).join(''));
+  return out.join('-');
+}
+
+// ---------- storage (IndexedDB, with in-memory fallback) ----------
+
+const DB_NAME = 'dailygrind-signing';
+const STORES = ['keys', 'trusted', 'redeemed'];
+let dbPromise;
+const memory = Object.fromEntries(STORES.map((s) => [s, new Map()]));
+let persistent = true;
+
+function openDB() {
+  if (!dbPromise) {
+    dbPromise = new Promise((resolve, reject) => {
+      const req = indexedDB.open(DB_NAME, 1);
+      req.onupgradeneeded = () => {
+        for (const s of STORES) req.result.createObjectStore(s, { keyPath: 'id' });
+      };
+      req.onsuccess = () => resolve(req.result);
+      req.onerror = () => reject(req.error);
+    }).catch((e) => {
+      console.warn('IndexedDB unavailable, keys will not persist:', e);
+      persistent = false;
+      return null;
+    });
+  }
+  return dbPromise;
+}
+
+async function dbOp(store, mode, fn) {
+  const db = await openDB();
+  if (!db) return (fn(null, memory[store]) || {}).result;
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(store, mode);
+    const req = fn(tx.objectStore(store));
+    tx.oncomplete = () => resolve(req && req.result);
+    tx.onerror = () => reject(tx.error);
+  });
+}
+
+const db = {
+  all: (store) =>
+    dbOp(store, 'readonly', (os, mem) => (os ? os.getAll() : { result: [...mem.values()] })).then((r) => r || []),
+  get: (store, id) => dbOp(store, 'readonly', (os, mem) => (os ? os.get(id) : { result: mem.get(id) })),
+  put: (store, value) => dbOp(store, 'readwrite', (os, mem) => (os ? os.put(value) : (mem.set(value.id, value), undefined))),
+  del: (store, id) => dbOp(store, 'readwrite', (os, mem) => (os ? os.delete(id) : void mem.delete(id))),
+};
+
+// ---------- state ----------
+
+let ownKeys = [];
+let trustedKeys = [];
+let algs = [];
+
+async function loadKeys() {
+  ownKeys = (await db.all('keys')).sort((a, b) => a.created.localeCompare(b.created));
+  trustedKeys = await db.all('trusted');
+}
+
+function trustMap() {
+  const m = new Map();
+  for (const k of trustedKeys) m.set(k.keyId, k);
+  for (const k of ownKeys) m.set(k.keyId, { ...exportPublicKey(k), label: `${k.label} (this device)` });
+  return m;
+}
+
+// ---------- tabs ----------
+
+const tabs = [...document.querySelectorAll('.tabs [role="tab"]')];
+function selectTab(tab) {
+  for (const t of tabs) {
+    const on = t === tab;
+    t.setAttribute('aria-selected', String(on));
+    t.tabIndex = on ? 0 : -1;
+    $(t.getAttribute('aria-controls')).hidden = !on;
+  }
+}
+tabs.forEach((t, i) => {
+  t.addEventListener('click', () => selectTab(t));
+  t.addEventListener('keydown', (e) => {
+    const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
+    if (!d) return;
+    const next = tabs[(i + d + tabs.length) % tabs.length];
+    selectTab(next);
+    next.focus();
+  });
+});
+
+// ---------- key management UI ----------
+
+function keyDescription(k) {
+  const spec = ALGS[k.alg];
+  return `${spec.label} · ${spec.family}`;
+}
+
+function renderKeySelects() {
+  for (const sel of document.querySelectorAll('.signing-key-select')) {
+    const prev = sel.value;
+    sel.replaceChildren(
+      ...ownKeys.map((k) => el('option', { value: k.keyId, text: `${k.label} — ${ALGS[k.alg].label}` })),
+    );
+    if (ownKeys.some((k) => k.keyId === prev)) sel.value = prev;
+    else if (ownKeys.length) sel.value = ownKeys[ownKeys.length - 1].keyId;
+  }
+}
+
+function renderKeyLists() {
+  $('own-keys').replaceChildren(
+    ...(ownKeys.length
+      ? ownKeys.map((k) =>
+          el(
+            'li',
+            {},
+            el('strong', { text: k.label }),
+            el('div', { class: 'meta', text: `${keyDescription(k)} · created ${new Date(k.created).toLocaleString()}` }),
+            el('div', { class: 'keyid', text: `Fingerprint: ${formatKeyId(k.keyId)}` }),
+            el(
+              'div',
+              { class: 'actions' },
+              el('button', {
+                type: 'button',
+                class: 'btn secondary',
+                text: 'Copy Public Key',
+                onclick: () => copyText(JSON.stringify(exportPublicKey(k), null, 2), $('keys-status')),
+              }),
+              el('button', {
+                type: 'button',
+                class: 'btn secondary',
+                text: 'Download Public Key',
+                onclick: () =>
+                  downloadText(JSON.stringify(exportPublicKey(k), null, 2), `dailygrind-pubkey-${k.keyId.slice(0, 8)}.json`),
+              }),
+              el('button', {
+                type: 'button',
+                class: 'btn danger',
+                text: 'Delete',
+                onclick: async () => {
+                  if (!confirm(`Delete signing key “${k.label}”? Documents it signed will no longer verify as trusted on this device unless you re-import its public key.`)) return;
+                  await db.del('keys', k.id);
+                  await refresh();
+                },
+              }),
+            ),
+          ),
+        )
+      : [el('li', { class: 'muted', text: 'No signing keys yet.' })]),
+  );
+
+  $('trusted-keys').replaceChildren(
+    ...(trustedKeys.length
+      ? trustedKeys.map((k) =>
+          el(
+            'li',
+            {},
+            el('strong', { text: k.label }),
+            el('div', { class: 'meta', text: keyDescription(k) }),
+            el('div', { class: 'keyid', text: `Fingerprint: ${formatKeyId(k.keyId)}` }),
+            el(
+              'div',
+              { class: 'actions' },
+              el('button', {
+                type: 'button',
+                class: 'btn danger',
+                text: 'Remove Trust',
+                onclick: async () => {
+                  await db.del('trusted', k.id);
+                  await refresh();
+                },
+              }),
+            ),
+          ),
+        )
+      : [el('li', { class: 'muted', text: 'No imported keys. Your own keys are trusted automatically.' })]),
+  );
+}
+
+async function refresh() {
+  await loadKeys();
+  renderKeySelects();
+  renderKeyLists();
+  const none = ownKeys.length === 0;
+  for (const f of ['receipt-form', 'voucher-form']) $(f).querySelector('button[type=submit]').disabled = none;
+}
+
+async function createKey(alg, label) {
+  const rec = await generateKeyRecord(alg, label);
+  rec.id = rec.keyId;
+  await db.put('keys', rec);
+  return rec;
+}
+
+$('new-key-btn').addEventListener('click', async (e) => {
+  const status = $('keys-status');
+  const alg = $('new-key-alg').value;
+  e.target.disabled = true;
+  status.textContent = 'Generating…';
+  try {
