+  <script>
+    (function () {
+      var MIN_PAGE = 1;
+      var MAX_PAGE = 3;
+      var DIRECTION_KEY = 'pagination-direction';
+
+      function pageFromUrl(url) {
+        try {
+          var n = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+          return isNaN(n) ? MIN_PAGE : Math.min(Math.max(n, MIN_PAGE), MAX_PAGE);
+        } catch (e) {
+          return MIN_PAGE;
+        }
+      }
+
+      // Configure the prev/next links for the current page.
+      document.addEventListener('DOMContentLoaded', function () {
+        var current = pageFromUrl(location.href);
+        var prev = document.getElementById('previous');
+        var next = document.getElementById('next');
+        document.getElementById('current-page').textContent = current + ' of ' + MAX_PAGE;
+
+        function setLink(link, page, enabled) {
+          link.href = '?page=' + page;
+          if (enabled) {
+            link.removeAttribute('aria-disabled');
+            link.removeAttribute('tabindex');
+          } else {
+            link.setAttribute('aria-disabled', 'true');
+            link.setAttribute('tabindex', '-1');
+          }
+        }
+        setLink(prev, Math.max(current - 1, MIN_PAGE), current > MIN_PAGE);
+        setLink(next, Math.min(current + 1, MAX_PAGE), current < MAX_PAGE);
+
+        // Fallback direction hint for browsers without the Navigation API.
+        prev.addEventListener('click', function () {
+          sessionStorage.setItem(DIRECTION_KEY, 'backward');
+        });
+        next.addEventListener('click', function () {
+          sessionStorage.setItem(DIRECTION_KEY, 'forward');
+        });
+      });
+
+      function directionFor(fromUrl, toUrl) {
+        if (fromUrl && toUrl) {
+          var from = pageFromUrl(fromUrl);
+          var to = pageFromUrl(toUrl);
+          if (to > from) return 'forward';
+          if (to < from) return 'backward';
+        }
+        return sessionStorage.getItem(DIRECTION_KEY);
+      }
+
+      // Outgoing page: tag the transition with its direction.
+      window.addEventListener('pageswap', function (e) {
+        if (!e.viewTransition || !e.activation) return;
+        var dir = directionFor(
+          e.activation.from && e.activation.from.url,
+          e.activation.entry && e.activation.entry.url
+        );
+        if (dir) e.viewTransition.types.add(dir);
+      });
+
+      // Incoming page: tag the transition with its direction.
+      window.addEventListener('pagereveal', function (e) {
+        if (!e.viewTransition) return;
+        var activation = window.navigation && navigation.activation;
+        var dir = directionFor(
+          activation && activation.from && activation.from.url,
+          activation && activation.entry && activation.entry.url
+        );
+        sessionStorage.removeItem(DIRECTION_KEY);
+        if (dir) {
+          e.viewTransition.types.add(dir);
+        } else {
+          e.viewTransition.skipTransition();
+        }
+      });
+    })();
+  </script>
