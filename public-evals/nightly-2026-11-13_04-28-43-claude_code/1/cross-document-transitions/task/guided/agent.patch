+  <script>
+    // Determine the transition direction for cross-document navigations.
+    // Must run before first render, so it lives inline in <head>.
+    (() => {
+      const pageOf = (url) => {
+        if (!url) return null;
+        const n = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+        return Number.isFinite(n) && n > 0 ? n : 1;
+      };
+
+      const directionBetween = (fromUrl, toUrl) => {
+        const from = pageOf(fromUrl);
+        const to = pageOf(toUrl);
+        if (from === null || to === null || from === to) return null;
+        return to > from ? 'next' : 'previous';
+      };
+
+      // Fallback for browsers without the Navigation API: remember the clicked link's direction.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest?.('.pagination a[data-direction]');
+        if (link) sessionStorage.setItem('vt-direction', link.dataset.direction);
+      });
+
+      // Outgoing page
+      window.addEventListener('pageswap', (e) => {
+        if (!e.viewTransition) return;
+        const dir = directionBetween(location.href, e.activation?.entry?.url) ||
+          sessionStorage.getItem('vt-direction');
+        if (dir) e.viewTransition.types.add(dir);
+      });
+
+      // Incoming page
+      window.addEventListener('pagereveal', (e) => {
+        const stored = sessionStorage.getItem('vt-direction');
+        sessionStorage.removeItem('vt-direction');
+        if (!e.viewTransition) return;
+        const activation = window.navigation?.activation;
+        const dir = (activation && directionBetween(activation.from?.url, activation.entry?.url)) || stored;
+        if (dir) e.viewTransition.types.add(dir);
+      });
+    })();
+  </script>
 </head>
 
