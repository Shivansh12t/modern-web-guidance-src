+
+      const url = new URL(link.href);
+      if (url.origin !== location.origin) return;
+      const parentView = link.closest('.Stack-view');
+      if (!resolveUrl(url.pathname) || !parentView) return;
+
+      e.preventDefault();
+      returnFocus.set(parentView, link);
+      drillDown(url.pathname);
+    });
+
+    // Back from a deep link has no in-app entry behind it — history.back()
+    // would leave the site — so synthesize a root entry instead.
+    function goBack() {
+      const atDeepLinkRoot = currentDepth === 0 && entriesByDepth.get(0)?.view !== rootView;
+      if (atDeepLinkRoot) {
+        synthesizeRootEntry();
+      } else {
+        history.back();
+      }
+    }
+
+    function synthesizeRootEntry() {
+      const newDepth = currentDepth + 1;
+      history.pushState({depth: newDepth}, '', '/');
+
+      if (!rootView?.isConnected) {
+        rootView ??= createRootView();
+        stack.prepend(rootView);
+        // Keep the current view visually in place before animating left.
+        stack.scrollTo({left: stack.scrollLeft + stack.clientWidth, behavior: 'instant'});
+      }
+      entriesByDepth.set(newDepth, {urlPath: '/', view: rootView});
+      updateFromHistoryState(history.state);
+    }
+
+    // ---------- History sync ----------
+    window.addEventListener('popstate', (event) => {
+      updateFromHistoryState(event.state);
+    });
+
+    function updateFromHistoryState(state, behaviorOverride) {
+      const newDepth = state?.depth ?? 0;
+      const urlPath = getCurrentUrlPath();
+
+      const entry = entriesByDepth.get(newDepth) ?? {view: null};
+      if (entry.urlPath !== urlPath) {
+        entry.urlPath = urlPath;
+        entry.view = null;
+      }
+      entriesByDepth.set(newDepth, entry);
+
+      // Remember which view is on screen so inserting views to its left
+      // (rebuilding pruned/unknown entries) doesn't visually shift it.
+      const visibleView = stack.children[Math.round(stack.scrollLeft / stack.clientWidth)];
+
+      // Rebuild any views up to the destination that don't exist yet: views
+      // pruned by an earlier swipe-back, entries from before a reload, or
+      // the root view after landing on a deep link. Each is inserted in
+      // depth order so "back" is always spatially to the left.
+      for (let d = Math.min(0, ...entriesByDepth.keys()); d <= newDepth; d++) {
+        const e = entriesByDepth.get(d);
+        if (!e || e.view?.isConnected) continue;
+        const routeData = resolveUrl(e.urlPath);
+        if (routeData) {
+          e.view = createDrillDownView(routeData);
+        } else {
+          rootView ??= createRootView();
+          e.view = rootView;
+        }
+        insertAtDepth(e.view, d);
+      }
+
+      if (visibleView?.isConnected) {
+        const idx = [...stack.children].indexOf(visibleView);
+        stack.scrollTo({left: idx * stack.clientWidth, behavior: 'instant'});
+      }
+
+      currentDepth = newDepth;
+
+      const targetView = entriesByDepth.get(newDepth)?.view;
+      if (!targetView) return;
+
+      const toIdx = [...stack.children].indexOf(targetView);
+      const fromIdx = Math.round(stack.scrollLeft / stack.clientWidth);
+      if (fromIdx === toIdx) {
+        // Already aligned (e.g. history.go() after a completed swipe) —
+        // still make sure inert/title/focus are correct.
+        onActiveViewChanged(targetView);
+        return;
+      }
+
+      const forward = toIdx > fromIdx;
+      const multiStep = Math.abs(toIdx - fromIdx) > 1;
+      const behavior = behaviorOverride ?? (forward || multiStep ? 'instant' : 'auto');
+      stack.scrollTo({left: toIdx * stack.clientWidth, behavior});
+    }
+
+    // Insert a view before the first existing view with a greater depth.
+    function insertAtDepth(view, depth) {
+      let before = null;
+      let bestDepth = Infinity;
+      for (const [d, e] of entriesByDepth) {
+        if (d > depth && d < bestDepth && e.view?.parentElement === stack && e.view !== view) {
+          before = e.view;
+          bestDepth = d;
+        }
+      }
+      stack.insertBefore(view, before);
+    }
+
+    // ---------- Active view changed (single source of truth) ----------
+    function onActiveViewChanged(currentView) {
+      if (!currentView || currentView.parentElement !== stack) return;
+      const focusWasInStack = stack.contains(document.activeElement);
+
+      let seenCurrent = false;
+      for (const view of [...stack.children]) {
+        if (seenCurrent) {
+          for (const e of entriesByDepth.values()) {
+            if (e.view === view) e.view = null;
+          }
+          view.remove();
+        } else {
+          view.toggleAttribute('inert', view !== currentView);
+          if (view === currentView) seenCurrent = true;
+        }
+      }
+
+      // A swipe changed the view without touching history — reconcile.
+      let currentViewDepth;
+      for (const [d, e] of entriesByDepth) {
+        if (e.view === currentView) currentViewDepth = d;
+      }
+      if (currentViewDepth !== undefined && currentViewDepth !== currentDepth) {
+        history.go(currentViewDepth - currentDepth);
+      }
+
+      const viewTitle = currentView === rootView
+        ? null
+        : currentView.querySelector('.view-header h2')?.textContent;
+      document.title = viewTitle ? `${viewTitle} | ${APP_NAME}` : `${APP_NAME} | Artisanal Coffee`;
+
+      const back = currentView.querySelector('.back');
+      if (back) {
+        const prev = currentView.previousElementSibling;
+        const parentTitle = !prev || prev === rootView
+          ? ROOT_TITLE
+          : prev.querySelector('.view-header h2')?.textContent ?? ROOT_TITLE;
+        back.setAttribute('aria-label', `Back to ${parentTitle}`);
+      }
+
+      const stored = returnFocus.get(currentView);
+      if (stored?.isConnected) {
+        stored.focus({preventScroll: true});
+        returnFocus.delete(currentView);
+      } else if (currentView !== rootView) {
+        // Don't steal focus on initial page load (deep link).
+        if (ready) back?.focus({preventScroll: true});
+      } else if (focusWasInStack && !currentView.contains(document.activeElement)) {
+        currentView.querySelector('.Stack-viewContent')?.focus({preventScroll: true});
+      }
+    }
+
+    stack.addEventListener('scrollsnapchange', (event) => {
+      onActiveViewChanged(event.snapTargetInline);
+    });
+
+    // Fallback for browsers without scroll snap events.
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const viewObserver = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.intersectionRatio === 1) onActiveViewChanged(entry.target);
+        }
+      }, {root: stack, threshold: 1});
+
+      new MutationObserver((mutations) => {
+        for (const m of mutations) {
+          for (const node of m.addedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.observe(node);
+          }
+          for (const node of m.removedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.unobserve(node);
+          }
+        }
+      }).observe(stack, {childList: true});
+
+      for (const view of stack.children) viewObserver.observe(view);
+    }
+
+    // Parallax fallback for browsers without scroll-driven animations.
+    if (!CSS.supports('animation-timeline: view()')) {
+      stack.addEventListener('scroll', () => {
+        const viewWidth = stack.clientWidth;
+        for (const view of stack.children) {
+          const offsetLeft = view.offsetLeft - stack.scrollLeft;
+          const progress = Math.min(1, Math.max(0, -offsetLeft / viewWidth));
+          const content = view.querySelector('.Stack-viewContent');
+          content.style.transform = progress ? `translateX(${progress * 75}%)` : '';
+          content.style.filter = progress ? `brightness(${1 - progress * 0.2})` : '';
+        }
+      }, {passive: true});
+    }
+
+    // Keep the active view aligned when the viewport is resized/rotated.
+    new ResizeObserver(() => {
+      const active = entriesByDepth.get(currentDepth)?.view;
+      const idx = active ? [...stack.children].indexOf(active) : -1;
+      if (idx >= 0) stack.scrollTo({left: idx * stack.clientWidth, behavior: 'instant'});
+    }).observe(stack);
+
+    // ---------- Init (handles deep links) ----------
+    const initialUrlPath = getCurrentUrlPath();
+    const initialRouteData = resolveUrl(initialUrlPath);
+    let initialView;
+    if (initialRouteData) {
+      initialView = createDrillDownView(initialRouteData);
+    } else {
+      rootView = createRootView();
+      initialView = rootView;
+    }
+    stack.appendChild(initialView);
+
+    // Preserve the depth on reload so earlier entries in this tab's
+    // history still map to views on the left; fresh visits start at 0.
+    const initialDepth = Number.isInteger(history.state?.depth) ? history.state.depth : 0;
+    currentDepth = initialDepth;
+    entriesByDepth.set(initialDepth, {urlPath: initialUrlPath, view: initialView});
+    history.replaceState({depth: initialDepth}, '');
+    updateFromHistoryState(history.state, 'instant');
+    ready = true;
+  </script>
+
 </body>
 
 </html>
