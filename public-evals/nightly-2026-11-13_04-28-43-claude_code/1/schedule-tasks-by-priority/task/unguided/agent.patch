+
+  <script>
+    (() => {
+      'use strict';
+
+      // ---- Task definitions -------------------------------------------------
+      const TASK_TYPES = {
+        checkout: { label: 'Checkout', priority: 'user-blocking', chunks: 12, verbs: ['Validate cart', 'Authorize payment', 'Confirm order'] },
+        menu: { label: 'Menu update', priority: 'user-visible', chunks: 25, verbs: ['Sync prices', 'Refresh items', 'Rebuild menu cache'] },
+        telemetry: { label: 'Telemetry', priority: 'background', chunks: 40, verbs: ['Collect metrics', 'Compress logs', 'Flush telemetry'] },
+      };
+      const PRIORITY_RANK = { 'user-blocking': 0, 'user-visible': 1, 'background': 2 };
+      const CHUNK_MS = 8; // max synchronous work per slice, well under a 16ms frame
+
+      // ---- Scheduler abstraction -------------------------------------------
+      // Prefer the native Prioritized Task Scheduling API; fall back to a small
+      // priority queue driven by MessageChannel (macrotasks that let the browser
+      // render and handle input between slices).
+      const hasNative = typeof window.scheduler !== 'undefined' && typeof window.scheduler.postTask === 'function';
+
+      const fallback = (() => {
+        const queues = [[], [], []];
+        const channel = new MessageChannel();
+        let pending = false;
+
+        channel.port1.onmessage = () => {
+          pending = false;
+          const q = queues.find((list) => list.length);
+          if (!q) return;
+          const job = q.shift();
+          job();
+          if (queues.some((list) => list.length)) request();
+        };
+
+        function request() {
+          if (!pending) {
+            pending = true;
+            channel.port2.postMessage(null);
+          }
+        }
+
+        function enqueue(priority, job) {
+          queues[PRIORITY_RANK[priority]].push(job);
+          request();
+        }
+
+        return {
+          postTask(fn, priority) {
+            return new Promise((resolve, reject) => {
+              enqueue(priority, () => {
+                try { resolve(fn()); } catch (err) { reject(err); }
+              });
+            });
+          },
+          yield(priority) {
+            return new Promise((resolve) => enqueue(priority, resolve));
+          },
+        };
+      })();
+
+      const sched = {
+        name: hasNative ? 'scheduler.postTask (native)' : 'priority queue (fallback)',
+        postTask(fn, priority) {
+          return hasNative ? window.scheduler.postTask(fn, { priority }) : fallback.postTask(fn, priority);
+        },
+        yield(priority) {
+          if (hasNative) {
+            // scheduler.yield() continuations inherit the priority of the
+            // current postTask; otherwise post an empty task at that priority.
+            if (typeof window.scheduler.yield === 'function') return window.scheduler.yield();
+            return window.scheduler.postTask(() => {}, { priority });
+          }
+          return fallback.yield(priority);
+        },
+      };
+
+      // ---- DOM refs ---------------------------------------------------------
+      const root = document.getElementById('ops-queue');
+      const tasksEl = document.getElementById('ops-tasks');
+      const logEl = document.getElementById('ops-log');
+      const activeEl = document.getElementById('ops-active');
+      const completedEl = document.getElementById('ops-completed');
+      const longestEl = document.getElementById('ops-longest');
+      document.getElementById('ops-engine').textContent = sched.name;
+
+      let nextId = 1;
+      let active = 0;
+      let completed = 0;
+      let longestBlock = 0;
+
+      function updateCounters() {
+        activeEl.textContent = active;
+        completedEl.textContent = completed;
+        longestEl.textContent = `${longestBlock.toFixed(1)} ms`;
+      }
+
+      function log(message) {
+        const li = document.createElement('li');
+        const time = document.createElement('time');
+        const now = new Date();
+        time.textContent = now.toLocaleTimeString([], { hour12: false }) + '.' + String(now.getMilliseconds()).padStart(3, '0');
+        li.append(time, document.createTextNode(message));
+        logEl.prepend(li);
+        while (logEl.children.length > 100) logEl.lastElementChild.remove();
+      }
+
+      function removeEmptyPlaceholder() {
+        const empty = tasksEl.querySelector('.ops-empty');
+        if (empty) empty.remove();
+      }
+
+      function renderTask(task) {
+        removeEmptyPlaceholder();
+        const li = document.createElement('li');
+        li.className = 'ops-task queued';
+        li.dataset.priority = task.priority;
+        li.innerHTML = `
+          <div class="ops-task-head">
+            <span class="ops-task-name"></span>
+            <span class="ops-task-state">queued</span>
+          </div>
+          <div class="ops-progress"><span></span></div>`;
+        li.querySelector('.ops-task-name').textContent = `#${task.id} ${task.label} · ${task.priority}`;
+        tasksEl.append(li);
+        task.el = li;
+        task.stateEl = li.querySelector('.ops-task-state');
+        task.barEl = li.querySelector('.ops-progress > span');
+      }
+
+      function setState(task, state, detail) {
+        task.el.classList.remove('queued', 'running', 'done');
+        task.el.classList.add(state);
+        task.stateEl.textContent = detail || state;
+      }
+
+      // Simulated CPU-bound work bounded to CHUNK_MS per slice.
+      function doChunk() {
+        const start = performance.now();
+        let x = 0;
+        while (performance.now() - start < CHUNK_MS) {
+          x += Math.sqrt(Math.random() * 1000);
+        }
+        return x;
+      }
+
+      async function runTask(task) {
+        setState(task, 'running', 'running');
+        log(`▶ #${task.id} ${task.label} started (${task.priority})`);
+        const started = performance.now();
+
+        for (let i = 0; i < task.chunks; i++) {
+          doChunk();
+          const pct = ((i + 1) / task.chunks) * 100;
+          task.barEl.style.width = `${pct}%`;
+          const verb = task.verbs[Math.min(task.verbs.length - 1, Math.floor((i / task.chunks) * task.verbs.length))];
+          task.stateEl.textContent = `${verb} ${Math.round(pct)}%`;
+          // Hand control back to the browser so input and rendering can run,
+          // and so higher-priority tasks can preempt between chunks.
+          if (i < task.chunks - 1) await sched.yield(task.priority);
+        }
+
+        const elapsed = performance.now() - started;
+        setState(task, 'done', `done · ${Math.round(elapsed)} ms`);
+        log(`✔ #${task.id} ${task.label} finished in ${Math.round(elapsed)} ms`);
+        active--;
+        completed++;
+        updateCounters();
+      }
+
+      function enqueue(type) {
+        const def = TASK_TYPES[type];
+        const task = { id: nextId++, type, ...def };
+        renderTask(task);
+        active++;
+        updateCounters();
+        log(`+ #${task.id} ${task.label} queued (${task.priority})`);
+        sched.postTask(() => runTask(task), task.priority).catch((err) => {
+          log(`✖ #${task.id} ${task.label} failed: ${err && err.message ? err.message : err}`);
+          setState(task, 'done', 'failed');
+          active--;
+          updateCounters();
+        });
+        return task;
+      }
+
+      // ---- Controls ---------------------------------------------------------
+      root.querySelectorAll('[data-task]').forEach((btn) => {
+        btn.addEventListener('click', () => enqueue(btn.dataset.task));
+      });
+
+      document.getElementById('ops-batch').addEventListener('click', () => {
+        // Submit in deliberately mixed order; the scheduler executes by priority.
+        const batch = ['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu', 'telemetry', 'checkout'];
+        log(`⧉ Mixed batch submitted: ${batch.length} tasks in arrival order ${batch.join(', ')}`);
+        batch.forEach(enqueue);
+      });
+
+      document.getElementById('ops-clear').addEventListener('click', () => {
+        tasksEl.querySelectorAll('.ops-task.done').forEach((el) => el.remove());
+        if (!tasksEl.children.length) {
+          const li = document.createElement('li');
+          li.className = 'ops-empty';
+          li.textContent = 'No tasks yet. Use the buttons above.';
+          tasksEl.append(li);
+        }
+      });
+
+      // ---- Responsiveness monitor ------------------------------------------
+      // Track the longest gap between animation frames as a proxy for main-thread blocking.
+      let lastFrame = performance.now();
+      function frame(now) {
+        const gap = now - lastFrame;
+        lastFrame = now;
+        if (active > 0 && gap > longestBlock) {
+          longestBlock = gap;
+          longestEl.textContent = `${longestBlock.toFixed(1)} ms`;
+        }
+        requestAnimationFrame(frame);
+      }
+      requestAnimationFrame(frame);
+
+      updateCounters();
+    })();
+  </script>
+
 </body>
 
