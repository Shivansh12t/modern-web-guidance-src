+  <script type="module">
+    // ---- Scheduler setup -------------------------------------------------
+    // The Prioritized Task Scheduling API isn't in every browser (e.g. Safari),
+    // and this simulator depends on cross-priority ordering + TaskController,
+    // so load the polyfill only when the native API is missing.
+    const engineNote = document.getElementById('ops-engine');
+    let engine = 'native scheduler.postTask()';
+    if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+      try {
+        await import('https://esm.sh/scheduler-polyfill@1');
+        engine = 'scheduler-polyfill';
+      } catch (err) {
+        console.error('Failed to load scheduler polyfill', err);
+      }
+    }
+    const hasScheduler = 'scheduler' in window && 'postTask' in window.scheduler;
+    engineNote.textContent = hasScheduler
+      ? `Scheduling engine: ${engine}. Priorities: user-blocking › user-visible › background.`
+      : 'Scheduling engine unavailable — tasks run in submission order via setTimeout.';
+
+    // Yield to the main thread so input and rendering can happen.
+    // Inside a postTask() callback, scheduler.yield() continuations inherit
+    // the task's priority and signal.
+    function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        return scheduler.yield();
+      }
+      return new Promise((resolve) => setTimeout(resolve, 0));
+    }
+
+    function postTask(callback, { signal } = {}) {
+      if (hasScheduler) return scheduler.postTask(callback, { signal });
+      return new Promise((resolve, reject) => {
+        setTimeout(() => {
+          if (signal?.aborted) return reject(signal.reason ?? new DOMException('Aborted', 'AbortError'));
+          Promise.resolve().then(callback).then(resolve, reject);
+        }, 0);
+      });
+    }
+
+    // ---- Task catalog ----------------------------------------------------
+    const TASKS = {
+      checkout: {
+        label: 'Checkout',
+        priority: 'user-blocking',
+        workMs: 350,
+        details: ['Validate cart', 'Authorize card', 'Print ticket for barista'],
+      },
+      menu: {
+        label: 'Menu update',
+        priority: 'user-visible',
+        workMs: 900,
+        details: ['Recalculate seasonal pricing', 'Sync allergen data', 'Refresh menu boards'],
+      },
+      telemetry: {
+        label: 'Telemetry log',
+        priority: 'background',
+        workMs: 1600,
+        details: ['Aggregate grinder metrics', 'Compress espresso shot logs', 'Batch upload analytics'],
+      },
+    };
+
+    // ---- DOM refs & state ------------------------------------------------
+    const queueEl = document.getElementById('ops-queue');
+    const logEl = document.getElementById('ops-log');
+    const pendingEl = document.getElementById('ops-pending');
+    const doneEl = document.getElementById('ops-done');
+    const gapEl = document.getElementById('ops-gap');
+    const tapsEl = document.getElementById('ops-taps');
+
+    let nextId = 1;
+    let pending = 0;
+    let completed = 0;
+    let runOrder = 0;
+    let taps = 0;
+    // One controller shared by all background tasks so they can be cancelled together.
+    let backgroundController = null;
+
+    function signalFor(priority) {
+      if (!hasScheduler) {
+        if (priority !== 'background') return undefined;
+        backgroundController ??= new AbortController();
+        return backgroundController.signal;
+      }
+      if (priority === 'background') {
+        backgroundController ??= new TaskController({ priority: 'background' });
+        return backgroundController.signal;
+      }
+      // Fresh controller per task so the priority travels with the signal
+      // (and any scheduler.yield() continuations inside it).
+      return new TaskController({ priority }).signal;
+    }
+
+    function updateCounters() {
+      pendingEl.textContent = pending;
+      doneEl.textContent = completed;
+    }
+
+    function createRow(id, def) {
+      const li = document.createElement('li');
+      li.className = 'ops-task';
+      li.dataset.state = 'queued';
+      li.innerHTML = `
+        <span class="ops-badge" data-priority="${def.priority}">${def.priority}</span>
+        <span class="ops-name">#${id} ${def.label}</span>
+        <span class="ops-status">queued</span>
+        <progress max="100" value="0" aria-label="#${id} ${def.label} progress"></progress>`;
+      queueEl.append(li);
+      return li;
+    }
+
+    function addLog(text) {
+      const li = document.createElement('li');
+      li.textContent = text;
+      logEl.append(li);
+      li.scrollIntoView({ block: 'nearest' });
+    }
+
+    // Busy-wait to simulate synchronous CPU work for a slice of time.
+    function burn(ms) {
+      const end = performance.now() + ms;
+      while (performance.now() < end) { /* simulated processing */ }
+    }
+
+    // ---- Run a task ------------------------------------------------------
+    function enqueue(type) {
+      const def = TASKS[type];
+      const id = nextId++;
+      const row = createRow(id, def);
+      const status = row.querySelector('.ops-status');
+      const bar = row.querySelector('progress');
+      const queuedAt = performance.now();
+      pending++;
+      updateCounters();
+
+      const signal = signalFor(def.priority);
+
+      return postTask(async () => {
+        row.dataset.state = 'running';
+        const startedAt = performance.now();
+        const stepMs = def.workMs / def.details.length;
+        let deadline = performance.now() + 50;
+
+        for (let step = 0; step < def.details.length; step++) {
+          status.textContent = def.details[step];
+          let stepDone = 0;
+          while (stepDone < stepMs) {
+            const slice = Math.min(5, stepMs - stepDone);
+            burn(slice);
+            stepDone += slice;
+            bar.value = Math.round(((step * stepMs + stepDone) / def.workMs) * 100);
+
+            // Yield whenever we've held the main thread for ~50ms so
+            // clicks and paints never wait behind a long task.
+            if (performance.now() >= deadline) {
+              await yieldToMain();
+              if (signal?.aborted) throw signal.reason ?? new DOMException('Aborted', 'AbortError');
+              deadline = performance.now() + 50;
+            }
+          }
+        }
+        return { startedAt, finishedAt: performance.now() };
+      }, { signal })
+        .then(({ startedAt, finishedAt }) => {
+          completed++;
+          runOrder++;
+          addLog(`${runOrder}. #${id} ${def.label} [${def.priority}] — waited ${Math.round(startedAt - queuedAt)} ms, total ${Math.round(finishedAt - queuedAt)} ms`);
+          row.remove();
+        })
+        .catch((err) => {
+          if (err?.name !== 'AbortError') {
+            console.error(err);
+            addLog(`#${id} ${def.label} failed: ${err?.message ?? err}`);
+            row.remove();
+            return;
+          }
+          row.dataset.state = 'cancelled';
+          status.textContent = 'cancelled';
+          addLog(`#${id} ${def.label} [${def.priority}] — cancelled`);
+          setTimeout(() => row.remove(), 1200);
+        })
+        .finally(() => {
+          pending--;
+          updateCounters();
+        });
+    }
+
+    // ---- Controls --------------------------------------------------------
+    document.querySelectorAll('.ops-controls [data-task]').forEach((btn) => {
+      btn.addEventListener('click', () => enqueue(btn.dataset.task));
+    });
+
+    // Submit a deliberately shuffled mix; the scheduler executes it by priority.
+    document.getElementById('ops-batch').addEventListener('click', () => {
+      const mix = ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout', 'telemetry', 'checkout'];
+      addLog(`Batch submitted in order: ${mix.map((t) => TASKS[t].label).join(', ')}`);
+      mix.forEach(enqueue);
+    });
+
+    document.getElementById('ops-cancel').addEventListener('click', () => {
+      if (!backgroundController) return;
+      backgroundController.abort();
+      backgroundController = null;
+    });
+
+    document.getElementById('ops-clear').addEventListener('click', () => {
+      logEl.replaceChildren();
+      runOrder = 0;
+    });
+
+    document.getElementById('ops-tap').addEventListener('click', () => {
+      tapsEl.textContent = ++taps;
+    });
+
+    // ---- Responsiveness monitor -----------------------------------------
+    // Tracks the longest gap between animation frames while work is pending.
+    let lastFrame = performance.now();
+    let longestGap = 0;
+    function onFrame(now) {
+      const gap = now - lastFrame;
+      lastFrame = now;
+      if (pending > 0 && gap > longestGap) {
+        longestGap = gap;
+        gapEl.textContent = `${Math.round(gap)} ms`;
+      }
+      requestAnimationFrame(onFrame);
+    }
+    requestAnimationFrame(onFrame);
+  </script>
+
 </body>
 
