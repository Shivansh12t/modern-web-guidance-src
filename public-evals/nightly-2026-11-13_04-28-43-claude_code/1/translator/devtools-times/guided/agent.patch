--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,221 @@
+/**
+ * On-device translation helpers built on the browser's built-in Translator API
+ * (Chrome 138+ / Edge 148+ desktop). Nothing is sent to a server: the browser
+ * downloads a language pack once and translates locally afterwards.
+ *
+ * Content opts in to translation with a `data-translatable` attribute. Only text
+ * nodes are rewritten, so links, emphasis and other inline markup survive.
+ */
+
+export const TRANSLATABLE_SELECTOR = '[data-translatable]';
+
+export const LANGUAGES: { code: string; label: string }[] = [
+  { code: 'ar', label: 'العربية (Arabic)' },
+  { code: 'bg', label: 'Български (Bulgarian)' },
+  { code: 'bn', label: 'বাংলা (Bengali)' },
+  { code: 'cs', label: 'Čeština (Czech)' },
+  { code: 'da', label: 'Dansk (Danish)' },
+  { code: 'de', label: 'Deutsch (German)' },
+  { code: 'el', label: 'Ελληνικά (Greek)' },
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Español (Spanish)' },
+  { code: 'fi', label: 'Suomi (Finnish)' },
+  { code: 'fr', label: 'Français (French)' },
+  { code: 'he', label: 'עברית (Hebrew)' },
+  { code: 'hi', label: 'हिन्दी (Hindi)' },
+  { code: 'hr', label: 'Hrvatski (Croatian)' },
+  { code: 'hu', label: 'Magyar (Hungarian)' },
+  { code: 'id', label: 'Bahasa Indonesia (Indonesian)' },
+  { code: 'it', label: 'Italiano (Italian)' },
+  { code: 'ja', label: '日本語 (Japanese)' },
+  { code: 'kn', label: 'ಕನ್ನಡ (Kannada)' },
+  { code: 'ko', label: '한국어 (Korean)' },
+  { code: 'lt', label: 'Lietuvių (Lithuanian)' },
+  { code: 'mr', label: 'मराठी (Marathi)' },
+  { code: 'nl', label: 'Nederlands (Dutch)' },
+  { code: 'no', label: 'Norsk (Norwegian)' },
+  { code: 'pl', label: 'Polski (Polish)' },
+  { code: 'pt', label: 'Português (Portuguese)' },
+  { code: 'ro', label: 'Română (Romanian)' },
+  { code: 'ru', label: 'Русский (Russian)' },
+  { code: 'sk', label: 'Slovenčina (Slovak)' },
+  { code: 'sl', label: 'Slovenščina (Slovenian)' },
+  { code: 'sv', label: 'Svenska (Swedish)' },
+  { code: 'ta', label: 'தமிழ் (Tamil)' },
+  { code: 'te', label: 'తెలుగు (Telugu)' },
+  { code: 'th', label: 'ไทย (Thai)' },
+  { code: 'tr', label: 'Türkçe (Turkish)' },
+  { code: 'uk', label: 'Українська (Ukrainian)' },
+  { code: 'vi', label: 'Tiếng Việt (Vietnamese)' },
+  { code: 'zh', label: '简体中文 (Chinese, Simplified)' },
+  { code: 'zh-Hant', label: '繁體中文 (Chinese, Traditional)' },
+];
+
+const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self;
+}
+
+/** Primary language subtag of the content, e.g. "en" for `lang="en-US"`. */
+export function getContentLanguage(el: Element = document.documentElement): string {
+  const lang = el.closest('[lang]')?.getAttribute('lang') || 'en';
+  return lang === 'zh-Hant' ? lang : lang.split('-')[0].toLowerCase();
+}
+
+// ---------------------------------------------------------------------------
+// Translator instances (one per language pair, reused across page navigations)
+// ---------------------------------------------------------------------------
+
+const translators = new Map<string, Promise<Translator>>();
+
+export function getPairAvailability(sourceLanguage: string, targetLanguage: string) {
+  return Translator.availability({ sourceLanguage, targetLanguage });
+}
+
+/**
+ * Creates (or reuses) a translator. When the language pack still needs to be
+ * downloaded this MUST be called from a user gesture, otherwise the browser
+ * rejects with NotAllowedError.
+ */
+export function getTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onDownloadProgress?: (fraction: number) => void,
+): Promise<Translator> {
+  const key = `${sourceLanguage}>${targetLanguage}`;
+  let pending = translators.get(key);
+  if (!pending) {
+    pending = Translator.create({
+      sourceLanguage,
+      targetLanguage,
+      monitor(m) {
+        m.addEventListener('downloadprogress', (e) => onDownloadProgress?.(e.loaded));
+      },
+    });
+    // Don't cache failures (e.g. missing user activation) so the user can retry.
+    pending.catch(() => translators.delete(key));
+    translators.set(key, pending);
+  }
+  return pending;
+}
+
+// ---------------------------------------------------------------------------
+// DOM translation
+// ---------------------------------------------------------------------------
+
+/** Original text for every text node we've touched. */
+const originalText = new WeakMap<Text, string>();
+/** Original lang/dir attributes of every translated container. */
+const originalAttrs = new WeakMap<HTMLElement, { lang: string | null; dir: string | null }>();
+/** Per-language cache of translated strings (teasers repeat across pages). */
+const translationCache = new Map<string, Map<string, string>>();
+
+const SKIP_PARENTS = 'script, style, code, pre, svg, [translate="no"]';
+
+function collectTextNodes(root: Element): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      if (!node.nodeValue?.trim()) return NodeFilter.FILTER_REJECT;
+      if (node.parentElement?.closest(SKIP_PARENTS)) return NodeFilter.FILTER_REJECT;
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function getTranslatableRoots(): HTMLElement[] {
+  const all = Array.from(document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR));
+  // Ignore roots nested inside other roots so text isn't processed twice.
+  return all.filter((el) => !el.parentElement?.closest(TRANSLATABLE_SELECTOR));
+}
+
+export function hasTranslatableContent(): boolean {
+  return document.querySelector(TRANSLATABLE_SELECTOR) !== null;
+}
+
+export interface TranslateProgress {
+  done: number;
+  total: number;
+}
+
+export async function translatePage(
+  translator: Translator,
+  targetLanguage: string,
+  { signal, onProgress }: { signal?: AbortSignal; onProgress?: (p: TranslateProgress) => void } = {},
+): Promise<void> {
+  const roots = getTranslatableRoots();
+  const work = roots.map((root) => ({ root, nodes: collectTextNodes(root) }));
+  const total = work.reduce((sum, w) => sum + w.nodes.length, 0);
+  let done = 0;
+  onProgress?.({ done, total });
+
+  let cache = translationCache.get(targetLanguage);
+  if (!cache) translationCache.set(targetLanguage, (cache = new Map()));
+
+  for (const { root, nodes } of work) {
+    for (const node of nodes) {
+      signal?.throwIfAborted();
+      if (!node.isConnected) continue;
+
+      if (!originalText.has(node)) originalText.set(node, node.nodeValue ?? '');
+      const original = originalText.get(node)!;
+      // Keep surrounding whitespace so inline markup stays correctly spaced.
+      const [, lead, core, trail] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+
+      let translated = cache.get(core);
+      if (translated === undefined) {
+        translated = await translator.translate(core, { signal });
+        cache.set(core, translated);
+      }
+      if (node.isConnected) node.nodeValue = lead + translated + trail;
+      onProgress?.({ done: ++done, total });
+    }
+
+    if (!originalAttrs.has(root)) {
+      originalAttrs.set(root, { lang: root.getAttribute('lang'), dir: root.getAttribute('dir') });
+    }
+    root.lang = targetLanguage;
+    root.dir = RTL_LANGUAGES.has(targetLanguage) ? 'rtl' : 'ltr';
+    root.dataset.translated = targetLanguage;
+  }
+}
+
+export function restorePage(): void {
+  for (const root of getTranslatableRoots()) {
+    for (const node of collectTextNodes(root)) {
+      const original = originalText.get(node);
+      if (original !== undefined) node.nodeValue = original;
+    }
+    const attrs = originalAttrs.get(root);
+    if (attrs) {
+      attrs.lang === null ? root.removeAttribute('lang') : root.setAttribute('lang', attrs.lang);
+      attrs.dir === null ? root.removeAttribute('dir') : root.setAttribute('dir', attrs.dir);
+    }
+    delete root.dataset.translated;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Preference persistence
+// ---------------------------------------------------------------------------
+
+const STORAGE_KEY = 'devtools-times:translation-target';
+
+export function getSavedTargetLanguage(): string | null {
+  try {
+    return localStorage.getItem(STORAGE_KEY);
+  } catch {
+    return null;
+  }
+}
+
+export function saveTargetLanguage(lang: string | null): void {
+  try {
+    lang ? localStorage.setItem(STORAGE_KEY, lang) : localStorage.removeItem(STORAGE_KEY);
+  } catch {
+    /* storage unavailable (private mode etc.) — preference just won't persist */
+  }
+}
