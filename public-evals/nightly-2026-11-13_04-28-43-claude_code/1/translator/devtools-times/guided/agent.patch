diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..2d53b15
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,229 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  getContentLanguage,
+  getPairAvailability,
+  getSavedTargetLanguage,
+  getTranslator,
+  hasTranslatableContent,
+  isTranslatorSupported,
+  restorePage,
+  saveTargetLanguage,
+  translatePage,
+} from '../utils/translation';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'checking' }
+  | { kind: 'downloading'; progress: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'translated'; lang: string }
+  | { kind: 'needs-download'; lang: string }
+  | { kind: 'unavailable' }
+  | { kind: 'same-language' }
+  | { kind: 'error'; message: string };
+
+const labelFor = (code: string) => LANGUAGES.find((l) => l.code === code)?.label ?? code;
+
+function defaultTarget(source: string): string {
+  const saved = getSavedTargetLanguage();
+  if (saved && LANGUAGES.some((l) => l.code === saved)) return saved;
+  for (const pref of navigator.languages ?? []) {
+    const code = pref.split('-')[0];
+    if (code !== source && LANGUAGES.some((l) => l.code === code)) return code;
+  }
+  return source === 'es' ? 'en' : 'es';
+}
+
+export default function TranslateControl() {
+  const panelId = useId();
+  const selectId = useId();
+  const [supported] = useState(isTranslatorSupported);
+  const [hasContent] = useState(hasTranslatableContent);
+  const [sourceLanguage] = useState(() => getContentLanguage());
+  const [target, setTarget] = useState(() => defaultTarget(sourceLanguage));
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const abortRef = useRef<AbortController | null>(null);
+
+  const busy = status.kind === 'checking' || status.kind === 'downloading' || status.kind === 'translating';
+  const translatedLang = status.kind === 'translated' ? status.lang : null;
+
+  async function run(lang: string, { userInitiated }: { userInitiated: boolean }) {
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+
+    if (lang === sourceLanguage) {
+      restorePage();
+      saveTargetLanguage(null);
+      setStatus({ kind: 'same-language' });
+      return;
+    }
+
+    try {
+      setStatus({ kind: 'checking' });
+      const availability = await getPairAvailability(sourceLanguage, lang);
+      if (controller.signal.aborted) return;
+
+      if (availability === 'unavailable') {
+        setStatus({ kind: 'unavailable' });
+        return;
+      }
+      if (availability !== 'available' && !userInitiated) {
+        // Downloading a language pack requires a user gesture; wait for a click.
+        setStatus({ kind: 'needs-download', lang });
+        return;
+      }
+
+      if (availability !== 'available') setStatus({ kind: 'downloading', progress: 0 });
+      const translator = await getTranslator(sourceLanguage, lang, (progress) => {
+        if (!controller.signal.aborted) setStatus({ kind: 'downloading', progress });
+      });
+      if (controller.signal.aborted) return;
+
+      await translatePage(translator, lang, {
+        signal: controller.signal,
+        onProgress: ({ done, total }) => setStatus({ kind: 'translating', done, total }),
+      });
+      saveTargetLanguage(lang);
+      setStatus({ kind: 'translated', lang });
+    } catch (err) {
+      if (controller.signal.aborted) return;
+      const name = err instanceof DOMException ? err.name : '';
+      setStatus({
+        kind: 'error',
+        message:
+          name === 'NotAllowedError'
+            ? 'Please click “Translate” again to start the language download.'
+            : name === 'QuotaExceededError'
+              ? 'This text is too long to translate on your device.'
+              : 'Translation failed. Please try again.',
+      });
+    }
+  }
+
+  function showOriginal() {
+    abortRef.current?.abort();
+    restorePage();
+    saveTargetLanguage(null);
+    setStatus({ kind: 'idle' });
+  }
+
+  // Re-apply the reader's saved language on page load / client-side navigation,
+  // as long as the language pack is already on the device (no gesture needed).
+  useEffect(() => {
+    if (supported && hasContent && getSavedTargetLanguage()) {
+      run(target, { userInitiated: false });
+    }
+    return () => abortRef.current?.abort();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  if (!hasContent) return null;
+
+  let message: React.ReactNode = 'Articles are translated privately on your device. No text is sent to a server.';
+  if (!supported) {
+    message = 'On-device translation isn’t supported in this browser. Try a recent desktop version of Chrome or Edge.';
+  } else if (status.kind === 'checking') {
+    message = 'Checking language support…';
+  } else if (status.kind === 'downloading') {
+    message = `Downloading language pack… ${Math.round(status.progress * 100)}%`;
+  } else if (status.kind === 'translating') {
+    message = `Translating… ${status.done} of ${status.total}`;
+  } else if (status.kind === 'translated') {
+    message = `Translated to ${labelFor(status.lang)} on your device. Machine translations may contain errors.`;
+  } else if (status.kind === 'needs-download') {
+    message = `Click “Translate” to download the ${labelFor(status.lang)} language pack.`;
+  } else if (status.kind === 'unavailable') {
+    message = `Translating to ${labelFor(target)} isn’t available on this device.`;
+  } else if (status.kind === 'same-language') {
+    message = 'This page is already in that language.';
+  } else if (status.kind === 'error') {
+    message = status.message;
+  }
+
+  return (
+    <>
+      <button
+        type="button"
+        popoverTarget={panelId}
+        className="translate-trigger flex items-center gap-1 p-1 text-gray-600 hover:text-gray-900"
+        aria-label={translatedLang ? `Translation: ${labelFor(translatedLang)}` : 'Translate page'}
+      >
+        <LanguageIcon className="h-6 w-6" aria-hidden="true" />
+        <span className="text-xs font-semibold" aria-hidden="true">
+          {translatedLang ? translatedLang.toUpperCase() : 'Translate'}
+        </span>
+      </button>
+
+      <div
+        id={panelId}
+        popover="auto"
+        role="dialog"
+        aria-labelledby={`${panelId}-title`}
+        className="translate-panel w-72 rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-700 shadow-lg"
+      >
+        <h2 id={`${panelId}-title`} className="mb-3 font-semibold text-gray-900">
+          Translate articles
+        </h2>
+
+        <form
+          onSubmit={(e) => {
+            e.preventDefault();
+            run(target, { userInitiated: true });
+          }}
+        >
+          <label htmlFor={selectId} className="mb-1 block text-xs font-medium text-gray-600">
+            Translate from {labelFor(sourceLanguage)} to
+          </label>
+          <select
+            id={selectId}
+            value={target}
+            disabled={!supported}
+            onChange={(e) => {
+              setTarget(e.target.value);
+              if (status.kind !== 'translated' && !busy) setStatus({ kind: 'idle' });
+            }}
+            className="mb-3 w-full rounded border border-gray-300 bg-white px-2 py-1.5 text-gray-900 disabled:opacity-50"
+          >
+            {LANGUAGES.filter((l) => l.code !== sourceLanguage).map((l) => (
+              <option key={l.code} value={l.code}>
+                {l.label}
+              </option>
+            ))}
+          </select>
+
+          <div className="flex gap-2">
+            <button
+              type="submit"
+              disabled={!supported || busy || translatedLang === target}
+              className="flex-1 rounded bg-gray-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50"
+            >
+              Translate
+            </button>
+            <button
+              type="button"
+              onClick={showOriginal}
+              disabled={!supported || (!translatedLang && !busy)}
+              className="flex-1 rounded border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50"
+            >
+              Show original
+            </button>
+          </div>
+        </form>
+
+        {status.kind === 'downloading' && (
+          <progress className="mt-3 h-1.5 w-full" max={1} value={status.progress} aria-hidden="true" />
+        )}
+        {status.kind === 'translating' && status.total > 0 && (
+          <progress className="mt-3 h-1.5 w-full" max={status.total} value={status.done} aria-hidden="true" />
+        )}
+
+        <p role="status" className="mt-3 text-xs text-gray-500">
+          {message}
+        </p>
+      </div>
+    </>
+  );
+}
