diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..2efecfd
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,316 @@
+import React, { useEffect, useId, useMemo, useRef, useState, useSyncExternalStore } from 'react';
+import { LanguageIcon, XMarkIcon } from '@heroicons/react/24/outline';
+import {
+  getAvailability,
+  getLanguageOptions,
+  getPageLanguage,
+  getSuggestedLanguage,
+  getTranslationState,
+  languageLabel,
+  showOriginal,
+  subscribeTranslation,
+  translatePage,
+  type TranslationState,
+} from '../utils/translation';
+
+interface Props {
+  /** `header`: compact button with a popover. `inline`: full-width bar (used above article bodies). */
+  variant?: 'header' | 'inline';
+}
+
+const SERVER_STATE: TranslationState = {
+  supported: false,
+  status: 'idle',
+  targetLanguage: null,
+  pendingLanguage: null,
+  sourceLanguages: [],
+  progress: { done: 0, total: 0 },
+  downloadProgress: null,
+  error: null,
+};
+
+function useTranslationState() {
+  return useSyncExternalStore(subscribeTranslation, getTranslationState, () => SERVER_STATE);
+}
+
+function isBusy(state: TranslationState) {
+  return state.status === 'preparing' || state.status === 'downloading' || state.status === 'translating';
+}
+
+const AVAILABILITY_HINT: Record<AIAvailability, string> = {
+  available: 'Ready on this device',
+  downloadable: 'One-time language pack download required',
+  downloading: 'Language pack is downloading…',
+  unavailable: 'Not available on this device',
+};
+
+export default function TranslateControl({ variant = 'header' }: Props) {
+  const state = useTranslationState();
+  const [open, setOpen] = useState(false);
+  const containerRef = useRef<HTMLDivElement>(null);
+  const panelId = useId();
+
+  useEffect(() => {
+    if (!open) return;
+    const onPointerDown = (event: PointerEvent) => {
+      if (!containerRef.current?.contains(event.target as Node)) setOpen(false);
+    };
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') setOpen(false);
+    };
+    document.addEventListener('pointerdown', onPointerDown);
+    document.addEventListener('keydown', onKeyDown);
+    return () => {
+      document.removeEventListener('pointerdown', onPointerDown);
+      document.removeEventListener('keydown', onKeyDown);
+    };
+  }, [open]);
+
+  if (variant === 'inline') {
+    return (
+      <div
+        translate="no"
+        className="notranslate not-prose my-6 rounded-md border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700"
+      >
+        <TranslatePanel state={state} layout="inline" />
+      </div>
+    );
+  }
+
+  const busy = isBusy(state);
+  const active = state.targetLanguage && state.status !== 'error';
+
+  return (
+    <div ref={containerRef} className="notranslate relative" translate="no">
+      <button
+        type="button"
+        onClick={() => setOpen((value) => !value)}
+        aria-expanded={open}
+        aria-controls={panelId}
+        aria-label={active ? `Translated to ${languageLabel(state.targetLanguage!)}. Change translation` : 'Translate articles'}
+        title="Translate articles on this device"
+        className={`flex items-center gap-1 rounded p-1 text-xs font-semibold transition-colors hover:text-amber-400 ${
+          active ? 'text-amber-600' : 'text-gray-600'
+        }`}
+      >
+        {busy ? (
+          <span className="block h-5 w-5 animate-spin rounded-full border-2 border-amber-400 border-t-transparent" aria-hidden="true" />
+        ) : (
+          <LanguageIcon className="h-6 w-6" aria-hidden="true" />
+        )}
+        <span className="hidden sm:inline">
+          {active ? state.targetLanguage!.toUpperCase() : 'Translate'}
+        </span>
+        {state.pendingLanguage && !active && (
+          <span className="h-2 w-2 rounded-full bg-amber-400" aria-hidden="true" />
+        )}
+      </button>
+
+      {open && (
+        <div
+          id={panelId}
+          role="dialog"
+          aria-label="Translate articles"
+          className="absolute left-0 top-full z-50 mt-2 w-80 rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-700 shadow-lg"
+        >
+          <div className="mb-3 flex items-start justify-between gap-2">
+            <div>
+              <h2 className="font-semibold text-gray-900">Translate articles</h2>
+              <p className="mt-0.5 text-xs text-gray-500">
+                Runs entirely in your browser — article text never leaves your device.
+              </p>
+            </div>
+            <button
+              type="button"
+              onClick={() => setOpen(false)}
+              className="rounded p-0.5 text-gray-400 hover:text-gray-700"
+              aria-label="Close"
+            >
+              <XMarkIcon className="h-5 w-5" aria-hidden="true" />
+            </button>
+          </div>
+          <TranslatePanel state={state} layout="stacked" />
+        </div>
+      )}
+    </div>
+  );
+}
+
+interface PanelProps {
+  state: TranslationState;
+  layout: 'stacked' | 'inline';
+}
+
+function TranslatePanel({ state, layout }: PanelProps) {
+  const selectId = useId();
+  const options = useMemo(() => getLanguageOptions(), []);
+  const pageLanguage = useMemo(() => getPageLanguage(), []);
+  const [selected, setSelected] = useState<string>(
+    () => state.targetLanguage ?? state.pendingLanguage ?? getSuggestedLanguage() ?? 'es',
+  );
+  const [availability, setAvailability] = useState<AIAvailability | null>(null);
+
+  // Keep the picker in sync when another control changes the language.
+  useEffect(() => {
+    const next = state.targetLanguage ?? state.pendingLanguage;
+    if (next) setSelected(next);
+  }, [state.targetLanguage, state.pendingLanguage]);
+
+  useEffect(() => {
+    if (!state.supported) return;
+    let cancelled = false;
+    setAvailability(null);
+    getAvailability(selected).then((result) => {
+      if (!cancelled) setAvailability(result);
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [selected, state.supported, state.status]);
+
+  if (!state.supported) {
+    return (
+      <p className={layout === 'inline' ? 'flex items-center gap-2' : ''}>
+        {layout === 'inline' && <LanguageIcon className="h-5 w-5 shrink-0 text-gray-400" aria-hidden="true" />}
+        <span>
+          On-device translation needs a browser with the built-in{' '}
+          <a
+            href="https://developer.chrome.com/docs/ai/translator-api"
+            target="_blank"
+            rel="noopener noreferrer"
+            className="text-amber-700 underline hover:text-amber-500"
+          >
+            Translator API
+          </a>{' '}
+          (Chrome 138 or later on desktop).
+        </span>
+      </p>
+    );
+  }
+
+  const busy = isBusy(state);
+  const translatedTo = state.status === 'translated' ? state.targetLanguage : null;
+  const isCurrent = translatedTo === selected;
+  const isSource = selected === pageLanguage && !state.targetLanguage;
+  const disabled = busy || availability === 'unavailable' || isCurrent || isSource;
+
+  const onTranslate = () => {
+    // Called directly from the click handler so the user activation can authorise a model download.
+    void translatePage(selected);
+  };
+
+  const picker = (
+    <div className={`flex items-center gap-2 ${layout === 'inline' ? 'flex-wrap' : ''}`}>
+      <label htmlFor={selectId} className={layout === 'inline' ? 'flex items-center gap-2 font-medium' : 'sr-only'}>
+        {layout === 'inline' && <LanguageIcon className="h-5 w-5 text-gray-500" aria-hidden="true" />}
+        {layout === 'inline' ? 'Read this article in' : 'Target language'}
+      </label>
+      <select
+        id={selectId}
+        value={selected}
+        onChange={(event) => setSelected(event.target.value)}
+        disabled={busy}
+        className="min-w-0 flex-1 rounded border border-gray-300 bg-white px-2 py-1.5 text-sm focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400 disabled:opacity-60"
+      >
+        {options.map((option) => (
+          <option key={option.code} value={option.code}>
+            {option.label}
+          </option>
+        ))}
+      </select>
+      <button
+        type="button"
+        onClick={onTranslate}
+        disabled={disabled}
+        className="whitespace-nowrap rounded bg-gray-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:bg-gray-400"
+      >
+        {state.pendingLanguage === selected ? 'Continue' : 'Translate'}
+      </button>
+      {state.targetLanguage && !busy && (
+        <button
+          type="button"
+          onClick={showOriginal}
+          className="whitespace-nowrap rounded border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-100"
+        >
+          Show original
+        </button>
+      )}
+    </div>
+  );
+
+  return (
+    <div className={layout === 'inline' ? 'space-y-2' : 'space-y-3'}>
+      {picker}
+      <div aria-live="polite" className="text-xs text-gray-500">
+        <StatusLine state={state} availability={availability} selected={selected} pageLanguage={pageLanguage} />
+      </div>
+    </div>
+  );
+}
+
+function StatusLine({
+  state,
+  availability,
+  selected,
+  pageLanguage,
+}: {
+  state: TranslationState;
+  availability: AIAvailability | null;
+  selected: string;
+  pageLanguage: string;
+}) {
+  if (state.status === 'downloading') {
+    const percent = Math.round((state.downloadProgress ?? 0) * 100);
+    return <ProgressBar label={`Downloading language pack… ${percent}%`} value={state.downloadProgress ?? 0} />;
+  }
+
+  if (state.status === 'preparing' || state.status === 'translating') {
+    const { done, total } = state.progress;
+    return (
+      <ProgressBar
+        label={`Translating into ${languageLabel(state.targetLanguage ?? selected)}… ${done}/${total}`}
+        value={total ? done / total : 0}
+      />
+    );
+  }
+
+  if (state.status === 'error' && state.error) {
+    return <p className="text-red-700">{state.error}</p>;
+  }
+
+  if (state.status === 'translated' && state.targetLanguage) {
+    const from = state.sourceLanguages.length
+      ? state.sourceLanguages.map((code) => languageLabel(code)).join(', ')
+      : null;
+    return (
+      <p>
+        {from
+          ? `Translated from ${from} to ${languageLabel(state.targetLanguage)}.`
+          : `This page is already in ${languageLabel(state.targetLanguage)}.`}{' '}
+        Machine translation may contain errors.
+        {state.error && <span className="block text-amber-700">{state.error}</span>}
+      </p>
+    );
+  }
+
+  if (state.pendingLanguage) {
+    return <p>Your saved language needs a quick download before it can be applied. Click "Continue".</p>;
+  }
+
+  if (selected === pageLanguage) {
+    return <p>Articles are already written in {languageLabel(pageLanguage)}.</p>;
+  }
+
+  return <p>{availability ? AVAILABILITY_HINT[availability] : 'Checking availability…'}</p>;
+}
+
+function ProgressBar({ label, value }: { label: string; value: number }) {
+  return (
+    <div>
+      <p>{label}</p>
+      <div className="mt-1 h-1.5 w-full overflow-hidden rounded bg-gray-200" role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={Math.round(value * 100)}>
+        <div className="h-full bg-amber-400 transition-all" style={{ width: `${Math.max(4, value * 100)}%` }} />
+      </div>
+    </div>
+  );
+}
