diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..d93a101
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,484 @@
+/**
+ * On-device article translation for The DevTools Times.
+ *
+ * Uses Chrome's built-in Translator API (and, when present, the Language
+ * Detector API) so that article text never leaves the reader's device.
+ *
+ * Any element marked with `data-translatable` is picked up. Inside such an
+ * element every text node is translated individually, so links, emphasis and
+ * other inline markup are preserved. Original text is remembered so the page
+ * can be restored at any time.
+ *
+ * State lives in this module (a tiny observable store) so that multiple
+ * React islands (e.g. the header control and the inline article control)
+ * share one translation session, and it survives Astro <ClientRouter />
+ * navigations.
+ */
+
+export type TranslationStatus =
+  | 'unsupported'
+  | 'idle'
+  | 'preparing'
+  | 'downloading'
+  | 'translating'
+  | 'translated'
+  | 'error';
+
+export interface TranslationState {
+  supported: boolean;
+  status: TranslationStatus;
+  /** Language the page is currently translated (or being translated) into. */
+  targetLanguage: string | null;
+  /** Saved preference that could not be applied automatically (model needs a download, which requires a click). */
+  pendingLanguage: string | null;
+  /** Languages the translated content was detected/declared to be in. */
+  sourceLanguages: string[];
+  progress: { done: number; total: number };
+  /** Model download progress in the range 0..1, or null if not downloading. */
+  downloadProgress: number | null;
+  error: string | null;
+}
+
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+const STORAGE_KEY = 'devtools-times:translate-to';
+const SELECTOR = '[data-translatable]';
+const SKIP_SELECTOR = '[translate="no"], .notranslate, script, style, code, pre, kbd, samp, svg, math, textarea';
+const DETECTION_MIN_CONFIDENCE = 0.5;
+
+/** Languages offered in the picker. Chrome supports translating between these and English. */
+const LANGUAGE_CODES = [
+  'en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'sv', 'da', 'fi', 'no', 'cs', 'ro', 'hu', 'el',
+  'tr', 'ru', 'uk', 'bg', 'hr', 'lt', 'sl', 'he', 'ar', 'hi', 'bn', 'mr', 'ta', 'te', 'kn',
+  'th', 'vi', 'id', 'ja', 'ko', 'zh', 'zh-Hant',
+];
+
+const isBrowser = typeof window !== 'undefined' && typeof document !== 'undefined';
+
+export function isTranslatorSupported(): boolean {
+  return isBrowser && 'Translator' in self && typeof self.Translator?.create === 'function';
+}
+
+function isDetectorSupported(): boolean {
+  return isBrowser && 'LanguageDetector' in self && typeof self.LanguageDetector?.create === 'function';
+}
+
+/* ------------------------------------------------------------------ */
+/* Store                                                               */
+/* ------------------------------------------------------------------ */
+
+let state: TranslationState = {
+  supported: isTranslatorSupported(),
+  status: isTranslatorSupported() ? 'idle' : 'unsupported',
+  targetLanguage: null,
+  pendingLanguage: null,
+  sourceLanguages: [],
+  progress: { done: 0, total: 0 },
+  downloadProgress: null,
+  error: null,
+};
+
+const listeners = new Set<() => void>();
+
+function setState(patch: Partial<TranslationState>) {
+  state = { ...state, ...patch };
+  listeners.forEach((listener) => listener());
+}
+
+export function getTranslationState(): TranslationState {
+  return state;
+}
+
+export function subscribeTranslation(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+/* ------------------------------------------------------------------ */
+/* Language helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+/** Normalises a BCP 47 tag to the granularity the Translator API distinguishes. */
+export function normalizeLanguage(tag: string): string {
+  const lower = tag.trim().toLowerCase();
+  if (lower.startsWith('zh')) {
+    return /^zh-(hant|tw|hk|mo)/.test(lower) ? 'zh-Hant' : 'zh';
+  }
+  return lower.split(/[-_]/)[0] || 'en';
+}
+
+function sameLanguage(a: string, b: string): boolean {
+  return normalizeLanguage(a) === normalizeLanguage(b);
+}
+
+let displayNames: Intl.DisplayNames | null = null;
+let displayNamesLocale = '';
+
+/** Human-readable language name, e.g. "Spanish (español)". */
+export function languageLabel(code: string, uiLocale = 'en'): string {
+  try {
+    if (!displayNames || displayNamesLocale !== uiLocale) {
+      displayNames = new Intl.DisplayNames([uiLocale], { type: 'language' });
+      displayNamesLocale = uiLocale;
+    }
+    const name = displayNames.of(code) ?? code;
+    const native = new Intl.DisplayNames([code], { type: 'language' }).of(code);
+    return native && native.toLowerCase() !== name.toLowerCase() ? `${name} (${native})` : name;
+  } catch {
+    return code;
+  }
+}
+
+export function getLanguageOptions(): LanguageOption[] {
+  return LANGUAGE_CODES.map((code) => ({ code, label: languageLabel(code) })).sort((a, b) =>
+    a.label.localeCompare(b.label),
+  );
+}
+
+/** The language the page content is authored in. */
+export function getPageLanguage(): string {
+  if (!isBrowser) return 'en';
+  return normalizeLanguage(document.documentElement.lang || 'en');
+}
+
+/** Best guess at the reader's preferred language that differs from the page language. */
+export function getSuggestedLanguage(): string | null {
+  if (!isBrowser) return null;
+  const page = getPageLanguage();
+  for (const lang of navigator.languages ?? [navigator.language]) {
+    const normalized = normalizeLanguage(lang);
+    if (normalized !== page && LANGUAGE_CODES.includes(normalized)) return normalized;
+  }
+  return null;
+}
+
+/** Availability of a translation model from the page language into `target`. */
+export async function getAvailability(target: string, source = getPageLanguage()): Promise<AIAvailability> {
+  if (!isTranslatorSupported()) return 'unavailable';
+  if (sameLanguage(source, target)) return 'available';
+  try {
+    return await self.Translator!.availability({
+      sourceLanguage: normalizeLanguage(source),
+      targetLanguage: normalizeLanguage(target),
+    });
+  } catch {
+    return 'unavailable';
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Model management                                                    */
+/* ------------------------------------------------------------------ */
+
+const translators = new Map<string, Promise<TranslatorInstance>>();
+let detectorPromise: Promise<LanguageDetectorInstance | null> | null = null;
+
+function getTranslator(source: string, target: string, signal: AbortSignal): Promise<TranslatorInstance> {
+  const key = `${source}->${target}`;
+  let promise = translators.get(key);
+  if (!promise) {
+    promise = self.Translator!.create({
+      sourceLanguage: source,
+      targetLanguage: target,
+      monitor(monitor) {
+        monitor.addEventListener('downloadprogress', (event) => {
+          setState({ status: 'downloading', downloadProgress: event.loaded });
+        });
+      },
+    });
+    translators.set(key, promise);
+    promise.catch(() => translators.delete(key));
+  }
+  // Allow callers to stop waiting without tearing down a shared model.
+  return new Promise((resolve, reject) => {
+    const onAbort = () => reject(signal.reason ?? new DOMException('Aborted', 'AbortError'));
+    if (signal.aborted) return onAbort();
+    signal.addEventListener('abort', onAbort, { once: true });
+    promise!.then(resolve, reject).finally(() => signal.removeEventListener('abort', onAbort));
+  });
+}
+
+function getDetector(): Promise<LanguageDetectorInstance | null> {
+  if (!isDetectorSupported()) return Promise.resolve(null);
+  if (!detectorPromise) {
+    detectorPromise = (async () => {
+      try {
+        const availability = await self.LanguageDetector!.availability();
+        // Only use the detector if it is ready (or can be fetched); never block translation on it.
+        if (availability === 'unavailable') return null;
+        return await self.LanguageDetector!.create();
+      } catch {
+        return null;
+      }
+    })();
+  }
+  return detectorPromise;
+}
+
+/* ------------------------------------------------------------------ */
+/* DOM bookkeeping                                                     */
+/* ------------------------------------------------------------------ */
+
+/** Original text of every text node we have touched on the current page. */
+const originalText = new Map<Text, string>();
+/** Original `lang` attribute (or null) of every root element we have touched. */
+const originalLang = new Map<HTMLElement, string | null>();
+/** Translation cache: "src->tgt\u0000text" -> translated text. */
+const cache = new Map<string, string>();
+
+function collectRoots(): HTMLElement[] {
+  const all = Array.from(document.querySelectorAll<HTMLElement>(SELECTOR));
+  // Ignore roots nested inside another root – the outer one covers them.
+  return all.filter((el) => !el.parentElement?.closest(SELECTOR));
+}
+
+function collectTextNodes(root: HTMLElement): Text[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const text = originalText.get(node as Text) ?? node.nodeValue ?? '';
+      if (!text.trim()) return NodeFilter.FILTER_REJECT;
+      if (node.parentElement?.closest(SKIP_SELECTOR)) return NodeFilter.FILTER_REJECT;
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  const nodes: Text[] = [];
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function originalOf(node: Text): string {
+  if (!originalText.has(node)) originalText.set(node, node.nodeValue ?? '');
+  return originalText.get(node)!;
+}
+
+function declaredLanguage(root: HTMLElement): string {
+  if (originalLang.has(root)) {
+    const own = originalLang.get(root);
+    if (own) return normalizeLanguage(own);
+    return normalizeLanguage(root.parentElement?.closest<HTMLElement>('[lang]')?.lang || getPageLanguage());
+  }
+  return normalizeLanguage(root.closest<HTMLElement>('[lang]')?.lang || getPageLanguage());
+}
+
+async function detectSourceLanguage(root: HTMLElement, textNodes: Text[]): Promise<string> {
+  const declared = root.dataset.sourceLang ? normalizeLanguage(root.dataset.sourceLang) : declaredLanguage(root);
+  if (root.dataset.sourceLang) return declared;
+  const detector = await getDetector();
+  if (!detector) return declared;
+  const sample = textNodes.map(originalOf).join(' ').replace(/\s+/g, ' ').trim().slice(0, 1500);
+  if (sample.length < 20) return declared; // too short to detect reliably
+  try {
+    const [best] = await detector.detect(sample);
+    if (best && best.detectedLanguage !== 'und' && best.confidence >= DETECTION_MIN_CONFIDENCE) {
+      return normalizeLanguage(best.detectedLanguage);
+    }
+  } catch {
+    /* fall back to the declared language */
+  }
+  return declared;
+}
+
+function restoreRoot(root: HTMLElement) {
+  if (originalLang.has(root)) {
+    const lang = originalLang.get(root);
+    if (lang === null || lang === undefined) root.removeAttribute('lang');
+    else root.setAttribute('lang', lang);
+    originalLang.delete(root);
+  }
+  delete root.dataset.translated;
+  root.removeAttribute('aria-busy');
+}
+
+function restoreDom() {
+  for (const [node, text] of originalText) {
+    if (node.nodeValue !== text) node.nodeValue = text;
+  }
+  originalText.clear();
+  for (const root of Array.from(originalLang.keys())) restoreRoot(root);
+  document.querySelectorAll<HTMLElement>(`${SELECTOR}[aria-busy]`).forEach((el) => el.removeAttribute('aria-busy'));
+}
+
+/* ------------------------------------------------------------------ */
+/* Public actions                                                      */
+/* ------------------------------------------------------------------ */
+
+let currentRun: AbortController | null = null;
+
+function isAbort(error: unknown) {
+  return error instanceof DOMException && error.name === 'AbortError';
+}
+
+/**
+ * Translates every `[data-translatable]` element on the page into `target`.
+ * Must be called from a user gesture the first time a model needs downloading.
+ */
+export async function translatePage(target: string): Promise<void> {
+  if (!isTranslatorSupported()) return;
+  const targetLanguage = normalizeLanguage(target);
+
+  currentRun?.abort();
+  const run = new AbortController();
+  currentRun = run;
+  const { signal } = run;
+
+  // Always translate from the originals so switching languages doesn't compound errors.
+  restoreDom();
+
+  const roots = collectRoots();
+  setState({
+    status: 'preparing',
+    targetLanguage,
+    pendingLanguage: null,
+    sourceLanguages: [],
+    progress: { done: 0, total: roots.length },
+    downloadProgress: null,
+    error: null,
+  });
+  persistPreference(targetLanguage);
+
+  const sources = new Set<string>();
+  let done = 0;
+  let failures = 0;
+  let lastError: unknown = null;
+
+  for (const root of roots) {
+    if (signal.aborted) return;
+    try {
+      const nodes = collectTextNodes(root);
+      const source = await detectSourceLanguage(root, nodes);
+      if (signal.aborted) return;
+
+      if (!sameLanguage(source, targetLanguage) && nodes.length) {
+        root.setAttribute('aria-busy', 'true');
+        const translator = await getTranslator(source, targetLanguage, signal);
+        if (signal.aborted) return;
+        if (state.status !== 'translating') setState({ status: 'translating', downloadProgress: null });
+
+        for (const node of nodes) {
+          const original = originalOf(node);
+          const [, lead, core, trail] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+          const key = `${source}->${targetLanguage}\u0000${core}`;
+          let translated = cache.get(key);
+          if (translated === undefined) {
+            translated = await translator.translate(core, { signal });
+            cache.set(key, translated);
+          }
+          if (signal.aborted) return;
+          node.nodeValue = `${lead}${translated}${trail}`;
+        }
+
+        if (!originalLang.has(root)) originalLang.set(root, root.getAttribute('lang'));
+        root.setAttribute('lang', targetLanguage);
+        root.dataset.translated = 'true';
+        root.removeAttribute('aria-busy');
+        sources.add(source);
+      }
+    } catch (error) {
+      root.removeAttribute('aria-busy');
+      if (signal.aborted || isAbort(error)) return;
+      failures++;
+      lastError = error;
+      console.warn('[translate] Failed to translate element', root, error);
+    }
+    done++;
+    setState({ progress: { done, total: roots.length }, sourceLanguages: Array.from(sources) });
+  }
+
+  if (signal.aborted) return;
+  currentRun = null;
+
+  if (failures && failures === roots.length) {
+    setState({ status: 'error', error: describeError(lastError, targetLanguage), downloadProgress: null });
+    return;
+  }
+  setState({
+    status: 'translated',
+    downloadProgress: null,
+    error: failures ? `${failures} item${failures === 1 ? '' : 's'} could not be translated.` : null,
+  });
+}
+
+/** Restores the original text and clears the saved language preference. */
+export function showOriginal(): void {
+  currentRun?.abort();
+  currentRun = null;
+  if (isBrowser) restoreDom();
+  persistPreference(null);
+  setState({
+    status: state.supported ? 'idle' : 'unsupported',
+    targetLanguage: null,
+    pendingLanguage: null,
+    sourceLanguages: [],
+    progress: { done: 0, total: 0 },
+    downloadProgress: null,
+    error: null,
+  });
+}
+
+function describeError(error: unknown, target: string): string {
+  const name = error instanceof DOMException ? error.name : '';
+  if (name === 'NotSupportedError') return `Translation into ${languageLabel(target)} isn't available on this device.`;
+  if (name === 'NotAllowedError') return 'Click "Translate" again to allow the language model to download.';
+  if (name === 'QuotaExceededError') return 'This content is too long to translate on this device.';
+  return error instanceof Error && error.message ? error.message : 'Translation failed.';
+}
+
+/* ------------------------------------------------------------------ */
+/* Preference persistence & navigation                                 */
+/* ------------------------------------------------------------------ */
+
+function persistPreference(language: string | null) {
+  try {
+    if (language) localStorage.setItem(STORAGE_KEY, language);
+    else localStorage.removeItem(STORAGE_KEY);
+  } catch {
+    /* storage may be unavailable (privacy mode) */
+  }
+}
+
+function readPreference(): string | null {
+  try {
+    return localStorage.getItem(STORAGE_KEY);
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Re-applies the active (or saved) translation to freshly rendered content.
+ * Runs on first load and after every <ClientRouter /> navigation.
+ */
+async function onPageLoad() {
+  if (!isTranslatorSupported()) return;
+  if (document.body.dataset.translationInit) return;
+  document.body.dataset.translationInit = 'true';
+
+  // The previous page's DOM is gone; forget its nodes.
+  currentRun?.abort();
+  currentRun = null;
+  originalText.clear();
+  originalLang.clear();
+
+  const language = state.targetLanguage ?? readPreference();
+  if (!language) return;
+
+  // Without a user gesture we can only use models that are already on the device.
+  const availability = await getAvailability(language);
+  if (availability === 'available') {
+    await translatePage(language);
+  } else if (availability !== 'unavailable') {
+    setState({ status: 'idle', targetLanguage: null, pendingLanguage: normalizeLanguage(language) });
+  }
+}
+
+if (isBrowser) {
+  document.addEventListener('astro:page-load', () => void onPageLoad());
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', () => void onPageLoad(), { once: true });
+  } else {
+    void onPageLoad();
+  }
+}
