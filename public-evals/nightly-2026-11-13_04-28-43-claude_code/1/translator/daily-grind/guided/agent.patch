+  <script type="module">
+    // On-device translation of menu descriptions and story text via the built-in Translator API.
+    const SOURCE_LANG = 'en';
+    const select = document.getElementById('lang-select');
+    const status = document.getElementById('lang-status');
+    const targets = [...document.querySelectorAll('[data-translate]')];
+    const originals = new Map(targets.map((el) => [el, el.textContent.trim()]));
+    const translators = new Map(); // targetLanguage -> Translator instance
+    const cache = new Map(); // `${lang}\u0000${text}` -> translated text
+    let requestId = 0;
+
+    const setStatus = (text) => { status.textContent = text; };
+
+    function restoreOriginal() {
+      for (const el of targets) {
+        el.textContent = originals.get(el);
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      }
+    }
+
+    if (!('Translator' in self)) {
+      select.disabled = true;
+      setStatus('On-device translation is not supported in this browser. Try a recent desktop version of Chrome or Edge.');
+    } else {
+      select.addEventListener('change', () => translatePage(select.value));
+    }
+
+    async function getTranslator(targetLanguage) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+
+      const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+
+      if (availability !== 'available') {
+        setStatus('Downloading language pack…');
+      }
+
+      // Called from the select's change handler, so the user gesture required for downloads is present.
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round(e.loaded * 100);
+            status.replaceChildren(
+              `Downloading language pack… ${pct}%`,
+              Object.assign(document.createElement('progress'), { max: 1, value: e.loaded }),
+            );
+          });
+        },
+      });
+      translators.set(targetLanguage, translator);
+      return translator;
+    }
+
+    async function translatePage(lang) {
+      const id = ++requestId;
+
+      if (lang === SOURCE_LANG) {
+        restoreOriginal();
+        setStatus('');
+        return;
+      }
+
+      const label = select.selectedOptions[0].textContent;
+      select.setAttribute('aria-busy', 'true');
+      targets.forEach((el) => el.classList.add('is-translating'));
+
+      try {
+        const translator = await getTranslator(lang);
+        if (id !== requestId) return; // a newer selection superseded this one
+
+        if (!translator) {
+          restoreOriginal();
+          setStatus(`Translation to ${label} isn't available on this device.`);
+          return;
+        }
+
+        setStatus(`Translating to ${label}…`);
+        const results = await Promise.all(targets.map(async (el) => {
+          const text = originals.get(el);
+          const key = `${lang}\u0000${text}`;
+          if (!cache.has(key)) cache.set(key, await translator.translate(text));
+          return cache.get(key);
+        }));
+        if (id !== requestId) return;
+
+        targets.forEach((el, i) => {
+          el.textContent = results[i];
+          el.lang = lang;
+          el.dir = 'auto'; // handles right-to-left languages such as Arabic and Hebrew
+        });
+        setStatus(`Translated on your device to ${label}.`);
+      } catch (err) {
+        if (id !== requestId) return;
+        console.error(err);
+        restoreOriginal();
+        setStatus(err?.name === 'NotAllowedError'
+          ? 'Please choose the language again to start the download.'
+          : `Sorry, we couldn't translate to ${label}. Showing the original English.`);
+      } finally {
+        if (id === requestId) {
+          select.removeAttribute('aria-busy');
+          targets.forEach((el) => el.classList.remove('is-translating'));
+        }
+      }
+    }
+  </script>
+
