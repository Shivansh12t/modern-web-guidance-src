+
+      const hasTranslatorAPI = 'Translator' in self;
+      const translators = new Map(); // lang -> Promise<Translator>
+      const cache = new Map();       // `${lang}:${key}` -> translated text
+      let requestId = 0;
+
+      const setStatus = (msg) => { status.textContent = msg; };
+
+      function getTranslator(lang) {
+        if (!translators.has(lang)) {
+          // Must be invoked synchronously from the user's gesture so a model
+          // download (if needed) is permitted by the browser.
+          const p = Translator.create({
+            sourceLanguage: SOURCE_LANG,
+            targetLanguage: lang,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const pct = Math.round((e.loaded ?? 0) * 100);
+                setStatus(`Downloading ${languageNames[lang]} language model… ${pct}%`);
+              });
+            },
+          });
+          p.catch(() => translators.delete(lang));
+          translators.set(lang, p);
+        }
+        return translators.get(lang);
+      }
+
+      function render(lang, texts) {
+        nodes.forEach((el) => {
+          el.textContent = texts.get(el);
+          el.classList.remove('is-translating');
+          if (lang === SOURCE_LANG) el.removeAttribute('lang');
+          else el.setAttribute('lang', lang);
+        });
+        document.documentElement.lang = lang;
+      }
+
+      function renderBundled(lang) {
+        const dict = BUNDLED[lang];
+        if (!dict) return false;
+        render(lang, new Map(nodes.map((el) => [el, dict[el.dataset.i18n] ?? originals.get(el)])));
+        return true;
+      }
+
+      async function applyLanguage(lang, { fromUser = false } = {}) {
+        const id = ++requestId;
+        try { localStorage.setItem(STORAGE_KEY, lang); } catch { /* storage unavailable */ }
+
+        if (lang === SOURCE_LANG) {
+          render(lang, originals);
+          setStatus('');
+          return;
+        }
+
+        let translatorPromise = null;
+        if (hasTranslatorAPI) {
+          if (fromUser || translators.has(lang)) {
+            translatorPromise = getTranslator(lang);
+          } else {
+            // On page load (no user gesture) only use a model that's already on the device.
+            try {
+              const availability = await Translator.availability({ sourceLanguage: SOURCE_LANG, targetLanguage: lang });
+              if (availability === 'available') translatorPromise = getTranslator(lang);
+            } catch { /* fall through to bundled */ }
+          }
+        }
+
+        if (translatorPromise) {
+          nodes.forEach((el) => el.classList.add('is-translating'));
+          setStatus(`Translating to ${languageNames[lang]} on your device…`);
+          try {
+            const translator = await translatorPromise;
+            const texts = new Map(await Promise.all(nodes.map(async (el) => {
+              const key = `${lang}:${el.dataset.i18n}`;
