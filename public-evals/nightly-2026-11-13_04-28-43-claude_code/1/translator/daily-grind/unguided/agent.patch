+        } else {
+          render(SOURCE_LANG, originals);
+          setStatus(`Sorry, ${languageNames[lang]} isn't available in this browser.`);
+        }
+      }
+
+      select.addEventListener('change', () => applyLanguage(select.value, { fromUser: true }));
+
+      let saved = null;
+      try { saved = localStorage.getItem(STORAGE_KEY); } catch { /* storage unavailable */ }
