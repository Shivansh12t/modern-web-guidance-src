+            })));
+            if (id !== requestId) return; // a newer selection superseded this one
+            render(lang, texts);
+            setStatus(`Translated on-device to ${languageNames[lang]}.`);
+            return;
+          } catch (err) {
+            console.warn('On-device translation failed, using bundled translations.', err);
+            if (id !== requestId) return;
+          }
+        }
+
+        if (renderBundled(lang)) {
