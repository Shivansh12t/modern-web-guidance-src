+
+      panel.addEventListener('transitionend', function (event) {
+        if (event.target !== panel || event.propertyName !== 'opacity') return;
+        if (overlay.classList.contains('is-open')) {
+          body.setAttribute('data-overlay-state', 'open');
+        } else {
+          finishClose();
+        }
+      });
+
+      document.querySelectorAll('.btn[data-drink]').forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          var drink = DRINKS[btn.getAttribute('data-drink')];
+          if (!drink) return; // fall back to normal navigation
+          event.preventDefault();
+          openOverlay(drink, btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeOverlay);
+
+      overlay.addEventListener('click', function (event) {
+        if (event.target === overlay) closeOverlay();
+      });
+
+      document.addEventListener('keydown', function (event) {
+        if (!overlay.classList.contains('is-open')) return;
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeOverlay();
+        } else if (event.key === 'Tab') {
+          var focusable = getFocusable();
+          if (!focusable.length) return;
+          var first = focusable[0];
+          var last = focusable[focusable.length - 1];
+          if (event.shiftKey && document.activeElement === first) {
+            event.preventDefault();
+            last.focus();
+          } else if (!event.shiftKey && document.activeElement === last) {
+            event.preventDefault();
+            first.focus();
+          }
+        }
+      });
+    })();
