+  <script>
+    // Builds the breadcrumb trail from the current URL path so the same
+    // markup works on the home page and on menu sub-pages such as
+    // /menu/seasonal (Maple Oat Latte), /menu/espresso, /menu/cold-brew.
+    (function () {
+      var LABELS = {
+        '/menu': 'Menu',
+        '/menu/seasonal': 'Maple Oat Latte',
+        '/menu/espresso': 'Dark Roast Espresso',
+        '/menu/cold-brew': 'Cold Brew',
+        '/locations': 'Locations',
+        '/rewards': 'Rewards',
+        '/account': 'My Account',
+        '/order-online': 'Order Online',
+        '/about': 'Our Story',
+        '/careers': 'Join the Team',
+        '/contact': 'Contact Us',
+        '/privacy-policy': 'Privacy'
+      };
+
+      function prettify(segment) {
+        return decodeURIComponent(segment)
+          .replace(/\.html?$/i, '')
+          .replace(/[-_]+/g, ' ')
+          .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
+      }
+
+      var list = document.getElementById('breadcrumb-list');
+      if (!list) return;
+
+      var segments = window.location.pathname.split('/').filter(function (s) {
+        return s && !/^index\.html?$/i.test(s);
+      });
+
+      var crumbs = [{ href: '/', label: 'Home' }];
+      var path = '';
+      segments.forEach(function (seg) {
+        path += '/' + seg;
+        crumbs.push({ href: path, label: LABELS[path.toLowerCase()] || prettify(seg) });
+      });
+
+      list.textContent = '';
+      crumbs.forEach(function (crumb, i) {
+        var li = document.createElement('li');
+        var isLast = i === crumbs.length - 1;
+        var el = document.createElement(isLast ? 'span' : 'a');
+        el.textContent = crumb.label;
+        if (isLast) {
+          el.setAttribute('aria-current', 'page');
+        } else {
+          el.href = crumb.href;
+        }
+        li.appendChild(el);
+        list.appendChild(li);
+      });
+
+      if (crumbs.length > 1) {
+        document.title = crumbs[crumbs.length - 1].label + ' | The Daily Grind';
+      }
+    })();
+  </script>
+
 </body>
 
