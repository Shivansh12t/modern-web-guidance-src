+  <script>
+    // Build the breadcrumb trail from the current URL path.
+    // The static markup ("Home") is the no-script fallback for the home page.
+    (() => {
+      const labels = {
+        menu: 'Menu',
+        seasonal: 'Maple Oat Latte',
+        espresso: 'Dark Roast Espresso',
+        'cold-brew': 'Cold Brew',
+        locations: 'Locations',
+        rewards: 'Rewards',
+        account: 'My Account',
+        'order-online': 'Order Online',
+        about: 'Our Story',
+        careers: 'Join the Team',
+        contact: 'Contact Us',
+        'privacy-policy': 'Privacy',
+      };
+      const toLabel = (slug) =>
+        labels[slug] ??
+        decodeURIComponent(slug).replace(/[-_]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
+
+      const segments = location.pathname
+        .replace(/\/index\.html?$/, '')
+        .split('/')
+        .filter(Boolean);
+
+      const crumbs = [{ href: '/', label: 'Home' }];
+      segments.forEach((slug, i) => {
+        crumbs.push({ href: '/' + segments.slice(0, i + 1).join('/'), label: toLabel(slug) });
+      });
+
+      const list = document.getElementById('breadcrumb-list');
+      list.replaceChildren(...crumbs.map((crumb, i) => {
+        const li = document.createElement('li');
+        const a = document.createElement('a');
+        a.href = crumb.href;
+        a.textContent = crumb.label;
+        if (i === crumbs.length - 1) a.setAttribute('aria-current', 'page');
+        li.append(a);
+        return li;
+      }));
+    })();
+  </script>
+
 </body>
 
 </html>
