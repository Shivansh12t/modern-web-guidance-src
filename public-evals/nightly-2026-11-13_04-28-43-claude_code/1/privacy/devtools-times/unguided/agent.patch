diff --git a/src/components/AuthPrivacyNotice.tsx b/src/components/AuthPrivacyNotice.tsx
new file mode 100644
index 0000000..64d2b98
--- /dev/null
+++ b/src/components/AuthPrivacyNotice.tsx
@@ -0,0 +1,66 @@
+import React from 'react';
+
+/** Hostname of the service that receives account credentials. Shown to users for transparency. */
+export const AUTH_SERVICE_ORIGIN = 'https://us-central1-web-devrel-apps.cloudfunctions.net';
+export const AUTH_SERVICE_BASE = `${AUTH_SERVICE_ORIGIN}/times_cdn/api`;
+
+/**
+ * Request options shared by sign-in and sign-up calls.
+ * - credentials: 'omit'  → no cookies from this site are sent to the auth service
+ * - referrerPolicy        → the auth service does not learn which page you were on
+ * - cache: 'no-store'     → responses containing account data are not cached
+ */
+export const authFetchInit = (body: unknown): RequestInit => ({
+  method: 'POST',
+  headers: { 'Content-Type': 'application/json' },
+  body: JSON.stringify(body),
+  credentials: 'omit',
+  referrerPolicy: 'no-referrer',
+  cache: 'no-store',
+  mode: 'cors',
+});
+
+/** Parse a JSON body defensively; never throw on an empty/non-JSON error response. */
+export const readJson = async (response: Response): Promise<Record<string, unknown>> => {
+  try {
+    return (await response.json()) as Record<string, unknown>;
+  } catch {
+    return {};
+  }
+};
+
+const privacyUrl = () => {
+  const base = import.meta.env.BASE_URL;
+  return `${base}${base.endsWith('/') ? '' : '/'}legal/privacy`;
+};
+
+type Props = { mode: 'signin' | 'signup' };
+
+/** Just-in-time privacy notice shown right next to where personal data is entered. */
+export default function AuthPrivacyNotice({ mode }: Props) {
+  return (
+    <div className="mt-6 p-3 text-xs text-gray-600 bg-gray-50 border border-gray-200 rounded-md space-y-1">
+      <p className="font-semibold text-gray-700">How we handle your data</p>
+      {mode === 'signup' ? (
+        <p>
+          We only ask for a username and a password: no email address, real name or phone number.
+          Choose a username that does not identify you if you prefer. Your details are used solely to
+          create and secure your account.
+        </p>
+      ) : (
+        <p>
+          Your username and password are used only to sign you in. We do not store them in your
+          browser, and they are never shared with analytics.
+        </p>
+      )}
+      <p>
+        Your details are sent encrypted (HTTPS) to our authentication service at{' '}
+        <code>{new URL(AUTH_SERVICE_ORIGIN).hostname}</code>. No cookies or referrer information go
+        with them.{' '}
+        <a href={privacyUrl()} className="underline" data-skip-tracking="true">
+          Privacy Policy
+        </a>
+      </p>
+    </div>
+  );
+}
