+/**
+ * Privacy-oriented response headers applied to every response.
+ * The CSP lists every third party the page may talk to, so new trackers
+ * can't be added silently.
+ */
+const BASE_HEADERS: Record<string, string> = {
+  // Send only the origin (never the full URL with path/query) to other sites.
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  // Turn off powerful features and interest-based ad APIs we don't use.
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'autoplay=(self)',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'magnetometer=()',
+    'microphone=()',
+    'payment=()',
+    'usb=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Content-Security-Policy': [
+    "default-src 'self'",
+    // Astro islands/ClientRouter use inline module scripts.
+    `script-src 'self' 'unsafe-inline' ${DEVREL_SERVICES}`,
+    `connect-src 'self' ${DEVREL_SERVICES}`,
+    "style-src 'self' 'unsafe-inline'",
+    "img-src 'self' data: https:",
+    "font-src 'self'",
+    "media-src 'self' https:",
+    "object-src 'none'",
+    "base-uri 'self'",
+    "form-action 'self'",
+  ].join('; '),
+};
+
+/** Pages where users enter credentials get extra protection. */
+const isAuthPage = (pathname: string) => /\/(signin|signup)\/?$/.test(pathname);
