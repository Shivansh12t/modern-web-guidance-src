diff --git a/src/components/PrivacyConsent.astro b/src/components/PrivacyConsent.astro
new file mode 100644
index 0000000..09100b0
--- /dev/null
+++ b/src/components/PrivacyConsent.astro
@@ -0,0 +1,190 @@
+---
+/**
+ * Privacy-by-design consent manager.
+ *
+ * - Optional third-party scripts (analytics) are NOT loaded until the visitor
+ *   explicitly opts in. The default is "off".
+ * - Global Privacy Control / Do Not Track signals are honoured as a refusal and
+ *   the banner is not shown to those visitors at all.
+ * - "Accept" and "Reject" are equally prominent; there are no pre-ticked boxes.
+ * - The choice can be changed at any time via any element carrying
+ *   `data-open-privacy-preferences` (e.g. the footer link).
+ * - The only thing stored is the choice itself (localStorage, first-party),
+ *   which is strictly necessary to remember it.
+ */
+const baseUrl = import.meta.env.BASE_URL;
+const privacyUrl = `${baseUrl.endsWith('/') ? baseUrl : baseUrl + '/'}legal/privacy`;
+---
+
+<div
+  id="privacy-consent"
+  transition:persist
+  role="dialog"
+  aria-modal="false"
+  aria-labelledby="privacy-consent-title"
+  aria-describedby="privacy-consent-desc"
+  hidden
+  class="fixed inset-x-0 bottom-0 z-[100] p-4"
+>
+  <div class="mx-auto max-w-3xl rounded-lg border border-gray-300 bg-white p-5 shadow-lg text-sm text-gray-800">
+    <h2 id="privacy-consent-title" class="text-base font-bold mb-2">Your privacy choices</h2>
+    <div id="privacy-consent-desc" class="space-y-2">
+      <p>
+        The DevTools Times works without any tracking. With your permission we would also load an
+        <strong>optional analytics script</strong> from our analytics provider
+        (<code class="text-xs">us-central1-web-devrel-apps.cloudfunctions.net</code>). It records the
+        label of links and buttons you click together with a timestamp, so we can learn which
+        features are used. It does not set cookies and is never used for advertising.
+      </p>
+      <p>
+        Analytics stays <strong>off</strong> unless you turn it on. You can change your mind at any time via
+        "Manage Privacy Preferences" in the footer. Details are in our
+        <a href={privacyUrl} class="underline" data-skip-tracking="true">Privacy Policy</a>.
+      </p>
+      <label class="flex items-start gap-2 pt-1">
+        <input id="privacy-consent-analytics" type="checkbox" class="mt-1" />
+        <span>Allow optional usage analytics</span>
+      </label>
+    </div>
+    <div class="mt-4 flex flex-wrap gap-2 justify-end">
+      <button
+        type="button"
+        data-consent-action="reject"
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md border border-gray-900 bg-white text-gray-900 font-medium hover:bg-gray-100"
+      >
+        Reject optional
+      </button>
+      <button
+        type="button"
+        data-consent-action="save"
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md border border-gray-900 bg-white text-gray-900 font-medium hover:bg-gray-100"
+      >
+        Save choices
+      </button>
+      <button
+        type="button"
+        data-consent-action="accept"
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md border border-gray-900 bg-white text-gray-900 font-medium hover:bg-gray-100"
+      >
+        Accept analytics
+      </button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STORAGE_KEY = 'dtt-privacy-consent';
+  const CONSENT_VERSION = 1;
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+  type Consent = { v: number; analytics: boolean; updatedAt: string };
+
+  const hasOptOutSignal = (): boolean => {
+    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+    return nav.globalPrivacyControl === true || navigator.doNotTrack === '1';
+  };
+
+  const readConsent = (): Consent | null => {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (!raw) return null;
+      const parsed = JSON.parse(raw) as Consent;
+      // Ask again if what we ask for has changed since the choice was made.
+      return parsed && parsed.v === CONSENT_VERSION ? parsed : null;
+    } catch {
+      return null;
+    }
+  };
+
+  const writeConsent = (analytics: boolean) => {
+    const value: Consent = { v: CONSENT_VERSION, analytics, updatedAt: new Date().toISOString() };
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
+    } catch {
+      /* storage unavailable: choice applies to this page view only */
+    }
+    return value;
+  };
+
+  const analyticsAllowed = (): boolean => {
+    if (hasOptOutSignal()) return false;
+    return readConsent()?.analytics === true;
+  };
+
+  let analyticsLoaded = false;
+  const loadAnalytics = () => {
+    if (analyticsLoaded || !analyticsAllowed()) return;
+    analyticsLoaded = true;
+    const s = document.createElement('script');
+    s.src = ANALYTICS_SRC;
+    s.defer = true;
+    s.referrerPolicy = 'strict-origin-when-cross-origin';
+    s.crossOrigin = 'anonymous';
+    document.head.appendChild(s);
+  };
+
+  const banner = () => document.getElementById('privacy-consent');
+  const checkbox = () => document.getElementById('privacy-consent-analytics') as HTMLInputElement | null;
+
+  const showBanner = () => {
+    const el = banner();
+    if (!el) return;
+    const cb = checkbox();
+    if (cb) {
+      cb.checked = analyticsAllowed();
+      cb.disabled = hasOptOutSignal();
+    }
+    el.hidden = false;
+  };
+
+  const hideBanner = () => {
+    const el = banner();
+    if (el) el.hidden = true;
+  };
+
+  const applyChoice = (analytics: boolean) => {
+    const wasLoaded = analyticsLoaded;
+    writeConsent(analytics && !hasOptOutSignal());
+    hideBanner();
+    if (analyticsAllowed()) {
+      loadAnalytics();
+    } else if (wasLoaded) {
+      // A loaded third-party script cannot be reliably unloaded; reload so
+      // the withdrawal takes effect immediately.
+      location.reload();
+    }
+  };
+
+  document.addEventListener('click', (event) => {
+    const target = event.target as Element | null;
+    if (!target) return;
+
+    const opener = target.closest('[data-open-privacy-preferences]');
+    if (opener) {
+      event.preventDefault();
+      showBanner();
+      return;
+    }
+
+    const actionEl = target.closest('[data-consent-action]');
+    if (!actionEl) return;
+    const action = actionEl.getAttribute('data-consent-action');
+    if (action === 'accept') applyChoice(true);
+    else if (action === 'reject') applyChoice(false);
+    else if (action === 'save') applyChoice(checkbox()?.checked === true);
+  });
+
+  const init = () => {
+    if (analyticsAllowed()) {
+      loadAnalytics();
+    } else if (!hasOptOutSignal() && readConsent() === null) {
+      showBanner();
+    }
+  };
+
+  init();
+</script>
