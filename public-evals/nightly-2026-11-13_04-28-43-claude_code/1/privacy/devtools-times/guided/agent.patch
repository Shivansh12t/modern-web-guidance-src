diff --git a/src/components/PasswordField.tsx b/src/components/PasswordField.tsx
new file mode 100644
index 0000000..05eaa54
--- /dev/null
+++ b/src/components/PasswordField.tsx
@@ -0,0 +1,99 @@
+import React, { useState } from 'react';
+
+interface PasswordFieldProps {
+  id: string;
+  label: string;
+  autoComplete: 'current-password' | 'new-password';
+  value: string;
+  onChange: (value: string) => void;
+  /** Hint shown above the input (kept above so mobile keyboards don't cover it). */
+  hint?: React.ReactNode;
+  /** Error text revealed (via :user-invalid) once the user has left the field invalid. */
+  errorMessage?: string;
+  pattern?: string;
+  minLength?: number;
+}
+
+/**
+ * Accessible password input with a "Show password" toggle.
+ * - Pasting is allowed (password managers / generated passwords).
+ * - Stable id/name + correct autocomplete so browsers can save and autofill.
+ * - aria-invalid / aria-describedby are only updated after interaction.
+ */
+export default function PasswordField({
+  id,
+  label,
+  autoComplete,
+  value,
+  onChange,
+  hint,
+  errorMessage,
+  pattern,
+  minLength,
+}: PasswordFieldProps) {
+  const [visible, setVisible] = useState(false);
+  const [showError, setShowError] = useState(false);
+  const hintId = hint ? `${id}-hint` : undefined;
+  const errorId = errorMessage ? `${id}-error` : undefined;
+
+  const describedBy = [hintId, showError ? errorId : undefined].filter(Boolean).join(' ') || undefined;
+
+  const sync = (input: HTMLInputElement, interacted: boolean) => {
+    if (!errorMessage) return;
+    if (interacted || showError) setShowError(!input.validity.valid);
+  };
+
+  return (
+    <div className="field">
+      <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">
+        {label}
+      </label>
+      {hint && (
+        <p id={hintId} className="field-hint text-xs text-gray-600 mb-1">
+          {hint}
+        </p>
+      )}
+      <div className="flex gap-2">
+        <input
+          type={visible ? 'text' : 'password'}
+          id={id}
+          name="password"
+          autoComplete={autoComplete}
+          autoCapitalize="none"
+          autoCorrect="off"
+          spellCheck={false}
+          enterKeyHint="done"
+          value={value}
+          onChange={(e) => {
+            onChange(e.target.value);
+            sync(e.target, false);
+          }}
+          onBlur={(e) => sync(e.target, e.target.value !== '')}
+          onInvalid={(e) => setShowError(Boolean(errorMessage) && !e.currentTarget.validity.valid)}
+          required
+          pattern={pattern}
+          minLength={minLength}
+          aria-describedby={describedBy}
+          aria-invalid={showError}
+          className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+        />
+        <button
+          type="button"
+          onClick={() => setVisible((v) => !v)}
+          aria-controls={id}
+          aria-pressed={visible}
+          data-skip-tracking="true"
+          className="shrink-0 px-3 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
+        >
+          {visible ? 'Hide' : 'Show'}
+          <span className="sr-only"> password</span>
+        </button>
+      </div>
+      {errorMessage && (
+        <p id={errorId} className="field-error text-sm text-red-700 mt-1">
+          <span role="img" aria-label="Error">⚠️</span> {errorMessage}
+        </p>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/PrivacyPreferences.astro b/src/components/PrivacyPreferences.astro
new file mode 100644
index 0000000..7338fc1
--- /dev/null
+++ b/src/components/PrivacyPreferences.astro
@@ -0,0 +1,197 @@
+---
+/**
+ * Privacy preferences dialog.
+ *
+ * Privacy by default: optional third-party analytics is OFF until the reader
+ * explicitly opts in here. The choice is stored only in this browser
+ * (localStorage, never sent to our server) and can be changed at any time
+ * from the "Manage Privacy Preferences" button in the footer.
+ *
+ * The loader that acts on this choice lives in Layout.astro.
+ */
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<dialog
+  id="privacy-preferences"
+  aria-labelledby="privacy-preferences-title"
+  closedby="any"
+  class="m-auto w-[min(36rem,calc(100%-2rem))] rounded-lg p-0 shadow-xl text-left"
+>
+  <form method="dialog" id="privacy-preferences-form" class="p-6 space-y-4">
+    <h2 id="privacy-preferences-title" class="text-xl font-bold text-gray-900">
+      Privacy preferences
+    </h2>
+
+    <p class="text-sm text-gray-700">
+      We keep data collection to the minimum needed to run this site. Anything
+      optional is off unless you turn it on, and you can change your mind at any time.
+    </p>
+
+    <fieldset class="space-y-4">
+      <legend class="sr-only">Data uses</legend>
+
+      <div class="rounded-md border border-gray-200 p-4">
+        <div class="flex items-start gap-3">
+          <input
+            type="checkbox"
+            id="pref-essential"
+            checked
+            disabled
+            class="mt-1 h-4 w-4"
+            aria-describedby="pref-essential-desc"
+          />
+          <div>
+            <label for="pref-essential" class="font-semibold text-gray-900">
+              Strictly necessary (always on)
+            </label>
+            <p id="pref-essential-desc" class="text-sm text-gray-600 mt-1">
+              A first-party session cookie, created only when you use the reading list,
+              so we can remember the articles you saved. It is not shared with anyone.
+            </p>
+          </div>
+        </div>
+      </div>
+
+      <div class="rounded-md border border-gray-200 p-4">
+        <div class="flex items-start gap-3">
+          <input
+            type="checkbox"
+            id="pref-analytics"
+            name="analytics"
+            class="mt-1 h-4 w-4"
+            aria-describedby="pref-analytics-desc pref-gpc-note"
+          />
+          <div>
+            <label for="pref-analytics" class="font-semibold text-gray-900">
+              Usage analytics (optional)
+            </label>
+            <p id="pref-analytics-desc" class="text-sm text-gray-600 mt-1">
+              Loads a script from our analytics provider (<code>us-central1-web-devrel-apps.cloudfunctions.net</code>).
+              When you click a link or button, it sends the element type, its visible text and
+              the time of the click. Your browser also shares your IP address and user agent with
+              the provider. It never runs on the sign-in or sign-up pages and never sees what you
+              type into forms.
+            </p>
+            <p id="pref-gpc-note" class="text-sm text-amber-800 mt-2" hidden>
+              Your browser is sending a Global Privacy Control or Do Not Track signal, so
+              analytics stays off.
+            </p>
+          </div>
+        </div>
+      </div>
+    </fieldset>
+
+    <p class="text-xs text-gray-600">
+      Read the full <a href={`${baseUrl}legal/privacy`} class="underline" data-skip-tracking="true">privacy policy</a>.
+    </p>
+
+    <div class="flex flex-wrap justify-end gap-3 pt-2">
+      <button
+        type="submit"
+        value="cancel"
+        formnovalidate
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md border border-gray-300 text-sm font-medium text-gray-800 hover:bg-gray-50"
+      >
+        Cancel
+      </button>
+      <button
+        type="submit"
+        value="save"
+        autofocus
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md bg-gray-900 text-sm font-medium text-white hover:bg-gray-800"
+      >
+        Save preferences
+      </button>
+    </div>
+  </form>
+</dialog>
+
+<script>
+  type Prefs = { analytics: boolean; updatedAt?: string };
+
+  const STORAGE_KEY = 'dtt:privacy-preferences';
+
+  const readPrefs = (): Prefs => {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      return raw ? { analytics: JSON.parse(raw).analytics === true } : { analytics: false };
+    } catch {
+      return { analytics: false };
+    }
+  };
+
+  const browserOptOut = () =>
+    (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true ||
+    navigator.doNotTrack === '1';
+
+  function setup() {
+    const dialog = document.getElementById('privacy-preferences') as HTMLDialogElement | null;
+    if (!dialog || dialog.dataset.ready) return;
+    dialog.dataset.ready = 'true';
+
+    const checkbox = dialog.querySelector<HTMLInputElement>('#pref-analytics')!;
+    const gpcNote = dialog.querySelector<HTMLElement>('#pref-gpc-note')!;
+
+    const syncForm = () => {
+      const optOut = browserOptOut();
+      checkbox.checked = !optOut && readPrefs().analytics;
+      checkbox.disabled = optOut;
+      gpcNote.hidden = !optOut;
+    };
+
+    // Re-sync the form from storage each time the dialog opens so a
+    // cancelled change is never shown as saved.
+    dialog.addEventListener('toggle', (event) => {
+      if ((event as ToggleEvent).newState === 'open') syncForm();
+    });
+    syncForm();
+
+    dialog.addEventListener('close', () => {
+      const action = dialog.returnValue;
+      dialog.returnValue = '';
+      if (action !== 'save') return;
+
+      const previous = readPrefs().analytics;
+      const next = !browserOptOut() && checkbox.checked;
+      try {
+        localStorage.setItem(
+          STORAGE_KEY,
+          JSON.stringify({ analytics: next, updatedAt: new Date().toISOString() } satisfies Prefs),
+        );
+      } catch {
+        // Storage unavailable: nothing is persisted, so analytics stays off.
+      }
+
+      if (next && !previous) {
+        window.dttPrivacy?.maybeLoadAnalytics();
+      } else if (!next && previous && window.dttPrivacy?.analyticsLoaded()) {
+        // A third-party script cannot be "unloaded"; reload so it stops running.
+        location.reload();
+      }
+    });
+
+    // Fallback for browsers without Invoker Commands (command/commandfor).
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document
+        .querySelectorAll<HTMLButtonElement>('button[commandfor="privacy-preferences"][command="show-modal"]')
+        .forEach((button) => button.addEventListener('click', () => dialog.showModal()));
+    }
+
+    // Light-dismiss fallback where <dialog closedby> is unsupported.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e: PointerEvent) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+    }
+  }
+
+  // Runs on the initial load and after every client-side navigation.
+  document.addEventListener('astro:page-load', setup);
+</script>
