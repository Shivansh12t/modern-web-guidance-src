 import { defineMiddleware } from 'astro:middleware';
 
+/**
+ * Privacy-preserving response headers applied to every document and API
+ * response.
+ *
+ * - Referrer-Policy: never leak full paths/query strings (e.g. article slugs
+ *   a reader is viewing) to third-party origins.
+ * - Permissions-Policy: a news site needs no powerful device features, so
+ *   they are disabled for this origin and every embedded frame. It also
+ *   opts out of interest-based advertising APIs (Topics / FLoC).
+ * - X-Content-Type-Options: prevent MIME sniffing of responses.
+ */
+const PRIVACY_HEADERS: Record<string, string> = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'ambient-light-sensor=()',
+    'autoplay=()',
+    'bluetooth=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'hid=()',
+    'idle-detection=()',
+    'interest-cohort=()',
+    'magnetometer=()',
+    'microphone=()',
+    'midi=()',
+    'payment=()',
+    'serial=()',
+    'usb=()',
+    'xr-spatial-tracking=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+};
+
+/** Pages that handle credentials should never be stored by shared caches. */
+const CREDENTIAL_PAGES = /\/(signin|signup)\/?$/;
