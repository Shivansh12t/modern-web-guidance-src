+# Security & privacy response headers for The Daily Grind.
+# Format: Netlify / Cloudflare Pages `_headers`. Port the same values to
+# nginx/Apache/CDN config if hosting elsewhere. See docs/PRIVACY.md.
+#
+# The site is 100% first-party (no CDNs, fonts, analytics, ads, embeds), so
+# every policy below is "self only". Adding ANY third party requires a review
+# entry in docs/PRIVACY.md and an explicit change here.
+
+/*
+  # --- Content Security Policy: blocks XSS and silent third-party loading ---
+  Content-Security-Policy: default-src 'none'; script-src 'self' 'report-sample'; style-src 'self' 'report-sample'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; worker-src 'self'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests; report-to csp
+  Reporting-Endpoints: csp="/api/reports/csp", default="/api/reports/default"
+
+  # --- Network-layer allowlist (Chromium 152+): covers channels CSP doesn't
+  #     (preconnect, dns-prefetch, WebRTC). Only our own origin is allowed.
+  #     redirects=allow so same-origin redirects (e.g. POST /logout -> /) work.
+  Connection-Allowlist: (response-origin); redirects=allow; report-to=default
+  Vary: Sec-Fetch-Dest
+
+  # --- Don't leak full URLs (paths/queries can contain IDs) cross-origin ---
+  Referrer-Policy: strict-origin-when-cross-origin
+
+  # --- Disable powerful/tracking-prone features we never use ---
+  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), compute-pressure=(), display-capture=(), encrypted-media=(), focus-without-user-activation=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), join-ad-interest-group=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), private-aggregation=(), publickey-credentials-get=(self), run-ad-auction=(), screen-wake-lock=(), serial=(), shared-storage=(), shared-storage-select-url=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()
+
+  # --- Clickjacking, isolation, sniffing ---
+  X-Frame-Options: DENY
+  Cross-Origin-Opener-Policy: same-origin
+  Cross-Origin-Resource-Policy: same-origin
+  X-Content-Type-Options: nosniff
+
+  # --- HTTPS only. Ramp max-age up (300 -> 86400 -> 31536000) once verified,
+  #     then consider `preload`.
+  Strict-Transport-Security: max-age=300; includeSubDomains
+
+# Authenticated / personal pages must never be cached by browsers or proxies.
+/account
+  Cache-Control: no-store
+/account/*
+  Cache-Control: no-store
+/rewards
+  Cache-Control: no-store
+/order-online
+  Cache-Control: no-store
+
+# Logout wipes everything this origin stored in the browser.
+# (The server must also invalidate the session server-side.)
+/logout
+  Cache-Control: no-store
+  Clear-Site-Data: "cookies", "storage", "cache"
