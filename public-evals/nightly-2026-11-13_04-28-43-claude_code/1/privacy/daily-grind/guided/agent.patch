@@ -0,0 +1,95 @@
+#!/usr/bin/env node
+// Static privacy audit for the site's shipped files.
+// Fails (exit 1) if it finds:
+//  - any request to a non-allowlisted external origin (scripts, styles, images,
+//    fonts, iframes, forms, fetch/beacon URLs, CSS url()/@import)
+//  - inline <script>/<style>/style="" or on* handlers (would need 'unsafe-inline')
+//  - dangerous DOM sinks (innerHTML, document.write, eval, ...)
+//  - PII-prone storage or fingerprinting APIs in client JS
+// Run: npm run audit:third-parties
+// Complements (does not replace) a periodic runtime audit of a HAR capture.
+
+import { readdir, readFile } from 'node:fs/promises';
+import { join, extname, relative } from 'node:path';
+
+const ROOT = new URL('..', import.meta.url).pathname;
+const SKIP_DIRS = new Set(['node_modules', '.git', 'docs', 'scripts']);
+const EXTS = new Set(['.html', '.css', '.js', '.mjs']);
+
+// Third-party origins that have passed review in docs/PRIVACY.md. Keep empty
+// unless a documented, reviewed need exists.
+const ALLOWED_ORIGINS = new Set([]);
+
+// Outbound links (<a href>) to these are navigation, not subresource loading.
+const RESOURCE_PATTERNS = [
+  /<(?:script|img|source|iframe|embed|video|audio|track)\b[^>]*\bsrc\s*=\s*["']([^"']+)["']/gi,
+  /<link\b[^>]*\bhref\s*=\s*["']([^"']+)["']/gi,
+  /<form\b[^>]*\baction\s*=\s*["']([^"']+)["']/gi,
+  /\bsrcset\s*=\s*["']([^"']+)["']/gi,
+  /url\(\s*["']?([^"')\s]+)/gi,
+  /@import\s+["']([^"']+)["']/gi,
+  /\b(?:fetch|sendBeacon|EventSource|WebSocket|importScripts|import)\s*\(\s*["'`]([^"'`]+)["'`]/gi,
+];
+
+const RULES = [
+  { re: /<script\b(?![^>]*\bsrc=)[^>]*>\s*\S/gi, msg: 'inline <script> (use an external same-origin file)', ext: ['.html'] },
+  { re: /<style\b/gi, msg: 'inline <style> (use /css/*.css)', ext: ['.html'] },
+  { re: /\sstyle\s*=\s*["']/gi, msg: 'inline style attribute', ext: ['.html'] },
+  { re: /\son[a-z]+\s*=\s*["']/gi, msg: 'inline event handler attribute', ext: ['.html'] },
+  { re: /\.(?:innerHTML|outerHTML)\s*=|insertAdjacentHTML|document\.write|setHTMLUnsafe|\beval\s*\(|new Function\s*\(/g, msg: 'dangerous DOM sink', ext: ['.js', '.mjs'] },
+  { re: /localStorage\.setItem|sessionStorage\.setItem|indexedDB\.open|document\.cookie\s*=/g, msg: 'client-side storage write (no PII/tokens in web storage; review purpose)', ext: ['.js', '.mjs'] },
+  { re: /navigator\.userAgent\b|toDataURL\s*\(|getImageData\s*\(|AudioContext|enumerateDevices|navigator\.plugins|getHighEntropyValues/g, msg: 'fingerprinting-prone API', ext: ['.js', '.mjs'] },
+];
+
+async function* walk(dir) {
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    if (entry.isDirectory()) {
+      if (!SKIP_DIRS.has(entry.name)) yield* walk(join(dir, entry.name));
+    } else if (EXTS.has(extname(entry.name))) {
+      yield join(dir, entry.name);
+    }
+  }
+}
+
+function externalOrigin(ref) {
+  const trimmed = ref.trim();
+  if (!/^(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(trimmed)) return null; // relative or data:/blob:
+  try {
+    return new URL(trimmed, 'https://self.invalid').origin;
+  } catch {
+    return trimmed;
+  }
+}
+
+const lineOf = (text, index) => text.slice(0, index).split('\n').length;
+const findings = [];
+
+for await (const file of walk(ROOT)) {
+  const text = await readFile(file, 'utf8');
+  const rel = relative(ROOT, file);
+  const ext = extname(file);
+
+  for (const pattern of RESOURCE_PATTERNS) {
+    for (const m of text.matchAll(pattern)) {
+      for (const ref of m[1].split(',').map((s) => s.trim().split(/\s+/)[0])) {
+        const origin = externalOrigin(ref);
+        if (origin && !ALLOWED_ORIGINS.has(origin)) {
+          findings.push(`${rel}:${lineOf(text, m.index)}  third-party request to ${origin}`);
+        }
+      }
+    }
+  }
+  for (const rule of RULES) {
+    if (!rule.ext.includes(ext)) continue;
+    for (const m of text.matchAll(rule.re)) {
+      findings.push(`${rel}:${lineOf(text, m.index)}  ${rule.msg}`);
+    }
+  }
+}
+
+if (findings.length) {
+  console.error(`Privacy audit failed with ${findings.length} finding(s):\n`);
+  for (const f of findings) console.error(`  ${f}`);
+  process.exit(1);
+}
+console.log('Privacy audit passed: no third-party requests, inline code, dangerous sinks, or fingerprinting APIs found.');
