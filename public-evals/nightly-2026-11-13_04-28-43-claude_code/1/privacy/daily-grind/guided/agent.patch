diff --git a/js/privacy.js b/js/privacy.js
new file mode 100644
index 0000000..752a666
--- /dev/null
+++ b/js/privacy.js
@@ -0,0 +1,65 @@
+// Privacy-by-design helpers for The Daily Grind.
+//
+// Ground rules for this file (and any future client code):
+//  - No third-party scripts, SDKs, pixels or beacons. Everything is same-origin.
+//  - No fingerprinting: no canvas/audio/font probing, no full userAgent parsing.
+//    Use feature detection only.
+//  - Never put PII or tokens in localStorage/sessionStorage/IndexedDB or URLs.
+//    Session state lives in an HttpOnly cookie the page cannot read.
+//  - Write to the DOM with textContent only (Trusted Types is enforced by CSP
+//    with `trusted-types 'none'`, so innerHTML-style sinks will throw).
+
+// 1. Data minimization: strip tracking/click-ID parameters from the address
+//    bar so they don't end up in bookmarks, shared links, history, or the
+//    Referer sent on later same-origin requests. (Our server should also
+//    drop them from access logs.)
+const TRACKING_PARAMS = [
+  /^utm_/i,
+  /^(gclid|gbraid|wbraid|dclid|gclsrc)$/i,
+  /^(fbclid|msclkid|ttclid|twclid|li_fat_id|igshid|yclid)$/i,
+  /^(mc_cid|mc_eid|_hsenc|_hsmi|mkt_tok|oly_anon_id|oly_enc_id|vero_id)$/i,
+];
+
+function stripTrackingParams() {
+  const url = new URL(window.location.href);
+  let changed = false;
+  for (const key of [...url.searchParams.keys()]) {
+    if (TRACKING_PARAMS.some((re) => re.test(key))) {
+      url.searchParams.delete(key);
+      changed = true;
+    }
+  }
+  if (changed) {
+    history.replaceState(history.state, '', url.pathname + url.search + url.hash);
+  }
+}
+
+// 2. Honor Global Privacy Control. We already don't sell/share data or run
+//    trackers, but we surface that the signal was received so users can see
+//    it was respected (transparency, no consent-banner fatigue).
+function reflectGlobalPrivacyControl() {
+  const status = document.querySelector('[data-gpc-status]');
+  if (status && navigator.globalPrivacyControl === true) {
+    status.textContent = 'Your browser’s Global Privacy Control signal was detected and is honored.';
+  }
+}
+
+// 3. Logout hygiene. The server responds to POST /logout with
+//    `Clear-Site-Data: "cookies", "storage", "cache"`; this is a client-side
+//    belt-and-braces for browsers that don't fully support that header.
+function hardenLogout() {
+  for (const form of document.querySelectorAll('form[data-logout]')) {
+    form.addEventListener('submit', () => {
+      try {
+        sessionStorage.clear();
+        localStorage.clear();
+      } catch {
+        // Storage may be unavailable (e.g. disabled by the user); nothing to clear.
+      }
+    });
+  }
+}
+
+stripTrackingParams();
+reflectGlobalPrivacyControl();
+hardenLogout();
