index 0000000..bf8c8d0
--- /dev/null
+++ b/assets/js/privacy.js
@@ -0,0 +1,337 @@
+/*!
+ * The Daily Grind — client-side privacy module.
+ *
+ * Principles:
+ *  - Privacy by default: nothing optional runs until the user opts in.
+ *  - Browser opt-out signals (Global Privacy Control, Do Not Track) win over
+ *    stored preferences and cannot be overridden from the UI.
+ *  - Data minimization: the only thing stored is a tiny consent record
+ *    (category booleans, schema version, and a day-precision date for expiry).
+ *    No identifiers, no fingerprinting, no cookies.
+ *  - Third-party audit: any request to an origin not on the allowlist is
+ *    reported in the console so it gets caught during development / QA.
+ *
+ * Public API (for future first-party features that need consent):
+ *   DailyGrindPrivacy.hasConsent('analytics')  -> boolean
+ *   DailyGrindPrivacy.onChange(fn)             -> unsubscribe function
+ *   DailyGrindPrivacy.openChoices()
+ *   DailyGrindPrivacy.auditReport()            -> { thirdParty: [...], cspViolations: [...] }
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'dg_privacy';
+  var SCHEMA_VERSION = 1;
+  var CONSENT_MAX_AGE_DAYS = 180;
+  var OPTIONAL_CATEGORIES = ['analytics'];
+
+  // Origins allowed to receive requests from this page. Keep empty unless a
+  // vendor has passed a privacy review (DPA signed, listed in the privacy
+  // policy, added to the CSP in /_headers and the <meta> fallback).
+  var THIRD_PARTY_ALLOWLIST = [];
+
+  // Storage keys owned by the site that must be wiped on logout.
+  // The consent record is intentionally kept: it holds no personal data and
+  // the user's privacy choice should survive signing out.
+  var SESSION_STORAGE_PREFIX = 'dg_';
+
+  var listeners = [];
+  var audit = { thirdParty: [], cspViolations: [] };
+
+  // ---------------------------------------------------------------------------
+  // Opt-out signals
+  // ---------------------------------------------------------------------------
+  function optOutSignal() {
+    var nav = window.navigator || {};
+    if (nav.globalPrivacyControl === true) return true;
+    var dnt = nav.doNotTrack || window.doNotTrack || nav.msDoNotTrack;
+    return dnt === '1' || dnt === 'yes';
+  }
+
+  // ---------------------------------------------------------------------------
+  // Consent storage (minimal, versioned, expiring)
+  // ---------------------------------------------------------------------------
+  function storage() {
+    try {
+      var s = window.localStorage;
+      var probe = '__dg_probe__';
+      s.setItem(probe, '1');
+      s.removeItem(probe);
+      return s;
+    } catch (e) {
+      return null; // Storage disabled/blocked: fall back to privacy defaults.
+    }
+  }
+
+  function today() {
+    // Day precision only — no need for a precise timestamp.
+    return new Date().toISOString().slice(0, 10);
+  }
+
+  function defaults() {
+    var c = {};
+    OPTIONAL_CATEGORIES.forEach(function (k) { c[k] = false; });
+    return c;
+  }
+
+  function readConsent() {
+    var s = storage();
+    if (!s) return null;
+    try {
+      var raw = JSON.parse(s.getItem(STORAGE_KEY));
+      if (!raw || raw.v !== SCHEMA_VERSION || typeof raw.d !== 'string') {
+        s.removeItem(STORAGE_KEY);
+        return null;
+      }
+      var ageDays = (Date.now() - Date.parse(raw.d)) / 86400000;
+      if (!(ageDays >= 0 && ageDays <= CONSENT_MAX_AGE_DAYS)) {
+        s.removeItem(STORAGE_KEY); // Expired consent must be re-asked.
+        return null;
+      }
+      // Only accept known keys with strict boolean values.
+      var c = defaults();
+      OPTIONAL_CATEGORIES.forEach(function (k) { c[k] = raw.c && raw.c[k] === true; });
+      return c;
+    } catch (e) {
+      s.removeItem(STORAGE_KEY);
+      return null;
+    }
+  }
+
+  function writeConsent(choices) {
+    var s = storage();
+    if (!s) return;
+    var c = defaults();
+    OPTIONAL_CATEGORIES.forEach(function (k) { c[k] = choices[k] === true; });
+    s.setItem(STORAGE_KEY, JSON.stringify({ v: SCHEMA_VERSION, d: today(), c: c }));
+  }
+
+  function currentConsent() {
+    if (optOutSignal()) return defaults();
+    return readConsent() || defaults();
+  }
+
+  function hasConsent(category) {
+    if (OPTIONAL_CATEGORIES.indexOf(category) === -1) return false;
+    return currentConsent()[category] === true;
+  }
+
+  function notify() {
+    var c = currentConsent();
+    listeners.slice().forEach(function (fn) {
+      try { fn(c); } catch (e) { /* isolate listener errors */ }
+    });
+  }
+
+  function onChange(fn) {
+    if (typeof fn !== 'function') return function () {};
+    listeners.push(fn);
+    return function () {
+      var i = listeners.indexOf(fn);
+      if (i !== -1) listeners.splice(i, 1);
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Privacy choices dialog
+  // ---------------------------------------------------------------------------
+  var dialog, form, signalNote;
+
+  function syncDialog() {
+    if (!form) return;
+    var locked = optOutSignal();
+    var c = currentConsent();
+    if (signalNote) signalNote.hidden = !locked;
+    OPTIONAL_CATEGORIES.forEach(function (k) {
+      var input = form.querySelector('[data-privacy-toggle="' + k + '"]');
+      if (!input) return;
+      input.checked = c[k];
+      input.disabled = locked;
+    });
+  }
+
+  function openChoices() {
+    if (!dialog) return;
+    syncDialog();
+    if (typeof dialog.showModal === 'function') {
+      if (!dialog.open) dialog.showModal();
+    } else {
+      dialog.setAttribute('open', ''); // Very old browsers without <dialog>.
+    }
+  }
+
+  function handleClose() {
+    var action = dialog.returnValue;
+    dialog.returnValue = '';
+    if (action !== 'save' && action !== 'reject') return; // Esc / dismissed: no change.
+    var choices = defaults();
+    if (action === 'save' && !optOutSignal()) {
+      OPTIONAL_CATEGORIES.forEach(function (k) {
+        var input = form.querySelector('[data-privacy-toggle="' + k + '"]');
+        choices[k] = !!(input && input.checked);
+      });
+    }
+    writeConsent(choices);
+    notify();
+  }
+
+  function initDialog() {
+    dialog = document.getElementById('privacy-dialog');
+    if (!dialog) return;
+    form = dialog.querySelector('[data-privacy-form]');
+    signalNote = dialog.querySelector('[data-privacy-signal]');
+    dialog.addEventListener('close', handleClose);
+
+    // Fallback for browsers without <dialog>: emulate method="dialog".
+    if (typeof dialog.showModal !== 'function' && form) {
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        dialog.returnValue = (e.submitter && e.submitter.value) || '';
+        dialog.removeAttribute('open');
+        handleClose();
+      });
+    }
+
+    var openers = document.querySelectorAll('[data-privacy-open]');
+    Array.prototype.forEach.call(openers, function (btn) {
+      btn.hidden = false;
+      btn.addEventListener('click', openChoices);
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Secure logout: wipe client-side state before the POST goes out.
+  // The server should also respond with `Clear-Site-Data` (see /_headers).
+  // ---------------------------------------------------------------------------
+  function clearClientState() {
+    try {
+      var ss = window.sessionStorage;
+      if (ss) ss.clear();
+    } catch (e) { /* ignore */ }
+    var ls = storage();
+    if (ls) {
+      for (var i = ls.length - 1; i >= 0; i--) {
+        var key = ls.key(i);
+        if (key && key !== STORAGE_KEY && key.indexOf(SESSION_STORAGE_PREFIX) === 0) {
+          ls.removeItem(key);
+        }
+      }
+    }
+    if (window.caches && typeof window.caches.keys === 'function') {
+      window.caches.keys().then(function (names) {
+        names.forEach(function (n) { window.caches.delete(n); });
+      }).catch(function () {});
+    }
+  }
+
+  function initLogout() {
+    var forms = document.querySelectorAll('form[data-logout]');
+    Array.prototype.forEach.call(forms, function (f) {
+      f.addEventListener('submit', clearClientState);
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Outbound link hardening: never leak window.opener or full referrers to
+  // other origins, even if someone adds an external link later.
+  // ---------------------------------------------------------------------------
+  function hardenLinks() {
+    var links = document.querySelectorAll('a[href]');
+    Array.prototype.forEach.call(links, function (a) {
+      var url;
+      try { url = new URL(a.href, location.href); } catch (e) { return; }
+      if (url.origin === location.origin || !/^https?:$/.test(url.protocol)) return;
+      var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+      ['noopener', 'noreferrer'].forEach(function (r) {
+        if (rel.indexOf(r) === -1) rel.push(r);
+      });
+      a.setAttribute('rel', rel.join(' '));
+      a.setAttribute('referrerpolicy', 'no-referrer');
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Third-party audit (runtime). Flags any request leaving our origin that is
+  // not explicitly allowlisted, plus any CSP violation. Only URL origins are
+  // recorded — never query strings, which may carry personal data.
+  // ---------------------------------------------------------------------------
+  function isAllowedOrigin(origin) {
+    return origin === location.origin || THIRD_PARTY_ALLOWLIST.indexOf(origin) !== -1;
+  }
+
+  function recordResource(name, type) {
+    var origin;
+    try { origin = new URL(name, location.href).origin; } catch (e) { return; }
+    if (origin === 'null' || isAllowedOrigin(origin)) return;
+    var already = audit.thirdParty.some(function (r) { return r.origin === origin; });
+    if (already) return;
+    audit.thirdParty.push({ origin: origin, type: type || 'unknown' });
+    if (window.console && console.warn) {
+      console.warn('[privacy-audit] Unapproved third-party request to ' + origin +
+        ' (' + (type || 'unknown') + '). Review it before shipping.');
+    }
+  }
+
+  function initAudit() {
+    if (window.performance && typeof performance.getEntriesByType === 'function') {
+      performance.getEntriesByType('resource').forEach(function (e) {
+        recordResource(e.name, e.initiatorType);
+      });
+    }
+    if (typeof window.PerformanceObserver === 'function') {
+      try {
+        new PerformanceObserver(function (list) {
+          list.getEntries().forEach(function (e) { recordResource(e.name, e.initiatorType); });
+        }).observe({ type: 'resource', buffered: true });
+      } catch (e) { /* unsupported entry type */ }
+    }
+    document.addEventListener('securitypolicyviolation', function (e) {
+      var blocked;
+      try { blocked = new URL(e.blockedURI).origin; } catch (err) { blocked = e.blockedURI; }
+      audit.cspViolations.push({ directive: e.effectiveDirective, blocked: blocked });
+      if (window.console && console.warn) {
+        console.warn('[privacy-audit] CSP blocked ' + blocked + ' (' + e.effectiveDirective + ').');
+      }
+    });
+  }
+
+  function auditReport() {
+    return {
+      thirdParty: audit.thirdParty.slice(),
+      cspViolations: audit.cspViolations.slice(),
+      allowlist: THIRD_PARTY_ALLOWLIST.slice(),
+      optOutSignal: optOutSignal()
+    };
+  }
+
+  // ---------------------------------------------------------------------------
+  // Boot
+  // ---------------------------------------------------------------------------
+  // Honor GPC/DNT immediately: drop any earlier opt-in that may have been saved.
+  if (optOutSignal() && readConsent()) writeConsent(defaults());
+
+  initAudit();
+
+  function onReady() {
+    initDialog();
+    initLogout();
+    hardenLinks();
+  }
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', onReady);
+  } else {
+    onReady();
+  }
+
+  // Keep tabs in sync when the choice changes elsewhere.
+  window.addEventListener('storage', function (e) {
+    if (e.key === STORAGE_KEY) { syncDialog(); notify(); }
+  });
+
+  window.DailyGrindPrivacy = Object.freeze({
+    hasConsent: hasConsent,
+    onChange: onChange,
+    openChoices: openChoices,
+    auditReport: auditReport
+  });
+})();
