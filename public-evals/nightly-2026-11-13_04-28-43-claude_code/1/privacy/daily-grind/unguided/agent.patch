+#!/usr/bin/env node
+/**
+ * Static privacy & third-party audit for The Daily Grind site.
+ *
+ * Fails (exit 1) if the shipped files:
+ *  - reference any third-party origin not in ALLOWED_THIRD_PARTIES
+ *  - contain known tracker / analytics / ad-tech signatures
+ *  - use inline <script>, inline event handlers, inline style attributes or
+ *    <style> blocks (would require weakening the CSP)
+ *  - open new windows without rel="noopener noreferrer"
+ *  - send personal data over GET forms
+ *  - have a <meta> CSP that drifts from the one in _headers
+ *  - ship images that still carry EXIF/XMP metadata (GPS, device, author)
+ *
+ * Usage: node scripts/privacy-audit.mjs [rootDir]
+ * No dependencies — runs on plain Node 18+.
+ */
+import { readdir, readFile } from 'node:fs/promises';
+import { join, relative, extname } from 'node:path';
+
+const ROOT = process.argv[2] ?? new URL('..', import.meta.url).pathname;
+
+// Must match THIRD_PARTY_ALLOWLIST in assets/js/privacy.js and the CSP.
+const ALLOWED_THIRD_PARTIES = new Set([]);
+
+// Hosts that may appear in text without causing a request (docs, specs).
+const NON_REQUEST_HOSTS = new Set(['www.w3.org', 'dailygrind.example']);
+
+const TRACKER_SIGNATURES = [
+  /google-analytics\.com|googletagmanager\.com|gtag\(|\bga\(\s*['"]create/i,
+  /doubleclick\.net|googlesyndication\.com|adservice\.google/i,
+  /connect\.facebook\.net|fbq\(|facebook\.com\/tr/i,
+  /hotjar\.com|clarity\.ms|fullstory\.com|mouseflow\.com|smartlook/i,
+  /segment\.(com|io)|mixpanel\.com|amplitude\.com|heap(analytics)?\.(com|io)/i,
+  /tiktok\.com\/i18n\/pixel|snap\.licdn\.com|ads-twitter\.com|bat\.bing\.com/i,
+  /fonts\.googleapis\.com|fonts\.gstatic\.com/i,
+  /navigator\.(plugins|hardwareConcurrency|deviceMemory)|getChannelData|toDataURL\(|measureText\(/i,
+];
+
+const SCAN_EXT = new Set(['.html', '.htm', '.css', '.js', '.mjs', '.json', '.svg', '.webmanifest']);
+const IMAGE_EXT = new Set(['.jpg', '.jpeg']);
+const SKIP_DIRS = new Set(['.git', 'node_modules', 'scripts', '.claude']);
+
+const findings = [];
+const report = (file, rule, detail) => findings.push({ file, rule, detail });
+
+async function* walk(dir) {
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    if (entry.isDirectory()) {
+      if (!SKIP_DIRS.has(entry.name)) yield* walk(join(dir, entry.name));
+    } else {
+      yield join(dir, entry.name);
+    }
+  }
+}
+
+function stripComments(text, ext) {
+  if (ext === '.html' || ext === '.htm' || ext === '.svg') return text.replace(/<!--[\s\S]*?-->/g, '');
+  if (ext === '.css' || ext === '.js' || ext === '.mjs') {
+    return text.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:\\])\/\/.*$/gm, '$1');
+  }
+  return text;
+}
+
+function auditUrls(file, text) {
+  const urlRe = /(?:https?:)?\/\/([a-z0-9.-]+\.[a-z]{2,})(?::\d+)?/gi;
+  for (const m of text.matchAll(urlRe)) {
+    const host = m[1].toLowerCase();
+    if (NON_REQUEST_HOSTS.has(host)) continue;
+    const origin = `https://${host}`;
+    if (!ALLOWED_THIRD_PARTIES.has(origin)) {
+      report(file, 'third-party-origin', `${host} is not an approved third party`);
+    }
+  }
+}
+
+function auditHtml(file, html) {
+  if (/<script(?![^>]*\bsrc=)[^>]*>\s*\S/i.test(html)) report(file, 'inline-script', 'inline <script> blocks violate script-src \'self\'');
+  if (/\son[a-z]+\s*=/i.test(html)) report(file, 'inline-handler', 'inline event handler attributes violate the CSP');
+  if (/<style[\s>]/i.test(html)) report(file, 'inline-style', '<style> blocks violate style-src \'self\'');
+  if (/\sstyle\s*=/i.test(html)) report(file, 'inline-style', 'style="" attributes violate style-src \'self\'');
+  if (/<iframe|<embed|<object/i.test(html)) report(file, 'embed', 'embeds load third-party content and set cookies');
+
+  for (const m of html.matchAll(/<a\b[^>]*target\s*=\s*["']?_blank[^>]*>/gi)) {
+    if (!/rel\s*=\s*["'][^"']*noopener[^"']*noreferrer|rel\s*=\s*["'][^"']*noreferrer[^"']*noopener/i.test(m[0])) {
+      report(file, 'tabnabbing', `${m[0].slice(0, 60)}… needs rel="noopener noreferrer"`);
+    }
+  }
+
+  for (const m of html.matchAll(/<form\b([^>]*)>([\s\S]*?)<\/form>/gi)) {
+    const attrs = m[1];
+    const body = m[2];
+    const method = (attrs.match(/method\s*=\s*["']?(\w+)/i)?.[1] ?? 'get').toLowerCase();
+    const sensitive = /type\s*=\s*["']?(password|email|tel)|name\s*=\s*["']?(email|phone|password|card|address|dob)/i.test(body);
+    if (method === 'get' && sensitive) report(file, 'pii-in-url', 'form with personal data uses GET (leaks into URLs, logs, referrers)');
+    if (/action\s*=\s*["']?http:/i.test(attrs)) report(file, 'insecure-form', 'form posts over plain HTTP');
+  }
+
+  if (/<a\b[^>]*href\s*=\s*["']\/logout["']/i.test(html)) {
+    report(file, 'logout-get', 'logout via GET link is CSRF-able and prefetchable; use a POST form');
+  }
+}
+
+function extractCsp(text) {
+  return text.replace(/\s+/g, ' ').trim().split(/\s*;\s*/).filter(Boolean)
+    .filter((d) => !/^(frame-ancestors|report-uri|report-to|sandbox)\b/.test(d))
+    .sort().join('; ');
+}
+
+async function auditCspSync(htmlFiles) {
+  let headers;
+  try {
+    headers = await readFile(join(ROOT, '_headers'), 'utf8');
+  } catch {
+    report('_headers', 'missing-headers', 'no _headers file with security headers');
+    return;
+  }
+  const headerCsp = headers.match(/^\s*Content-Security-Policy:\s*(.+)$/m)?.[1];
+  if (!headerCsp) return report('_headers', 'missing-csp', 'no Content-Security-Policy header');
+  for (const required of ['Strict-Transport-Security', 'Referrer-Policy', 'X-Content-Type-Options', 'Permissions-Policy', 'Clear-Site-Data']) {
+    if (!headers.includes(`${required}:`)) report('_headers', 'missing-header', `${required} is not set`);
+  }
+  for (const [file, html] of htmlFiles) {
+    const meta = html.match(/<meta\s+http-equiv=["']Content-Security-Policy["']\s+content=(["'])([\s\S]*?)\1/i)?.[2];
+    if (!meta) { report(file, 'missing-csp', 'no <meta> CSP fallback'); continue; }
+    if (extractCsp(meta) !== extractCsp(headerCsp)) report(file, 'csp-drift', '<meta> CSP differs from _headers CSP');
+  }
+}
+
+function auditJpegMetadata(file, buf) {
+  // Walk JPEG segments until start-of-scan, flagging APP1 (EXIF/XMP) and APP13 (IPTC).
+  let i = 2;
+  while (i + 4 <= buf.length && buf[i] === 0xff) {
+    const marker = buf[i + 1];
+    if (marker === 0xda) break;
+    if (marker === 0xe1) report(file, 'image-metadata', 'EXIF/XMP metadata present (may include GPS, device, author)');
+    if (marker === 0xed) report(file, 'image-metadata', 'IPTC metadata present');
+    i += 2 + buf.readUInt16BE(i + 2);
+  }
+}
+
+const htmlFiles = [];
+for await (const path of walk(ROOT)) {
+  const file = relative(ROOT, path);
+  const ext = extname(path).toLowerCase();
+  if (IMAGE_EXT.has(ext)) { auditJpegMetadata(file, await readFile(path)); continue; }
+  if (!SCAN_EXT.has(ext)) continue;
+  const raw = await readFile(path, 'utf8');
+  const text = stripComments(raw, ext);
+  auditUrls(file, text);
+  for (const sig of TRACKER_SIGNATURES) {
+    const hit = text.match(sig);
+    if (hit) report(file, 'tracker-signature', `matched "${hit[0]}"`);
+  }
+  if (ext === '.html' || ext === '.htm') { auditHtml(file, text); htmlFiles.push([file, raw]); }
+}
+await auditCspSync(htmlFiles);
+
+if (findings.length) {
+  console.error(`Privacy audit failed with ${findings.length} finding(s):\n`);
+  for (const f of findings) console.error(`  ✗ ${f.file}  [${f.rule}]  ${f.detail}`);
+  process.exit(1);
+}
+console.log(`Privacy audit passed: ${htmlFiles.length} HTML file(s), 0 third-party origins, CSP in sync.`);
