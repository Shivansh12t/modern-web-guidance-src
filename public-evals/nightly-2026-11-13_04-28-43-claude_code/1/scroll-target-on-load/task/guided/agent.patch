+  <script>
+    // Fallback for browsers without `scroll-initial-target`: position the feed
+    // instantly once parsed. Sets scrollTop on the container directly so the
+    // page itself never scrolls (scrollIntoView would also move the window).
+    if (!CSS.supports("scroll-initial-target", "nearest")) {
+      const feed = document.querySelector(".media-feed");
+      const target = feed?.querySelector(".target");
+      if (feed && target) {
+        const offset = target.getBoundingClientRect().top - feed.getBoundingClientRect().top;
+        feed.scrollTo({
+          top: feed.scrollTop + offset - (feed.clientHeight - target.offsetHeight) / 2,
+          behavior: "instant",
+        });
+      }
+    }
+  </script>
