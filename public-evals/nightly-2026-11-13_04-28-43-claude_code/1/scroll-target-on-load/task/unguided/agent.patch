+    /* Media scroller */
+    .media-scroller {
+      height: 480px;
+      overflow-y: auto;
+      scroll-behavior: auto; /* never animate programmatic scrolling */
+      overscroll-behavior: contain;
+      margin-top: 20px;
+      padding: 16px;
+      background: var(--secondary);
+      border-radius: 8px;
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+    }
+
+    .media-card {
+      display: flex;
+      gap: 16px;
+      align-items: center;
+      flex-shrink: 0;
+      background: white;
+      border-radius: 8px;
+      padding: 12px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      display: block;
+      width: 160px;
+      height: 120px;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: 6px;
+      flex-shrink: 0;
+      background: var(--secondary);
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .media-card.target {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
     footer {
       background: var(--secondary);
