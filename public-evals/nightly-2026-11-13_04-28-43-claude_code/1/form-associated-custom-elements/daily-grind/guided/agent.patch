@@ -0,0 +1,301 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Participates natively in forms through ElementInternals:
+ *   - submits its value under its `name` attribute (no hidden input)
+ *   - `required` constraint validation (valueMissing) that blocks submission
+ *   - form reset (restores the default from the `value` attribute)
+ *   - disabled via its own `disabled` attribute or an ancestor <fieldset disabled>
+ *   - back/forward + autocomplete state restoration
+ *
+ * Attributes: name, value (default value), max (default 5), required, disabled
+ * Exposes `:state(user-invalid)` once a submit attempt fails while empty.
+ */
+const LABELS = ['Terrible', 'Poor', 'Okay', 'Good', 'Excellent'];
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 0.75rem;
+      --star-off: #bcaaa4;
+      --star-on: #f59e0b;
+      --star-focus: #4e342e;
+    }
+    :host(:disabled) { opacity: 0.55; }
+    /* Separate rules: an unsupported :state() must not drop the fallback. */
+    :host(:state(user-invalid)) .stars {
+      outline: 2px solid #b3261e;
+      outline-offset: 4px;
+      border-radius: 6px;
+    }
+    :host([data-user-invalid]) .stars {
+      outline: 2px solid #b3261e;
+      outline-offset: 4px;
+      border-radius: 6px;
+    }
+    .stars { display: inline-flex; }
+    button {
+      all: unset;
+      box-sizing: border-box;
+      display: grid;
+      place-items: center;
+      inline-size: 48px;
+      block-size: 48px;
+      cursor: pointer;
+      border-radius: 6px;
+      color: var(--star-off);
+      transition: color 0.15s, transform 0.15s;
+    }
+    button:focus-visible {
+      outline: 3px solid var(--star-focus);
+      outline-offset: -3px;
+    }
+    button[data-on] { color: var(--star-on); }
+    /* Hover preview: fill up to the hovered star, unfill the rest. */
+    .stars:not(:has(:disabled)):hover button { color: var(--star-on); }
+    .stars:not(:has(:disabled)) button:hover ~ button { color: var(--star-off); }
+    button:disabled { cursor: not-allowed; }
+    svg { inline-size: 32px; block-size: 32px; fill: currentColor; }
+    @media (prefers-reduced-motion: no-preference) {
+      .stars:not(:has(:disabled)) button:hover { transform: scale(1.12); }
+    }
+    @media (forced-colors: active) {
+      button { color: GrayText; }
+      button[data-on], .stars:not(:has(:disabled)):hover button { color: Highlight; }
+    }
+    .caption { min-inline-size: 7ch; font-weight: 600; }
+  </style>
+  <div class="stars" part="stars"></div>
+  <span class="caption" part="caption" aria-hidden="true"></span>
+`;
+
+const STAR_SVG =
+  '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg>';
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'max', 'value'];
+
+  #internals;
+  #value = '';
+  #dirty = false; // like <input>: once the user picks, the `value` attribute stops driving the value
+  #disabled = false;
+  #userInvalid = false;
+  #stars;
+  #caption;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#stars = root.querySelector('.stars');
+    this.#caption = root.querySelector('.caption');
+
+    this.#stars.addEventListener('click', (e) => {
+      const btn = e.target.closest('button');
+      if (btn && !btn.disabled) this.#pick(Number(btn.dataset.value));
+    });
+    this.#stars.addEventListener('keydown', (e) => this.#onKeydown(e));
+    // A failed submit (or checkValidity/reportValidity) fires `invalid` on us.
+    this.addEventListener('invalid', () => this.#setUserInvalid(true));
+  }
+
+  connectedCallback() {
+    if (!this.#stars.childElementCount) this.#render();
+    if (!this.#dirty) this.#setValue(this.getAttribute('value') ?? '');
+  }
+
+  attributeChangedCallback(name) {
+    if (!this.#stars) return;
+    if (name === 'max') {
+      this.#render();
+      this.#setValue(this.#value); // re-clamp
+    } else if (name === 'value' && !this.#dirty) {
+      this.#setValue(this.getAttribute('value') ?? '');
+    } else {
+      this.#validate();
+    }
+  }
+
+  // ---- Public API mirroring native controls ----
+  get max() {
+    const n = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(n) && n > 0 && n <= 10 ? n : 5;
+  }
+  set max(v) { this.setAttribute('max', v); }
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+  get valueAsNumber() { return this.#value ? Number(this.#value) : NaN; }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get userInvalid() { return this.#userInvalid; }
+
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get type() { return this.localName; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  // ---- Form lifecycle callbacks ----
+  formResetCallback() {
+    this.#dirty = false;
+    this.#setUserInvalid(false);
+    this.#setValue(this.defaultValue);
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable the inner buttons rather than toggling `disabled` on the host, so an
+    // ancestor <fieldset disabled> can re-enable us. The host matches :disabled itself.
+    this.#disabled = disabled;
+    for (const btn of this.#buttons()) btn.disabled = disabled;
+    this.#syncTabStops();
+  }
+
+  formStateRestoreCallback(state) {
+    // Called for back/forward restoration ("restore") and browser autofill ("autocomplete").
+    this.#dirty = true;
+    this.#setValue(typeof state === 'string' ? state : '');
+  }
+
+  // ---- Internals ----
+  #buttons() { return this.#stars.querySelectorAll('button'); }
+
+  #render() {
+    const max = this.max;
+    const frag = document.createDocumentFragment();
+    for (let i = 1; i <= max; i++) {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.setAttribute('role', 'radio');
+      btn.dataset.value = String(i);
+      btn.setAttribute('aria-label', `${i} ${i === 1 ? 'star' : 'stars'}`);
+      btn.disabled = this.#disabled;
+      btn.innerHTML = STAR_SVG;
+      frag.append(btn);
+    }
+    this.#stars.replaceChildren(frag);
+  }
+
+  #setValue(raw) {
+    const n = parseInt(raw, 10);
+    const v = Number.isInteger(n) && n >= 1 && n <= this.max ? String(n) : '';
+    this.#value = v;
+    // Second argument is the state handed back to formStateRestoreCallback.
+    this.#internals.setFormValue(v || null, v);
+    if (v) this.#setUserInvalid(false);
+    this.#update();
+    this.#validate();
+  }
+
+  #update() {
+    const current = Number(this.#value) || 0;
+    for (const btn of this.#buttons()) {
+      const n = Number(btn.dataset.value);
+      btn.toggleAttribute('data-on', n <= current);
+      btn.setAttribute('aria-checked', String(n === current));
+    }
+    this.#caption.textContent = current
+      ? `${current}/${this.max}${this.max === 5 ? ` · ${LABELS[current - 1]}` : ''}`
+      : '';
+    this.#syncTabStops();
+  }
+
+  // Roving tabindex: one tab stop, on the checked star (or the first one).
+  #syncTabStops() {
+    const current = Number(this.#value) || 1;
+    for (const btn of this.#buttons()) {
+      btn.tabIndex = Number(btn.dataset.value) === current ? 0 : -1;
+    }
+  }
+
+  #validate() {
+    if (this.required && !this.#value) {
+      const anchor = this.#stars.querySelector('[tabindex="0"]') ?? undefined;
+      this.#internals.setValidity({ valueMissing: true }, 'Please choose a star rating.', anchor);
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+
+  #setUserInvalid(on) {
+    on = on && !this.#internals.validity.valid;
+    this.#userInvalid = on;
+    this.#internals.ariaInvalid = on ? 'true' : 'false';
+    try {
+      if (on) this.#internals.states.add('user-invalid');
+      else this.#internals.states.delete('user-invalid');
+    } catch {
+      // CustomStateSet unsupported: fall back to an attribute hook for styling.
+      this.toggleAttribute('data-user-invalid', on);
+    }
+  }
+
+  #pick(n) {
+    if (this.#disabled) return;
+    const prev = this.#value;
+    this.#dirty = true;
+    this.#setValue(n);
+    this.#stars.querySelector(`[data-value="${n}"]`)?.focus();
+    if (this.#value !== prev) {
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    }
+  }
+
+  #onKeydown(e) {
+    if (this.#disabled) return;
+    const max = this.max;
+    const current = Number(this.#value) || 0;
+    const rtl = getComputedStyle(this).direction === 'rtl';
+    let next;
+    switch (e.key) {
+      case 'ArrowRight': next = current + (rtl ? -1 : 1); break;
+      case 'ArrowLeft': next = current + (rtl ? 1 : -1); break;
+      case 'ArrowUp': next = current + 1; break;
+      case 'ArrowDown': next = current - 1; break;
+      case 'Home': next = 1; break;
+      case 'End': next = max; break;
+      case ' ':
+      case 'Enter': {
+        // Space/Enter select the focused star (matches the click behaviour).
+        const btn = e.target.closest('button');
+        if (!btn) return;
+        e.preventDefault();
+        this.#pick(Number(btn.dataset.value));
+        return;
+      }
+      default: return;
+    }
+    e.preventDefault();
+    // Radio-group convention: arrows wrap around.
+    if (next < 1) next = max;
+    if (next > max) next = 1;
+    this.#pick(next);
+  }
+}
+
+customElements.define('star-rating', StarRating);
