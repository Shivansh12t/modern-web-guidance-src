+  <script>
+    (() => {
+      const form = document.getElementById('feedback-form');
+      const pastryToggle = document.getElementById('fb-had-pastry');
+      const pastryFieldset = document.getElementById('fb-pastry');
+      const captions = ['', 'Not for me', 'Okay', 'Good', 'Great', 'Perfect cup'];
+
+      // Turn the pastry fieldset on or off. The checkbox sits in the fieldset's
+      // first <legend>, so it stays usable while the rest is disabled.
+      const syncPastry = () => { pastryFieldset.disabled = !pastryToggle.checked; };
+      pastryToggle.addEventListener('change', syncPastry);
+
+      const updateCaption = (rating) => {
+        const el = form.querySelector(`[data-caption-for="${rating.id}"]`);
+        if (el) el.textContent = captions[rating.valueAsNumber] || '';
+      };
+      const updateAllCaptions = () => form.querySelectorAll('star-rating').forEach(updateCaption);
+      form.addEventListener('input', (e) => {
+        if (e.target.localName === 'star-rating') updateCaption(e.target);
+      });
+
+      // Reset runs before the controls go back to their defaults, so wait a tick.
+      form.addEventListener('reset', () => setTimeout(() => { syncPastry(); updateAllCaptions(); }));
+
+      // Run after built-in and custom controls have restored their state.
+      const syncAll = () => customElements.whenDefined('star-rating').then(() => { syncPastry(); updateAllCaptions(); });
+      window.addEventListener('pageshow', syncAll);
+      syncAll();
+
+      // Thank-you message after the GET submission comes back to this page.
