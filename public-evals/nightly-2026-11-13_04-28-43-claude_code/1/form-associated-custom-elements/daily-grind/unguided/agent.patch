index 0000000..223a1b2
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,439 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Behaves like a native form control:
+ *   - Submits `name=value` with its form (nothing is submitted when unrated).
+ *   - Supports `required` (valueMissing) and setCustomValidity() (customError),
+ *     and works with checkValidity(), reportValidity() and interactive
+ *     validation when the form is submitted.
+ *   - Goes back to its default (the `value` attribute) when the form resets.
+ *   - Picks up disabled state from its own `disabled` attribute or from an
+ *     ancestor <fieldset disabled>. While disabled it is left out of
+ *     submission and validation.
+ *   - Restores its value on back/forward navigation and autofill.
+ *
+ * Attributes: name, value (default value), max (default 5), required, disabled
+ * Events: `input` and `change` fire when the user changes the rating.
+ * Custom states: :state(checked), :state(user-invalid)
+ * Parts: ::part(stars), ::part(star), ::part(star checked)
+ */
+
+const STAR_PATH =
+  'M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      --star-size: 2rem;
+      --star-gap: 0.25rem;
+      --star-fill: #ffab40;
+      --star-hover-fill: #ffc77a;
+      --star-empty: #d7ccc8;
+      --star-stroke: #8d6e63;
+      --star-focus: #4e342e;
+      display: inline-block;
+      vertical-align: middle;
+      -webkit-tap-highlight-color: transparent;
+    }
+    :host([hidden]) { display: none; }
+    :host(:disabled) { opacity: 0.45; }
+
+    .stars {
+      display: inline-flex;
+      gap: var(--star-gap);
+    }
+    .star {
+      display: inline-flex;
+      width: var(--star-size);
+      height: var(--star-size);
+      border-radius: 6px;
+      cursor: pointer;
+      outline: none;
+      transition: transform 0.12s ease;
+    }
+    :host(:disabled) .star { cursor: not-allowed; }
+    :host(:not(:disabled)) .star:hover { transform: scale(1.12); }
+    .star:focus-visible {
+      box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--star-focus);
+    }
+    svg {
+      width: 100%;
+      height: 100%;
+      pointer-events: none;
+    }
+    path {
+      fill: var(--star-empty);
+      stroke: var(--star-stroke);
+      stroke-width: 1;
+      stroke-linejoin: round;
+      transition: fill 0.12s ease;
+    }
+    .star.filled path { fill: var(--star-fill); }
+    .stars.previewing .star.filled path { fill: var(--star-hover-fill); }
+
+    @media (prefers-reduced-motion: reduce) {
+      .star, path { transition: none; }
+      :host(:not(:disabled)) .star:hover { transform: none; }
+    }
+  </style>
+  <div class="stars" part="stars"></div>
+`;
+
+const clampInt = (raw, min, max) => {
+  const n = Math.round(Number(raw));
+  if (!Number.isFinite(n)) return min;
+  return Math.min(max, Math.max(min, n));
+};
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'max', 'required'];
+
+  #internals;
+  #container;
+  #stars = [];
+  #value = 0; // 0 means "no rating"
+  #dirty = false; // true once the value is set by the user or a script
+  #disabled = false; // combined state reported by formDisabledCallback
+  #touched = false; // controls :state(user-invalid)
+  #preview = 0;
+  #customError = '';
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#container = root.querySelector('.stars');
+    this.#renderStars();
+
+    this.#container.addEventListener('click', this.#onClick);
+    this.#container.addEventListener('keydown', this.#onKeyDown);
+    this.#container.addEventListener('pointerover', this.#onPointerOver);
+    this.#container.addEventListener('pointerleave', this.#onPointerLeave);
+
+    // Clicking an associated <label> sends a click to the host itself.
+    this.addEventListener('click', (e) => {
+      if (e.composedPath()[0] === this) this.focus();
+    });
+
+    // Fired when the browser blocks a submit or reportValidity() fails.
+    this.addEventListener('invalid', () => {
+      this.#touched = true;
+      this.#updateStates();
+    });
+  }
+
+  connectedCallback() {
+    // Handle properties set before the element was upgraded.
+    for (const prop of ['value', 'max', 'required', 'disabled', 'name']) {
+      if (Object.prototype.hasOwnProperty.call(this, prop)) {
+        const v = this[prop];
+        delete this[prop];
+        this[prop] = v;
+      }
+    }
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    switch (name) {
+      case 'value':
+        if (!this.#dirty) this.#value = this.#parse(newValue);
+        break;
+      case 'max':
+        this.#renderStars();
+        this.#value = Math.min(this.#value, this.max);
+        break;
+    }
+    this.#sync();
+  }
+
+  // ---- Form lifecycle callbacks -------------------------------------------
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#touched = false;
+    this.#value = this.#parse(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    this.#disabled = disabled;
+    this.#preview = 0;
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state /* , mode: 'restore' | 'autocomplete' */) {
+    this.#dirty = true;
+    this.#value = this.#parse(state);
+    this.#sync();
+  }
+
+  // ---- Public API (matches native controls) --------------------------------
+
+  get value() {
+    return this.#value ? String(this.#value) : '';
+  }
+  set value(v) {
+    this.#dirty = true;
+    this.#value = this.#parse(v);
+    this.#sync();
+  }
+
+  get valueAsNumber() {
+    return this.#value;
+  }
+  set valueAsNumber(v) {
+    this.value = v;
+  }
+
+  get defaultValue() {
+    return this.getAttribute('value') ?? '';
+  }
+  set defaultValue(v) {
+    this.setAttribute('value', v);
+  }
+
+  get max() {
+    return clampInt(this.getAttribute('max') ?? 5, 1, 10);
+  }
+  set max(v) {
+    this.setAttribute('max', v);
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(v) {
+    this.setAttribute('name', v);
+  }
+
+  get required() {
+    return this.hasAttribute('required');
+  }
+  set required(v) {
+    this.toggleAttribute('required', Boolean(v));
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+  set disabled(v) {
+    this.toggleAttribute('disabled', Boolean(v));
+  }
+
+  get type() {
+    return this.localName;
+  }
+  get form() {
+    return this.#internals.form;
+  }
+  get labels() {
+    return this.#internals.labels;
+  }
+  get validity() {
+    return this.#internals.validity;
+  }
+  get validationMessage() {
+    return this.#internals.validationMessage;
+  }
+  get willValidate() {
+    return this.#internals.willValidate;
+  }
+
+  checkValidity() {
+    return this.#internals.checkValidity();
+  }
+  reportValidity() {
+    return this.#internals.reportValidity();
+  }
+  setCustomValidity(message) {
+    this.#customError = String(message ?? '');
+    this.#sync();
+  }
+
+  focus(options) {
+    this.#focusTarget()?.focus(options);
+  }
+  blur() {
+    this.shadowRoot.activeElement?.blur();
+  }
+
+  // ---- Internals ------------------------------------------------------------
+
+  #parse(raw) {
+    if (raw === null || raw === undefined || raw === '') return 0;
+    return clampInt(raw, 0, this.max);
+  }
+
+  #renderStars() {
+    const max = this.max;
+    this.#container.replaceChildren();
+    this.#stars = [];
+    for (let i = 1; i <= max; i++) {
+      const star = document.createElement('span');
+      star.className = 'star';
+      star.part = 'star';
+      star.dataset.value = String(i);
+      star.setAttribute('role', 'radio');
+      star.setAttribute('aria-label', `${i} ${i === 1 ? 'star' : 'stars'}`);
+      star.setAttribute('aria-posinset', String(i));
+      star.setAttribute('aria-setsize', String(max));
+      star.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${STAR_PATH}"/></svg>`;
+      this.#container.append(star);
+      this.#stars.push(star);
+    }
+  }
+
+  #focusTarget() {
+    return this.#stars[Math.max(0, this.#value - 1)];
+  }
+
+  #sync() {
+    const value = this.#value;
+    const shown = this.#preview || value;
+    const focusIndex = Math.max(0, value - 1);
+
+    this.#container.classList.toggle('previewing', this.#preview > 0);
+    this.#stars.forEach((star, i) => {
+      const checked = i + 1 === value;
+      star.classList.toggle('filled', i < shown);
+      star.part = checked ? 'star checked' : 'star';
+      star.setAttribute('aria-checked', String(checked));
+      star.tabIndex = !this.#disabled && i === focusIndex ? 0 : -1;
+    });
+
+    // Form value + state used when restoring after navigation.
+    this.#internals.setFormValue(value ? String(value) : null, String(value));
+
+    // Validity. The anchor makes the browser's bubble point at the stars.
+    const anchor = this.#focusTarget();
+    if (this.#customError) {
+      this.#internals.setValidity({ customError: true }, this.#customError, anchor);
+    } else if (this.required && !value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        this.dataset.requiredMessage || 'Please select a rating.',
+        anchor
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(this.#disabled);
+    this.#updateStates();
+  }
+
+  #updateStates() {
+    const states = this.#internals.states;
+    if (!states) return;
+    const set = (name, on) => {
+      try {
+        on ? states.add(name) : states.delete(name);
+      } catch {
+        // Older Chromium only accepted the legacy `--name` form.
+        on ? states.add(`--${name}`) : states.delete(`--${name}`);
+      }
+    };
+    set('checked', this.#value > 0);
+    set('user-invalid', this.#touched && this.#internals.willValidate && !this.#internals.validity.valid);
+  }
+
+  #commit(next) {
+    const value = this.#parse(next);
+    if (value === this.#value) return;
+    this.#dirty = true;
+    this.#touched = true;
+    this.#value = value;
+    this.#sync();
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #starFromEvent(e) {
+    return e.target instanceof Element ? e.target.closest('.star') : null;
+  }
+
+  #onClick = (e) => {
+    const star = this.#starFromEvent(e);
+    if (!star || this.#disabled) return;
+    this.#commit(star.dataset.value);
+    this.#focusTarget()?.focus();
+  };
+
+  #onKeyDown = (e) => {
+    if (this.#disabled) return;
