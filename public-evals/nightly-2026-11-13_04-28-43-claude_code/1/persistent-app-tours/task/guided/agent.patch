     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // Load polyfills only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    const tourStep = document.getElementById("tour-step");
+    const rewardsLink = document.getElementById("feature");
+    const isTourOpen = () =>
+      tourStep.matches(":popover-open") || tourStep.classList.contains(":popover-open");
+
+    // Open by default. popover="manual" means it is not light-dismissed by
+    // clicks elsewhere; it only closes via the "Got it" button.
+    tourStep.showPopover();
+
+    // Don't navigate away while the tour step is showing.
+    rewardsLink.addEventListener("click", (event) => {
+      if (isTourOpen()) event.preventDefault();
+    });
+
+    // Return focus to the related control once the tour step is dismissed.
+    tourStep.addEventListener("toggle", (event) => {
+      const active = document.activeElement;
+      if (event.newState === "closed" && (!active || active === document.body || tourStep.contains(active))) {
+        rewardsLink.focus();
+      }
+    });
+  </script>
+
 </body>
 
