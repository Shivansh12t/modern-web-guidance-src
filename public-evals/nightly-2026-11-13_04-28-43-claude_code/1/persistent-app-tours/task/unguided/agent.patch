+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var step = document.getElementById('tour-step');
+      var closeBtn = step.querySelector('.tour-close');
+      var supportsPopover = typeof step.showPopover === 'function';
+      var supportsAnchor = window.CSS && CSS.supports && CSS.supports('anchor-name: --a');
+      var open = false;
+      var rafId = 0;
+
+      // JS fallback positioning for browsers without CSS anchor positioning.
+      function place() {
+        var r = link.getBoundingClientRect();
+        var w = step.offsetWidth;
+        var h = step.offsetHeight;
+        var gap = 12;
+        var left = r.left + r.width / 2 - w / 2;
+        left = Math.max(8, Math.min(left, window.innerWidth - w - 8));
+        var top = r.bottom + gap;
+        if (top + h > window.innerHeight && r.top - gap - h >= 0) top = r.top - gap - h;
+        step.style.left = left + 'px';
+        step.style.top = top + 'px';
+      }
+
+      function track() {
+        if (!open) return;
+        place();
+        rafId = requestAnimationFrame(track);
+      }
+
+      function setOpen(isOpen) {
+        open = isOpen;
+        document.body.classList.toggle('tour-active', isOpen);
+        if (isOpen) {
+          link.setAttribute('aria-describedby', 'tour-step');
+          if (!supportsAnchor) {
+            step.style.position = 'fixed';
+            cancelAnimationFrame(rafId);
+            track();
+          }
+        } else {
+          link.removeAttribute('aria-describedby');
+          cancelAnimationFrame(rafId);
+        }
+      }
+
+      function openTour() {
+        if (supportsPopover) {
+          step.showPopover();
+        } else {
+          step.style.display = 'block';
+          step.style.zIndex = '1001';
+          setOpen(true);
+        }
+      }
+
+      function closeTour() {
+        if (supportsPopover) {
+          if (step.matches(':popover-open')) step.hidePopover();
+        } else {
+          step.style.display = 'none';
+          setOpen(false);
+        }
+      }
+
+      if (supportsPopover) {
+        step.addEventListener('toggle', function (e) {
+          setOpen(e.newState === 'open');
+        });
+      } else {
+        closeBtn.addEventListener('click', closeTour);
+      }
+
+      // Keep the rewards link from navigating away while the tour is open.
+      link.addEventListener('click', function (e) {
+        if (open) e.preventDefault();
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && open) closeTour();
+      });
+
+      openTour();
+    })();
+  </script>
+
