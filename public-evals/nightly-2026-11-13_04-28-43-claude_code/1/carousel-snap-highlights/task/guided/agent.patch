+    /* Seasonal Favorites carousel */
+    .carousel {
+      --item-width: min(75vw, 280px);
+      display: flex;
+      gap: 32px;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Room for the scaled-up (1.15) card and its shadow, and let the
+         first/last items reach the center snap point */
+      padding-block: 40px;
+      padding-inline: calc(50% - var(--item-width) / 2);
+      margin-top: 20px;
+    }
+
+    .carousel:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel-item .card {
+      height: 100%;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    .carousel-item .card h3 {
+      transition: color 0.4s;
+    }
+
+    .carousel-item .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* Highlight only the snapped card; disabled entirely for reduced motion
+       because the white-to-blue change produces a flash */
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+
+        .card h3 {
+          color: white;
+        }
+      }
+
+      /* JS fallback for browsers without scroll-state queries */
+      .carousel-item.is-snapped .card {
+        background: #007bff;
+        color: white;
+        scale: 1.15;
+        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+      }
+
+      .carousel-item.is-snapped .card h3 {
+        color: white;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel-item .card,
+      .carousel-item .card h3 {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
   </style>
