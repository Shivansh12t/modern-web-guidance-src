+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+      var items = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-item'));
+
+      function setSnapped(target) {
+        items.forEach(function (item) {
+          item.classList.toggle('is-snapped', item === target);
+        });
+      }
+
+      // Find the item whose center is closest to the carousel's center.
+      function closestItem() {
+        var rect = carousel.getBoundingClientRect();
+        var center = rect.left + rect.width / 2;
+        var best = null, bestDist = Infinity;
+        items.forEach(function (item) {
+          var r = item.getBoundingClientRect();
+          var dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) { bestDist = dist; best = item; }
+        });
+        return best;
+      }
+
+      if ('onscrollsnapchange' in window) {
+        // Native snap events (Chromium 129+).
+        carousel.addEventListener('scrollsnapchange', function (e) {
+          if (e.snapTargetInline) setSnapped(e.snapTargetInline);
+        });
+      } else {
+        var timer;
+        var update = function () { setSnapped(closestItem()); };
+        if ('onscrollend' in window) {
+          carousel.addEventListener('scrollend', update);
+        } else {
+          carousel.addEventListener('scroll', function () {
+            clearTimeout(timer);
+            timer = setTimeout(update, 100);
+          }, { passive: true });
+        }
+      }
+
+      window.addEventListener('resize', function () { setSnapped(closestItem()); });
+      setSnapped(closestItem());
+    })();
+  </script>
