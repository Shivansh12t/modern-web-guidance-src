+/* WebMCP: highlight forms while an AI agent is filling them in.
+   Kept as separate rules so unsupported browsers drop only these. */
+form:tool-form-active {
+  outline: 2px dashed var(--color-amber-400, #fbbf24);
+  outline-offset: 4px;
+}
