+import 'react';
+
 declare global {
   interface Window {
     adNetwork: any; // Replace 'any' with a more specific type if you know it
   }
+
+  /** SubmitEvent extended by the WebMCP Declarative API. */
+  interface AgentSubmitEvent extends SubmitEvent {
+    /** True when an AI agent submitted the form through WebMCP. */
+    agentInvoked?: boolean;
+    /** Returns the tool result to the invoking agent. */
+    respondWith(result: Promise<unknown>): void;
+  }
+}
