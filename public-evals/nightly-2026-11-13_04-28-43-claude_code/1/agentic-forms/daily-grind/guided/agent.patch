+
+  <script type="module">
+    const form = document.getElementById('quick-order-form');
+    const status = document.getElementById('qo-status');
+    const submitBtn = form.querySelector('button[type="submit"]');
+
+    const PRICES = {
+      'maple-oat-latte': 5.75, 'dark-roast-espresso': 3.25, 'cold-brew': 4.5, 'cappuccino': 4.75,
+      'flat-white': 4.95, 'drip-coffee': 2.95, 'chai-latte': 5.25,
+    };
+    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+    const timeFmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' });
+
+    const optionText = (select) => select.selectedOptions[0]?.textContent.split(' — ')[0] ?? '';
+
+    function calculateTotal(data) {
+      let unit = PRICES[data.get('drink')] ?? 0;
+      if (data.get('size') === 'large') unit += 0.75;
+      if (['oat', 'almond'].includes(data.get('milk'))) unit += 0.6;
+      if (data.get('extra_shot')) unit += 0.9;
+      return unit * Number(data.get('quantity') || 1);
+    }
+
+    // Clear stale error styling as soon as the user edits a field.
+    form.addEventListener('input', (event) => {
+      event.target.removeAttribute?.('aria-invalid');
+    });
+
+    function collectErrors() {
+      const errors = [];
+      for (const el of form.elements) {
+        if (el.willValidate && !el.checkValidity()) {
+          const label = form.querySelector(`label[for="${el.id}"]`)?.textContent.replace('*', '').trim() || el.name;
+          errors.push({ el, field: el.name, label, message: el.validationMessage });
+          el.setAttribute('aria-invalid', 'true');
+        }
+      }
+      return errors;
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      status.classList.remove('error');
+
+      const errors = collectErrors();
+      if (errors.length) {
+        status.classList.add('error');
+        status.textContent = `Please fix: ${errors.map((e) => `${e.label} (${e.message})`).join(', ')}`;
+        errors[0].el.focus();
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(
+            'Validation failed: ' + errors.map((e) => `${e.field} (${e.message})`).join(', ')
+          ));
+        }
+        return;
+      }
+
+      const data = new FormData(form);
+      submitBtn.disabled = true;
+
+      const result = placeOrder(data).finally(() => { submitBtn.disabled = false; });
+      if (event.agentInvoked) event.respondWith(result);
+    });
+
+    async function placeOrder(data) {
+      // Demo: a real implementation would POST to the form action:
+      // await fetch(form.action, { method: 'POST', body: data });
+      await new Promise((resolve) => setTimeout(resolve, 400));
+
+      const orderId = `DG-${crypto.randomUUID().slice(0, 6).toUpperCase()}`;
+      const qty = Number(data.get('quantity'));
+      const drink = optionText(form.elements.drink);
+      const location = optionText(form.elements.location);
+      const total = money.format(calculateTotal(data));
+      const pickupRaw = data.get('pickup_time');
+      const pickup = pickupRaw
+        ? timeFmt.format(new Date(`1970-01-01T${pickupRaw}`))
+        : 'as soon as possible (about 10 minutes)';
+      const name = data.get('customer_name');
+
+      const summary =
+        `Order ${orderId} confirmed: ${qty} × ${data.get('size')} ${data.get('iced') ? 'iced ' : ''}${drink} ` +
+        `for ${name}, pickup at ${location} ${pickupRaw ? 'at ' : ''}${pickup}. Total ${total}, pay in store.`;
+
+      status.textContent = summary; // textContent: user input is never parsed as HTML
+      form.reset();
+      return summary;
+    }
+  </script>
