+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const totalEl = document.getElementById('qo-total');
+      const confirmationEl = document.getElementById('qo-confirmation');
+
+      const SIZE_UPCHARGE = { small: 0, medium: 0.5, large: 1 };
+      const PLANT_MILKS = ['oat', 'almond', 'soy'];
+      const SYRUPS = ['vanilla', 'caramel', 'hazelnut', 'maple'];
+      const PICKUP_MINUTES = { asap: 5, '15min': 15, '30min': 30, '60min': 60 };
+
+      const clampInt = (value, min, max, fallback) => {
+        const n = parseInt(value, 10);
+        return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
+      };
+
+      function readOrder() {
+        const data = new FormData(form);
+        const drinkOption = form.drink.selectedOptions[0];
+        return {
+          drink: data.get('drink') || '',
+          drinkLabel: drinkOption && drinkOption.value ? drinkOption.textContent.split(' — ')[0] : '',
+          basePrice: drinkOption && drinkOption.dataset.price ? parseFloat(drinkOption.dataset.price) : 0,
+          size: data.get('size') || 'medium',
+          temperature: data.get('drink') === 'cold-brew' ? 'iced' : (data.get('temperature') || 'hot'),
+          milk: data.get('milk') || 'whole',
+          extraShots: clampInt(data.get('extra_shots'), 0, 4, 0),
+          sweetener: data.get('sweetener') || 'none',
+          quantity: clampInt(data.get('quantity'), 1, 10, 1),
+          location: data.get('location') || '',
+          locationLabel: form.location.selectedOptions[0] ? form.location.selectedOptions[0].textContent : '',
+          pickupTime: data.get('pickup_time') || 'asap',
+          customerName: String(data.get('customer_name') || '').trim(),
+          notes: String(data.get('notes') || '').trim(),
+        };
+      }
+
+      function priceOf(order) {
+        if (!order.drink) return 0;
+        let unit = order.basePrice + (SIZE_UPCHARGE[order.size] || 0);
+        if (PLANT_MILKS.includes(order.milk)) unit += 0.7;
+        if (SYRUPS.includes(order.sweetener)) unit += 0.6;
+        unit += order.extraShots * 0.8;
+        return Math.round(unit * order.quantity * 100) / 100;
+      }
+
+      function validate(order) {
+        const errors = [];
+        if (!order.drink) errors.push('Please choose a drink.');
+        if (!SIZE_UPCHARGE.hasOwnProperty(order.size)) errors.push('Please choose a valid size.');
+        if (!order.location) errors.push('Please choose a pickup location.');
+        if (!order.customerName) errors.push('Please enter a name for the cup.');
+        return errors;
+      }
+
+      function updateTotal() {
+        totalEl.textContent = '$' + priceOf(readOrder()).toFixed(2);
+      }
+
+      function showMessage(html, isError) {
+        confirmationEl.innerHTML = html;
+        confirmationEl.classList.toggle('order-error', !!isError);
+        confirmationEl.hidden = false;
+      }
+
+      const escapeHtml = (str) => str.replace(/[&<>"']/g, (c) => ({
+        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
+      })[c]);
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const order = readOrder();
+        const errors = validate(order);
+        let result;
+
+        if (errors.length) {
+          showMessage('<strong>We couldn\'t place your order:</strong><br>' + errors.map(escapeHtml).join('<br>'), true);
+          result = { success: false, errors };
+        } else {
+          const total = priceOf(order);
+          const orderNumber = 'DG-' + Math.random().toString(36).slice(2, 8).toUpperCase();
+          const readyAt = new Date(Date.now() + PICKUP_MINUTES[order.pickupTime] * 60000);
+          const readyAtText = readyAt.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+
+          const description = [
+            order.quantity > 1 ? order.quantity + ' ×' : '',
+            order.size, order.temperature, order.drinkLabel,
+            order.milk !== 'whole' ? '(' + (order.milk === 'none' ? 'no' : order.milk) + ' milk)' : '',
+            order.extraShots ? '+ ' + order.extraShots + ' extra shot' + (order.extraShots > 1 ? 's' : '') : '',
+            order.sweetener !== 'none' ? '+ ' + order.sweetener : '',
+          ].filter(Boolean).join(' ');
+
+          showMessage(
+            '<strong>Order ' + orderNumber + ' placed!</strong><br>' +
+            escapeHtml(description) + ' for <strong>' + escapeHtml(order.customerName) + '</strong>.<br>' +
+            'Pick up at ' + escapeHtml(order.locationLabel) + ' around ' + readyAtText +
+            '. Total: <strong>$' + total.toFixed(2) + '</strong>' +
+            (order.notes ? '<br>Notes: ' + escapeHtml(order.notes) : ''),
+            false
+          );
+
+          result = {
+            success: true,
+            orderNumber,
+            summary: description,
+            customerName: order.customerName,
+            location: order.locationLabel,
+            estimatedPickup: readyAt.toISOString(),
+            total: '$' + total.toFixed(2),
+          };
+        }
+
+        // When an AI agent submitted the form via WebMCP, hand the result back to it.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+
+      form.addEventListener('reset', () => {
+        confirmationEl.hidden = true;
+        setTimeout(updateTotal);
+      });
+
+      // Bring the form into view while an agent is filling it in.
+      window.addEventListener('toolactivated', (event) => {
+        if (event.toolName === form.getAttribute('toolname')) {
+          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        }
+      });
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
 </html>
