+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var stageEl = document.getElementById('roast-stage');
+      if (!widget || !canvas || !canvas.getContext) return;
+
+      var ctx = canvas.getContext('2d');
+      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      // ---- Simulated roast profile (one 60s cycle, then re-charge) ----
+      var CYCLE_SECONDS = 60;
+      var elapsed = 0; // simulated seconds into the current roast
+      var temp = 200;
+
+      function profileTemp(t) {
+        // Charge at 200°C, dip to turning point (~95°C at 8s), then climb to ~225°C.
+        if (t < 8) return 200 - (105 * (t / 8));
+        var p = (t - 8) / (CYCLE_SECONDS - 8);
+        return 95 + 130 * (1 - Math.pow(1 - p, 1.6));
+      }
+
+      function stageFor(t, c) {
+        if (t < 8) return 'Charging — turning point';
+        if (c < 160) return 'Drying phase';
+        if (c < 196) return 'Maillard browning';
+        if (c < 210) return 'First crack';
+        return 'Development — dark roast';
+      }
+
+      // 0 = green, 1 = dark roast; driven by temperature after turning point
+      function roastLevel() {
+        if (elapsed < 8) return 0;
+        return Math.max(0, Math.min(1, (temp - 110) / 115));
+      }
+
+      function tick() {
+        elapsed += 1;
+        if (elapsed > CYCLE_SECONDS) elapsed = 0;
+        var noise = (Math.random() - 0.5) * 0.8;
+        temp = profileTemp(elapsed) + noise;
+        tempEl.textContent = temp.toFixed(1);
+        stageEl.textContent = stageFor(elapsed, temp);
+      }
+
+      // ---- Canvas: beans tumbling in a drum ----
+      var width = 0, height = 0;
+      var beans = [];
+      for (var i = 0; i < 70; i++) {
+        beans.push({
+          angle: Math.random() * Math.PI * 2,
+          radius: 0.25 + Math.random() * 0.7, // fraction of drum radius
+          speed: 0.4 + Math.random() * 0.5,
+          spin: Math.random() * Math.PI * 2,
+          spinSpeed: (Math.random() - 0.5) * 4,
+          size: 0.8 + Math.random() * 0.4
+        });
+      }
+
+      // green -> yellow -> cinnamon -> chocolate -> near-black
+      var palette = [[122, 140, 82], [196, 170, 92], [168, 108, 58], [104, 60, 34], [52, 30, 20]];
+      function beanColor(level) {
+        var pos = level * (palette.length - 1);
+        var idx = Math.min(palette.length - 2, Math.floor(pos));
+        var f = pos - idx, a = palette[idx], b = palette[idx + 1];
+        return 'rgb(' + Math.round(a[0] + (b[0] - a[0]) * f) + ',' +
+          Math.round(a[1] + (b[1] - a[1]) * f) + ',' +
+          Math.round(a[2] + (b[2] - a[2]) * f) + ')';
+      }
+
+      function resize() {
+        var dpr = window.devicePixelRatio || 1;
+        var rect = canvas.getBoundingClientRect();
+        width = rect.width;
+        height = rect.height;
+        if (!width || !height) return;
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        draw(0);
+      }
+
+      function draw(dt) {
+        if (!width || !height) return;
+        var cx = width / 2, cy = height / 2;
+        var drumR = Math.min(width, height) * 0.42;
+        var level = roastLevel();
+        var color = beanColor(level);
+        var beanW = Math.max(6, drumR * 0.07);
+
+        ctx.clearRect(0, 0, width, height);
+
+        // Heat glow beneath the drum, intensifying with temperature
+        var heat = Math.max(0, Math.min(1, (temp - 90) / 140));
+        var glow = ctx.createRadialGradient(cx, cy + drumR, drumR * 0.1, cx, cy + drumR, drumR * 1.6);
+        glow.addColorStop(0, 'rgba(255,' + Math.round(120 - heat * 60) + ',30,' + (0.25 + heat * 0.45) + ')');
+        glow.addColorStop(1, 'rgba(255,80,20,0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, width, height);
+
+        // Drum
+        ctx.beginPath();
+        ctx.arc(cx, cy, drumR, 0, Math.PI * 2);
+        ctx.fillStyle = '#2a1d19';
+        ctx.fill();
+        ctx.lineWidth = 6;
+        ctx.strokeStyle = '#6d5a52';
+        ctx.stroke();
+
+        ctx.save();
+        ctx.beginPath();
+        ctx.arc(cx, cy, drumR - 3, 0, Math.PI * 2);
+        ctx.clip();
+
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.angle += b.speed * dt;
+          b.spin += b.spinSpeed * dt;
+          // Beans ride up one side and tumble down: bias toward the bottom of the drum
+          var a = b.angle;
+          var r = drumR * b.radius;
+          var x = cx + Math.cos(a) * r;
+          var y = cy + Math.abs(Math.sin(a)) * r * 0.85 + drumR * 0.1 - Math.sin(a * 2) * drumR * 0.08;
+
+          ctx.save();
+          ctx.translate(x, y);
+          ctx.rotate(b.spin);
+          var w = beanW * b.size, h = w * 0.7;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, w, h, 0, 0, Math.PI * 2);
+          ctx.fillStyle = color;
+          ctx.fill();
+          // Center crease
+          ctx.beginPath();
+          ctx.moveTo(-w * 0.8, 0);
+          ctx.quadraticCurveTo(0, h * 0.35, w * 0.8, 0);
+          ctx.lineWidth = Math.max(1, w * 0.12);
+          ctx.strokeStyle = 'rgba(0,0,0,0.45)';
+          ctx.stroke();
+          ctx.restore();
+        }
+        ctx.restore();
+      }
+
+      // ---- Lifecycle: start/stop both loops together ----
+      var rafId = 0, intervalId = 0, lastTs = 0, running = false;
+
+      function frame(ts) {
+        var dt = lastTs ? Math.min(0.05, (ts - lastTs) / 1000) : 0;
+        lastTs = ts;
+        draw(dt);
+        rafId = requestAnimationFrame(frame);
+      }
+
+      function start() {
+        if (running) return;
+        running = true;
+        intervalId = setInterval(tick, 1000);
+        if (reduceMotion) {
+          draw(0);
+        } else {
+          lastTs = 0;
+          rafId = requestAnimationFrame(frame);
+        }
+      }
+
+      function stop() {
+        if (!running) return;
+        running = false;
+        clearInterval(intervalId);
+        cancelAnimationFrame(rafId);
+        intervalId = 0;
+        rafId = 0;
+      }
+
+      // Keep the canvas crisp across layout changes
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(resize).observe(canvas);
+      } else {
+        window.addEventListener('resize', resize);
+      }
+      tick();
+      resize();
+
+      // Prefer the browser's rendering lifecycle (content-visibility: auto);
+      // fall back to IntersectionObserver, then to always-on.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          if (event.skipped) {
+            stop();
+          } else {
+            start();
+          }
+        });
+      } else if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          var entry = entries[entries.length - 1];
+          if (entry.isIntersecting) {
+            start();
+          } else {
+            stop();
+          }
+        }, { rootMargin: '200px 0px' }).observe(widget);
+      } else {
+        start();
+      }
+    })();
+  </script>
 </body>
 
