+  <script>
+    (() => {
+      const grid = document.getElementById('seasonal-grid');
+      const select = document.getElementById('seasonal-sort');
+      const status = document.getElementById('seasonal-sort-status');
+      if (!grid || !select) return;
+
+      const cards = [...grid.querySelectorAll(':scope > .card')];
+      const featuredOrder = new Map(cards.map((card, i) => [card, i]));
+      const nameOf = (card) => card.querySelector('h3')?.textContent.trim() ?? '';
+      const collator = new Intl.Collator(document.documentElement.lang || undefined, { sensitivity: 'base' });
+
+      const comparators = {
+        'featured': (a, b) => featuredOrder.get(a) - featuredOrder.get(b),
+        'name-asc': (a, b) => collator.compare(nameOf(a), nameOf(b)),
+        'name-desc': (a, b) => collator.compare(nameOf(b), nameOf(a)),
+      };
+
+      const canMoveBefore = Object.hasOwn(Element.prototype, 'moveBefore');
+
+      // Move the existing nodes (never recreate them) so view transitions can match them.
+      function reorder(ordered) {
+        for (const card of ordered) {
+          if (canMoveBefore) grid.moveBefore(card, null);
+          else grid.append(card);
+        }
+      }
+
+      function reorderWithTransition(ordered) {
+        const update = () => reorder(ordered);
+        if (grid.startViewTransition) {
+          grid.startViewTransition(update);
+        } else if (document.startViewTransition) {
+          document.startViewTransition(update);
+        } else {
+          update();
+        }
+      }
+
+      select.addEventListener('change', () => {
+        const compare = comparators[select.value] ?? comparators.featured;
+        const ordered = [...grid.querySelectorAll(':scope > .card')].sort(compare);
+        reorderWithTransition(ordered);
+        const label = select.selectedOptions[0]?.textContent ?? select.value;
+        status.textContent = `Seasonal favorites sorted by ${label}, ${ordered.length} items`;
+      });
+    })();
+  </script>
+
