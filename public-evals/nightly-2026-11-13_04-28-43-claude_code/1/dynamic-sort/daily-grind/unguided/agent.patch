+  <script>
+    (function () {
+      var grid = document.getElementById('seasonal-grid');
+      var select = document.getElementById('seasonal-sort');
+      var status = document.getElementById('seasonal-sort-status');
+      if (!grid || !select) return;
+
+      var cards = Array.prototype.slice.call(grid.querySelectorAll('.card'));
+      cards.forEach(function (card, i) { card.dataset.order = i; });
+
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });
+      var nameOf = function (card) { return card.querySelector('h3').textContent.trim(); };
+
+      var comparators = {
+        'featured': function (a, b) { return a.dataset.order - b.dataset.order; },
+        'name-asc': function (a, b) { return collator.compare(nameOf(a), nameOf(b)); },
+        'name-desc': function (a, b) { return collator.compare(nameOf(b), nameOf(a)); }
+      };
+
+      function sortCards(key) {
+        var compare = comparators[key] || comparators.featured;
+        var current = Array.prototype.slice.call(grid.querySelectorAll('.card'));
+
+        // FLIP: First — record current positions.
+        var first = new Map();
+        current.forEach(function (card) { first.set(card, card.getBoundingClientRect()); });
+        // Stop any in-flight animations so "last" positions are measured cleanly
+        // (cards mid-flight start from their current on-screen spot).
+        current.forEach(function (card) {
+          if (card.getAnimations) card.getAnimations().forEach(function (a) { a.cancel(); });
+        });
+
+        // Reorder the DOM (stable sort keeps featured order for ties).
+        current.slice().sort(compare).forEach(function (card) { grid.appendChild(card); });
+
+        status.textContent = 'Seasonal favorites sorted by ' +
+          select.options[select.selectedIndex].text + '.';
+
+        if (reduceMotion.matches || typeof Element.prototype.animate !== 'function') return;
+
+        // Last + Invert + Play.
+        current.forEach(function (card) {
+          var from = first.get(card);
+          var to = card.getBoundingClientRect();
+          var dx = from.left - to.left;
+          var dy = from.top - to.top;
+          if (!dx && !dy) return;
+          card.animate(
+            [
+              { transform: 'translate(' + dx + 'px, ' + dy + 'px)' },
+              { transform: 'translate(0, 0)' }
+            ],
+            { duration: 450, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' }
+          );
+        });
+      }
+
+      select.addEventListener('change', function () { sortCards(select.value); });
+    })();
+  </script>
+
