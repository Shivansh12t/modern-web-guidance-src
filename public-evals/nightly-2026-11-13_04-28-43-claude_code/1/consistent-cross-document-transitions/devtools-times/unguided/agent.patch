+}
+/* ------------------------------------------------------------------
+ * Page transitions (native cross-document View Transitions API)
+ *
+ * The header stays put; only the page content cross-fades and slides.
+ * The new page is only snapshotted once #page-content has been parsed
+ * (see <link rel="expect" blocking="render"> in Layout.astro), so the
+ * animation never reveals an incomplete or unstyled layout.
+ * ------------------------------------------------------------------ */
+@view-transition {
+  navigation: auto;
+}
+
+.site-header {
+  view-transition-name: site-header;
+}
+
+.page-content {
+  view-transition-name: page-content;
+}
+
+/* Keep the root (background, footer) still so nothing flashes behind the content. */
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+
+/* Header is identical across pages: no animation, no cross-fade flicker. */
+::view-transition-old(site-header),
+::view-transition-new(site-header) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+
+::view-transition-group(page-content) {
+  animation-duration: 280ms;
+  animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
+}
+
+/* Content is taller/shorter per page: anchor to the top instead of stretching. */
+::view-transition-old(page-content),
+::view-transition-new(page-content) {
+  height: auto;
+  object-fit: none;
+  object-position: top;
+  overflow: clip;
+}
+
+::view-transition-old(page-content) {
+  animation: page-out 160ms cubic-bezier(0.4, 0, 1, 1) both;
+}
+
+::view-transition-new(page-content) {
+  animation: page-in 280ms cubic-bezier(0, 0, 0.2, 1) 60ms both;
+}
+
+@keyframes page-out {
+  to {
+    opacity: 0;
+    transform: translateY(-8px);
+  }
+}
+
+@keyframes page-in {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
