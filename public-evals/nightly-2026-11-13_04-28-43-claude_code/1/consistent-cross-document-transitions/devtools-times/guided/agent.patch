+    -->
+    <link rel="expect" href={`#${aboveFoldId}`} blocking="render" />
+
+    <!--
+      Registered before first render so `pagereveal` is never missed.
+      Adds a direction type (forward/backward) based on page depth:
+      home (0) -> category (1) -> article (2).
+    -->
+    <script is:inline blocking="render">
+      (() => {
+        const depth = (url) => {
+          const path = new URL(url, location.href).pathname;
+          if (/\/articles\/[^/]+\/?$/.test(path)) return 2;
+          if (/\/category\/[^/]+\/?$/.test(path)) return 1;
+          return 0;
+        };
+        window.addEventListener("pagereveal", (event) => {
+          const from = window.navigation?.activation?.from?.url;
+          if (!event.viewTransition || !from) return;
+          const delta = depth(location.href) - depth(from);
+          if (delta > 0) event.viewTransition.types.add("forward");
+          else if (delta < 0) event.viewTransition.types.add("backward");
+        });
+      })();
+    </script>
