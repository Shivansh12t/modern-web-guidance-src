+/* ------------------------------------------------------------------
+   Cross-document page transitions (home ↔ category ↔ article)
+   Progressive enhancement: unsupported browsers navigate normally.
+   ------------------------------------------------------------------ */
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* The masthead stays put while the page content changes beneath it. */
+.site-header {
+  view-transition-name: site-header;
+}
+
+::view-transition-group(site-header) {
+  animation: none;
+}
+
+/* Default: quick, subtle cross-fade with a slight lift. */
+::view-transition-old(root) {
+  animation: 180ms ease-in both page-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 280ms ease-out 60ms both page-fade-in;
+}
+
+/* Going deeper (home → category → article): content enters from the right. */
+:active-view-transition-type(forward) {
+  &::view-transition-old(root) {
+    animation: 200ms ease-in both page-out-to-left;
+  }
+  &::view-transition-new(root) {
+    animation: 300ms cubic-bezier(0.2, 0.8, 0.2, 1) 40ms both page-in-from-right;
+  }
+}
+
+/* Going back up (article → category → home): content enters from the left. */
+:active-view-transition-type(backward) {
+  &::view-transition-old(root) {
+    animation: 200ms ease-in both page-out-to-right;
+  }
+  &::view-transition-new(root) {
+    animation: 300ms cubic-bezier(0.2, 0.8, 0.2, 1) 40ms both page-in-from-left;
+  }
+}
+
+@keyframes page-fade-out {
+  to { opacity: 0; }
+}
+@keyframes page-fade-in {
+  from { opacity: 0; translate: 0 8px; }
+}
+@keyframes page-out-to-left {
+  to { opacity: 0; translate: -24px 0; }
+}
+@keyframes page-in-from-right {
+  from { opacity: 0; translate: 24px 0; }
+}
+@keyframes page-out-to-right {
+  to { opacity: 0; translate: 24px 0; }
+}
+@keyframes page-in-from-left {
+  from { opacity: 0; translate: -24px 0; }
+}
