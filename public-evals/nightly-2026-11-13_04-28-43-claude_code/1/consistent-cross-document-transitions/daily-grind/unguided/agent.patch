+    (function () {
+      var root = document.documentElement;
+      try {
+        var saved = localStorage.getItem('dg-theme');
+        var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+        root.dataset.theme = theme;
+      } catch (e) { root.dataset.theme = 'light'; }
+      root.classList.add('js');
+    })();
+  </script>
+  <!-- Hold first render (and thus the incoming page transition) until the
+       above-the-fold content is parsed; the footer is not awaited. -->
+  <link rel="expect" href="#location-list" blocking="render">
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .hero.page-hero {
+      height: 40vh;
+      background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1350&q=80');
+    }
+
+    nav a[aria-current="page"] {
+      color: var(--accent);
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+    /* Cross-document page transitions */
+    @view-transition {
+      navigation: auto;
+    }
+
+    nav {
+      view-transition-name: site-header;
+    }
+
+    ::view-transition-old(root) {
+      animation: dg-fade-out 220ms ease-in both;
+    }
+
+    ::view-transition-new(root) {
+      animation: dg-fade-in 320ms ease-out both;
+    }
+
+    ::view-transition-group(site-header) {
+      animation-duration: 0s;
+    }
+
+    @keyframes dg-fade-out {
+      to { opacity: 0; transform: translateY(-8px); }
+    }
+
+    @keyframes dg-fade-in {
+      from { opacity: 0; transform: translateY(8px); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-old(root),
+      ::view-transition-new(root) {
+        animation: none;
+      }
+    }
+
+    [data-theme="dark"] {
+      --text: #efebe9;
+      --light: #1b1412;
+      --secondary: #3e2723;
+    }
+
+    [data-theme="dark"] .card {
+      background: #2a201d;
+    }
+
+    [data-theme="dark"] .card h3 {
+      color: var(--accent);
+    }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero page-hero" id="hero">
+    <h1>Find Your Daily Grind</h1>
+    <p>Neighborhood cafés with fresh coffee and friendly faces.</p>
+  </header>
+
+  <main class="container">
+    <section id="location-list">
+      <h2 style="text-align: center;">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p>123 Main Street &middot; Open 6am&ndash;8pm</p>
+          <a href="/locations/downtown" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>45 River Road &middot; Open 7am&ndash;7pm</p>
+          <a href="/locations/riverside" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Uptown</h3>
+          <p>890 Oak Avenue &middot; Open 6am&ndash;9pm</p>
+          <a href="/locations/uptown" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
