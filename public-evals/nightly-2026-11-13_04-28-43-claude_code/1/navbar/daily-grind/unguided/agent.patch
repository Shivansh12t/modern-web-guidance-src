+  <script>
+    (function () {
+      var nav = document.getElementById('site-nav');
+      if (!nav) return;
+      document.documentElement.classList.add('js');
+
+      var logo = nav.querySelector('.logo');
+      var navToggle = nav.querySelector('.nav-toggle');
+      var list = nav.querySelector('.nav-list');
+      var submenuToggles = Array.prototype.slice.call(nav.querySelectorAll('.submenu-toggle'));
+
+      /* ---------- Active page ---------- */
+      function normalize(path) {
+        path = path.replace(/\/index\.html?$/, '/').replace(/\/+$/, '');
+        return path || '/';
+      }
+      var current = normalize(window.location.pathname);
+      Array.prototype.forEach.call(nav.querySelectorAll('a[href]'), function (link) {
+        var target = normalize(new URL(link.getAttribute('href'), window.location.href).pathname);
+        if (target === current) {
+          link.setAttribute('aria-current', 'page');
+          var parent = link.closest('.has-submenu');
+          if (parent && link.closest('.submenu')) parent.classList.add('is-active-parent');
+        }
+      });
+
+      /* ---------- Submenus ---------- */
+      function setSubmenu(btn, open) {
+        btn.setAttribute('aria-expanded', String(open));
+        document.getElementById(btn.getAttribute('aria-controls')).classList.toggle('is-open', open);
+      }
+      function closeSubmenus(except) {
+        submenuToggles.forEach(function (btn) { if (btn !== except) setSubmenu(btn, false); });
+      }
+      submenuToggles.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          var open = btn.getAttribute('aria-expanded') !== 'true';
+          closeSubmenus(btn);
+          setSubmenu(btn, open);
+        });
+        var item = btn.closest('.has-submenu');
+        // Inline mode: close the dropdown when focus leaves it.
+        item.addEventListener('focusout', function (e) {
+          if (!nav.classList.contains('is-collapsed') && !item.contains(e.relatedTarget)) {
+            setSubmenu(btn, false);
+          }
+        });
+      });
+
+      /* ---------- Collapsed panel ---------- */
+      function setPanel(open) {
+        navToggle.setAttribute('aria-expanded', String(open));
+        list.classList.toggle('is-open', open);
+        if (!open) closeSubmenus();
+      }
+      navToggle.addEventListener('click', function () {
+        setPanel(navToggle.getAttribute('aria-expanded') !== 'true');
+      });
+
+      /* ---------- Escape / click outside ---------- */
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== 'Escape') return;
+        var openSub = submenuToggles.filter(function (b) {
+          return b.getAttribute('aria-expanded') === 'true';
+        })[0];
+        if (openSub) {
+          setSubmenu(openSub, false);
+          if (nav.contains(document.activeElement)) openSub.focus();
+        } else if (nav.classList.contains('is-collapsed') && list.classList.contains('is-open')) {
+          setPanel(false);
+          navToggle.focus();
+        }
+      });
+      document.addEventListener('click', function (e) {
+        if (nav.contains(e.target)) return;
+        closeSubmenus();
+        if (nav.classList.contains('is-collapsed')) setPanel(false);
+      });
+
+      /* ---------- Inline vs. collapsed, based on real available space ---------- */
+      function fitsInline() {
+        var style = getComputedStyle(nav);
+        var available = nav.clientWidth -
+          parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
+        var gap = parseFloat(style.columnGap) || 0;
+        var listGap = parseFloat(getComputedStyle(list).columnGap) || 0;
+        var needed = logo.getBoundingClientRect().width + gap;
+        var items = list.children;
+        for (var i = 0; i < items.length; i++) {
+          var cs = getComputedStyle(items[i]);
+          needed += items[i].getBoundingClientRect().width +
+            parseFloat(cs.marginLeft) + parseFloat(cs.marginRight);
+        }
+        needed += listGap * Math.max(0, items.length - 1);
+        return needed <= available;
+      }
+
+      function update() {
+        var wasCollapsed = nav.classList.contains('is-collapsed');
+        // Measure the inline layout synchronously (no paint in between).
+        nav.classList.remove('is-collapsed');
+        nav.classList.add('is-measuring');
+        var collapse = !fitsInline();
+        nav.classList.remove('is-measuring');
+        nav.classList.toggle('is-collapsed', collapse);
+
+        if (collapse !== wasCollapsed) {
+          closeSubmenus();
+          setPanel(false);
+        }
+        if (!collapse) {
+          // Inline mode: the toggle is hidden and the list always visible.
+          navToggle.setAttribute('aria-expanded', 'false');
+          list.classList.remove('is-open');
+        }
+      }
+
+      var lastWidth = -1;
+      function onResize() {
+        if (nav.clientWidth === lastWidth) return;
+        lastWidth = nav.clientWidth;
+        update();
+      }
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(onResize).observe(nav);
+      } else {
+        window.addEventListener('resize', onResize);
+      }
+      update();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
+    })();
+  </script>
+
 </body>
 
