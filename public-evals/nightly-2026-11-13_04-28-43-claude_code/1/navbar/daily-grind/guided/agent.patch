+  <script type="module">
+    // Load the Popover polyfill only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const header = document.querySelector(".site-header");
+    const inner = header.querySelector(".header-inner");
+    const menu = header.querySelector("#site-menu");
+    const OPEN = ":is(:popover-open, .\\:popover-open)";
+    const isOpen = (el) => el.hasAttribute("popover") && el.matches(OPEN);
+    const canHover = matchMedia("(hover: hover)");
+    const hasAnchorPos = CSS.supports("position-area", "block-end");
+
+    // --- Current page indicator ---------------------------------------
+    const normalize = (path) => path.replace(/\/(index\.html)?$/, "") || "/";
+    const here = normalize(location.pathname);
+    for (const link of header.querySelectorAll("a[href]")) {
+      if (normalize(new URL(link.href).pathname) !== here) continue;
+      link.setAttribute("aria-current", "page");
+      // Mark the parent submenu trigger so the section is visible when collapsed.
+      link.closest(".nav-dropdown")?.querySelector(".dropdown-trigger").classList.add("is-current-section");
+    }
+
+    // --- Submenus --------------------------------------------------------
+    const dropdowns = [...header.querySelectorAll(".nav-dropdown")].map((li) => {
+      const trigger = li.querySelector(".dropdown-trigger");
+      const list = li.querySelector(".dropdown-list");
+      const d = { li, trigger, list, previewing: false };
+
+      trigger.addEventListener("click", (event) => {
+        if (header.classList.contains("is-wide")) {
+          // Clicking while hover-previewing pins the submenu open instead of toggling it closed.
+          if (d.previewing) {
+            d.previewing = false;
+            event.preventDefault();
+          }
+          return; // popovertarget handles the toggle natively
+        }
+        list.hidden = !list.hidden;
+        trigger.setAttribute("aria-expanded", String(!list.hidden));
+      });
+
+      list.addEventListener("toggle", (event) => {
+        const open = event.newState === "open";
+        trigger.setAttribute("aria-expanded", String(open));
+        if (!open) d.previewing = false;
+        if (open && !hasAnchorPos) positionFallback(trigger, list);
+      });
+
+      li.addEventListener("pointerenter", (event) => {
+        if (!header.classList.contains("is-wide") || !canHover.matches || event.pointerType === "touch") return;
+        if (isOpen(list)) return;
+        d.previewing = true;
+        try { list.showPopover({ source: trigger }); } catch { list.showPopover(); }
+      });
+
+      li.addEventListener("pointerleave", () => {
+        if (d.previewing && isOpen(list)) list.hidePopover();
+        d.previewing = false;
+      });
+
+      li.addEventListener("focusout", (event) => {
+        if (event.relatedTarget && !li.contains(event.relatedTarget) && isOpen(list)) list.hidePopover();
+      });
+
+      return d;
+    });
+
+    function positionFallback(trigger, list) {
+      const t = trigger.getBoundingClientRect();
+      const size = list.getBoundingClientRect();
+      let top = t.bottom + 8;
+      if (top + size.height > innerHeight) top = Math.max(0, t.top - size.height - 8);
+      const left = Math.min(Math.max(0, t.left), Math.max(0, innerWidth - size.width));
+      list.style.top = `${top}px`;
+      list.style.left = `${left}px`;
+    }
+
+    // --- Layout switching (no hard-coded breakpoint) ----------------------
+    function applyLayout(wide) {
+      header.classList.toggle("is-wide", wide);
+      if (wide) menu.removeAttribute("popover");
+      else if (!menu.hasAttribute("popover")) menu.setAttribute("popover", "auto");
+
+      for (const { trigger, list } of dropdowns) {
+        if (wide) list.setAttribute("popover", "auto");
+        else list.removeAttribute("popover");
+        list.hidden = !wide;
+        trigger.setAttribute("aria-expanded", "false");
+      }
+    }
+
+    let wideState = null;
+    let lastWidth = 0;
+
+    function update() {
+      const width = inner.clientWidth;
+      // While collapsed, only re-measure when there is more room than before.
+      if (wideState === false && width <= lastWidth) {
+        lastWidth = width;
+        return;
+      }
+      lastWidth = width;
+
+      header.classList.add("is-measuring");
+      const menuWasOpen = isOpen(menu);
+      if (menuWasOpen) menu.hidePopover(); // a top-layer list can't be measured in flow
+      header.classList.add("is-wide");
+      const wide = inner.scrollWidth <= inner.clientWidth;
+
+      if (wide !== wideState) {
+        applyLayout(wide);
+        wideState = wide;
+      } else if (!wide) {
+        header.classList.remove("is-wide");
+      }
+      if (!wide && menuWasOpen) menu.showPopover();
+
+      requestAnimationFrame(() => header.classList.remove("is-measuring"));
+    }
+
+    const observer = new ResizeObserver(update);
+    observer.observe(header);
+    observer.observe(menu);
+    update();
+  </script>
+
