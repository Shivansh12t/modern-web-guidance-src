+  <script>
+    // Demo order tracker: starts indeterminate while the order is being confirmed,
+    // then switches to a determinate value as preparation steps complete.
+    (() => {
+      const bar = document.getElementById('order-progress');
+      const status = document.getElementById('order-progress-status');
+      const valueText = document.getElementById('order-progress-value');
+      const steps = [
+        { value: 25, text: 'Order received — your barista is on it.' },
+        { value: 60, text: 'Pulling espresso and steaming oat milk.' },
+        { value: 85, text: 'Adding the finishing maple drizzle.' },
+        { value: 100, text: 'Ready for pickup at the counter!' },
+      ];
+      let i = 0;
+      const advance = () => {
+        const step = steps[i++];
+        bar.value = step.value;
+        valueText.textContent = `${step.value}%`;
+        status.textContent = step.text;
+        if (i < steps.length) setTimeout(advance, 3000);
+      };
+      setTimeout(advance, 3000);
+    })();
+  </script>
+
