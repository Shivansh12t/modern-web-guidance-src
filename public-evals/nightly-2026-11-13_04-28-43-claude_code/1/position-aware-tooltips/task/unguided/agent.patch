+  <div id="maple-tooltip" class="tooltip" role="tooltip" data-placement="top" aria-hidden="true">
+    <strong>Maple Oat Latte</strong>
+    <ul>
+      <li>Double shot of house espresso</li>
+      <li>Steamed oat milk (dairy-free)</li>
+      <li>Pure Vermont maple syrup</li>
+      <li>12 oz &middot; ~190 cal &middot; $5.25</li>
+    </ul>
+    <div class="tooltip-arrow" aria-hidden="true"></div>
+  </div>
+
+  <script>
+    (function () {
+      const anchor = document.getElementById('anchor');
+      const tooltip = document.getElementById('maple-tooltip');
+      const arrow = tooltip.querySelector('.tooltip-arrow');
+
+      const GAP = 12;          // distance between anchor and tooltip
+      const PADDING = 8;       // min distance from viewport edges
+      const ARROW_INSET = 10;  // keep arrow away from rounded corners
+      const OPPOSITE = { top: 'bottom', bottom: 'top', left: 'right', right: 'left' };
+      const PREFERRED = 'top';
+
+      let pinned = false;
+      let open = false;
+
+      function clamp(v, min, max) {
+        return Math.min(Math.max(v, min), Math.max(min, max));
+      }
+
+      function fits(placement, a, t, vw, vh) {
+        switch (placement) {
+          case 'top': return a.top - GAP - t.height >= PADDING;
+          case 'bottom': return a.bottom + GAP + t.height <= vh - PADDING;
+          case 'left': return a.left - GAP - t.width >= PADDING;
+          case 'right': return a.right + GAP + t.width <= vw - PADDING;
+        }
+      }
+
+      function space(placement, a, vw, vh) {
+        switch (placement) {
+          case 'top': return a.top;
+          case 'bottom': return vh - a.bottom;
+          case 'left': return a.left;
+          case 'right': return vw - a.right;
+        }
+      }
+
+      function position() {
+        if (!open) return;
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+        const a = anchor.getBoundingClientRect();
+        const t = tooltip.getBoundingClientRect();
+
+        // Try preferred side, then its opposite (flip), then the cross axis.
+        const order = [PREFERRED, OPPOSITE[PREFERRED]];
+        const cross = PREFERRED === 'top' || PREFERRED === 'bottom' ? ['right', 'left'] : ['bottom', 'top'];
+        order.push(...cross);
+        let placement = order.find(p => fits(p, a, t, vw, vh));
+        if (!placement) {
+          // Nothing fits fully: pick the side with the most room.
+          placement = order.reduce((best, p) => space(p, a, vw, vh) > space(best, a, vw, vh) ? p : best);
+        }
+
+        const ax = a.left + a.width / 2;
+        const ay = a.top + a.height / 2;
+        let x, y;
+
+        if (placement === 'top' || placement === 'bottom') {
+          x = clamp(ax - t.width / 2, PADDING, vw - t.width - PADDING);
+          y = placement === 'top' ? a.top - GAP - t.height : a.bottom + GAP;
+        } else {
+          y = clamp(ay - t.height / 2, PADDING, vh - t.height - PADDING);
+          x = placement === 'left' ? a.left - GAP - t.width : a.right + GAP;
+        }
+
+        tooltip.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
+        tooltip.dataset.placement = placement;
+
+        // Keep the arrow pointing at the anchor centre even after shifting.
+        const half = arrow.offsetWidth / 2;
+        arrow.style.left = arrow.style.top = '';
+        if (placement === 'top' || placement === 'bottom') {
+          arrow.style.left = clamp(ax - x - half, ARROW_INSET, t.width - ARROW_INSET - half * 2) + 'px';
+        } else {
+          arrow.style.top = clamp(ay - y - half, ARROW_INSET, t.height - ARROW_INSET - half * 2) + 'px';
+        }
+      }
+
+      function show() {
+        if (open) return;
+        open = true;
+        tooltip.classList.add('is-visible');
+        tooltip.setAttribute('aria-hidden', 'false');
+        anchor.setAttribute('aria-expanded', 'true');
+        position();
+        window.addEventListener('scroll', position, { passive: true, capture: true });
+        window.addEventListener('resize', position);
+      }
+
+      function hide() {
+        if (!open) return;
+        open = false;
+        pinned = false;
+        tooltip.classList.remove('is-visible');
+        tooltip.setAttribute('aria-hidden', 'true');
+        anchor.setAttribute('aria-expanded', 'false');
+        window.removeEventListener('scroll', position, { capture: true });
+        window.removeEventListener('resize', position);
+      }
+
+      function hideUnlessPinned() {
+        if (!pinned && !anchor.matches(':hover, :focus-visible') && !tooltip.matches(':hover')) hide();
+      }
+
+      anchor.addEventListener('mouseenter', show);
+      anchor.addEventListener('focus', show);
+      anchor.addEventListener('mouseleave', () => setTimeout(hideUnlessPinned, 100));
+      tooltip.addEventListener('mouseleave', () => setTimeout(hideUnlessPinned, 100));
+      anchor.addEventListener('blur', () => { pinned = false; hideUnlessPinned(); });
+
+      anchor.addEventListener('click', (e) => {
+        e.stopPropagation();
+        if (open && pinned) { hide(); return; }
+        pinned = true;
+        show();
+      });
+
+      document.addEventListener('click', (e) => {
+        if (open && !tooltip.contains(e.target)) hide();
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && open) hide();
+      });
+    })();
+  </script>
+
