     }
+
+    /* Info tooltip (Popover API + CSS Anchor Positioning) */
+    .card-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 8px;
+      margin-bottom: 10px;
+    }
+
+    .card-title h3 {
+      margin-bottom: 0;
+    }
+
+    .info-btn {
+      display: inline-grid;
+      place-items: center;
+      width: 24px;
+      height: 24px;
+      border-radius: 50%;
+      border: 1.5px solid var(--primary);
+      background: white;
+      color: var(--primary);
+      font: italic bold 0.85rem/1 Georgia, serif;
+      cursor: pointer;
+      transition: background 0.2s, color 0.2s;
+    }
+
+    .info-btn:hover,
+    .info-btn:focus-visible {
+      background: var(--primary);
+      color: white;
+    }
+
+    .info-btn:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    #tooltip {
+      --arrow-size: 8px;
+      border: none;
+      background: transparent;
+      padding: 0;
+      overflow: visible;
+      max-width: min(280px, calc(100vw - 16px));
+    }
+
+    #tooltip:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .tooltip-content {
+      position: relative;
+      background: var(--primary);
+      color: white;
+      padding: 10px 14px;
+      border-radius: 6px;
+      font-size: 0.85rem;
+      line-height: 1.45;
+      text-align: left;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
+    }
+
+    .tooltip-content strong {
+      color: var(--accent);
+    }
+
+    @supports (anchor-name: --a) {
+      #tooltip {
+        inset: auto;
+        margin: unset;
+        position: fixed;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+        /* Lets descendants query which fallback is active */
+        container-type: anchored;
+      }
+
+      .tooltip-content {
+        margin-block-end: calc(var(--arrow-size) + 4px);
+      }
+    }
+
+    /* Arrow only where its direction can track the flip */
+    @supports (container-type: anchored) {
+      .tooltip-content::before {
+        content: "";
+        position: absolute;
+        left: 50%;
+        translate: -50% 0;
+        width: calc(var(--arrow-size) * 2);
+        height: var(--arrow-size);
+        background: inherit;
+        /* Default: tooltip above anchor, arrow points down */
+        top: 100%;
+        clip-path: polygon(0 0, 100% 0, 50% 100%);
+      }
+
+      @container anchored(fallback: flip-block) {
+        .tooltip-content {
+          margin-block-end: 0;
+          margin-block-start: calc(var(--arrow-size) + 4px);
+        }
+
+        .tooltip-content::before {
+          /* Flipped: tooltip below anchor, arrow points up */
+          top: auto;
+          bottom: 100%;
+          clip-path: polygon(50% 0, 100% 100%, 0 100%);
+        }
+      }
+    }
   </style>
