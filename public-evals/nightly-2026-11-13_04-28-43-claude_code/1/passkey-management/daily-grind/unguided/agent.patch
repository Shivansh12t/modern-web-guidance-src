+++ b/account/passkeys.js
@@ -0,0 +1,540 @@
+/**
+ * Passkey management for the "My Account" page.
+ *
+ * Expected backend contract (session cookie auth, JSON):
+ *
+ *   GET    /api/account/passkeys
+ *     200 → {
+ *       rpId: "dailygrind.example",
+ *       user: { id: "<base64url user handle>", name: "jane@example.com", displayName: "Jane" },
+ *       currentCredentialId: "<base64url>" | null,   // passkey used for this session, if any
+ *       passkeys: [{
+ *         id: "<base64url credential ID>",
+ *         name: "MacBook Touch ID",
+ *         createdAt: "2026-01-02T10:00:00Z",
+ *         lastUsedAt: "2026-11-01T08:30:00Z" | null,
+ *         providerName: "iCloud Keychain" | null,    // from AAGUID lookup
+ *         backedUp: true                             // BS flag → synced passkey
+ *       }]
+ *     }
+ *   PATCH  /api/account/passkeys/:id   body { name }  → 200 updated passkey object
+ *   DELETE /api/account/passkeys/:id                  → 204 (or 200)
+ *
+ *   401 from any endpoint → user is redirected to /login.
+ *
+ * After the list loads and after every deletion, the WebAuthn Signal API is used
+ * (where supported) to tell the user's authenticator / password manager which
+ * credentials are still valid, so deleted passkeys stop being offered at sign-in.
+ *
+ * Append ?demo to the URL to use in-memory sample data instead of the API.
+ */
+
+const API_BASE = '/api/account/passkeys';
+const NAME_MAX_LENGTH = 64;
+const DEMO = new URLSearchParams(location.search).has('demo');
+
+const root = document.getElementById('passkey-root');
+const noticeEl = document.getElementById('notice');
+const syncNote = document.getElementById('sync-note');
+const greeting = document.getElementById('greeting');
+const dialog = document.getElementById('delete-dialog');
+
+const state = {
+  rpId: null,
+  user: null,
+  currentCredentialId: null,
+  passkeys: [],
+  editingId: null,
+  busyIds: new Set(),
+};
+
+/* ------------------------------------------------------------------ */
+/* API                                                                 */
+/* ------------------------------------------------------------------ */
+
+class ApiError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function csrfToken() {
+  return document.querySelector('meta[name="csrf-token"]')?.content || '';
+}
+
+async function request(path, { method = 'GET', body } = {}) {
+  const headers = { Accept: 'application/json', 'X-Requested-With': 'fetch' };
+  if (method !== 'GET') {
+    const token = csrfToken();
+    if (token) headers['X-CSRF-Token'] = token;
+  }
+  if (body !== undefined) headers['Content-Type'] = 'application/json';
+
+  let res;
+  try {
+    res = await fetch(path, {
+      method,
+      headers,
+      credentials: 'same-origin',
+      cache: 'no-store',
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError('We couldn’t reach the server. Check your connection and try again.', 0);
+  }
+
+  if (res.status === 401) {
+    location.assign(`/login?next=${encodeURIComponent(location.pathname + location.hash)}`);
+    throw new ApiError('Your session has expired. Redirecting to sign in…', 401);
+  }
+
+  let data = null;
+  const type = res.headers.get('content-type') || '';
+  if (res.status !== 204 && type.includes('application/json')) {
+    data = await res.json().catch(() => null);
+  }
+
+  if (!res.ok) {
+    const message =
+      (data && typeof data.error === 'string' && data.error) ||
+      (res.status === 404 ? 'That passkey no longer exists.' : 'Something went wrong. Please try again.');
+    throw new ApiError(message, res.status);
+  }
+  return data;
+}
+
+const realApi = {
+  list: () => request(API_BASE),
+  rename: (id, name) => request(`${API_BASE}/${encodeURIComponent(id)}`, { method: 'PATCH', body: { name } }),
+  remove: (id) => request(`${API_BASE}/${encodeURIComponent(id)}`, { method: 'DELETE' }),
+};
+
+function createDemoApi() {
+  const day = 86400000;
+  const now = Date.now();
+  const iso = (t) => new Date(t).toISOString();
+  const db = {
+    rpId: location.hostname,
+    user: { id: 'ZGVtby11c2VyLTQy', name: 'jamie@example.com', displayName: 'Jamie' },
+    currentCredentialId: 'cred-mbp',
+    passkeys: [
+      { id: 'cred-mbp', name: 'MacBook Pro', createdAt: iso(now - 210 * day), lastUsedAt: iso(now - 3600000), providerName: 'iCloud Keychain', backedUp: true },
+      { id: 'cred-pixel', name: 'Pixel 9', createdAt: iso(now - 90 * day), lastUsedAt: iso(now - 6 * day), providerName: 'Google Password Manager', backedUp: true },
+      { id: 'cred-yubi', name: 'YubiKey 5C', createdAt: iso(now - 400 * day), lastUsedAt: null, providerName: 'YubiKey 5 Series', backedUp: false },
+    ],
+  };
+  const wait = (v) => new Promise((r) => setTimeout(() => r(structuredClone(v)), 350));
+  const find = (id) => {
+    const pk = db.passkeys.find((p) => p.id === id);
+    if (!pk) throw new ApiError('That passkey no longer exists.', 404);
+    return pk;
+  };
+  return {
+    list: () => wait(db),
+    rename: async (id, name) => { const pk = find(id); pk.name = name; return wait(pk); },
+    remove: async (id) => { find(id); db.passkeys = db.passkeys.filter((p) => p.id !== id); return wait(null); },
+  };
+}
+
+const api = DEMO ? createDemoApi() : realApi;
+
+/* ------------------------------------------------------------------ */
+/* Authenticator sync (WebAuthn Signal API)                            */
+/* ------------------------------------------------------------------ */
+
+const signalSupported =
+  typeof window.PublicKeyCredential !== 'undefined' &&
+  typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function';
+
+/** Tell the authenticator the full set of credentials the server still accepts. */
+async function syncAcceptedCredentials() {
+  if (DEMO || !signalSupported || !state.rpId || !state.user?.id) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: state.rpId,
+      userId: state.user.id,
+      allAcceptedCredentialIds: state.passkeys.map((p) => p.id),
+    });
+  } catch (err) {
+    // Best effort: the server is the source of truth, so sync failures are non-fatal.
+    console.warn('Passkey sync with authenticator failed:', err);
+  }
+}
+
+/** Keep the account name shown in the authenticator's passkey picker current. */
+async function syncUserDetails() {
+  if (DEMO || !state.rpId || !state.user?.id) return;
+  if (typeof window.PublicKeyCredential?.signalCurrentUserDetails !== 'function') return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: state.rpId,
+      userId: state.user.id,
+      name: state.user.name,
+      displayName: state.user.displayName || state.user.name,
+    });
+  } catch (err) {
+    console.warn('User details sync with authenticator failed:', err);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering helpers                                                   */
+/* ------------------------------------------------------------------ */
+
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [key, value] of Object.entries(props)) {
+    if (value === undefined || value === null || value === false) continue;
+    if (key === 'className') node.className = value;
+    else if (key === 'dataset') Object.assign(node.dataset, value);
+    else if (key.startsWith('on')) node.addEventListener(key.slice(2).toLowerCase(), value);
+    else if (value === true) node.setAttribute(key, '');
+    else node.setAttribute(key, value);
+  }
+  for (const child of children.flat()) {
+    if (child === null || child === undefined || child === false) continue;
+    node.append(child instanceof Node ? child : document.createTextNode(String(child)));
+  }
+  return node;
+}
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+const relFmt = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function formatDate(value) {
+  const d = new Date(value);
+  return Number.isNaN(d.getTime()) ? 'Unknown' : dateFmt.format(d);
+}
+
+function formatRelative(value) {
+  const d = new Date(value);
+  if (Number.isNaN(d.getTime())) return 'Unknown';
+  const seconds = (d.getTime() - Date.now()) / 1000;
+  const units = [
+    ['year', 31536000], ['month', 2592000], ['week', 604800],
+    ['day', 86400], ['hour', 3600], ['minute', 60],
+  ];
+  for (const [unit, size] of units) {
+    if (Math.abs(seconds) >= size) return relFmt.format(Math.round(seconds / size), unit);
+  }
+  return 'just now';
+}
+
+function keyIcon() {
+  const ns = 'http://www.w3.org/2000/svg';
+  const svg = document.createElementNS(ns, 'svg');
+  svg.setAttribute('width', '22');
+  svg.setAttribute('height', '22');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  svg.setAttribute('fill', 'none');
+  svg.setAttribute('stroke', 'currentColor');
+  svg.setAttribute('stroke-width', '2');
+  svg.setAttribute('stroke-linecap', 'round');
+  svg.setAttribute('aria-hidden', 'true');
+  const path = document.createElementNS(ns, 'path');
+  path.setAttribute('d', 'M15.5 7.5a3.5 3.5 0 1 1-4.95 3.18L4 17.24V20h2.76l.74-.74V18h1.26l.74-.74V16h1.26l1.56-1.56A3.5 3.5 0 0 1 15.5 7.5zM16.5 9.5h.01');
+  svg.append(path);
+  return svg;
+}
+
+let noticeTimer;
+function showNotice(message, type = 'success') {
+  clearTimeout(noticeTimer);
+  noticeEl.replaceChildren(el('div', { className: `notice ${type}` }, message));
+  if (type === 'success') noticeTimer = setTimeout(() => noticeEl.replaceChildren(), 6000);
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                           */
+/* ------------------------------------------------------------------ */
+
+function render({ focus } = {}) {
+  root.setAttribute('aria-busy', 'false');
+
+  if (state.passkeys.length === 0) {
+    root.replaceChildren(
+      el('div', { className: 'state' },
+        el('h3', {}, 'No passkeys yet'),
+        el('p', {}, 'You can add a passkey the next time you sign in on a supported device.')),
+    );
+    syncNote.hidden = true;
+    return;
+  }
+
+  const sorted = [...state.passkeys].sort((a, b) => {
+    if (a.id === state.currentCredentialId) return -1;
+    if (b.id === state.currentCredentialId) return 1;
+    return new Date(b.lastUsedAt || b.createdAt) - new Date(a.lastUsedAt || a.createdAt);
+  });
+
+  const list = el('ul', { className: 'passkey-list', 'aria-label': 'Your passkeys' },
+    sorted.map((pk) => (pk.id === state.editingId ? renderEditor(pk) : renderItem(pk))));
+  root.replaceChildren(list);
+  syncNote.hidden = !signalSupported || DEMO;
+
+  if (focus) {
+    const target = root.querySelector(focus);
+    target?.focus();
+  }
+}
+
+function renderItem(pk) {
+  const busy = state.busyIds.has(pk.id);
+  const isCurrent = pk.id === state.currentCredentialId;
+  const meta = [
+    pk.providerName && el('span', {}, pk.providerName),
+    el('span', {}, `Added ${formatDate(pk.createdAt)}`),
+    el('span', {}, pk.lastUsedAt ? `Last used ${formatRelative(pk.lastUsedAt)}` : 'Never used'),
+  ];
+
+  return el('li', { className: 'passkey', dataset: { id: pk.id } },
+    el('div', { className: 'passkey-icon' }, keyIcon()),
+    el('div', { className: 'passkey-body' },
+      el('div', { className: 'passkey-name' },
+        pk.name || 'Unnamed passkey',
+        isCurrent && el('span', { className: 'badge current' }, 'This device'),
+        pk.backedUp && el('span', { className: 'badge', title: 'Synced across your devices by your password manager' }, 'Synced')),
+      el('div', { className: 'passkey-meta' }, meta)),
+    el('div', { className: 'passkey-actions' },
+      el('button', {
+        type: 'button',
+        className: 'btn btn-secondary',
+        dataset: { action: 'rename', id: pk.id },
+        disabled: busy,
+        'aria-label': `Rename ${pk.name || 'unnamed passkey'}`,
+        onClick: () => startEditing(pk.id),
+      }, 'Rename'),
+      el('button', {
+        type: 'button',
+        className: 'btn btn-danger',
+        dataset: { action: 'delete', id: pk.id },
+        disabled: busy,
+        'aria-label': `Remove ${pk.name || 'unnamed passkey'}`,
+        onClick: () => confirmDelete(pk.id),
+      }, busy ? 'Removing…' : 'Remove')),
+  );
+}
+
+function renderEditor(pk) {
+  const busy = state.busyIds.has(pk.id);
+  const inputId = `rename-${pk.id}`;
+  const errorId = `${inputId}-error`;
+  const input = el('input', {
+    id: inputId,
+    type: 'text',
+    name: 'name',
+    maxlength: String(NAME_MAX_LENGTH),
+    autocomplete: 'off',
+    required: true,
+    disabled: busy,
+    'aria-describedby': errorId,
+  });
+  input.value = pk.name || '';
+  const error = el('span', { id: errorId, className: 'field-error', 'aria-live': 'assertive' });
+
+  const form = el('form', {
+    className: 'rename-form',
+    onSubmit: (e) => {
+      e.preventDefault();
+      submitRename(pk.id, input, error);
+    },
+  },
+    el('label', { for: inputId, className: 'visually-hidden' }, 'Passkey name'),
+    input,
+    el('button', { type: 'submit', className: 'btn', disabled: busy }, busy ? 'Saving…' : 'Save'),
+    el('button', { type: 'button', className: 'btn btn-secondary', disabled: busy, onClick: () => stopEditing(pk.id) }, 'Cancel'),
+    error,
+  );
+
+  input.addEventListener('keydown', (e) => {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      stopEditing(pk.id);
+    }
+  });
+
+  return el('li', { className: 'passkey', dataset: { id: pk.id } },
+    el('div', { className: 'passkey-icon' }, keyIcon()),
+    el('div', { className: 'passkey-body' }, form),
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Actions                                                             */
+/* ------------------------------------------------------------------ */
+
+function startEditing(id) {
+  state.editingId = id;
+  render();
+  const input = document.getElementById(`rename-${id}`);
+  if (input) {
+    input.focus();
+    input.select();
+  }
+}
+
+function stopEditing(id) {
+  state.editingId = null;
+  render({ focus: `[data-action="rename"][data-id="${CSS.escape(id)}"]` });
+}
+
+async function submitRename(id, input, errorEl) {
+  // Collapse whitespace and strip control characters before sending.
+  const name = input.value.replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim();
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+
+  if (!name) {
+    errorEl.textContent = 'Please enter a name.';
+    input.setAttribute('aria-invalid', 'true');
+    input.focus();
+    return;
+  }
+  if (name.length > NAME_MAX_LENGTH) {
+    errorEl.textContent = `Names can be up to ${NAME_MAX_LENGTH} characters.`;
+    input.setAttribute('aria-invalid', 'true');
+    input.focus();
+    return;
+  }
+  if (name === pk.name) {
+    stopEditing(id);
+    return;
+  }
+
+  state.busyIds.add(id);
+  render({ focus: `#rename-${CSS.escape(id)}` });
+  try {
+    const updated = await api.rename(id, name);
+    pk.name = updated && typeof updated.name === 'string' ? updated.name : name;
+    state.busyIds.delete(id);
+    state.editingId = null;
+    render({ focus: `[data-action="rename"][data-id="${CSS.escape(id)}"]` });
+    showNotice(`Passkey renamed to “${pk.name}”.`);
+  } catch (err) {
+    state.busyIds.delete(id);
+    if (err.status === 404) {
+      await handleMissing(id);
+      return;
+    }
+    render();
+    const freshInput = document.getElementById(`rename-${id}`);
+    const freshError = document.getElementById(`rename-${id}-error`);
+    if (freshInput) {
+      freshInput.value = name;
+      freshInput.setAttribute('aria-invalid', 'true');
+      freshInput.focus();
+    }
+    if (freshError) freshError.textContent = err.message;
+  }
+}
+
+function confirmDelete(id) {
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+
+  document.getElementById('delete-name').textContent = pk.name || 'This passkey';
+  document.getElementById('delete-current-warning').hidden = id !== state.currentCredentialId;
+  document.getElementById('delete-last-warning').hidden = state.passkeys.length !== 1;
+
+  dialog.returnValue = '';
+  dialog.addEventListener('close', function onClose() {
+    dialog.removeEventListener('close', onClose);
+    if (dialog.returnValue === 'confirm') {
+      deletePasskey(id);
+    } else {
+      root.querySelector(`[data-action="delete"][data-id="${CSS.escape(id)}"]`)?.focus();
+    }
+  });
+  dialog.showModal();
+}
+
+async function deletePasskey(id) {
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+  const label = pk.name || 'Unnamed passkey';
+
+  // Work out where focus should go once the item disappears.
+  const items = [...root.querySelectorAll('.passkey')];
+  const index = items.findIndex((li) => li.dataset.id === id);
+  const neighbour = items[index + 1] || items[index - 1];
+
+  state.busyIds.add(id);
+  if (state.editingId === id) state.editingId = null;
+  render();
+
+  try {
+    await api.remove(id);
+  } catch (err) {
+    state.busyIds.delete(id);
+    if (err.status === 404) {
+      await handleMissing(id);
+      return;
+    }
+    render({ focus: `[data-action="delete"][data-id="${CSS.escape(id)}"]` });
+    showNotice(`Couldn’t remove “${label}”. ${err.message}`, 'error');
+    return;
+  }
+
+  state.busyIds.delete(id);
+  state.passkeys = state.passkeys.filter((p) => p.id !== id);
+  if (state.currentCredentialId === id) state.currentCredentialId = null;
+
+  render({
+    focus: neighbour
+      ? `[data-action="delete"][data-id="${CSS.escape(neighbour.dataset.id)}"]`
+      : undefined,
+  });
+  if (!neighbour) document.getElementById('passkeys-heading').focus();
+
+  await syncAcceptedCredentials();
+  showNotice(
+    signalSupported && !DEMO
+      ? `“${label}” was removed from your account and your browser was notified.`
+      : `“${label}” was removed from your account. You may also want to delete it from your device’s password manager.`,
+  );
+}
+
+/** The server says a passkey is gone (e.g. deleted in another tab): refresh. */
+async function handleMissing(id) {
+  state.passkeys = state.passkeys.filter((p) => p.id !== id);
+  if (state.editingId === id) state.editingId = null;
+  showNotice('That passkey was already removed. Your list has been refreshed.', 'info');
+  await load({ quiet: true });
+}
+
+async function load({ quiet = false } = {}) {
+  if (!quiet) {
+    root.setAttribute('aria-busy', 'true');
+    root.replaceChildren(el('div', { className: 'state' }, 'Loading your passkeys…'));
+  }
+  try {
+    const data = await api.list();
+    if (!data || !Array.isArray(data.passkeys)) throw new ApiError('Unexpected response from server.', 500);
+    state.rpId = data.rpId || location.hostname;
+    state.user = data.user || null;
+    state.currentCredentialId = data.currentCredentialId || null;
+    state.passkeys = data.passkeys.filter((p) => p && typeof p.id === 'string');
+    if (state.editingId && !state.passkeys.some((p) => p.id === state.editingId)) state.editingId = null;
+
+    if (state.user?.displayName) greeting.textContent = `Welcome back, ${state.user.displayName}.`;
+    render();
+
+    // Reconcile the authenticator with the server's list (covers keys deleted elsewhere).
+    syncAcceptedCredentials();
+    syncUserDetails();
+  } catch (err) {
+    if (err.status === 401) return;
+    root.setAttribute('aria-busy', 'false');
+    root.replaceChildren(
+      el('div', { className: 'state' },
+        el('h3', {}, 'We couldn’t load your passkeys'),
+        el('p', {}, err.message),
+        el('button', { type: 'button', className: 'btn', onClick: () => load() }, 'Try again')),
+    );
+  }
+}
+
+document.getElementById('passkeys-heading').setAttribute('tabindex', '-1');
+if (DEMO) showNotice('Demo mode: showing sample passkeys. Changes are not saved.', 'info');
+load();
