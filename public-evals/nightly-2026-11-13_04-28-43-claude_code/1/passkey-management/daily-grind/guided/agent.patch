+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+  <link rel="stylesheet" href="/account/account.css">
+  <script type="module" src="/account/passkeys.js"></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account/" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="account-hero">
+    <h1>My Account</h1>
+    <p>Manage your profile and how you sign in.</p>
+  </header>
+
+  <main class="container account">
+    <p id="demo-notice" class="notice" hidden>
+      Showing demo data — the account service isn't reachable, so changes are saved in this browser only.
+    </p>
+
+    <!-- Profile -->
+    <section class="panel" aria-labelledby="profile-title">
+      <h2 id="profile-title">Profile</h2>
+      <form id="profile-form" class="profile-form">
+        <label>
+          <span>Email / username</span>
+          <input name="name" type="email" autocomplete="username" required>
+        </label>
+        <label>
+          <span>Display name</span>
+          <input name="displayName" type="text" autocomplete="name" required maxlength="64">
+        </label>
+        <button type="submit" class="btn">Save profile</button>
+      </form>
+    </section>
+
+    <!-- Passkeys -->
+    <section class="panel" aria-labelledby="passkeys-title">
+      <div class="panel-header">
+        <div>
+          <h2 id="passkeys-title">Passkeys</h2>
+          <p class="muted">Sign in with your fingerprint, face, screen lock, or a security key — no password needed.</p>
+        </div>
+        <button type="button" id="create-passkey" class="btn" hidden>Create a passkey</button>
