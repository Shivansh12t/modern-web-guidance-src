index 0000000..d9ae5f5
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,283 @@
+import * as api from './api.js';
+import { lookupProvider, ZERO_AAGUID } from './aaguids.js';
+
+// ---------- Progressive-enhancement polyfills (loaded only when missing) ----------
+
+if (!('commandForElement' in HTMLButtonElement.prototype)) {
+  import('https://esm.sh/invokers-polyfill@0.5.7').catch(() => {});
+}
+
+const webauthnPolyfill =
+  window.PublicKeyCredential &&
+  (!PublicKeyCredential.getClientCapabilities || !PublicKeyCredential.parseCreationOptionsFromJSON)
+    ? import('https://esm.sh/webauthn-polyfills@0.1.7').catch(() => {})
+    : Promise.resolve();
+
+// ---------- DOM ----------
+
+const $ = (id) => document.getElementById(id);
+const list = $('passkey-list');
+const emptyState = $('passkey-empty');
+const rowTemplate = $('passkey-row');
+const statusEl = $('status');
+const createBtn = $('create-passkey');
+const renameDialog = $('rename-dialog');
+const renameForm = $('rename-form');
+const deleteDialog = $('delete-dialog');
+const profileForm = $('profile-form');
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+let credentials = [];
+let activeCredential = null;
+
+function announce(message) {
+  // Clear first so repeating the same message is still announced.
+  statusEl.textContent = '';
+  requestAnimationFrame(() => { statusEl.textContent = message; });
+}
+
+function showDemoNotice() {
+  $('demo-notice').hidden = !api.isDemoMode();
+}
+
+// ---------- Signal API (keeps password managers in sync with the server) ----------
+
+function isValidBase64Url(value) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function syncAcceptedCredentials(rpId, userId, creds) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = creds.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and Base64URL userId/credential IDs are required.');
+    return;
+  }
+  try {
+    // rpId always comes from the server, never window.location.hostname.
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function syncUserDetails({ rpId, userId, name, displayName }) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// ---------- Rendering ----------
+
+function labelFor(cred) {
+  return cred.name?.trim() || lookupProvider(cred.aaguid).name;
+}
+
+function render() {
+  list.replaceChildren(
+    ...credentials.map((cred) => {
+      const row = rowTemplate.content.firstElementChild.cloneNode(true);
+      const provider = lookupProvider(cred.aaguid);
+      const label = labelFor(cred);
+      row.dataset.id = cred.id;
+      row.querySelector('.passkey-icon').src = cred.providerIcon || provider.icon;
+      row.querySelector('.passkey-name').textContent = label;
+
+      const providerEl = row.querySelector('.passkey-provider');
+      if (provider.name !== label && provider.name !== 'Passkey') {
+        providerEl.textContent = `Saved in ${provider.name}`;
+      } else {
+        providerEl.remove();
+      }
+
+      const created = row.querySelector('.passkey-created');
+      created.dateTime = new Date(cred.registeredAt).toISOString();
+      created.textContent = dateFormat.format(cred.registeredAt);
+
+      if (cred.lastUsedAt) {
+        const used = row.querySelector('.passkey-used');
+        used.dateTime = new Date(cred.lastUsedAt).toISOString();
+        used.textContent = dateFormat.format(cred.lastUsedAt);
+      } else {
+        row.querySelector('.passkey-used-wrap').textContent = ' · Never used';
+      }
+
+      for (const btn of row.querySelectorAll('button')) {
+        btn.setAttribute('aria-label', `${btn.textContent} ${label}`);
+      }
+      return row;
+    }),
+  );
+  list.hidden = credentials.length === 0;
+  emptyState.hidden = credentials.length > 0;
+  list.setAttribute('aria-busy', 'false');
+}
+
+async function refreshCredentials({ sync = true } = {}) {
+  const { rpId, userId, credentials: creds } = await api.listCredentials();
+  credentials = creds;
+  render();
+  showDemoNotice();
+  if (sync) await syncAcceptedCredentials(rpId, userId, credentials);
+}
+
+// ---------- Rename ----------
+
+list.addEventListener('click', (event) => {
+  const btn = event.target.closest('button[data-action]');
+  if (!btn) return;
+  activeCredential = credentials.find((c) => c.id === btn.closest('.passkey').dataset.id);
+  if (!activeCredential) return;
+
+  if (btn.dataset.action === 'rename') {
+    renameForm.elements.name.value = labelFor(activeCredential);
+    renameDialog.returnValue = '';
+    renameDialog.showModal();
+    renameForm.elements.name.select();
+  } else if (btn.dataset.action === 'delete') {
+    $('delete-name').textContent = labelFor(activeCredential);
+    $('delete-last-warning').hidden = credentials.length > 1;
+    deleteDialog.returnValue = '';
+    deleteDialog.showModal();
+  }
+});
+
+renameDialog.addEventListener('close', async () => {
+  const choice = renameDialog.returnValue;
+  renameDialog.returnValue = '';
+  const cred = activeCredential;
+  const newName = renameForm.elements.name.value.trim();
+  if (choice !== 'save' || !cred || !newName || newName === labelFor(cred)) return;
+
+  try {
+    // Nickname is a server-side label only; no Signal API call is needed.
+    await api.renameCredential(cred.id, newName);
+    await refreshCredentials({ sync: false });
+    announce(`Passkey renamed to “${newName}”.`);
+  } catch (e) {
+    console.warn(e);
+    announce('Sorry, we couldn’t rename that passkey. Please try again.');
+  }
+});
+
+// ---------- Delete ----------
+
+deleteDialog.addEventListener('close', async () => {
+  const choice = deleteDialog.returnValue;
+  deleteDialog.returnValue = '';
+  const cred = activeCredential;
+  if (choice !== 'delete' || !cred) return;
+
+  const label = labelFor(cred);
+  try {
+    await api.deleteCredential(cred.id);
+    // Re-fetch and tell the password manager which credentials are still valid,
+    // so the deleted passkey is removed from the user's authenticator too.
+    await refreshCredentials();
+    announce(`“${label}” was deleted.`);
+    (list.querySelector('button') || createBtn).focus?.();
+  } catch (e) {
+    console.warn(e);
+    announce('Sorry, we couldn’t delete that passkey. Please try again.');
+  }
+});
+
+// ---------- Profile ----------
+
+async function loadProfile() {
+  const user = await api.getUser();
+  profileForm.elements.name.value = user.name ?? '';
+  profileForm.elements.displayName.value = user.displayName ?? '';
+}
+
+profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const submit = profileForm.querySelector('[type=submit]');
+  const name = profileForm.elements.name.value.trim();
+  const displayName = profileForm.elements.displayName.value.trim();
+  submit.disabled = true;
+  try {
+    const updated = await api.updateUser({ name, displayName });
+    await syncUserDetails({ ...updated, name, displayName });
+    announce('Profile saved.');
+  } catch (e) {
+    console.warn(e);
+    announce('Sorry, we couldn’t save your profile. Please try again.');
+  } finally {
+    submit.disabled = false;
+  }
+});
+
+// ---------- Create passkey ----------
+
+async function isPasskeySupported() {
+  await webauthnPolyfill;
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.parseCreationOptionsFromJSON) return false;
+  try {
+    const caps = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(caps.passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+function aaguidFrom(credential) {
+  try {
+    const authData = new Uint8Array(credential.response.getAuthenticatorData());
+    const hex = [...authData.slice(37, 53)].map((b) => b.toString(16).padStart(2, '0')).join('');
+    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+  } catch {
+    return ZERO_AAGUID;
+  }
+}
+
+createBtn.addEventListener('click', async () => {
+  createBtn.disabled = true;
+  try {
+    const optionsJSON = await api.getRegistrationOptions();
+    // authenticatorAttachment is left unset so security keys can be registered too.
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+    const credential = await navigator.credentials.create({ publicKey });
+    await api.registerCredential(credential.toJSON(), aaguidFrom(credential));
+    await refreshCredentials();
+    announce('Passkey created. You can use it next time you sign in.');
+  } catch (e) {
+    if (e.name === 'NotAllowedError' || e.name === 'AbortError') {
+      announce('Passkey creation was cancelled.');
+    } else if (e.name === 'InvalidStateError') {
+      announce('A passkey for this account already exists on this device.');
+    } else {
+      console.warn(e);
+      announce('Sorry, we couldn’t create a passkey. Please try again.');
+    }
+  } finally {
+    createBtn.disabled = false;
+  }
+});
+
+// ---------- Init ----------
+
+async function init() {
+  try {
+    await Promise.all([refreshCredentials(), loadProfile()]);
+  } catch (e) {
+    console.warn(e);
+    list.setAttribute('aria-busy', 'false');
+    announce('We couldn’t load your account details. Please refresh the page.');
+  }
+  showDemoNotice();
+
+  const supported = await isPasskeySupported();
+  createBtn.hidden = !supported;
+  $('passkey-unsupported').hidden = supported;
+}
+
+init();
