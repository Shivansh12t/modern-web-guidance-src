+
+    <p id="status" class="status" role="status" aria-live="polite"></p>
+  </main>
+
+  <template id="passkey-row">
+    <li class="passkey">
+      <img class="passkey-icon" alt="" width="40" height="40">
+      <div class="passkey-info">
+        <strong class="passkey-name"></strong>
+        <span class="passkey-provider muted"></span>
+        <span class="passkey-dates muted">
+          Created <time class="passkey-created"></time><span class="passkey-used-wrap"> · Last used
+            <time class="passkey-used"></time></span>
+        </span>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="btn-secondary" data-action="rename">Rename</button>
+        <button type="button" class="btn-danger" data-action="delete">Delete</button>
+      </div>
+    </li>
+  </template>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-title" closedby="any">
+    <form method="dialog" id="rename-form">
+      <h2 id="rename-title">Rename passkey</h2>
+      <label>
+        <span>Passkey name</span>
+        <input name="name" type="text" required maxlength="64" autocomplete="off" autofocus>
+      </label>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" formnovalidate class="btn-secondary">Cancel</button>
+        <button type="submit" value="save" class="btn">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="delete-dialog" aria-labelledby="delete-title" aria-describedby="delete-desc">
+    <form method="dialog">
