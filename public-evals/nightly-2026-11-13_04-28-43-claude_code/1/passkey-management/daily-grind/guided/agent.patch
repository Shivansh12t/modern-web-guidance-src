diff --git a/account/api.js b/account/api.js
new file mode 100644
index 0000000..294bd35
--- /dev/null
+++ b/account/api.js
@@ -0,0 +1,199 @@
+// Account / passkey API client.
+//
+// Expected backend contract (session-cookie authenticated):
+//   GET    /api/credentials              -> { rpId, userId, credentials: StoredPasskeyCredential[] }
+//   PUT    /api/credential/:id  {name}   -> StoredPasskeyCredential
+//   DELETE /api/credential/:id           -> { success: true }
+//   GET    /api/user                     -> { name, displayName, rpId, userId }
+//   PUT    /api/user {name, displayName} -> { name, displayName, rpId, userId }
+//   POST   /api/passkey/registration-options -> PublicKeyCredentialCreationOptionsJSON
+//   POST   /api/passkey/register  (RegistrationResponseJSON) -> StoredPasskeyCredential
+//
+// StoredPasskeyCredential: { id, name, aaguid, registeredAt, lastUsedAt? }
+// `id` and `userId` are unpadded Base64URL strings; timestamps are epoch milliseconds.
+//
+// The site is currently served statically, so when the backend isn't reachable the client
+// falls back to an in-browser demo store (localStorage) so the UI remains usable.
+
+const DEMO_KEY = 'dailygrind:demo-account';
+let demoMode = false;
+
+export const isDemoMode = () => demoMode;
+
+async function request(method, url, body) {
+  const res = await fetch(url, {
+    method,
+    credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  if (res.status === 401) {
+    location.href = `/login?next=${encodeURIComponent(location.pathname)}`;
+    throw new Error('Not signed in');
+  }
+  if (!res.ok) {
+    const err = new Error(`Request failed (${res.status})`);
+    err.status = res.status;
+    throw err;
+  }
+  const type = res.headers.get('content-type') || '';
+  if (!type.includes('application/json')) {
+    const err = new Error('Unexpected response');
+    err.status = res.status;
+    throw err;
+  }
+  return res.json();
+}
+
+// ---------- Demo store ----------
+
+const DAY = 86_400_000;
+
+function seedDemo() {
+  const now = Date.now();
+  return {
+    rpId: location.hostname,
+    // Valid unpadded Base64URL IDs (required by the Signal API).
+    userId: 'ZGVtby11c2VyLTQyMDE',
+    name: 'alex@example.com',
+    displayName: 'Alex Barista',
+    credentials: [
+      {
+        id: 'ZGVtby1jcmVkLWdwbS0x',
+        name: 'Google Password Manager',
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        registeredAt: now - 120 * DAY,
+        lastUsedAt: now - 2 * DAY,
+      },
+      {
+        id: 'ZGVtby1jcmVkLWljbG91ZC0y',
+        name: 'iCloud Keychain',
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        registeredAt: now - 45 * DAY,
+        lastUsedAt: now - 9 * DAY,
+      },
+      {
+        id: 'ZGVtby1jcmVkLXl1YmlrZXktMw',
+        name: 'Office YubiKey',
+        aaguid: 'cb69481e-8ff7-4039-93ec-0a2729a154a8',
+        registeredAt: now - 300 * DAY,
+      },
+    ],
+  };
+}
+
+function loadDemo() {
+  try {
+    const saved = JSON.parse(localStorage.getItem(DEMO_KEY));
+    if (saved && Array.isArray(saved.credentials)) return saved;
+  } catch { /* fall through */ }
+  const seeded = seedDemo();
+  saveDemo(seeded);
+  return seeded;
+}
+
+function saveDemo(state) {
+  localStorage.setItem(DEMO_KEY, JSON.stringify(state));
+}
+
+const demo = {
+  listCredentials() {
+    const { rpId, userId, credentials } = loadDemo();
+    return { rpId, userId, credentials };
+  },
+  renameCredential(id, name) {
+    const state = loadDemo();
+    const cred = state.credentials.find((c) => c.id === id);
+    if (!cred) throw Object.assign(new Error('Credential not found.'), { status: 404 });
+    cred.name = name;
+    saveDemo(state);
+    return cred;
+  },
+  deleteCredential(id) {
+    const state = loadDemo();
+    state.credentials = state.credentials.filter((c) => c.id !== id);
+    saveDemo(state);
+    return { success: true };
+  },
+  getUser() {
+    const { name, displayName, rpId, userId } = loadDemo();
+    return { name, displayName, rpId, userId };
+  },
+  updateUser({ name, displayName }) {
+    const state = loadDemo();
+    Object.assign(state, { name, displayName });
+    saveDemo(state);
+    return { name, displayName, rpId: state.rpId, userId: state.userId };
+  },
+  registrationOptions() {
+    const { rpId, userId, name, displayName, credentials } = loadDemo();
+    const challenge = new Uint8Array(32);
+    crypto.getRandomValues(challenge);
+    return {
+      challenge: toBase64Url(challenge),
+      rp: { id: rpId, name: 'The Daily Grind' },
+      user: { id: userId, name, displayName },
+      pubKeyCredParams: [{ type: 'public-key', alg: -7 }, { type: 'public-key', alg: -257 }],
+      excludeCredentials: credentials.map((c) => ({ type: 'public-key', id: c.id })),
+      authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+      attestation: 'none',
+    };
+  },
+  register(response, aaguid) {
+    // Demo only: a real server MUST verify the attestation (e.g. with SimpleWebAuthn).
+    const state = loadDemo();
+    const cred = { id: response.id, name: '', aaguid, registeredAt: Date.now() };
+    state.credentials.push(cred);
+    saveDemo(state);
+    return cred;
+  },
+};
+
+function toBase64Url(bytes) {
+  let s = '';
+  for (const b of bytes) s += String.fromCharCode(b);
+  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+// Real request, or the demo store if the backend isn't available at all.
+async function call(realFn, demoFn) {
+  if (demoMode) return demoFn();
+  try {
+    return await realFn();
+  } catch (err) {
+    // Network failure, missing endpoint, or the static server returning HTML.
+    if (err instanceof TypeError || err.status === 404 || err.status === 405 || err.status === 200) {
+      demoMode = true;
+      return demoFn();
+    }
+    throw err;
+  }
+}
+
+// ---------- Public API ----------
+
+export const listCredentials = () =>
+  call(() => request('GET', '/api/credentials'), () => demo.listCredentials());
+
+export const renameCredential = (id, name) =>
+  call(
+    () => request('PUT', `/api/credential/${encodeURIComponent(id)}`, { name }),
+    () => demo.renameCredential(id, name),
+  );
+
+export const deleteCredential = (id) =>
+  call(
+    () => request('DELETE', `/api/credential/${encodeURIComponent(id)}`),
+    () => demo.deleteCredential(id),
+  );
+
+export const getUser = () => call(() => request('GET', '/api/user'), () => demo.getUser());
+
+export const updateUser = (details) =>
+  call(() => request('PUT', '/api/user', details), () => demo.updateUser(details));
+
+export const getRegistrationOptions = () =>
+  call(() => request('POST', '/api/passkey/registration-options'), () => demo.registrationOptions());
+
+export const registerCredential = (responseJSON, aaguid) =>
+  call(() => request('POST', '/api/passkey/register', responseJSON), () => demo.register(responseJSON, aaguid));
