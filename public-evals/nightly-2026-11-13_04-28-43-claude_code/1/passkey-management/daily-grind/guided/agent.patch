index 0000000..c734685
--- /dev/null
+++ b/account/aaguids.js
@@ -0,0 +1,44 @@
+// Small local subset of the community AAGUID registry
+// (https://github.com/passkeydeveloper/passkey-authenticator-aaguids), used only as a UX hint
+// to show which provider holds each passkey. Never use AAGUIDs for security decisions.
+
+const tile = (letter, bg) =>
+  `data:image/svg+xml,${encodeURIComponent(
+    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><rect width="40" height="40" rx="8" fill="${bg}"/>` +
+    `<text x="20" y="27" font-family="Segoe UI,Arial,sans-serif" font-size="18" font-weight="700" fill="#fff" text-anchor="middle">${letter}</text></svg>`,
+  )}`;
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+export const UNKNOWN_PROVIDER = {
+  name: 'Passkey',
+  icon: `data:image/svg+xml,${encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><rect width="40" height="40" rx="8" fill="#8d6e63"/>' +
+    '<circle cx="16" cy="17" r="6" fill="none" stroke="#fff" stroke-width="3"/>' +
+    '<path d="M21 20l10 10M27 26l3-3M24 23l3-3" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>',
+  )}`,
+};
+
+const REGISTRY = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager', icon: tile('G', '#1a73e8') },
+  'adce0002-35bc-c60a-648b-0b25f1f05503': { name: 'Chrome on Mac', icon: tile('C', '#1a73e8') },
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': { name: 'iCloud Keychain', icon: tile('i', '#555') },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': { name: 'iCloud Keychain (Managed)', icon: tile('i', '#555') },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': { name: 'Windows Hello', icon: tile('W', '#0078d4') },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': { name: 'Windows Hello', icon: tile('W', '#0078d4') },
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': { name: 'Windows Hello', icon: tile('W', '#0078d4') },
+  'bada5566-a7aa-401f-bd96-45619a55120d': { name: '1Password', icon: tile('1', '#0572ec') },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': { name: 'Bitwarden', icon: tile('B', '#175ddc') },
+  '531126d6-e717-415c-9320-3d9aa6981239': { name: 'Dashlane', icon: tile('D', '#0e353d') },
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': { name: 'NordPass', icon: tile('N', '#3e5fff') },
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': { name: 'Keeper', icon: tile('K', '#ffc700') },
+  '53414d53-554e-4700-0000-000000000000': { name: 'Samsung Pass', icon: tile('S', '#1428a0') },
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': { name: 'YubiKey 5 Series', icon: tile('Y', '#84bd00') },
+  'ee882879-721c-4913-9775-3dfcce97072a': { name: 'YubiKey 5 Series', icon: tile('Y', '#84bd00') },
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': { name: 'YubiKey 5 Series (NFC)', icon: tile('Y', '#84bd00') },
+};
+
+export function lookupProvider(aaguid) {
+  if (!aaguid || aaguid === ZERO_AAGUID) return UNKNOWN_PROVIDER;
+  return REGISTRY[aaguid.toLowerCase()] ?? UNKNOWN_PROVIDER;
+}
