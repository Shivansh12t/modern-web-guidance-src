@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import { json } from '../../../lib/auth';
+
+const LOGIN_ENDPOINT = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Verifies credentials against the Times auth service and, on success, records
+ * the reader in the server-side session so account pages know who is signed in.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  let body: { username?: unknown; password?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body' }, { status: 400 });
+  }
+  const { username, password } = body;
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required' }, { status: 400 });
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Authentication service unavailable' }, { status: 502 });
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json({ error: data.error || 'Unknown error' }, { status: upstream.status });
+  }
+
+  if (session) {
+    // Rotate the session ID on privilege change to prevent session fixation.
+    await session.regenerate();
+    session.set('user', { username: username.trim() });
+  }
+  return json({ ok: true, username: username.trim() });
+};
