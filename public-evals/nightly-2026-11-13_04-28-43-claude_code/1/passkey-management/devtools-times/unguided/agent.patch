@@ -0,0 +1,30 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { getSessionUser, json, unauthorized } from '../../../lib/auth';
+import { getWebAuthnUserID, listPasskeys } from '../../../lib/passkeyStore';
+import { getRelyingParty } from '../../../lib/webauthn';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return unauthorized();
+
+  const { rpName, rpID } = getRelyingParty(url);
+  const [userID, existing] = await Promise.all([
+    getWebAuthnUserID(user.username),
+    listPasskeys(user.username),
+  ]);
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userName: user.username,
+    userDisplayName: user.username,
+    userID: Buffer.from(userID, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials: existing.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  session.set('passkeyChallenge', { challenge: options.challenge, expires: Date.now() + 5 * 60_000 });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..052faab
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { getSessionUser, json, unauthorized } from '../../../lib/auth';
+import { addPasskey, listPasskeys } from '../../../lib/passkeyStore';
+import { toSummary } from '../../../lib/passkeyView';
+import { getRelyingParty, sanitizePasskeyName } from '../../../lib/webauthn';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return unauthorized();
+
+  const pending = await session.get('passkeyChallenge');
+  // Challenges are single-use.
+  session.delete('passkeyChallenge');
+  if (!pending || typeof pending.challenge !== 'string' || Date.now() > pending.expires) {
+    return json({ error: 'Registration timed out. Please try again.' }, { status: 400 });
+  }
+
+  let body: { response?: RegistrationResponseJSON; name?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body' }, { status: 400 });
+  }
+  if (!body.response) return json({ error: 'Missing registration response' }, { status: 400 });
+
+  const { rpID, origin } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, { status: 400 });
+  }
+  if (!verification.verified) {
+    return json({ error: 'Passkey could not be verified.' }, { status: 400 });
+  }
+
+  const info = verification.registrationInfo;
+  const existing = await listPasskeys(user.username);
+  const providerName = info.passkeyProviderMetadata?.friendlyNames?.['en-US'];
+  const name =
+    sanitizePasskeyName(body.name) ??
+    sanitizePasskeyName(providerName) ??
+    `Passkey ${existing.length + 1}`;
+
+  const stored = {
+    id: info.credential.id,
+    publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+    counter: info.credential.counter,
+    transports: info.credential.transports,
+    deviceType: info.credentialDeviceType,
+    backedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    name,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+
+  try {
+    await addPasskey(user.username, stored);
+  } catch (err) {
+    return json({ error: (err as Error).message }, { status: 409 });
+  }
+  return json({ passkey: toSummary(stored) }, { status: 201 });
+};
