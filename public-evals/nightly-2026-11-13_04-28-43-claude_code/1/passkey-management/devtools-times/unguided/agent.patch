@@ -0,0 +1,39 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json, unauthorized } from '../../../lib/auth';
+import { deletePasskey, renamePasskey } from '../../../lib/passkeyStore';
+import { toSummary } from '../../../lib/passkeyView';
+import { MAX_NAME_LENGTH, sanitizePasskeyName } from '../../../lib/webauthn';
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  let body: { name?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body' }, { status: 400 });
+  }
+  const name = sanitizePasskeyName(body.name);
+  if (!name) {
+    return json(
+      { error: `Name must be between 1 and ${MAX_NAME_LENGTH} characters.` },
+      { status: 400 },
+    );
+  }
+
+  const updated = await renamePasskey(user.username, params.id!, name);
+  if (!updated) return json({ error: 'Passkey not found' }, { status: 404 });
+  return json({ passkey: toSummary(updated) });
+};
+
+/** Remove a passkey from the account. */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const removed = await deletePasskey(user.username, params.id!);
+  if (!removed) return json({ error: 'Passkey not found' }, { status: 404 });
+  return new Response(null, { status: 204 });
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
new file mode 100644
index 0000000..ad2aec9
