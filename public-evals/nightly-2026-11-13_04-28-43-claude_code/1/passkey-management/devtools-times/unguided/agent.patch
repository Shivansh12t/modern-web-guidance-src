diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..d482292
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,417 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  browserSupportsWebAuthn,
+  startRegistration,
+  WebAuthnError,
+} from '@simplewebauthn/browser';
+import { KeyIcon, PencilSquareIcon, TrashIcon, CloudIcon, DevicePhoneMobileIcon } from '@heroicons/react/24/outline';
+import type { PasskeySummary } from '../lib/passkeyView';
+
+const API = `${import.meta.env.BASE_URL}api/passkeys`;
+const MAX_NAME_LENGTH = 64;
+
+interface AccountPasskeys {
+  rpID: string;
+  userID: string;
+  username: string;
+  passkeys: PasskeySummary[];
+}
+
+type SignalCapableCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (opts: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (opts: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+};
+
+function getSignalApi(): SignalCapableCredential | null {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) return null;
+  const pkc = window.PublicKeyCredential as SignalCapableCredential;
+  return typeof pkc.signalAllAcceptedCredentials === 'function' ? pkc : null;
+}
+
+/**
+ * Tell the browser (and through it, the reader's passkey providers) which
+ * credentials this account still accepts and what the account is called, so
+ * deleted passkeys stop being offered at sign-in. Best effort: the WebAuthn
+ * Signal API is fire-and-forget and not supported everywhere.
+ */
+async function syncAuthenticator(account: Omit<AccountPasskeys, 'passkeys'>, ids: string[]) {
+  const pkc = getSignalApi();
+  if (!pkc) return false;
+  try {
+    await pkc.signalAllAcceptedCredentials!({
+      rpId: account.rpID,
+      userId: account.userID,
+      allAcceptedCredentialIds: ids,
+    });
+    await pkc.signalCurrentUserDetails?.({
+      rpId: account.rpID,
+      userId: account.userID,
+      name: account.username,
+      displayName: account.username,
+    });
+    return true;
+  } catch (err) {
+    console.warn('Could not sync passkeys with the browser authenticator', err);
+    return false;
+  }
+}
+
+async function readError(res: Response, fallback: string) {
+  try {
+    const data = await res.json();
+    return data.error || fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
+const formatDate = (iso: string) => dateFormat.format(new Date(iso));
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<AccountPasskeys | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [creating, setCreating] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+  const [webAuthnSupported, setWebAuthnSupported] = useState(true);
+  const [signalSupported, setSignalSupported] = useState(false);
+  const editInputRef = useRef<HTMLInputElement>(null);
+
+  const applyPasskeys = useCallback(
+    (next: AccountPasskeys) => {
+      setAccount(next);
+      void syncAuthenticator(next, next.passkeys.map((p) => p.id));
+    },
+    [],
+  );
+
+  useEffect(() => {
+    setWebAuthnSupported(browserSupportsWebAuthn());
+    setSignalSupported(getSignalApi() !== null);
+
+    (async () => {
+      try {
+        const res = await fetch(API, { headers: { Accept: 'application/json' } });
+        if (res.status === 401) {
+          window.location.href = `${import.meta.env.BASE_URL}signin?next=account`;
+          return;
+        }
+        if (!res.ok) throw new Error(await readError(res, 'Could not load your passkeys.'));
+        applyPasskeys(await res.json());
+      } catch (err) {
+        setError((err as Error).message);
+      } finally {
+        setLoading(false);
+      }
+    })();
+  }, [applyPasskeys]);
+
+  useEffect(() => {
+    if (editingId) editInputRef.current?.focus();
+  }, [editingId]);
+
+  const flash = (message: string) => {
+    setError(null);
+    setNotice(message);
+  };
+
+  const handleCreate = async () => {
+    if (!account) return;
+    setError(null);
+    setNotice(null);
+    setCreating(true);
+    try {
+      const optionsRes = await fetch(`${API}/register-options`, { method: 'POST' });
+      if (!optionsRes.ok) throw new Error(await readError(optionsRes, 'Could not start registration.'));
+      const optionsJSON = await optionsRes.json();
+
+      const response = await startRegistration({ optionsJSON });
+
+      const verifyRes = await fetch(`${API}/register-verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ response }),
+      });
+      if (!verifyRes.ok) throw new Error(await readError(verifyRes, 'Could not save the passkey.'));
+      const { passkey } = (await verifyRes.json()) as { passkey: PasskeySummary };
+
+      applyPasskeys({ ...account, passkeys: [...account.passkeys, passkey] });
+      flash(`Added “${passkey.name}”. You can rename it below.`);
+    } catch (err) {
+      if (err instanceof WebAuthnError && err.code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') {
+        setError('This device already has a passkey for your account.');
+      } else if (err instanceof Error && err.name === 'NotAllowedError') {
+        setError('Passkey creation was cancelled.');
+      } else {
+        setError((err as Error).message);
+      }
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const startEditing = (passkey: PasskeySummary) => {
+    setConfirmDeleteId(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+  };
+
+  const cancelEditing = () => {
+    setEditingId(null);
+    setDraftName('');
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: PasskeySummary) => {
+    e.preventDefault();
+    if (!account) return;
+    const name = draftName.replace(/\s+/g, ' ').trim();
+    if (!name) {
+      setError('Passkey name cannot be empty.');
+      return;
+    }
+    if (name === passkey.name) {
+      cancelEditing();
+      return;
+    }
+    setBusyId(passkey.id);
+    try {
+      const res = await fetch(`${API}/${encodeURIComponent(passkey.id)}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!res.ok) throw new Error(await readError(res, 'Could not rename the passkey.'));
+      const { passkey: updated } = (await res.json()) as { passkey: PasskeySummary };
+      applyPasskeys({
+        ...account,
+        passkeys: account.passkeys.map((p) => (p.id === updated.id ? updated : p)),
+      });
+      cancelEditing();
+      flash(`Renamed passkey to “${updated.name}”.`);
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleDelete = async (passkey: PasskeySummary) => {
+    if (!account) return;
+    setBusyId(passkey.id);
+    try {
+      const res = await fetch(`${API}/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+      if (!res.ok && res.status !== 404) {
+        throw new Error(await readError(res, 'Could not remove the passkey.'));
+      }
+      const remaining = account.passkeys.filter((p) => p.id !== passkey.id);
+      setConfirmDeleteId(null);
+      setAccount({ ...account, passkeys: remaining });
+      const synced = await syncAuthenticator(account, remaining.map((p) => p.id));
+      flash(
+        synced
+          ? `Removed “${passkey.name}”. Your browser has been asked to remove it from your passkey provider too.`
+          : `Removed “${passkey.name}”. You may also want to delete it from your device’s password manager.`,
+      );
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between p-6 border-b border-gray-200">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900 flex items-center gap-2">
+            <KeyIcon className="h-5 w-5" aria-hidden="true" />
+            Passkeys
+          </h2>
+          <p className="mt-1 text-sm text-gray-600 max-w-prose">
+            Passkeys let you sign in with your fingerprint, face, screen lock, or a security key instead of a
+            password. Give each one a name so you can recognise it later.
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleCreate}
+          disabled={!account || creating || !webAuthnSupported}
+          className="shrink-0 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+        >
+          {creating ? 'Waiting for device…' : 'Create a passkey'}
+        </button>
+      </div>
+
+      <div className="p-6 space-y-4">
+        {!webAuthnSupported && (
+          <p className="p-3 text-sm text-yellow-800 bg-yellow-50 rounded-md">
+            This browser doesn’t support passkeys. You can still rename or remove existing ones.
+          </p>
+        )}
+
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-md" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && (
+          <div className="p-3 text-sm text-green-800 bg-green-100 rounded-md" role="status">
+            {notice}
+          </div>
+        )}
+
+        {loading ? (
+          <p className="text-sm text-gray-500">Loading passkeys…</p>
+        ) : account && account.passkeys.length === 0 ? (
+          <div className="text-center py-8 border border-dashed border-gray-300 rounded-md">
+            <KeyIcon className="h-8 w-8 mx-auto text-gray-400" aria-hidden="true" />
+            <p className="mt-2 text-sm text-gray-600">You haven’t registered any passkeys yet.</p>
+          </div>
+        ) : account ? (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {account.passkeys.map((passkey) => {
+              const isEditing = editingId === passkey.id;
+              const isConfirming = confirmDeleteId === passkey.id;
+              const isBusy = busyId === passkey.id;
+              const SyncIcon = passkey.backedUp ? CloudIcon : DevicePhoneMobileIcon;
+
+              return (
+                <li key={passkey.id} className="p-4">
+                  <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+                    <div className="flex items-start gap-3 min-w-0 flex-1">
+                      <SyncIcon className="h-6 w-6 mt-0.5 shrink-0 text-gray-500" aria-hidden="true" />
+                      <div className="min-w-0 flex-1">
+                        {isEditing ? (
+                          <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-wrap gap-2">
+                            <label htmlFor={`passkey-name-${passkey.id}`} className="sr-only">
+                              Passkey name
+                            </label>
+                            <input
+                              ref={editInputRef}
+                              id={`passkey-name-${passkey.id}`}
+                              type="text"
+                              value={draftName}
+                              maxLength={MAX_NAME_LENGTH}
+                              onChange={(e) => setDraftName(e.target.value)}
+                              onKeyDown={(e) => e.key === 'Escape' && cancelEditing()}
+                              disabled={isBusy}
+                              required
+                              className="flex-1 min-w-[12rem] px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                            />
+                            <button
+                              type="submit"
+                              disabled={isBusy}
+                              className="py-1.5 px-3 text-sm font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+                            >
+                              {isBusy ? 'Saving…' : 'Save'}
+                            </button>
+                            <button
+                              type="button"
+                              onClick={cancelEditing}
+                              disabled={isBusy}
+                              className="py-1.5 px-3 text-sm font-medium rounded-md text-gray-700 border border-gray-300 hover:bg-gray-50"
+                            >
+                              Cancel
+                            </button>
+                          </form>
+                        ) : (
+                          <p className="font-semibold text-gray-900 truncate" title={passkey.name}>
+                            {passkey.name}
+                          </p>
+                        )}
+                        <p className="mt-1 text-xs text-gray-500">
+                          {passkey.backedUp ? 'Synced passkey' : 'Device-bound passkey'}
+                          {' · '}Created {formatDate(passkey.createdAt)}
+                          {' · '}
+                          {passkey.lastUsedAt ? `Last used ${formatDate(passkey.lastUsedAt)}` : 'Never used to sign in'}
+                        </p>
+                      </div>
+                    </div>
+
+                    {!isEditing && !isConfirming && (
+                      <div className="flex gap-2 shrink-0">
+                        <button
+                          type="button"
+                          onClick={() => startEditing(passkey)}
+                          disabled={isBusy}
+                          className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium rounded-md text-gray-700 border border-gray-300 hover:bg-gray-50"
+                          aria-label={`Rename ${passkey.name}`}
+                        >
+                          <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                          Rename
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            cancelEditing();
+                            setConfirmDeleteId(passkey.id);
+                          }}
+                          disabled={isBusy}
+                          className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium rounded-md text-red-700 border border-red-200 hover:bg-red-50"
+                          aria-label={`Remove ${passkey.name}`}
+                        >
+                          <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                          Remove
+                        </button>
+                      </div>
+                    )}
+                  </div>
+
+                  {isConfirming && (
+                    <div
+                      className="mt-3 p-3 rounded-md bg-red-50 border border-red-200 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
+                      role="alertdialog"
+                      aria-label={`Confirm removing ${passkey.name}`}
+                    >
+                      <p className="text-sm text-red-800">
+                        Remove “{passkey.name}”? You won’t be able to sign in with it anymore.
+                      </p>
+                      <div className="flex gap-2 shrink-0">
+                        <button
+                          type="button"
+                          onClick={() => setConfirmDeleteId(null)}
+                          disabled={isBusy}
+                          className="py-1.5 px-3 text-sm font-medium rounded-md text-gray-700 bg-white border border-gray-300 hover:bg-gray-50"
+                        >
+                          Cancel
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => handleDelete(passkey)}
+                          disabled={isBusy}
+                          className="py-1.5 px-3 text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 disabled:opacity-60"
+                        >
+                          {isBusy ? 'Removing…' : 'Remove passkey'}
+                        </button>
+                      </div>
+                    </div>
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        ) : null}
+
+        <p className="text-xs text-gray-500">
+          {signalSupported
+            ? 'Changes here are shared with your browser so removed passkeys stop appearing when you sign in.'
+            : 'Your browser can’t sync passkey changes automatically. After removing a passkey, also delete it from your device’s password manager.'}
+        </p>
+      </div>
+    </section>
+  );
+}
