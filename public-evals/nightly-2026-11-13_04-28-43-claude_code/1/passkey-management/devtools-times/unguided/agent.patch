+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json, unauthorized } from '../../../lib/auth';
+import { getWebAuthnUserID, listPasskeys } from '../../../lib/passkeyStore';
+import { toSummary } from '../../../lib/passkeyView';
+import { getRelyingParty } from '../../../lib/webauthn';
+
+/**
+ * Lists the signed-in reader's passkeys along with the identifiers the browser
+ * needs to signal the current state to its authenticators.
+ */
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const { rpID } = getRelyingParty(url);
+  const [userID, passkeys] = await Promise.all([
+    getWebAuthnUserID(user.username),
+    listPasskeys(user.username),
+  ]);
+
+  return json({
+    rpID,
+    userID,
+    username: user.username,
+    passkeys: passkeys.map(toSummary),
+  });
+};
