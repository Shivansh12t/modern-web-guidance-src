@@ -0,0 +1,24 @@
+import type { StoredPasskey } from './passkeyStore';
+
+/** Shape of a passkey as exposed to the browser (no public key material). */
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  backedUp: boolean;
+  deviceType: 'singleDevice' | 'multiDevice';
+  transports: string[];
+}
+
+export function toSummary(p: StoredPasskey): PasskeySummary {
+  return {
+    id: p.id,
+    name: p.name,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+    backedUp: p.backedUp,
+    deviceType: p.deviceType,
+    transports: p.transports ?? [],
+  };
+}
diff --git a/src/lib/webauthn.ts b/src/lib/webauthn.ts
new file mode 100644
index 0000000..b21333e
--- /dev/null
+++ b/src/lib/webauthn.ts
@@ -0,0 +1,21 @@
+/** Relying-party settings derived from the request so the app works on any host it is served from. */
+export const RP_NAME = 'The DevTools Times';
+
+export function getRelyingParty(url: URL) {
+  return {
+    rpName: RP_NAME,
+    rpID: url.hostname,
+    origin: url.origin,
+  };
+}
+
+const MAX_NAME_LENGTH = 64;
+
+export function sanitizePasskeyName(raw: unknown): string | null {
+  if (typeof raw !== 'string') return null;
+  const name = raw.replace(/\s+/g, ' ').trim();
+  if (!name || name.length > MAX_NAME_LENGTH) return null;
+  return name;
+}
+
+export { MAX_NAME_LENGTH };
