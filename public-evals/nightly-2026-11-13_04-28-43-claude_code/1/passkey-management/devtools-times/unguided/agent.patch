diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..3058f11
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,22 @@
+import type { APIContext } from 'astro';
+
+type Session = APIContext['session'];
+
+export interface SessionUser {
+  username: string;
+}
+
+export async function getSessionUser(session: Session): Promise<SessionUser | null> {
+  if (!session) return null;
+  const user = await session.get('user');
+  return user && typeof user.username === 'string' ? { username: user.username } : null;
+}
+
+export function json(body: unknown, init: ResponseInit = {}): Response {
+  return new Response(JSON.stringify(body), {
+    ...init,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...init.headers },
+  });
+}
+
+export const unauthorized = () => json({ error: 'You need to sign in first.' }, { status: 401 });
diff --git a/src/lib/passkeyStore.ts b/src/lib/passkeyStore.ts
new file mode 100644
index 0000000..ab110d6
--- /dev/null
+++ b/src/lib/passkeyStore.ts
@@ -0,0 +1,115 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { AuthenticatorTransportFuture, CredentialDeviceType } from '@simplewebauthn/server';
+
+/**
+ * A passkey registered to a reader's account. Binary values are stored as
+ * base64url strings so the record can be serialised to JSON.
+ */
+export interface StoredPasskey {
+  /** base64url credential ID */
+  id: string;
+  /** base64url COSE public key */
+  publicKey: string;
+  counter: number;
+  transports?: AuthenticatorTransportFuture[];
+  deviceType: CredentialDeviceType;
+  backedUp: boolean;
+  aaguid: string;
+  /** Reader-editable label shown in account settings */
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface StoredUser {
+  /** base64url WebAuthn user handle (stable per account, never the username) */
+  webauthnUserID: string;
+  passkeys: StoredPasskey[];
+}
+
+type StoreShape = Record<string, StoredUser>;
+
+const STORE_DIR = process.env.PASSKEY_STORE_DIR ?? path.join(process.cwd(), '.data');
+const STORE_FILE = path.join(STORE_DIR, 'passkeys.json');
+
+let cache: StoreShape | null = null;
+// Serialise writes so concurrent requests don't clobber each other.
+let writeChain: Promise<void> = Promise.resolve();
+
+async function load(): Promise<StoreShape> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await fs.readFile(STORE_FILE, 'utf8')) as StoreShape;
+  } catch {
+    cache = {};
+  }
+  return cache;
+}
+
+function persist(): Promise<void> {
+  const snapshot = JSON.stringify(cache ?? {}, null, 2);
+  writeChain = writeChain
+    .catch(() => {})
+    .then(async () => {
+      await fs.mkdir(STORE_DIR, { recursive: true });
+      const tmp = `${STORE_FILE}.${process.pid}.tmp`;
+      await fs.writeFile(tmp, snapshot, 'utf8');
+      await fs.rename(tmp, STORE_FILE);
+    });
+  return writeChain;
+}
+
+async function getOrCreateUser(username: string): Promise<StoredUser> {
+  const store = await load();
+  let user = store[username];
+  if (!user) {
+    user = { webauthnUserID: randomBytes(32).toString('base64url'), passkeys: [] };
+    store[username] = user;
+    await persist();
+  }
+  return user;
+}
+
+export async function getWebAuthnUserID(username: string): Promise<string> {
+  return (await getOrCreateUser(username)).webauthnUserID;
+}
+
+export async function listPasskeys(username: string): Promise<StoredPasskey[]> {
+  const store = await load();
+  return [...(store[username]?.passkeys ?? [])];
+}
+
+export async function addPasskey(username: string, passkey: StoredPasskey): Promise<void> {
+  const user = await getOrCreateUser(username);
+  if (user.passkeys.some((p) => p.id === passkey.id)) {
+    throw new Error('This passkey is already registered.');
+  }
+  user.passkeys.push(passkey);
+  await persist();
+}
+
+export async function renamePasskey(
+  username: string,
+  id: string,
+  name: string,
+): Promise<StoredPasskey | null> {
+  const store = await load();
+  const passkey = store[username]?.passkeys.find((p) => p.id === id);
+  if (!passkey) return null;
+  passkey.name = name;
+  await persist();
+  return passkey;
+}
+
+export async function deletePasskey(username: string, id: string): Promise<boolean> {
+  const store = await load();
+  const user = store[username];
+  if (!user) return false;
+  const before = user.passkeys.length;
+  user.passkeys = user.passkeys.filter((p) => p.id !== id);
+  if (user.passkeys.length === before) return false;
+  await persist();
+  return true;
+}
