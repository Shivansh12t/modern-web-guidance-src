+import type { APIRoute } from 'astro';
+import { getSessionUser, isJsonRequest, json, unauthorized } from '../../../lib/auth';
+import { MAX_NAME_LENGTH, cleanName, getRpId, updateAccountDisplayName } from '../../../lib/passkeys';
+
+/** Updates the reader's display name and returns what the client needs for signalCurrentUserDetails(). */
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+  if (!isJsonRequest(request)) return json({ error: 'Unsupported content type' }, 415);
+
+  const body = await request.json().catch(() => ({}));
+  const displayName = cleanName(body.displayName);
+  if (!displayName) return json({ error: `Display name must be 1–${MAX_NAME_LENGTH} characters.` }, 400);
+
+  const account = updateAccountDisplayName(user.username, displayName);
+  return json({
+    name: account.name,
+    displayName: account.displayName,
+    rpId: getRpId(url),
+    userId: account.passkeyUserId,
+  });
+};
diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
