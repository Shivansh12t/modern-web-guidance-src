+---
+import Layout from '../layouts/Layout.astro';
+import AccountProfile from '../components/AccountProfile';
+import PasskeyManager from '../components/PasskeyManager';
+import { getSessionUser } from '../lib/auth';
+import { MAX_NAME_LENGTH, getOrCreateAccount, getRpId, listCredentials } from '../lib/passkeys';
+
+const user = await getSessionUser(Astro.session);
+if (!user) {
+  return Astro.redirect(`${import.meta.env.BASE_URL}signin`);
+}
+
+Astro.response.headers.set('Cache-Control', 'no-store');
+
+const account = getOrCreateAccount(user.username);
+const passkeyData = {
+  rpId: getRpId(Astro.url),
+  userId: account.passkeyUserId,
+  credentials: listCredentials(account),
+};
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <div class="max-w-3xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-6">
+    <div class="flex flex-wrap items-center justify-between gap-4">
+      <h1 class="text-3xl font-bold text-gray-900">Account settings</h1>
+      <form method="post" action={`${import.meta.env.BASE_URL}api/auth/logout`}>
+        <button
+          type="submit"
+          class="rounded border border-gray-300 px-3 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50"
+        >
+          Sign out
+        </button>
+      </form>
+    </div>
+
+    <AccountProfile
+      client:load
+      username={account.name}
+      initialDisplayName={account.displayName}
+      maxNameLength={MAX_NAME_LENGTH}
+    />
+
+    <PasskeyManager client:load initialData={passkeyData} maxNameLength={MAX_NAME_LENGTH} />
+  </div>
+</Layout>
