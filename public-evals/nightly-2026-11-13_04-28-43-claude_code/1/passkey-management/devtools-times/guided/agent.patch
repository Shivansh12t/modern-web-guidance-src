+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,278 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { signalAcceptedCredentials } from '../lib/webauthn-signals';
+import type { PasskeyView } from '../lib/passkeys';
+
+export interface PasskeyListData {
+  rpId: string;
+  userId: string;
+  credentials: PasskeyView[];
+}
+
+interface Props {
+  initialData: PasskeyListData;
+  maxNameLength: number;
+}
+
+const API = `${import.meta.env.BASE_URL}api/account/passkeys`;
+
+const dateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
+const utcDateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
+
+async function readError(response: Response, fallback: string) {
+  const data = await response.json().catch(() => ({}));
+  return typeof data.error === 'string' ? data.error : fallback;
+}
+
+export default function PasskeyManager({ initialData, maxNameLength }: Props) {
+  const [data, setData] = useState(initialData);
+  const [hydrated, setHydrated] = useState(false);
+  const [status, setStatus] = useState<{ kind: 'success' | 'error'; text: string } | null>(null);
+  const [target, setTarget] = useState<PasskeyView | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [dialogError, setDialogError] = useState<string | null>(null);
+
+  const renameDialog = useRef<HTMLDialogElement>(null);
+  const deleteDialog = useRef<HTMLDialogElement>(null);
+  const ids = useId();
+
+  // On mount, tell the authenticator which passkeys the server still accepts,
+  // so keys removed elsewhere (e.g. another device) stop being offered.
+  useEffect(() => {
+    setHydrated(true);
+    void signalAcceptedCredentials(initialData.rpId, initialData.userId, initialData.credentials.map((c) => c.id));
+  }, [initialData]);
+
+  // Dates are rendered in UTC on the server, then in the reader's own time zone once hydrated.
+  const formatDate = (epoch: number) => (hydrated ? dateFormatter : utcDateFormatter).format(epoch);
+
+  async function refresh(): Promise<PasskeyListData | null> {
+    const response = await fetch(API, { headers: { Accept: 'application/json' } });
+    if (!response.ok) return null;
+    const next: PasskeyListData = await response.json();
+    setData(next);
+    return next;
+  }
+
+  function openRename(cred: PasskeyView) {
+    setTarget(cred);
+    setRenameValue(cred.name);
+    setDialogError(null);
+    renameDialog.current?.showModal();
+  }
+
+  function openDelete(cred: PasskeyView) {
+    setTarget(cred);
+    setDialogError(null);
+    deleteDialog.current?.showModal();
+  }
+
+  async function submitRename(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    if (!target) return;
+    setBusy(true);
+    setDialogError(null);
+    try {
+      const response = await fetch(`${API}/${encodeURIComponent(target.id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: renameValue }),
+      });
+      if (!response.ok) {
+        setDialogError(await readError(response, 'Could not rename this passkey.'));
+        return;
+      }
+      // A passkey nickname is a server-side label only, so no Signal API call is needed here.
+      const { name } = await response.json();
+      setData((prev) => ({
+        ...prev,
+        credentials: prev.credentials.map((c) => (c.id === target.id ? { ...c, name } : c)),
+      }));
+      setStatus({ kind: 'success', text: `Passkey renamed to “${name}”.` });
+      renameDialog.current?.close();
+    } catch {
+      setDialogError('Network error. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function confirmDelete() {
+    if (!target) return;
+    setBusy(true);
+    setDialogError(null);
+    try {
+      const response = await fetch(`${API}/${encodeURIComponent(target.id)}`, { method: 'DELETE' });
+      if (!response.ok && response.status !== 404) {
+        setDialogError(await readError(response, 'Could not remove this passkey.'));
+        return;
+      }
+      const next = (await refresh()) ?? {
+        ...data,
+        credentials: data.credentials.filter((c) => c.id !== target.id),
+      };
+      setData(next);
+      setStatus({ kind: 'success', text: `“${target.name}” was removed from your account.` });
+      deleteDialog.current?.close();
+      // Sync the remaining credential IDs so the authenticator hides the removed passkey.
+      await signalAcceptedCredentials(next.rpId, next.userId, next.credentials.map((c) => c.id));
+    } catch {
+      setDialogError('Network error. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const renameTitleId = `${ids}-rename-title`;
+  const renameInputId = `${ids}-rename-input`;
+  const renameErrorId = `${ids}-rename-error`;
+  const deleteTitleId = `${ids}-delete-title`;
+  const deleteDescId = `${ids}-delete-desc`;
+
+  return (
+    <section aria-labelledby={`${ids}-heading`} className="bg-white border border-gray-200 rounded-lg p-6">
+      <h2 id={`${ids}-heading`} className="text-xl font-bold text-gray-900">Passkeys</h2>
+      <p className="mt-1 text-sm text-gray-600">
+        Passkeys let you sign in with your fingerprint, face, screen lock or a security key. Rename them so they're
+        easy to recognise, and remove any you no longer use — we'll ask your browser to forget removed keys too.
+      </p>
+
+      <p role="status" aria-live="polite" className="min-h-6 mt-3 text-sm">
+        {status && (
+          <span className={status.kind === 'success' ? 'text-green-700' : 'text-red-700'}>{status.text}</span>
+        )}
+      </p>
+
+      {data.credentials.length === 0 ? (
+        <p className="mt-2 p-4 text-sm text-gray-600 bg-gray-50 border border-dashed border-gray-300 rounded-md">
+          No passkeys found for your account.
+        </p>
+      ) : (
+        <ul className="mt-2 divide-y divide-gray-200 border border-gray-200 rounded-md">
+          {data.credentials.map((cred) => (
+            <li key={cred.id} className="flex flex-wrap items-center gap-4 p-4">
+              <span className="flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700">
+                <KeyIcon className="size-5" aria-hidden="true" />
+              </span>
+              <div className="min-w-0 flex-1">
+                <p className="font-semibold text-gray-900 break-words">{cred.name}</p>
+                {cred.name !== cred.providerName && <p className="text-xs text-gray-500">{cred.providerName}</p>}
+                <p className="mt-1 text-xs text-gray-600">
+                  Added <time dateTime={new Date(cred.registeredAt).toISOString()}>{formatDate(cred.registeredAt)}</time>
+                  {' · '}
+                  {cred.lastUsedAt ? (
+                    <>
+                      Last used{' '}
+                      <time dateTime={new Date(cred.lastUsedAt).toISOString()}>{formatDate(cred.lastUsedAt)}</time>
+                    </>
+                  ) : (
+                    'Never used'
+                  )}
+                </p>
+              </div>
+              <div className="flex gap-2">
+                <button
+                  type="button"
+                  onClick={() => openRename(cred)}
+                  className="inline-flex items-center gap-1 rounded border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-800 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900"
+                >
+                  <PencilSquareIcon className="size-4" aria-hidden="true" />
+                  Rename<span className="sr-only"> {cred.name}</span>
+                </button>
+                <button
+                  type="button"
+                  onClick={() => openDelete(cred)}
+                  className="inline-flex items-center gap-1 rounded border border-red-300 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-700"
+                >
+                  <TrashIcon className="size-4" aria-hidden="true" />
+                  Remove<span className="sr-only"> {cred.name}</span>
+                </button>
+              </div>
+            </li>
+          ))}
+        </ul>
+      )}
+
+      <dialog
+        ref={renameDialog}
+        aria-labelledby={renameTitleId}
+        className="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-lg p-6 shadow-xl"
+      >
+        <h3 id={renameTitleId} className="text-lg font-bold text-gray-900">Rename passkey</h3>
+        <form onSubmit={submitRename} className="mt-4 space-y-4">
+          <div>
+            <label htmlFor={renameInputId} className="block text-sm font-medium text-gray-700 mb-1">
+              Passkey name
+            </label>
+            <input
+              id={renameInputId}
+              type="text"
+              value={renameValue}
+              onChange={(e) => setRenameValue(e.target.value)}
+              required
+              maxLength={maxNameLength}
+              autoComplete="off"
+              autoFocus
+              aria-invalid={dialogError ? true : undefined}
+              aria-describedby={dialogError ? renameErrorId : undefined}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            {dialogError && (
+              <p id={renameErrorId} className="mt-1 text-sm text-red-700">{dialogError}</p>
+            )}
+          </div>
+          <div className="flex justify-end gap-2">
+            <button
+              type="button"
+              onClick={() => renameDialog.current?.close()}
+              className="rounded border border-gray-300 px-4 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50"
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={busy}
+              className="rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-75"
+            >
+              {busy ? 'Saving…' : 'Save'}
+            </button>
+          </div>
+        </form>
+      </dialog>
+
+      <dialog
+        ref={deleteDialog}
+        aria-labelledby={deleteTitleId}
+        aria-describedby={deleteDescId}
+        className="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-lg p-6 shadow-xl"
+      >
+        <h3 id={deleteTitleId} className="text-lg font-bold text-gray-900">Remove “{target?.name}”?</h3>
+        <p id={deleteDescId} className="mt-2 text-sm text-gray-600">
+          You won't be able to sign in to The DevTools Times with this passkey anymore. Supported browsers and password
+          managers will also be asked to remove it.
+        </p>
+        {dialogError && <p role="alert" className="mt-3 text-sm text-red-700">{dialogError}</p>}
+        <div className="mt-6 flex justify-end gap-2">
+          <form method="dialog">
+            <button
+              value="cancel"
+              autoFocus
+              className="rounded border border-gray-300 px-4 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50"
+            >
+              Keep passkey
+            </button>
+          </form>
+          <button
+            type="button"
+            onClick={confirmDelete}
+            disabled={busy}
+            className="rounded bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 disabled:opacity-75"
+          >
+            {busy ? 'Removing…' : 'Remove passkey'}
+          </button>
+        </div>
+      </dialog>
+    </section>
+  );
+}
