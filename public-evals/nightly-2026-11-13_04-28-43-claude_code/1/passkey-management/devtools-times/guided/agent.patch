new file mode 100644
index 0000000..d6bdb64
--- /dev/null
+++ b/src/pages/api/account/passkeys/[id].ts
@@ -0,0 +1,36 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, isJsonRequest, json, unauthorized } from '../../../../lib/auth';
+import {
+  MAX_NAME_LENGTH,
+  cleanName,
+  deleteCredential,
+  getOrCreateAccount,
+  renameCredential,
+} from '../../../../lib/passkeys';
+
+const notFound = () => json({ error: 'Passkey not found.' }, 404);
+
+/** Renames a passkey. This is a server-side label only; no Signal API call is needed. */
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+  if (!isJsonRequest(request)) return json({ error: 'Unsupported content type' }, 415);
+
+  const body = await request.json().catch(() => ({}));
+  const name = cleanName(body.name);
+  if (!name) return json({ error: `Name must be 1–${MAX_NAME_LENGTH} characters.` }, 400);
+
+  const account = getOrCreateAccount(user.username);
+  if (!params.id || !renameCredential(account, params.id, name)) return notFound();
+  return json({ id: params.id, name });
+};
+
+/** Removes a passkey. The client then syncs the remaining IDs via signalAllAcceptedCredentials(). */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const account = getOrCreateAccount(user.username);
+  if (!params.id || !deleteCredential(account, params.id)) return notFound();
+  return json({ success: true });
+};
