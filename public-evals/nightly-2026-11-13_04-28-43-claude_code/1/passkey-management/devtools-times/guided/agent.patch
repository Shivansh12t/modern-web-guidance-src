--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { isJsonRequest, json } from '../../../lib/auth';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Proxies sign-in to the upstream auth service so a successful login can be
+ * recorded in the server-side session (needed for account settings).
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!isJsonRequest(request)) return json({ error: 'Unsupported content type' }, 415);
+
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Sign-in service unavailable' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json({ error: data.error || 'Unknown error' }, upstream.status);
+  }
+
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await session?.regenerate();
+  session?.set('user', { username: username.trim() });
+  return json({ ...data, username: username.trim() });
+};
