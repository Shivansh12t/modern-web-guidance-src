diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..cf0d353
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,33 @@
+export interface SessionUser {
+  username: string;
+}
+
+type Session = { get(key: string): Promise<any>; set(key: string, value: unknown): void | Promise<void> } | undefined;
+
+/** Returns the signed-in reader stored in the Astro session, or null. */
+export async function getSessionUser(session: Session): Promise<SessionUser | null> {
+  const user = await session?.get('user');
+  if (user && typeof user.username === 'string' && user.username.length > 0) {
+    return { username: user.username };
+  }
+  return null;
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function unauthorized(): Response {
+  return json({ error: 'You need to sign in to manage your account.' }, 401);
+}
+
+/**
+ * Mutating account endpoints only accept JSON bodies, which forces a CORS
+ * preflight for cross-site requests (the app runs with checkOrigin disabled).
+ */
+export function isJsonRequest(request: Request): boolean {
+  return (request.headers.get('content-type') ?? '').toLowerCase().startsWith('application/json');
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..6309cfb
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,159 @@
+import { randomBytes } from 'node:crypto';
+
+/**
+ * Server-side passkey store for signed-in readers.
+ *
+ * This is an in-memory store (kept on globalThis so it survives dev HMR). Swap
+ * it for a database in production; the API routes only depend on the
+ * functions exported here.
+ *
+ * All credential IDs and passkey user IDs are unpadded Base64URL strings, as
+ * required by WebAuthn and the Signal API.
+ */
+
+export interface StoredPasskeyCredential {
+  /** Base64URL credential ID. */
+  id: string;
+  /** Base64URL user handle the passkey was registered with. */
+  passkeyUserId: string;
+  /** Custom nickname, defaulting to the provider name. */
+  name: string;
+  aaguid: string;
+  transports: string[];
+  /** Epoch milliseconds. */
+  registeredAt: number;
+  /** Epoch milliseconds. */
+  lastUsedAt?: number;
+}
+
+export interface PasskeyAccount {
+  /** Username (WebAuthn `user.name`). */
+  name: string;
+  /** Human-friendly name (WebAuthn `user.displayName`). */
+  displayName: string;
+  /** Base64URL WebAuthn user handle. */
+  passkeyUserId: string;
+}
+
+/** Public shape returned to the client. */
+export interface PasskeyView extends Omit<StoredPasskeyCredential, 'passkeyUserId'> {
+  providerName: string;
+}
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+/**
+ * Subset of the community AAGUID registry
+ * (github.com/passkeydeveloper/passkey-authenticator-aaguids), used for UX
+ * hints only — never for security decisions.
+ */
+export const AAGUID_PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey 5 Series',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+};
+
+export function providerNameFor(aaguid: string): string {
+  if (aaguid === ZERO_AAGUID) return 'Unknown passkey provider';
+  return AAGUID_PROVIDERS[aaguid] ?? 'Unknown passkey provider';
+}
+
+export const MAX_NAME_LENGTH = 64;
+
+interface Store {
+  accounts: Map<string, PasskeyAccount>;
+  credentials: Map<string, StoredPasskeyCredential>;
+}
+
+const globalStore = globalThis as typeof globalThis & { __devtoolsTimesPasskeys?: Store };
+const store: Store = (globalStore.__devtoolsTimesPasskeys ??= {
+  accounts: new Map(),
+  credentials: new Map(),
+});
+
+function newBase64UrlId(bytes = 16): string {
+  return randomBytes(bytes).toString('base64url');
+}
+
+const DAY = 24 * 60 * 60 * 1000;
+
+/** Seeds demo passkeys so a newly signed-in reader has something to manage. */
+function seedCredentials(account: PasskeyAccount) {
+  const now = Date.now();
+  const seeds: Array<Pick<StoredPasskeyCredential, 'aaguid' | 'transports' | 'registeredAt' | 'lastUsedAt'>> = [
+    { aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', transports: ['internal', 'hybrid'], registeredAt: now - 140 * DAY, lastUsedAt: now - 2 * DAY },
+    { aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', transports: ['internal', 'hybrid'], registeredAt: now - 60 * DAY, lastUsedAt: now - 21 * DAY },
+    { aaguid: 'cb69481e-8ff7-4039-93ec-0a2729a154a8', transports: ['usb', 'nfc'], registeredAt: now - 400 * DAY },
+  ];
+  for (const seed of seeds) {
+    const id = newBase64UrlId();
+    store.credentials.set(id, {
+      id,
+      passkeyUserId: account.passkeyUserId,
+      name: providerNameFor(seed.aaguid),
+      ...seed,
+    });
+  }
+}
+
+export function getOrCreateAccount(username: string): PasskeyAccount {
+  let account = store.accounts.get(username);
+  if (!account) {
+    account = { name: username, displayName: username, passkeyUserId: newBase64UrlId() };
+    store.accounts.set(username, account);
+    seedCredentials(account);
+  }
+  return account;
+}
+
+export function updateAccountDisplayName(username: string, displayName: string): PasskeyAccount {
+  const account = getOrCreateAccount(username);
+  account.displayName = displayName;
+  return account;
+}
+
+export function listCredentials(account: PasskeyAccount): PasskeyView[] {
+  return [...store.credentials.values()]
+    .filter((cred) => cred.passkeyUserId === account.passkeyUserId)
+    .sort((a, b) => b.registeredAt - a.registeredAt)
+    .map(({ passkeyUserId: _omit, ...cred }) => ({ ...cred, providerName: providerNameFor(cred.aaguid) }));
+}
+
+/** Returns the credential only if it belongs to the given account. */
+function findOwnedCredential(account: PasskeyAccount, id: string) {
+  const cred = store.credentials.get(id);
+  return cred && cred.passkeyUserId === account.passkeyUserId ? cred : undefined;
+}
+
+export function renameCredential(account: PasskeyAccount, id: string, name: string): boolean {
+  const cred = findOwnedCredential(account, id);
+  if (!cred) return false;
+  cred.name = name;
+  return true;
+}
+
+export function deleteCredential(account: PasskeyAccount, id: string): boolean {
+  if (!findOwnedCredential(account, id)) return false;
+  return store.credentials.delete(id);
+}
+
+/** Normalises and validates a user-supplied label. Returns null when invalid. */
+export function cleanName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const name = value.replace(/\s+/g, ' ').trim();
+  if (name.length === 0 || name.length > MAX_NAME_LENGTH) return null;
+  return name;
+}
+
+/**
+ * The RP ID passkeys are registered under. Configure PASSKEY_RP_ID in
+ * production; otherwise fall back to the host serving the request. The client
+ * always uses this server-provided value for Signal API calls.
+ */
+export function getRpId(requestUrl: URL): string {
+  return process.env.PASSKEY_RP_ID || requestUrl.hostname;
+}
diff --git a/src/lib/webauthn-signals.ts b/src/lib/webauthn-signals.ts
new file mode 100644
index 0000000..1de076e
--- /dev/null
+++ b/src/lib/webauthn-signals.ts
@@ -0,0 +1,41 @@
+/**
+ * Client-side WebAuthn Signal API helpers. These keep the reader's password
+ * manager / browser authenticator in sync with the server's passkey records.
+ *
+ * Signal calls are a progressive enhancement (unsupported in some browsers),
+ * so they are feature-detected and failures are logged as warnings only.
+ */
+
+/** Valid unpadded Base64URL: [A-Za-z0-9_-], no '=' padding, length % 4 !== 1. */
+export function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+/** Tells the authenticator which credentials are still valid so removed passkeys disappear. */
+export async function signalAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and Base64URL IDs are required.');
+    return;
+  }
+  try {
+    // Always use the server-provided rpId, never window.location.hostname.
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+/** Updates the username/display name shown for this account in the authenticator. */
+export async function signalUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
