@@ -0,0 +1,16 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json, unauthorized } from '../../../lib/auth';
+import { getOrCreateAccount, getRpId, listCredentials } from '../../../lib/passkeys';
+
+/** Lists the signed-in reader's passkeys plus the rpId/userId used for Signal API sync. */
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return unauthorized();
+
+  const account = getOrCreateAccount(user.username);
+  return json({
+    rpId: getRpId(url),
+    userId: account.passkeyUserId,
+    credentials: listCredentials(account),
+  });
+};
