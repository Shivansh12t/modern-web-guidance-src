@@ -0,0 +1,80 @@
+import React, { useId, useState } from 'react';
+import { signalUserDetails } from '../lib/webauthn-signals';
+
+interface Props {
+  username: string;
+  initialDisplayName: string;
+  maxNameLength: number;
+}
+
+export default function AccountProfile({ username, initialDisplayName, maxNameLength }: Props) {
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [saving, setSaving] = useState(false);
+  const [status, setStatus] = useState<{ kind: 'success' | 'error'; text: string } | null>(null);
+  const ids = useId();
+
+  async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    setSaving(true);
+    setStatus(null);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/account/profile`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName }),
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok) {
+        setStatus({ kind: 'error', text: data.error || 'Could not update your display name.' });
+        return;
+      }
+      setDisplayName(data.displayName);
+      setStatus({ kind: 'success', text: 'Display name updated.' });
+      // Keep the name shown in the reader's passkey provider in sync.
+      await signalUserDetails(data.rpId, data.userId, data.name, data.displayName);
+    } catch {
+      setStatus({ kind: 'error', text: 'Network error. Please try again.' });
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <section aria-labelledby={`${ids}-heading`} className="bg-white border border-gray-200 rounded-lg p-6">
+      <h2 id={`${ids}-heading`} className="text-xl font-bold text-gray-900">Profile</h2>
+      <p className="mt-1 text-sm text-gray-600">
+        Signed in as <strong>{username}</strong>. Your display name is also shown next to your passkeys in supported
+        browsers and password managers.
+      </p>
+      <form onSubmit={handleSubmit} className="mt-4 flex flex-wrap items-end gap-3">
+        <div className="flex-1 min-w-56">
+          <label htmlFor={`${ids}-display-name`} className="block text-sm font-medium text-gray-700 mb-1">
+            Display name
+          </label>
+          <input
+            id={`${ids}-display-name`}
+            type="text"
+            value={displayName}
+            onChange={(e) => setDisplayName(e.target.value)}
+            required
+            maxLength={maxNameLength}
+            autoComplete="name"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+        </div>
+        <button
+          type="submit"
+          disabled={saving}
+          className="rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-75"
+        >
+          {saving ? 'Saving…' : 'Save'}
+        </button>
+      </form>
+      <p role="status" aria-live="polite" className="min-h-6 mt-2 text-sm">
+        {status && (
+          <span className={status.kind === 'success' ? 'text-green-700' : 'text-red-700'}>{status.text}</span>
+        )}
+      </p>
+    </section>
+  );
+}
