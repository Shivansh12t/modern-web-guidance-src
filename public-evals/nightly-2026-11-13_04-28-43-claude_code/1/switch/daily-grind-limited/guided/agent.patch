+  <script>
+    {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById("dark-theme");
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const read = () => {
+        try { return localStorage.getItem("color-scheme"); } catch { return null; }
+      };
+      const isDark = () => {
+        const stored = meta.content;
+        return stored === "dark" || (stored !== "light" && systemDark.matches);
+      };
+      const sync = () => { toggle.checked = isDark(); };
+
+      toggle.addEventListener("change", () => {
+        const target = toggle.checked ? "dark" : "light";
+        const system = systemDark.matches ? "dark" : "light";
+        // Matching the system preference means "undo my override".
+        const stored = target === system ? null : target;
+        try {
+          stored ? localStorage.setItem("color-scheme", stored) : localStorage.removeItem("color-scheme");
+        } catch {}
+        meta.content = stored ?? "light dark";
+      });
+
+      // Keep in sync with system changes and other tabs.
+      systemDark.addEventListener("change", sync);
+      addEventListener("storage", (e) => {
+        if (e.key === "color-scheme" || e.key === null) {
+          meta.content = read() ?? "light dark";
+          sync();
+        }
+      });
+
+      sync();
+    }
+  </script>
+
