+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://esm.sh/input-switch-polyfill').catch(() => {});
+    }
+
+    const meta = document.querySelector('meta[name="color-scheme"]');
+    const toggle = document.getElementById('dark-mode-switch');
+    const systemDark = matchMedia('(prefers-color-scheme: dark)');
+    const KEY = 'color-scheme';
+
+    const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
+
+    function apply(stored) {
+      meta.content = stored ?? 'light dark';
+      toggle.checked = (stored ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';
+    }
+
+    toggle.addEventListener('change', () => {
+      const target = toggle.checked ? 'dark' : 'light';
+      const system = systemDark.matches ? 'dark' : 'light';
+      // Matching the system preference means undoing the override: clear it.
+      const stored = target === system ? null : target;
+      try {
+        stored ? localStorage.setItem(KEY, stored) : localStorage.removeItem(KEY);
+      } catch {}
+      meta.content = stored ?? 'light dark';
+    });
+
+    // Keep the switch in sync with system changes (when no override) and other tabs.
+    systemDark.addEventListener('change', () => apply(read()));
+    addEventListener('storage', (e) => { if (e.key === KEY || e.key === null) apply(read()); });
+
+    apply(read());
+  </script>
+
