diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,52 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Scrollbar: roasted-brown thumb on a pale crema track (~6:1 contrast) */
+      --scrollbar-thumb: #6d4c41;
+      --scrollbar-track: #efebe9;
     }
 
+    /* Page scrollbar */
+    html {
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      /* Needed so macOS overlay scrollbars honor the custom colors */
+      scrollbar-width: thin;
+      scrollbar-gutter: stable;
+    }
+
+    /* Stark, high-contrast scrollbar when the user asks for more contrast */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-thumb: #000000;
+        --scrollbar-track: #ffffff;
+      }
+
+      html {
+        scrollbar-width: auto;
+      }
+    }
+
+    /* Legacy fallback for WebKit/Blink without scrollbar-color support */
+    @supports not (scrollbar-color: auto) {
+      ::-webkit-scrollbar {
+        width: 12px;
+        height: 12px;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 6px;
+        border: 2px solid var(--scrollbar-track);
+      }
+
+      ::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
