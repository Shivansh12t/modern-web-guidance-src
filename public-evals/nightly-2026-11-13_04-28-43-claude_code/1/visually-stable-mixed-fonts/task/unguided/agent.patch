diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,87 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>font-size-adjust demo</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+      font-family: Georgia, "Times New Roman", serif;
+      line-height: 1.6;
+    }
+
+    body {
+      max-width: 48rem;
+      margin: 3rem auto;
+      padding: 0 1.5rem;
+    }
+
+    section {
+      padding: 1.5rem;
+      margin-block: 1.5rem;
+      border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
+      border-radius: 0.75rem;
+    }
+
+    h2 {
+      margin-top: 0;
+      font-size: 1.1rem;
+    }
+
+    code {
+      font-family: "Courier New", Courier, monospace;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in srgb, currentColor 10%, transparent);
+    }
+
+    /*
+     * Mixed fonts: `from-font` reads the primary font's own x-height ratio
+     * and applies it to every fallback / inline font (e.g. the monospace
+     * <code>), so all glyphs share the same visual lowercase height.
+     */
+    #mixed-fonts-container {
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      /* Inherit the computed aspect value so code matches surrounding text. */
+      font-size-adjust: inherit;
+    }
+
+    /*
+     * Independent theme: lock proportions to an explicit numeric metric,
+     * so whatever font loads (or falls back), its x-height is 0.5 × font-size.
+     */
+    #independent-theme-container {
+      font-family: Verdana, "Trebuchet MS", sans-serif;
+      font-size-adjust: ex-height 0.5;
+      background: color-mix(in srgb, teal 12%, transparent);
+    }
+  </style>
+</head>
+<body>
+  <h1>Normalizing mixed fonts with <code>font-size-adjust</code></h1>
+
+  <section id="mixed-fonts-container">
+    <h2>Mixed font families</h2>
+    <p>
+      Serif body text sits next to inline code such as
+      <code>const total = items.reduce(sum, 0);</code> and
+      <code>font-size-adjust</code>, yet the lowercase letters line up at the
+      same visual height because the container uses
+      <code>font-size-adjust: from-font</code>.
+    </p>
+  </section>
+
+  <section id="independent-theme-container">
+    <h2>Independent theme</h2>
+    <p>
+      This block uses its own font stack and pins its proportions with
+      <code>font-size-adjust: ex-height 0.5</code>, so the x-height stays at
+      half the font size regardless of which font actually renders.
+    </p>
+  </section>
+</body>
+</html>
