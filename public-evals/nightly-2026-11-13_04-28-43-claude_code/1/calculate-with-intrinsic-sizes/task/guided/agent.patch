+      inline-size: 100%;
+      padding: 16px 20px;
+      background: none;
+      border: 0;
+      font: inherit;
+      color: var(--primary);
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+      border-radius: 8px;
+    }
+
+    /* Chevron next to the label: points to the inline end when closed, down when open */
+    #accordion-toggle::before {
+      content: "";
+      flex-shrink: 0;
+      inline-size: 0.6em;
+      block-size: 0.6em;
+      border-inline-end: 2px solid currentColor;
+      border-block-end: 2px solid currentColor;
+      rotate: -45deg;
+    }
+
+    #accordion-toggle:dir(rtl)::before {
+      rotate: 135deg;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::before {
+      rotate: 45deg;
+    }
+
+    /*
+      NOTE: Directly transitioning between two different intrinsic keyword sizes
+      (e.g. block-size: min-content -> max-content, or auto -> fit-content) is NOT
+      supported. One end of the transition must be a fixed length or percentage
+      (here 0), and calc-size() can only reference a single intrinsic keyword.
+    */
+    .accordion-content {
+      overflow: hidden;
+      block-size: 0;
+      /* Removes collapsed content from the accessibility tree and tab order;
+         transitioning visibility keeps it shown until the collapse finishes */
+      visibility: hidden;
+      transition: block-size 0.4s ease-in-out, visibility 0.4s;
+    }
+
+    .accordion-content.is-open {
+      /* Fallback for browsers without calc-size() */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      visibility: visible;
+    }
+
+    .accordion-content-inner {
+      padding-inline: 20px;
+    }
+
+    .accordion-content-inner p + p {
+      margin-block-start: 10px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      #accordion-toggle::before {
+        transition: rotate 0.2s;
+      }
+    }
+
+    /* Reduced motion: drop the size animation; jump the size and use a quick fade */
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        opacity: 0;
+        transition: opacity 0.2s ease, visibility 0.2s;
+      }
+
+      .accordion-content.is-open {
+        opacity: 1;
+      }
+    }
