diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,40 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Staggered entrance: each card starts 100ms after the previous one */
+    @keyframes card-enter {
+      from {
+        opacity: 0;
+        translate: 0 20px;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .grid > .card {
+        --stagger-time: 0.1s;
+        /* "both" holds the hidden first keyframe during each card's delay */
+        animation: card-enter 0.5s ease-out both;
+      }
+
+      /* Literal time in @supports (var() would make the check always pass) */
+      @supports (animation-delay: calc(sibling-index() * 0.1s)) {
+        .grid > .card {
+          animation-delay: calc((sibling-index() - 1) * var(--stagger-time));
+        }
+      }
+
+      /* Fallback for browsers without sibling-index() */
+      @supports not (animation-delay: calc(sibling-index() * 0.1s)) {
+        .grid > .card:nth-child(2) { animation-delay: 0.1s; }
+        .grid > .card:nth-child(3) { animation-delay: 0.2s; }
+        .grid > .card:nth-child(4) { animation-delay: 0.3s; }
+        .grid > .card:nth-child(5) { animation-delay: 0.4s; }
+        .grid > .card:nth-child(6) { animation-delay: 0.5s; }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
