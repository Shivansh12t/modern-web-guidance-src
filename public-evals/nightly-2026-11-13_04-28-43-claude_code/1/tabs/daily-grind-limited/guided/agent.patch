+  <script>
+    // Tabbed coffee menu: focusgroup="tablist" provides arrow-key navigation and roles.
+    // Selection follows focus; we keep panels, ARIA state and scroll position in sync.
+    {
+      const menu = document.getElementById('coffee-menu');
+      const tablist = menu.querySelector('.tablist');
+      const tabs = [...tablist.querySelectorAll('button')];
+      const panels = tabs.map(tab => menu.querySelector(`[aria-labelledby="${tab.id}"]`));
+
+      function select(selected) {
+        tabs.forEach((tab, i) => {
+          const isSelected = tab === selected;
+          tab.ariaSelected = String(isSelected);
+          tab.toggleAttribute('focusgroupstart', isSelected);
+          if (isSelected) {
+            panels[i].removeAttribute('hidden');
+          } else {
+            panels[i].hidden = 'until-found';
+          }
+        });
+        // Scroll only the tablist (not the page) so the selected tab, plus a peek of its neighbor, is visible.
+        selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+      }
+
+      tablist.addEventListener('click', e => {
+        const tab = e.target.closest('button');
+        if (tab) select(tab);
+      });
+
+      tablist.addEventListener('focusin', e => {
+        const tab = e.target.closest('button');
+        if (tab && tab.ariaSelected !== 'true') select(tab);
+      });
+
+      // Find-in-page revealed a hidden panel: select its tab.
+      panels.forEach((panel, i) => {
+        panel.addEventListener('beforematch', () => select(tabs[i]));
+      });
+    }
+  </script>
+
 </body>
 
