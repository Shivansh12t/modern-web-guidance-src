+  <script>
+    (function () {
+      var form = document.getElementById('contact-form');
+      var success = document.getElementById('contact-success');
+      var controls = form.querySelectorAll('input, textarea');
+
+      function validate(control) {
+        var invalid = !control.checkValidity();
+        control.closest('.field').classList.toggle('is-invalid', invalid);
+        control.setAttribute('aria-invalid', invalid ? 'true' : 'false');
+        return !invalid;
+      }
+
+      controls.forEach(function (control) {
+        // Mark as touched once the user leaves the field, then validate live.
+        control.addEventListener('blur', function () {
+          control.dataset.touched = 'true';
+          validate(control);
+        });
+        control.addEventListener('input', function () {
+          success.classList.remove('visible');
+          if (control.dataset.touched) validate(control);
+        });
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var firstInvalid = null;
+        controls.forEach(function (control) {
+          control.dataset.touched = 'true';
+          if (!validate(control) && !firstInvalid) firstInvalid = control;
+        });
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+        form.reset();
+        controls.forEach(function (control) {
+          delete control.dataset.touched;
+          control.closest('.field').classList.remove('is-invalid');
+          control.removeAttribute('aria-invalid');
+        });
+        success.classList.add('visible');
+      });
+    })();
+  </script>
+
 </body>
 
