+  <script>
+    // Fallback grid picker for browsers that don't support customizable <select>.
+    (function () {
+      if (CSS.supports('appearance', 'base-select')) return;
+      var select = document.getElementById('roast');
+      var picker = document.createElement('div');
+      picker.className = 'roast-picker';
+      var trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      trigger.id = 'roast-trigger';
+      var grid = document.createElement('div');
+      grid.className = 'roast-grid';
+      grid.id = 'roast-grid';
+      grid.setAttribute('role', 'listbox');
+      grid.setAttribute('aria-labelledby', 'roast-label');
+      grid.tabIndex = -1;
+      grid.hidden = true;
+      trigger.setAttribute('aria-controls', grid.id);
+      document.querySelector('.roast-label').id = 'roast-label';
+
+      var items = Array.prototype.map.call(select.options, function (opt, i) {
+        var item = document.createElement('div');
+        item.className = 'roast-option';
+        item.id = 'roast-opt-' + opt.value;
+        item.setAttribute('role', 'option');
+        item.innerHTML = '<img class="roast-card-img" alt="" src="' + opt.dataset.img + '">' +
+          '<span class="roast-name"></span><span class="roast-desc"></span>';
+        item.querySelector('.roast-name').textContent = opt.querySelector('.roast-name') ?
+          opt.querySelector('.roast-name').textContent : opt.textContent.trim();
+        item.querySelector('.roast-desc').textContent = opt.dataset.desc;
+        item.addEventListener('click', function () { choose(i); close(); });
+        grid.appendChild(item);
+        return item;
+      });
+      var active = select.selectedIndex;
+
+      function render() {
+        items.forEach(function (item, i) {
+          item.setAttribute('aria-selected', String(i === select.selectedIndex));
+          item.classList.toggle('is-active', i === active && !grid.hidden);
+        });
+        trigger.textContent = items[select.selectedIndex].querySelector('.roast-name').textContent;
+        grid.setAttribute('aria-activedescendant', items[active].id);
+      }
+      function choose(i) { select.selectedIndex = i; active = i; render(); }
+      function open() {
+        grid.hidden = false; active = select.selectedIndex;
+        trigger.setAttribute('aria-expanded', 'true'); render(); grid.focus();
+      }
+      function close() {
+        grid.hidden = true; trigger.setAttribute('aria-expanded', 'false'); render(); trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () { grid.hidden ? open() : close(); });
+      grid.addEventListener('keydown', function (e) {
+        var n = items.length;
+        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') active = (active + 1) % n;
+        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') active = (active - 1 + n) % n;
+        else if (e.key === 'Home') active = 0;
+        else if (e.key === 'End') active = n - 1;
+        else if (e.key === 'Enter' || e.key === ' ') { choose(active); close(); }
+        else if (e.key === 'Escape' || e.key === 'Tab') { close(); return; }
+        else return;
+        e.preventDefault(); render();
+      });
+      document.addEventListener('click', function (e) {
+        if (!grid.hidden && !picker.contains(e.target)) { grid.hidden = true; trigger.setAttribute('aria-expanded', 'false'); render(); }
+      });
+
+      select.classList.add('visually-hidden');
+      select.tabIndex = -1;
+      select.setAttribute('aria-hidden', 'true');
+      select.parentNode.insertBefore(picker, select);
+      picker.appendChild(trigger);
+      picker.appendChild(grid);
+      picker.appendChild(select);
+      render();
+    })();
+  </script>
