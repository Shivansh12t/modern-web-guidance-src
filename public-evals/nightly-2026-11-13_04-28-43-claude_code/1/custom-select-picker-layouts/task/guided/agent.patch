+  <script>
+    // The native select only navigates with Up/Down. In the 3-column grid
+    // picker all options sit on one row, so map Left/Right to prev/next.
+    document.getElementById('roast-picker').addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const current = document.activeElement;
+      if (!(current instanceof HTMLOptionElement)) return; // picker closed
+      const forward = (e.key === 'ArrowRight') !== (getComputedStyle(current).direction === 'rtl');
+      const target = forward ? current.nextElementSibling : current.previousElementSibling;
+      if (target instanceof HTMLOptionElement) {
+        e.preventDefault();
+        target.focus();
+      }
+    });
+  </script>
