+
+      var BG_URL = 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80';
+      var MAX_RIPPLES = 10;
+
+      // ---------- Shaders ----------
+      var VERT = [
+        'attribute vec2 a_pos;',
+        'varying vec2 v_uv;',
+        'void main() {',
+        '  v_uv = a_pos * 0.5 + 0.5;',
+        '  gl_Position = vec4(a_pos, 0.0, 1.0);',
+        '}'
+      ].join('\n');
+
+      var FRAG = [
+        'precision highp float;',
+        'varying vec2 v_uv;',
+        'uniform sampler2D u_tex;',
+        'uniform vec2 u_res;',        // CSS pixels
+        'uniform float u_time;',
+        'uniform vec2 u_mouse;',      // CSS pixels, y down
+        'uniform float u_hover;',     // 0..1 pointer presence
+        'uniform vec4 u_ripples[' + MAX_RIPPLES + '];', // x, y, startTime, strength
+        '',
+        'void main() {',
+        '  vec2 p = vec2(v_uv.x, 1.0 - v_uv.y) * u_res;',
+        '  vec2 disp = vec2(0.0);',
+        '  float light = 0.0;',
+        '',
+        // Gentle ambient swell so the surface feels liquid even when idle.
+        '  vec2 c = u_res * 0.5;',
+        '  float dc = length(p - c);',
+        '  float amb = sin(dc * 0.045 - u_time * 1.6) * 0.9 + sin((p.x + p.y) * 0.02 + u_time * 0.9) * 0.6;',
+        '  disp += normalize(p - c + 0.0001) * amb;',
+        '',
+        // Soft lens that follows the pointer.
+        '  vec2 dm = p - u_mouse;',
+        '  float md = length(dm);',
+        '  float lens = exp(-md * md / 9000.0) * u_hover;',
+        '  disp += normalize(dm + 0.0001) * sin(md * 0.12 - u_time * 5.0) * 3.0 * lens;',
+        '',
+        // Expanding rings.
+        '  for (int i = 0; i < ' + MAX_RIPPLES + '; i++) {',
+        '    vec4 r = u_ripples[i];',
+        '    if (r.w <= 0.0) continue;',
+        '    float age = u_time - r.z;',
+        '    if (age < 0.0 || age > 3.0) continue;',
+        '    vec2 d = p - r.xy;',
+        '    float dist = length(d);',
+        '    float front = age * 380.0;',
+        '    float x = dist - front;',
+        '    float env = exp(-x * x / 2200.0) * exp(-age * 1.6) * r.w;',
+        '    float wave = sin(x * 0.09) * env;',
+        '    disp += normalize(d + 0.0001) * wave * 14.0;',
+        '    light += cos(x * 0.09) * env;',
+        '  }',
+        '',
+        '  vec2 uv = (p - disp) / u_res;',
+        '  uv.y = 1.0 - uv.y;',
+        '  vec2 ca = disp / u_res * 0.25;',   // slight chromatic split along the wave
+        '  vec4 base = texture2D(u_tex, uv);',
+        '  float rr = texture2D(u_tex, uv + ca).r;',
+        '  float bb = texture2D(u_tex, uv - ca).b;',
+        '  vec4 col = vec4(rr, base.g, bb, base.a);',
+        '  col.rgb += vec3(1.0, 0.85, 0.6) * max(light, 0.0) * 0.12 * col.a;',
+        '  gl_FragColor = col;',
+        '}'
+      ].join('\n');
+
+      function compile(type, src) {
+        var s = gl.createShader(type);
+        gl.shaderSource(s, src);
+        gl.compileShader(s);
+        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
