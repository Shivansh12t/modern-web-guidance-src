+  <script>
+    /*
+     * Hero ripple: rasterises the hero's HTML (background, heading, tagline,
+     * button) into a texture using the live DOM layout, then renders it through
+     * a WebGL fragment shader that applies ripple distortion. The original DOM
+     * nodes remain on top with transparent paint, so text selection, links,
+     * keyboard focus and screen readers all keep working normally.
+     */
+    (function () {
+      'use strict';
+
+      var hero = document.querySelector('.hero');
+      var canvas = hero && hero.querySelector('.hero-gl');
+      if (!hero || !canvas) return;
+      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+      var gl = canvas.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false });
