+    /* WebGL ripple layer.
+       The real DOM content stays in place (selectable, clickable, accessible);
+       once the GPU layer is live, the DOM's paint is made transparent and the
+       canvas shows a rippling copy of it underneath. */
+    .hero {
+      position: relative;
+      overflow: hidden;
+    }
+
+    .hero > * {
+      position: relative;
+      z-index: 1;
+    }
+
+    .hero > .hero-gl {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      z-index: 0;
+      pointer-events: none;
+      opacity: 0;
+      transition: opacity 0.4s ease;
+    }
+
+    .hero.hero--gl > .hero-gl {
+      opacity: 1;
+    }
+
+    .hero.hero--gl.hero--gl-bg {
+      background: #2a1d19;
+    }
+
+    .hero.hero--gl h1,
+    .hero.hero--gl p,
+    .hero.hero--gl .btn {
+      color: transparent;
+      text-shadow: none;
+    }
+
+    .hero.hero--gl .btn,
+    .hero.hero--gl .btn:hover {
+      background: transparent;
+      transition: none;
+    }
+
+    .hero.hero--gl .btn:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .hero.hero--gl ::selection {
+      color: transparent;
+      background: rgba(255, 171, 64, 0.4);
+    }
