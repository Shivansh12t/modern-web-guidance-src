+  <script>
+    (function () {
+      var THRESHOLD = 0.4;     // fraction of item width needed to trigger removal
+      var INTENT_PX = 8;       // movement before we decide horizontal vs vertical
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      var list = document.querySelector('.SwipeableList');
+      if (!list) return;
+      var cart = list.closest('.cart');
+      var totalEl = cart.querySelector('.cart-total');
+      var emptyEl = cart.querySelector('.cart-empty');
+      var summaryEl = cart.querySelector('.cart-summary');
+      var hintEl = cart.querySelector('.cart-hint');
+
+      function updateCart() {
+        var items = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        var total = 0;
+        items.forEach(function (li) { total += parseFloat(li.dataset.price) || 0; });
+        totalEl.textContent = '$' + total.toFixed(2);
+        var empty = items.length === 0;
+        emptyEl.hidden = !empty;
+        summaryEl.hidden = empty;
+        hintEl.hidden = empty;
+      }
+
+      function onTransitionEndOnce(el, prop, fallbackMs, cb) {
+        var done = false;
+        function finish(e) {
+          if (done || (e && (e.target !== el || e.propertyName !== prop))) return;
+          done = true;
+          el.removeEventListener('transitionend', finish);
+          cb();
+        }
+        el.addEventListener('transitionend', finish);
+        setTimeout(finish, reduceMotion ? 20 : fallbackMs);
+      }
+
+      function collapse(li) {
+        li.style.height = li.offsetHeight + 'px';
+        li.offsetHeight; // force reflow so the height transition starts from the measured value
+        li.classList.add('is-collapsing');
+        li.style.height = '0px';
+        li.style.marginBottom = '0px';
+        onTransitionEndOnce(li, 'height', 400, function () { li.remove(); });
+      }
+
+      function removeItem(li, track) {
+        if (li.classList.contains('is-removing')) return;
+        li.classList.remove('is-swiping');
+        li.classList.add('is-removing');
+        updateCart();
+        track.style.transform = 'translateX(-100%)';
+        onTransitionEndOnce(track, 'transform', 300, function () { collapse(li); });
+      }
+
+      function initItem(li) {
+        if (li.classList.contains('is-initialized')) return;
+        var track = li.querySelector('.SwipeableList-track');
+        var removeBtn = li.querySelector('.cart-item-remove');
+        var startX = 0, startY = 0, dx = 0, pointerId = null, dragging = false, width = 0;
+
+        function reset() {
+          pointerId = null;
+          dragging = false;
+          dx = 0;
+        }
+
+        track.addEventListener('pointerdown', function (e) {
+          if (li.classList.contains('is-removing') || pointerId !== null) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          if (e.target.closest('button')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          width = li.offsetWidth;
+          dx = 0;
+        });
+
+        track.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var mx = e.clientX - startX;
+          var my = e.clientY - startY;
+
+          if (!dragging) {
+            if (Math.abs(mx) < INTENT_PX && Math.abs(my) < INTENT_PX) return;
+            if (Math.abs(my) > Math.abs(mx)) { reset(); return; } // vertical scroll wins
+            dragging = true;
+            li.classList.add('is-swiping');
+            track.setPointerCapture(pointerId);
+          }
+
+          e.preventDefault();
+          // Left swipe moves freely; rightward drag gets heavy resistance.
+          dx = mx < 0 ? mx : mx * 0.15;
+          track.style.transform = 'translateX(' + dx + 'px)';
+          li.classList.toggle('is-past-threshold', -dx >= width * THRESHOLD);
+        });
+
+        function end(e) {
+          if (e.pointerId !== pointerId) return;
+          var wasDragging = dragging;
+          var past = -dx >= width * THRESHOLD;
+          reset();
+          if (!wasDragging) return;
+          if (past && e.type === 'pointerup') {
+            removeItem(li, track);
+          } else {
+            li.classList.remove('is-swiping', 'is-past-threshold');
+            track.style.transform = '';
+          }
+        }
+
+        track.addEventListener('pointerup', end);
+        track.addEventListener('pointercancel', end);
+
+        if (removeBtn) {
+          removeBtn.addEventListener('click', function () {
+            li.classList.add('is-past-threshold');
+            removeItem(li, track);
+          });
+        }
+
+        li.classList.add('is-initialized');
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(initItem);
+      updateCart();
+    })();
+  </script>
+
