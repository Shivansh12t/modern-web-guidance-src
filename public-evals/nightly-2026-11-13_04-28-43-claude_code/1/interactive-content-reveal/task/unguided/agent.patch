+  <script>
+    (() => {
+      const INNER = '90px';
+      const OUTER = '110px';
+
+      document.querySelectorAll('.product-card').forEach((card) => {
+        let frame = 0;
+        let lastEvent = null;
+
+        const updatePosition = () => {
+          frame = 0;
+          if (!lastEvent) return;
+          const rect = card.getBoundingClientRect();
+          card.style.setProperty('--mouse-x', `${lastEvent.clientX - rect.left}px`);
+          card.style.setProperty('--mouse-y', `${lastEvent.clientY - rect.top}px`);
+        };
+
+        const track = (event) => {
+          lastEvent = event;
+          if (!frame) frame = requestAnimationFrame(updatePosition);
+        };
+
+        const setSize = (inner, outer) => {
+          card.style.setProperty('--inner-size', inner);
+          card.style.setProperty('--outer-size', outer);
+        };
+
+        card.addEventListener('pointerenter', (event) => {
+          // Hover-only effect; touch taps shouldn't leave the overlay stuck open.
+          if (event.pointerType === 'touch') return;
+          lastEvent = event;
+          updatePosition();
+          setSize(INNER, OUTER);
+        });
+
+        card.addEventListener('pointermove', (event) => {
+          if (event.pointerType === 'touch') return;
+          track(event);
+        });
+
+        card.addEventListener('pointerleave', () => {
+          setSize('0px', '0px');
+        });
+      });
+    })();
+  </script>
