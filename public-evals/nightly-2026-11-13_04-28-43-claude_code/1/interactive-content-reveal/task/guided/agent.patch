+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
+    }
+
+    /* Only devices that can truly hover get the spotlight */
+    @media (hover: hover) and (pointer: fine) {
