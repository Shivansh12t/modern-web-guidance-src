+  <script>
+    (() => {
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral, bergamot, lemon', price: 18.5,
+          img: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=160&h=160&q=70' },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel, red apple, cocoa', price: 16,
+          img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=160&h=160&q=70' },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy, cedar, dark chocolate', price: 17,
+          img: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=160&h=160&q=70' },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Toffee, spice, orange peel', price: 16.5,
+          img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=160&h=160&q=70' },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant, grapefruit, bright', price: 19.5,
+          img: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=160&h=160&q=70' },
+        { id: 'house', name: 'Daily Grind House Blend', notes: 'Nutty, balanced, chocolatey', price: 14,
+          img: 'https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=160&h=160&q=70' }
+      ];
+
+      const pantry = document.getElementById('bean-pantry');
+      const bag = document.getElementById('bean-bag');
+      const countEl = document.getElementById('bean-count');
+      const totalEl = document.getElementById('bean-total');
+      const statusEl = document.getElementById('bean-status');
+      const addAllBtn = document.querySelector('[data-action="add-all"]');
+      const clearBtn = document.querySelector('[data-action="clear"]');
+      const order = BEANS.map(b => b.id);
+      const byId = Object.fromEntries(BEANS.map(b => [b.id, b]));
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const DURATION = 450;
+      const EASING = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
+
+      function createItem(bean) {
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.dataset.id = bean.id;
+        li.innerHTML = `
+          <img src="${bean.img}" alt="" loading="lazy" width="56" height="56">
+          <div class="bean-info"><strong></strong><span></span></div>
+          <span class="bean-price"></span>
+          <button type="button" class="bean-toggle"></button>`;
+        li.querySelector('strong').textContent = bean.name;
+        li.querySelector('.bean-info span').textContent = bean.notes;
+        li.querySelector('.bean-price').textContent = `$${bean.price.toFixed(2)}`;
+        li.querySelector('img').addEventListener('error', e => { e.target.style.visibility = 'hidden'; }, { once: true });
+        return li;
+      }
+
+      const items = () => [...document.querySelectorAll('.bean-item')];
+
+      /*
+       * Group FLIP transition: every item is measured before and after the DOM
+       * change, then all of them animate together from their old position to
+       * the new one. Only transforms are animated via the Web Animations API,
+       * so nothing blocks input — users can keep clicking (even mid-animation)
+       * and the next transition starts from wherever items currently are.
+       */
+      function groupTransition(mutate) {
+        if (reduceMotion.matches) { mutate(); return; }
+
+        // First: visual positions, including any in-flight transform.
+        const first = new Map(items().map(el => [el, el.getBoundingClientRect()]));
+        items().forEach(el => el.getAnimations().forEach(a => a.cancel()));
+
+        mutate();
+
+        // Last + Invert + Play, all at once.
+        items().forEach(el => {
+          const last = el.getBoundingClientRect();
+          const prev = first.get(el);
+          if (!prev) {
+            el.animate(
+              [{ opacity: 0, transform: 'scale(0.9)' }, { opacity: 1, transform: 'none' }],
+              { duration: DURATION, easing: EASING }
+            );
+            return;
+          }
+          const dx = prev.left - last.left;
+          const dy = prev.top - last.top;
+          if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) return;
+          el.animate(
+            [
+              { transform: `translate(${dx}px, ${dy}px)`, zIndex: 2 },
+              { transform: 'none', zIndex: 2 }
+            ],
+            { duration: DURATION, easing: EASING }
+          );
+        });
+      }
+
+      // Keep each list in the catalog's canonical order so positions are stable.
+      function insertSorted(list, el) {
+        const idx = order.indexOf(el.dataset.id);
+        const next = [...list.children].find(c => order.indexOf(c.dataset.id) > idx);
+        list.insertBefore(el, next || null);
+      }
+
+      function sync() {
+        const selected = [...bag.children].map(el => byId[el.dataset.id]);
+        countEl.textContent = selected.length;
+        totalEl.textContent = `$${selected.reduce((s, b) => s + b.price, 0).toFixed(2)}`;
+        addAllBtn.disabled = pantry.children.length === 0;
+        clearBtn.disabled = bag.children.length === 0;
+        for (const el of items()) {
+          const inBag = el.parentElement === bag;
+          const btn = el.querySelector('.bean-toggle');
+          btn.textContent = inBag ? 'Remove' : 'Add';
+          btn.setAttribute('aria-label', `${inBag ? 'Remove' : 'Add'} ${byId[el.dataset.id].name}`);
+        }
+      }
+
+      function moveItems(els, target, message) {
+        if (!els.length) return;
+        groupTransition(() => {
+          els.forEach(el => insertSorted(target, el));
+          sync();
+        });
+        statusEl.textContent = message;
+      }
+
+      BEANS.forEach(b => pantry.appendChild(createItem(b)));
+      // Start with a couple of favorites already in the bag.
+      ['colombia', 'house'].forEach(id => insertSorted(bag, pantry.querySelector(`[data-id="${id}"]`)));
+      sync();
+
+      document.querySelector('.bean-board').addEventListener('click', e => {
+        const toggle = e.target.closest('.bean-toggle');
+        if (toggle) {
+          const el = toggle.closest('.bean-item');
+          const toBag = el.parentElement === pantry;
+          const name = byId[el.dataset.id].name;
+          moveItems([el], toBag ? bag : pantry, `${name} ${toBag ? 'added to' : 'removed from'} your bag.`);
+          toggle.focus({ preventScroll: true });
+          return;
+        }
+        const action = e.target.closest('[data-action]')?.dataset.action;
+        if (action === 'add-all') moveItems([...pantry.children], bag, 'All beans added to your bag.');
+        if (action === 'clear') moveItems([...bag.children], pantry, 'Your bag has been cleared.');
+      });
+    })();
+  </script>
+
