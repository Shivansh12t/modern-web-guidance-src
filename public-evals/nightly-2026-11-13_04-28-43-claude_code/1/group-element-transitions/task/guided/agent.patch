+  <script>
+    (() => {
+      const IMG = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=120&h=120&q=70`;
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', meta: 'Light roast · jasmine, lemon', img: IMG('1447933601403-0c6688de566e'), inBox: true },
+        { id: 'colombia', name: 'Colombia Huila', meta: 'Medium roast · caramel, red apple', img: IMG('1559056199-641a0ac8b55e'), inBox: false },
+        { id: 'sumatra', name: 'Sumatra Mandheling', meta: 'Dark roast · cedar, cocoa', img: IMG('1514432324607-a09d9b4aefdd'), inBox: false },
+        { id: 'guatemala', name: 'Guatemala Antigua', meta: 'Medium roast · chocolate, spice', img: IMG('1509042239860-f550ce710b93'), inBox: true },
+        { id: 'kenya', name: 'Kenya AA', meta: 'Light roast · blackcurrant, grapefruit', img: IMG('1442512595331-e89e73853f31'), inBox: false },
+        { id: 'house', name: 'Daily Grind House Blend', meta: 'Medium-dark · toffee, hazelnut', img: IMG('1495474472287-4d71bcdd2085'), inBox: false },
+      ];
+
+      const picker = document.getElementById('bean-picker');
+      const available = document.getElementById('bean-available');
+      const box = document.getElementById('bean-box');
+      const availableCount = document.getElementById('available-count');
+      const boxCount = document.getElementById('box-count');
+      const status = document.getElementById('bean-status');
+
+      function createItem(bean, index) {
+        const li = document.createElement('li');
+        li.className = 'bean';
+        li.dataset.id = bean.id;
+        li.dataset.order = index;
+        // Unique name per item so each bean is tracked individually across both lists.
+        li.style.viewTransitionName = `bean-${bean.id}`;
+
+        const img = document.createElement('img');
+        img.src = bean.img;
+        img.alt = '';
+        img.width = 56;
+        img.height = 56;
+        img.loading = 'lazy';
+        img.decoding = 'async';
+
+        const text = document.createElement('div');
+        const name = document.createElement('div');
+        name.className = 'bean-name';
+        name.textContent = bean.name;
+        const meta = document.createElement('div');
+        meta.className = 'bean-meta';
+        meta.textContent = bean.meta;
+        text.append(name, meta);
+
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        btn.className = 'bean-toggle';
+
+        li.append(img, text, btn);
+        return li;
+      }
+
+      function syncItem(li) {
+        const inBox = li.parentElement === box;
+        const name = li.querySelector('.bean-name').textContent;
+        const btn = li.querySelector('.bean-toggle');
+        btn.textContent = inBox ? 'Remove' : 'Add';
+        btn.setAttribute('aria-label', `${inBox ? 'Remove' : 'Add'} ${name}`);
+      }
+
+      function updateCounts() {
+        const a = available.children.length;
+        const b = box.children.length;
+        availableCount.textContent = `${a} left`;
+        boxCount.textContent = `${b} ${b === 1 ? 'bag' : 'bags'}`;
+      }
+
+      // Keep the catalog list in its original order when a bean is returned to it.
+      function insertSorted(list, li) {
+        const order = Number(li.dataset.order);
+        const next = [...list.children].find((el) => Number(el.dataset.order) > order);
+        list.insertBefore(li, next ?? null);
+      }
+
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+
+      function withTransition(update) {
+        let transition;
+        if (supportsScoped) {
+          // Scoped to the picker: the rest of the page stays live and unobscured.
+          transition = picker.startViewTransition(update);
+        } else if (document.startViewTransition) {
+          // Root snapshot is disabled and ::view-transition ignores pointer events,
+          // so the page remains interactive during the document-level fallback.
+          transition = document.startViewTransition(update);
+        } else {
+          update();
+          return;
+        }
+        // Rapid clicks skip the in-flight transition; swallow that rejection.
+        transition.ready.catch(() => {});
+      }
+
+      function toggle(li) {
+        const fromBox = li.parentElement === box;
+        const source = fromBox ? box : available;
+        const name = li.querySelector('.bean-name').textContent;
+        const hadFocus = li.contains(document.activeElement);
+        const sibling = li.nextElementSibling ?? li.previousElementSibling;
+
+        withTransition(() => {
+          if (fromBox) insertSorted(available, li);
+          else box.append(li);
+          syncItem(li);
+          updateCounts();
+          // Moving the node drops focus; keep keyboard users in the list they were working in.
+          if (hadFocus) {
+            (sibling?.parentElement === source ? sibling : li).querySelector('.bean-toggle').focus();
+          }
+        });
+
+        status.textContent = fromBox ? `${name} removed from your bean box.` : `${name} added to your bean box.`;
+      }
+
+      BEANS.forEach((bean, i) => {
+        const li = createItem(bean, i);
+        (bean.inBox ? box : available).append(li);
+        syncItem(li);
+      });
+      updateCounts();
+
+      picker.addEventListener('click', (event) => {
+        const btn = event.target.closest('.bean-toggle');
+        if (btn) toggle(btn.closest('.bean'));
+      });
+    })();
+  </script>
+
