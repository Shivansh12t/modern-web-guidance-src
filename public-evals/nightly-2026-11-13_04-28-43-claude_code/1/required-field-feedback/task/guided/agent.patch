+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const success = document.getElementById('newsletter-success');
+
+      // List the error message in aria-describedby only while it's shown:
+      // referenced text is announced even when hidden.
+      const linkError = (el, shown) => {
+        const errorId = el.dataset.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+
+      // Pick the message that matches the failure: empty vs. badly formatted.
+      const setErrorText = (el) => {
+        const text = document.querySelector(`#${el.dataset.error} .error-text`);
+        if (!text) return;
+        text.textContent = el.validity.valueMissing
+          ? 'Enter your email address.'
+          : 'Enter an email address in the format you@example.com.';
+      };
+
+      // One polite live region announces errors that appear on blur.
+      const announcer = document.createElement('div');
+      announcer.setAttribute('aria-live', 'polite');
+      announcer.classList.add('visually-hidden');
+      document.body.append(announcer);
+      let announceTimer;
+
+      const announceError = (el) => {
+        const text = document.querySelector(`#${el.dataset.error} .error-text`);
+        if (!text) return;
+        const label = el.labels?.[0]?.textContent.trim() ?? '';
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announceTimer = setTimeout(() => {
+          announcer.textContent = `${label}: Error: ${text.textContent}`;
+        }, 500);
+      };
+
+      const announced = new WeakSet();
+
+      // Keep aria-invalid in sync with the visual :user-invalid state.
+      const syncAria = (el, announce = false) => {
+        if (!el.matches?.('input, select, textarea')) return;
+        if (el.matches(':user-invalid')) {
+          setErrorText(el);
+          if (announce && !announced.has(el)) {
+            announceError(el);
+            announced.add(el);
+          }
+          el.setAttribute('aria-invalid', 'true');
+          linkError(el, true);
+        } else {
+          el.setAttribute('aria-invalid', 'false');
+          linkError(el, false);
+          if (announced.has(el)) {
+            announced.delete(el);
+            clearTimeout(announceTimer);
+            announcer.textContent = '';
+          }
+        }
+      };
+
+      // Start neutral: Firefox/Safari would otherwise expose the empty required field as invalid.
+      [...form.elements].forEach((el) => syncAria(el));
+
+      form.addEventListener('blur', (e) => syncAria(e.target, true), true);
+      form.addEventListener('input', (e) => syncAria(e.target));
+      form.addEventListener('change', (e) => syncAria(e.target, true));
+      // A failed submit fires 'invalid' on each failing field; native validation then
+      // focuses the first one, which reads its error, so don't announce it again.
+      form.addEventListener('invalid', (e) => {
+        announced.add(e.target);
+        syncAria(e.target);
+      }, true);
+      form.addEventListener('reset', () => {
+        setTimeout(() => [...form.elements].forEach((el) => syncAria(el)));
+      });
+
+      // No backend is wired up yet: confirm the signup in-page instead of navigating.
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        success.textContent = `Thanks! ${email.value} is now on the list.`;
+        form.reset();
+      });
+    })();
+  </script>
