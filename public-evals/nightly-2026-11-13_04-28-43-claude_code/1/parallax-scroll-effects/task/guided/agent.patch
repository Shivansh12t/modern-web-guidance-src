+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      height: 70vh;
+      min-height: 420px;
+      overflow: clip;
+      display: grid;
+      place-items: center;
+      background: var(--primary);
+      color: white;
+      isolation: isolate;
+      view-timeline: --parallax;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: 0;
+    }
+
+    /* Layers are oversized by their travel distance so no gaps appear while moving */
+    .parallax-layer--back {
+      --distance: 12vh;
+      inset: calc(-1 * var(--distance)) 0;
+      z-index: -3;
+    }
+
+    .parallax-layer--back img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .parallax-layer--back::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background: linear-gradient(rgba(62, 39, 35, 0.75), rgba(62, 39, 35, 0.6));
+    }
+
+    .parallax-layer--mid {
+      --distance: 28vh;
+      inset: calc(-1 * var(--distance)) 0;
+      z-index: -2;
+    }
+
+    .parallax-layer--front {
+      --distance: 45vh;
+      inset: calc(-1 * var(--distance)) 0;
