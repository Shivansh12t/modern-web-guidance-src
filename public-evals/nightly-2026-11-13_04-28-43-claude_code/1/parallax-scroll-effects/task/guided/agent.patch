+  <script>
+    // Fallback for browsers without scroll-driven animations (rAF-throttled, only active while visible).
+    (() => {
+      if (CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) return;
+
+      const section = document.querySelector('.parallax');
+      if (!section) return;
+      const layers = [...section.querySelectorAll('.parallax-layer')];
+      const motion = matchMedia('(prefers-reduced-motion: reduce)');
+      let ticking = false;
+      let visible = false;
+
+      function update() {
+        ticking = false;
+        const rect = section.getBoundingClientRect();
+        const vh = window.innerHeight;
+        // 0 when the section enters at the bottom, 1 when it leaves at the top (matches `cover`)
+        const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
+        for (const layer of layers) {
+          const distance = parseFloat(getComputedStyle(layer).getPropertyValue('--distance')) * vh / 100;
+          layer.style.transform = `translateY(${distance * (1 - 2 * progress)}px)`;
+        }
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(update);
+        }
+      }
+
+      function start() {
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('resize', onScroll, { passive: true });
+        onScroll();
+      }
+
+      function stop() {
+        window.removeEventListener('scroll', onScroll);
+        window.removeEventListener('resize', onScroll);
+      }
+
+      new IntersectionObserver(([entry]) => {
+        visible = entry.isIntersecting;
+        visible && !motion.matches ? start() : stop();
+      }).observe(section);
+
+      // React live if the user toggles their reduced-motion preference
+      motion.addEventListener('change', () => {
+        if (motion.matches) {
+          stop();
+          layers.forEach((layer) => (layer.style.transform = ''));
+        } else if (visible) {
+          start();
+        }
+      });
+    })();
+  </script>
