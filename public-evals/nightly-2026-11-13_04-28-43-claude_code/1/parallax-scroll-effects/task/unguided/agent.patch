+  <script>
+    /*
+     * Lightweight scroll parallax.
+     * - Only transforms (GPU-composited), batched in requestAnimationFrame.
+     * - Runs only while the section is on screen (IntersectionObserver).
+     * - Fully disabled when the user prefers reduced motion (and reacts live if that changes).
+     * - Purely decorative: content is readable and static without JS.
+     */
+    (function () {
+      var section = document.querySelector('[data-parallax]');
+      if (!section) return;
+
+      var layers = Array.prototype.map.call(
+        section.querySelectorAll('[data-speed]'),
+        function (el) { return { el: el, speed: parseFloat(el.dataset.speed) || 0 }; }
+      );
+      var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var visible = false;
+      var ticking = false;
+      var viewportH = window.innerHeight;
+
+      function reset() {
+        layers.forEach(function (l) { l.el.style.transform = ''; });
+      }
+
+      function update() {
+        ticking = false;
+        if (!visible || motionQuery.matches) return;
+
+        var rect = section.getBoundingClientRect();
+        // Distance of the section's center from the viewport's center (px).
+        var offset = rect.top + rect.height / 2 - viewportH / 2;
+        // Background is oversized by 25% top/bottom; keep motion within it.
+        var limit = rect.height * 0.25;
+
+        for (var i = 0; i < layers.length; i++) {
+          var l = layers[i];
+          var y = offset * l.speed * -1;
+          if (y > limit) y = limit;
+          else if (y < -limit) y = -limit;
+          l.el.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
+        }
+      }
+
+      function requestTick() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      function setActive(on) {
+        visible = on;
+        section.classList.toggle('is-active', on && !motionQuery.matches);
+        if (on) requestTick();
+      }
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          setActive(entries[0].isIntersecting);
+        }, { rootMargin: '100px 0px' }).observe(section);
+      } else {
+        setActive(true);
+      }
+
+      window.addEventListener('scroll', requestTick, { passive: true });
+      window.addEventListener('resize', function () {
+        viewportH = window.innerHeight;
+        requestTick();
+      }, { passive: true });
+
+      function onMotionPrefChange() {
+        if (motionQuery.matches) {
+          section.classList.remove('is-active');
+          reset();
+        } else {
+          setActive(visible);
+        }
+      }
+      if (motionQuery.addEventListener) motionQuery.addEventListener('change', onMotionPrefChange);
+      else if (motionQuery.addListener) motionQuery.addListener(onMotionPrefChange);
+    })();
+  </script>
+
