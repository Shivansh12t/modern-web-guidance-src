+  <script>
+    /* Fallbacks for browsers without CSS scroll-driven animations.
+       Written in ES5 so it also runs in old browsers. */
+    (function () {
+      var supports = window.CSS && CSS.supports;
+      if (supports && CSS.supports('animation-timeline', 'scroll()')) {
+        return; // Native CSS handles everything.
+      }
+
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var hasCustomProps = supports && CSS.supports('--a', '0');
+      var distance = 200; // keep in sync with --nav-shrink-distance
+      var ticking = false;
+      var last = -1;
+
+      if (!hasCustomProps) {
+        nav.className += ' nav--legacy';
+      }
+
+      function getScrollY() {
+        return window.pageYOffset ||
+          document.documentElement.scrollTop ||
+          document.body.scrollTop || 0;
+      }
+
+      function update() {
+        ticking = false;
+        var progress = Math.min(Math.max(getScrollY() / distance, 0), 1);
+        if (progress === last) return;
+        last = progress;
+
+        if (hasCustomProps) {
+          // 2. Continuous, scroll-linked: same visuals as the native path.
+          nav.style.setProperty('--shrink', progress.toFixed(3));
+        } else {
+          // 3. Discrete toggle, smoothed by CSS transitions.
+          var compact = progress >= 0.5;
+          var has = /\bnav--compact\b/.test(nav.className);
+          if (compact && !has) {
+            nav.className += ' nav--compact';
+          } else if (!compact && has) {
+            nav.className = nav.className.replace(/\s*\bnav--compact\b/, '');
+          }
+        }
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          (window.requestAnimationFrame || function (cb) { setTimeout(cb, 16); })(update);
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, false);
+      window.addEventListener('resize', onScroll, false);
+      update();
+    })();
+  </script>
