+  <script>
+    // Fallback for browsers without scroll-driven animations: drive the same
+    // --nav-progress custom property from a rAF-throttled scroll listener.
+    (function () {
+      var supported = window.CSS && CSS.supports &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supported) return;
+
+      var root = document.documentElement;
+      var distance = parseFloat(getComputedStyle(root).getPropertyValue('--nav-shrink')) || 28;
+      var reduceMotion = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)');
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var y = window.pageYOffset || root.scrollTop || 0;
+        var progress = Math.max(0, Math.min(1, y / distance));
+        if (reduceMotion && reduceMotion.matches) progress = progress >= 1 ? 1 : 0;
+        root.style.setProperty('--nav-progress', progress);
+      }
+
+      window.addEventListener('scroll', function () {
+        if (!ticking) {
+          ticking = true;
+          (window.requestAnimationFrame || setTimeout)(update);
+        }
+      }, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    })();
+  </script>
