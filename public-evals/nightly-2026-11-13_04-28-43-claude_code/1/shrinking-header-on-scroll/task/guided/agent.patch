+    /* Navigation
+       --nav-progress goes from 0 (top of page) to 1 (compact) over the first
+       --nav-shrink pixels of scrolling. Every size below is derived from it, so
+       the native scroll-driven animation and the JS fallback only need to
+       drive this single value. */
+    @property --nav-progress {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    :root {
+      --nav-h-max: 80px;
+      --nav-h-min: 52px;
+      --nav-shrink: 28px; /* = max - min, so content scrolls in sync with the nav */
+      --nav-progress: 0;
+      --nav-h: calc(var(--nav-h-max) - (var(--nav-h-max) - var(--nav-h-min)) * var(--nav-progress));
+      /* Keep focused elements from being hidden under the fixed nav (WCAG 2.4.11) */
+      scroll-padding-top: calc(var(--nav-h) + 8px);
+    }
+
+    @keyframes nav-shrink {
+      from { --nav-progress: 0; }
+      to { --nav-progress: 1; }
+    }
+
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      :root {
+        animation: nav-shrink auto linear both;
+        animation-timeline: scroll(block root);
+        animation-range: 0px var(--nav-shrink);
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        :root {
+          animation-timing-function: steps(1, jump-end);
+        }
+      }
+    }
+
