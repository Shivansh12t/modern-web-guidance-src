+  <script type="module">
+    // Load the Invoker Commands polyfill only where command/commandfor is unsupported.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.sh/invokers-polyfill');
+    }
+
+    const dialog = document.getElementById('feedback-dialog');
+    const form = document.getElementById('feedback-form');
+    const moveBtn = document.getElementById('feedback-move');
+    const locationLabel = document.getElementById('feedback-location');
+    const thanks = document.getElementById('feedback-thanks');
+    const sections = ['section-hero', 'section-favorites', 'section-footer']
+      .map((id) => document.getElementById(id));
+
+    function moveDialogTo(target) {
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: the modal stays open, in the top layer, with focus intact.
+        target.moveBefore(dialog, null);
+        return;
+      }
+      // Fallback: a traditional move drops the dialog out of the top layer,
+      // so restore modal state and focus manually.
+      const wasOpen = dialog.open;
+      target.insertBefore(dialog, null);
+      if (wasOpen) {
+        if (dialog.open) dialog.removeAttribute('open'); // showModal() throws if already [open] but non-modal
+        dialog.showModal();
+        moveBtn.focus();
+      }
+    }
+
+    moveBtn.addEventListener('click', () => {
+      const current = sections.findIndex((section) => section.contains(dialog));
+      const next = sections[(current + 1) % sections.length];
+      moveDialogTo(next);
+      locationLabel.textContent = `Currently in: ${next.dataset.sectionName}`;
+    });
+
+    dialog.addEventListener('close', () => {
+      // A fallback move may queue a close event; ignore it if the dialog was reopened.
+      if (dialog.open) return;
+      if (dialog.returnValue === 'submit') {
+        thanks.textContent = 'Thanks for your feedback!';
+        form.reset();
+      }
+      dialog.returnValue = '';
+    });
+  </script>
+
