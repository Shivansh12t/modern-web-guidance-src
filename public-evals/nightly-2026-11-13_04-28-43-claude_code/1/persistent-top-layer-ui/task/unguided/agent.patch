+  <button type="button" class="feedback-fab" id="feedback-open" aria-haspopup="dialog"
+    aria-controls="feedback-modal">Give Feedback</button>
+
+  <dialog class="feedback-modal" id="feedback-modal" aria-labelledby="feedback-title">
+    <header>
+      <h2 id="feedback-title">Share Your Feedback</h2>
+      <button type="button" class="icon-btn" data-action="close" aria-label="Close feedback">&times;</button>
+    </header>
