+          <option value="4">Good</option>
+          <option value="3" selected>Okay</option>
+          <option value="2">Not great</option>
+          <option value="1">Poor</option>
+        </select>
+      </label>
+      <label>Comments
+        <textarea name="comments" placeholder="Tell us what you loved or what we can improve..."></textarea>
+      </label>
+      <p class="status" data-role="status" aria-live="polite"></p>
+      <div class="actions">
+        <button type="button" class="btn btn-secondary" data-action="move">Move &rarr; next section</button>
+        <button type="submit" class="btn" value="submit">Send Feedback</button>
+      </div>
+    </form>
+  </dialog>
+  <p class="sr-only" id="feedback-announcer" aria-live="polite"></p>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-modal');
+      const openBtn = document.getElementById('feedback-open');
+      const form = document.getElementById('feedback-form');
+      const hostName = dialog.querySelector('[data-role="host-name"]');
+      const status = dialog.querySelector('[data-role="status"]');
+      const announcer = document.getElementById('feedback-announcer');
+      const hosts = Array.from(document.querySelectorAll('.modal-host'));
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      let hostIndex = 0;
+
+      function updateHostUI() {
+        hosts.forEach((h, i) => h.classList.toggle('is-hosting', i === hostIndex && dialog.open));
+        hostName.textContent = hosts[hostIndex].dataset.hostLabel || hosts[hostIndex].id;
+      }
+
+      // Snapshot state that a plain remove/insert would lose.
+      function captureState() {
+        const active = document.activeElement;
+        const focused = dialog.contains(active) ? active : null;
+        const selection = focused && typeof focused.selectionStart === 'number'
+          ? { start: focused.selectionStart, end: focused.selectionEnd, dir: focused.selectionDirection }
+          : null;
+        const scrolls = Array.from(dialog.querySelectorAll('textarea')).map(el => [el, el.scrollTop]);
+        return { wasOpen: dialog.open, wasModal: dialog.matches(':modal'), focused, selection, scrolls };
+      }
+
+      function restoreState(state) {
+        if (state.wasOpen) {
+          if (state.wasModal && !dialog.matches(':modal')) {
+            // Lost top-layer status during the move: re-promote without
+            // tearing down the user's session (the close event is ignored
+            // below because the dialog is open again when it is dispatched).
+            if (dialog.open) dialog.close();
+            dialog.showModal();
+          } else if (!dialog.open) {
+            dialog.show();
+          }
+        }
+        state.scrolls.forEach(([el, top]) => { el.scrollTop = top; });
+        const target = state.focused && dialog.contains(state.focused) ? state.focused : dialog.querySelector('[data-action="move"]');
+        if (target && document.activeElement !== target) {
+          target.focus({ preventScroll: true });
+        }
+        if (state.selection && target === state.focused) {
+          try {
+            target.setSelectionRange(state.selection.start, state.selection.end, state.selection.dir);
+          } catch (_) { /* not all inputs support selection */ }
+        }
+      }
+
+      function mountIn(host) {
+        if (dialog.parentNode === host) return;
+        const state = captureState();
+        if (supportsMoveBefore) {
+          // Atomic, state-preserving move: keeps top layer, focus and form state.
+          try {
+            host.moveBefore(dialog, null);
+          } catch (_) {
+            host.appendChild(dialog);
+          }
+        } else {
+          host.appendChild(dialog);
+        }
+        restoreState(state);
+      }
+
+      function moveToNext() {
+        hostIndex = (hostIndex + 1) % hosts.length;
+        mountIn(hosts[hostIndex]);
+        updateHostUI();
+        const label = hostName.textContent;
+        status.textContent = `Moved to "${label}". Your draft is still here.`;
+        announcer.textContent = `Feedback dialog moved to ${label} section.`;
+        hosts[hostIndex].scrollIntoView({ behavior: 'smooth', block: 'center' });
+      }
+
+      function openModal() {
+        mountIn(hosts[hostIndex]);
+        status.textContent = '';
+        if (!dialog.open) dialog.showModal();
+        updateHostUI();
+      }
+
+      openBtn.addEventListener('click', openModal);
+
+      dialog.addEventListener('click', (e) => {
+        const action = e.target.closest('[data-action]')?.dataset.action;
+        if (action === 'move') moveToNext();
+        else if (action === 'close') dialog.close('cancel');
+        else if (e.target === dialog) dialog.close('cancel'); // backdrop click
+      });
+
+      form.addEventListener('submit', (e) => {
+        const comments = form.elements.comments.value.trim();
+        if (!comments) {
+          e.preventDefault();
+          status.textContent = 'Please add a comment before sending.';
+          form.elements.comments.focus();
+          return;
+        }
+        // method="dialog" closes with returnValue "submit".
+      });
+
+      dialog.addEventListener('close', () => {
+        // A close fired as part of re-promoting after a move: the dialog is
+        // already open again, so this is not a real dismissal.
+        if (dialog.open) return;
+        if (dialog.returnValue === 'submit') {
+          form.reset();
+          announcer.textContent = 'Thanks! Your feedback was sent.';
+        }
+        dialog.returnValue = '';
+        updateHostUI();
+        openBtn.focus();
+      });
+
+      updateHostUI();
+    })();
+  </script>
+
