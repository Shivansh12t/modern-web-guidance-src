+  <script>
+    (() => {
+      const form = document.getElementById('shipping-form');
+      const status = document.getElementById('shipping-status');
+      const fields = form.querySelectorAll('input, select, textarea');
+
+      // List a field's error message in aria-describedby only while it is shown.
+      const linkError = (el, shown) => {
+        const errorId = el.dataset.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+
+      // Keep aria-invalid in sync with the CSS :user-invalid state.
+      const syncAria = (el) => {
+        if (!el.matches?.('input, select, textarea')) return;
+        const invalid = el.matches(':user-invalid');
+        el.setAttribute('aria-invalid', invalid ? 'true' : 'false');
+        linkError(el, invalid);
+      };
+
+      fields.forEach(syncAria);
+      form.addEventListener('blur', (e) => syncAria(e.target), true);
+      form.addEventListener('change', (e) => syncAria(e.target), true);
+      form.addEventListener('input', (e) => syncAria(e.target));
+      form.addEventListener('invalid', (e) => syncAria(e.target), true);
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const button = form.querySelector('button[type="submit"]');
+        button.disabled = true;
+        status.textContent = '';
+        try {
+          const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
+          if (!res.ok) throw new Error(res.statusText);
+          status.textContent = 'Delivery address saved. Your next bag of beans is on its way!';
+        } catch {
+          status.textContent = 'Sorry, we couldn\u2019t save your address. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
