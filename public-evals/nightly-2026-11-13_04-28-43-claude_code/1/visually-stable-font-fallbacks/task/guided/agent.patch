   <style>
+    /*
+     * Metric-matched fallback faces.
+     * While the web fonts load (font-display: swap) the browser renders with these
+     * local fonts, rescaled so their average glyph width and line metrics match the
+     * web font. When the swap happens, text keeps (nearly) the same width and line
+     * box height, so nothing reflows. Values were computed from the actual
+     * Inter / Playfair Display font files against Arial / Times New Roman metrics.
+     * Liberation Sans/Serif are metric-compatible clones found on Linux/ChromeOS.
+     */
+    @font-face {
+      font-family: "Inter Fallback";
+      src: local("Arial"), local("ArialMT"), local("Liberation Sans");
+      font-weight: 400;
+      size-adjust: 107.27%;
+      ascent-override: 90.31%;
+      descent-override: 22.49%;
+      line-gap-override: 0%;
+    }
+
+    /* Separate bold face so the browser uses real Arial Bold, not faux-bold. */
+    @font-face {
+      font-family: "Inter Fallback";
+      src: local("Arial Bold"), local("Arial-BoldMT"), local("Liberation Sans Bold");
+      font-weight: 700;
+      size-adjust: 107.27%;
+      ascent-override: 90.31%;
+      descent-override: 22.49%;
+      line-gap-override: 0%;
+    }
+
+    @font-face {
+      font-family: "Playfair Display Fallback";
+      src: local("Times New Roman Bold"), local("TimesNewRomanPS-BoldMT"), local("Liberation Serif Bold");
+      font-weight: 700;
+      size-adjust: 114.58%;
+      ascent-override: 94.43%;
+      descent-override: 21.91%;
+      line-gap-override: 0%;
+    }
+
