+      --font-display: "Playfair Display", "Playfair Display Fallback", Georgia, serif;
+      /* x-height / cap-height aspect values of the web fonts (from their OS/2 tables). */
+      --font-body-ex: 0.546;
+      --font-display-ex: 0.514;
+      --font-display-cap: 0.708;
     }
 
