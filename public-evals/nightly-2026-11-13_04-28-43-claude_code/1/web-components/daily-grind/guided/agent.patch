diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..8a04755
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,267 @@
+/**
+ * <coffee-card> — a menu item card with a persistent "favorite" toggle.
+ *
+ * Light DOM content stays authoritative (readable/crawlable without JS):
+ *   <coffee-card item="cold-brew" image="…" price="$4.75">
+ *     <h3 slot="title">Cold Brew</h3>
+ *     <p>Steeped for 18 hours…</p>
+ *     <a slot="action" href="/menu/cold-brew">View Details</a>
+ *   </coffee-card>
+ *
+ * Attributes:  item (storage key), image, image-alt, price, favorited (reflected)
+ * Events:      favorite-change  { detail: { item, favorited } } — bubbles, composed
+ * Theming:     --coffee-card-bg, --coffee-card-fg, --coffee-card-accent,
+ *              --coffee-card-radius, --coffee-card-shadow
+ * Parts:       media, favorite
+ */
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+const readFavorites = () => {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+};
+
+const writeFavorite = (item, on) => {
+  try {
+    const favs = readFavorites();
+    on ? favs.add(item) : favs.delete(item);
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favs]));
+  } catch {
+    /* storage unavailable (private mode, quota) — state still works for the session */
+  }
+};
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--coffee-card-bg, #fff);
+    --_fg: var(--coffee-card-fg, #3e2723);
+    --_accent: var(--coffee-card-accent, #4e342e);
+    --_radius: var(--coffee-card-radius, 8px);
+    --_shadow: var(--coffee-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+
+    display: block;
+    container-type: inline-size;
+  }
+  :host([hidden]) { display: none; }
+
+  .card {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    background: var(--_bg);
+    color: var(--_fg);
+    border-radius: var(--_radius);
+    box-shadow: var(--_shadow);
+    overflow: hidden;
+    text-align: center;
+    transition: box-shadow 0.2s, translate 0.2s;
+  }
+  .card:hover { box-shadow: 0 6px 16px rgb(0 0 0 / 0.15); }
+  @media (prefers-reduced-motion: no-preference) {
+    .card:hover { translate: 0 -2px; }
+  }
+
+  .media {
+    display: block;
+    width: 100%;
+    aspect-ratio: 4 / 3;
+    object-fit: cover;
+    background: #d7ccc8;
+  }
+  .media[hidden] { display: none; }
+
+  .body {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 20px;
+  }
+
+  ::slotted([slot="title"]) {
+    margin: 0;
+    color: var(--_accent);
+    font-size: 1.2rem;
+  }
+  ::slotted(p) { margin: 0; }
+
+  .price {
+    font-weight: 600;
+    color: var(--_accent);
+  }
+  .price:empty { display: none; }
+
+  .actions { margin-top: auto; padding-top: 0.5rem; }
+
+  ::slotted(a[slot="action"]) {
+    display: inline-block;
+    background: var(--_accent);
+    color: #fff;
+    padding: 10px 20px;
+    border-radius: 5px;
+    text-decoration: none;
+    transition: background 0.3s;
+  }
+  ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+  ::slotted(a[slot="action"]:focus-visible) {
+    outline: 3px solid #ffab40;
+    outline-offset: 2px;
+  }
+
+  .favorite {
+    position: absolute;
+    top: 0.6rem;
+    right: 0.6rem;
+    display: grid;
+    place-items: center;
+    width: 44px;
+    height: 44px;
+    padding: 0;
+    border: none;
+    border-radius: 50%;
+    background: rgb(255 255 255 / 0.92);
+    color: var(--_accent);
+    font: inherit;
+    cursor: pointer;
+    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
+    transition: scale 0.15s;
+  }
+  .favorite:hover { scale: 1.08; }
+  .favorite:focus-visible {
+    outline: 3px solid #ffab40;
+    outline-offset: 2px;
+  }
+  .favorite svg {
+    width: 22px;
+    height: 22px;
+    fill: transparent;
+    stroke: currentColor;
+    stroke-width: 2;
+    transition: fill 0.15s;
+  }
+  .favorite[aria-pressed="true"] { color: #c62828; }
+  .favorite[aria-pressed="true"] svg { fill: currentColor; }
+
+  /* Wide placement (e.g. a single-column region): image beside the text. */
+  @container (min-width: 34rem) {
+    .card { flex-direction: row; text-align: start; }
+    .media { width: 40%; aspect-ratio: auto; }
+    .body { align-items: flex-start; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card">
+    <img class="media" part="media" alt="" loading="lazy" decoding="async" hidden>
+    <button class="favorite" part="favorite" type="button" aria-pressed="false">
+      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <path d="M12 20.5s-7.5-4.6-9.4-9.3C1.3 7.9 3.4 4.5 6.9 4.5c2 0 3.6 1.1 5.1 3 1.5-1.9 3.1-3 5.1-3 3.5 0 5.6 3.4 4.3 6.7-1.9 4.7-9.4 9.3-9.4 9.3z"/>
+      </svg>
+    </button>
+    <div class="body">
+      <slot name="title"></slot>
+      <slot></slot>
+      <span class="price"></span>
+      <div class="actions"><slot name="action"></slot></div>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['image', 'image-alt', 'price', 'favorited'];
+
+  #img;
+  #price;
+  #button;
+  #titleSlot;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#img = root.querySelector('.media');
+    this.#price = root.querySelector('.price');
+    this.#button = root.querySelector('.favorite');
+    this.#titleSlot = root.querySelector('slot[name="title"]');
+
+    this.#button.addEventListener('click', () => this.toggleFavorite());
+    this.#titleSlot.addEventListener('slotchange', () => this.#updateLabel());
+  }
+
+  connectedCallback() {
+    // Restore persisted state unless markup explicitly set it.
+    if (this.item && !this.hasAttribute('favorited') && readFavorites().has(this.item)) {
+      this.toggleAttribute('favorited', true);
+    }
+    this.#updateLabel();
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    switch (name) {
+      case 'image':
+        this.#img.hidden = !value;
+        if (value) this.#img.src = value;
+        else this.#img.removeAttribute('src');
+        break;
+      case 'image-alt':
+        // Default is decorative (alt=""): the title already names the item.
+        this.#img.alt = value ?? '';
+        break;
+      case 'price':
+        this.#price.textContent = value ?? '';
+        break;
+      case 'favorited':
+        this.#button.setAttribute('aria-pressed', String(value !== null));
+        break;
+    }
+  }
+
+  get item() {
+    return this.getAttribute('item') ?? '';
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(on) {
+    this.toggleAttribute('favorited', Boolean(on));
+  }
+
+  get name() {
+    return this.#titleSlot
+      .assignedElements()
+      .map((el) => el.textContent.trim())
+      .join(' ');
+  }
+
+  toggleFavorite(force) {
+    const on = force ?? !this.favorited;
+    if (on === this.favorited) return;
+    this.favorited = on;
+    if (this.item) writeFavorite(this.item, on);
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { item: this.item, favorited: on, name: this.name },
+      }),
+    );
+  }
+
+  #updateLabel() {
+    // Constant name + aria-pressed conveys state; don't flip the label too.
+    this.#button.setAttribute('aria-label', `Favorite ${this.name || 'this drink'}`);
+  }
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
diff --git a/components/coffee-collection.js b/components/coffee-collection.js
new file mode 100644
index 0000000..0a045a1
--- /dev/null
+++ b/components/coffee-collection.js
@@ -0,0 +1,168 @@
+/**
+ * <coffee-collection> — responsive grid of <coffee-card>s with a
+ * "show favorites only" filter and a live favorites count.
+ *
+ *   <coffee-collection>
+ *     <coffee-card …></coffee-card>
+ *     …
+ *   </coffee-collection>
+ *
+ * Attributes:  filter="favorites" (reflected; toggled by the built-in button)
+ * Theming:     --coffee-collection-gap, --coffee-collection-min, --coffee-collection-accent
+ * Parts:       toolbar, filter, status, empty
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_gap: var(--coffee-collection-gap, 20px);
+    --_min: var(--coffee-collection-min, 250px);
+    --_accent: var(--coffee-collection-accent, #4e342e);
+    display: block;
+  }
+  :host([hidden]) { display: none; }
+
+  .toolbar {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: center;
+    gap: 0.75rem 1.25rem;
+    margin-block: 1rem;
+  }
+
+  .filter {
+    font: inherit;
+    font-size: 0.9rem;
+    color: var(--_accent);
+    background: transparent;
+    border: 2px solid var(--_accent);
+    border-radius: 999px;
+    padding: 0.4rem 1rem;
+    min-height: 44px;
+    cursor: pointer;
+    transition: background 0.2s, color 0.2s;
+  }
+  .filter:hover { background: rgb(78 52 46 / 0.08); }
+  .filter[aria-pressed="true"] { background: var(--_accent); color: #fff; }
+  .filter:focus-visible { outline: 3px solid #ffab40; outline-offset: 2px; }
+
+  .status { margin: 0; font-size: 0.9rem; }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(var(--_min), 100%), 1fr));
+    gap: var(--_gap);
+  }
+
+  .empty {
+    margin: 1rem 0 0;
+    padding: 1.5rem;
+    text-align: center;
+    border: 2px dashed #d7ccc8;
+    border-radius: 8px;
+  }
+  .empty[hidden] { display: none; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="toolbar" part="toolbar">
+    <button class="filter" part="filter" type="button" aria-pressed="false">
+      Show favorites only
+    </button>
+    <p class="status" part="status" role="status"></p>
+  </div>
+  <div class="grid"><slot></slot></div>
+  <p class="empty" part="empty" hidden>
+    No favorites yet. Tap the heart on a drink to save it here.
+  </p>
+`;
+
+export class CoffeeCollection extends HTMLElement {
+  static observedAttributes = ['filter'];
+
+  #filterBtn;
+  #status;
+  #empty;
+  #slot;
+  #observer;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#filterBtn = root.querySelector('.filter');
+    this.#status = root.querySelector('.status');
+    this.#empty = root.querySelector('.empty');
+    this.#slot = root.querySelector('slot');
+
+    this.#filterBtn.addEventListener('click', () => {
+      this.favoritesOnly = !this.favoritesOnly;
+    });
+    this.#slot.addEventListener('slotchange', () => this.#render());
+    // Observe the attribute rather than only listening for favorite-change, so state
+    // restored from storage when a card upgrades (after us) is still counted.
+    this.#observer = new MutationObserver(() => this.#render());
+  }
+
+  connectedCallback() {
+    this.#observer.observe(this, {
+      subtree: true,
+      attributes: true,
+      attributeFilter: ['favorited'],
+    });
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#observer.disconnect();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  get favoritesOnly() {
+    return this.getAttribute('filter') === 'favorites';
+  }
+  set favoritesOnly(on) {
+    if (on) this.setAttribute('filter', 'favorites');
+    else this.removeAttribute('filter');
+  }
+
+  get cards() {
+    return this.#slot
+      .assignedElements()
+      .filter((el) => el.localName === 'coffee-card');
+  }
+
+  #render() {
+    const cards = this.cards;
+    const filtering = this.favoritesOnly;
+    let favCount = 0;
+
+    for (const card of cards) {
+      // Cards may not be upgraded yet; fall back to the attribute.
+      const fav = card.hasAttribute('favorited');
+      if (fav) favCount++;
+      card.hidden = filtering && !fav;
+    }
+
+    this.#filterBtn.setAttribute('aria-pressed', String(filtering));
+    this.#empty.hidden = !(filtering && favCount === 0);
+
+    const text =
+      favCount === 0
+        ? 'No favorites saved'
+        : `${favCount} favorite${favCount === 1 ? '' : 's'} saved`;
+    // Only touch the live region when the text changes, to avoid repeat announcements.
+    if (this.#status.textContent !== text) this.#status.textContent = text;
+  }
+}
+
+if (!customElements.get('coffee-collection')) {
+  customElements.define('coffee-collection', CoffeeCollection);
+}
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..5d92439
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,208 @@
+/**
+ * <site-nav> — sticky site header with a collapsible menu on narrow screens.
+ *
+ *   <site-nav label="Main">
+ *     <a slot="brand" href="/">The Daily Grind</a>
+ *     <a href="/menu">Menu</a>
+ *     …
+ *     <a href="/logout" data-variant="outline">Logout</a>
+ *   </site-nav>
+ *
+ * Links stay in the Light DOM, so they work (and are crawlable) before JS loads.
+ * Attributes:  label (accessible name of the nav landmark), open (reflected)
+ * Theming:     --site-nav-bg, --site-nav-fg, --site-nav-accent
+ * Parts:       bar, toggle, menu
+ */
+
+const NARROW = '(max-width: 40rem)';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--site-nav-bg, #4e342e);
+    --_fg: var(--site-nav-fg, #fff);
+    --_accent: var(--site-nav-accent, #ffab40);
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--_bg);
+    color: var(--_fg);
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem 1rem;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot="brand"]) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+    text-transform: uppercase;
+  }
+
+  .menu {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.5rem 20px;
+  }
+
+  ::slotted(a:not([slot])) {
+    color: inherit;
+    font-size: 0.9rem;
+    text-decoration: none;
+    padding: 0.25rem 0;
+    transition: color 0.3s;
+  }
+  ::slotted(a:not([slot]):hover) { color: var(--_accent); }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--_accent);
+    outline-offset: 3px;
+    border-radius: 2px;
+  }
+  ::slotted(a[aria-current="page"]) { color: var(--_accent); }
+  ::slotted(a[data-variant="outline"]) {
+    border: 1px solid var(--_accent);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    min-height: 44px;
+    padding: 0.4rem 0.8rem;
+    font: inherit;
+    font-size: 0.9rem;
+    color: inherit;
+    background: transparent;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    cursor: pointer;
+  }
+  .toggle:focus-visible { outline: 3px solid var(--_accent); outline-offset: 2px; }
+  .bars, .bars::before, .bars::after {
+    display: block;
+    width: 18px;
+    height: 2px;
+    background: currentColor;
+    transition: rotate 0.2s, translate 0.2s, opacity 0.2s;
+  }
+  .bars { position: relative; }
+  .bars::before, .bars::after { content: ""; position: absolute; left: 0; }
+  .bars::before { translate: 0 -6px; }
+  .bars::after { translate: 0 6px; }
+  :host([open]) .bars { background: transparent; }
+  :host([open]) .bars::before { translate: 0; rotate: 45deg; }
+  :host([open]) .bars::after { translate: 0; rotate: -45deg; }
+
+  @media ${NARROW} {
+    .toggle { display: inline-flex; }
+    .menu {
+      display: none;
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0;
+      padding-top: 0.5rem;
+    }
+    :host([open]) .menu { display: flex; }
+    ::slotted(a:not([slot])) { padding: 0.75rem 0; font-size: 1rem; }
+    ::slotted(a[data-variant="outline"]) { margin-top: 0.5rem; text-align: center; }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .bars, .bars::before, .bars::after { transition: none; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="bar">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <span class="bars" aria-hidden="true"></span>
+      Menu
+    </button>
+    <div class="menu" id="menu" part="menu"><slot></slot></div>
+  </nav>
+`;
+
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['open', 'label'];
+
+  #nav;
+  #toggle;
+  #mq = window.matchMedia(NARROW);
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+
+    this.#toggle.addEventListener('click', () => {
+      this.open = !this.open;
+    });
+
+    // Close after choosing a link (handles in-page anchors on mobile).
+    root.querySelector('.menu slot').addEventListener('click', (e) => {
+      if (e.target.closest?.('a') && this.#mq.matches) this.open = false;
+    });
+
+    this.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && this.open) {
+        this.open = false;
+        this.#toggle.focus();
+      }
+    });
+  }
+
+  #onFocusOut = (e) => {
+    // Collapse when keyboard focus leaves the whole component on narrow screens.
+    if (this.open && this.#mq.matches && !this.contains(e.relatedTarget)) {
+      this.open = false;
+    }
+  };
+
+  #onMediaChange = () => {
+    if (!this.#mq.matches) this.open = false;
+  };
+
+  connectedCallback() {
+    if (!this.hasAttribute('label')) this.#nav.setAttribute('aria-label', 'Main');
+    this.addEventListener('focusout', this.#onFocusOut);
+    this.#mq.addEventListener('change', this.#onMediaChange);
+  }
+
+  disconnectedCallback() {
+    this.removeEventListener('focusout', this.#onFocusOut);
+    this.#mq.removeEventListener('change', this.#onMediaChange);
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'open') this.#toggle.setAttribute('aria-expanded', String(value !== null));
+    if (name === 'label') this.#nav.setAttribute('aria-label', value || 'Main');
+  }
+
+  get open() {
+    return this.hasAttribute('open');
+  }
+  set open(on) {
+    this.toggleAttribute('open', Boolean(on));
+  }
+}
+
+if (!customElements.get('site-nav')) customElements.define('site-nav', SiteNav);
