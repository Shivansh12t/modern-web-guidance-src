diff --git a/components/shared-styles.js b/components/shared-styles.js
new file mode 100644
index 0000000..06593ad
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,62 @@
+/**
+ * Shared constructable stylesheets adopted by every Daily Grind component.
+ * Theme tokens are CSS custom properties defined on :root in the page, which
+ * inherit through shadow boundaries, so components stay themeable while their
+ * internal styles remain encapsulated.
+ */
+
+const sheet = (css) => {
+  const s = new CSSStyleSheet();
+  s.replaceSync(css);
+  return s;
+};
+
+export const baseStyles = sheet(`
+  :host {
+    box-sizing: border-box;
+    font-family: inherit;
+    color: var(--text, #3e2723);
+  }
+  *, *::before, *::after { box-sizing: inherit; }
+
+  .visually-hidden {
+    position: absolute !important;
+    width: 1px; height: 1px;
+    padding: 0; margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  :focus-visible {
+    outline: 3px solid var(--focus-ring, var(--accent, #ffab40));
+    outline-offset: 2px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      transition-duration: 0.01ms !important;
+      animation-duration: 0.01ms !important;
+    }
+  }
+`);
+
+/** Button look shared by shadow-DOM buttons/links (.btn) and slotted CTAs. */
+export const buttonCss = `
+  display: inline-block;
+  background: var(--primary, #4e342e);
+  color: #fff;
+  padding: 10px 20px;
+  text-decoration: none;
+  border: 0;
+  border-radius: 5px;
+  font: inherit;
+  cursor: pointer;
+  transition: background 0.3s;
+`;
+
+export const buttonStyles = sheet(`
+  .btn { ${buttonCss} }
+  .btn:hover { background: var(--primary-dark, #3e2723); }
+`);
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..fc64545
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,184 @@
+import { baseStyles } from './shared-styles.js';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--primary, #4e342e);
+    color: #fff;
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    padding: 1rem 5%;
+  }
+
+  .brand ::slotted(*) {
+    color: #fff;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    background: transparent;
+    color: #fff;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    padding: 6px 10px;
+    font: inherit;
+    cursor: pointer;
+  }
+  .bars, .bars::before, .bars::after {
+    display: block;
+    width: 18px;
+    height: 2px;
+    background: currentColor;
+    transition: transform 0.2s;
+  }
+  .bars { position: relative; }
+  .bars::before, .bars::after { content: ""; position: absolute; left: 0; }
+  .bars::before { top: -6px; }
+  .bars::after { top: 6px; }
+  :host([open]) .bars { background: transparent; }
+  :host([open]) .bars::before { transform: translateY(6px) rotate(45deg); }
+  :host([open]) .bars::after { transform: translateY(-6px) rotate(-45deg); }
+
+  .links {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+  }
+
+  ::slotted(a) {
+    color: #fff;
+    text-decoration: none;
+    font-size: 0.9rem;
+    transition: color 0.3s;
+  }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 2px;
+  }
+  ::slotted(a[aria-current="page"]) { color: var(--accent, #ffab40); }
+  ::slotted(a[data-variant="outline"]) {
+    border: 1px solid var(--accent, #ffab40);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  @media (max-width: 720px) {
+    .toggle { display: inline-flex; }
+    .links {
+      display: none;
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 12px;
+      padding-top: 1rem;
+    }
+    :host([open]) .links { display: flex; }
+    ::slotted(a) { font-size: 1rem; }
+  }
+`);
+
+/**
+ * <site-nav> — sticky, responsive site navigation.
+ *
+ * Slots:
+ *   brand   – logo / home link
+ *   default – navigation links (<a>); add data-variant="outline" for a bordered link
+ *
+ * Attributes:
+ *   label – accessible name for the navigation landmark (default "Main")
+ *   open  – reflects whether the mobile menu is expanded
+ *
+ * Mobile: a disclosure button (aria-expanded/aria-controls) toggles the links;
+ * Escape closes the menu and returns focus to the button.
+ */
+class SiteNav extends HTMLElement {
+  static observedAttributes = ['open', 'label'];
+
+  #button;
+  #nav;
+  #mql = window.matchMedia('(max-width: 720px)');
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.innerHTML = `
+      <nav part="nav">
+        <div class="brand"><slot name="brand"></slot></div>
+        <button class="toggle" part="toggle" type="button"
+                aria-expanded="false" aria-controls="links">
+          <span class="bars" aria-hidden="true"></span>
+          <span class="toggle-text">Menu</span>
+        </button>
+        <div class="links" id="links" part="links"><slot></slot></div>
+      </nav>`;
+    this.#nav = root.querySelector('nav');
+    this.#button = root.querySelector('.toggle');
+  }
+
+  connectedCallback() {
+    this.#syncLabel();
+    this.#button.addEventListener('click', this.#onToggle);
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('click', this.#onLinkClick);
+    this.#mql.addEventListener('change', this.#onViewportChange);
+  }
+
+  disconnectedCallback() {
+    this.#button.removeEventListener('click', this.#onToggle);
+    this.removeEventListener('keydown', this.#onKeydown);
+    this.removeEventListener('click', this.#onLinkClick);
+    this.#mql.removeEventListener('change', this.#onViewportChange);
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'open') {
+      this.#button.setAttribute('aria-expanded', String(this.open));
+    } else if (name === 'label') {
+      this.#syncLabel();
+    }
+  }
+
+  get open() { return this.hasAttribute('open'); }
+  set open(value) { this.toggleAttribute('open', Boolean(value)); }
+
+  #syncLabel() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+  }
+
+  #onToggle = () => { this.open = !this.open; };
+
+  #onKeydown = (e) => {
+    if (e.key === 'Escape' && this.open) {
+      this.open = false;
+      this.#button.focus();
+    }
+  };
+
+  // Collapse the mobile menu after choosing a destination (e.g. in-page anchors).
+  #onLinkClick = (e) => {
+    if (this.open && e.target.closest('a') && e.target.closest('a').slot === '') {
+      this.open = false;
+    }
+  };
+
+  #onViewportChange = (e) => { if (!e.matches) this.open = false; };
+}
+
+customElements.define('site-nav', SiteNav);
