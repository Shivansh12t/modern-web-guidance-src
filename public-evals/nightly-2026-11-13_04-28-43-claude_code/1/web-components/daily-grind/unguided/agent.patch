@@ -0,0 +1,88 @@
+import { baseStyles, buttonCss } from './shared-styles.js';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    --hero-overlay: rgba(0, 0, 0, 0.5);
+  }
+
+  .hero {
+    position: relative;
+    min-height: var(--hero-height, 60vh);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 3rem 20px;
+    text-align: center;
+    color: #fff;
+    background-color: var(--primary, #4e342e);
+    background-image:
+      linear-gradient(var(--hero-overlay), var(--hero-overlay)),
+      var(--hero-image, none);
+    background-size: cover;
+    background-position: center;
+  }
+
+  ::slotted([slot="heading"]) {
+    margin: 0 0 0.5rem;
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+  }
+  ::slotted(p) { margin: 0; font-size: 1.1rem; }
+
+  .actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 12px;
+    margin-top: 15px;
+  }
+  .actions ::slotted(a) { ${buttonCss} }
+  .actions ::slotted(a:hover) { background: var(--primary-dark, #3e2723); }
+  .actions ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 3px;
+  }
+`);
+
+/**
+ * <hero-banner> — full-width hero with a background photo and call to action.
+ *
+ * Slots:
+ *   heading – the page heading (use a real <h1> so it stays in the document outline)
+ *   default – supporting copy
+ *   actions – call-to-action links, styled as buttons
+ *
+ * Attributes:
+ *   image – background image URL (decorative; convey meaning in the text)
+ */
+class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.innerHTML = `
+      <div class="hero" part="hero">
+        <slot name="heading"></slot>
+        <slot></slot>
+        <div class="actions" part="actions"><slot name="actions"></slot></div>
+      </div>`;
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name !== 'image') return;
+    const hero = this.shadowRoot.querySelector('.hero');
+    if (value) {
+      hero.style.setProperty('--hero-image', `url(${JSON.stringify(value)})`);
+    } else {
+      hero.style.removeProperty('--hero-image');
+    }
+  }
+}
+
+customElements.define('hero-banner', HeroBanner);
