new file mode 100644
index 0000000..6447769
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,261 @@
+import { baseStyles, buttonStyles } from './shared-styles.js';
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+const readFavorites = () => {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) || []);
+  } catch {
+    return new Set();
+  }
+};
+
+const writeFavorites = (set) => {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) — favorites just won't persist */
+  }
+};
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    container-type: inline-size;
+  }
+
+  article {
+    position: relative;
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+    background: var(--card-bg, #fff);
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    overflow: hidden;
+    text-align: center;
+    transition: box-shadow 0.3s, transform 0.3s;
+  }
+  article:hover,
+  article:focus-within {
+    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
+    transform: translateY(-2px);
+  }
+
+  .media {
+    aspect-ratio: 4 / 3;
+    background: var(--secondary, #d7ccc8);
+  }
+  .media[hidden] { display: none; }
+  .media img {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    padding: 20px;
+  }
+
+  ::slotted([slot="title"]) {
+    margin: 0 0 10px;
+    color: var(--primary, #4e342e);
+    font-size: 1.25rem;
+  }
+  ::slotted(p) { margin: 0; }
+
+  .price {
+    margin-top: 8px;
+    font-weight: 600;
+    color: var(--primary, #4e342e);
+  }
+  .price:empty { display: none; }
+
+  .footer { margin-top: auto; padding-top: 15px; }
+
+  .favorite {
+    position: absolute;
+    top: 10px;
+    right: 10px;
+    display: grid;
+    place-items: center;
+    width: 44px;
+    height: 44px;
+    border: 0;
+    border-radius: 50%;
+    background: rgba(255, 255, 255, 0.92);
+    color: var(--primary, #4e342e);
+    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
+    cursor: pointer;
+    transition: transform 0.15s, color 0.2s;
+  }
+  .favorite:hover { transform: scale(1.08); }
+  .favorite svg { width: 22px; height: 22px; }
+  .favorite path {
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
+  }
+  .favorite[aria-pressed="true"] { color: #c62828; }
+  .favorite[aria-pressed="true"] path { fill: currentColor; }
+
+  @media (forced-colors: active) {
+    .favorite[aria-pressed="true"] path { fill: ButtonText; }
+  }
+`);
+
+/**
+ * <coffee-card> — a menu item card with image, description, details link and
+ * a favorite toggle.
+ *
+ * Slots:
+ *   title   – item name; use a real heading (e.g. <h3>) for document structure
+ *   default – description
+ *
+ * Attributes:
+ *   href       – details page URL (omit to hide the link)
+ *   cta        – link text (default "View Details")
+ *   image      – photo URL
+ *   image-alt  – alt text for the photo (empty = decorative)
+ *   price      – optional price text, e.g. "$5.25"
+ *   item-id    – stable id used to persist favorites (defaults to the title text)
+ *   favorite   – reflects favorite state
+ *
+ * Events:
+ *   favorite-change – { detail: { id, name, favorite } }, bubbles & composed
+ */
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'cta', 'image', 'image-alt', 'price', 'favorite'];
+
+  #els;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, buttonStyles, styles];
+    root.innerHTML = `
+      <article part="card">
+        <div class="media" part="media" hidden>
+          <img loading="lazy" decoding="async" alt="">
+        </div>
+        <button class="favorite" part="favorite" type="button" aria-pressed="false">
+          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+            <path d="M12 21s-7.5-4.6-9.5-9.2C1.1 8.4 3.2 4.5 7 4.5c2 0 3.6 1.1 5 3
+                     1.4-1.9 3-3 5-3 3.8 0 5.9 3.9 4.5 7.3C19.5 16.4 12 21 12 21z"/>
+          </svg>
+          <span class="visually-hidden fav-label"></span>
+        </button>
+        <div class="body" part="body">
+          <slot name="title"></slot>
+          <slot></slot>
+          <p class="price" part="price"></p>
+          <div class="footer">
+            <a class="btn" part="cta" hidden>
+              <span class="cta-text">View Details</span><span class="visually-hidden cta-context"></span>
+            </a>
+          </div>
+        </div>
+      </article>`;
+
+    this.#els = {
+      media: root.querySelector('.media'),
+      img: root.querySelector('img'),
+      fav: root.querySelector('.favorite'),
+      favLabel: root.querySelector('.fav-label'),
+      price: root.querySelector('.price'),
+      link: root.querySelector('a.btn'),
+      ctaText: root.querySelector('.cta-text'),
+      ctaContext: root.querySelector('.cta-context'),
+      titleSlot: root.querySelector('slot[name="title"]'),
+    };
+  }
+
+  connectedCallback() {
+    this.#els.fav.addEventListener('click', this.#onFavoriteClick);
+    this.#els.titleSlot.addEventListener('slotchange', this.#syncName);
+    this.#syncName();
+    if (!this.hasAttribute('favorite') && readFavorites().has(this.itemId)) {
+      this.toggleAttribute('favorite', true);
+    }
+  }
+
+  disconnectedCallback() {
+    this.#els.fav.removeEventListener('click', this.#onFavoriteClick);
+    this.#els.titleSlot.removeEventListener('slotchange', this.#syncName);
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    const els = this.#els;
+    switch (name) {
+      case 'href':
+        if (value) els.link.setAttribute('href', value);
+        else els.link.removeAttribute('href');
+        els.link.hidden = !value;
+        break;
+      case 'cta':
+        els.ctaText.textContent = value || 'View Details';
+        break;
+      case 'image':
+        if (value) els.img.src = value;
+        else els.img.removeAttribute('src');
+        els.media.hidden = !value;
+        break;
+      case 'image-alt':
+        els.img.alt = value ?? '';
+        break;
+      case 'price':
+        els.price.textContent = value ?? '';
+        break;
+      case 'favorite':
+        els.fav.setAttribute('aria-pressed', String(value !== null));
+        break;
+    }
+  }
+
+  /** Plain-text item name taken from the title slot. */
+  get name() {
+    return this.#els.titleSlot
+      .assignedNodes({ flatten: true })
+      .map((n) => n.textContent)
+      .join(' ')
+      .trim();
+  }
+
+  get itemId() {
+    return this.getAttribute('item-id') || this.name;
+  }
+
+  get favorite() { return this.hasAttribute('favorite'); }
+  set favorite(value) { this.toggleAttribute('favorite', Boolean(value)); }
+
+  // Give the repeated "View Details" link and favorite button unique accessible
+  // names (e.g. "View Details about Cold Brew") without changing visible text.
+  #syncName = () => {
+    const name = this.name;
+    this.#els.ctaContext.textContent = name ? ` about ${name}` : '';
+    this.#els.favLabel.textContent = name ? `Favorite ${name}` : 'Favorite';
+  };
+
+  #onFavoriteClick = () => {
+    this.favorite = !this.favorite;
+    const id = this.itemId;
+    const favorites = readFavorites();
+    if (this.favorite) favorites.add(id);
+    else favorites.delete(id);
+    writeFavorites(favorites);
+
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { id, name: this.name, favorite: this.favorite },
+    }));
+  };
+}
+
+customElements.define('coffee-card', CoffeeCard);
