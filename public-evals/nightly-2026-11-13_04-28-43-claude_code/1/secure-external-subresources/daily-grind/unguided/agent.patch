+          integrity: 'sha384-2y1uNpSNOY9ir7wWSFNtQG+DL8lReYC7wjOq+WrBxhmROD2tKOui4uesuYMUZymA'
+        }
+      };
+
+      // CORS request, no cookies/HTTP auth, no Referer header, integrity-checked.
+      function verifiedFetch(asset) {
+        return fetch(asset.url, {
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer',
+          integrity: asset.integrity
+        }).then(function (res) {
+          if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + asset.url);
+          return res;
+        });
+      }
+
+      function warn(what, err) {
+        console.warn('[Daily Grind] Skipped ' + what + ' (failed integrity/network check):', err);
+      }
+
+      // Fonts: load via the FontFace API from verified bytes. Falls back to system fonts on failure.
+      if ('FontFace' in window && document.fonts) {
+        FONTS.forEach(function (f) {
+          verifiedFetch(f)
+            .then(function (res) { return res.arrayBuffer(); })
+            .then(function (buf) {
+              var face = new FontFace(f.family, buf, { weight: f.weight, style: 'normal', display: 'swap' });
+              return face.load();
+            })
+            .then(function (face) { document.fonts.add(face); })
+            .catch(function (err) { warn('font ' + f.family + ' ' + f.weight, err); });
+        });
+      }
+
+      // Images: only verified bytes are turned into object URLs and shown.
+      function loadVerifiedImage(key) {
+        return verifiedFetch(IMAGES[key])
+          .then(function (res) { return res.blob(); })
+          .then(function (blob) { return URL.createObjectURL(blob); });
+      }
+
+      loadVerifiedImage('hero')
+        .then(function (src) {
+          document.querySelector('.hero').style.setProperty('--hero-image', 'url("' + src + '")');
+        })
+        .catch(function (err) { warn('hero image', err); });
+
+      document.querySelectorAll('img[data-verified-image]').forEach(function (img) {
+        var key = img.getAttribute('data-verified-image');
+        if (!IMAGES[key]) return;
+        loadVerifiedImage(key)
+          .then(function (src) {
+            img.addEventListener('load', function () {
+              img.classList.add('is-loaded');
+              URL.revokeObjectURL(src);
+            }, { once: true });
+            img.src = src;
+          })
+          .catch(function (err) { warn('image "' + key + '"', err); });
+      });
+
+      // Icons: the Lucide <script> is deferred and SRI-checked; if it was blocked, `lucide` is undefined.
+      document.addEventListener('DOMContentLoaded', function () {
