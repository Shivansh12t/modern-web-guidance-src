+  <script>
+    (() => {
+      const app = document.getElementById('app');
+      const SITE = 'The Daily Grind';
+      // A fixed, small set of routes, so every visited view can stay cached
+      // without an eviction strategy.
+      const ROUTES = ['home', 'menu', 'locations', 'rewards', 'account'];
+      const views = new Map();        // route -> <section> (kept alive once created)
+      const scrollPositions = new Map();
+      let current = null;
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+      views.set('home', document.getElementById('home-view'));
+
+      function routeFromHash() {
+        const name = location.hash.replace(/^#\/?/, '').split(/[/?]/)[0];
+        return ROUTES.includes(name) ? name : 'home';
+      }
+
+      // Build a view only the first time it's needed; afterwards it's reused as-is.
+      function getView(route) {
+        let view = views.get(route);
+        if (view) return view;
+        const tpl = document.getElementById(`view-${route}`);
+        view = document.createElement('section');
+        view.className = 'spa-view inactive';
+        view.id = `${route}-view`;
+        view.tabIndex = -1;
+        view.dataset.title = tpl.dataset.title;
+        view.setAttribute('aria-label', tpl.dataset.title);
+        view.inert = true;
+        view.append(tpl.content.cloneNode(true));
+        initView[route]?.(view);
+        app.append(view);
+        views.set(route, view);
+        return view;
+      }
+
+      function show(route, { focus = true } = {}) {
+        if (route === current) return;
+        const next = getView(route);
+
+        if (current) {
+          const prev = views.get(current);
+          scrollPositions.set(current, window.scrollY);
+          prev.classList.add('inactive');
+          prev.setAttribute('aria-hidden', 'true');
+          prev.inert = true;
+        }
+
+        next.classList.remove('inactive');
+        next.removeAttribute('aria-hidden');
+        next.inert = false;
+        current = route;
+
+        document.title = next.dataset.title ? `${next.dataset.title} | ${SITE}` : `${SITE} | Artisanal Coffee`;
+        document.querySelectorAll('[data-route]').forEach((a) => {
+          if (a.dataset.route === route) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+
+        window.scrollTo(0, scrollPositions.get(route) ?? 0);
+        if (focus) next.focus({ preventScroll: true });
+      }
+
+      // Per-view behavior, wired once at creation. State lives in the DOM and
+      // survives navigation because views are never destroyed.
+      const initView = {
+        menu(view) {
+          const buttons = view.querySelectorAll('[data-filter]');
+          const status = view.querySelector('[data-order-status]');
+          let count = 0;
+          view.addEventListener('click', (e) => {
+            const filterBtn = e.target.closest('[data-filter]');
+            if (filterBtn) {
+              const f = filterBtn.dataset.filter;
+              buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === filterBtn)));
+              view.querySelectorAll('[data-category]').forEach((card) => {
+                card.hidden = f !== 'all' && card.dataset.category !== f;
+              });
+            }
+            const addBtn = e.target.closest('[data-add]');
+            if (addBtn) {
+              count += 1;
+              const item = addBtn.closest('.card').querySelector('h3').textContent;
+              status.textContent = `Added ${item}. ${count} item${count === 1 ? '' : 's'} in your order.`;
+            }
+          });
+        },
+        locations(view) {
+          const input = view.querySelector('[data-location-search]');
+          const empty = view.querySelector('[data-location-empty]');
+          input.addEventListener('input', () => {
+            const q = input.value.trim().toLowerCase();
+            let shown = 0;
+            view.querySelectorAll('.location-list li').forEach((li) => {
+              const match = li.textContent.toLowerCase().includes(q);
+              li.hidden = !match;
+              if (match) shown += 1;
+            });
+            empty.hidden = shown > 0;
+          });
+        },
+        rewards(view) {
+          const GOAL = 150;
+          let stars = 85;
+          const render = () => {
+            view.querySelector('[data-stars]').textContent = stars;
+            view.querySelector('[data-stars-progress]').value = stars % GOAL;
+            view.querySelector('[data-stars-remaining]').textContent = GOAL - (stars % GOAL);
+          };
+          view.querySelector('[data-checkin]').addEventListener('click', () => {
+            stars += 10;
+            render();
+          });
+        },
+        account(view) {
+          const form = view.querySelector('[data-account-form]');
+          const status = view.querySelector('[data-account-status]');
+          form.addEventListener('submit', (e) => {
+            e.preventDefault();
+            status.textContent = 'Your changes have been saved.';
+          });
+          form.addEventListener('input', () => { status.textContent = ''; });
+        },
+      };
+
+      window.addEventListener('hashchange', () => show(routeFromHash()));
+
+      // Initial render: don't steal focus on page load.
+      show(routeFromHash(), { focus: false });
+    })();
+  </script>
+
 </body>
 
