+  <script>
+    (() => {
+      'use strict';
+
+      const IMG = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=600&q=70`;
+      const $ = (root, ref) => root.querySelector(`[data-ref="${ref}"]`);
+      const esc = (str) => String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+      /* ------------------------------------------------------------------
+       * View definitions. `init` runs exactly once, when the view is first
+       * visited. After that the view's DOM (form input, filters, scroll
+       * position, selections) is kept alive offscreen and simply re-shown.
+       * ---------------------------------------------------------------- */
+      const views = {
+        home: { path: '/', title: 'The Daily Grind | Artisanal Coffee' },
+
+        menu: {
+          path: '/menu',
+          title: 'Menu | The Daily Grind',
+          template: 'tpl-menu',
+          init(root) {
+            const items = [
+              { name: 'Maple Oat Latte', cat: 'espresso', price: 5.25, desc: 'Creamy oat milk with a hint of Vermont maple syrup.', img: '1461023058943-07fcbe16d735' },
+              { name: 'Dark Roast Espresso', cat: 'espresso', price: 3.25, desc: 'Bold, smokey, and perfect for a morning boost.', img: '1510591509098-f4fdc6d0ff04' },
+              { name: 'Cappuccino', cat: 'espresso', price: 4.50, desc: 'Equal parts espresso, steamed milk, and velvety foam.', img: '1509042239860-f550ce710b93' },
+              { name: 'Cold Brew', cat: 'cold', price: 4.95, desc: 'Steeped for 18 hours for maximum smoothness.', img: '1517701604599-bb29b565090c' },
+              { name: 'Iced Vanilla Latte', cat: 'cold', price: 5.45, desc: 'House vanilla, espresso, and cold milk over ice.', img: '1461023058943-07fcbe16d735' },
+              { name: 'Chai Latte', cat: 'tea', price: 4.75, desc: 'Spiced black tea simmered with steamed milk.', img: '1571934811356-5cc061b6821f' },
+              { name: 'Matcha Latte', cat: 'tea', price: 5.25, desc: 'Ceremonial-grade matcha whisked with your choice of milk.', img: '1515823064-d6e0c04616a7' },
+              { name: 'Almond Croissant', cat: 'bakery', price: 4.50, desc: 'Flaky, buttery, and filled with almond frangipane.', img: '1555507036-ab1f4038808a' },
+              { name: 'Blueberry Muffin', cat: 'bakery', price: 3.65, desc: 'Bursting with wild Maine blueberries.', img: '1607958996333-41aef7caefaa' },
+            ];
+            const grid = $(root, 'items');
+            const empty = $(root, 'empty');
+            const search = $(root, 'search');
+            const cartLabel = $(root, 'cart');
+            const cart = new Map();
+            let cat = 'all';
+
+            grid.innerHTML = items.map((it, i) => `
+              <article class="card menu-card" data-i="${i}">
+                <img src="${IMG(it.img)}" alt="${esc(it.name)}" loading="lazy" decoding="async" width="600" height="160">
+                <div class="body">
+                  <h3>${esc(it.name)}</h3>
+                  <p>${esc(it.desc)}</p>
+                  <div class="row">
+                    <span class="price">$${it.price.toFixed(2)}</span>
+                    <button class="btn small" data-add="${i}">Add</button>
+                  </div>
+                </div>
+              </article>`).join('');
+            const cards = [...grid.children];
+
+            const filter = () => {
+              const q = search.value.trim().toLowerCase();
+              let shown = 0;
+              cards.forEach((card, i) => {
+                const it = items[i];
+                const ok = (cat === 'all' || it.cat === cat) &&
+                  (!q || it.name.toLowerCase().includes(q) || it.desc.toLowerCase().includes(q));
+                card.hidden = !ok;
+                if (ok) shown++;
+              });
+              empty.hidden = shown > 0;
+            };
+
+            const renderCart = () => {
+              let count = 0, total = 0;
+              cart.forEach((qty, i) => { count += qty; total += qty * items[i].price; });
+              cartLabel.textContent = count
+                ? `${count} item${count > 1 ? 's' : ''} in your order · $${total.toFixed(2)}`
+                : 'Your order is empty.';
+            };
+
+            root.querySelector('.chips').addEventListener('click', (e) => {
+              const chip = e.target.closest('.chip');
+              if (!chip) return;
+              cat = chip.dataset.cat;
+              root.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
+              filter();
+            });
+            search.addEventListener('input', filter);
+            grid.addEventListener('click', (e) => {
+              const btn = e.target.closest('[data-add]');
+              if (!btn) return;
+              const i = Number(btn.dataset.add);
+              cart.set(i, (cart.get(i) || 0) + 1);
+              renderCart();
+            });
+          },
+        },
+
+        locations: {
+          path: '/locations',
+          title: 'Locations | The Daily Grind',
+          template: 'tpl-locations',
+          init(root) {
+            const locs = [
+              { name: 'Downtown', addr: '120 Main St', hours: [6, 21], phone: '(555) 010-1000', img: '1501339847302-ac426a4a7cbb', perks: 'Drive-thru · Patio seating' },
+              { name: 'Riverside', addr: '48 Water St', hours: [7, 19], phone: '(555) 010-2000', img: '1554118811-1e0d58224f24', perks: 'River views · Dog friendly' },
+              { name: 'Old Town', addr: '9 Cobblestone Ln', hours: [7, 17], phone: '(555) 010-3000', img: '1453614512568-c4024d13c247', perks: 'Historic building · Roastery tours' },
+              { name: 'University', addr: '300 College Ave', hours: [6, 23], phone: '(555) 010-4000', img: '1445116572660-236099ec97a0', perks: 'Late hours · Study rooms' },
+              { name: 'Harbor Point', addr: '77 Pier Rd', hours: [8, 18], phone: '(555) 010-5000', img: '1521017432531-fbd92d768814', perks: 'Waterfront · Live music Fridays' },
+            ];
+            const list = $(root, 'list');
+            const detail = $(root, 'detail');
+            const search = $(root, 'search');
+            const openOnly = $(root, 'openOnly');
+            let selected = 0;
+
+            const isOpen = (l) => { const h = new Date().getHours(); return h >= l.hours[0] && h < l.hours[1]; };
+            const fmt = (h) => `${((h + 11) % 12) + 1}${h < 12 ? 'am' : 'pm'}`;
+
+            list.innerHTML = locs.map((l, i) => `
+              <li><button role="option" data-i="${i}" aria-selected="${i === selected}">
+                <strong>${esc(l.name)}</strong>
+                <span class="badge" data-badge></span><br>
+                <small>${esc(l.addr)} · ${fmt(l.hours[0])}–${fmt(l.hours[1])}</small>
+              </button></li>`).join('');
+            const rows = [...list.children];
+
+            const refreshBadges = () => rows.forEach((li, i) => {
+              const b = li.querySelector('[data-badge]');
+              const open = isOpen(locs[i]);
+              b.textContent = open ? 'Open' : 'Closed';
+              b.classList.toggle('closed', !open);
+            });
+
+            const renderDetail = () => {
+              const l = locs[selected];
+              detail.innerHTML = `
+                <img src="${IMG(l.img)}" alt="${esc(l.name)} café interior" decoding="async" width="600" height="220">
+                <div class="body">
+                  <h3>${esc(l.name)}</h3>
+                  <p>${esc(l.addr)}</p>
+                  <p>Hours: ${fmt(l.hours[0])} – ${fmt(l.hours[1])} daily</p>
+                  <p>Phone: ${esc(l.phone)}</p>
+                  <p><em>${esc(l.perks)}</em></p>
+                  <a class="btn small" target="_blank" rel="noopener"
+                     href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(l.addr)}">Get directions</a>
+                </div>`;
+            };
+
+            const filter = () => {
+              const q = search.value.trim().toLowerCase();
+              rows.forEach((li, i) => {
+                const l = locs[i];
+                li.hidden = !((!q || `${l.name} ${l.addr}`.toLowerCase().includes(q)) && (!openOnly.checked || isOpen(l)));
+              });
+            };
+
+            list.addEventListener('click', (e) => {
+              const btn = e.target.closest('button[data-i]');
+              if (!btn) return;
+              selected = Number(btn.dataset.i);
+              list.querySelectorAll('button').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
+              renderDetail();
+            });
+            search.addEventListener('input', filter);
+            openOnly.addEventListener('change', filter);
+
+            refreshBadges();
+            renderDetail();
+            // Open/closed status is time-dependent: refresh cheaply on every re-show
+            // instead of rebuilding the view.
+            return { onShow() { refreshBadges(); filter(); } };
+          },
+        },
+
+        rewards: {
+          path: '/rewards',
+          title: 'Rewards | The Daily Grind',
+          template: 'tpl-rewards',
+          init(root) {
+            const perks = [
+              { name: 'Extra Shot or Syrup', cost: 25 },
+              { name: 'Any Bakery Item', cost: 100 },
+              { name: 'Any Handcrafted Drink', cost: 150 },
+              { name: 'Bag of Whole Beans', cost: 400 },
+            ];
+            let points = 235;
+            const history = [
+              ['Nov 11 · Maple Oat Latte', '+52'],
+              ['Nov 8 · Cold Brew', '+49'],
+              ['Nov 3 · Redeemed Bakery Item', '−100'],
+            ];
+            const pointsEl = $(root, 'points');
+            const bar = $(root, 'bar');
+            const next = $(root, 'next');
+            const histEl = $(root, 'history');
+            const perksEl = $(root, 'perks');
+
+            perksEl.innerHTML = perks.map((p, i) => `
+              <div class="card">
+                <h3>${esc(p.name)}</h3>
+                <p>${p.cost} stars</p>
+                <button class="btn small accent" data-redeem="${i}" style="margin-top:12px">Redeem</button>
+              </div>`).join('');
+            const buttons = [...perksEl.querySelectorAll('[data-redeem]')];
+
+            const render = () => {
+              pointsEl.textContent = points;
+              const goal = perks.find((p) => p.cost > points);
+              bar.style.width = goal ? `${Math.round((points / goal.cost) * 100)}%` : '100%';
+              next.textContent = goal
+                ? `${goal.cost - points} stars until ${goal.name}`
+                : 'You can redeem any reward!';
+              histEl.innerHTML = history.slice(0, 6)
+                .map(([label, delta]) => `<li><span>${esc(label)}</span><strong>${esc(delta)}</strong></li>`).join('');
+              buttons.forEach((b, i) => { b.disabled = perks[i].cost > points; });
+            };
+
+            perksEl.addEventListener('click', (e) => {
+              const btn = e.target.closest('[data-redeem]');
+              if (!btn || btn.disabled) return;
+              const p = perks[Number(btn.dataset.redeem)];
+              points -= p.cost;
+              history.unshift([`Today · Redeemed ${p.name}`, `−${p.cost}`]);
+              render();
+            });
+            render();
+          },
+        },
+
+        account: {
+          path: '/account',
+          title: 'My Account | The Daily Grind',
+          template: 'tpl-account',
+          init(root) {
+            const tabs = [...root.querySelectorAll('[role="tab"]')];
+            const panels = [...root.querySelectorAll('[role="tabpanel"]')];
+            root.querySelector('.tabs').addEventListener('click', (e) => {
+              const tab = e.target.closest('[role="tab"]');
+              if (!tab) return;
+              tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
+              panels.forEach((p) => { p.hidden = p.dataset.panel !== tab.dataset.tab; });
+            });
+            const form = $(root, 'profileForm');
+            const saved = $(root, 'saved');
+            form.addEventListener('submit', (e) => {
+              e.preventDefault();
+              saved.textContent = 'Saved ✓';
+              setTimeout(() => { saved.textContent = ''; }, 2500);
+            });
+            form.addEventListener('input', () => { saved.textContent = ''; });
+          },
+        },
+      };
+
+      /* ------------------------------------------------------------------
+       * Router with a keep-alive view cache.
+       * ---------------------------------------------------------------- */
+      const app = document.getElementById('app');
+      const navLinks = [...document.querySelectorAll('a[data-route]')];
+      const cache = new Map();            // name -> { el, hooks, scrollY }
+      let current = null;
+
+      // Home is already in the DOM.
+      cache.set('home', { el: app.querySelector('[data-view="home"]'), hooks: null, scrollY: 0 });
+
+      const routeFromPath = (path) => {
+        const clean = path.replace(/\/+$/, '') || '/';
+        return Object.keys(views).find((k) => views[k].path === clean) || null;
+      };
+
+      const getView = (name) => {
+        let entry = cache.get(name);
+        if (entry) return entry;
+        const def = views[name];
+        const el = document.createElement('div');
+        el.className = 'view is-inactive';
+        el.dataset.view = name;
+        el.tabIndex = -1;
+        el.inert = true;
+        el.appendChild(document.getElementById(def.template).content.cloneNode(true));
+        app.appendChild(el);
+        entry = { el, hooks: def.init ? def.init(el) || null : null, scrollY: 0 };
+        cache.set(name, entry);
+        return entry;
+      };
+
+      const show = (name, { restoreScroll = false } = {}) => {
+        if (name === current) return;
+        const next = getView(name);
+
+        if (current) {
+          const prev = cache.get(current);
+          prev.scrollY = window.scrollY;     // remember where the user was
+          prev.el.classList.add('is-inactive');
+          prev.el.inert = true;              // no focus / AT access while offscreen
+          prev.hooks?.onHide?.();
+        }
+
+        next.el.classList.remove('is-inactive');
+        next.el.inert = false;
+        next.hooks?.onShow?.();
+        current = name;
+
+        document.title = views[name].title;
+        navLinks.forEach((a) => {
+          if (a.dataset.route === name) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+
+        window.scrollTo(0, restoreScroll ? next.scrollY : 0);
+        next.el.focus({ preventScroll: true });
+      };
+
+      const navigate = (name) => {
+        if (name === current) return;
+        // Persist scroll of the view we're leaving into its history entry too.
+        history.replaceState({ ...(history.state || {}), view: current, scrollY: window.scrollY }, '');
+        history.pushState({ view: name }, '', views[name].path);
+        show(name);
+      };
+
+      // Intercept internal SPA links (nav + logo).
+      document.addEventListener('click', (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const a = e.target.closest('a[href]');
+        if (!a || a.target === '_blank' || a.origin !== location.origin) return;
+        const name = routeFromPath(a.pathname);
+        if (!name) return;                    // non-SPA link: let the browser handle it
+        e.preventDefault();
+        navigate(name);
+      });
+
+      window.addEventListener('popstate', (e) => {
+        const name = e.state?.view || routeFromPath(location.pathname) || 'home';
+        show(name, { restoreScroll: true });
+      });
+
+      // Warm up views during idle time so even the first visit is instant.
+      const idle = window.requestIdleCallback || ((cb) => setTimeout(cb, 200));
+      const prefetch = (name) => { if (!cache.has(name)) getView(name); };
+      navLinks.forEach((a) => {
+        const name = a.dataset.route;
+        a.addEventListener('pointerenter', () => prefetch(name), { once: true });
+        a.addEventListener('focus', () => prefetch(name), { once: true });
+      });
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+      // Initial route (supports deep links when the server falls back to index.html).
+      // Static hosts without SPA fallback serve /menu/index.html etc., which
+      // redirect to /?view=menu; normalise that back to the clean URL.
+      const viewParam = new URLSearchParams(location.search).get('view');
+      const initial = (viewParam in views && viewParam) || routeFromPath(location.pathname) || 'home';
+      if (initial !== 'home') {
+        const home = cache.get('home').el;
+        home.classList.add('is-inactive');
+        home.inert = true;
+      }
+      history.replaceState({ view: initial }, '', views[initial].path + location.hash);
+      show(initial);
+      idle(() => Object.keys(views).forEach((n) => idle(() => prefetch(n))));
+    })();
+  </script>
+
