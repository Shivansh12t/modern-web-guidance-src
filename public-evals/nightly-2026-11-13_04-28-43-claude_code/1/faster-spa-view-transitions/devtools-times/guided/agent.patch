+import { getCollection, type CollectionEntry, type RenderResult } from 'astro:content';
+
+/** The client-side SPA views reachable from the main section navigation. */
+export const SECTIONS = [
+  { id: 'top-news', label: 'Top News', path: '' },
+  { id: 'world', label: 'World', path: 'world' },
+  { id: 'politics', label: 'Politics', path: 'politics' },
+  { id: 'multimedia', label: 'Multimedia', path: 'multimedia' },
+  { id: 'reports', label: 'Reports', path: 'reports' },
+] as const;
+
+export type SectionId = (typeof SECTIONS)[number]['id'];
+
+const SITE_TITLE = 'The DevTools Times';
+
+export function isSectionId(value: unknown): value is SectionId {
+  return SECTIONS.some((section) => section.id === value);
+}
+
+export function getSection(id: SectionId) {
+  return SECTIONS.find((section) => section.id === id)!;
+}
+
+export function sectionHref(id: SectionId) {
+  return `${import.meta.env.BASE_URL}${getSection(id).path}`;
+}
+
+export function sectionTitle(id: SectionId) {
+  return id === 'top-news' ? SITE_TITLE : `${getSection(id).label} | ${SITE_TITLE}`;
+}
+
+export async function getFrontPageArticles() {
+  const articles = await getCollection('articles');
+  articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+  const politics = articles.slice(11, 15);
+  // Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+  politics[2] = {
+    id: 'public-transit-overhaul',
+    data: {
+      title: "What's new in DevTools",
+      summary:
+        'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+      author: 'Chrome DevTools Team',
+      date: new Date('2025-09-16T00:00:00.000Z'),
+      category: 'Web Development',
+      image:
+        'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+      image_caption: '',
+      readingTime: 3,
+    },
+    body: '',
+    collection: 'articles',
+    slug: 'public-transit-overhaul',
+    render: async () => '' as unknown as RenderResult,
+  } as unknown as CollectionEntry<'articles'>;
+
+  return {
+    topArticle: articles[0],
+    topStories: articles.slice(1, 4),
+    topNews: articles.slice(4, 8),
+    world: articles.slice(8, 11),
+    politics,
+  };
+}
