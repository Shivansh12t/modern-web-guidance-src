diff --git a/src/components/sections/SectionView.astro b/src/components/sections/SectionView.astro
new file mode 100644
index 0000000..992c218
--- /dev/null
+++ b/src/components/sections/SectionView.astro
@@ -0,0 +1,106 @@
+---
+import { getCollection } from 'astro:content';
+import ArticleTeaser from '../ArticleTeaser.astro';
+import TopStoryTeaserGrid from '../TopStoryTeaserGrid.astro';
+import SimpleTeaserGrid from '../SimpleTeaserGrid.astro';
+import Ad from '../AdSlotBanner';
+import { getFrontPageArticles, sectionTitle, getSection, type SectionId } from '../../utils/sections';
+
+export interface Props {
+  id: SectionId;
+  active?: boolean;
+}
+
+const { id, active = true } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL;
+const label = getSection(id).label;
+
+const needsArticles = id === 'top-news' || id === 'world' || id === 'politics';
+const articles = needsArticles ? await getFrontPageArticles() : null;
+const listItems =
+  id === 'multimedia'
+    ? await getCollection('multimedia')
+    : id === 'reports'
+      ? await getCollection('reports')
+      : [];
+listItems.sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate));
+---
+
+<section
+  class="spa-view"
+  data-spa-view-id={id}
+  data-title={sectionTitle(id)}
+  aria-label={label}
+  tabindex="-1"
+  data-inactive={active ? undefined : ''}
+  inert={!active}
+>
+  {id === 'top-news' && articles && (
+    <>
+      <div class="bg-white border-b border-gray-300">
+        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+            {articles.topStories.map((article) => (
+              <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
+                <a href={`${baseUrl}articles/${article.id}`}>
+                  <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                </a>
+                <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+
+      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+        <ArticleTeaser article={articles.topArticle} large={true} />
+      </div>
+
+      <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+        <section class="p-4 md:p-6 text-center">
+          <Ad client:visible />
+        </section>
+        <TopStoryTeaserGrid title="Top News" articles={articles.topNews} />
+      </div>
+    </>
+  )}
+
+  {id === 'world' && articles && (
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+      <SimpleTeaserGrid title="World" articles={articles.world} />
+      <section class="p-4 md:p-6 text-center">
+        <Ad client:visible />
+      </section>
+    </div>
+  )}
+
+  {id === 'politics' && articles && (
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+      <TopStoryTeaserGrid title="Politics" articles={articles.politics} />
+      <section class="p-4 md:p-6 text-center">
+        <Ad client:visible />
+      </section>
+    </div>
+  )}
+
+  {(id === 'multimedia' || id === 'reports') && (
+    <div class="max-w-6xl mx-auto p-4 md:p-6">
+      <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">{label}</h2>
+      <p class="text-gray-700 mb-6">
+        {id === 'multimedia' ? 'Watch our latest multimedia content.' : 'Read our latest reports.'}
+      </p>
+      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
+        {listItems.map((item) => (
+          <li class="flex flex-col shadow-sm p-4 sm:p-6 h-full">
+            <span class="text-amber-800 text-sm font-brand tracking-widest">{item.data.category}</span>
+            <h3 class="text-2xl font-brand text-gray-900 mt-1 mb-2">{item.data.title}</h3>
+            <p class="text-gray-700 flex-grow">{item.data.description}</p>
+            <time datetime={item.data.publishDate} class="text-xs text-gray-500 mt-4 pt-2 border-t border-gray-100">
+              {new Date(item.data.publishDate).toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
+            </time>
+          </li>
+        ))}
+      </ul>
+    </div>
+  )}
+</section>
