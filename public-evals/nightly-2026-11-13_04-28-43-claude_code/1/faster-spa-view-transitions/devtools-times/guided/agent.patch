+}
+/*
+ * Client-side section views (see src/scripts/spa-views.ts).
+ * Inactive views stay in the DOM with `content-visibility: hidden`, which skips their
+ * layout/paint but keeps their rendering state cached, so switching back is fast.
+ */
+.spa-views {
+  position: relative;
+}
+
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view[data-inactive] {
+  content-visibility: hidden;
+  position: absolute;
+  inset-block-start: 0;
+  inset-inline: 0;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view[data-inactive] {
+    display: none;
+  }
+}
+
+.section-link[aria-current="page"] {
+  border-block-end-color: currentColor;
+  color: var(--color-amber-800);
+}
+
+@media (forced-colors: active) {
+  .section-link[aria-current="page"] {
+    border-block-end-color: CanvasText;
+  }
+}
