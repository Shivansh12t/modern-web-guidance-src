diff --git a/src/scripts/spa-views.ts b/src/scripts/spa-views.ts
new file mode 100644
index 0000000..b7ccc46
--- /dev/null
+++ b/src/scripts/spa-views.ts
@@ -0,0 +1,143 @@
+/**
+ * Client-side SPA views for the main section navigation.
+ *
+ * Section-to-section navigations are routed through Astro's ClientRouter (so history,
+ * scroll restoration and view transitions keep working), but instead of fetching and
+ * swapping the whole document we:
+ *   1. fetch the target view as an HTML fragment the first time it is visited,
+ *   2. keep every visited view in the DOM, hidden with `content-visibility: hidden`
+ *      (which preserves its rendering state) and `inert`,
+ *   3. switch views by toggling those attributes.
+ *
+ * Views are never detached from the document: Astro unmounts islands that are
+ * disconnected during a swap, so detaching would kill their hydrated state.
+ */
+import type {
+  TransitionBeforePreparationEvent,
+  TransitionBeforeSwapEvent,
+} from 'astro:transitions/client';
+
+const fragmentRequests = new Map<string, Promise<string>>();
+let pending: { viewId: string; signal: AbortSignal } | null = null;
+
+const normalize = (path: string) => path.replace(/\/+$/, '');
+
+const getHost = () => document.querySelector<HTMLElement>('[data-spa-host]');
+
+const getView = (host: ParentNode, viewId: string) =>
+  host.querySelector<HTMLElement>(`:scope > [data-spa-view-id="${CSS.escape(viewId)}"]`);
+
+/** Maps a URL to a section view id using the section nav links on the page. */
+function viewIdForUrl(url: URL): string | null {
+  if (url.origin !== location.origin || url.search) return null;
+  const target = normalize(url.pathname);
+  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-spa-link]')) {
+    if (normalize(new URL(link.href).pathname) === target) return link.dataset.spaLink!;
+  }
+  return null;
+}
+
+/** Fetches (once, shared between prefetch and navigation) the HTML of a view. */
+function fetchFragment(host: HTMLElement, viewId: string): Promise<string> {
+  let request = fragmentRequests.get(viewId);
+  if (!request) {
+    request = fetch(`${host.dataset.fragmentBase}${encodeURIComponent(viewId)}`, {
+      headers: { Accept: 'text/html' },
+    }).then((response) => {
+      if (!response.ok) throw new Error(`Failed to load view "${viewId}": ${response.status}`);
+      return response.text();
+    });
+    request.catch(() => fragmentRequests.delete(viewId));
+    fragmentRequests.set(viewId, request);
+  }
+  return request;
+}
+
+/** Returns the view element, fetching and inserting it (inactive) if it isn't cached yet. */
+async function ensureView(host: HTMLElement, viewId: string): Promise<HTMLElement> {
+  const cached = getView(host, viewId);
+  if (cached) return cached;
+
+  const html = await fetchFragment(host, viewId);
+  // Another navigation may have inserted it while we were waiting.
+  const raced = getView(host, viewId);
+  if (raced) return raced;
+
+  const template = document.createElement('template');
+  template.innerHTML = html;
+  const view = template.content.querySelector<HTMLElement>(`[data-spa-view-id="${CSS.escape(viewId)}"]`);
+  if (!view) throw new Error(`Fragment for view "${viewId}" has no view element`);
+  setInactive(view, true);
+  // Inline island bootstrap scripts inside the view are executed by Astro's router
+  // (runScripts) right after the swap, which hydrates the view's islands.
+  host.append(view);
+  // The fragment has been consumed; future visits reuse the DOM node, not the HTML.
+  fragmentRequests.delete(viewId);
+  return view;
+}
+
+function setInactive(view: HTMLElement, inactive: boolean) {
+  view.toggleAttribute('data-inactive', inactive);
+  view.inert = inactive;
+}
+
+function activate(host: HTMLElement, viewId: string) {
+  let target: HTMLElement | null = null;
+  for (const view of host.querySelectorAll<HTMLElement>(':scope > [data-spa-view-id]')) {
+    const isTarget = view.dataset.spaViewId === viewId;
+    setInactive(view, !isTarget);
+    if (isTarget) target = view;
+  }
+  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-spa-link]')) {
+    if (link.dataset.spaLink === viewId) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  }
+  if (target) {
+    // Astro's router reads document.title after the swap to label the history entry.
+    if (target.dataset.title) document.title = target.dataset.title;
+    target.focus({ preventScroll: true });
+  }
+}
+
+document.addEventListener('astro:before-preparation', (event) => {
+  const ev = event as TransitionBeforePreparationEvent;
+  pending = null;
+  const host = getHost();
+  if (!host || ev.formData) return;
+  // Only intercept when both the current and the target page are section views.
+  if (!viewIdForUrl(ev.from)) return;
+  const viewId = viewIdForUrl(ev.to);
+  if (!viewId) return;
+
+  const defaultLoader = ev.loader;
+  ev.loader = async () => {
+    try {
+      await ensureView(host, viewId);
+      if (!ev.signal.aborted) pending = { viewId, signal: ev.signal };
+    } catch (error) {
+      console.warn('[spa-views] falling back to a full page swap', error);
+      if (!ev.signal.aborted) await defaultLoader();
+    }
+  };
+});
+
+document.addEventListener('astro:before-swap', (event) => {
+  const ev = event as TransitionBeforeSwapEvent;
+  const current = pending;
+  pending = null;
+  if (!current || current.signal !== ev.signal) return;
+  const host = getHost();
+  if (!host) return;
+  ev.swap = () => activate(host, current.viewId);
+});
+
+// Warm the fragment cache when the user signals intent to visit a section.
+const prefetch = (event: Event) => {
+  const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-spa-link]');
+  const host = getHost();
+  if (!link || !host) return;
+  const viewId = link.dataset.spaLink!;
+  if (!getView(host, viewId)) fetchFragment(host, viewId).catch(() => {});
+};
+document.addEventListener('pointerover', prefetch, { passive: true });
+document.addEventListener('focusin', prefetch);
