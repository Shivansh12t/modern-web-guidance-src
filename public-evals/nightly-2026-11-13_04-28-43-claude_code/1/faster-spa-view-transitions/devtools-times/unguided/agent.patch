diff --git a/src/utils/sections.ts b/src/utils/sections.ts
new file mode 100644
index 0000000..580467f
--- /dev/null
+++ b/src/utils/sections.ts
@@ -0,0 +1,64 @@
+import { getCollection, type CollectionEntry, type RenderResult } from 'astro:content';
+
+/**
+ * The main sections of the front page. Each one is a client-side "view" of a
+ * single SPA shell (see components/SectionViews.astro) that is also reachable
+ * as a real, server-rendered URL so deep links / reloads keep working.
+ */
+export const SECTION_VIEWS = [
+    { id: 'top', label: 'Top News', path: '', title: 'The DevTools Times' },
+    { id: 'world', label: 'World', path: 'world', title: 'World | The DevTools Times' },
+    { id: 'politics', label: 'Politics', path: 'politics', title: 'Politics | The DevTools Times' },
+    { id: 'multimedia', label: 'Multimedia', path: 'multimedia', title: 'Multimedia | The DevTools Times' },
+    { id: 'reports', label: 'Reports', path: 'reports', title: 'Reports | The DevTools Times' },
+] as const;
+
+export type SectionViewId = (typeof SECTION_VIEWS)[number]['id'];
+
+export const getSectionView = (id: SectionViewId) => SECTION_VIEWS.find((view) => view.id === id)!;
+
+export async function getSectionData() {
+    const articles = await getCollection('articles');
+    articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+    const topArticle = articles[0];
+    const topStories = articles.slice(1, 4);
+    const topNewsArticles = articles.slice(4, 8);
+    const worldNewsArticles = articles.slice(8, 11);
+    const politicsArticles = articles.slice(11, 15);
+
+    // Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+    politicsArticles[2] = {
+        id: 'public-transit-overhaul',
+        data: {
+            title: 'What\'s new in DevTools',
+            summary: 'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+            author: 'Chrome DevTools Team',
+            date: new Date('2025-09-16T00:00:00.000Z'),
+            category: 'Web Development',
+            image: 'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+            image_caption: '',
+            readingTime: 3,
+        },
+        body: '',
+        collection: 'articles',
+        slug: 'public-transit-overhaul',
+        render: async () => '' as unknown as RenderResult,
+    } as unknown as CollectionEntry<'articles'>;
+
+    const byDateDesc = (a: { data: { publishDate: string } }, b: { data: { publishDate: string } }) =>
+        b.data.publishDate.localeCompare(a.data.publishDate);
+
+    const multimedia = (await getCollection('multimedia')).sort(byDateDesc);
+    const reports = (await getCollection('reports')).sort(byDateDesc);
+
+    return {
+        topArticle,
+        topStories,
+        topNewsArticles,
+        worldNewsArticles,
+        politicsArticles,
+        multimedia,
+        reports,
+    };
+}
