--- /dev/null
+++ b/src/components/SectionViewContent.astro
@@ -0,0 +1,92 @@
+---
+import ArticleTeaser from './ArticleTeaser.astro';
+import TopStoryTeaserGrid from './TopStoryTeaserGrid.astro';
+import SimpleTeaserGrid from './SimpleTeaserGrid.astro';
+import Ad from './AdSlotBanner';
+import type { SectionViewId, getSectionData } from '../utils/sections';
+
+export interface Props {
+    view: SectionViewId;
+    data: Awaited<ReturnType<typeof getSectionData>>;
+}
+
+const { view, data } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL;
+const formatDate = (value: string) =>
+    new Date(value).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
+---
+
+{view === 'top' && (
+    <Fragment>
+        <!-- Top Stories Bar -->
+        <div class="bg-white border-b border-gray-300">
+            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+                    {data.topStories.map(article => (
+                        <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
+                            <a href={`${baseUrl}articles/${article.id}`}>
+                                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                            </a>
+                            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                        </div>
+                    ))}
+                </div>
+            </div>
+        </div>
+
+        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+            <ArticleTeaser article={data.topArticle} large={true} />
+        </div>
+
+        <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+            <section class="p-4 md:p-6 text-center">
+                <Ad client:visible />
+            </section>
+            <TopStoryTeaserGrid title="Top News" articles={data.topNewsArticles} />
+        </div>
+    </Fragment>
+)}
+
+{view === 'world' && (
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+        <SimpleTeaserGrid title="World" articles={data.worldNewsArticles} />
+        <section class="p-4 md:p-6 text-center">
+            <Ad client:visible />
+        </section>
+    </div>
+)}
+
+{view === 'politics' && (
+    <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+        <TopStoryTeaserGrid title="Politics" articles={data.politicsArticles} />
+        <section class="p-4 md:p-6 text-center">
+            <Ad client:visible />
+        </section>
+    </div>
+)}
+
+{(view === 'multimedia' || view === 'reports') && (
+    <section class="max-w-6xl mx-auto p-4 md:p-6">
+        <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-2">
+            {view === 'multimedia' ? 'Multimedia' : 'Reports'}
+        </h2>
+        <p class="text-gray-600 mb-6 lg:mb-8">
+            {view === 'multimedia' ? 'Watch our latest multimedia content.' : 'Read our latest reports.'}
+        </p>
+        <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
+            {(view === 'multimedia' ? data.multimedia : data.reports).map(item => (
+                <li class="flex items-start gap-3 p-4 shadow-sm h-full">
+                    <div class={`w-12 h-12 rounded flex items-center justify-center flex-shrink-0 font-semibold ${view === 'multimedia' ? 'bg-blue-100 text-blue-800' : 'bg-yellow-100 text-yellow-800'}`}>
+                        {item.data.title.charAt(0)}
+                    </div>
+                    <div class="flex flex-col">
+                        <span class="text-amber-800 text-sm font-brand tracking-widest">{item.data.category}</span>
+                        <h3 class="text-xl font-brand text-gray-800">{item.data.title}</h3>
+                        <p class="text-gray-600 mt-1">{item.data.description}</p>
+                        <span class="text-xs text-gray-500 mt-2">{formatDate(item.data.publishDate)}</span>
+                    </div>
+                </li>
+            ))}
+        </ul>
+    </section>
+)}
diff --git a/src/components/SectionViews.astro b/src/components/SectionViews.astro
new file mode 100644
index 0000000..10f40af
--- /dev/null
+++ b/src/components/SectionViews.astro
@@ -0,0 +1,186 @@
+---
+/**
+ * SPA shell for the main sections (Top News, World, Politics, Multimedia, Reports).
+ *
+ * - The requested section is rendered live; every other section is shipped
+ *   inside an inert <template> and only turned into DOM the first time it is
+ *   visited (or when its tab is hovered/focused, as a warm-up).
+ * - Switching sections is done client-side by hooking into Astro's ClientRouter
+ *   (no fetch, no body swap). Visited views stay mounted offscreen
+ *   (content-visibility: hidden + inert), so returning to one is just a style
+ *   flip: DOM, hydrated islands and their state are preserved.
+ * - Every section has its own real URL, so reloads, deep links and
+ *   non-JS navigation keep working.
+ */
+import SectionViewContent from './SectionViewContent.astro';
+import { SECTION_VIEWS, getSectionData, type SectionViewId } from '../utils/sections';
+
+export interface Props {
+    initial: SectionViewId;
+}
+
+const { initial } = Astro.props;
+const data = await getSectionData();
+const baseUrl = import.meta.env.BASE_URL;
+const views = SECTION_VIEWS.map((view) => ({ ...view, href: `${baseUrl}${view.path}` }));
+---
+
+<div data-section-views data-active={initial}>
+    <nav aria-label="Sections" class="sticky top-0 z-[5] bg-white border-b border-gray-300">
+        <ul class="max-w-6xl mx-auto px-4 flex justify-center items-center gap-6 h-11 text-sm font-semibold overflow-x-auto">
+            {views.map((view) => (
+                <li class="h-full">
+                    <a
+                        href={view.href}
+                        data-section-link={view.id}
+                        aria-current={view.id === initial ? 'page' : undefined}
+                        class="h-full flex items-center border-b-2 border-transparent whitespace-nowrap hover:text-gray-600 aria-[current=page]:border-amber-400 aria-[current=page]:text-amber-500"
+                    >
+                        {view.label}
+                    </a>
+                </li>
+            ))}
+        </ul>
+    </nav>
+
+    {views.map((view) =>
+        view.id === initial ? (
+            <div class="section-view" data-view-id={view.id} data-view-path={view.href} data-view-title={view.title}>
+                <SectionViewContent view={view.id} data={data} />
+            </div>
+        ) : (
+            <template data-view-id={view.id} data-view-path={view.href} data-view-title={view.title}>
+                <SectionViewContent view={view.id} data={data} />
+            </template>
+        )
+    )}
+</div>
+
+<style is:global>
+    .section-view[data-inactive] {
+        /* Keep the subtree (and its rendering state) alive but skip layout/paint. */
+        content-visibility: hidden;
+    }
+    @supports not (content-visibility: hidden) {
+        .section-view[data-inactive] {
+            display: none;
+        }
+    }
+</style>
+
+<script>
+    import type {
+        TransitionBeforePreparationEvent,
+        TransitionBeforeSwapEvent,
+    } from 'astro:transitions/client';
+
+    const ROOT_SELECTOR = '[data-section-views]';
+
+    const getRoot = () => document.querySelector<HTMLElement>(ROOT_SELECTOR);
+    const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
+
+    /** Live views and not-yet-instantiated templates, in document order. */
+    const viewNodes = (root: HTMLElement) =>
+        root.querySelectorAll<HTMLElement>(':scope > .section-view, :scope > template[data-view-id]');
+
+    function viewIdForUrl(root: HTMLElement, url: URL): string | null {
+        if (url.origin !== location.origin) return null;
+        const path = normalizePath(url.pathname);
+        for (const node of viewNodes(root)) {
+            if (normalizePath(node.dataset.viewPath ?? '') === path) return node.dataset.viewId ?? null;
+        }
+        return null;
+    }
+
+    /**
+     * Astro only emits island bootstrap / directive scripts once per page, so they
+     * may live inside a template that is never opened. Run them up front, once.
+     */
+    function hoistTemplateScripts(root: HTMLElement) {
+        for (const template of root.querySelectorAll<HTMLTemplateElement>(':scope > template[data-view-id]')) {
+            for (const original of template.content.querySelectorAll('script')) {
+                const script = document.createElement('script');
+                for (const attr of original.attributes) script.setAttribute(attr.name, attr.value);
+                script.textContent = original.textContent;
+                script.dataset.astroExec = '';
+                document.body.append(script);
+                original.remove();
+            }
+        }
+    }
+
+    /** Returns the live view element, creating it from its template on first use. */
+    function ensureView(root: HTMLElement, id: string): HTMLElement | null {
+        const existing = root.querySelector<HTMLElement>(`:scope > .section-view[data-view-id="${id}"]`);
+        if (existing) return existing;
+
+        const template = root.querySelector<HTMLTemplateElement>(`:scope > template[data-view-id="${id}"]`);
+        if (!template) return null;
+        hoistTemplateScripts(root);
+
+        const view = document.createElement('div');
+        view.className = 'section-view';
+        Object.assign(view.dataset, template.dataset);
+        view.dataset.inactive = '';
+        view.inert = true;
+        view.append(document.importNode(template.content, true));
+        template.replaceWith(view);
+        return view;
+    }
+
+    function showView(root: HTMLElement, id: string) {
+        const target = ensureView(root, id);
+        if (!target) return;
+
+        for (const view of root.querySelectorAll<HTMLElement>(':scope > .section-view')) {
+            const active = view === target;
+            view.toggleAttribute('data-inactive', !active);
+            view.inert = !active;
+        }
+        for (const link of root.querySelectorAll<HTMLAnchorElement>('[data-section-link]')) {
+            if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'page');
+            else link.removeAttribute('aria-current');
+        }
+        root.dataset.active = id;
+        if (target.dataset.viewTitle) document.title = target.dataset.viewTitle;
+    }
+
+    // Intercept ClientRouter navigations between sections of the current shell:
+    // skip the network fetch and replace the body swap with a view switch.
+    // History entries, scroll restoration and view-transition animation are
+    // still handled by the router.
+    document.addEventListener('astro:before-preparation', (event) => {
+        const ev = event as TransitionBeforePreparationEvent;
+        const root = getRoot();
+        if (!root || ev.formData || !viewIdForUrl(root, ev.to)) return;
+        ev.loader = async () => {
+            ev.newDocument = document;
+        };
+    });
+
+    document.addEventListener('astro:before-swap', (event) => {
+        const ev = event as TransitionBeforeSwapEvent;
+        if (ev.newDocument !== document) return;
+        const root = getRoot();
+        const id = root && viewIdForUrl(root, ev.to);
+        if (!root || !id) return;
+        ev.swap = () => showView(root, id);
+    });
+
+    // Warm up a section before it is clicked so the first visit is instant too.
+    const warmUp = (event: Event) => {
+        const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>('[data-section-link]');
+        const root = link?.closest<HTMLElement>(ROOT_SELECTOR);
+        if (link?.dataset.sectionLink && root) ensureView(root, link.dataset.sectionLink);
+    };
+    document.addEventListener('pointerover', warmUp, { passive: true });
+    document.addEventListener('focusin', warmUp);
+
+    // Run on startup and after every ClientRouter page swap.
+    const onPageLoad = () => {
+        const root = getRoot();
+        if (root) hoistTemplateScripts(root);
+    };
+    onPageLoad();
+    document.addEventListener('astro:page-load', onPageLoad);
+</script>
