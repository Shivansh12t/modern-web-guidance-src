+  <script>
+    // Fallback for browsers without CSS `field-sizing: content`.
+    (function () {
+      if (CSS.supports && CSS.supports('field-sizing', 'content')) return;
+
+      var canvas = document.createElement('canvas');
+      var ctx = canvas.getContext('2d');
+
+      function textWidth(el, text) {
+        var cs = getComputedStyle(el);
+        ctx.font = cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
+        return ctx.measureText(text).width;
+      }
+
+      function chrome(el) {
+        var cs = getComputedStyle(el);
+        return parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight) +
+          parseFloat(cs.borderLeftWidth) + parseFloat(cs.borderRightWidth);
+      }
+
+      function sizeInput(el) {
+        var text = el.value || el.placeholder || '';
+        el.style.width = Math.ceil(textWidth(el, text) + chrome(el) + 2) + 'px';
+      }
+
+      function sizeSelect(el) {
+        var opt = el.options[el.selectedIndex];
+        var text = opt ? opt.text : '';
+        // Extra room for the native dropdown arrow
+        el.style.width = Math.ceil(textWidth(el, text) + chrome(el) + 28) + 'px';
+      }
+
+      function sizeTextarea(el) {
+        var lines = (el.value || el.placeholder || '').split('\n');
+        var widest = lines.reduce(function (w, line) {
+          return Math.max(w, textWidth(el, line));
+        }, 0);
+        el.style.width = Math.ceil(widest + chrome(el) + 4) + 'px';
+        el.style.height = 'auto';
+        el.style.height = el.scrollHeight +
+          parseFloat(getComputedStyle(el).borderTopWidth) +
+          parseFloat(getComputedStyle(el).borderBottomWidth) + 'px';
+      }
+
+      function resize(el) {
+        if (el.tagName === 'SELECT') sizeSelect(el);
+        else if (el.tagName === 'TEXTAREA') sizeTextarea(el);
+        else sizeInput(el);
+      }
+
+      var fields = document.querySelectorAll('.autosize');
+      fields.forEach(function (el) {
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () { resize(el); });
+        resize(el);
+      });
+
+      window.addEventListener('resize', function () { fields.forEach(resize); });
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(function () { fields.forEach(resize); });
+      }
+    })();
+  </script>
