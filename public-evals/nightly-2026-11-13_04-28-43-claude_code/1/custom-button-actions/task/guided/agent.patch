+  <script>
+    const toggles = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    const actionTarget = document.getElementById('action-target');
+
+    actionTarget.addEventListener('command', (event) => {
+      const { command, source } = event;
+      const target = event.target;
+
+      if (command in toggles) {
+        const isOn = target.classList.toggle(toggles[command]);
+        source?.setAttribute('aria-pressed', String(isOn));
+      } else if (command === '--reset') {
+        target.classList.remove(...Object.values(toggles));
+        document.querySelectorAll(`button[commandfor="${target.id}"][aria-pressed]`)
+          .forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
+      }
+    });
+
+    // Fallback for browsers without the Invoker Commands API
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest?.('button[commandfor]');
+        if (!button) return;
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        const command = button.getAttribute('command');
+        if (!target || !command) return;
+        const evt = new Event('command');
+        evt.command = command;
+        evt.source = button;
+        target.dispatchEvent(evt);
+      });
+    }
+  </script>
+
