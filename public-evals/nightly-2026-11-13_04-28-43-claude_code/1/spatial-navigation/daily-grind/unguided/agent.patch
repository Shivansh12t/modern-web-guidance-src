+  <script>
+    /**
+     * Spatial (2D) arrow-key navigation for card collections.
+     *
+     * Navigation is computed from each item's rendered geometry rather than a
+     * fixed column count, so it behaves correctly in any layout: responsive
+     * auto-fit grids, single-column lists, horizontal carousels, RTL text,
+     * and rows of uneven length.
+     *
+     * Uses a roving tabindex: the collection is a single Tab stop, and the
+     * last focused item is restored when the user tabs back in.
+     */
+    (function () {
+      'use strict';
+
+      const EPS = 2; // px tolerance for sub-pixel layout differences
+
+      function isVisible(el) {
+        const r = el.getBoundingClientRect();
+        return r.width > 0 && r.height > 0 && getComputedStyle(el).visibility !== 'hidden';
+      }
+
+      function initSpatialNav(container) {
+        const itemSelector = '[data-nav-item]';
+        // The rect used for geometry is the card around the focus target.
+        const rectOf = (item) => (item.closest('.card') || item).getBoundingClientRect();
+        const getItems = () => Array.from(container.querySelectorAll(itemSelector)).filter(isVisible);
+
+        let current = null;
+        // Remembered horizontal position for consecutive Up/Down moves, so moving
+        // through a short row and back doesn't drift away from the original column.
+        let anchorX = null;
+
+        function setCurrent(item, { focus = false } = {}) {
+          const all = container.querySelectorAll(itemSelector);
+          all.forEach((el) => el.setAttribute('tabindex', el === item ? '0' : '-1'));
+          current = item;
+          if (focus && item) {
+            item.focus({ preventScroll: true });
+            (item.closest('.card') || item).scrollIntoView({ block: 'nearest', inline: 'nearest' });
+          }
+        }
+
+        function ensureTabStop() {
+          const items = getItems();
+          if (!items.length) return;
+          if (!current || !items.includes(current)) {
+            setCurrent(items[0]);
+          } else {
+            setCurrent(current);
+          }
+        }
+
+        const isRTL = () => getComputedStyle(container).direction === 'rtl';
+
+        /** Find the best item in a direction ('left' | 'right' | 'up' | 'down'). */
+        function findInDirection(from, dir, items) {
+          const a = rectOf(from);
+          const ax = dir === 'up' || dir === 'down'
+            ? (anchorX ?? (a.left + a.right) / 2)
+            : (a.left + a.right) / 2;
+          const ay = (a.top + a.bottom) / 2;
+
+          let best = null;
+          let bestScore = Infinity;
+
+          for (const item of items) {
+            if (item === from) continue;
+            const b = rectOf(item);
+            const bx = (b.left + b.right) / 2;
+            const by = (b.top + b.bottom) / 2;
+            let primary, secondary;
+
+            if (dir === 'left' || dir === 'right') {
+              // Must share a visual row (vertical overlap) and lie in that direction.
+              const overlapsRow = b.top < a.bottom - EPS && b.bottom > a.top + EPS;
+              if (!overlapsRow) continue;
+              if (dir === 'right' && !(bx > ax + EPS)) continue;
+              if (dir === 'left' && !(bx < ax - EPS)) continue;
+              primary = Math.abs(bx - ax);
+              secondary = Math.abs(by - ay);
+            } else {
+              // Must be entirely in the next row(s) above/below.
+              if (dir === 'down' && !(b.top >= a.bottom - EPS)) continue;
+              if (dir === 'up' && !(b.bottom <= a.top + EPS)) continue;
+              primary = dir === 'down' ? b.top - a.bottom : a.top - b.bottom;
+              // Distance from the anchor column to the item's horizontal span (0 if inside).
+              secondary = ax < b.left ? b.left - ax : ax > b.right ? ax - b.right : 0;
+            }
+
+            // Strongly prefer the nearest row/column, then alignment.
+            const score = primary * 1000 + secondary;
+            if (score < bestScore) {
+              bestScore = score;
+              best = item;
+            }
+          }
+          return best;
+        }
+
+        /** Items sharing a visual row with `from`, sorted in visual order. */
+        function rowOf(from, items) {
+          const a = rectOf(from);
+          return items
+            .filter((item) => {
+              const b = rectOf(item);
+              return b.top < a.bottom - EPS && b.bottom > a.top + EPS;
+            })
+            .sort((x, y) => rectOf(x).left - rectOf(y).left);
+        }
+
+        container.addEventListener('keydown', (e) => {
+          const item = e.target.closest(itemSelector);
+          if (!item || !container.contains(item)) return;
+          if (e.altKey || e.metaKey || e.shiftKey) return;
+
+          const items = getItems();
+          if (!items.length) return;
+          const index = items.indexOf(item);
+          const rtl = isRTL();
+          let target = null;
+
+          switch (e.key) {
+            case 'ArrowRight':
+            case 'ArrowLeft': {
+              if (e.ctrlKey) return;
+              const dir = e.key === 'ArrowRight' ? 'right' : 'left';
+              target = findInDirection(item, dir, items);
+              if (!target) {
+                // End of a row: continue in reading order (wraps to the next/previous row).
+                const forward = (dir === 'right') !== rtl;
+                target = items[index + (forward ? 1 : -1)] || null;
+              }
+              anchorX = null;
+              break;
+            }
+            case 'ArrowDown':
+            case 'ArrowUp': {
+              if (e.ctrlKey) return;
+              if (anchorX === null) {
+                const r = rectOf(item);
+                anchorX = (r.left + r.right) / 2;
+              }
+              target = findInDirection(item, e.key === 'ArrowDown' ? 'down' : 'up', items);
+              break;
+            }
+            case 'Home':
+            case 'End': {
+              const start = e.key === 'Home';
+              if (e.ctrlKey) {
+                target = start ? items[0] : items[items.length - 1];
+              } else {
+                const row = rowOf(item, items);
+                // Visual start of row is the right edge in RTL.
+                const takeFirst = start !== rtl;
+                target = takeFirst ? row[0] : row[row.length - 1];
+              }
+              anchorX = null;
+              break;
+            }
+            default:
+              return;
+          }
+
+          // Always consume handled keys so the page doesn't scroll unexpectedly,
+          // even when there's nowhere to go (e.g. ArrowDown on the last row).
+          e.preventDefault();
+          if (target && target !== item) setCurrent(target, { focus: true });
+        });
+
+        // Keep the roving tabindex in sync with mouse clicks / programmatic focus.
+        container.addEventListener('focusin', (e) => {
+          const item = e.target.closest(itemSelector);
+          if (item && item !== current) setCurrent(item);
+        });
+
+        // Reset the vertical anchor when focus leaves via Tab or pointer.
+        container.addEventListener('focusout', (e) => {
+          if (!container.contains(e.relatedTarget)) anchorX = null;
+        });
+        container.addEventListener('pointerdown', () => { anchorX = null; });
+
+        // Layout may change (resize, layout mode, content changes); geometry is
+        // read lazily on each keypress, so we only need to keep the tab stop valid.
+        if ('ResizeObserver' in window) {
+          new ResizeObserver(() => { anchorX = null; ensureTabStop(); }).observe(container);
+        }
+        new MutationObserver(ensureTabStop).observe(container, { childList: true, subtree: true });
+
+        ensureTabStop();
+
+        return {
+          refresh() { anchorX = null; ensureTabStop(); },
+          get current() { return current; },
+        };
+      }
+
+      /* ---- Layout mode switcher ---- */
+      function initLayoutSwitch(grid, nav) {
+        const buttons = document.querySelectorAll('[data-layout-option]');
+        const status = document.getElementById('layout-status');
+        const STORAGE_KEY = 'daily-grind:card-layout';
+        const valid = Array.from(buttons, (b) => b.dataset.layoutOption);
+
+        function apply(mode, announce) {
+          if (!valid.includes(mode)) mode = 'grid';
+          grid.dataset.layout = mode;
+          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layoutOption === mode)));
+          nav.refresh();
+          // Keep the active card visible after the layout reflows.
+          const card = nav.current && nav.current.closest('.card');
+          if (card && grid.dataset.layout === 'carousel') card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+          if (announce && status) status.textContent = `Layout changed to ${mode}.`;
+          try { localStorage.setItem(STORAGE_KEY, mode); } catch (_) { /* storage unavailable */ }
+        }
+
+        buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.layoutOption, true)));
+
+        let saved = null;
+        try { saved = localStorage.getItem(STORAGE_KEY); } catch (_) { /* storage unavailable */ }
+        apply(saved || grid.dataset.layout || 'grid', false);
+      }
+
+      document.querySelectorAll('[data-spatial-nav]').forEach((container) => {
+        const nav = initSpatialNav(container);
+        if (container.id === 'favorites-grid') initLayoutSwitch(container, nav);
+      });
+    })();
+  </script>
+
