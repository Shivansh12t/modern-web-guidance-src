+  <script>
+    /**
+     * Spatial (arrow-key) navigation for the card grid.
+     * - Roving tabindex: the grid is a single Tab stop.
+     * - Candidates are chosen from live geometry on every keypress, so it works
+     *   in any layout mode (auto-fit grid, single-column list, horizontal rail).
+     * - If no candidate exists in the pressed direction, the event is left alone
+     *   so the browser can scroll natively.
+     */
+    (() => {
+      const grid = document.querySelector('.grid[role="grid"]');
+      if (!grid) return;
+
+      const ITEM_SELECTOR = '[role="gridcell"] .btn';
+      const TOLERANCE = 1;   // px, for sub-pixel rounding
+      const WEIGHT = 2;      // perpendicular-offset weight for fallback scoring
+
+      const DIRECTIONS = {
+        ArrowRight: 'right', ArrowLeft: 'left', ArrowDown: 'down', ArrowUp: 'up',
+      };
+
+      const getItems = () =>
+        [...grid.querySelectorAll(ITEM_SELECTOR)].filter((el) =>
+          el.checkVisibility ? el.checkVisibility({ visibilityProperty: true }) : el.getClientRects().length > 0
+        );
+
+      function setActive(item, { focus = true } = {}) {
+        for (const el of grid.querySelectorAll(ITEM_SELECTOR)) {
+          el.tabIndex = el === item ? 0 : -1;
+        }
+        if (focus) {
+          item.focus({ preventScroll: true });
+          item.closest('[role="gridcell"]').scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+      }
+
+      function findCandidate(current, items, dir) {
+        const cur = current.getBoundingClientRect();
+        const horizontal = dir === 'left' || dir === 'right';
+        const curCenter = horizontal ? cur.top + cur.height / 2 : cur.left + cur.width / 2;
+
+        let bestAligned = null;
+        let bestFallback = null;
+
+        for (const el of items) {
+          if (el === current) continue;
+          const r = el.getBoundingClientRect();
+
+          // Edge-based direction filter + gap along the navigation axis.
+          let gap;
+          switch (dir) {
+            case 'right': if (r.left < cur.right - TOLERANCE) continue; gap = r.left - cur.right; break;
+            case 'left': if (r.right > cur.left + TOLERANCE) continue; gap = cur.left - r.right; break;
+            case 'down': if (r.top < cur.bottom - TOLERANCE) continue; gap = r.top - cur.bottom; break;
+            case 'up': if (r.bottom > cur.top + TOLERANCE) continue; gap = cur.top - r.bottom; break;
+          }
+          gap = Math.max(0, gap);
+
+          const center = horizontal ? r.top + r.height / 2 : r.left + r.width / 2;
+          const offset = Math.abs(center - curCenter);
+          const overlaps = horizontal
+            ? r.top < cur.bottom - TOLERANCE && r.bottom > cur.top + TOLERANCE
+            : r.left < cur.right - TOLERANCE && r.right > cur.left + TOLERANCE;
+
+          if (overlaps) {
+            if (!bestAligned || gap < bestAligned.gap || (gap === bestAligned.gap && offset < bestAligned.offset)) {
+              bestAligned = { el, gap, offset };
+            }
+          } else {
+            const score = gap + WEIGHT * offset;
+            if (!bestFallback || score < bestFallback.score) bestFallback = { el, score };
+          }
+        }
+
+        return bestAligned?.el ?? bestFallback?.el ?? null;
+      }
+
+      grid.addEventListener('keydown', (e) => {
+        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+
+        const items = getItems();
+        if (!items.includes(target)) return;
+
+        let next = null;
+        if (e.key in DIRECTIONS) {
+          next = findCandidate(target, items, DIRECTIONS[e.key]);
+        } else if (e.key === 'Home') {
+          next = items[0];
+        } else if (e.key === 'End') {
+          next = items[items.length - 1];
+        } else {
+          return;
+        }
+
+        // No candidate: leave the event alone so native scrolling still works.
+        if (!next || next === target) return;
+
+        e.preventDefault();
+        setActive(next);
+      });
+
+      // Keep the roving tab stop in sync if focus arrives by click or programmatically.
+      grid.addEventListener('focusin', (e) => {
+        const target = e.composedPath()[0];
+        if (target instanceof Element && target.matches(ITEM_SELECTOR)) setActive(target, { focus: false });
+      });
+
+      // Layout mode switcher.
+      const toolbar = document.querySelector('.grid-toolbar');
+      toolbar?.addEventListener('click', (e) => {
+        const button = e.target.closest('button[data-layout]');
+        if (!button) return;
+        grid.dataset.layout = button.dataset.layout;
+        for (const b of toolbar.querySelectorAll('button')) {
+          b.setAttribute('aria-pressed', String(b === button));
+        }
+      });
+
+      // Ensure the single tab stop always points at a visible item.
+      const ensureTabStop = () => {
+        const items = getItems();
+        if (items.length && !items.some((el) => el.tabIndex === 0)) setActive(items[0], { focus: false });
+      };
+      new ResizeObserver(ensureTabStop).observe(grid);
+      ensureTabStop();
+    })();
+  </script>
