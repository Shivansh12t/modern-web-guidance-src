+  <script>
+    (() => {
+      const countEl = document.getElementById('order-count');
+      const statusEl = document.getElementById('order-status');
+      const order = [];
+
+      document.querySelectorAll('.order-form').forEach((form) => {
+        const priceEl = form.querySelector('.price');
+        const button = form.querySelector('.add-btn');
+        const name = form.closest('.card').querySelector('h3').textContent.trim();
+
+        form.addEventListener('change', (event) => {
+          if (event.target.name === 'size') {
+            priceEl.textContent = `$${event.target.dataset.price}`;
+          }
+        });
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const size = form.querySelector('input[name="size"]:checked');
+          order.push({ item: form.elements.item.value, size: size.value, price: Number(size.dataset.price) });
+          countEl.textContent = order.length;
+          statusEl.textContent = `Added a ${size.value} ${name} to your order. ${order.length} item${order.length === 1 ? '' : 's'} in your order.`;
+
+          button.textContent = 'Added ✓';
+          button.dataset.added = '';
+          clearTimeout(button._reset);
+          button._reset = setTimeout(() => {
+            button.textContent = 'Add to order';
+            delete button.dataset.added;
+          }, 1500);
+        });
+      });
+    })();
+  </script>
+
