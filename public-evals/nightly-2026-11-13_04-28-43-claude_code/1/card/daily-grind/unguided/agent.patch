+  <div class="visually-hidden" role="status" aria-live="polite" id="order-status"></div>
+
+  <script>
+    (function () {
+      const STORAGE_KEY = 'dailyGrindOrder';
+      const countEl = document.querySelector('.cart-count');
+      const statusEl = document.getElementById('order-status');
+
+      function loadOrder() {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
+        catch (e) { return []; }
+      }
+
+      function saveOrder(order) {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch (e) { /* storage unavailable */ }
+      }
+
+      function renderCount(order, bump) {
+        const total = order.reduce((n, line) => n + line.qty, 0);
+        countEl.textContent = total;
+        countEl.setAttribute('aria-label', total + (total === 1 ? ' item' : ' items') + ' in your order');
+        countEl.toggleAttribute('data-empty', total === 0);
+        if (bump) {
+          countEl.classList.remove('bump');
+          void countEl.offsetWidth; // restart animation
+          countEl.classList.add('bump');
+        }
+      }
+
+      let order = loadOrder();
+      renderCount(order, false);
+
+      document.querySelectorAll('.drink-card').forEach(function (card) {
+        const form = card.querySelector('.drink-card__form');
+        const priceEl = card.querySelector('.drink-card__price');
+        const button = card.querySelector('.drink-card__add');
+        const title = card.querySelector('.drink-card__title');
+        const img = card.querySelector('.drink-card__media img');
+        const name = title.textContent.trim();
+        let resetTimer;
+
+        // Content-aware hook: long names get a stacked header via CSS :has()
+        if (name.length > 22) title.setAttribute('data-long', '');
+
+        // If the photo fails to load, remove it so the card falls back to its text-only layout
+        if (img) {
+          const drop = function () { img.remove(); };
+          if (img.complete && img.naturalWidth === 0) drop();
+          else img.addEventListener('error', drop, { once: true });
+        }
+
+        function selected() {
+          return form.querySelector('input[name="size"]:checked');
+        }
+
+        function updatePrice() {
+          const opt = selected();
+          if (opt) priceEl.textContent = '$' + Number(opt.dataset.price).toFixed(2);
+        }
+
+        form.addEventListener('change', updatePrice);
+        updatePrice();
+
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          const opt = selected();
+          if (!opt) return;
+          const size = opt.value;
+          const price = Number(opt.dataset.price);
+          const id = card.dataset.drink;
+          const existing = order.find(line => line.id === id && line.size === size);
+          if (existing) existing.qty += 1;
+          else order.push({ id: id, name: name, size: size, price: price, qty: 1 });
+          saveOrder(order);
+          renderCount(order, true);
+
+          const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+          statusEl.textContent = 'Added ' + sizeLabel + ' ' + name + ' to your order.';
+          button.textContent = 'Added ✓';
+          button.classList.add('is-added');
