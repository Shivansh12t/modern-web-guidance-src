--- a/index.html
+++ b/index.html
@@ -14,6 +14,42 @@
       --light: #fafafa;
     }
 
+    /*
+     * Adaptive text colors.
+     * Each themed surface sets --surface-bg to its background, and its text
+     * color is derived from that value: pure black on light backgrounds, pure
+     * white on dark ones. Because the derivation happens on the element itself
+     * (not once on :root), changing --primary / --secondary anywhere — in the
+     * stylesheet, on a scoped element, or via JS — keeps text readable.
+     *
+     * Order of preference:
+     *   1. contrast-color()  – native WCAG-based black/white pick
+     *   2. relative LCH      – lightness threshold trick, flips to black/white
+     *   3. static fallback   – the original colors for older browsers
+     */
+    nav,
+    .btn,
+    footer {
+      background: var(--surface-bg);
+    }
+
+    @supports (color: lch(from red l c h)) {
+      nav,
+      .btn,
+      footer {
+        /* L above ~49.44 => black text, otherwise white text */
+        color: lch(from var(--surface-bg) calc((49.44 - l) * infinity) 0 0);
+      }
+    }
+
+    @supports (color: contrast-color(red)) {
+      nav,
+      .btn,
+      footer {
+        color: contrast-color(var(--surface-bg));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
@@ -29,7 +65,7 @@
 
     /* Navigation */
     nav {
-      background: var(--primary);
+      --surface-bg: var(--primary);
       color: white;
       padding: 1rem 5%;
       display: flex;
@@ -56,14 +92,20 @@
     }
 
     nav a {
-      color: white;
+      color: inherit;
       text-decoration: none;
       font-size: 0.9rem;
       transition: color 0.3s;
     }
 
-    nav a:hover {
-      color: var(--accent);
