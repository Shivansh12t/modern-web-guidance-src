+       adaptive text color and signal hover with an accent underline. */
+    nav a:hover,
+    nav a:focus-visible {
+      text-decoration: underline;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 2px;
+      text-underline-offset: 4px;
     }
 
     .logout-link {
@@ -121,21 +163,26 @@
