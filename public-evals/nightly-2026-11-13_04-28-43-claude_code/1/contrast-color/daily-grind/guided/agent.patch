@@ -12,6 +12,44 @@
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      /* WCAG relative-luminance crossover between black and white text */
+      --wcag-y-threshold: 0.17913;
+    }
+
+    /*
+     * Auto-contrast surfaces.
+     * Each themed surface sets --surface to its background color (and
+     * --surface-text-fallback for very old browsers). The text color is then
+     * derived from --surface, so changing --primary / --secondary anywhere
+     * (on :root, a theme class, or inline via JS) keeps the text readable.
+     */
+    nav,
+    .btn,
+    footer {
+      background-color: var(--surface);
+      color: var(--surface-text-fallback);
+    }
+
+    /* Fallback: compute black/white from relative luminance (CIE XYZ y) */
+    @supports (color: color(from red xyz-d65 calc(sign(0.5 - y) * x) y z)) {
+      nav,
+      .btn,
+      footer {
+        --surface-y: max(0, sign(var(--wcag-y-threshold) - y));
+        color: color(from var(--surface) xyz-d65
+            calc(var(--surface-y) * 0.9505)
+            var(--surface-y)
+            calc(var(--surface-y) * 1.089));
+      }
+    }
+
+    /* Preferred: let the browser pick the highest-contrast text color */
+    @supports (color: contrast-color(red)) {
+      nav,
+      .btn,
+      footer {
+        color: contrast-color(var(--surface));
+      }
     }
 
     * {
@@ -29,8 +67,8 @@
 
