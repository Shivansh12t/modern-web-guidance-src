+  <script>
+    /* Fallback for browsers without CSS sibling-index()/sibling-count():
+       sets --i/--n on each item and keeps them in sync when items are
+       added or removed. Only items of the targeted class are counted. */
+    (() => {
+      if (CSS.supports('z-index', 'sibling-index()')) return;
+      const groups = [
+        ['.grid', '.spectrum-card'],
+        ['.fan-container', '.fan-card'],
+        ['.circle-container', '.circle-orb'],
+      ];
+      const update = (parent, sel) => {
+        const items = [...parent.children].filter(el => el.matches(sel));
+        items.forEach((el, idx) => {
+          el.style.setProperty('--i', idx + 1);
+          el.style.setProperty('--n', items.length);
+        });
+      };
+      groups.forEach(([parentSel, sel]) => {
+        document.querySelectorAll(parentSel).forEach(parent => {
+          update(parent, sel);
+          new MutationObserver(() => update(parent, sel)).observe(parent, { childList: true });
+        });
+      });
+    })();
+  </script>
