+  <script>
+    /* Fallback for browsers without sibling-index()/sibling-count():
+       inject 1-based index/count custom properties, and keep them in sync
+       when items are added or removed. */
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const update = (parent) => {
+        const items = parent.children;
+        for (let i = 0; i < items.length; i++) {
+          items[i].style.setProperty('--sibling-index', i + 1);
+          items[i].style.setProperty('--sibling-count', items.length);
+        }
+      };
+      const parents = new Set(
+        [...document.querySelectorAll(selector)].map((el) => el.parentElement)
+      );
+      const observer = new MutationObserver((records) =>
+        records.forEach((r) => update(r.target))
+      );
+      parents.forEach((parent) => {
+        update(parent);
+        observer.observe(parent, { childList: true });
+      });
+    }
+  </script>
+
