diff --git a/menubar.js b/menubar.js
new file mode 100644
index 0000000..08245d9
--- /dev/null
+++ b/menubar.js
@@ -0,0 +1,217 @@
+// Application menu bar: Menu, Locations, Rewards.
+// One Tab stop; ArrowLeft/ArrowRight move between menus; focusing a trigger previews its menu;
+// while a menu is open, hovering another trigger switches to it.
+
+// Load the Popover polyfill only where the API is missing.
+if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+  import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+}
+
+(() => {
+  const menubar = document.querySelector('[role="menubar"]');
+  if (!menubar) return;
+
+  // Direct children only: these are the top-level triggers.
+  const rootTriggers = [...menubar.querySelectorAll(':scope > [commandfor]')];
+  const hasInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+  const hasFocusgroup = 'focusGroup' in HTMLElement.prototype;
+  const hasAnchorPositioning = CSS.supports('position-area: block-end');
+
+  const enterOnOpen = new WeakSet();
+  let pointerTrigger = null;
+  let windowRefocus = false;
+
+  const menuFor = trigger => document.getElementById(trigger.getAttribute('commandfor'));
+  const triggerFor = menu => rootTriggers.find(trigger => menuFor(trigger) === menu);
+  const isOpen = menu => {
+    try { return menu.matches(':popover-open'); }
+    catch { return menu.classList.contains(':popover-open'); } // Polyfill class.
+  };
+  const itemsOf = menu => [...menu.querySelectorAll('[focusgroup] > a, [focusgroup] > button')]
+    .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+  const openMenus = () => rootTriggers.map(menuFor).filter(isOpen);
+
+  function showMenu(trigger) {
+    const menu = menuFor(trigger);
+    if (!isOpen(menu)) menu.showPopover({ source: trigger });
+  }
+
+  function closeAndRestore(menu, { fromPointer = false } = {}) {
+    const trigger = triggerFor(menu);
+    trigger.focus({ preventScroll: true, focusVisible: !fromPointer });
+    if (isOpen(menu)) menu.hidePopover();
+  }
+
+  function closeAll() {
+    openMenus().forEach(menu => menu.hidePopover());
+  }
+
+  // Left/Right always land on the adjacent trigger as a preview, never inside its menu.
+  function moveToRootTrigger(from, direction) {
+    const count = rootTriggers.length;
+    const next = rootTriggers[(rootTriggers.indexOf(from) + direction + count) % count];
+    rootTriggers.forEach(trigger => { trigger.tabIndex = trigger === next ? 0 : -1; });
+    closeAll();
+    next.focus({ preventScroll: true }); // Focusing the trigger previews its menu.
+  }
+
+  function focusItem(menu, which) {
+    const items = itemsOf(menu);
+    const item = which === 'last' ? items.at(-1) : items[0];
+    item?.focus({ preventScroll: true });
+  }
+
+  // Fallback placement when CSS anchor positioning is unavailable.
+  function placeMenu(menu, trigger) {
+    if (hasAnchorPositioning) return;
+    const gap = 8;
+    const t = trigger.getBoundingClientRect();
+    const m = menu.getBoundingClientRect();
+    let left = t.left;
+    if (left + m.width > innerWidth - gap) left = Math.max(gap, t.right - m.width);
+    let top = t.bottom;
+    if (top + m.height > innerHeight - gap && t.top - m.height >= gap) top = t.top - m.height;
+    menu.style.left = `${left}px`;
+    menu.style.top = `${top}px`;
+  }
+
+  addEventListener('blur', () => { windowRefocus = true; });
+  addEventListener('focus', () => { setTimeout(() => { windowRefocus = false; }); });
+
+  for (const trigger of rootTriggers) {
+    const menu = menuFor(trigger);
+
+    // Pointer presses toggle without moving focus; the toggle handler focuses ringlessly.
+    trigger.addEventListener('pointerdown', event => {
+      event.preventDefault();
+      pointerTrigger = trigger;
+    });
+
+    trigger.addEventListener('click', event => {
+      const opening = !isOpen(menu);
+      // Keyboard-generated clicks (Enter, Space, ArrowDown) enter the menu once it opens.
+      if (opening && event.detail === 0 && pointerTrigger !== trigger) enterOnOpen.add(menu);
+      if (event.detail === 0) pointerTrigger = null;
+      if (hasInvokers) return; // Native toggle-popover does the rest.
+      event.preventDefault();
+      if (opening) menu.showPopover({ source: trigger });
+      else closeAndRestore(menu, { fromPointer: event.detail !== 0 });
+    });
+
+    // Preview on focus.
+    trigger.addEventListener('focus', event => {
+      if (windowRefocus || menu.contains(event.relatedTarget)) return;
+      showMenu(trigger);
+    });
+
+    // Hide a previewed menu when focus leaves the trigger, unless it moved into the menu.
+    trigger.addEventListener('blur', event => {
+      if (isOpen(menu) && !menu.contains(event.relatedTarget)) menu.hidePopover();
+    });
+
+    // Hover switches menus only while another one is open.
+    trigger.addEventListener('pointerenter', () => {
+      const others = openMenus().filter(open => open !== menu);
+      if (!others.length) return;
+      others.forEach(open => open.hidePopover());
+      trigger.focus({ preventScroll: true, focusVisible: false });
+    });
+
+    trigger.addEventListener('keydown', event => {
+      switch (event.key) {
+        case 'ArrowRight':
+        case 'ArrowLeft':
+          event.preventDefault();
+          moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+          break;
+        case 'ArrowDown':
+          event.preventDefault();
+          if (isOpen(menu)) focusItem(menu, 'first');
+          else { enterOnOpen.add(menu); trigger.click(); }
+          break;
+        case 'Home':
+        case 'End':
+          event.preventDefault();
+          showMenu(trigger);
+          focusItem(menu, event.key === 'End' ? 'last' : 'first');
+          break;
+        // Enter and Space are handled natively by toggle-popover.
+      }
+    });
+
+    menu.addEventListener('toggle', event => {
+      const open = event.newState === 'open';
+      trigger.setAttribute('aria-expanded', String(open));
+      if (!open) {
+        enterOnOpen.delete(menu);
+        return;
+      }
+      placeMenu(menu, trigger);
+      if (enterOnOpen.has(menu)) {
+        enterOnOpen.delete(menu);
+        focusItem(menu, 'first');
+      } else if (pointerTrigger === trigger) {
+        // Pointer open: keep focus on the trigger, without a ring, so arrow keys still work.
+        trigger.focus({ preventScroll: true, focusVisible: false });
+      }
+      pointerTrigger = null;
+    });
+
+    menu.addEventListener('keydown', event => {
+      const items = itemsOf(menu);
+      const current = items.indexOf(document.activeElement);
+      switch (event.key) {
+        case 'ArrowRight':
+        case 'ArrowLeft':
+          event.preventDefault();
+          moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+          break;
+        case 'Escape':
+          event.preventDefault();
+          closeAndRestore(menu);
+          break;
+        case 'Home':
+        case 'End':
+          event.preventDefault();
+          focusItem(menu, event.key === 'End' ? 'last' : 'first');
+          break;
+        case 'ArrowDown':
+        case 'ArrowUp':
+          // Native focusgroup handles these; the fallback below covers other browsers.
+          if (hasFocusgroup || current < 0) return;
+          event.preventDefault();
+          items[(current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length]
+            .focus({ preventScroll: true });
+          break;
+      }
+    });
+
+    // Hover follows focus inside the menu.
+    menu.addEventListener('pointermove', event => {
+      const item = event.target.closest('a, button');
+      if (item && menu.contains(item) && document.activeElement !== item) {
+        item.focus({ preventScroll: true, focusVisible: false });
+      }
+    });
+
+    // Activating an item closes the menu (links then navigate as usual).
+    menu.addEventListener('click', event => {
+      if (event.target.closest('a, button')) menu.hidePopover();
+    });
+  }
+
+  // Without native focusgroup, expose menu roles explicitly.
+  if (!hasFocusgroup) {
+    menubar.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      group.setAttribute('role', 'menu');
+      group.querySelectorAll(':scope > a:not([role]), :scope > button:not([role])').forEach(item => {
+        item.setAttribute('role', 'menuitem');
+      });
+    });
+  }
+
+  // Close every menu when focus lands outside the menu bar (Tab out, etc.).
+  document.addEventListener('focusin', event => {
+    if (!menubar.contains(event.target)) closeAll();
+  });
+})();
