+  <script>
+    // Application menu bar (WAI-ARIA menubar pattern):
+    // roving tabindex across top-level items, arrow-key navigation,
+    // typeahead, and submenus that open via click, keyboard, or hover
+    // (hover only once a submenu is already open, like desktop app menus).
+    (function () {
+      const menubar = document.querySelector('[role="menubar"]');
+      if (!menubar) return;
+
+      const topItems = Array.from(menubar.querySelectorAll(':scope > li > [role="menuitem"]'));
+      const submenuOf = (item) => document.getElementById(item.getAttribute('aria-controls'));
+      const itemsOf = (menu) => Array.from(menu.querySelectorAll('[role="menuitem"]'));
+      let openItem = null;
+
+      function setRoving(target) {
+        topItems.forEach((item) => { item.tabIndex = item === target ? 0 : -1; });
+      }
+
+      function closeMenu({ focusParent = false } = {}) {
+        if (!openItem) return;
+        const item = openItem;
+        item.setAttribute('aria-expanded', 'false');
+        submenuOf(item).hidden = true;
+        openItem = null;
+        if (focusParent) item.focus();
+      }
+
+      function openMenu(item, focus) {
+        if (openItem && openItem !== item) closeMenu();
+        setRoving(item);
+        item.setAttribute('aria-expanded', 'true');
+        const menu = submenuOf(item);
+        menu.hidden = false;
+        openItem = item;
+        const items = itemsOf(menu);
+        if (focus === 'first') items[0].focus();
+        else if (focus === 'last') items[items.length - 1].focus();
+        else item.focus();
+      }
+
+      function moveTop(from, delta, keepOpen) {
+        const i = topItems.indexOf(from);
+        const next = topItems[(i + delta + topItems.length) % topItems.length];
+        if (keepOpen) {
+          openMenu(next, 'first');
+        } else {
+          setRoving(next);
+          next.focus();
+        }
+      }
+
+      function typeahead(items, current, char) {
+        const start = items.indexOf(current);
+        const ordered = items.slice(start + 1).concat(items.slice(0, start + 1));
+        return ordered.find((el) => el.textContent.trim().toLowerCase().startsWith(char));
+      }
+
+      topItems.forEach((item) => {
+        item.addEventListener('click', () => {
+          if (openItem === item) closeMenu({ focusParent: true });
+          else openMenu(item);
+        });
+
+        item.addEventListener('mouseenter', () => {
+          if (openItem && openItem !== item) openMenu(item);
+        });
+
+        item.addEventListener('keydown', (e) => {
+          switch (e.key) {
+            case 'ArrowRight': moveTop(item, 1, !!openItem); break;
+            case 'ArrowLeft': moveTop(item, -1, !!openItem); break;
+            case 'Home': setRoving(topItems[0]); topItems[0].focus(); break;
+            case 'End': {
+              const last = topItems[topItems.length - 1];
+              setRoving(last); last.focus(); break;
+            }
+            case 'ArrowDown':
+            case 'Enter':
+            case ' ':
+              openMenu(item, 'first'); break;
+            case 'ArrowUp': openMenu(item, 'last'); break;
+            case 'Escape': closeMenu({ focusParent: true }); break;
+            default:
+              if (e.key.length === 1 && /\S/.test(e.key) && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                const match = typeahead(topItems, item, e.key.toLowerCase());
+                if (match) { setRoving(match); match.focus(); }
+                e.preventDefault();
+              }
+              return;
+          }
+          e.preventDefault();
+        });
+
+        const menu = submenuOf(item);
+        menu.addEventListener('keydown', (e) => {
+          const items = itemsOf(menu);
+          const i = items.indexOf(document.activeElement);
+          switch (e.key) {
+            case 'ArrowDown': items[(i + 1) % items.length].focus(); break;
+            case 'ArrowUp': items[(i - 1 + items.length) % items.length].focus(); break;
+            case 'Home': items[0].focus(); break;
+            case 'End': items[items.length - 1].focus(); break;
+            case 'ArrowRight': moveTop(item, 1, true); break;
+            case 'ArrowLeft': moveTop(item, -1, true); break;
+            case 'Escape': closeMenu({ focusParent: true }); break;
+            case 'Tab': closeMenu(); return; // let focus move naturally
+            case ' ': document.activeElement.click(); break;
+            default:
+              if (e.key.length === 1 && /\S/.test(e.key) && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                const match = typeahead(items, items[i], e.key.toLowerCase());
+                if (match) match.focus();
+                e.preventDefault();
+              }
+              return; // Enter falls through to native link activation
+          }
+          e.preventDefault();
+        });
+
+        menu.addEventListener('mouseover', (e) => {
+          const target = e.target.closest('[role="menuitem"]');
+          if (target) target.focus({ preventScroll: true });
+        });
+      });
+
+      document.addEventListener('pointerdown', (e) => {
+        if (openItem && !menubar.contains(e.target)) closeMenu();
+      });
+
+      menubar.addEventListener('focusout', (e) => {
+        if (openItem && e.relatedTarget && !menubar.contains(e.relatedTarget)) closeMenu();
+      });
+    })();
+  </script>
+
 </body>
 
