+
+    .tip-wrap:hover .tooltip,
+    .tip-wrap:focus-within .tooltip {
+      opacity: 1;
+      visibility: visible;
+      transition-delay: 0s;
+    }
+
+    .tip-wrap.tip-dismissed .tooltip {
+      opacity: 0;
+      visibility: hidden;
+      transition: none;
+    }
+
+    /* Modern browsers: CSS anchor positioning with viewport-aware flipping */
+    @supports (anchor-name: --a) and (position-try-fallbacks: flip-block) {
+      .tip-wrap {
+        position: static;
+      }
+
+      .tooltip,
+      .tooltip.tip-below {
+        position: fixed;
+        position-anchor: var(--anchor);
+        inset: auto;
+        transform: none;
+        margin: 10px;
+        position-area: top;
+        position-try-fallbacks: flip-block, top span-right, top span-left, bottom span-right, bottom span-left;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .tooltip {
+        transition: none;
+      }
+    }
