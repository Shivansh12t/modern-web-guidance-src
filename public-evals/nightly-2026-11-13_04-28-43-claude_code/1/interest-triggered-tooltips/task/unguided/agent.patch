+      /* Short hide delay lets the pointer cross the gap onto the tooltip */
+      transition: opacity 0.15s ease, visibility 0s linear 0.15s;
+    }
+
+    .tooltip.tip-below {
+      bottom: auto;
+      top: calc(100% + 10px);
