+  <script>
+    (function () {
+      var wraps = document.querySelectorAll('.tip-wrap');
+      var hasAnchor = window.CSS && CSS.supports &&
+        CSS.supports('anchor-name: --a') && CSS.supports('position-try-fallbacks: flip-block');
+
+      function place(wrap) {
+        if (hasAnchor) return;
+        var tip = wrap.querySelector('.tooltip');
+        var btn = wrap.querySelector('.btn');
+        if (!tip || !btn) return;
+        // Reset, then measure and adjust so the tooltip stays on screen.
+        tip.classList.remove('tip-below');
+        tip.style.left = '';
+        tip.style.marginLeft = '';
+        var b = btn.getBoundingClientRect();
+        var t = tip.getBoundingClientRect();
+        var navEl = document.querySelector('nav');
+        var topLimit = navEl ? navEl.getBoundingClientRect().bottom : 0;
+        if (b.top - t.height - 10 < topLimit) tip.classList.add('tip-below');
+        var vw = document.documentElement.clientWidth;
+        var pad = 8, shift = 0;
+        if (t.left < pad) shift = pad - t.left;
+        else if (t.right > vw - pad) shift = vw - pad - t.right;
+        if (shift) tip.style.marginLeft = shift + 'px';
+      }
+
+      function dismissAll() {
+        for (var i = 0; i < wraps.length; i++) wraps[i].classList.add('tip-dismissed');
+      }
+
+      for (var i = 0; i < wraps.length; i++) {
+        (function (wrap) {
+          function show() {
+            wrap.classList.remove('tip-dismissed');
+            place(wrap);
+          }
+          wrap.addEventListener('mouseenter', show);
+          wrap.addEventListener('focusin', show);
+        })(wraps[i]);
+      }
+
+      // WCAG 1.4.13: allow dismissing tooltips without moving pointer or focus.
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' || e.key === 'Esc') dismissAll();
+      });
+    })();
+  </script>
+
