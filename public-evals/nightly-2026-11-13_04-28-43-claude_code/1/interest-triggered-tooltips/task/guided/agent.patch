+  <script>
+    // Wire ARIA for interestfor hint popovers before any polyfill loads,
+    // so screen reader users get descriptions without interacting first.
+    (function () {
+      const owned = new WeakSet();
+      const norm = (s) => (s || "").replace(/\s+/g, " ").trim();
+      const textOf = (el) => {
+        if (!el) return "";
+        let out = "";
+        for (const n of el.childNodes) {
+          if (n.nodeType === 3) out += n.data;
+          else if (n.nodeType === 1 && n.getAttribute("aria-hidden") !== "true" && !n.hasAttribute("popover")) {
+            out += n.tagName === "IMG" ? " " + (n.getAttribute("alt") || "") + " " : " " + textOf(n) + " ";
+          }
+        }
+        return out;
+      };
+      const nameOf = (t) => {
+        const ids = t.getAttribute("aria-labelledby");
+        if (ids) return norm(ids.split(/\s+/).map((id) => textOf(document.getElementById(id))).join(" "));
+        return norm(t.getAttribute("aria-label")) || norm(textOf(t)) || norm(t.getAttribute("title"));
+      };
+      const isOpen = (el) => {
+        try { return el.matches(":popover-open"); } catch { return el.classList.contains(":popover-open"); }
+      };
+
+      function wireHints(root = document) {
+        for (const trigger of root.querySelectorAll("[interestfor]")) {
+          const hint = document.getElementById(trigger.getAttribute("interestfor"));
+          if (!hint || hint.getAttribute("popover") !== "hint") continue;
+          const name = nameOf(trigger);
+          if (norm(hint.textContent) === name) continue;
+          if (!hint.hasAttribute("role")) hint.setAttribute("role", "tooltip");
+          if (!name) {
+            if (!trigger.hasAttribute("aria-labelledby")) trigger.setAttribute("aria-labelledby", hint.id);
+            continue;
+          }
+          const opensOnActivation =
+            trigger.getAttribute("popovertarget") === hint.id || trigger.getAttribute("commandfor") === hint.id;
+          if (opensOnActivation) {
+            if (!trigger.hasAttribute("aria-expanded")) {
+              trigger.setAttribute("aria-expanded", String(isOpen(hint)));
+              owned.add(trigger);
+            }
+          } else if (!trigger.hasAttribute("aria-describedby")) {
+            trigger.setAttribute("aria-describedby", hint.id);
+          }
+        }
+      }
+
+      // `toggle` doesn't bubble: listen in the capture phase.
+      document.addEventListener("toggle", (e) => {
+        const hint = e.target;
+        if (!hint.id) return;
+        for (const t of document.querySelectorAll(`[interestfor="${CSS.escape(hint.id)}"]`)) {
+          if (owned.has(t)) t.setAttribute("aria-expanded", String(e.newState === "open"));
+        }
+      }, true);
+
+      window.wireHints = wireHints;
+      wireHints();
+    })();
+  </script>
+  <script type="module">
+    // Load polyfills only where native support is missing (order matters:
+    // interestfor builds on popover).
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+  </script>
+
