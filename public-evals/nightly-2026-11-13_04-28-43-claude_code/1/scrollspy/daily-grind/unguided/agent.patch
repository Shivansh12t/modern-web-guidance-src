+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var links = Array.prototype.slice.call(document.querySelectorAll('nav a.nav-section-link'));
+      var sections = links
+        .map(function (link) { return document.querySelector(link.getAttribute('href')); })
+        .filter(Boolean);
+      var ticking = false;
+
+      function navHeight() {
+        return nav.getBoundingClientRect().height;
+      }
+
+      function updateNavHeightVar() {
+        document.documentElement.style.setProperty('--nav-height', navHeight() + 'px');
+      }
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          var isActive = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function update() {
+        ticking = false;
+        // A section is "current" once its top passes a line just below the nav
+        var line = navHeight() + window.innerHeight * 0.25;
+        var current = null;
+
+        sections.forEach(function (section) {
+          if (section.getBoundingClientRect().top <= line) {
+            current = section.id;
+          }
+        });
+
+        // At the very bottom, the last section may be too short to reach the line
+        var scrolledToBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
+        if (scrolledToBottom && sections.length) {
+          current = sections[sections.length - 1].id;
+        }
+
+        setActive(current);
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', function () {
+        updateNavHeightVar();
+        requestUpdate();
+      });
+      window.addEventListener('load', requestUpdate);
+
+      updateNavHeightVar();
+      update();
+    })();
+  </script>
+
 </body>
 
