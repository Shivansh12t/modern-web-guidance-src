+  <script type="module">
+    const navLinks = [...document.querySelectorAll('nav ul a[href^="#"]')];
+
+    const setCurrent = (activeLink) => {
+      for (const link of navLinks) {
+        if (link === activeLink) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native :target-current handles the visual state; mirror it for assistive tech.
+      const sync = () => setCurrent(document.querySelector('nav ul a:target-current'));
+      sync();
+      document.addEventListener('scrollend', sync);
+    } else {
+      // Fallback: IntersectionObserver watching a line across the middle of the viewport.
+      const linkById = new Map(navLinks.map((link) => [link.hash.slice(1), link]));
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const active = linkById.get(entry.target.id);
+          for (const link of navLinks) {
+            link.classList.toggle('target-current', link === active);
+          }
+          setCurrent(active);
+        }
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      for (const id of linkById.keys()) {
+        const section = document.getElementById(id);
+        if (section) observer.observe(section);
+      }
+
+      // Clear the highlight when scrolled back up into the hero (above all sections).
+      const hero = document.querySelector('.hero');
+      new IntersectionObserver(([entry]) => {
+        if (entry.isIntersecting) {
+          navLinks.forEach((link) => link.classList.remove('target-current'));
+          setCurrent(null);
+        }
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 }).observe(hero);
+    }
+  </script>
+
