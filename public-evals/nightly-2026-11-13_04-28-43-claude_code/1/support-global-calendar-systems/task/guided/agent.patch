+  <script type="module">
+    // Load the Temporal polyfill only where the native API is missing (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      try {
+        const mod = await import('https://esm.sh/temporal-polyfill@1/full');
+        globalThis.Temporal = mod.Temporal;
+      } catch (err) {
+        console.error('Failed to load Temporal polyfill', err);
+      }
+    }
+
+    const form = document.getElementById('calendar-form');
+    const input = document.getElementById('calendar-date-input');
+    const status = document.getElementById('calendar-status');
+    const cards = document.querySelectorAll('.calendar-card');
+
+    // Candidate calendar IDs in order of preference. "islamic" alone is
+    // deprecated in some engines, so prefer the well-defined variants.
+    const CALENDAR_CANDIDATES = {
+      islamic: ['islamic-umalqura', 'islamic-civil', 'islamic-tbla', 'islamic'],
+      hebrew: ['hebrew'],
+      japanese: ['japanese'],
+    };
+
+    function supportedCalendars() {
+      try {
+        return new Set(Intl.supportedValuesOf('calendar'));
+      } catch {
+        return null;
+      }
+    }
+
+    const supported = supportedCalendars();
+
+    function resolveCalendar(key, probe) {
+      for (const id of CALENDAR_CANDIDATES[key]) {
+        if (supported && !supported.has(id)) continue;
+        try {
+          const d = probe.withCalendar(id);
+          if (d.calendarId === id) return id;
+        } catch { /* try next */ }
+      }
+      return null;
+    }
+
+    function el(tag, props = {}, children = []) {
+      const node = document.createElement(tag);
+      Object.assign(node, props);
+      for (const child of [].concat(children)) {
+        node.append(child instanceof Node ? child : document.createTextNode(String(child)));
+      }
+      return node;
+    }
+
+    function formatLocalized(date, calendarId) {
+      const opts = { year: 'numeric', month: 'long', day: 'numeric' };
+      // Era-based calendars (Japanese) need the era name to be meaningful.
+      if (date.era !== undefined) opts.era = 'long';
+      return date.toLocaleString(`en-u-ca-${calendarId}`, opts);
+    }
+
+    function monthName(date, calendarId) {
+      return date.toLocaleString(`en-u-ca-${calendarId}`, { month: 'long' });
+    }
+
+    function renderCard(card, isoDate, today) {
+      const output = card.querySelector('.calendar-output');
+      const key = card.dataset.calendar;
+      const calendarId = resolveCalendar(key, isoDate);
+
+      if (!calendarId) {
+        output.replaceChildren(el('p', { textContent: 'This calendar is not supported by your browser.' }));
+        return;
+      }
+
+      const date = isoDate.withCalendar(calendarId);
+      const todayInCal = today.withCalendar(calendarId);
+      const cmp = Temporal.PlainDate.compare(date, todayInCal);
+      const relative = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+      const yearText = date.era !== undefined && date.eraYear !== undefined && date.eraYear !== date.year
+        ? `${date.year} (${date.era} ${date.eraYear})`
+        : String(date.year);
+
+      const dl = el('dl');
+      const rows = [
+        ['Year', yearText],
+        ['Month', date.month],
+        ['Month code', date.monthCode],
+        ['Day', date.day],
+        ['Months in year', date.monthsInYear],
+        ['Status', el('span', { className: 'relative-badge', textContent: relative })],
+      ];
+      for (const [label, value] of rows) {
+        const dd = el('dd', {}, value);
+        dd.dataset.field = label.toLowerCase().replace(/\s+/g, '-');
+        dl.append(el('dt', { textContent: label }), dd);
+      }
+      dl.querySelector('.relative-badge').dataset.relative = relative;
+
+      const tbody = el('tbody');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const first = date.with({ month: m, day: 1 });
+        const row = el('tr', {}, [
+          el('td', { textContent: m }),
+          el('td', { textContent: monthName(first, calendarId) }),
+          el('td', { textContent: first.monthCode }),
+          el('td', { textContent: first.daysInMonth }),
+        ]);
+        if (m === date.month) {
+          row.className = 'current-month';
+          row.setAttribute('aria-current', 'date');
+        }
+        tbody.append(row);
+      }
+
+      const table = el('table', { className: 'month-table' }, [
+        el('caption', { className: 'visually-hidden', textContent: `Months of ${calendarId} year ${date.year}` }),
+        el('thead', {}, el('tr', {}, ['#', 'Month', 'Code', 'Days'].map(h => el('th', { scope: 'col', textContent: h })))),
+        tbody,
+      ]);
+
+      const details = el('details', {}, [
+        el('summary', { textContent: `Months in ${date.year} (${date.monthsInYear})` }),
+        table,
+      ]);
+
+      output.replaceChildren(
+        el('p', { className: 'localized', textContent: formatLocalized(date, calendarId) }),
+        el('p', { className: 'calendar-id' }, el('small', { textContent: `Calendar: ${calendarId}` })),
+        dl,
+        details,
+      );
+    }
+
+    function update() {
+      if (typeof Temporal === 'undefined') {
+        status.textContent = 'Calendar conversion is unavailable in this browser.';
+        return;
+      }
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        status.textContent = 'Please choose a valid date.';
+        return;
+      }
+      const today = Temporal.Now.plainDateISO();
+      cards.forEach(card => renderCard(card, isoDate, today));
+      status.textContent = `Showing ${isoDate.toLocaleString('en', { dateStyle: 'long' })} in three calendars.`;
+    }
+
+    if (typeof Temporal !== 'undefined') {
+      input.value = Temporal.Now.plainDateISO().toString();
+    }
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      update();
+    });
+    input.addEventListener('change', update);
+
+    update();
+  </script>
+
 </body>
 
