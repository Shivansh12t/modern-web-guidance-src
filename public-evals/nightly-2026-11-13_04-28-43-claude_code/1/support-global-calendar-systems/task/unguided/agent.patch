+  <script>
+    (function () {
+      var CALENDARS = {
+        islamic: ['islamic', 'islamic-umalqura', 'islamic-civil'],
+        hebrew: ['hebrew'],
+        japanese: ['japanese']
+      };
+      var input = document.getElementById('calendar-date-input');
+
+      function loadTemporal() {
+        if (globalThis.Temporal) return Promise.resolve(globalThis.Temporal);
+        return new Promise(function (resolve, reject) {
+          var s = document.createElement('script');
+          s.src = 'https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/global.min.js';
+          s.onload = function () {
+            globalThis.Temporal ? resolve(globalThis.Temporal) : reject(new Error('Temporal unavailable'));
+          };
+          s.onerror = function () { reject(new Error('Failed to load Temporal polyfill')); };
+          document.head.appendChild(s);
+        });
+      }
+
+      function escapeHtml(str) {
+        return String(str).replace(/[&<>"']/g, function (c) {
+          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+        });
+      }
+
+      function withCalendar(T, iso, ids) {
+        for (var i = 0; i < ids.length; i++) {
+          try { return iso.withCalendar(ids[i]); } catch (e) { /* try next */ }
+        }
+        throw new Error('Calendar not supported: ' + ids[0]);
+      }
+
+      function localized(date) {
+        var opts = { calendar: date.calendarId, year: 'numeric', month: 'long', day: 'numeric' };
+        if (date.calendarId === 'japanese') opts.era = 'long';
+        try {
+          return date.toLocaleString('en-US', opts);
+        } catch (e) {
+          return date.toString();
+        }
+      }
+
+      function render(T, isoString) {
+        var iso = T.PlainDate.from(isoString);
+        var today = T.Now.plainDateISO();
+        var cmp = T.PlainDate.compare(iso, today);
+        var status = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+        Object.keys(CALENDARS).forEach(function (key) {
+          var card = document.querySelector('[data-calendar="' + key + '"]');
+          var body = card.querySelector('.calendar-body');
+          try {
+            var d = withCalendar(T, iso, CALENDARS[key]);
+            var rows = '';
+            for (var m = 1; m <= d.monthsInYear; m++) {
+              var first = T.PlainDate.from({ calendar: d.calendarId, year: d.year, month: m, day: 1 });
+              rows += '<tr' + (m === d.month ? ' class="current"' : '') + '>' +
+                '<td>' + m + '</td>' +
+                '<td>' + escapeHtml(first.monthCode) + '</td>' +
+                '<td>' + escapeHtml(first.toLocaleString('en-US', { calendar: d.calendarId, month: 'long' })) + '</td>' +
+                '<td>' + first.daysInMonth + '</td></tr>';
+            }
+            var yearInfo = String(d.year);
+            if (d.era !== undefined && d.eraYear !== undefined) {
+              yearInfo += ' (era ' + escapeHtml(d.era) + ', year ' + d.eraYear + ')';
+            }
+            body.innerHTML =
+              '<p class="localized">' + escapeHtml(localized(d)) + '</p>' +
+              '<dl>' +
+              '<dt>Year</dt><dd class="cal-year">' + yearInfo + '</dd>' +
+              '<dt>Month</dt><dd class="cal-month">' + d.month + '</dd>' +
+              '<dt>Month code</dt><dd class="cal-month-code">' + escapeHtml(d.monthCode) + '</dd>' +
+              '<dt>Day</dt><dd class="cal-day">' + d.day + '</dd>' +
+              '<dt>Months in year</dt><dd class="cal-months-in-year">' + d.monthsInYear + '</dd>' +
+              '<dt>Status</dt><dd><span class="status cal-status ' + status.toLowerCase() + '">' + status + '</span></dd>' +
+              '</dl>' +
+              '<table><thead><tr><th>#</th><th>Code</th><th>Month</th><th>Days</th></tr></thead>' +
+              '<tbody>' + rows + '</tbody></table>';
+          } catch (e) {
+            body.innerHTML = '<p class="calendar-error">' + escapeHtml(e.message) + '</p>';
+          }
+        });
+      }
+
+      loadTemporal().then(function (T) {
+        input.value = T.Now.plainDateISO().toString();
+        var update = function () { if (input.value) render(T, input.value); };
+        input.addEventListener('input', update);
+        input.addEventListener('change', update);
+        update();
+      }).catch(function (e) {
+        document.querySelectorAll('.calendar-card .calendar-body').forEach(function (b) {
+          b.innerHTML = '<p class="calendar-error">Calendar conversion is unavailable: ' + escapeHtml(e.message) + '</p>';
+        });
+      });
+    })();
+  </script>
