+  <script>
+    // Fallback for browsers without CSS scroll-driven animations:
+    // drive each #animated section from its matching #tracked section via IntersectionObserver.
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)') &&
+      !matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const animated = document.querySelector('#animated');
+      const visuals = animated.querySelectorAll('section');
+      const steps = [...document.querySelectorAll('#tracked section')];
+      animated.classList.add('scroll-fallback');
+
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          const i = steps.indexOf(entry.target);
+          const visual = visuals[i];
+          if (!visual) continue;
+          // 0 → 1 as the step fills the viewport (works for steps taller than the viewport too)
+          const ratio = Math.min(1, entry.intersectionRect.height /
+            Math.min(entry.boundingClientRect.height, innerHeight));
+          const leavingTop = entry.boundingClientRect.top < 0 && i < steps.length - 1;
+
+          if (leavingTop) {
+            visual.style.opacity = ratio;
+            visual.style.transform = 'none';
+            visual.style.translate = `0 ${-(1 - ratio) * 12}%`;
+          } else if (entry.boundingClientRect.top >= 0 || i < steps.length - 1) {
+            visual.style.opacity = ratio;
+            visual.style.transform = `scale(${0.85 + ratio * 0.15}) rotateY(${-25 + ratio * 25}deg)`;
+            visual.style.translate = '0 0';
+          }
+        }
+      }, { threshold: Array.from({ length: 101 }, (_, i) => i / 100) });
+
+      steps.forEach((step) => observer.observe(step));
+    }
+  </script>
