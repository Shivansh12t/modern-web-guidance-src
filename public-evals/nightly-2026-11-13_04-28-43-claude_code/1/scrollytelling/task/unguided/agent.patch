+  <script>
+    (function () {
+      var tracked = Array.prototype.slice.call(document.querySelectorAll('#tracked > section'));
+      var animated = Array.prototype.slice.call(document.querySelectorAll('#animated > section'));
+      var dots = Array.prototype.slice.call(document.querySelectorAll('.scrolly-dots li'));
+      var sticky = document.querySelector('.scrolly-sticky');
+      if (!tracked.length || !animated.length) return;
+
+      var activeIndex = -1;
+      var ticking = false;
+
+      function clamp(v, min, max) { return Math.min(max, Math.max(min, v)); }
+
+      function setActive(index) {
+        if (index === activeIndex) return;
+        activeIndex = index;
+        tracked.forEach(function (el, i) { el.classList.toggle('is-active', i === index); });
+        animated.forEach(function (el, i) { el.classList.toggle('is-active', i === index); });
+        dots.forEach(function (el, i) { el.classList.toggle('is-active', i === index); });
+      }
+
+      function update() {
+        ticking = false;
+        // Trigger line sits at the vertical middle of the viewport.
+        var trigger = window.innerHeight / 2;
+        var current = 0;
+
+        tracked.forEach(function (step, i) {
+          var rect = step.getBoundingClientRect();
+          // 0 when the step's top reaches the trigger line, 1 when its bottom passes it.
+          var progress = clamp((trigger - rect.top) / rect.height, 0, 1);
+          if (rect.top <= trigger) current = i;
+          var visual = animated[i];
+          if (visual) visual.style.setProperty('--progress', progress.toFixed(4));
+        });
+
+        setActive(current);
+
+        // Overall progress across all steps for the progress bar.
+        var first = tracked[0].getBoundingClientRect();
+        var last = tracked[tracked.length - 1].getBoundingClientRect();
+        var total = last.bottom - first.top;
+        var overall = clamp((trigger - first.top) / total, 0, 1);
+        if (sticky) sticky.style.setProperty('--overall', overall.toFixed(4));
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
