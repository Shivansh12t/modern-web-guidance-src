+    .option-icon[data-icon="cream"] { --icon: var(--icon-cream); }
+    .option-icon[data-icon="spice"] { --icon: var(--icon-spice); }
+    .option-icon[data-icon="ice"] { --icon: var(--icon-ice); }
+    .option-icon[data-icon="sweet"] { --icon: var(--icon-sweet); }
+
+    /* Custom checkbox: native <input> remains the interactive target */
+    .checkbox-custom {
+      --checkbox-size: 1.3em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      display: inline-grid;
+      place-content: center;
+      flex-shrink: 0;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid #6d4c41;
+      border-radius: 5px;
+      background-color: white;
+      color: var(--accent);
+      cursor: pointer;
+    }
+
+    .checkbox-custom::before {
+      content: "";
+      inline-size: var(--checkbox-icon-size);
+      aspect-ratio: 1;
+      background-color: currentColor;
+      mask: var(--checkbox-icon, var(--icon-check)) no-repeat center / contain;
+      scale: 0;
+      rotate: -45deg;
+    }
+
+    .checkbox-custom:is(:checked, :indeterminate) {
+      background-color: var(--primary);
+      border-color: var(--primary);
+    }
+
+    .checkbox-custom:checked {
+      --checkbox-icon: var(--icon-check);
+    }
+
+    .checkbox-custom:indeterminate {
+      --checkbox-icon: var(--icon-dash);
+    }
+
+    .checkbox-custom:is(:checked, :indeterminate)::before {
+      scale: 1;
+      rotate: 0deg;
+    }
+
+    .checkbox-custom:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .checkbox-custom:disabled {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    .option:has(:disabled) {
+      cursor: not-allowed;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .checkbox-custom {
+        transition: background-color 0.2s ease, border-color 0.2s ease;
+      }
+
+      .checkbox-custom::before {
+        transition: scale 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), rotate 0.25s ease;
+      }
+
+      .checkbox-custom:checked {
+        animation: checkbox-pop 0.3s ease;
+      }
+
+      .checkbox-custom:active:not(:disabled) {
+        scale: 0.88;
+      }
+    }
+
+    @keyframes checkbox-pop {
+      50% {
+        box-shadow: 0 0 0 6px rgba(255, 171, 64, 0.35);
+      }
+    }
+
+    @media (forced-colors: active) {
+      .checkbox-custom {
+        border-color: CanvasText;
+      }
+
+      .checkbox-custom::before {
+        background-color: CanvasText;
+      }
+
+      .checkbox-custom:is(:checked, :indeterminate) {
+        background-color: Canvas;
+        border-color: Highlight;
+      }
+
+      .option-icon {
+        background-color: CanvasText;
+      }
+    }
+
+    .visually-hidden {
+      position: absolute;
+      clip-path: inset(50%);
+      overflow: hidden;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      padding: 0;
+      border: 0;
+      white-space: nowrap;
+    }
+
+    .card-actions {
+      margin-top: auto;
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 10px;
+    }
+
+    .card-actions .btn {
+      font: inherit;
+      border: 2px solid var(--primary);
+      cursor: pointer;
+    }
+
+    .btn-outline {
+      background: white;
+      color: var(--primary);
+    }
+
+    .btn-outline:hover {
+      background: #efebe9;
+    }
+
+    .btn:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
