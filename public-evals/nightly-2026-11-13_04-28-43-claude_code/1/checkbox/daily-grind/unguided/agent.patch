+  <script>
+    // Progressive enhancement only: the checkboxes are fully functional without JS.
+    document.querySelectorAll('.customize').forEach((group) => {
+      const summary = group.querySelector('.customize-summary');
+      const boxes = group.querySelectorAll('input[type="checkbox"]');
+      const update = () => {
+        const checked = [...boxes].filter((b) => b.checked);
+        const total = checked.reduce((sum, b) => sum + parseFloat(b.dataset.price || 0), 0);
+        summary.textContent = checked.length
+          ? `${checked.length} add-on${checked.length > 1 ? 's' : ''} selected (+$${total.toFixed(2)})`
+          : '';
+      };
+      boxes.forEach((box) => {
+        box.addEventListener('change', () => {
+          // Lets CSS play a distinct "release" animation on uncheck only.
+          box.classList.toggle('was-checked', !box.checked);
+          update();
+        });
+      });
+      update();
+    });
+  </script>
+
 </body>
 
