+  <script>
+    (function () {
+      // Logout confirmation dialog
+      var dialog = document.getElementById('logout-dialog');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+
+      if (dialog && typeof dialog.showModal === 'function') {
+        openBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          dialog.showModal();
+        });
+
+        closeBtn.addEventListener('click', function () {
+          dialog.close();
+        });
+
+        // Close when clicking the backdrop (outside the dialog box)
+        dialog.addEventListener('click', function (e) {
+          if (e.target !== dialog) return;
+          var r = dialog.getBoundingClientRect();
+          var inside = e.clientX >= r.left && e.clientX <= r.right &&
+                       e.clientY >= r.top && e.clientY <= r.bottom;
+          if (!inside) dialog.close();
+        });
+
+        dialog.addEventListener('close', function () {
+          openBtn.focus();
+        });
+      }
+      // If <dialog> is unsupported, the link simply navigates to /logout.
+
+      // Floating informational notice
+      var notice = document.getElementById('info-notice');
+      var trigger = document.getElementById('foobar');
+      var dismiss = document.getElementById('close-notice-btn');
+      var hideTimer = null;
+
+      function showNotice() {
+        notice.classList.add('is-visible');
+        notice.setAttribute('aria-hidden', 'false');
+        trigger.setAttribute('aria-expanded', 'true');
+        clearTimeout(hideTimer);
+        hideTimer = setTimeout(hideNotice, 8000);
+      }
+
+      function hideNotice() {
+        clearTimeout(hideTimer);
+        var hadFocus = notice.contains(document.activeElement);
+        notice.classList.remove('is-visible');
+        notice.setAttribute('aria-hidden', 'true');
+        trigger.setAttribute('aria-expanded', 'false');
+        if (hadFocus) trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () {
+        if (notice.classList.contains('is-visible')) hideNotice();
+        else showNotice();
+      });
+
+      dismiss.addEventListener('click', hideNotice);
+
+      // Pause auto-dismiss while the user is interacting with the notice
+      notice.addEventListener('mouseenter', function () { clearTimeout(hideTimer); });
+      notice.addEventListener('focusin', function () { clearTimeout(hideTimer); });
+      notice.addEventListener('mouseleave', function () {
+        if (notice.classList.contains('is-visible')) hideTimer = setTimeout(hideNotice, 4000);
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && notice.classList.contains('is-visible') && !dialog.open) hideNotice();
+      });
+    })();
+  </script>
+
