+  <script type="module">
+    // Load polyfills only where native support is missing
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js').catch(console.error);
+    }
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(console.error);
+    }
+
+    // Exit transitions need discrete display + overlay transitions; Firefox/Safari
+    // lack one of them, so there we animate via [data-closing] before closing.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return (supportsDisplayTransition = false);
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+    const supportsTopLayerExit = () => window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+
+    async function closeTopLayer(el, close) {
+      if (!supportsTopLayerExit()) {
+        el.setAttribute('data-closing', '');
+        const animations = el.getAnimations({ subtree: true });
+        if (animations.length) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!el.hasAttribute('data-closing')) return;
+        el.removeAttribute('data-closing');
+      }
+      close();
+    }
+
+    // ----- Logout dialog -----
+    const dialog = document.getElementById('logout-dialog');
+    const closeDialog = () => closeTopLayer(dialog, () => dialog.close());
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    // Route Esc / back gesture through the animated close
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+    // Light-dismiss fallback where closedby isn't supported (Safari)
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) closeDialog(); });
+    }
+
+    // ----- Floating notice -----
+    const notice = document.getElementById('info-notice');
+    const trigger = document.getElementById('foobar');
+    const announcer = document.getElementById('sr-announcer');
+
+    notice.addEventListener('toggle', (e) => {
+      if (e.newState !== 'open') return;
+      const message = `${document.getElementById('info-notice-title').textContent}. ${document.getElementById('info-notice-text').textContent}`;
+      if ('ariaNotify' in document) {
+        document.ariaNotify(message);
+      } else {
+        announcer.textContent = '';
+        requestAnimationFrame(() => { announcer.textContent = message; });
+      }
+    });
+
+    notice.querySelector('.notice-close').addEventListener('click', () => {
+      const hadFocus = notice.contains(document.activeElement);
+      closeTopLayer(notice, () => {
+        notice.hidePopover();
+        if (hadFocus) trigger.focus(); // don't strand focus on the removed button
+      });
+    });
+  </script>
+
