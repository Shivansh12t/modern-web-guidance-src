+  <script>
+    // The "View Details" links declare interestfor="seasonal-preview", so the
+    // browser itself handles hover, keyboard focus and long-press, and fires
+    // `interest` / `loseinterest` on the preview box. No per-button listeners.
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const nameEl = preview.querySelector('.preview-name');
+      const accentEl = preview.querySelector('.preview-accent');
+      const DEFAULT_TEXT = 'Select a drink to preview';
+
+      const reset = () => {
+        preview.classList.remove('is-active');
+        preview.style.removeProperty('--preview-accent');
+        nameEl.textContent = DEFAULT_TEXT;
+        accentEl.textContent = '';
+      };
+
+      preview.addEventListener('interest', (event) => {
+        const source = event.source;
+        if (!source) return;
+        const { drink, accent, accentName } = source.dataset;
+        nameEl.textContent = drink || DEFAULT_TEXT;
+        accentEl.textContent = accent ? `Accent: ${[accentName, accent].filter(Boolean).join(' ')}` : '';
+        if (accent) preview.style.setProperty('--preview-accent', accent);
+        preview.classList.add('is-active');
+      });
+
+      preview.addEventListener('loseinterest', reset);
+    })();
+  </script>
+
