+  <script type="module">
+    const button = document.getElementById('reauth-btn');
+    const statusEl = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function ensureWebAuthnJSONSupport() {
+      if (!window.PublicKeyCredential) return false;
+      if (
+        typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        // Pinned, SRI-protected polyfill (see import map) for older browsers.
+        await import('webauthn-polyfills');
+      }
+      return typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function';
+    }
+
+    async function triggerReauth() {
+      // Cancel any in-flight WebAuthn request to avoid prompt collisions.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Requesting verification…');
+
+      try {
+        if (!(await ensureWebAuthnJSONSupport())) {
+          setStatus('This browser does not support passkeys.', 'error');
+          return;
+        }
+
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Options request failed (${optionsResponse.status})`);
+        }
+        const optionsJSON = await optionsResponse.json();
+
+        // Reauth must be scoped to the signed-in user's registered passkeys;
+        // never fall back to discoverable credentials here.
+        if (!Array.isArray(optionsJSON.allowCredentials) || optionsJSON.allowCredentials.length === 0) {
+          setStatus('No passkey is registered for this account.', 'error');
+          return;
+        }
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        setStatus('Follow your device prompt to confirm it\'s you…');
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          setStatus('Verification was not completed.', 'error');
+          return;
+        }
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          setStatus('Identity confirmed. You can now update your account.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+        } else if (verifyResponse.status === 404) {
+          setStatus('That passkey is no longer registered to your account.', 'error');
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId, // server-provided rpId only
+              credentialId: encodedCredential.id,
+            }).catch(() => {});
+          }
+        } else {
+          setStatus('Verification failed. Please try again.', 'error');
+        }
+      } catch (err) {
+        if (err.name === 'AbortError') return;
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled or timed out.', 'error');
+        } else {
+          console.error(err);
+          setStatus('Something went wrong. Please try again.', 'error');
+        }
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', triggerReauth);
+  </script>
+
