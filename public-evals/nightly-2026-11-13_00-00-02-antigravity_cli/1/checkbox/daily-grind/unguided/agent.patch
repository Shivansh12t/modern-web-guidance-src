+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:checked) {
+      border-color: var(--primary);
+      background-color: #fff8ef;
+      box-shadow: 0 2px 6px rgba(78, 52, 46, 0.08);
+    }
+
+    /* Keyboard focus accessibility styles */
+    .custom-checkbox input[type="checkbox"]:focus-visible + .checkbox-box {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.25);
+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:focus-visible) {
+      border-color: var(--accent);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.25);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .custom-checkbox,
+      .checkbox-box,
+      .checkbox-box svg,
+      .option-icon,
+      .option-label,
+      .option-price {
+        transition: none;
+      }
+    }
