+      stroke-linejoin: round;
+      stroke-dasharray: 24;
+      stroke-dashoffset: 24;
+      opacity: 0;
+      transform: scale(0.6);
+      transition: stroke-dashoffset 0.28s cubic-bezier(0.4, 0, 0.2, 1),
+                  opacity 0.2s ease,
+                  transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    /* Custom option thematic icon */
+    .option-icon {
