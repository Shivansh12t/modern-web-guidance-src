+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theater-mode-toggle');
+      const videoIframe = document.getElementById('coffee-roasting-video');
+      const heroSection = document.querySelector('.hero');
+      const videoContainer = document.getElementById('video-container');
+
+      let isTheaterMode = false;
+
+      toggleBtn.addEventListener('click', function () {
+        isTheaterMode = !isTheaterMode;
+        const destination = isTheaterMode ? heroSection : videoContainer;
+
+        if (typeof destination.moveBefore === 'function') {
+          destination.moveBefore(videoIframe, null);
+        } else {
+          destination.appendChild(videoIframe);
+        }
+
+        heroSection.classList.toggle('theater-active', isTheaterMode);
+        toggleBtn.setAttribute('aria-pressed', String(isTheaterMode));
+        toggleBtn.textContent = isTheaterMode ? 'Exit Theater Mode' : 'Toggle Theater Mode';
+      });
+    })();
+  </script>
