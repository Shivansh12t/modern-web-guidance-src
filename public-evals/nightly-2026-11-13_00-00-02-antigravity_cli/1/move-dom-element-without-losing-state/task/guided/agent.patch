+  <script>
+    const theaterToggleBtn = document.getElementById('theater-toggle-btn');
+    const heroSection = document.getElementById('hero-section');
+    const videoSectionSlot = document.getElementById('video-section-slot');
+    const videoContainer = document.getElementById('roasting-video-container');
+    const theaterStatus = document.getElementById('theater-status');
+
+    let isTheaterMode = false;
+
+    function moveElementPreservingState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterToggleBtn.addEventListener('click', () => {
+      isTheaterMode = !isTheaterMode;
+      const targetParent = isTheaterMode ? heroSection : videoSectionSlot;
+
+      moveElementPreservingState(targetParent, videoContainer);
+
+      heroSection.classList.toggle('theater-active', isTheaterMode);
+      theaterToggleBtn.setAttribute('aria-pressed', String(isTheaterMode));
+      theaterToggleBtn.textContent = isTheaterMode
+        ? 'Exit Theater Mode'
+        : 'Enable Theater Mode';
+      theaterStatus.textContent = isTheaterMode
+        ? 'Video moved to hero section in theater mode.'
+        : 'Video returned to the roastery section.';
+    });
+  </script>
+
