+    /* Visually Hidden Utility */
+    .visually-hidden {
+      position: absolute;
+      clip-path: inset(50%);
+      overflow: hidden;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      padding: 0;
+      border: 0;
+      white-space: nowrap;
+    }
+
+    /* Roast Picker (Customizable Select) */
+    .roast-picker-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.35rem;
+      margin-top: 1.25rem;
+      width: 100%;
+      max-width: 340px;
+      text-align: left;
+    }
+
+    .roast-label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      color: var(--light);
+      letter-spacing: 0.3px;
+    }
+
+    select.roast-select,
+    select.roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    select.roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 0.65rem 0.9rem;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      background-color: rgba(62, 39, 35, 0.92);
+      color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    @media (pointer: coarse) {
+      select.roast-select {
+        min-height: 52px;
+      }
+    }
+
+    select.roast-select:hover {
+      border-color: var(--accent);
+      background-color: rgba(62, 39, 35, 1);
+    }
+
+    select.roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.roast-select::picker-icon {
+      color: var(--accent);
+    }
+
+    select.roast-select button {
+      display: flex;
+      align-items: center;
+      gap: 0.65rem;
+      background: none;
+      border: none;
+      color: inherit;
+      font: inherit;
+      padding: 0;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 0.65rem;
+    }
+
+    select.roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.roast-select::picker(select) {
+      background-color: #2b1b17;
+      color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      padding: 0.5rem;
+      margin-top: 0.35rem;
+      box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.55);
+      width: anchor-size(width);
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0.65rem 0.75rem;
+      border-radius: 6px;
+      color: var(--light);
+      cursor: pointer;
+      transition: background-color 0.15s;
+    }
+
+    select.roast-select option + option {
+      margin-top: 0.25rem;
+    }
+
+    select.roast-select option:hover {
+      background-color: #4e342e;
+    }
+
+    select.roast-select option::checkmark {
+      display: none;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--accent);
+      color: #2b1b17;
+      outline: 2px solid var(--light);
+      outline-offset: -2px;
+    }
+
+    select.roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.roast-select option:checked .option-desc {
+      color: #3e2723;
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+      width: 24px;
+      height: 24px;
+      color: var(--accent);
+    }
+
+    select.roast-select option:checked .option-icon {
+      color: #2b1b17;
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-size: 0.95rem;
+      font-weight: 600;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: var(--secondary);
+    }
+
