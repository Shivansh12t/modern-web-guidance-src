+              </div>
+              <div class="notes-tags">
+                ${notesSet.map(n => `<span class="note-tag">${n}</span>`).join('')}
+              </div>
+            </article>
+          `;
+        }).join('');
+
+        topBlendsGrid.querySelectorAll('.blend-card').forEach(card => {
+          card.addEventListener('click', () => {
+            const id = card.getAttribute('data-blend-id');
+            const found = currentTopBlends.find(b => b.id === id);
+            if (found) {
+              selectedBlendId = found.id;
+              updateRadarAndBars(getTargetConfig(), found.profile, `Inspecting ${found.id} (${found.matchScore}%)`);
+              renderBlendsList();
+            }
+          });
+        });
+      }
+
+      function updateKPIs(msg) {
+        kpiTotalBlends.textContent = msg.processed.toLocaleString();
+        kpiHighMatches.textContent = `${msg.highMatchCount.toLocaleString()} high-harmony matches (≥88%)`;
+        const best = (msg.topBlends && msg.topBlends[0]) || msg.bestBlend;
+        if (best) {
+          kpiTopScore.textContent = `${best.matchScore}%`;
+          kpiAvgScore.textContent = `Batch Avg Harmony: ${msg.avgMatch}%`;
+          kpiTopOrigin.textContent = `${best.components[0].pct}% ${best.components[0].name}`;
+          const rest = best.components.slice(1).map(c => `${c.pct}% ${c.name}`).join(', ');
+          kpiTopSecondary.textContent = rest ? `+ ${rest}` : `${best.roast} Roast`;
+          kpiExtractionSpec.textContent = `${best.extractionYield}% Yield @ ${best.brewTempC}°C`;
+          kpiGrindSpec.textContent = `${best.grindMicrons} µm Grind • Ratio ${best.ratio}`;
+        }
+      }
+
+      function createSimulationWorker() {
+        try {
+          const blob = new Blob([WORKER_SOURCE], { type: 'application/javascript' });
+          const blobUrl = URL.createObjectURL(blob);
+          return new Worker(blobUrl);
+        } catch (err) {
+          try {
+            return new Worker('simulator-worker.js');
+          } catch (err2) {
+            return null;
+          }
+        }
+      }
+
+      function handleWorkerMessage(e) {
+        const msg = e.data;
+        if (!msg || msg.runId !== currentRunId) return;
+
+        if (msg.type === 'progress') {
+          latestProgressMsg = msg;
+          if (!pendingProgressFrame) {
+            pendingProgressFrame = requestAnimationFrame(() => {
+              pendingProgressFrame = null;
+              if (!latestProgressMsg) return;
+              const m = latestProgressMsg;
+              progressCount.textContent = `${m.processed.toLocaleString()} / ${m.total.toLocaleString()}`;
+              progressPct.textContent = `${m.percent}%`;
+              progressFill.style.width = `${m.percent}%`;
+              progressBarAria.setAttribute('aria-valuenow', String(m.percent));
+              nativeProgress.value = m.percent;
+              throughputEl.textContent = `${m.throughput.toLocaleString()} blends/sec`;
+              elapsedEl.textContent = `${m.elapsedMs} ms`;
+              updateKPIs(m);
+              if (m.bestBlend) {
+                updateRadarAndBars(getTargetConfig(), m.bestBlend.profile, `Leading: ${m.bestBlend.id} (${m.bestBlend.matchScore}%)`);
+              }
+            });
+          }
+        } else if (msg.type === 'complete') {
+          if (pendingProgressFrame) {
+            cancelAnimationFrame(pendingProgressFrame);
+            pendingProgressFrame = null;
+          }
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+          statusPill.className = 'status-pill completed';
+          statusText.textContent = `Simulation Complete (${msg.total.toLocaleString()} Blends Analyzed)`;
+          progressCount.textContent = `${msg.total.toLocaleString()} / ${msg.total.toLocaleString()}`;
+          progressPct.textContent = '100%';
+          progressFill.style.width = '100%';
+          progressBarAria.setAttribute('aria-valuenow', '100');
+          nativeProgress.value = 100;
+          throughputEl.textContent = `${msg.throughput.toLocaleString()} blends/sec`;
+          elapsedEl.textContent = `${msg.elapsedMs} ms`;
+
+          currentTopBlends = msg.topBlends || [];
+          selectedBlendId = currentTopBlends[0] ? currentTopBlends[0].id : null;
+          updateKPIs(msg);
+          if (currentTopBlends[0]) {
+            updateRadarAndBars(getTargetConfig(), currentTopBlends[0].profile, `Best Match: ${currentTopBlends[0].id} (${currentTopBlends[0].matchScore}%)`);
+          }
+          renderBlendsList();
+        } else if (msg.type === 'cancelled') {
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+          statusPill.className = 'status-pill';
+          statusText.textContent = 'Simulation Cancelled';
+        }
+      }
+
+      function startBatchSimulation() {
+        currentRunId++;
+        const runId = currentRunId;
+        const batchSize = Number(selectBatchSize.value) || 25000;
+        const target = getTargetConfig();
+
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        statusPill.className = 'status-pill running';
+        statusText.textContent = 'Simulating Recipe Batch (Non-Blocking)...';
+        progressCount.textContent = `0 / ${batchSize.toLocaleString()}`;
+        progressPct.textContent = '0%';
+        progressFill.style.width = '0%';
+        progressBarAria.setAttribute('aria-valuenow', '0');
+        nativeProgress.value = 0;
+
+        if (!simWorker) {
+          simWorker = createSimulationWorker();
+          if (simWorker) {
+            simWorker.onmessage = handleWorkerMessage;
+          }
+        }
+
+        if (simWorker) {
+          simWorker.postMessage({
+            type: 'start',
+            runId,
+            batchSize,
+            target,
+            seed: Date.now() & 0x7fffffff
+          });
+        } else {
+          // Non-blocking time-sliced fallback (< 4ms budget per frame) if Worker is restricted
+          const fallbackCtx = {
+            postMessage: (data) => handleWorkerMessage({ data })
+          };
+          const runner = new Function('self', WORKER_SOURCE);
+          runner(fallbackCtx);
+          fallbackCtx.onmessage({
+            data: {
+              type: 'start',
+              runId,
+              batchSize,
+              target,
+              seed: Date.now() & 0x7fffffff
+            }
+          });
+        }
+      }
+
+      // Wire up Sliders
+      Object.keys(sliders).forEach(key => {
+        sliders[key].addEventListener('input', () => {
+          sliderVals[key].textContent = sliders[key].value;
+          const activeBlend = currentTopBlends.find(b => b.id === selectedBlendId) || currentTopBlends[0];
+          updateRadarAndBars(getTargetConfig(), activeBlend ? activeBlend.profile : null);
+        });
+      });
+
+      // Wire up Presets
+      presetButtons.forEach(btn => {
+        btn.addEventListener('click', () => {
+          presetButtons.forEach(b => b.classList.remove('active'));
+          btn.classList.add('active');
+          const presetKey = btn.getAttribute('data-preset');
+          const p = PRESETS[presetKey];
+          if (p) {
+            sliders.acidity.value = p.acidity;
+            sliders.body.value = p.body;
+            sliders.sweetness.value = p.sweetness;
+            sliders.bitterness.value = p.bitterness;
+            sliders.aroma.value = p.aroma;
+            Object.keys(sliders).forEach(k => {
+              sliderVals[k].textContent = sliders[k].value;
+            });
+            selectRoast.value = p.roast;
+            selectBrew.value = p.brewMethod;
+            startBatchSimulation();
+          }
+        });
+      });
+
+      runBtn.addEventListener('click', startBatchSimulation);
+
+      cancelBtn.addEventListener('click', () => {
+        if (simWorker) {
+          simWorker.postMessage({ type: 'cancel' });
+        }
+        currentRunId++;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+        statusPill.className = 'status-pill';
+        statusText.textContent = 'Simulation Cancelled';
+      });
+
+      resetBtn.addEventListener('click', () => {
+        const def = PRESETS.signature;
+        sliders.acidity.value = def.acidity;
+        sliders.body.value = def.body;
+        sliders.sweetness.value = def.sweetness;
+        sliders.bitterness.value = def.bitterness;
+        sliders.aroma.value = def.aroma;
+        Object.keys(sliders).forEach(k => {
+          sliderVals[k].textContent = sliders[k].value;
+        });
+        selectRoast.value = def.roast;
+        selectBrew.value = def.brewMethod;
+        selectBatchSize.value = '25000';
+        filterInput.value = '';
+        presetButtons.forEach(b => b.classList.toggle('active', b.getAttribute('data-preset') === 'signature'));
+        startBatchSimulation();
+      });
+
+      filterInput.addEventListener('input', renderBlendsList);
+
+      // Seed initial state immediately so page loads with populated top blends, and worker is warmed up
+      currentTopBlends = [
+        {
+          id: 'BLD-04812',
+          components: [
+            { name: 'Colombian Huila', pct: 50, notes: ['Caramel', 'Red Apple', 'Toasted Walnut'] },
+            { name: 'Costa Rican Tarrazu', pct: 30, notes: ['Honey', 'Apricot', 'Crisp Citrus'] },
+            { name: 'Ethiopian Yirgacheffe', pct: 20, notes: ['Jasmine', 'Bergamot', 'Peach'] }
+          ],
+          roast: 'Medium',
