+          matchScore: 98.4
+        },
+        {
+          id: 'BLD-11904',
+          components: [
+            { name: 'Guatemalan Antigua', pct: 55, notes: ['Cocoa Nib', 'Orange Zest', 'Maple'] },
+            { name: 'Colombian Huila', pct: 45, notes: ['Caramel', 'Red Apple', 'Toasted Walnut'] }
+          ],
+          roast: 'Medium',
+          brewMethod: 'Pour Over',
+          brewTempC: 94,
