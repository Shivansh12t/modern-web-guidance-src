+  <script>
+    (() => {
+      const menuSection = document.getElementById('coffee-menu');
+      if (!menuSection) return;
+
+      const tablist = menuSection.querySelector('[focusgroup]');
+      const tabs = Array.from(tablist.querySelectorAll('button'));
+      const panels = Array.from(menuSection.querySelectorAll('[role="tabpanel"]'));
+
+      function selectTab(selectedTab) {
+        if (!selectedTab) return;
+
+        for (const tab of tabs) {
+          const isSelected = tab === selectedTab;
+          tab.ariaSelected = String(isSelected);
+          tab.toggleAttribute('focusgroupstart', isSelected);
+        }
+
+        for (const panel of panels) {
+          const isActive = panel.getAttribute('aria-labelledby') === selectedTab.id;
+          if (isActive) {
+            panel.removeAttribute('hidden');
+          } else {
+            panel.setAttribute('hidden', 'until-found');
+          }
+        }
+
+        selectedTab.scrollIntoView({
+          block: 'nearest',
+          inline: 'nearest',
+          container: 'nearest'
+        });
+      }
+
+      tablist.addEventListener('click', (event) => {
+        const tab = event.target.closest('button');
+        if (tab && tablist.contains(tab)) {
+          selectTab(tab);
+        }
+      });
+
+      tablist.addEventListener('focusin', (event) => {
+        const tab = event.target.closest('button');
+        if (tab && tablist.contains(tab)) {
+          selectTab(tab);
+        }
+      });
+
+      menuSection.addEventListener('beforematch', (event) => {
+        const matchedPanel = event.target.closest('[role="tabpanel"]');
+        if (!matchedPanel) return;
+        const associatedTab = document.getElementById(matchedPanel.getAttribute('aria-labelledby'));
+        if (associatedTab) {
+          selectTab(associatedTab);
+        }
+      });
+    })();
+  </script>
+
