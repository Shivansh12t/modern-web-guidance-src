+  <script>
+    (function () {
+      const tabsContainer = document.getElementById('menu-tabs-container');
+      const tabList = document.getElementById('menu-tablist');
+      const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
+      const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));
+      const prevBtn = document.getElementById('tab-scroll-prev');
+      const nextBtn = document.getElementById('tab-scroll-next');
+      const allDrinksGrid = document.getElementById('all-drinks-grid');
+
+      // Populate "All Drinks" panel from individual category panels so cards stay in sync
+      if (allDrinksGrid) {
+        const categoryCards = document.querySelectorAll('.tab-panel:not(#panel-all) .card');
+        categoryCards.forEach((card) => {
+          allDrinksGrid.appendChild(card.cloneNode(true));
+        });
+      }
+
+      // Update scroll overflow state and edge fade indicators for narrow viewports
+      function updateScrollIndicators() {
+        const maxScrollLeft = tabList.scrollWidth - tabList.clientWidth;
+        const isOverflowing = maxScrollLeft > 2;
+        const canScrollLeft = tabList.scrollLeft > 4;
+        const canScrollRight = tabList.scrollLeft < maxScrollLeft - 4;
+
+        tabsContainer.classList.toggle('is-overflowing', isOverflowing);
+        tabsContainer.classList.toggle('can-scroll-left', isOverflowing && canScrollLeft);
+        tabsContainer.classList.toggle('can-scroll-right', isOverflowing && canScrollRight);
+
+        if (prevBtn) prevBtn.disabled = !canScrollLeft;
+        if (nextBtn) nextBtn.disabled = !canScrollRight;
+      }
+
+      // Smoothly center the active tab in the scrollable tab bar on narrow screens
+      function scrollTabIntoView(tab) {
+        if (!tab) return;
+        const tabRect = tab.getBoundingClientRect();
+        const listRect = tabList.getBoundingClientRect();
+        const offset = (tabRect.left - listRect.left) - (listRect.width / 2) + (tabRect.width / 2);
+        tabList.scrollBy({ left: offset, behavior: 'smooth' });
+      }
+
+      function activateTab(selectedTab, { focus = false } = {}) {
+        tabs.forEach((tab) => {
+          const isSelected = tab === selectedTab;
+          tab.setAttribute('aria-selected', String(isSelected));
+          tab.setAttribute('tabindex', isSelected ? '0' : '-1');
+        });
+
+        const targetPanelId = selectedTab.getAttribute('aria-controls');
+        panels.forEach((panel) => {
+          const isMatch = panel.id === targetPanelId;
+          panel.classList.toggle('is-active', isMatch);
+          if (isMatch) {
+            panel.removeAttribute('hidden');
+          } else {
+            panel.setAttribute('hidden', '');
+          }
+        });
+
+        if (focus) {
+          selectedTab.focus({ preventScroll: true });
+        }
+
+        scrollTabIntoView(selectedTab);
+      }
+
+      // Click interaction
+      tabs.forEach((tab) => {
+        tab.addEventListener('click', () => {
+          activateTab(tab, { focus: false });
+        });
+
+        // Keyboard accessibility (Left/Right/Home/End)
+        tab.addEventListener('keydown', (event) => {
+          const currentIndex = tabs.indexOf(tab);
+          let nextIndex = null;
+
+          if (event.key === 'ArrowRight') {
+            nextIndex = (currentIndex + 1) % tabs.length;
+          } else if (event.key === 'ArrowLeft') {
+            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
+          } else if (event.key === 'Home') {
+            nextIndex = 0;
+          } else if (event.key === 'End') {
+            nextIndex = tabs.length - 1;
+          }
+
+          if (nextIndex !== null) {
+            event.preventDefault();
+            activateTab(tabs[nextIndex], { focus: true });
+          }
+        });
+      });
+
+      // Scroll buttons for narrow viewports
+      if (prevBtn) {
+        prevBtn.addEventListener('click', () => {
+          tabList.scrollBy({ left: -Math.max(160, tabList.clientWidth * 0.65), behavior: 'smooth' });
+        });
+      }
+
+      if (nextBtn) {
+        nextBtn.addEventListener('click', () => {
+          tabList.scrollBy({ left: Math.max(160, tabList.clientWidth * 0.65), behavior: 'smooth' });
+        });
+      }
+
+      tabList.addEventListener('scroll', updateScrollIndicators, { passive: true });
+      window.addEventListener('resize', updateScrollIndicators);
+
+      // Initial check
+      updateScrollIndicators();
+    })();
