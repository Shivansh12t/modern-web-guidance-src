+  <script type="module">
+    const menuSection = document.getElementById('coffee-menu');
+    const tablist = menuSection.querySelector('[focusgroup~="tablist"]');
+    const tabs = Array.from(tablist.querySelectorAll('button'));
+    const panels = Array.from(menuSection.querySelectorAll('[role="tabpanel"]'));
+
+    function selectTab(selectedTab) {
+      if (!selectedTab || !tabs.includes(selectedTab)) return;
+
+      for (const tab of tabs) {
+        const isSelected = tab === selectedTab;
+        tab.ariaSelected = String(isSelected);
+        tab.toggleAttribute('focusgroupstart', isSelected);
+      }
+
+      for (const panel of panels) {
+        const isMatch = panel.getAttribute('aria-labelledby') === selectedTab.id;
+        if (isMatch) {
+          panel.removeAttribute('hidden');
+        } else {
+          panel.hidden = 'until-found';
+        }
+      }
+
+      selectedTab.scrollIntoView({
+        block: 'nearest',
+        inline: 'nearest',
+        container: 'nearest',
+      });
+    }
+
+    // Selection follows focus & click activation
+    tablist.addEventListener('focusin', (e) => {
+      const tab = e.target.closest('button');
+      if (tab && tablist.contains(tab)) {
+        selectTab(tab);
+      }
+    });
+
+    tablist.addEventListener('click', (e) => {
+      const tab = e.target.closest('button');
+      if (tab && tablist.contains(tab)) {
+        selectTab(tab);
+      }
+    });
+
+    // Synchronize tab & panel states when native Find-in-Page reveals a hidden="until-found" panel
+    menuSection.addEventListener('beforematch', (e) => {
+      const matchedPanel = e.target.closest('[role="tabpanel"]');
+      if (!matchedPanel) return;
+      const associatedTab = document.getElementById(matchedPanel.getAttribute('aria-labelledby'));
+      if (associatedTab) {
+        selectTab(associatedTab);
+      }
+    });
+
+    // IntersectionObserver fallback for scrollability fade hints when scroll-driven animations are unsupported
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      const [first, last] = [tablist.firstElementChild, tablist.lastElementChild];
+      if (first && last) {
+        const observer = new IntersectionObserver((entries) => {
+          for (const { target, intersectionRatio } of entries) {
+            tablist.classList.toggle(
+              target === first ? 'more-start' : 'more-end',
+              intersectionRatio < 1
+            );
+          }
+        }, { root: tablist, threshold: 1, rootMargin: '1px' });
+
+        observer.observe(first);
+        observer.observe(last);
+      }
+    }
+
+    // Load focusgroup polyfill only when native support is missing
+    if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
+      try {
+        const { polyfill } = await import('https://esm.sh/@microsoft/focusgroup-polyfill');
+        polyfill();
+      } catch {
+        // Lightweight fallback if offline/CDN unreachable
+        const syncTabIndex = () => {
+          for (const tab of tabs) {
+            tab.tabIndex = tab.hasAttribute('focusgroupstart') ? 0 : -1;
+          }
+        };
+        syncTabIndex();
+        tablist.addEventListener('focusin', syncTabIndex);
+        tablist.addEventListener('keydown', (e) => {
+          const currentIndex = tabs.indexOf(document.activeElement);
+          if (currentIndex === -1) return;
+          let nextIndex = -1;
+          if (e.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
+          else if (e.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
+          else if (e.key === 'Home') nextIndex = 0;
+          else if (e.key === 'End') nextIndex = tabs.length - 1;
+          if (nextIndex !== -1) {
+            e.preventDefault();
+            tabs[nextIndex].focus();
+          }
+        });
+      }
+    }
+  </script>
