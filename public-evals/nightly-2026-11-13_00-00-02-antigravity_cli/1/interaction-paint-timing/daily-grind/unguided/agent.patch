+        if (metricsStore.all.length === 0) {
+          tbody.innerHTML =
+            '<tr id="perf-empty-row"><td colspan="6" style="text-align: center; color: #8d6e63; padding: 16px;">' +
+            'Waiting for interactions... Click the navigation bar, "Order Now" button, "Seasonal Favorites" cards, or view switcher tabs.' +
+            '</td></tr>';
+          return;
+        }
+
+        var emptyRow = document.getElementById('perf-empty-row');
+        if (emptyRow && emptyRow.parentNode) {
+          emptyRow.parentNode.removeChild(emptyRow);
+        }
+
+        if (latestEntry) {
+          var tr = document.createElement('tr');
+          tr.setAttribute('data-perf-entry-id', String(latestEntry.id));
+          tr.setAttribute('data-perf-category', latestEntry.category);
+          tr.setAttribute('data-paint-duration-ms', latestEntry.duration.toFixed(2));
+
+          var rating = getSpeedRating(latestEntry.duration);
+          tr.innerHTML = [
+            '<td>' + latestEntry.id + '</td>',
+            '<td><strong>' + latestEntry.categoryLabel + '</strong></td>',
+            '<td>' + latestEntry.label + '</td>',
+            '<td><strong>' + latestEntry.duration.toFixed(2) + ' ms</strong></td>',
+            '<td><span class="perf-pill ' + rating + '">' + rating.toUpperCase() + '</span></td>',
+            '<td>' + latestEntry.formattedTime + '</td>'
+          ].join('');
+
+          if (tbody.firstChild) {
+            tbody.insertBefore(tr, tbody.firstChild);
+          } else {
+            tbody.appendChild(tr);
+          }
+        }
+      }
+
+      var CATEGORY_LABELS = {
+        'navbar': 'Navigation Bar',
+        'order-now': 'Order Now Button',
+        'seasonal-favorites': 'Seasonal Favorites',
+        'view-switch': 'Client-Side View Switch'
+      };
+
+      function recordPaintMeasurement(options) {
+        var category = options.category;
+        var label = options.label;
+        var startTime = typeof options.startTime === 'number' ? options.startTime : performance.now();
+        var targetElement = options.targetElement || null;
+        var fromView = options.fromView || null;
+        var toView = options.toView || null;
+
+        metricSeq += 1;
+        var id = metricSeq;
+        var startMark = 'dg-' + category + '-' + id + '-start';
+        var endMark = 'dg-' + category + '-' + id + '-paint-end';
+        var measureName = 'dg-' + category + '-paint-' + id;
+
+        try {
+          performance.mark(startMark, { startTime: startTime });
+        } catch (e) {
+          try { performance.mark(startMark); } catch (err) {}
+        }
+
+        afterNextPaint(function (paintEndTime) {
+          var rawDuration = Math.max(0.01, paintEndTime - startTime);
+          var duration = Number(rawDuration.toFixed(2));
+
+          try {
+            performance.mark(endMark, { startTime: paintEndTime });
+            performance.measure(measureName, startMark, endMark);
+            // Also record a standard category-level measure name for easy querying
+            performance.measure('daily-grind:' + category + ':paint', startMark, endMark);
+          } catch (e) {
+            // Fallback for older User Timing implementations
+          }
+
+          var nowDate = new Date();
+          var formattedTime = nowDate.toLocaleTimeString([], {
+            hour12: false,
+            hour: '2-digit',
+            minute: '2-digit',
+            second: '2-digit'
+          }) + '.' + String(nowDate.getMilliseconds()).padStart(3, '0');
+
+          var entry = {
+            id: id,
+            category: category,
+            categoryLabel: CATEGORY_LABELS[category] || category,
+            label: label,
+            fromView: fromView,
+            toView: toView,
+            startTime: Number(startTime.toFixed(2)),
+            paintEndTime: Number(paintEndTime.toFixed(2)),
+            duration: duration,
+            durationMs: duration,
+            measureName: measureName,
+            timestamp: nowDate.toISOString(),
+            formattedTime: formattedTime
+          };
+
+          metricsStore.all.push(entry);
+          if (!metricsStore.byCategory[category]) {
+            metricsStore.byCategory[category] = [];
+          }
+          metricsStore.byCategory[category].push(entry);
+
+          if (targetElement && targetElement.setAttribute) {
+            targetElement.setAttribute('data-last-paint-ms', duration.toFixed(2));
+            targetElement.setAttribute('data-paint-count', String(
+              Number(targetElement.getAttribute('data-paint-count') || '0') + 1
+            ));
+          }
+
+          saveMetricsToStorage();
+          renderPerfDashboard(entry);
+
+          console.info(
+            '[DailyGrind PerfMonitor] ' + entry.categoryLabel + ' (' + entry.label + ') painted in ' +
+            duration.toFixed(2) + ' ms',
+            entry
+          );
+
+          try {
+            window.dispatchEvent(new CustomEvent('dailygrind:perf-paint', { detail: entry }));
+          } catch (e) {}
+        });
+      }
+
+      // =========================================================================
+      // 3. Client-Side View Switch Execution & Visual Update Logic
+      // =========================================================================
+      function performClientSideViewSwitch(targetViewKey, options) {
+        options = options || {};
+        var interactionStartTime = typeof options.startTime === 'number' ? options.startTime : performance.now();
+        var triggerSource = options.triggerSource || 'direct';
+        var viewConfig = VIEWS[targetViewKey] || VIEWS['home'];
+        var previousView = currentView;
+        currentView = targetViewKey;
+
+        // 1. Update View Stage DOM
+        var stage = document.getElementById('client-view-stage');
+        var stageBadge = document.getElementById('stage-badge');
+        var stageTitle = document.getElementById('stage-title');
+        var stageBody = document.getElementById('stage-body');
+        var currentViewLabel = document.getElementById('current-view-name');
+        var heroTitle = document.getElementById('hero-title');
+        var heroSubtitle = document.getElementById('hero-subtitle');
+
+        if (stage) {
+          stage.setAttribute('data-active-view', targetViewKey);
+          stage.classList.add('view-updated');
+          setTimeout(function () {
+            stage.classList.remove('view-updated');
+          }, 350);
+        }
+        if (stageBadge) stageBadge.textContent = viewConfig.badge;
+        if (stageTitle) stageTitle.textContent = viewConfig.title;
+        if (stageBody) stageBody.innerHTML = viewConfig.html;
+        if (currentViewLabel) {
+          currentViewLabel.textContent = viewConfig.badge + ' (' + targetViewKey + ')';
+          currentViewLabel.setAttribute('data-current-view', targetViewKey);
+        }
+        if (heroTitle && viewConfig.heroTitle) heroTitle.textContent = viewConfig.heroTitle;
+        if (heroSubtitle && viewConfig.heroSubtitle) heroSubtitle.textContent = viewConfig.heroSubtitle;
+
+        // 2. Update active states on Navigation Bar links
+        var navLinks = document.querySelectorAll('nav a[data-view-target]');
+        for (var i = 0; i < navLinks.length; i++) {
+          var link = navLinks[i];
+          if (link.getAttribute('data-view-target') === targetViewKey) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+          }
+        }
+
+        // 3. Update active states on View Switcher Tabs
+        var viewTabs = document.querySelectorAll('.view-tab[data-view-switch]');
+        for (var j = 0; j < viewTabs.length; j++) {
+          var tab = viewTabs[j];
+          if (tab.getAttribute('data-view-switch') === targetViewKey) {
+            tab.classList.add('active');
+          } else {
+            tab.classList.remove('active');
+          }
+        }
+
+        // 4. Update selected states on Seasonal Favorites cards
+        var cards = document.querySelectorAll('#seasonal-grid .card');
+        for (var k = 0; k < cards.length; k++) {
+          var card = cards[k];
+          if (card.getAttribute('data-view-target') === targetViewKey) {
+            card.classList.add('selected-card');
+          } else {
+            card.classList.remove('selected-card');
+          }
+        }
+
+        // 5. Measure client-side view switch paint time
+        recordPaintMeasurement({
+          category: 'view-switch',
+          label: previousView + ' -> ' + targetViewKey + ' (' + triggerSource + ')',
+          fromView: previousView,
+          toView: targetViewKey,
+          startTime: interactionStartTime,
+          targetElement: stage
+        });
+      }
+
+      // =========================================================================
+      // 4. Event Listeners for Navigation Bar, Order Now, Seasonal Cards & Views
+      // =========================================================================
+      document.addEventListener('click', function (event) {
+        var clickStartTime = performance.now();
+        var target = event.target;
+        if (!target || !target.closest) return;
+
+        // A. Check if click occurred in Navigation Bar (<nav>)
+        var navEl = target.closest('nav');
+        if (navEl) {
+          var navLink = target.closest('a') || target.closest('.logo');
+          if (navLink) {
+            event.preventDefault();
+            var navLabel = (navLink.textContent || 'Navigation').trim();
+            var navViewTarget = navLink.getAttribute('data-view-target') || 'home';
+
+            recordPaintMeasurement({
+              category: 'navbar',
+              label: 'Nav: ' + navLabel,
+              startTime: clickStartTime,
+              targetElement: navLink,
+              fromView: currentView,
+              toView: navViewTarget
+            });
+
+            performClientSideViewSwitch(navViewTarget, {
+              startTime: clickStartTime,
+              triggerSource: 'navbar:' + navLabel
+            });
+            return;
+          }
+        }
+
+        // B. Check if click occurred on the "Order Now" button
+        var orderNowBtn = target.closest('#order-now-btn, a[href="/order-online"], .hero .btn');
+        if (orderNowBtn) {
+          event.preventDefault();
+          var orderLabel = (orderNowBtn.textContent || 'Order Now').trim();
+
+          recordPaintMeasurement({
+            category: 'order-now',
+            label: 'Button: ' + orderLabel,
+            startTime: clickStartTime,
+            targetElement: orderNowBtn,
+            fromView: currentView,
+            toView: 'order-online'
+          });
+
+          performClientSideViewSwitch('order-online', {
+            startTime: clickStartTime,
+            triggerSource: 'order-now-btn'
+          });
+          return;
+        }
+
+        // C. Check if click occurred on any "Seasonal Favorites" card or its button
+        var seasonalCard = target.closest('#seasonal-favorites-section .card, .grid .card');
+        if (seasonalCard) {
+          event.preventDefault();
+          var headingEl = seasonalCard.querySelector('h3');
+          var cardTitle = headingEl ? headingEl.textContent.trim() : 'Seasonal Card';
+          var cardViewTarget = seasonalCard.getAttribute('data-view-target') || 'seasonal-maple-oat-latte';
+
+          recordPaintMeasurement({
+            category: 'seasonal-favorites',
+            label: 'Card: ' + cardTitle,
+            startTime: clickStartTime,
+            targetElement: seasonalCard,
+            fromView: currentView,
+            toView: cardViewTarget
+          });
+
+          performClientSideViewSwitch(cardViewTarget, {
+            startTime: clickStartTime,
+            triggerSource: 'seasonal-card:' + cardTitle
+          });
+          return;
+        }
+
+        // D. Check if click occurred on explicit client-side view switch controls or footer links
+        var viewSwitchTrigger = target.closest('[data-view-switch], footer a[data-view-target]');
+        if (viewSwitchTrigger) {
+          event.preventDefault();
+          var targetView =
+            viewSwitchTrigger.getAttribute('data-view-switch') ||
+            viewSwitchTrigger.getAttribute('data-view-target') ||
+            'home';
+          var triggerText = (viewSwitchTrigger.textContent || targetView).trim();
+
+          performClientSideViewSwitch(targetView, {
+            startTime: clickStartTime,
+            triggerSource: 'view-control:' + triggerText
+          });
+          return;
+        }
+      });
+
+      // Handle hashchange / popstate client-side view switches as well
+      window.addEventListener('popstate', function () {
+        var hashView = (window.location.hash || '').replace(/^#\/?/, '');
+        var targetView = VIEWS[hashView] ? hashView : 'home';
+        performClientSideViewSwitch(targetView, {
+          startTime: performance.now(),
+          triggerSource: 'popstate'
+        });
+      });
+
+      window.addEventListener('hashchange', function () {
+        var hashView = (window.location.hash || '').replace(/^#\/?/, '');
+        if (hashView && VIEWS[hashView]) {
+          performClientSideViewSwitch(hashView, {
+            startTime: performance.now(),
+            triggerSource: 'hashchange'
+          });
+        }
+      });
+
+      // Clear Metrics button
+      var clearBtn = document.getElementById('perf-clear-btn');
+      if (clearBtn) {
+        clearBtn.addEventListener('click', function () {
+          window.perfMonitor.clear();
+        });
+      }
+
+      // Observe browser Event Timing API entries if supported
+      if (typeof PerformanceObserver !== 'undefined') {
+        try {
+          var eventObserver = new PerformanceObserver(function (list) {
+            var entries = list.getEntries();
+            for (var i = 0; i < entries.length; i++) {
+              var ev = entries[i];
+              if (ev.name === 'click' && window.perfMonitor) {
+                window.perfMonitor.browserEventTimings.push({
+                  name: ev.name,
+                  startTime: ev.startTime,
+                  processingStart: ev.processingStart,
+                  processingEnd: ev.processingEnd,
+                  duration: ev.duration
+                });
+              }
+            }
+          });
+          eventObserver.observe({ type: 'event', durationThreshold: 0, buffered: true });
+        } catch (err) {
+          // Browser may not support Event Timing with durationThreshold: 0
+        }
+      }
+
+      // =========================================================================
+      // 5. Public Global API for Programmatic Inspection & Testing
+      // =========================================================================
+      var publicApi = {
+        metrics: metricsStore.all,
+        byCategory: metricsStore.byCategory,
+        browserEventTimings: [],
+        getCurrentView: function () {
+          return currentView;
+        },
+        getMetrics: function (category) {
+          if (category) {
+            return (metricsStore.byCategory[category] || []).slice();
+          }
+          return metricsStore.all.slice();
+        },
+        getSummary: function () {
+          return {
+            navbar: computeCategoryStats('navbar'),
+            orderNow: computeCategoryStats('order-now'),
+            seasonalFavorites: computeCategoryStats('seasonal-favorites'),
+            viewSwitch: computeCategoryStats('view-switch'),
+            totalCount: metricsStore.all.length
+          };
+        },
+        switchView: function (viewName) {
+          performClientSideViewSwitch(viewName, {
+            startTime: performance.now(),
+            triggerSource: 'api:switchView'
+          });
+        },
+        measurePaint: function (category, label, startTime) {
+          recordPaintMeasurement({
+            category: category || 'view-switch',
+            label: label || 'Custom Paint Measurement',
+            startTime: typeof startTime === 'number' ? startTime : performance.now()
+          });
+        },
+        clear: function () {
+          metricsStore.all.length = 0;
+          Object.keys(metricsStore.byCategory).forEach(function (k) {
+            metricsStore.byCategory[k].length = 0;
+          });
+          try {
+            sessionStorage.removeItem(STORAGE_KEY);
+            performance.clearMarks();
+            performance.clearMeasures();
+          } catch (e) {}
+          renderPerfDashboard(null);
+        }
+      };
+
+      window.perfMonitor = publicApi;
+      window.performanceMonitor = publicApi;
+      window.__PERF_MONITOR__ = publicApi;
+
+      // Render any restored metrics on initial load
+      if (metricsStore.all.length > 0) {
+        var tbody = document.getElementById('perf-log-tbody');
+        if (tbody) tbody.innerHTML = '';
+        for (var m = 0; m < metricsStore.all.length; m++) {
+          renderPerfDashboard(metricsStore.all[m]);
+        }
+      } else {
+        renderPerfDashboard(null);
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
