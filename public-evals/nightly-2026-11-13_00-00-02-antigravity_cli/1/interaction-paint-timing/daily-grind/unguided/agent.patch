+        }
+      }
+
+      function computeCategoryStats(category) {
+        var list = metricsStore.byCategory[category] || [];
+        var count = list.length;
+        if (count === 0) {
+          return { count: 0, lastDuration: null, avgDuration: null, minDuration: null, maxDuration: null };
+        }
+        var sum = 0;
+        var min = Infinity;
+        var max = -Infinity;
+        for (var i = 0; i < count; i++) {
+          var d = list[i].duration;
+          sum += d;
+          if (d < min) min = d;
+          if (d > max) max = d;
+        }
+        var last = list[count - 1].duration;
+        var avg = Number((sum / count).toFixed(2));
+        return {
+          count: count,
+          lastDuration: last,
+          avgDuration: avg,
+          minDuration: Number(min.toFixed(2)),
+          maxDuration: Number(max.toFixed(2))
+        };
+      }
