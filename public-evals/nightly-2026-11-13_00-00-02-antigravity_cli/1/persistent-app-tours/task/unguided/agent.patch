+  <script>
+    (function () {
+      const featureLink = document.getElementById('feature');
+      const tourStep = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('close-tour-btn');
+
+      let isTourActive = true;
+
+      // Open popover by default if supported
+      if (typeof tourStep.showPopover === 'function') {
+        try {
+          tourStep.showPopover({ source: featureLink });
+        } catch (err) {
+          try {
+            tourStep.showPopover();
+          } catch (e) {}
+        }
+      }
+
+      const supportsAnchorPositioning =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('anchor-name: --feature') &&
+        CSS.supports('top: anchor(bottom)');
+
+      function updateTourPosition() {
+        if (!isTourActive || !featureLink || !tourStep) return;
+        if (supportsAnchorPositioning) return;
+
+        const rect = featureLink.getBoundingClientRect();
+        const stepRect = tourStep.getBoundingClientRect();
+        const stepWidth = stepRect.width || 260;
+
+        let left = rect.left + rect.width / 2 - stepWidth / 2;
+        const maxLeft = window.innerWidth - stepWidth - 12;
+        left = Math.max(12, Math.min(left, maxLeft));
+
+        const top = rect.bottom + 12;
+        tourStep.style.top = `${top}px`;
+        tourStep.style.left = `${left}px`;
+        tourStep.style.translate = 'none';
+      }
+
+      updateTourPosition();
+      window.addEventListener('resize', updateTourPosition, { passive: true });
+      window.addEventListener('scroll', updateTourPosition, { passive: true, capture: true });
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(updateTourPosition);
+        ro.observe(document.documentElement);
+        ro.observe(featureLink);
+      }
+
+      // Prevent navigation when clicking the rewards link during the tour
+      featureLink.addEventListener('click', function (e) {
+        const isOpen =
+          isTourActive &&
+          (tourStep.matches(':popover-open') || tourStep.hasAttribute('open'));
+        if (isOpen) {
+          e.preventDefault();
+        }
+      });
+
+      function closeTour() {
+        isTourActive = false;
+        tourStep.removeAttribute('open');
+        if (typeof tourStep.hidePopover === 'function') {
+          try {
+            tourStep.hidePopover();
+          } catch (e) {}
+        }
+        tourStep.style.display = 'none';
+      }
+
+      closeBtn.addEventListener('click', closeTour);
+      tourStep.addEventListener('toggle', function (e) {
+        if (e.newState === 'closed') {
+          isTourActive = false;
+          tourStep.removeAttribute('open');
+          tourStep.style.display = 'none';
+        }
+      });
+    })();
+  </script>
 </body>
 
