+  <script>
+    const progress = document.getElementById('loyalty-progress');
+    const ringCount = document.getElementById('ring-count');
+    const ringSubtext = document.getElementById('ring-subtext');
+    const statusText = document.getElementById('loyalty-status-text');
+    const addStampBtn = document.getElementById('add-stamp-btn');
+
+    if (!CSS.supports('width: attr(value type(<number>))')) {
+      progress.style.setProperty('--value', progress.getAttribute('value'));
+      const observer = new MutationObserver(() => {
+        progress.style.setProperty('--value', progress.getAttribute('value'));
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ['value'],
+      });
+    }
+
+    const totalDrinks = 10;
+    let currentDrinks = 8;
+
+    addStampBtn.addEventListener('click', () => {
+      currentDrinks = currentDrinks < totalDrinks ? currentDrinks + 1 : 1;
+      const percent = Math.round((currentDrinks / totalDrinks) * 100);
+      const remaining = totalDrinks - currentDrinks;
+
+      progress.setAttribute('value', String(percent));
+      ringCount.textContent = `${currentDrinks} / ${totalDrinks}`;
+
+      if (remaining === 0) {
+        const valueText = `${currentDrinks} of ${totalDrinks} drinks (${percent}%) — Free drink unlocked!`;
+        progress.setAttribute('aria-valuetext', valueText);
+        ringSubtext.textContent = 'Free Drink!';
+        statusText.innerHTML = '<strong>Congratulations!</strong> You have reached <strong>10 of 10</strong> bean stamps. Your next handcrafted drink is on the house!';
+        addStampBtn.textContent = 'Start New Card (1 / 10)';
+      } else {
+        const drinkWord = remaining === 1 ? 'drink' : 'drinks';
+        const valueText = `${currentDrinks} of ${totalDrinks} drinks (${percent}%) — ${remaining} ${drinkWord} away`;
+        progress.setAttribute('aria-valuetext', valueText);
+        ringSubtext.textContent = `${remaining} to go (${percent}%)`;
+        statusText.innerHTML = `You've collected <strong>${currentDrinks} of ${totalDrinks}</strong> bean stamps! Grab <strong>${remaining} more ${drinkWord}</strong> to unlock a complimentary artisanal coffee or seasonal specialty of your choice.`;
+        addStampBtn.textContent = 'Log a Drink (+1 Stamp)';
+      }
+    });
+  </script>
