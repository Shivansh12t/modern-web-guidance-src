+          });
+
+          if (verifyResponse.ok) {
+            try {
+              const verifyData = await verifyResponse.json();
+              verificationSucceeded =
+                verifyData === null ||
+                typeof verifyData !== 'object' ||
+                (verifyData.verified !== false &&
+                  verifyData.success !== false &&
+                  verifyData.ok !== false &&
+                  verifyData.status !== 'error' &&
+                  verifyData.status !== 'failed');
+            } catch (_) {
+              verificationSucceeded = true;
+            }
+          }
+        } catch (_) {
+          verificationSucceeded = false;
+        }
+
+        // 5. Clean up orphaned credentials if server verification fails
+        if (!verificationSucceeded && createdCredentialId) {
+          await cleanupOrphanedCredential(rpId, createdCredentialId);
+        }
+      } catch (_) {
+        // Do not show any dialog or error UI when background passkey registration fails
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    const signinStatus = document.getElementById('signin-status');
+
+    if (signinForm) {
+      signinForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const usernameInput = document.getElementById('username');
+        const username = usernameInput ? usernameInput.value.trim() : '';
+
+        if (signinStatus) {
+          signinStatus.textContent = 'Signed in successfully.';
+        }
+
+        await silentlyRegisterPasskey(username);
+      });
+    }
+  </script>
