+    async function cleanupOrphanedCredential(rpId, credentialId) {
+      try {
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: rpId || window.location.hostname,
+            credentialId,
+          });
+        }
+      } catch (_) {
+        // Silently ignore signal errors in the background
+      }
+    }
+
+    async function silentlyRegisterPasskey(username) {
+      let rpId = window.location.hostname;
+      let createdCredentialId = null;
+
+      try {
+        // 1. Check browser capabilities before silent registration
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || !capabilities.conditionalCreate) {
+          return;
+        }
+
+        // 2. Fetch creation options from POST /api/register/options
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username }),
+        });
+
+        if (!optionsResponse.ok) {
+          return;
+        }
+
+        const rawOptions = await optionsResponse.json();
+        const optionsSource = rawOptions && rawOptions.publicKey ? rawOptions.publicKey : rawOptions;
+        if (optionsSource && optionsSource.rp && optionsSource.rp.id) {
+          rpId = optionsSource.rp.id;
+        }
+
+        const publicKey = parseCreationOptions(rawOptions);
+
+        // 3. Silently create passkey in background using conditional mediation
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+
+        if (!credential) {
+          return;
+        }
