+  <script>
+    const brewStrengths = [
+      {
+        name: 'Mild',
+        description: 'Light, delicate roast with bright citrus and floral notes.'
+      },
+      {
+        name: 'Medium',
+        description: 'Balanced body with toasted caramel and smooth cocoa notes.'
+      },
+      {
+        name: 'Bold',
+        description: 'Rich, full-bodied dark roast with deep bittersweet chocolate notes.'
+      },
+      {
+        name: 'Extra Bold',
+        description: 'Intense espresso-grade roast with smoky, velvety depth and maximum kick.'
+      }
+    ];
+
+    const slider = document.querySelector('#brew-strength');
+    const strengthValue = document.querySelector('#brew-strength-value');
+    const strengthDesc = document.querySelector('#brew-strength-desc');
+    const stepLabels = document.querySelectorAll('.brew-strength-step');
+
+    function syncSliderValue() {
+      const index = Number(slider.value);
+      const current = brewStrengths[index] || brewStrengths[1];
+
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 100);
+      slider.style.setProperty('--control-value', slider.value);
+      slider.setAttribute('aria-valuetext', current.name);
+
+      strengthValue.textContent = current.name;
+      strengthDesc.textContent = current.description;
+
+      stepLabels.forEach((stepEl, i) => {
+        if (i === index) {
+          stepEl.setAttribute('data-active', 'true');
+        } else {
+          stepEl.removeAttribute('data-active');
+        }
+      });
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
+
 </body>
 
