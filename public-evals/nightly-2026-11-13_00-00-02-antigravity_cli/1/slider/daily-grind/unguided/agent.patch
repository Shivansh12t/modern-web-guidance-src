+  <script>
+    (function () {
+      const STRENGTHS = [
+        {
+          name: 'Mild',
+          title: 'Mild — Golden Morning Light',
+          desc: 'Delicate, tea-like clarity with floral jasmine aromas, honeyed sweetness, and bright stone-fruit notes.',
+          tags: ['Floral Honey', 'Peach Nectar', 'Light Body'],
+          ratio: '1:18',
+          caffeine: '~95 mg',
+          roast: 'Light Blonde',
+          method: 'Chemex & Pour Over'
+        },
+        {
+          name: 'Medium',
+          title: 'Medium — Balanced House Blend',
+          desc: 'Smooth and rounded body with notes of toasted almond, milk chocolate, and a clean citrus finish.',
+          tags: ['Toasted Almond', 'Milk Chocolate', 'Balanced Acidity'],
+          ratio: '1:16',
+          caffeine: '~140 mg',
+          roast: 'City Medium',
+          method: 'Drip & Pour Over'
+        },
+        {
+          name: 'Bold',
+          title: 'Bold — Velvet Roaster Reserve',
+          desc: 'Full-bodied and rich with caramelized brown sugar, roasted hazelnut, and bittersweet dark cocoa.',
+          tags: ['Dark Cocoa', 'Caramelized Sugar', 'Full Body'],
+          ratio: '1:14',
+          caffeine: '~185 mg',
+          roast: 'Full City Dark',
+          method: 'French Press & AeroPress'
+        },
+        {
+          name: 'Extra Bold',
+          title: 'Extra Bold — Midnight Espresso Roast',
+          desc: 'Intense, syrupy crema and deep smoky molasses notes crafted for maximum kick and zero bitterness.',
+          tags: ['Smoky Molasses', '85% Cacao', 'Velvety Crema'],
+          ratio: '1:12',
+          caffeine: '~230 mg',
+          roast: 'French / Espresso',
+          method: 'Espresso & Moka Pot'
+        }
+      ];
+
+      const slider = document.getElementById('brew-strength-slider');
+      const container = document.getElementById('brew-slider-container');
+      const fillBar = document.getElementById('brew-slider-fill');
+      const valueText = document.getElementById('brew-strength-value');
+      const stepButtons = document.querySelectorAll('.brew-step-btn');
+      const ticks = document.querySelectorAll('.slider-tick');
+      const beanDots = document.querySelectorAll('.bean-dot');
+
+      const profileTitle = document.getElementById('brew-profile-title');
+      const profileDesc = document.getElementById('brew-profile-desc');
+      const profileTags = document.getElementById('brew-profile-tags');
+      const metricRatio = document.getElementById('brew-metric-ratio');
+      const metricCaffeine = document.getElementById('brew-metric-caffeine');
+      const metricRoast = document.getElementById('brew-metric-roast');
+      const metricMethod = document.getElementById('brew-metric-method');
+
+      function updateBrewStrength(index) {
+        const clampedIndex = Math.max(0, Math.min(STRENGTHS.length - 1, Number(index) || 0));
+        const strength = STRENGTHS[clampedIndex];
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 3;
+        const percent = ((clampedIndex - min) / (max - min)) * 100;
+        const percentStr = percent.toFixed(4) + '%';
+
+        slider.value = String(clampedIndex);
+        slider.setAttribute('aria-valuenow', String(clampedIndex));
+        slider.setAttribute('aria-valuetext', strength.name);
+        slider.style.setProperty('--fill-percent', percentStr);
+
+        if (container) {
+          container.style.setProperty('--fill-percent', percentStr);
+        }
+        if (fillBar) {
+          fillBar.style.width = percentStr;
+        }
+        if (valueText) {
+          valueText.textContent = strength.name;
+        }
+
+        stepButtons.forEach((btn, idx) => {
+          btn.classList.toggle('active', idx === clampedIndex);
+          btn.setAttribute('aria-pressed', idx === clampedIndex ? 'true' : 'false');
+        });
+
+        ticks.forEach((tick, idx) => {
+          tick.classList.toggle('filled', idx <= clampedIndex);
+        });
+
+        beanDots.forEach((dot, idx) => {
+          dot.classList.toggle('active', idx <= clampedIndex);
+        });
+
+        if (profileTitle) profileTitle.textContent = strength.title;
+        if (profileDesc) profileDesc.textContent = strength.desc;
+        if (profileTags) {
+          profileTags.innerHTML = strength.tags
+            .map((tag) => `<span class="brew-tag">${tag}</span>`)
+            .join('');
+        }
+        if (metricRatio) metricRatio.textContent = strength.ratio;
+        if (metricCaffeine) metricCaffeine.textContent = strength.caffeine;
+        if (metricRoast) metricRoast.textContent = strength.roast;
+        if (metricMethod) metricMethod.textContent = strength.method;
+      }
+
+      if (slider) {
+        slider.addEventListener('input', (e) => {
+          updateBrewStrength(e.target.value);
+        });
+        slider.addEventListener('change', (e) => {
+          updateBrewStrength(e.target.value);
+        });
+      }
+
+      stepButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const step = Number(btn.getAttribute('data-step'));
+          updateBrewStrength(step);
+        });
+      });
+
+      updateBrewStrength(slider ? slider.value : 1);
+    })();
+  </script>
