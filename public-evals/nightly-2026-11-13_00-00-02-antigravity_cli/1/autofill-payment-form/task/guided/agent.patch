+  <script>
+    (() => {
+      const form = document.getElementById('payment-form');
+      const submitBtn = document.getElementById('payment-submit-btn');
+      const statusBox = document.getElementById('payment-status');
+
+      const errorMessages = {
+        'cc-number': 'Please enter a valid 13 to 19 digit card number (spaces allowed).',
+        'cc-name': 'Please enter the cardholder name as shown on your card.',
+        'cc-exp': 'Please enter a valid expiry date in MM/YY format.',
+        'cc-csc': 'Please enter the 3 or 4 digit security code.'
+      };
+
+      const editedFields = new Set();
+
+      const updateFieldValidity = (input) => {
+        const errorEl = document.getElementById(`${input.id}-error`);
+        input.setCustomValidity('');
+
+        if (!input.checkValidity()) {
+          const message = errorMessages[input.id] || input.validationMessage;
+          input.setCustomValidity(message);
+          input.setAttribute('aria-invalid', 'true');
+          if (errorEl) errorEl.textContent = message;
+          return false;
+        }
+
+        input.removeAttribute('aria-invalid');
+        if (errorEl) errorEl.textContent = '';
+        return true;
+      };
+
+      form.querySelectorAll('input').forEach((input) => {
+        input.addEventListener('input', () => {
+          editedFields.add(input.id);
+          input.setCustomValidity('');
+          if (input.checkValidity()) {
+            input.removeAttribute('aria-invalid');
+            const errorEl = document.getElementById(`${input.id}-error`);
+            if (errorEl) errorEl.textContent = '';
+          }
+        });
+
+        input.addEventListener('blur', () => {
+          if (editedFields.has(input.id) || input.value.trim() !== '') {
+            updateFieldValidity(input);
+          }
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        statusBox.textContent = '';
+        statusBox.className = 'payment-status';
+
+        let firstInvalid = null;
+        form.querySelectorAll('input').forEach((input) => {
+          const valid = updateFieldValidity(input);
+          if (!valid && !firstInvalid) {
+            firstInvalid = input;
+          }
+        });
+
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Payment Submitted';
+        statusBox.textContent = 'Your payment details have been verified and submitted.';
+        statusBox.classList.add('success');
+      });
+    })();
+  </script>
+
