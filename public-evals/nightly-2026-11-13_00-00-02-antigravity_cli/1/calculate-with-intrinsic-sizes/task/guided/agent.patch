     .btn:hover {
       background: #3e2723;
     }
 
+    /* Promo Badge */
+    .promo-badge {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 0.8rem;
+      padding-block: 4px;
+      padding-inline: 8px;
+      border-radius: 4px;
+      margin-block-end: 10px;
+      /* Fallback for browsers that do not support calc-size() */
+      inline-size: max-content;
+      /* Set inline-size to 1.2x max-content, clamped between 100px and 100% of parent width */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    /* Sourcing FAQ / Accordion Section */
+    .sourcing-section {
+      margin-block-start: 40px;
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .sourcing-section h2 {
+      color: var(--primary);
+      margin-block-end: 12px;
+      text-align: center;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding-block: 12px;
+      padding-inline: 20px;
+      font-size: 1rem;
+      font-weight: 600;
+      border-radius: 5px;
+      cursor: pointer;
+      text-align: start;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    /*
+     * Note: Directly transitioning or interpolating between two different intrinsic keyword sizes
+     * (e.g., from min-content to max-content) is not supported. One end of the transition must be
+     * a fixed length or percentage (such as 0 to auto).
+     */
+    .accordion-content {
+      display: block;
+      overflow: hidden;
+      /* Fallback and initial closed state */
+      block-size: 0;
+      opacity: 0;
+      visibility: hidden;
+      transition: block-size 0.3s ease-out, opacity 0.3s ease-out, visibility 0.3s;
+    }
+
+    .accordion-content.open,
+    .accordion-content.is-expanded {
+      /* Fallback value for open state */
+      block-size: auto;
+      /* Smoothly animate from 0 to natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      opacity: 1;
+      visibility: visible;
+    }
+
+    .accordion-inner {
+      padding-block-start: 1rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        transition: opacity 0.2s ease, visibility 0.2s;
+      }
+
+      .accordion-content.open,
+      .accordion-content.is-expanded {
+        block-size: auto;
+      }
+    }
+
