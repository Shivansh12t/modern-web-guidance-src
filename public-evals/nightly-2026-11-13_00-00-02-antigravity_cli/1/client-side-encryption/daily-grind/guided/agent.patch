diff --git a/delivery-encryption.js b/delivery-encryption.js
new file mode 100644
index 0000000..eb2bd94
--- /dev/null
+++ b/delivery-encryption.js
@@ -0,0 +1,434 @@
+const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+const DB_NAME = 'daily-grind-crypto-store';
+const STORE_NAME = 'courier-keys';
+const KEY_RECORD_ID = 'recipient-kem-key';
+const ENVELOPE_CONTEXT = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+export function toBase64(bytes) {
+  const uint8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof uint8.toBase64 === 'function') {
+    return uint8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < uint8.byteLength; i++) {
+    binary += String.fromCharCode(uint8[i]);
+  }
+  return btoa(binary);
+}
+
+export function supportsPostQuantumEnvelope() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+  );
+}
+
+export async function generateRecipientKeys() {
+  if (supportsPostQuantumEnvelope()) {
+    const keyPair = await crypto.subtle.generateKey(
+      'MLKEM768-X25519',
+      false,
+      ['encapsulateKey', 'decapsulateKey'],
+    );
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return { suite: 'MLKEM768-X25519+ChaCha20-Poly1305', keyPair, publicKeyBytes };
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  return { suite: 'X25519+HKDF+AES-GCM', keyPair, publicKeyBytes };
+}
+
+async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = new Uint8Array(0)) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  infoBytes = new Uint8Array(0),
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await (() => {
+          const bytes =
+            recipientPublicKeyOrBytes instanceof Uint8Array
+              ? recipientPublicKeyOrBytes
+              : new Uint8Array(recipientPublicKeyOrBytes);
+          const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+          return kemName
+            ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+            : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+        })();
+
+  if (pubKey.algorithm.name !== 'X25519') {
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      pubKey.algorithm.name,
+      pubKey,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return { sharedKey, capsuleBytes };
+}
+
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  infoBytes = new Uint8Array(0),
+) {
+  if (recipientPrivateKey.algorithm.name !== 'X25519') {
+    return crypto.subtle.decapsulateKey(
+      recipientPrivateKey.algorithm.name,
+      recipientPrivateKey,
+      capsuleBytes,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+
+  const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, 'X25519', true, []);
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * @param {CryptoKey} key
+ * @param {string} plaintext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = new TextEncoder().encode(plaintext);
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded,
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload. Throws OperationError if tampered.
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext,
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+function openKeyStore() {
+  return new Promise((resolve, reject) => {
+    if (typeof indexedDB === 'undefined') {
+      reject(new Error('IndexedDB unavailable'));
+      return;
+    }
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () => {
+      const db = request.result;
+      if (!db.objectStoreNames.contains(STORE_NAME)) {
+        db.createObjectStore(STORE_NAME);
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+async function loadOrCreateRecipientKeys(forceRotate = false) {
+  const expectedSuite = supportsPostQuantumEnvelope()
+    ? 'MLKEM768-X25519+ChaCha20-Poly1305'
+    : 'X25519+HKDF+AES-GCM';
+
+  if (!forceRotate) {
+    try {
+      const db = await openKeyStore();
+      const stored = await new Promise((resolve, reject) => {
+        const tx = db.transaction(STORE_NAME, 'readonly');
+        const store = tx.objectStore(STORE_NAME);
+        const req = store.get(KEY_RECORD_ID);
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+      db.close();
+
+      if (stored && stored.keyPair && stored.suite === expectedSuite) {
+        const format = stored.keyPair.publicKey.algorithm.name === 'X25519' ? 'raw' : 'raw-public';
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey(format, stored.keyPair.publicKey),
+        );
+        return { suite: stored.suite, keyPair: stored.keyPair, publicKeyBytes };
+      }
+    } catch {
+      // Fall through to generate a fresh key pair if IndexedDB is restricted
+    }
+  }
+
+  const generated = await generateRecipientKeys();
+  try {
+    const db = await openKeyStore();
+    await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE_NAME, 'readwrite');
+      const store = tx.objectStore(STORE_NAME);
+      store.put({ suite: generated.suite, keyPair: generated.keyPair }, KEY_RECORD_ID);
+      tx.oncomplete = () => resolve();
+      tx.onerror = () => reject(tx.error);
+    });
+    db.close();
+  } catch {
+    // Key remains usable in memory for the current session
+  }
+
+  return generated;
+}
+
+function initDeliveryNotesUI() {
+  const form = document.getElementById('delivery-notes-form');
+  if (!form) return;
+
+  const orderInput = document.getElementById('order-reference');
+  const noteInput = document.getElementById('delivery-note');
+  const orderError = document.getElementById('order-reference-error');
+  const noteError = document.getElementById('delivery-note-error');
+  const submitBtn = document.getElementById('encrypt-submit-btn');
+  const rotateBtn = document.getElementById('rotate-keys-btn');
+  const verifyBtn = document.getElementById('verify-decrypt-btn');
+
+  const suiteBadge = document.getElementById('crypto-suite-badge');
+  const suiteOutput = document.getElementById('envelope-suite');
+  const pubKeyOutput = document.getElementById('recipient-public-key');
+  const capsuleOutput = document.getElementById('envelope-capsule');
+  const ivOutput = document.getElementById('envelope-iv');
+  const ciphertextOutput = document.getElementById('envelope-ciphertext');
+  const decryptedOutput = document.getElementById('decrypted-preview');
+  const statusBanner = document.getElementById('encryption-status');
+
+  let activeRecipient = null;
+  let latestEnvelope = null;
+
+  function setStatus(message, state = 'info') {
+    statusBanner.textContent = message;
+    statusBanner.dataset.state = state;
+  }
+
+  function validateField(input, errorEl, labelText) {
+    input.setCustomValidity('');
+    if (!input.validity.valid) {
+      let msg = `Please enter a valid ${labelText}.`;
+      if (input.validity.valueMissing) {
+        msg = `${labelText} is required.`;
+      } else if (input.validity.tooShort) {
+        msg = `${labelText} must be at least ${input.minLength} characters.`;
+      }
+      input.setCustomValidity(msg);
+      input.setAttribute('aria-invalid', 'true');
+      errorEl.textContent = msg;
+      errorEl.hidden = false;
+      return false;
+    }
+    input.removeAttribute('aria-invalid');
+    errorEl.textContent = '';
+    errorEl.hidden = true;
+    return true;
+  }
+
+  function clearFieldError(input, errorEl) {
+    input.setCustomValidity('');
+    if (input.validity.valid) {
+      input.removeAttribute('aria-invalid');
+      errorEl.textContent = '';
+      errorEl.hidden = true;
+    }
+  }
+
+  orderInput.addEventListener('blur', () => {
+    if (orderInput.value !== '') {
+      validateField(orderInput, orderError, 'Order Reference');
+    }
+  });
+  orderInput.addEventListener('input', () => clearFieldError(orderInput, orderError));
+
+  noteInput.addEventListener('blur', () => {
+    if (noteInput.value !== '') {
+      validateField(noteInput, noteError, 'Delivery instructions');
+    }
+  });
+  noteInput.addEventListener('input', () => clearFieldError(noteInput, noteError));
+
+  async function encryptCurrentNote() {
+    if (!activeRecipient) {
+      activeRecipient = await loadOrCreateRecipientKeys(false);
+    }
+
+    const orderRef = orderInput.value.trim();
+    const plaintextNote = noteInput.value.trim();
+    const aadBytes = new TextEncoder().encode(`order:${orderRef}`);
+
+    const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+      activeRecipient.publicKeyBytes,
+      ENVELOPE_CONTEXT,
+    );
+    const { iv, ciphertext } = await encryptMessage(sharedKey, plaintextNote, aadBytes);
+
+    latestEnvelope = {
+      suite: activeRecipient.suite,
+      capsuleBytes,
+      iv,
+      ciphertext,
+      aadBytes,
+      orderRef,
+    };
+
+    suiteOutput.textContent = `${activeRecipient.suite} (AAD: order:${orderRef})`;
+    pubKeyOutput.textContent = `${toBase64(activeRecipient.publicKeyBytes)} (${activeRecipient.publicKeyBytes.byteLength} bytes)`;
+    capsuleOutput.textContent = `${toBase64(capsuleBytes)} (${capsuleBytes.byteLength} bytes)`;
+    ivOutput.textContent = `${toBase64(iv)} (${iv.byteLength} bytes)`;
+    ciphertextOutput.textContent = `${toBase64(ciphertext)} (${ciphertext.byteLength} bytes)`;
+
+    const verifiedPlaintext = await decapsulateAndDecrypt(latestEnvelope);
+    decryptedOutput.textContent = verifiedPlaintext;
+    setStatus(
+      `Encrypted delivery note for ${orderRef} with ${activeRecipient.suite} and verified integrity.`,
+      'success',
+    );
+  }
+
+  async function decapsulateAndDecrypt(envelope) {
+    const recipientSharedKey = await decapsulateEnvelopeKey(
+      activeRecipient.keyPair.privateKey,
+      envelope.capsuleBytes,
+      ENVELOPE_CONTEXT,
+    );
+    return decryptMessage(
+      recipientSharedKey,
+      envelope.iv,
+      envelope.ciphertext,
+      envelope.aadBytes,
+    );
+  }
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+
+    const orderValid = validateField(orderInput, orderError, 'Order Reference');
+    const noteValid = validateField(noteInput, noteError, 'Delivery instructions');
+
+    if (!orderValid) {
+      orderInput.focus();
+      return;
+    }
+    if (!noteValid) {
+      noteInput.focus();
+      return;
+    }
+
+    submitBtn.disabled = true;
+    try {
+      await encryptCurrentNote();
+    } catch (err) {
+      setStatus(`Encryption failed: ${err.message || String(err)}`, 'error');
+    } finally {
+      submitBtn.disabled = false;
+    }
+  });
+
+  rotateBtn.addEventListener('click', async () => {
+    rotateBtn.disabled = true;
+    try {
+      activeRecipient = await loadOrCreateRecipientKeys(true);
+      suiteBadge.textContent = `Active Crypto Suite: ${activeRecipient.suite}`;
+      await encryptCurrentNote();
+      setStatus('Rotated courier key pair and re-encapsulated delivery note.', 'success');
+    } catch (err) {
+      setStatus(`Key rotation failed: ${err.message || String(err)}`, 'error');
+    } finally {
+      rotateBtn.disabled = false;
+    }
+  });
+
+  verifyBtn.addEventListener('click', async () => {
+    if (!latestEnvelope || !activeRecipient) {
+      setStatus('Encrypt a delivery note first before verifying decapsulation.', 'error');
+      return;
+    }
+    try {
+      const recovered = await decapsulateAndDecrypt(latestEnvelope);
+      decryptedOutput.textContent = recovered;
+      setStatus(
+        `Decapsulated capsule (${latestEnvelope.capsuleBytes.byteLength} bytes) and authenticated note for ${latestEnvelope.orderRef}.`,
+        'success',
+      );
+    } catch (err) {
+      setStatus(`Authentication or decapsulation failed: ${err.message || String(err)}`, 'error');
+    }
+  });
+
+  (async () => {
+    try {
+      activeRecipient = await loadOrCreateRecipientKeys(false);
+      suiteBadge.textContent = `Active Crypto Suite: ${activeRecipient.suite}`;
+      await encryptCurrentNote();
+    } catch (err) {
+      suiteBadge.textContent = 'WebCrypto initialization error';
+      setStatus(`Could not initialize WebCrypto keys: ${err.message || String(err)}`, 'error');
+    }
+  })();
+}
+
+if (typeof document !== 'undefined') {
+  initDeliveryNotesUI();
+}
