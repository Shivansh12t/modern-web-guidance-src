+  <script>
+    const rewardProgress = document.getElementById('reward-progress');
+    const rewardStatus = document.getElementById('reward-status');
+    const addBeansBtn = document.getElementById('add-beans-btn');
+    const syncRewardsBtn = document.getElementById('sync-rewards-btn');
+    const resetRewardsBtn = document.getElementById('reset-rewards-btn');
+
+    const updateDeterminateProgress = (nextValue) => {
+      const clamped = Math.min(100, Math.max(0, nextValue));
+      rewardProgress.value = clamped;
+      if (clamped >= 100) {
+        rewardStatus.textContent = '100 / 100 Beans — Free handcrafted drink reward unlocked!';
+      } else {
+        rewardStatus.textContent = `${clamped} / 100 Beans toward your next free drink`;
+      }
+    };
+
+    addBeansBtn.addEventListener('click', () => {
+      const current = rewardProgress.hasAttribute('value') ? Number(rewardProgress.value) : 75;
+      updateDeterminateProgress(current + 25);
+    });
+
+    syncRewardsBtn.addEventListener('click', () => {
+      rewardProgress.removeAttribute('value');
+      rewardStatus.textContent = 'Syncing reward balance with roastery…';
+    });
+
+    resetRewardsBtn.addEventListener('click', () => {
+      updateDeterminateProgress(25);
+    });
+  </script>
