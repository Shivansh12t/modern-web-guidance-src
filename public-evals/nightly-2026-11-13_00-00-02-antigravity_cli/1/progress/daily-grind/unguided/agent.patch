+  <script>
+    (function () {
+      const progressBar = document.getElementById('order-progress-bar');
+      const progressFill = document.getElementById('order-progress-fill');
+      const nativeProgress = document.getElementById('native-order-progress');
+      const statusText = document.getElementById('progress-status-text');
+      const badge = document.getElementById('progress-badge');
+      const steps = document.querySelectorAll('.progress-step');
+      const buttons = document.querySelectorAll('.progress-ctrl-btn');
+
+      const stageDescriptions = {
+        25: 'Order queued at the roastery bar — 25% complete (25 / 100 Bonus Beans toward your next free drink)',
+        50: 'Grinding fresh beans & pulling espresso shots — 50% complete (50 / 100 Bonus Beans toward your next free drink)',
+        75: 'Handcrafting your Maple Oat Latte — 75% complete (75 / 100 Bonus Beans toward your next free drink)',
+        100: 'Order ready for pickup & Free Drink Reward unlocked! — 100% complete (100 / 100 Bonus Beans)'
+      };
+
+      function setDeterminate(value) {
+        const numericVal = Math.max(0, Math.min(100, Number(value)));
+        progressBar.classList.remove('is-indeterminate');
+        progressBar.setAttribute('aria-valuenow', String(numericVal));
+        progressBar.setAttribute('aria-valuetext', numericVal + '% complete');
+        progressBar.removeAttribute('aria-busy');
+        progressFill.style.width = numericVal + '%';
+
+        nativeProgress.value = numericVal;
+        nativeProgress.textContent = numericVal + '%';
+
+        badge.textContent = numericVal + '% Complete';
+        statusText.textContent = stageDescriptions[numericVal] || ('Order & reward progress — ' + numericVal + '% complete');
+
+        steps.forEach((step) => {
+          const stepThreshold = Number(step.getAttribute('data-step'));
+          if (numericVal >= stepThreshold) {
+            step.classList.add('active');
+          } else {
+            step.classList.remove('active');
+          }
+        });
+      }
+
+      function setIndeterminate() {
+        progressBar.classList.add('is-indeterminate');
+        progressBar.removeAttribute('aria-valuenow');
+        progressBar.setAttribute('aria-valuetext', 'Processing order and calculating reward beans...');
+        progressBar.setAttribute('aria-busy', 'true');
+
+        nativeProgress.removeAttribute('value');
+        nativeProgress.textContent = 'Processing...';
+
+        badge.textContent = 'Processing...';
+        statusText.textContent = 'Connecting to barista bar & syncing your Daily Grind reward points...';
+
+        steps.forEach((step) => step.classList.remove('active'));
+      }
+
+      buttons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          buttons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+
+          const mode = btn.getAttribute('data-mode');
+          if (mode === 'indeterminate') {
+            setIndeterminate();
+          } else {
+            setDeterminate(btn.getAttribute('data-value'));
+          }
+        });
+      });
+    })();
+  </script>
