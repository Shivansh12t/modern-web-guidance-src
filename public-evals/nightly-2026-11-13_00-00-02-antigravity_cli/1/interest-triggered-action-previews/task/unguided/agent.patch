+    <div id="seasonal-preview" aria-live="polite">Select a drink to preview</div>
   </main>
 
+  <script>
+    const previewBox = document.getElementById('seasonal-preview');
+    const defaultPreviewText = 'Select a drink to preview';
+    let activeInvoker = null;
+
+    function resolveInvoker(event) {
+      if (event && event.source) return event.source;
+      try {
+        const matched = document.querySelector('[interestfor="seasonal-preview"]:interest-source');
+        if (matched) return matched;
+      } catch {}
+      if (document.activeElement && document.activeElement.getAttribute('interestfor') === 'seasonal-preview') {
+        return document.activeElement;
+      }
+      return null;
+    }
+
+    previewBox.addEventListener('interest', (event) => {
+      const source = resolveInvoker(event);
+      activeInvoker = source;
+      const card = source?.closest('.card');
+      const drink = source?.dataset.drink || card?.querySelector('h3')?.textContent?.trim() || '';
+      const description = source?.dataset.description || card?.querySelector('p')?.textContent?.trim() || '';
+      const accent = source?.dataset.accent || '#ffab40';
+
+      previewBox.textContent = description ? `${drink} — ${description}` : (drink || defaultPreviewText);
+      previewBox.dataset.drink = drink;
+      previewBox.dataset.accent = accent;
+      previewBox.style.setProperty('--preview-accent', accent);
+      previewBox.style.borderColor = accent;
+      previewBox.style.color = accent;
+    });
+
+    previewBox.addEventListener('loseinterest', (event) => {
+      if (event.source && activeInvoker && event.source !== activeInvoker) {
+        return;
+      }
+      activeInvoker = null;
+      previewBox.textContent = defaultPreviewText;
+      delete previewBox.dataset.drink;
+      delete previewBox.dataset.accent;
+      previewBox.style.removeProperty('--preview-accent');
+      previewBox.style.borderColor = '';
+      previewBox.style.color = '';
+    });
+  </script>
+
