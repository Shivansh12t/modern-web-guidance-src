+import React, { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStoryItem {
+  id: string;
+  title: string;
+  date: string;
+  category?: string;
+}
+
+interface TopStoriesCarouselProps {
+  stories: TopStoryItem[];
+  baseUrl?: string;
+}
+
+export default function TopStoriesCarousel({
+  stories,
+  baseUrl = import.meta.env.BASE_URL,
+}: TopStoriesCarouselProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [animKey, setAnimKey] = useState(0);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const handlePrevious = () => {
+    setDirection('prev');
+    setCurrentIndex((prev) => (prev - 1 + stories.length) % stories.length);
+    setAnimKey((prev) => prev + 1);
+  };
+
+  const handleNext = () => {
+    setDirection('next');
+    setCurrentIndex((prev) => (prev + 1) % stories.length);
+    setAnimKey((prev) => prev + 1);
+  };
+
+  const currentStory = stories[currentIndex];
+  const animationClass =
+    direction === 'next'
+      ? 'animate-slide-in-right'
+      : direction === 'prev'
+        ? 'animate-slide-in-left'
+        : '';
+
+  return (
+    <section
+      aria-label="Top Stories"
+      aria-roledescription="carousel"
+      className="bg-white border-b border-gray-300"
+    >
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div className="flex items-center justify-between gap-4">
+          <button
+            type="button"
+            onClick={handlePrevious}
+            aria-label="Previous"
+            className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer flex-shrink-0"
+          >
+            <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+            <span>Previous</span>
+          </button>
+
+          <div className="flex-1 overflow-hidden text-center px-2">
+            <div
+              key={animKey}
+              data-direction={direction ?? undefined}
+              className={animationClass}
+            >
+              <a href={`${baseUrl}articles/${currentStory.id}`}>
+                <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+                  {currentStory.title}
+                </h3>
+              </a>
+              <span className="text-xs text-gray-500">{currentStory.date}</span>
+            </div>
+          </div>
+
+          <button
+            type="button"
+            onClick={handleNext}
+            aria-label="Next"
+            className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer flex-shrink-0"
+          >
+            <span>Next</span>
+            <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
