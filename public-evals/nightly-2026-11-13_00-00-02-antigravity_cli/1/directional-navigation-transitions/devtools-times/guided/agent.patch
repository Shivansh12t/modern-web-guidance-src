+    <script>
+        function initTopStoriesCarousel() {
+            const carousel = document.getElementById('top-stories-carousel');
+            if (!carousel || carousel.dataset.initialized === 'true') return;
+            carousel.dataset.initialized = 'true';
+
+            const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-story-slide]'));
+            const prevBtn = carousel.querySelector<HTMLButtonElement>('button[data-direction="previous"]');
+            const nextBtn = carousel.querySelector<HTMLButtonElement>('button[data-direction="next"]');
+            const statusEl = carousel.querySelector<HTMLElement>('[data-carousel-status]');
+            const total = slides.length;
+            if (total === 0) return;
+
+            let currentIndex = slides.findIndex((slide) => !slide.hidden);
+            if (currentIndex === -1) currentIndex = 0;
+
+            function updateSlideDOM(nextIndex: number) {
+                currentIndex = nextIndex;
+                slides.forEach((slide, idx) => {
+                    slide.hidden = idx !== currentIndex;
+                });
+                if (statusEl) {
+                    statusEl.textContent = `Story ${currentIndex + 1} of ${total}`;
+                }
+            }
+
+            function navigate(nextIndex: number, direction: 'forward' | 'backward') {
+                const updateDOM = () => updateSlideDOM(nextIndex);
+
+                if (!document.startViewTransition) {
+                    updateDOM();
+                    return;
+                }
+
+                const transition = document.startViewTransition({
+                    update: updateDOM,
+                    types: [direction],
+                });
+                transition.ready.catch(() => {});
+            }
+
+            prevBtn?.addEventListener('click', () => {
+                const nextIndex = (currentIndex - 1 + total) % total;
+                navigate(nextIndex, 'backward');
