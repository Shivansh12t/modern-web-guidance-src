+  <script>
+    const drinks = [
+      {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        href: '/menu/seasonal'
+      },
+      {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        href: '/menu/espresso'
+      },
+      {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        href: '/menu/cold-brew'
+      }
+    ];
+
+    let currentIndex = 0;
+
+    const titleEl = document.getElementById('drink-title');
+    const descriptionEl = document.getElementById('drink-description');
+    const linkEl = document.getElementById('drink-link');
+    const statusEl = document.getElementById('carousel-status');
+    const prevBtn = document.getElementById('prev-btn');
+    const nextBtn = document.getElementById('next-btn');
+
+    function renderDrink(index) {
+      const drink = drinks[index];
+      titleEl.textContent = drink.title;
+      descriptionEl.textContent = drink.description;
+      linkEl.href = drink.href;
+      statusEl.textContent = `${index + 1} / ${drinks.length}`;
+    }
+
+    function navigate(updateDOM, direction) {
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      document.startViewTransition({
+        update: updateDOM,
+        types: [direction]
+      });
+    }
+
+    nextBtn.addEventListener('click', () => {
+      currentIndex = (currentIndex + 1) % drinks.length;
+      navigate(() => renderDrink(currentIndex), 'forward');
+    });
+
+    prevBtn.addEventListener('click', () => {
+      currentIndex = (currentIndex - 1 + drinks.length) % drinks.length;
+      navigate(() => renderDrink(currentIndex), 'backward');
+    });
+  </script>
 </body>
 
