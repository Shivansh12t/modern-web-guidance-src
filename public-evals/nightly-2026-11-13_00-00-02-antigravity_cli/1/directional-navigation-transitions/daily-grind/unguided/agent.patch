+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('#seasonal-favorites .card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const grid = document.querySelector('#seasonal-favorites .grid');
+      let currentIndex = 0;
+
+      function showCard(newIndex, direction) {
+        cards.forEach((card, index) => {
+          card.classList.remove('active', 'slide-in-right', 'slide-in-left');
+          card.setAttribute('aria-hidden', index === newIndex ? 'false' : 'true');
+        });
+
+        currentIndex = newIndex;
+        const activeCard = cards[currentIndex];
+        activeCard.classList.add('active');
+
+        if (direction) {
+          // Force reflow so the directional animation reliably restarts on each step
+          void activeCard.offsetWidth;
+          const animClass = direction === 'next' ? 'slide-in-right' : 'slide-in-left';
+          activeCard.classList.add(animClass);
+          activeCard.setAttribute('data-direction', direction);
+          if (grid) {
+            grid.setAttribute('data-direction', direction);
+          }
+        }
+      }
+
+      nextBtn.addEventListener('click', () => {
+        const nextIndex = (currentIndex + 1) % cards.length;
+        showCard(nextIndex, 'next');
+      });
+
+      prevBtn.addEventListener('click', () => {
+        const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
+        showCard(prevIndex, 'prev');
+      });
+    })();
+  </script>
+
