+  <script type="module">
+    const ALLOWED_ELEMENTS = [
+      'p', 'b', 'i', 'strong', 'em', 'u', 'ul', 'ol', 'li', 'blockquote', 'code', 'span', 'br'
+    ];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // setHTML() accepts a plain configuration object as the sanitizer
+        el.setHTML(html, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          // Match the native Sanitizer: strip aria-*/data-* and disallowed element content
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    async function safeParsePreview(previewEl, rawHTML) {
+      if (!rawHTML.trim()) {
+        previewEl.replaceChildren();
+        const placeholder = document.createElement('p');
+        const em = document.createElement('em');
+        em.textContent = 'Start typing above to preview your formatted feedback...';
+        placeholder.appendChild(em);
+        previewEl.appendChild(placeholder);
+        return;
+      }
+
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(rawHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, rawHTML);
+      }
+    }
+
+    const initialReviews = [
+      {
+        name: 'Elena Rostova',
+        drink: 'Maple Oat Latte',
+        rating: 5,
+        html: '<p>The <strong>Maple Oat Latte</strong> is autumn in a cup! Just the right balance of <em>real Vermont maple</em> without being overly sweet.</p>'
+      },
+      {
+        name: 'Marcus Vance',
+        drink: 'Dark Roast Espresso',
+        rating: 5,
+        html: '<p>Rich crema and bold notes:</p><ul><li>Zero bitterness</li><li>Smokey dark chocolate finish</li></ul>'
+      },
+      {
+        name: 'Priya Patel',
+        drink: 'Cold Brew',
+        rating: 4,
+        html: '<blockquote>Silkiest cold brew in town!</blockquote><p>Steeping for <b>18 hours</b> truly makes a difference.</p>'
+      }
+    ];
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const nameInput = document.getElementById('reviewer-name');
+    const htmlInput = document.getElementById('review-html');
+    const nameError = document.getElementById('name-error');
+    const htmlError = document.getElementById('html-error');
+    const previewBox = document.getElementById('review-preview');
+    const statusBanner = document.getElementById('review-status');
+
+    async function appendReviewCard({ name, drink, rating, html }, prepend = false) {
+      const li = document.createElement('li');
+      li.className = 'review-item';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const leftGroup = document.createElement('div');
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = name;
+
+      const badgeSpan = document.createElement('span');
+      badgeSpan.className = 'review-badge';
+      badgeSpan.style.marginInlineStart = '0.5rem';
+      badgeSpan.textContent = drink;
+
+      leftGroup.append(authorSpan, badgeSpan);
+
+      const ratingSpan = document.createElement('span');
+      ratingSpan.className = 'review-rating';
+      const starsCount = Number(rating) || 5;
+      ratingSpan.textContent = `${'★'.repeat(starsCount)}${'☆'.repeat(5 - starsCount)} (${starsCount}/5)`;
+
+      header.append(leftGroup, ratingSpan);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, html);
+
+      li.append(header, body);
+
+      if (prepend && reviewsList.firstChild) {
+        reviewsList.prepend(li);
+      } else {
+        reviewsList.appendChild(li);
+      }
+    }
+
+    for (const review of initialReviews) {
+      await appendReviewCard(review, false);
+    }
+
+    function validateField(input, errorEl) {
+      const isValid = input.value.trim().length >= (input.minLength > 0 ? input.minLength : 1);
+      if (!isValid) {
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.hidden = false;
+      } else {
+        input.removeAttribute('aria-invalid');
+        errorEl.hidden = true;
+      }
+      return isValid;
+    }
+
+    nameInput.addEventListener('blur', () => {
+      if (nameInput.value.length > 0) validateField(nameInput, nameError);
+    });
+
+    nameInput.addEventListener('input', () => {
+      if (nameInput.getAttribute('aria-invalid') === 'true' && nameInput.value.trim().length > 0) {
+        nameInput.removeAttribute('aria-invalid');
+        nameError.hidden = true;
+      }
+    });
+
+    htmlInput.addEventListener('blur', () => {
+      if (htmlInput.value.length > 0) validateField(htmlInput, htmlError);
+    });
+
+    htmlInput.addEventListener('input', () => {
+      if (htmlInput.getAttribute('aria-invalid') === 'true' && htmlInput.value.trim().length >= 3) {
+        htmlInput.removeAttribute('aria-invalid');
+        htmlError.hidden = true;
+      }
+      safeParsePreview(previewBox, htmlInput.value);
+    });
+
+    reviewForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      statusBanner.textContent = '';
+
+      const isNameValid = validateField(nameInput, nameError);
+      const isHtmlValid = validateField(htmlInput, htmlError);
+
+      if (!isNameValid) {
+        nameInput.focus();
+        return;
+      }
+      if (!isHtmlValid) {
+        htmlInput.focus();
+        return;
+      }
+
+      const formData = new FormData(reviewForm);
+      const name = String(formData.get('reviewer_name') || '').trim();
+      const drink = String(formData.get('drink') || 'Maple Oat Latte');
+      const rating = Number(formData.get('rating') || 5);
+      const html = String(formData.get('review_html') || '');
+
+      await appendReviewCard({ name, drink, rating, html }, true);
+
+      reviewForm.reset();
+      await safeParsePreview(previewBox, '');
+      statusBanner.textContent = `Thank you, ${name}! Your sanitized review for ${drink} has been posted.`;
+    });
+  </script>
+
 </body>
 
