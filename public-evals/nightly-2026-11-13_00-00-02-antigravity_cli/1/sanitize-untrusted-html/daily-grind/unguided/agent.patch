+  <script>
+    if (typeof Element !== 'undefined' && typeof Element.prototype.setHTML !== 'function') {
+      Element.prototype.setHTML = function (markup) {
+        const parser = new DOMParser();
+        const doc = parser.parseFromString(String(markup ?? ''), 'text/html');
+        const disallowedTags = new Set([
+          'SCRIPT', 'IFRAME', 'OBJECT', 'EMBED', 'STYLE', 'LINK',
+          'META', 'BASE', 'FORM', 'INPUT', 'BUTTON', 'TEXTAREA',
+          'SELECT', 'OPTION', 'APPLET', 'FRAME', 'FRAMESET',
+          'NOSCRIPT', 'TEMPLATE', 'SVG', 'MATH', 'AUDIO', 'VIDEO'
+        ]);
+
+        for (const el of Array.from(doc.body.querySelectorAll('*'))) {
+          if (disallowedTags.has(el.tagName)) {
+            el.remove();
+            continue;
+          }
+          for (const attr of Array.from(el.attributes)) {
+            const attrName = attr.name.toLowerCase();
+            const attrValue = attr.value.trim().toLowerCase();
+            if (
+              attrName.startsWith('on') ||
+              attrName === 'srcdoc' ||
+              attrName === 'formaction' ||
+              ((attrName === 'href' || attrName === 'src' || attrName === 'xlink:href' || attrName === 'action') &&
+                (attrValue.startsWith('javascript:') || attrValue.startsWith('vbscript:') || attrValue.startsWith('data:text/html')))
+            ) {
+              el.removeAttribute(attr.name);
+            }
+          }
+        }
+
+        this.replaceChildren(...Array.from(doc.body.childNodes));
+      };
+    }
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const drinkSelect = document.getElementById('review-drink');
+    const nameInput = document.getElementById('reviewer-name');
+    const ratingSelect = document.getElementById('review-rating');
+    const contentInput = document.getElementById('review-content');
+
+    function createReviewElement({ drink, name, rating, html }) {
+      const card = document.createElement('article');
+      card.className = 'review-card';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = name || 'Coffee Enthusiast';
+
+      const drinkBadge = document.createElement('span');
+      drinkBadge.className = 'review-drink-badge';
+      drinkBadge.textContent = drink;
+
+      meta.append(authorSpan, drinkBadge);
+
+      const ratingDiv = document.createElement('div');
+      ratingDiv.className = 'review-rating';
+      const numericRating = Math.min(5, Math.max(1, Number(rating) || 5));
+      ratingDiv.textContent = '★'.repeat(numericRating) + '☆'.repeat(5 - numericRating);
+      ratingDiv.setAttribute('aria-label', `${numericRating} out of 5 stars`);
+
+      header.append(meta, ratingDiv);
+
+      const reviewBody = document.createElement('div');
+      reviewBody.className = 'review-body';
+      reviewBody.setHTML(html);
+
+      card.append(header, reviewBody);
+      return card;
+    }
+
+    const initialReviews = [
+      {
+        drink: 'Maple Oat Latte',
+        name: 'Elena M.',
+        rating: 5,
+        html: 'The <strong>Maple Oat Latte</strong> has the <em>perfect</em> balance of rich espresso and real Vermont maple sweetness!'
+      },
+      {
+        drink: 'Dark Roast Espresso',
+        name: 'Marcus T.',
+        rating: 5,
+        html: 'Bold and smooth with zero bitterness. Great notes of <b>dark chocolate</b> and toasted walnut.'
+      },
+      {
+        drink: 'Cold Brew',
+        name: 'Priya K.',
+        rating: 4,
+        html: 'Super refreshing and silky smooth—easily my go-to afternoon pick-me-up.'
+      }
+    ];
+
+    initialReviews.forEach((review) => {
+      reviewsList.appendChild(createReviewElement(review));
+    });
+
+    reviewForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const rawHtml = contentInput.value.trim();
+      if (!rawHtml) return;
+
+      const newReview = {
+        drink: drinkSelect.value || 'Maple Oat Latte',
+        name: nameInput.value.trim() || 'Coffee Enthusiast',
+        rating: ratingSelect.value || '5',
+        html: rawHtml
+      };
+
+      reviewsList.prepend(createReviewElement(newReview));
+      contentInput.value = '';
+      nameInput.value = '';
+    });
+  </script>
+
