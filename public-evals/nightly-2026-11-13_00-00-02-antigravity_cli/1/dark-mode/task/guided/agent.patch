+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const themeSelect = document.getElementById('theme-select');
+      const systemOption = document.getElementById('theme-option-system');
+      const mql = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateSystemOptionLabel() {
+        if (systemOption) {
+          systemOption.textContent = `System (Currently ${mql.matches ? 'dark' : 'light'})`;
+        }
+      }
+
+      function syncThemeFromStorage() {
+        let stored = null;
+        try {
+          stored = localStorage.getItem('color-scheme');
+        } catch {}
+
+        if (stored === 'light' || stored === 'dark') {
+          meta.content = stored;
+          themeSelect.value = stored;
+        } else {
+          meta.content = 'light dark';
+          themeSelect.value = 'system';
+        }
+      }
+
+      themeSelect.addEventListener('change', () => {
+        const value = themeSelect.value;
+        if (value === 'light' || value === 'dark') {
+          meta.content = value;
+          try {
+            localStorage.setItem('color-scheme', value);
+          } catch {}
+        } else {
+          meta.content = 'light dark';
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+        }
+      });
+
+      mql.addEventListener('change', updateSystemOptionLabel);
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          syncThemeFromStorage();
+        }
+      });
+
+      updateSystemOptionLabel();
+      syncThemeFromStorage();
+    })();
+  </script>
