+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMessage = document.getElementById('newsletter-email-error');
+      const DEFAULT_ERROR_TEXT = 'Please enter a valid email address.';
+
+      if (!form || !emailInput || !errorMessage) return;
+
+      let hasInteracted = false;
+
+      function matchesUserInvalid(el) {
+        try {
+          return el.matches(':user-invalid');
+        } catch (_) {
+          return false;
+        }
+      }
+
+      function syncErrorState() {
+        const isValid = emailInput.validity.valid && emailInput.value.trim().length > 0;
+        const shouldShowError = (hasInteracted || matchesUserInvalid(emailInput)) && !isValid;
+
+        if (shouldShowError) {
+          emailInput.setAttribute('aria-invalid', 'true');
+          emailInput.setAttribute('aria-describedby', errorMessage.id);
+          emailInput.setAttribute('aria-errormessage', errorMessage.id);
+          emailInput.classList.add('is-invalid');
+
+          if (errorMessage.textContent !== DEFAULT_ERROR_TEXT) {
+            errorMessage.textContent = DEFAULT_ERROR_TEXT;
+          }
+          errorMessage.hidden = false;
+          errorMessage.removeAttribute('aria-hidden');
+          errorMessage.classList.add('is-visible');
+        } else {
+          emailInput.setAttribute('aria-invalid', 'false');
+          emailInput.removeAttribute('aria-describedby');
+          emailInput.removeAttribute('aria-errormessage');
+          emailInput.classList.remove('is-invalid');
+
+          errorMessage.hidden = true;
+          errorMessage.setAttribute('aria-hidden', 'true');
+          errorMessage.classList.remove('is-visible');
+          errorMessage.textContent = '';
+        }
+      }
+
+      // Initialize clean pre-interaction state
+      syncErrorState();
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('change', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('input', function () {
+        syncErrorState();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncErrorState();
+
+        if (!emailInput.validity.valid || emailInput.value.trim().length === 0) {
+          emailInput.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
