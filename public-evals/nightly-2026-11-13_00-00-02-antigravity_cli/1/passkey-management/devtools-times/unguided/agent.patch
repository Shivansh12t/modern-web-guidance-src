diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..0fd272d
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,966 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  DEFAULT_READER_ACCOUNT,
+  DEFAULT_REGISTERED_PASSKEYS,
+  base64UrlToUint8Array,
+  detectSignalCapabilities,
+  getRpId,
+  signalUnknownCredentialToAuthenticator,
+  syncAcceptedCredentialsWithAuthenticator,
+  syncCurrentUserDetailsWithAuthenticator,
+  toBase64Url,
+  type AuthenticatorSignalRecord,
+  type ReaderAccount,
+  type RegisteredPasskey,
+  type SignalCapabilities,
+} from '../utils/passkeys';
+
+interface PasskeyManagementProps {
+  initialUser?: ReaderAccount;
+  initialPasskeys?: RegisteredPasskey[];
+  onUserUpdated?: (user: ReaderAccount) => void;
+}
+
+export default function PasskeyManagement({
+  initialUser = DEFAULT_READER_ACCOUNT,
+  initialPasskeys = DEFAULT_REGISTERED_PASSKEYS,
+  onUserUpdated,
+}: PasskeyManagementProps) {
+  const [user, setUser] = useState<ReaderAccount>(initialUser);
+  const [passkeys, setPasskeys] =
+    useState<RegisteredPasskey[]>(initialPasskeys);
+  const [loading, setLoading] = useState<boolean>(true);
+  const [busyId, setBusyId] = useState<string | null>(null);
+
+  // Reader profile display name editing state
+  const [readerDisplayName, setReaderDisplayName] = useState<string>(
+    initialUser.displayName
+  );
+  const [readerUsername, setReaderUsername] = useState<string>(
+    initialUser.name
+  );
+  const [savingProfile, setSavingProfile] = useState<boolean>(false);
+
+  // Per-passkey display name editing state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState<string>('');
+
+  // New passkey registration state
+  const [newPasskeyLabel, setNewPasskeyLabel] = useState<string>('');
+  const [registeringPasskey, setRegisteringPasskey] = useState<boolean>(false);
+
+  // Feedback banner & WebAuthn Signal API log
+  const [statusBanner, setStatusBanner] = useState<{
+    type: 'success' | 'info' | 'error';
+    text: string;
+  } | null>(null);
+  const [signalLog, setSignalLog] = useState<AuthenticatorSignalRecord[]>([]);
+  const [capabilities, setCapabilities] = useState<SignalCapabilities>({
+    webauthnSupported: false,
+    signalAllAcceptedCredentials: false,
+    signalCurrentUserDetails: false,
+    signalUnknownCredential: false,
+  });
+
+  const apiUrl = `${import.meta.env.BASE_URL}api/passkeys.json`;
+
+  const appendSignalRecord = useCallback(
+    (record: AuthenticatorSignalRecord) => {
+      setSignalLog((prev) => [record, ...prev].slice(0, 12));
+    },
+    []
+  );
+
+  // Load passkeys from API and sync accepted credentials with browser authenticator
+  const fetchPasskeysAndSync = useCallback(
+    async (syncOnLoad = true) => {
+      try {
+        setLoading(true);
+        const response = await fetch(apiUrl);
+        if (response.ok) {
+          const data = await response.json();
+          const loadedUser: ReaderAccount = data.user || DEFAULT_READER_ACCOUNT;
+          const loadedPasskeys: RegisteredPasskey[] =
+            data.passkeys || DEFAULT_REGISTERED_PASSKEYS;
+
+          setUser(loadedUser);
+          setReaderDisplayName(loadedUser.displayName);
+          setReaderUsername(loadedUser.name);
+          setPasskeys(loadedPasskeys);
+          onUserUpdated?.(loadedUser);
+
+          if (syncOnLoad) {
+            const record = await syncAcceptedCredentialsWithAuthenticator({
+              userId: loadedUser.userId,
+              allAcceptedCredentialIds: loadedPasskeys.map(
+                (pk) => pk.credentialId
+              ),
+            });
+            appendSignalRecord(record);
+          }
+        }
+      } catch {
+        // Fallback to local state if offline
+      } finally {
+        setLoading(false);
+      }
+    },
+    [apiUrl, appendSignalRecord, onUserUpdated]
+  );
+
+  useEffect(() => {
+    setCapabilities(detectSignalCapabilities());
+    fetchPasskeysAndSync(true);
+  }, [fetchPasskeysAndSync]);
+
+  // Update the reader's account display name & username and sync via signalCurrentUserDetails
+  const handleUpdateReaderDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplayName = readerDisplayName.trim();
+    const trimmedUsername = readerUsername.trim() || user.name;
+    if (!trimmedDisplayName) {
+      setStatusBanner({
+        type: 'error',
+        text: 'Please enter a valid display name.',
+      });
+      return;
+    }
+
+    setSavingProfile(true);
+    setStatusBanner(null);
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'updateDisplayName',
+          displayName: trimmedDisplayName,
+          name: trimmedUsername,
+        }),
+      });
+
+      const data = await response.json();
+      const updatedUser: ReaderAccount = data.user || {
+        ...user,
+        displayName: trimmedDisplayName,
+        name: trimmedUsername,
+      };
+
+      setUser(updatedUser);
+      setReaderDisplayName(updatedUser.displayName);
+      setReaderUsername(updatedUser.name);
+      onUserUpdated?.(updatedUser);
+
+      // Signal updated user details to browser authenticator
+      const signalRecord = await syncCurrentUserDetailsWithAuthenticator({
+        userId: updatedUser.userId,
+        name: updatedUser.name,
+        displayName: updatedUser.displayName,
+      });
+      appendSignalRecord(signalRecord);
+
+      setStatusBanner({
+        type: 'success',
+        text: `Reader display name updated to "${updatedUser.displayName}" and synced with your browser authenticator.`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        text: 'Failed to update display name. Please try again.',
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  // Start editing a specific passkey's display name
+  const handleStartRenamePasskey = (passkey: RegisteredPasskey) => {
+    setEditingPasskeyId(passkey.credentialId);
+    setEditingPasskeyName(passkey.displayName);
+    setStatusBanner(null);
+  };
+
+  // Cancel editing a passkey's display name
+  const handleCancelRenamePasskey = () => {
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+  };
+
+  // Save a passkey's updated display name and sync with browser authenticator
+  const handleSavePasskeyName = async (
+    e: React.FormEvent,
+    credentialId: string
+  ) => {
+    e.preventDefault();
+    const trimmedName = editingPasskeyName.trim();
+    if (!trimmedName) {
+      setStatusBanner({
+        type: 'error',
+        text: 'Passkey display name cannot be empty.',
+      });
+      return;
+    }
+
+    setBusyId(credentialId);
+    setStatusBanner(null);
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          credentialId,
+          displayName: trimmedName,
+        }),
+      });
+
+      const data = await response.json();
+      const updatedPasskeys: RegisteredPasskey[] =
+        data.passkeys ||
+        passkeys.map((pk) =>
+          pk.credentialId === credentialId
+            ? { ...pk, name: trimmedName, displayName: trimmedName }
+            : pk
+        );
+
+      setPasskeys(updatedPasskeys);
+      setEditingPasskeyId(null);
+      setEditingPasskeyName('');
+
+      // Keep the browser authenticator in sync with current user details & accepted credentials
+      const userSignalRecord = await syncCurrentUserDetailsWithAuthenticator({
+        userId: user.userId,
+        name: user.name,
+        displayName: user.displayName,
+      });
+      appendSignalRecord(userSignalRecord);
+
+      const acceptedSignalRecord = await syncAcceptedCredentialsWithAuthenticator(
+        {
+          userId: user.userId,
+          allAcceptedCredentialIds: updatedPasskeys.map(
+            (pk) => pk.credentialId
+          ),
+        }
+      );
+      appendSignalRecord(acceptedSignalRecord);
+
+      setStatusBanner({
+        type: 'success',
+        text: `Updated passkey display name to "${trimmedName}" and synchronized authenticator state.`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        text: 'Could not update passkey display name. Please try again.',
+      });
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  // Remove a passkey and signal both signalAllAcceptedCredentials and signalUnknownCredential
+  const handleRemovePasskey = async (passkey: RegisteredPasskey) => {
+    const targetCredId = passkey.credentialId;
+    setBusyId(targetCredId);
+    setStatusBanner(null);
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ credentialId: targetCredId }),
+      });
+
+      const data = await response.json();
+      const remainingPasskeys: RegisteredPasskey[] =
+        data.passkeys ||
+        passkeys.filter((pk) => pk.credentialId !== targetCredId);
+      const remainingCredIds = remainingPasskeys.map((pk) => pk.credentialId);
+
+      setPasskeys(remainingPasskeys);
+      if (editingPasskeyId === targetCredId) {
+        setEditingPasskeyId(null);
+        setEditingPasskeyName('');
+      }
+
+      // 1. Signal the updated list of all accepted credentials for this user
+      const acceptedSignal = await syncAcceptedCredentialsWithAuthenticator({
+        userId: user.userId,
+        allAcceptedCredentialIds: remainingCredIds,
+      });
+      appendSignalRecord(acceptedSignal);
+
+      // 2. Signal that the removed credential ID is now unknown/revoked
+      const unknownSignal = await signalUnknownCredentialToAuthenticator({
+        credentialId: targetCredId,
+      });
+      appendSignalRecord(unknownSignal);
+
+      setStatusBanner({
+        type: 'success',
+        text: `Removed passkey "${passkey.displayName}" and signaled your browser authenticator (${remainingCredIds.length} active key${remainingCredIds.length === 1 ? '' : 's'} remaining).`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        text: 'Failed to remove passkey. Please try again.',
+      });
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  // Register a new passkey using WebAuthn (with fallback when platform dialog is unavailable)
+  const handleRegisterNewPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setRegisteringPasskey(true);
+    setStatusBanner(null);
+
+    const label =
+      newPasskeyLabel.trim() ||
+      `Chrome Passkey (${new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' })})`;
+
+    let createdCredentialId = toBase64Url(
+      `cred-devtools-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+    );
+    let deviceLabel = 'Browser Authenticator · Synced Passkey';
+
+    if (
+      typeof window !== 'undefined' &&
+      window.PublicKeyCredential &&
+      navigator.credentials?.create
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        window.crypto.getRandomValues(challenge);
+        const userIdBytes = base64UrlToUint8Array(toBase64Url(user.userId));
+
+        const credential = (await navigator.credentials.create({
+          publicKey: {
+            challenge: challenge.buffer as ArrayBuffer,
+            rp: {
+              name: 'The DevTools Times',
+              id: getRpId(),
+            },
+            user: {
+              id: userIdBytes.buffer as ArrayBuffer,
+              name: user.name,
+              displayName: user.displayName,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 }, // ES256
+              { type: 'public-key', alg: -257 }, // RS256
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred',
+            },
+            excludeCredentials: passkeys.map((pk) => ({
+              type: 'public-key' as const,
+              id: base64UrlToUint8Array(pk.credentialId).buffer as ArrayBuffer,
+            })),
+            timeout: 15000,
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential?.rawId) {
+          createdCredentialId = toBase64Url(credential.rawId);
+          deviceLabel = 'WebAuthn Platform Authenticator';
+        }
+      } catch {
+        // Fallback to generated credential ID if user dismisses native prompt or headless browser
+      }
+    }
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'register',
+          credentialId: createdCredentialId,
+          displayName: label,
+          deviceLabel,
+          authenticatorType: 'platform',
+          backedUp: true,
+        }),
+      });
+
+      const data = await response.json();
+      const updatedPasskeys: RegisteredPasskey[] = data.passkeys || passkeys;
+      setPasskeys(updatedPasskeys);
+      setNewPasskeyLabel('');
+
+      const acceptedSignal = await syncAcceptedCredentialsWithAuthenticator({
+        userId: user.userId,
+        allAcceptedCredentialIds: updatedPasskeys.map((pk) => pk.credentialId),
+      });
+      appendSignalRecord(acceptedSignal);
+
+      setStatusBanner({
+        type: 'success',
+        text: `Registered passkey "${label}" and synced accepted credentials with your browser authenticator.`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        text: 'Could not register new passkey. Please try again.',
+      });
+    } finally {
+      setRegisteringPasskey(false);
+    }
+  };
+
+  // Manual full sync button
+  const handleManualAuthenticatorSync = async () => {
+    setStatusBanner(null);
+    const acceptedRecord = await syncAcceptedCredentialsWithAuthenticator({
+      userId: user.userId,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.credentialId),
+    });
+    appendSignalRecord(acceptedRecord);
+
+    const userRecord = await syncCurrentUserDetailsWithAuthenticator({
+      userId: user.userId,
+      name: user.name,
+      displayName: user.displayName,
+    });
+    appendSignalRecord(userRecord);
+
+    setStatusBanner({
+      type: 'info',
+      text: 'Synchronized accepted passkeys and current reader profile details with your browser authenticator.',
+    });
+  };
+
+  // Restore default demo passkeys
+  const handleRestoreDefaults = async () => {
+    setStatusBanner(null);
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset' }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        setUser(data.user);
+        setReaderDisplayName(data.user.displayName);
+        setReaderUsername(data.user.name);
+        setPasskeys(data.passkeys);
+        onUserUpdated?.(data.user);
+
+        const acceptedRecord = await syncAcceptedCredentialsWithAuthenticator({
+          userId: data.user.userId,
+          allAcceptedCredentialIds: data.passkeys.map(
+            (pk: RegisteredPasskey) => pk.credentialId
+          ),
+        });
+        appendSignalRecord(acceptedRecord);
+
+        setStatusBanner({
+          type: 'info',
+          text: 'Restored default registered passkeys and synced with browser authenticator.',
+        });
+      }
+    } catch {
+      // Ignore error
+    }
+  };
+
+  const formatDate = (iso: string | null) => {
+    if (!iso) return 'Never';
+    try {
+      return new Date(iso).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
+      });
+    } catch {
+      return iso;
+    }
+  };
+
+  return (
+    <section
+      id="passkey-management"
+      aria-labelledby="passkey-management-heading"
+      className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
+    >
