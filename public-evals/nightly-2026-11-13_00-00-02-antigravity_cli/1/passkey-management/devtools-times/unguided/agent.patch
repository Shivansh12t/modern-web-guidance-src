diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..11c320a
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,240 @@
+import type { APIRoute } from 'astro';
+import {
+  DEFAULT_READER_ACCOUNT,
+  DEFAULT_REGISTERED_PASSKEYS,
+  toBase64Url,
+  type ReaderAccount,
+  type RegisteredPasskey,
+} from '../../utils/passkeys';
+
+let fallbackAccount: ReaderAccount = { ...DEFAULT_READER_ACCOUNT };
+let fallbackPasskeys: RegisteredPasskey[] = DEFAULT_REGISTERED_PASSKEYS.map(
+  (pk) => ({ ...pk })
+);
+
+async function getState(session: any): Promise<{
+  user: ReaderAccount;
+  passkeys: RegisteredPasskey[];
+}> {
+  if (session) {
+    const user =
+      (await session.get('readerAccount')) || { ...DEFAULT_READER_ACCOUNT };
+    const passkeys =
+      (await session.get('registeredPasskeys')) ||
+      DEFAULT_REGISTERED_PASSKEYS.map((pk) => ({ ...pk }));
+    return { user, passkeys };
+  }
+  return { user: fallbackAccount, passkeys: fallbackPasskeys };
+}
+
+async function saveState(
+  session: any,
+  user: ReaderAccount,
+  passkeys: RegisteredPasskey[]
+) {
+  fallbackAccount = user;
+  fallbackPasskeys = passkeys;
+  if (session) {
+    await session.set('readerAccount', user);
+    await session.set('registeredPasskeys', passkeys);
+  }
+}
+
+function buildResponse(
+  user: ReaderAccount,
+  passkeys: RegisteredPasskey[],
+  extra: Record<string, unknown> = {},
+  status = 200
+) {
+  const allAcceptedCredentialIds = passkeys.map((pk) => pk.credentialId);
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys,
+      allAcceptedCredentialIds,
+      ...extra,
+    }),
+    {
+      status,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const { user, passkeys } = await getState(session);
+  return buildResponse(user, passkeys);
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  let { user, passkeys } = await getState(session);
+
+  const action = body.action;
+
+  if (action === 'reset') {
+    user = { ...DEFAULT_READER_ACCOUNT };
+    passkeys = DEFAULT_REGISTERED_PASSKEYS.map((pk) => ({ ...pk }));
+    await saveState(session, user, passkeys);
+    return buildResponse(user, passkeys, { reset: true });
+  }
+
+  if (action === 'remove' || action === 'delete') {
+    const targetId = body.credentialId || body.id;
+    if (!targetId) {
+      return buildResponse(
+        user,
+        passkeys,
+        { error: 'credentialId is required' },
+        400
+      );
+    }
+    passkeys = passkeys.filter(
+      (pk) => pk.credentialId !== targetId && pk.id !== targetId
+    );
+    await saveState(session, user, passkeys);
+    return buildResponse(user, passkeys, { removedCredentialId: targetId });
+  }
+
+  if (action === 'updateUser' || action === 'updateDisplayName') {
+    const nextDisplayName = (body.displayName ?? user.displayName).trim();
+    const nextName = (body.name ?? body.username ?? user.name).trim();
+    if (!nextDisplayName) {
+      return buildResponse(
+        user,
+        passkeys,
+        { error: 'Display name cannot be empty' },
+        400
+      );
+    }
+    user = {
+      ...user,
+      displayName: nextDisplayName,
+      name: nextName || user.name,
+    };
+    await saveState(session, user, passkeys);
+    return buildResponse(user, passkeys);
+  }
+
+  if (action === 'rename' || action === 'updatePasskey') {
+    const targetId = body.credentialId || body.id;
+    const nextName = (body.displayName ?? body.name ?? '').trim();
+    if (!targetId || !nextName) {
+      return buildResponse(
+        user,
+        passkeys,
+        { error: 'credentialId and displayName are required' },
+        400
+      );
+    }
+    passkeys = passkeys.map((pk) =>
+      pk.credentialId === targetId || pk.id === targetId
+        ? { ...pk, name: nextName, displayName: nextName }
+        : pk
+    );
+    await saveState(session, user, passkeys);
+    return buildResponse(user, passkeys, { updatedCredentialId: targetId });
+  }
+
+  // Default POST: Register / Add a new passkey
+  const rawCredId =
+    body.credentialId ||
+    body.id ||
+    toBase64Url(`cred-devtools-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`);
+  const encodedCredId = toBase64Url(rawCredId);
+  const label =
+    (body.displayName || body.name || 'New Device Passkey').trim();
+  const now = new Date().toISOString();
+
+  const newPasskey: RegisteredPasskey = {
+    id: encodedCredId,
+    credentialId: encodedCredId,
+    name: label,
+    displayName: label,
+    createdAt: now,
+    lastUsedAt: now,
+    authenticatorType: body.authenticatorType || 'platform',
+    backedUp: body.backedUp ?? true,
+    deviceLabel: body.deviceLabel || 'Browser Authenticator · Synced Passkey',
+    transports: body.transports || ['internal', 'hybrid'],
+  };
+
+  passkeys = [newPasskey, ...passkeys];
+  await saveState(session, user, passkeys);
+  return buildResponse(user, passkeys, { addedPasskey: newPasskey }, 201);
+};
+
+export const PATCH: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  let { user, passkeys } = await getState(session);
+
+  const targetId =
+    body.credentialId ||
+    body.id ||
+    url.searchParams.get('credentialId') ||
+    url.searchParams.get('id');
+
+  if (targetId) {
+    const nextName = (body.displayName ?? body.name ?? '').trim();
+    if (!nextName) {
+      return buildResponse(
+        user,
+        passkeys,
+        { error: 'Display name cannot be empty' },
+        400
+      );
+    }
+    passkeys = passkeys.map((pk) =>
+      pk.credentialId === targetId || pk.id === targetId
+        ? { ...pk, name: nextName, displayName: nextName }
+        : pk
+    );
+  }
+
+  if (body.userDisplayName || (!targetId && body.displayName)) {
+    const nextUserDisplayName = (
+      body.userDisplayName ?? body.displayName
+    ).trim();
+    const nextUserName = (body.userName ?? body.name ?? user.name).trim();
+    if (nextUserDisplayName) {
+      user = {
+        ...user,
+        displayName: nextUserDisplayName,
+        name: nextUserName || user.name,
+      };
+    }
+  }
+
+  await saveState(session, user, passkeys);
+  return buildResponse(user, passkeys, {
+    updatedCredentialId: targetId || undefined,
+  });
+};
+
+export const PUT: APIRoute = PATCH;
+
+export const DELETE: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  let { user, passkeys } = await getState(session);
+
+  const targetId =
+    body.credentialId ||
+    body.id ||
+    url.searchParams.get('credentialId') ||
+    url.searchParams.get('id');
+
+  if (!targetId) {
+    return buildResponse(
+      user,
+      passkeys,
+      { error: 'credentialId is required' },
+      400
+    );
+  }
+
+  passkeys = passkeys.filter(
+    (pk) => pk.credentialId !== targetId && pk.id !== targetId
+  );
+  await saveState(session, user, passkeys);
+  return buildResponse(user, passkeys, { removedCredentialId: targetId });
+};
