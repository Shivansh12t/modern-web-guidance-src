+import React, { useState } from 'react';
+import PasskeyManagement from './PasskeyManagement';
+import {
+  DEFAULT_READER_ACCOUNT,
+  DEFAULT_REGISTERED_PASSKEYS,
+  type ReaderAccount,
+  type RegisteredPasskey,
+} from '../utils/passkeys';
+
+interface AccountSettingsProps {
+  initialUser?: ReaderAccount;
+  initialPasskeys?: RegisteredPasskey[];
+}
+
+export default function AccountSettings({
+  initialUser = DEFAULT_READER_ACCOUNT,
+  initialPasskeys = DEFAULT_REGISTERED_PASSKEYS,
+}: AccountSettingsProps) {
+  const [user, setUser] = useState<ReaderAccount>(initialUser);
+  const [dailyBriefing, setDailyBriefing] = useState<boolean>(true);
+  const [devtoolsDigest, setDevtoolsDigest] = useState<boolean>(true);
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Page Title & Reader Account Banner */}
+      <div className="border-b border-gray-300 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-gray-500">
+            Reader Account Settings
+          </p>
+          <h1 className="text-3xl font-bold text-gray-900 mt-1">
+            Manage Your Account
+          </h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as{' '}
+            <span className="font-semibold text-gray-900">
+              {user.displayName}
+            </span>{' '}
+            ({user.name})
+          </p>
+        </div>
+
+        <div className="flex items-center gap-3 self-start sm:self-center">
+          <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-300">
+            <span className="w-2 h-2 rounded-full bg-amber-500 mr-2"></span>
+            {user.subscriptionTier}
+          </span>
+        </div>
+      </div>
+
+      {/* Passkey Management Section */}
+      <PasskeyManagement
+        initialUser={initialUser}
+        initialPasskeys={initialPasskeys}
+        onUserUpdated={setUser}
+      />
+
+      {/* Subscription & Editorial Preferences Section */}
+      <section
+        aria-labelledby="editorial-preferences-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm p-6"
+      >
+        <h2
+          id="editorial-preferences-heading"
+          className="text-lg font-bold text-gray-900 mb-1"
+        >
+          Editorial &amp; Newsletter Preferences
+        </h2>
+        <p className="text-xs text-gray-600 mb-4">
+          Manage your delivery settings for The DevTools Times briefings.
+        </p>
+
+        <div className="divide-y divide-gray-200">
+          <label className="py-3 flex items-center justify-between cursor-pointer">
+            <div>
+              <p className="text-sm font-semibold text-gray-800">
+                The Morning DevTools Briefing
+              </p>
+              <p className="text-xs text-gray-500">
+                Daily top stories on web performance, browser internals, and
+                standards.
+              </p>
+            </div>
+            <input
+              type="checkbox"
+              checked={dailyBriefing}
+              onChange={(e) => setDailyBriefing(e.target.checked)}
+              className="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+            />
+          </label>
+
+          <label className="py-3 flex items-center justify-between cursor-pointer">
+            <div>
+              <p className="text-sm font-semibold text-gray-800">
+                Security &amp; Identity Weekly
+              </p>
+              <p className="text-xs text-gray-500">
+                Deep dives into WebAuthn, passkeys, and modern web
+                authentication.
+              </p>
+            </div>
+            <input
+              type="checkbox"
+              checked={devtoolsDigest}
+              onChange={(e) => setDevtoolsDigest(e.target.checked)}
+              className="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+            />
+          </label>
+        </div>
+      </section>
+    </div>
+  );
+}
