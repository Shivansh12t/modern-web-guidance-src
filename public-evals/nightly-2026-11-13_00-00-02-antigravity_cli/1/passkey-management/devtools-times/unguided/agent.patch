diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..6b2800e
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,348 @@
+export interface RegisteredPasskey {
+  id: string;
+  credentialId: string; // Base64URL-encoded credential ID
+  name: string;
+  displayName: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  authenticatorType: 'platform' | 'cross-platform';
+  backedUp: boolean;
+  deviceLabel: string;
+  transports?: string[];
+}
+
+export interface ReaderAccount {
+  userId: string; // Base64URL-encoded user handle
+  name: string; // Username / email
+  displayName: string; // Reader display name
+  subscriptionTier: string;
+  signedIn: boolean;
+}
+
+export interface AuthenticatorSignalRecord {
+  id: string;
+  method:
+    | 'signalAllAcceptedCredentials'
+    | 'signalCurrentUserDetails'
+    | 'signalUnknownCredential';
+  timestamp: string;
+  supported: boolean;
+  synced: boolean;
+  payload: Record<string, unknown>;
+  message: string;
+}
+
+export interface SignalCapabilities {
+  webauthnSupported: boolean;
+  signalAllAcceptedCredentials: boolean;
+  signalCurrentUserDetails: boolean;
+  signalUnknownCredential: boolean;
+}
+
+const BASE64URL_REGEX = /^[A-Za-z0-9_-]+$/;
+
+/**
+ * Ensures a string or byte array is encoded as an unpadded Base64URL string,
+ * as required by the WebAuthn Signal API for `userId` and `credentialId`.
+ */
+export function toBase64Url(input: string | ArrayBuffer | Uint8Array): string {
+  if (typeof input === 'string') {
+    const trimmed = input.trim();
+    if (trimmed.length > 0 && BASE64URL_REGEX.test(trimmed)) {
+      return trimmed;
+    }
+    const bytes = new TextEncoder().encode(trimmed);
+    return bytesToBase64Url(bytes);
+  }
+
+  const bytes = input instanceof Uint8Array ? input : new Uint8Array(input);
+  return bytesToBase64Url(bytes);
+}
+
+function bytesToBase64Url(bytes: Uint8Array): string {
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  const base64 =
+    typeof btoa === 'function'
+      ? btoa(binary)
+      : Buffer.from(bytes).toString('base64');
+  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
+}
+
+export function base64UrlToUint8Array(base64Url: string): Uint8Array {
+  const padded = base64Url
+    .replace(/-/g, '+')
+    .replace(/_/g, '/')
+    .padEnd(Math.ceil(base64Url.length / 4) * 4, '=');
+
+  if (typeof atob === 'function') {
+    const binary = atob(padded);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+  }
+
+  return new Uint8Array(Buffer.from(padded, 'base64'));
+}
+
+export const DEFAULT_READER_ACCOUNT: ReaderAccount = {
+  userId: 'dXNlci1kZXZ0b29scy1yZWFkZXItMDE', // Base64URL for "user-devtools-reader-01"
+  name: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+  subscriptionTier: 'Digital All-Access Subscriber',
+  signedIn: true,
+};
+
+export const DEFAULT_REGISTERED_PASSKEYS: RegisteredPasskey[] = [
+  {
+    id: 'Y3JlZC1tYWNib29rLXByby10b3VjaGlkLTAx',
+    credentialId: 'Y3JlZC1tYWNib29rLXByby10b3VjaGlkLTAx',
+    name: 'MacBook Pro — Chrome (Touch ID)',
+    displayName: 'MacBook Pro — Chrome (Touch ID)',
+    createdAt: '2026-08-14T10:20:00Z',
+    lastUsedAt: '2026-11-12T18:45:00Z',
+    authenticatorType: 'platform',
+    backedUp: true,
+    deviceLabel: 'macOS · Google Password Manager',
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'Y3JlZC1waXhlbC05LXByby1wYXNza2V5LTAy',
+    credentialId: 'Y3JlZC1waXhlbC05LXByby1wYXNza2V5LTAy',
+    name: 'Pixel 9 Pro',
+    displayName: 'Pixel 9 Pro',
+    createdAt: '2026-09-03T14:12:00Z',
+    lastUsedAt: '2026-11-10T08:15:00Z',
+    authenticatorType: 'platform',
+    backedUp: true,
+    deviceLabel: 'Android · Google Password Manager',
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'Y3JlZC15dWJpa2V5LTVjLW5mYy1iYWNrdXAtMDM',
+    credentialId: 'Y3JlZC15dWJpa2V5LTVjLW5mYy1iYWNrdXAtMDM',
+    name: 'YubiKey 5C NFC (Backup Key)',
+    displayName: 'YubiKey 5C NFC (Backup Key)',
+    createdAt: '2026-05-21T09:00:00Z',
+    lastUsedAt: '2026-07-19T16:30:00Z',
+    authenticatorType: 'cross-platform',
+    backedUp: false,
+    deviceLabel: 'Hardware Security Key',
+    transports: ['usb', 'nfc'],
+  },
+];
+
+export function getRpId(explicitRpId?: string): string {
+  if (explicitRpId && explicitRpId.trim().length > 0) {
+    return explicitRpId.trim();
+  }
+  if (typeof window !== 'undefined' && window.location?.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+export function detectSignalCapabilities(): SignalCapabilities {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) {
+    return {
+      webauthnSupported: false,
+      signalAllAcceptedCredentials: false,
+      signalCurrentUserDetails: false,
+      signalUnknownCredential: false,
+    };
+  }
+
+  return {
+    webauthnSupported: true,
+    signalAllAcceptedCredentials:
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+    signalCurrentUserDetails:
+      typeof PublicKeyCredential.signalCurrentUserDetails === 'function',
+    signalUnknownCredential:
+      typeof PublicKeyCredential.signalUnknownCredential === 'function',
+  };
+}
+
+/**
+ * Signals the complete list of accepted credential IDs for the current user
+ * to the browser authenticator via `PublicKeyCredential.signalAllAcceptedCredentials`.
+ */
+export async function syncAcceptedCredentialsWithAuthenticator(params: {
+  userId: string;
+  allAcceptedCredentialIds: string[];
+  rpId?: string;
+}): Promise<AuthenticatorSignalRecord> {
+  const rpId = getRpId(params.rpId);
+  const encodedUserId = toBase64Url(params.userId);
+  const encodedCredIds = params.allAcceptedCredentialIds.map((id) =>
+    toBase64Url(id)
+  );
+  const payload = {
+    rpId,
+    userId: encodedUserId,
+    allAcceptedCredentialIds: encodedCredIds,
+  };
+  const timestamp = new Date().toISOString();
+
+  if (
+    typeof window !== 'undefined' &&
+    'PublicKeyCredential' in window &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+      return {
+        id: `sig-accepted-${Date.now()}`,
+        method: 'signalAllAcceptedCredentials',
+        timestamp,
+        supported: true,
+        synced: true,
+        payload,
+        message: `Synced ${encodedCredIds.length} accepted passkey(s) with browser authenticator.`,
+      };
+    } catch (err: any) {
+      return {
+        id: `sig-accepted-${Date.now()}`,
+        method: 'signalAllAcceptedCredentials',
+        timestamp,
+        supported: true,
+        synced: false,
+        payload,
+        message: `Authenticator signal warning: ${err?.message || 'Unable to complete signalAllAcceptedCredentials'}.`,
+      };
+    }
+  }
+
+  return {
+    id: `sig-accepted-${Date.now()}`,
+    method: 'signalAllAcceptedCredentials',
+    timestamp,
+    supported: false,
+    synced: false,
+    payload,
+    message:
+      'Browser does not expose PublicKeyCredential.signalAllAcceptedCredentials; server state updated.',
+  };
+}
+
+/**
+ * Signals updated user details (`name` and `displayName`) to the browser authenticator
+ * via `PublicKeyCredential.signalCurrentUserDetails`.
+ */
+export async function syncCurrentUserDetailsWithAuthenticator(params: {
+  userId: string;
+  name: string;
+  displayName: string;
+  rpId?: string;
+}): Promise<AuthenticatorSignalRecord> {
+  const rpId = getRpId(params.rpId);
+  const encodedUserId = toBase64Url(params.userId);
+  const payload = {
+    rpId,
+    userId: encodedUserId,
+    name: params.name,
+    displayName: params.displayName,
+  };
+  const timestamp = new Date().toISOString();
+
+  if (
+    typeof window !== 'undefined' &&
+    'PublicKeyCredential' in window &&
+    typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails(payload);
+      return {
+        id: `sig-user-${Date.now()}`,
+        method: 'signalCurrentUserDetails',
+        timestamp,
+        supported: true,
+        synced: true,
+        payload,
+        message: `Synced display name "${params.displayName}" (${params.name}) with browser authenticator.`,
+      };
+    } catch (err: any) {
+      return {
+        id: `sig-user-${Date.now()}`,
+        method: 'signalCurrentUserDetails',
+        timestamp,
+        supported: true,
+        synced: false,
+        payload,
+        message: `Authenticator signal warning: ${err?.message || 'Unable to complete signalCurrentUserDetails'}.`,
+      };
+    }
+  }
+
+  return {
+    id: `sig-user-${Date.now()}`,
+    method: 'signalCurrentUserDetails',
+    timestamp,
+    supported: false,
+    synced: false,
+    payload,
+    message:
+      'Browser does not expose PublicKeyCredential.signalCurrentUserDetails; server state updated.',
+  };
+}
+
+/**
+ * Signals to the browser authenticator that a specific credential ID is no longer
+ * recognized by the server via `PublicKeyCredential.signalUnknownCredential`.
+ */
+export async function signalUnknownCredentialToAuthenticator(params: {
+  credentialId: string;
+  rpId?: string;
+}): Promise<AuthenticatorSignalRecord> {
+  const rpId = getRpId(params.rpId);
+  const encodedCredentialId = toBase64Url(params.credentialId);
+  const payload = {
+    rpId,
+    credentialId: encodedCredentialId,
+  };
+  const timestamp = new Date().toISOString();
+
+  if (
+    typeof window !== 'undefined' &&
+    'PublicKeyCredential' in window &&
+    typeof PublicKeyCredential.signalUnknownCredential === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalUnknownCredential(payload);
+      return {
+        id: `sig-unknown-${Date.now()}`,
+        method: 'signalUnknownCredential',
+        timestamp,
+        supported: true,
+        synced: true,
+        payload,
+        message: `Signaled removed credential (${encodedCredentialId.slice(0, 12)}…) to browser authenticator.`,
+      };
+    } catch (err: any) {
+      return {
+        id: `sig-unknown-${Date.now()}`,
+        method: 'signalUnknownCredential',
+        timestamp,
+        supported: true,
+        synced: false,
+        payload,
+        message: `Authenticator signal warning: ${err?.message || 'Unable to complete signalUnknownCredential'}.`,
+      };
+    }
+  }
+
+  return {
+    id: `sig-unknown-${Date.now()}`,
+    method: 'signalUnknownCredential',
+    timestamp,
+    supported: false,
+    synced: false,
+    payload,
+    message:
+      'Browser does not expose PublicKeyCredential.signalUnknownCredential; server state updated.',
+  };
+}
