@@ -0,0 +1,220 @@
+import aaguidsData from './aaguids.json';
+
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The DevTools Times';
+
+export interface AaguidRegistryEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+const aaguids: Record<string, AaguidRegistryEntry> = aaguidsData;
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID (Base64URL-encoded)
+  credentialPublicKey: string; // Base64URL-encoded public key used to verify assertion signatures
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string; // Authenticator Attestation GUID
+  providerIcon?: string; // Provider icon derived from the AAGUID registry
+  providerName?: string; // Original provider name from AAGUID registry
+  name: string; // Provider name derived from AAGUID registry or user-customized display name
+  transports: string[]; // Array of transport names (e.g. 'internal', 'hybrid')
+  lastUsedAt?: number; // Optional epoch timestamp of last sign-in
+  registeredAt: number; // Registration epoch timestamp
+  counter: number; // Authenticator sign-in signature counter
+}
+
+export interface UserAccountProfile {
+  id: string;
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // Username / email
+  displayName: string; // Display name
+  subscriptionTier: string;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export function resolveAaguidProvider(aaguid: string): {
+  name: string;
+  providerIcon?: string;
+  providerIconDark?: string;
+} {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+      providerIconDark: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+    providerIconDark: provider?.icon_dark,
+  };
+}
+
+// Unpadded Base64URL IDs for seed data
+// Buffer.from('reader-alex-morgan-01').toString('base64url') => 'cmVhZGVyLWFsZXgtbW9yZ2FuLTAx'
+const DEFAULT_PASSKEY_USER_ID = 'cmVhZGVyLWFsZXgtbW9yZ2FuLTAx';
+
+interface PasskeyGlobalState {
+  user: UserAccountProfile;
+  credentials: StoredPasskeyCredential[];
+  challenges: Record<string, string>;
+}
+
+const globalForPasskeys = globalThis as unknown as {
+  __devtoolsTimesPasskeyStore?: PasskeyGlobalState;
+};
+
+function createInitialState(): PasskeyGlobalState {
+  const googleProvider = resolveAaguidProvider('ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4');
+  const icloudProvider = resolveAaguidProvider('fbfc3007-154e-4ecc-8c0b-6e020557d7bd');
+  const onePasswordProvider = resolveAaguidProvider('bada5566-a7aa-401f-bd96-45619a55120d');
+
+  return {
+    user: {
+      id: DEFAULT_PASSKEY_USER_ID,
+      passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+      name: 'alex.morgan@devtoolstimes.dev',
+      displayName: 'Alex Morgan',
+      subscriptionTier: 'Digital All-Access Subscriber',
+    },
+    credentials: [
+      {
+        // Buffer.from('cred-google-pm-001').toString('base64url')
+        id: 'Y3JlZC1nb29nbGUtcG0tMDAx',
+        passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+        credentialPublicKey: 'pQECAyYgASFYIJV8Z29vZ2xlLXB1YmxpYy1rZXktc2VlZC0wMDE',
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        providerIcon: googleProvider.providerIcon,
+        providerName: googleProvider.name,
+        name: googleProvider.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: 1758038400000,
+        lastUsedAt: 1762963200000,
+        counter: 14,
+      },
+      {
+        // Buffer.from('cred-icloud-keychain-002').toString('base64url')
+        id: 'Y3JlZC1pY2xvdWQta2V5Y2hhaW4tMDAy',
+        passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+        credentialPublicKey: 'pQECAyYgASFYIJV8aWNsb3VkLXB1YmxpYy1rZXktc2VlZC0wMDI',
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        providerIcon: icloudProvider.providerIcon,
+        providerName: icloudProvider.name,
+        name: icloudProvider.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: 1752249600000,
+        lastUsedAt: 1761580800000,
+        counter: 7,
+      },
+      {
+        // Buffer.from('cred-1password-003').toString('base64url')
+        id: 'Y3JlZC0xcGFzc3dvcmQtMDAz',
+        passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+        credentialPublicKey: 'pQECAyYgASFYIJV8MXBhc3N3b3JkLXB1YmxpYy1rZXktc2VlZC0wMDM',
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+        providerIcon: onePasswordProvider.providerIcon,
+        providerName: onePasswordProvider.name,
+        name: onePasswordProvider.name,
+        transports: ['internal'],
+        registeredAt: 1744560000000,
+        counter: 2,
+      },
+    ],
+    challenges: {},
+  };
+}
+
+function getState(): PasskeyGlobalState {
+  if (!globalForPasskeys.__devtoolsTimesPasskeyStore) {
+    globalForPasskeys.__devtoolsTimesPasskeyStore = createInitialState();
+  }
+  return globalForPasskeys.__devtoolsTimesPasskeyStore;
+}
+
+export const db = {
+  async getCurrentUser(): Promise<UserAccountProfile> {
+    return { ...getState().user };
+  },
+
+  async updateUser(
+    userId: string,
+    updates: { name?: string; displayName?: string }
+  ): Promise<UserAccountProfile> {
+    const state = getState();
+    if (state.user.id === userId || state.user.passkeyUserId === userId) {
+      if (typeof updates.name === 'string' && updates.name.trim()) {
+        state.user.name = updates.name.trim();
+      }
+      if (typeof updates.displayName === 'string' && updates.displayName.trim()) {
+        state.user.displayName = updates.displayName.trim();
+      }
+    }
+    return { ...state.user };
+  },
+
+  async findCredentialsByUserId(userId: string): Promise<StoredPasskeyCredential[]> {
+    const state = getState();
+    return state.credentials
+      .filter((cred) => cred.passkeyUserId === userId)
+      .map((cred) => ({ ...cred }));
+  },
+
+  async findCredentialById(id: string): Promise<StoredPasskeyCredential | undefined> {
+    const state = getState();
+    const found = state.credentials.find((cred) => cred.id === id);
+    return found ? { ...found } : undefined;
+  },
+
+  async saveCredential(cred: StoredPasskeyCredential): Promise<StoredPasskeyCredential> {
+    const state = getState();
+    const index = state.credentials.findIndex((c) => c.id === cred.id);
+    if (index >= 0) {
+      state.credentials[index] = { ...cred };
+    } else {
+      state.credentials.unshift({ ...cred });
+    }
+    return { ...cred };
+  },
+
+  async deleteCredential(id: string): Promise<boolean> {
+    const state = getState();
+    const initialLength = state.credentials.length;
+    state.credentials = state.credentials.filter((cred) => cred.id !== id);
+    return state.credentials.length < initialLength;
+  },
+
+  async setChallenge(userId: string, challenge: string): Promise<void> {
+    const state = getState();
+    state.challenges[userId] = challenge;
+  },
+
+  async getChallenge(userId: string): Promise<string | undefined> {
+    const state = getState();
+    return state.challenges[userId];
+  },
+};
