+            <ul
+              className="divide-y divide-gray-200"
+              aria-label="Registered passkeys"
+            >
+              {credentials.map((cred) => {
+                const providerInfo = getProviderFromAaguid(cred.aaguid);
+                const iconSrc = cred.providerIcon || providerInfo.providerIcon;
+                const displayLabel = cred.name || providerInfo.providerName;
+                const isCustomNamed =
+                  cred.name &&
+                  providerInfo.providerName &&
+                  cred.name !== providerInfo.providerName;
+                const isEditing = editingCredentialId === cred.id;
+                const isBusy = busyCredentialId === cred.id;
+
+                return (
+                  <li
+                    key={cred.id}
+                    data-credential-id={cred.id}
+                    className="py-5 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
+                  >
+                    <div className="flex items-start gap-4 flex-1 min-w-0">
+                      {/* Provider Icon derived from AAGUID */}
+                      <div className="w-10 h-10 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0">
+                        {iconSrc ? (
+                          <img
