diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..be73159
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,900 @@
+import React, { useState, useEffect } from 'react';
+import 'webauthn-polyfills';
+import aaguidsData from '../utils/aaguids.json';
+import type {
+  StoredPasskeyCredential,
+  UserAccountProfile,
+  AaguidRegistryEntry,
+} from '../utils/passkeyStore';
+
+const aaguids: Record<string, AaguidRegistryEntry> = aaguidsData;
+
+interface Props {
+  initialUser: UserAccountProfile;
+  initialCredentials: StoredPasskeyCredential[];
+  initialRpId: string;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+function getProviderFromAaguid(aaguid: string): {
+  providerName: string;
+  providerIcon?: string;
+} {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      providerName: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    providerName: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
+
+function formatTimestamp(timestamp?: number): string {
+  if (!timestamp) return 'Never used';
+  return new Date(timestamp).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+async function isPasskeySupported(): Promise<boolean> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !PublicKeyCredential.getClientCapabilities
+  ) {
+    return false;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(
+      capabilities.passkeyPlatformAuthenticator ??
+        capabilities.userVerifyingPlatformAuthenticator
+    );
+  } catch {
+    return false;
+  }
+}
+
+async function syncAcceptedCredentials(
+  rpId: string,
+  userId: string,
+  currentCredentialsList: StoredPasskeyCredential[]
+): Promise<boolean> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !PublicKeyCredential.signalAllAcceptedCredentials
+  ) {
+    return false;
+  }
+
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (
+    !rpId ||
+    !isValidBase64Url(userId) ||
+    !credentialIds.every(isValidBase64Url)
+  ) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return false;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds,
+    });
+    return true;
+  } catch (e) {
+    // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+    return false;
+  }
+}
+
+export default function PasskeyManagement({
+  initialUser,
+  initialCredentials,
+  initialRpId,
+}: Props) {
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  const [credentials, setCredentials] =
+    useState<StoredPasskeyCredential[]>(initialCredentials);
+  const [rpId, setRpId] = useState<string>(initialRpId);
+  const [userId, setUserId] = useState<string>(initialUser.passkeyUserId);
+
+  // User profile display name / username state
+  const [accountName, setAccountName] = useState<string>(initialUser.name);
+  const [accountDisplayName, setAccountDisplayName] = useState<string>(
+    initialUser.displayName
+  );
+  const [profileSaving, setProfileSaving] = useState<boolean>(false);
+
+  // Per-credential rename state
+  const [editingCredentialId, setEditingCredentialId] = useState<string | null>(
+    null
+  );
+  const [editingCredentialName, setEditingCredentialName] =
+    useState<string>('');
+  const [busyCredentialId, setBusyCredentialId] = useState<string | null>(null);
+
+  // Passkey creation capability & status state
+  const [passkeySupported, setPasskeySupported] = useState<boolean>(true);
+  const [creatingPasskey, setCreatingPasskey] = useState<boolean>(false);
+  const [statusBanner, setStatusBanner] = useState<{
+    type: 'success' | 'error' | 'info';
+    message: string;
+  } | null>(null);
+
+  const listFetch = () => fetch(`${baseUrl}api/credentials`);
+  const renameCredentialFetch = (
+    credentialId: string,
+    payload: { name: string }
+  ) =>
+    fetch(`${baseUrl}api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+    });
+  const deleteFetch = (credentialId: string) =>
+    fetch(`${baseUrl}api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'DELETE',
+    });
+  const updateUserFetch = (payload: { name: string; displayName: string }) =>
+    fetch(`${baseUrl}api/user`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+    });
+
+  useEffect(() => {
+    let mounted = true;
+
+    async function loadManagementPanel() {
+      const supported = await isPasskeySupported();
+      if (mounted) {
+        setPasskeySupported(supported);
+      }
+
+      try {
+        const response = await listFetch();
+        if (!response.ok) return;
+        const data = await response.json();
+        if (!mounted) return;
+
+        setRpId(data.rpId);
+        setUserId(data.userId);
+        setCredentials(data.credentials || []);
+        if (data.user) {
+          setAccountName(data.user.name);
+          setAccountDisplayName(data.user.displayName);
+        }
+
+        // Sync accepted credentials on initial load using server-provided rpId and userId
+        await syncAcceptedCredentials(
+          data.rpId,
+          data.userId,
+          data.credentials || []
+        );
+      } catch (e) {
+        console.warn('Failed to load passkey management panel:', e);
+      }
+    }
+
+    loadManagementPanel();
+
+    return () => {
+      mounted = false;
+    };
+  }, []);
+
+  const handleStartRenameCredential = (cred: StoredPasskeyCredential) => {
+    const providerInfo = getProviderFromAaguid(cred.aaguid);
+    setEditingCredentialId(cred.id);
+    setEditingCredentialName(cred.name || providerInfo.providerName);
+    setStatusBanner(null);
+  };
+
+  const handleCancelRenameCredential = () => {
+    setEditingCredentialId(null);
+    setEditingCredentialName('');
+  };
+
+  // Renaming a passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+  const performCredentialRename = async (
+    credentialId: string,
+    newCredentialName: string
+  ) => {
+    const trimmed = newCredentialName.trim();
+    if (!trimmed) {
+      setStatusBanner({
+        type: 'error',
+        message: 'Please enter a valid display name for this passkey.',
+      });
+      return;
+    }
+
+    setBusyCredentialId(credentialId);
+    setStatusBanner(null);
+
+    try {
+      const response = await renameCredentialFetch(credentialId, {
+        name: trimmed,
+      });
+      if (response.ok) {
+        const updatedResponse = await listFetch();
+        const { credentials: updatedCredentials } =
+          await updatedResponse.json();
+        setCredentials(updatedCredentials);
+        setEditingCredentialId(null);
+        setEditingCredentialName('');
+        setStatusBanner({
+          type: 'success',
+          message: `Updated passkey display name to "${trimmed}".`,
+        });
+      } else {
+        setStatusBanner({
+          type: 'error',
+          message: 'Could not update passkey display name.',
+        });
+      }
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Network error while updating passkey display name.',
+      });
+    } finally {
+      setBusyCredentialId(null);
+    }
+  };
+
+  // Deleting a passkey removes it on the server and syncs remaining credentials via signalAllAcceptedCredentials
+  const performDelete = async (credentialId: string, displayName: string) => {
+    setBusyCredentialId(credentialId);
+    setStatusBanner(null);
+
+    try {
+      const response = await deleteFetch(credentialId);
+      if (response.ok) {
+        const updatedResponse = await listFetch();
+        const {
+          rpId: serverRpId,
+          userId: serverUserId,
+          credentials: updatedCredentials,
+        } = await updatedResponse.json();
+
+        setRpId(serverRpId);
+        setUserId(serverUserId);
+        setCredentials(updatedCredentials);
+        if (editingCredentialId === credentialId) {
+          setEditingCredentialId(null);
+        }
+
+        // Sync remaining accepted credentials after deletion
+        await syncAcceptedCredentials(
+          serverRpId,
+          serverUserId,
+          updatedCredentials
+        );
+
+        setStatusBanner({
+          type: 'success',
+          message: `Removed "${displayName}" and synchronized your browser authenticator.`,
+        });
+      } else {
+        setStatusBanner({
+          type: 'error',
+          message: 'Failed to remove passkey.',
+        });
+      }
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Network error while removing passkey.',
+      });
+    } finally {
+      setBusyCredentialId(null);
+    }
+  };
+
+  // Updating the user's account username or displayName triggers signalCurrentUserDetails
+  const performUserRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const updatedName = accountName.trim();
+    const updatedDisplayName = accountDisplayName.trim();
+
+    if (!updatedName || !updatedDisplayName) {
+      setStatusBanner({
+        type: 'error',
+        message: 'Both username and display name are required.',
+      });
+      return;
+    }
+
+    setProfileSaving(true);
+    setStatusBanner(null);
+
+    try {
+      const response = await updateUserFetch({
+        name: updatedName,
+        displayName: updatedDisplayName,
+      });
+
+      if (response.ok) {
+        const { rpId: serverRpId, userId: serverUserId } =
+          await response.json();
+        setRpId(serverRpId);
+        setUserId(serverUserId);
+
+        if (
+          window.PublicKeyCredential &&
+          PublicKeyCredential.signalCurrentUserDetails
+        ) {
+          if (!serverRpId || !isValidBase64Url(serverUserId)) {
+            console.warn(
+              'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+            );
+          } else {
+            try {
+              await PublicKeyCredential.signalCurrentUserDetails({
+                rpId: serverRpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+                userId: serverUserId, // Base64URL-encoded user ID from the server
+                name: updatedName,
+                displayName: updatedDisplayName,
+              });
+            } catch (syncErr) {
+              // Use console.warn instead of console.error for passive background sync
+              console.warn('SignalCurrentUserDetails sync warning:', syncErr);
+            }
+          }
+        }
+
+        setStatusBanner({
+          type: 'success',
+          message:
+            'Reader profile updated and synchronized with your passkey authenticator.',
+        });
+      } else {
+        setStatusBanner({
+          type: 'error',
+          message: 'Failed to update account profile details.',
+        });
+      }
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Network error while updating account profile details.',
+      });
+    } finally {
+      setProfileSaving(false);
+    }
+  };
+
+  // Register a new passkey or security key from the management panel
+  const handleCreatePasskey = async () => {
+    setStatusBanner(null);
+
+    if (
+      !window.PublicKeyCredential ||
+      !PublicKeyCredential.getClientCapabilities
+    ) {
+      setPasskeySupported(false);
+      return;
+    }
+
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    if (
+      !(
+        capabilities.passkeyPlatformAuthenticator ??
+        capabilities.userVerifyingPlatformAuthenticator
+      )
+    ) {
+      setPasskeySupported(false);
+      return;
+    }
+
+    setCreatingPasskey(true);
+
+    try {
+      const optionsResponse = await fetch(
+        `${baseUrl}api/passkeys/register/options`,
+        {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ promotion: false }),
+        }
+      );
+
+      if (!optionsResponse.ok || !PublicKeyCredential.parseCreationOptionsFromJSON) {
+        setStatusBanner({
+          type: 'error',
+          message: 'Could not initialize passkey creation options.',
+        });
+        setCreatingPasskey(false);
+        return;
+      }
+
+      const creationOptionsJSON = await optionsResponse.json();
+      const publicKey =
+        PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      let credential: PublicKeyCredential | null = null;
+      try {
+        credential = (await navigator.credentials.create({
+          publicKey,
+        })) as PublicKeyCredential | null;
+      } catch (err: any) {
+        if (err?.name === 'InvalidStateError') {
+          setStatusBanner({
+            type: 'info',
+            message: 'A passkey already exists on this authenticator for your account.',
+          });
+        } else if (err?.name === 'SecurityError') {
+          setStatusBanner({
+            type: 'error',
+            message: 'Configuration RP ID or Secure Context error.',
+          });
+        } else if (err?.name === 'NotAllowedError') {
+          setStatusBanner({
+            type: 'info',
+            message: 'Passkey registration was cancelled.',
+          });
+        } else if (err?.name === 'AbortError') {
+          setStatusBanner({
+            type: 'info',
+            message: 'The passkey registration operation was aborted.',
+          });
+        }
+        setCreatingPasskey(false);
+        return;
+      }
+
+      if (!credential) {
+        setCreatingPasskey(false);
+        return;
+      }
+
+      // Server Verification phase (Segregated Try/Catch for Signal API)
+      const encodedResponse = credential.toJSON();
+      const optionRpId = publicKey.rp.id || rpId;
+
+      try {
+        const verifyResponse = await fetch(
+          `${baseUrl}api/passkeys/register/verify`,
+          {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encodedResponse),
+          }
+        );
+
+        if (!verifyResponse.ok) {
+          if (
+            window.PublicKeyCredential &&
+            PublicKeyCredential.signalUnknownCredential &&
+            optionRpId &&
+            isValidBase64Url(encodedResponse.id)
+          ) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: optionRpId, // Always use server-provided rp.id; DO NOT use window.location.hostname
+                credentialId: encodedResponse.id,
+              });
+            } catch (sigErr) {
+              console.warn('SignalUnknownCredential sync warning:', sigErr);
+            }
+          }
+          setStatusBanner({
+            type: 'error',
+            message: 'Server could not verify the new passkey.',
+          });
+          setCreatingPasskey(false);
+          return;
+        }
+
+        const updatedResponse = await listFetch();
+        const {
+          rpId: serverRpId,
+          userId: serverUserId,
+          credentials: updatedCredentials,
+        } = await updatedResponse.json();
+
+        setRpId(serverRpId);
+        setUserId(serverUserId);
+        setCredentials(updatedCredentials);
+        await syncAcceptedCredentials(
+          serverRpId,
+          serverUserId,
+          updatedCredentials
+        );
+
+        setStatusBanner({
+          type: 'success',
+          message: 'New passkey registered and synced with your authenticator.',
+        });
+      } catch (serverErr) {
+        console.warn('Server verification network failure:', serverErr);
+        if (
+          window.PublicKeyCredential &&
+          PublicKeyCredential.signalUnknownCredential &&
+          optionRpId &&
+          isValidBase64Url(encodedResponse.id)
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: optionRpId,
+              credentialId: encodedResponse.id,
+            });
+          } catch (sigErr) {
+            console.warn('SignalUnknownCredential sync warning:', sigErr);
+          }
+        }
+        setStatusBanner({
+          type: 'error',
+          message: 'Network failure while verifying your new passkey.',
+        });
+      }
+    } finally {
+      setCreatingPasskey(false);
+    }
+  };
+
+  return (
+    <div className="space-y-8">
+      {statusBanner && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`p-4 rounded-lg border text-sm flex items-center justify-between ${
+            statusBanner.type === 'success'
+              ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
+              : statusBanner.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-900'
+              : 'bg-gray-50 border-gray-200 text-gray-800'
+          }`}
+        >
+          <span>{statusBanner.message}</span>
+          <button
+            type="button"
+            onClick={() => setStatusBanner(null)}
+            className="ml-4 text-xs font-semibold underline hover:no-underline"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Section 1: Reader Profile & Account Display Name (syncs via signalCurrentUserDetails) */}
+      <section
+        aria-labelledby="reader-profile-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
+      >
+        <div className="px-6 py-5 border-b border-gray-200 bg-gray-50/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
+          <div>
+            <h2
+              id="reader-profile-heading"
+              className="text-lg font-bold text-gray-900"
+            >
+              Reader Profile &amp; Identity
+            </h2>
+            <p className="text-sm text-gray-600">
+              Update your reader username or display name. Changes are automatically synchronized with your browser&apos;s passkey authenticator.
+            </p>
+          </div>
