+                            alt={`${providerInfo.providerName} icon`}
+                            className="w-6 h-6 object-contain"
+                          />
+                        ) : (
+                          <svg
+                            className="w-5 h-5 text-gray-500"
+                            fill="none"
+                            stroke="currentColor"
