@@ -0,0 +1,46 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import type { AuthenticatorTransportFuture } from '@simplewebauthn/server';
+import { db, RP_ID, RP_NAME } from '../../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  let isPromotionFlow = false;
+  try {
+    const body = await request.json();
+    isPromotionFlow = Boolean(body?.promotion);
+  } catch {
+    // Default to management flow when body is empty
+  }
+
+  const user = await db.getCurrentUser();
+  const userExistingCredentials = await db.findCredentialsByUserId(user.passkeyUserId);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userID: new Uint8Array(Buffer.from(user.passkeyUserId, 'base64url')),
+    userName: user.name,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: userExistingCredentials.map((cred) => ({
+      id: cred.id,
+      transports: cred.transports as AuthenticatorTransportFuture[],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(isPromotionFlow && { authenticatorAttachment: 'platform' }),
+    },
+  });
+
+  await db.setChallenge(user.passkeyUserId, options.challenge);
+  if (session) {
+    await session.set('passkeyChallenge', options.challenge);
+  }
+
+  return new Response(JSON.stringify(options), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..06870d0
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,101 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import aaguids from '../../../../utils/aaguids.json';
+import { db, RP_ID, type StoredPasskeyCredential } from '../../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await db.getCurrentUser();
+  const sessionChallenge = session ? await session.get('passkeyChallenge') : undefined;
+  const expectedChallenge =
+    (typeof sessionChallenge === 'string' && sessionChallenge) ||
+    (await db.getChallenge(user.passkeyUserId));
+
+  if (!expectedChallenge) {
+    return new Response(
+      JSON.stringify({ error: 'Missing registration challenge in session.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  const body = await request.json();
+  const expectedOrigin = request.headers.get('origin') || url.origin;
+
+  try {
+    const verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin,
+      expectedRPID: RP_ID,
+      // When creation options specified userVerification: "preferred",
+      // requireUserVerification MUST be false to avoid spurious failures
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey verification failed.' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { registrationInfo } = verification;
+    const {
+      aaguid,
+      credential,
+      credentialDeviceType,
+      credentialBackedUp,
+    } = registrationInfo;
+
+    let providerName = 'Unknown passkey provider';
+    let providerIcon: string | undefined = undefined;
+
+    if (aaguid === '00000000-0000-0000-0000-000000000000') {
+      // Zeroed AAGUID: skip registry lookup and use fallback
+      providerName = 'Unknown passkey provider';
+      providerIcon = undefined;
+    } else {
+      const registry = aaguids as Record<
+        string,
+        { name: string; icon_light?: string; icon_dark?: string }
+      >;
+      const provider = registry[aaguid];
+      providerName = provider?.name || 'Unknown passkey provider';
+      providerIcon = provider?.icon_light;
+    }
+
+    const now = Date.now();
+    const storedCredential: StoredPasskeyCredential = {
+      id: credential.id,
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon,
+      providerName,
+      name: providerName,
+      transports: credential.transports || ['internal'],
+      registeredAt: now,
+      lastUsedAt: now,
+      counter: credential.counter,
+    };
+
+    const saved = await db.saveCredential(storedCredential);
+    return new Response(JSON.stringify(saved), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Verification error' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
diff --git a/src/pages/api/user.ts b/src/pages/api/user.ts
