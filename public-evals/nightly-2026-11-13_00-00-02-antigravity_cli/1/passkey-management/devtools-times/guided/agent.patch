+            >
+              {profileSaving ? 'Saving Profile...' : 'Update Profile'}
+            </button>
+          </div>
+        </form>
+      </section>
+
+      {/* Section 2: Passkey Management (syncs via signalAllAcceptedCredentials) */}
+      <section
+        id="passkeys"
+        aria-labelledby="passkey-management-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
+      >
+        <div className="px-6 py-5 border-b border-gray-200 bg-gray-50/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+          <div>
+            <div className="flex items-center gap-2">
