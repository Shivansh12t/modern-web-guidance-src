+                              disabled={isBusy}
+                              className="px-3 py-1.5 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800 disabled:opacity-60"
+                            >
+                              {isBusy ? 'Saving...' : 'Save'}
+                            </button>
+                            <button
+                              type="button"
+                              onClick={handleCancelRenameCredential}
+                              disabled={isBusy}
+                              className="px-3 py-1.5 border border-gray-300 text-gray-700 text-xs font-semibold rounded-md hover:bg-gray-100"
+                            >
+                              Cancel
+                            </button>
+                          </form>
+                        ) : (
+                          <div className="flex flex-wrap items-center gap-2">
+                            <span className="text-base font-bold text-gray-900 truncate">
+                              {displayLabel}
+                            </span>
+                            {isCustomNamed && (
+                              <span className="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded">
+                                {providerInfo.providerName}
+                              </span>
+                            )}
+                            {cred.credentialBackedUp && (
+                              <span className="text-xs font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded">
+                                Synced
+                              </span>
+                            )}
+                          </div>
+                        )}
+
+                        <div className="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
+                          <span>
+                            Registered:{' '}
+                            <time
+                              dateTime={new Date(
+                                cred.registeredAt
+                              ).toISOString()}
+                              className="font-medium text-gray-700"
+                            >
+                              {formatTimestamp(cred.registeredAt)}
+                            </time>
+                          </span>
+                          <span>
+                            Last used:{' '}
+                            {cred.lastUsedAt ? (
+                              <time
+                                dateTime={new Date(
+                                  cred.lastUsedAt
+                                ).toISOString()}
+                                className="font-medium text-gray-700"
+                              >
+                                {formatTimestamp(cred.lastUsedAt)}
+                              </time>
+                            ) : (
+                              <span className="font-medium text-gray-600">
+                                Never used
+                              </span>
+                            )}
+                          </span>
+                        </div>
+                      </div>
+                    </div>
+
+                    {/* Per-Item Action Buttons: Rename & Delete */}
+                    <div className="flex items-center gap-2 self-end sm:self-center">
+                      {!isEditing && (
+                        <button
+                          type="button"
+                          onClick={() => handleStartRenameCredential(cred)}
+                          disabled={isBusy}
+                          aria-label={`Rename ${displayLabel}`}
+                          className="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-md text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-60"
+                        >
+                          Rename
+                        </button>
+                      )}
+                      <button
+                        type="button"
+                        onClick={() => performDelete(cred.id, displayLabel)}
+                        disabled={isBusy}
+                        aria-label={`Remove ${displayLabel}`}
+                        className="inline-flex items-center px-3 py-1.5 border border-red-200 rounded-md text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 disabled:opacity-60"
+                      >
+                        {isBusy && !isEditing ? 'Removing...' : 'Delete'}
+                      </button>
+                    </div>
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+        </div>
+      </section>
+    </div>
+  );
+}
