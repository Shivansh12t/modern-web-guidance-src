+          ) : (
+            <div className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-md px-3 py-2 max-w-xs">
+              Passkeys are not supported on this device. We recommend enabling a standard authenticator app (TOTP) for multi-factor security.
+            </div>
+          )}
+        </div>
+
+        <div className="p-6">
+          {credentials.length === 0 ? (
+            <div className="text-center py-10 px-4 border border-dashed border-gray-300 rounded-lg bg-gray-50">
+              <p className="text-base font-semibold text-gray-800">
