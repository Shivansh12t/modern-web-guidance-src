+        name: 'alex.carter@example.com',
+        displayName: 'Alex Carter'
+      };
+
+      const defaultPasskeys = [
+        {
+          id: 'passkey-1',
+          credentialId: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+          name: 'MacBook Pro (iCloud Keychain)',
+          provider: 'iCloud Keychain',
+          createdAt: '2026-08-14',
