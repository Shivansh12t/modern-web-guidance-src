+            } else if (created && created.id) {
+              newCredentialId = created.id;
+            }
+          } catch (err) {
+            // Fall back to simulated passkey registration if user cancels or environment lacks authenticator
+            console.warn('WebAuthn create fallback:', err);
+          }
+        }
