+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_passkeys_v1';
+      const USER_STORAGE_KEY = 'daily_grind_user_v1';
+
+      const defaultUser = {
+        id: 'dXNlcl9hbGV4X2NhcnRlcl8wMQ', // Base64URL-encoded userId
+        name: 'alex.carter@example.com',
+        displayName: 'Alex Carter'
+      };
+
+      const defaultPasskeys = [
+        {
+          id: 'passkey-1',
+          credentialId: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+          name: 'MacBook Pro (iCloud Keychain)',
+          provider: 'iCloud Keychain',
+          createdAt: '2026-08-14',
+          lastUsed: 'Today, 8:15 AM',
+          backedUp: true
+        },
+        {
+          id: 'passkey-2',
+          credentialId: 'k9LmP2xQr8StV4wYz1AbC3dEf6GhI7jKlM',
+          name: 'Pixel 9 Pro (Google Password Manager)',
+          provider: 'Google Password Manager',
+          createdAt: '2026-09-22',
+          lastUsed: 'Nov 10, 2026',
+          backedUp: true
+        },
+        {
+          id: 'passkey-3',
+          credentialId: 'z7YxW6vU5tS4rQ3pO2nM1lK0jI9hG8fE7d',
+          name: 'YubiKey 5C NFC',
+          provider: 'Hardware Security Key',
+          createdAt: '2026-06-03',
+          lastUsed: 'Oct 19, 2026',
+          backedUp: false
+        }
+      ];
+
+      function loadUser() {
+        try {
+          const saved = localStorage.getItem(USER_STORAGE_KEY);
+          if (saved) {
+            return JSON.parse(saved);
+          }
+        } catch (e) {
+          // ignore storage error
+        }
+        return { ...defaultUser };
+      }
+
+      function saveUser(user) {
+        try {
+          localStorage.setItem(USER_STORAGE_KEY, JSON.stringify(user));
+        } catch (e) {
+          // ignore storage error
+        }
+      }
+
+      function loadPasskeys() {
+        try {
+          const saved = localStorage.getItem(STORAGE_KEY);
+          if (saved) {
+            const parsed = JSON.parse(saved);
+            if (Array.isArray(parsed)) {
+              return parsed;
+            }
+          }
+        } catch (e) {
+          // ignore storage error
+        }
+        return defaultPasskeys.map(k => ({ ...k }));
+      }
+
+      function savePasskeys(keys) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(keys));
+        } catch (e) {
+          // ignore storage error
+        }
+      }
+
+      let currentUser = loadUser();
+      let passkeys = loadPasskeys();
+      let editingCredentialId = null;
+
+      const passkeyListEl = document.getElementById('passkey-list');
+      const emptyStateEl = document.getElementById('passkey-empty-state');
+      const syncStatusTextEl = document.getElementById('sync-status-text');
+      const passkeyCountBadgeEl = document.getElementById('passkey-count-badge');
+      const feedbackEl = document.getElementById('passkey-feedback');
+
+      function getRpId() {
+        return window.location.hostname || 'localhost';
+      }
+
+      function showFeedback(message) {
+        if (!feedbackEl) return;
+        feedbackEl.textContent = message;
+        feedbackEl.classList.add('visible');
+      }
+
+      // Synchronize accepted credentials with the browser's authenticator via WebAuthn Signal API
+      async function syncAcceptedCredentialsWithAuthenticator(reason) {
+        const rpId = getRpId();
+        const allAcceptedCredentialIds = passkeys.map(pk => pk.credentialId);
+
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalAllAcceptedCredentials({
+              rpId: rpId,
+              userId: currentUser.id,
+              allAcceptedCredentialIds: allAcceptedCredentialIds
+            });
+            if (syncStatusTextEl) {
+              syncStatusTextEl.textContent = '✓ Browser authenticator synced (' + allAcceptedCredentialIds.length + ' accepted credentials)';
+            }
+            return true;
+          } catch (err) {
+            console.warn('Failed to signal accepted credentials:', err);
+          }
+        }
+
+        if (syncStatusTextEl) {
+          syncStatusTextEl.textContent = '✓ Registered passkeys ready (' + allAcceptedCredentialIds.length + ' active)';
+        }
+        return false;
+      }
+
+      // Signal an unknown/deleted credential if supported
+      async function signalDeletedCredential(credentialId) {
+        const rpId = getRpId();
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId,
+              credentialId: credentialId
+            });
+          } catch (err) {
+            console.warn('Failed to signal unknown credential:', err);
+          }
+        }
+        await syncAcceptedCredentialsWithAuthenticator('delete');
+      }
+
+      // Signal updated user details to the authenticator
+      async function signalUserDetailsToAuthenticator() {
+        const rpId = getRpId();
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: rpId,
+              userId: currentUser.id,
+              name: currentUser.name,
+              displayName: currentUser.displayName
+            });
+          } catch (err) {
+            console.warn('Failed to signal current user details:', err);
+          }
+        }
+      }
+
+      function renderPasskeys() {
+        if (!passkeyListEl) return;
+        passkeyListEl.innerHTML = '';
+
+        const count = passkeys.length;
+        if (passkeyCountBadgeEl) {
+          passkeyCountBadgeEl.textContent = count + (count === 1 ? ' registered passkey' : ' registered passkeys');
+        }
+
+        if (count === 0) {
+          passkeyListEl.style.display = 'none';
+          if (emptyStateEl) emptyStateEl.style.display = 'block';
+          return;
+        }
+
+        passkeyListEl.style.display = 'flex';
+        if (emptyStateEl) emptyStateEl.style.display = 'none';
+
+        passkeys.forEach((pk) => {
+          const li = document.createElement('li');
+          li.className = 'passkey-item';
+          li.dataset.credentialId = pk.credentialId;
+
+          const isEditing = editingCredentialId === pk.credentialId;
+
+          const infoDiv = document.createElement('div');
+          infoDiv.className = 'passkey-info';
+
+          const iconDiv = document.createElement('div');
+          iconDiv.className = 'passkey-icon';
+          iconDiv.setAttribute('aria-hidden', 'true');
+          iconDiv.textContent = '🔑';
+
+          const detailsDiv = document.createElement('div');
+          detailsDiv.className = 'passkey-details';
+
+          if (isEditing) {
+            const form = document.createElement('form');
+            form.className = 'rename-form';
+            form.setAttribute('aria-label', 'Rename passkey');
+
+            const input = document.createElement('input');
+            input.type = 'text';
+            input.className = 'rename-input';
+            input.value = pk.name;
+            input.name = 'passkeyName';
+            input.required = true;
+            input.setAttribute('aria-label', 'Passkey name');
+
+            const saveBtn = document.createElement('button');
+            saveBtn.type = 'submit';
+            saveBtn.className = 'btn btn-sm';
+            saveBtn.textContent = 'Save';
+
+            const cancelBtn = document.createElement('button');
+            cancelBtn.type = 'button';
+            cancelBtn.className = 'btn btn-outline btn-sm';
+            cancelBtn.textContent = 'Cancel';
+            cancelBtn.addEventListener('click', () => {
+              editingCredentialId = null;
+              renderPasskeys();
+            });
+
+            form.addEventListener('submit', (e) => {
+              e.preventDefault();
+              const newName = input.value.trim();
+              if (newName) {
+                renamePasskey(pk.credentialId, newName);
+              }
+            });
+
+            form.appendChild(input);
+            form.appendChild(saveBtn);
+            form.appendChild(cancelBtn);
+            detailsDiv.appendChild(form);
+
+            setTimeout(() => input.focus(), 0);
+          } else {
+            const nameRow = document.createElement('div');
+            nameRow.className = 'passkey-name-row';
+
+            const nameSpan = document.createElement('span');
+            nameSpan.className = 'passkey-name';
+            nameSpan.textContent = pk.name;
+
+            const tagSpan = document.createElement('span');
+            tagSpan.className = 'passkey-tag';
+            tagSpan.textContent = pk.backedUp ? 'Synced' : 'Device-bound';
+
+            nameRow.appendChild(nameSpan);
+            nameRow.appendChild(tagSpan);
+            detailsDiv.appendChild(nameRow);
+          }
+
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'passkey-meta';
+
+          const createdSpan = document.createElement('span');
+          createdSpan.textContent = 'Created: ' + pk.createdAt;
+
+          const usedSpan = document.createElement('span');
+          usedSpan.textContent = 'Last used: ' + pk.lastUsed;
+
+          const idSpan = document.createElement('span');
+          idSpan.className = 'passkey-id';
+          idSpan.title = pk.credentialId;
+          idSpan.textContent = 'ID: ' + pk.credentialId.slice(0, 10) + '…';
+
+          metaDiv.appendChild(createdSpan);
+          metaDiv.appendChild(usedSpan);
+          metaDiv.appendChild(idSpan);
+          detailsDiv.appendChild(metaDiv);
+
+          infoDiv.appendChild(iconDiv);
+          infoDiv.appendChild(detailsDiv);
+
+          const actionsDiv = document.createElement('div');
+          actionsDiv.className = 'passkey-actions';
+
+          if (!isEditing) {
+            const renameBtn = document.createElement('button');
+            renameBtn.type = 'button';
+            renameBtn.className = 'btn btn-outline btn-sm rename-passkey-btn';
+            renameBtn.textContent = 'Rename';
+            renameBtn.setAttribute('aria-label', 'Rename ' + pk.name);
+            renameBtn.addEventListener('click', () => {
+              editingCredentialId = pk.credentialId;
+              renderPasskeys();
+            });
+
+            const deleteBtn = document.createElement('button');
+            deleteBtn.type = 'button';
+            deleteBtn.className = 'btn btn-danger btn-sm delete-passkey-btn';
+            deleteBtn.textContent = 'Delete';
+            deleteBtn.setAttribute('aria-label', 'Delete ' + pk.name);
+            deleteBtn.addEventListener('click', () => {
+              deletePasskey(pk.credentialId);
+            });
+
+            actionsDiv.appendChild(renameBtn);
+            actionsDiv.appendChild(deleteBtn);
+          }
+
+          li.appendChild(infoDiv);
+          li.appendChild(actionsDiv);
+          passkeyListEl.appendChild(li);
+        });
+      }
+
+      function renamePasskey(credentialId, newName) {
+        const target = passkeys.find(pk => pk.credentialId === credentialId);
+        if (!target) return;
+        const oldName = target.name;
+        target.name = newName;
+        editingCredentialId = null;
+        savePasskeys(passkeys);
+        renderPasskeys();
+        showFeedback('Renamed passkey "' + oldName + '" to "' + newName + '".');
+      }
+
+      async function deletePasskey(credentialId) {
+        const target = passkeys.find(pk => pk.credentialId === credentialId);
+        if (!target) return;
+        const removedName = target.name;
+        passkeys = passkeys.filter(pk => pk.credentialId !== credentialId);
+        if (editingCredentialId === credentialId) {
+          editingCredentialId = null;
+        }
+        savePasskeys(passkeys);
+        renderPasskeys();
+        await signalDeletedCredential(credentialId);
+        showFeedback('Deleted passkey "' + removedName + '" and synced browser authenticator.');
+      }
+
+      function toBase64Url(uint8) {
+        let binary = '';
+        for (let i = 0; i < uint8.byteLength; i++) {
+          binary += String.fromCharCode(uint8[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function fromBase64Url(base64url) {
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const raw = atob(base64);
+        const output = new Uint8Array(raw.length);
+        for (let i = 0; i < raw.length; i++) {
+          output[i] = raw.charCodeAt(i);
+        }
+        return output;
+      }
+
+      async function registerNewPasskey() {
+        let newCredentialId = 'cred_' + Math.random().toString(36).substring(2, 12) + 'x9A';
+        if (
+          window.navigator &&
+          navigator.credentials &&
+          typeof navigator.credentials.create === 'function' &&
+          typeof PublicKeyCredential !== 'undefined'
+        ) {
+          try {
+            const challenge = new Uint8Array(32);
+            if (window.crypto && crypto.getRandomValues) {
+              crypto.getRandomValues(challenge);
+            }
+            const created = await navigator.credentials.create({
+              publicKey: {
+                challenge: challenge,
+                rp: {
+                  name: 'The Daily Grind',
+                  id: getRpId()
+                },
+                user: {
+                  id: fromBase64Url(currentUser.id),
+                  name: currentUser.name,
+                  displayName: currentUser.displayName
+                },
+                pubKeyCredParams: [
+                  { type: 'public-key', alg: -7 },
+                  { type: 'public-key', alg: -257 }
+                ],
+                authenticatorSelection: {
+                  residentKey: 'required',
+                  userVerification: 'preferred'
+                },
+                excludeCredentials: passkeys.map(pk => ({
+                  id: fromBase64Url(pk.credentialId),
+                  type: 'public-key'
+                }))
+              }
+            });
+            if (created && created.rawId) {
+              newCredentialId = toBase64Url(new Uint8Array(created.rawId));
+            } else if (created && created.id) {
+              newCredentialId = created.id;
+            }
+          } catch (err) {
+            // Fall back to simulated passkey registration if user cancels or environment lacks authenticator
+            console.warn('WebAuthn create fallback:', err);
+          }
+        }
+
+        const today = new Date().toISOString().slice(0, 10);
+        const newKey = {
+          id: 'passkey-' + Date.now(),
+          credentialId: newCredentialId,
+          name: 'Passkey (' + today + ')',
+          provider: 'Platform Authenticator',
+          createdAt: today,
+          lastUsed: 'Just now',
+          backedUp: true
+        };
+
+        passkeys.push(newKey);
+        savePasskeys(passkeys);
+        renderPasskeys();
+        await syncAcceptedCredentialsWithAuthenticator('register');
+        showFeedback('Added new passkey "' + newKey.name + '" and synced browser authenticator.');
+      }
+
+      function renderUserProfile() {
+        const displayInput = document.getElementById('user-display-name');
+        const nameInput = document.getElementById('user-name');
+        const summaryDisplay = document.getElementById('profile-display-summary');
+        const summaryEmail = document.getElementById('profile-email-summary');
+        const avatarEl = document.getElementById('user-avatar');
+
+        if (displayInput) displayInput.value = currentUser.displayName;
+        if (nameInput) nameInput.value = currentUser.name;
+        if (summaryDisplay) summaryDisplay.textContent = currentUser.displayName;
+        if (summaryEmail) summaryEmail.textContent = currentUser.name;
+        if (avatarEl && currentUser.displayName) {
+          const initials = currentUser.displayName
+            .split(/\s+/)
+            .map(part => part[0])
+            .join('')
+            .toUpperCase()
+            .slice(0, 2);
+          avatarEl.textContent = initials || 'DG';
+        }
+      }
+
+      const profileForm = document.getElementById('profile-form');
+      if (profileForm) {
+        profileForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const displayInput = document.getElementById('user-display-name');
+          const nameInput = document.getElementById('user-name');
+          if (displayInput && nameInput) {
+            currentUser.displayName = displayInput.value.trim() || currentUser.displayName;
+            currentUser.name = nameInput.value.trim() || currentUser.name;
+            saveUser(currentUser);
+            renderUserProfile();
+            await signalUserDetailsToAuthenticator();
+            showFeedback('Updated profile details and notified browser authenticator.');
+          }
+        });
+      }
+
+      const createBtn = document.getElementById('create-passkey-btn');
+      if (createBtn) {
+        createBtn.addEventListener('click', () => {
+          registerNewPasskey();
+        });
+      }
+
+      const emptyAddBtn = document.getElementById('empty-add-passkey-btn');
+      if (emptyAddBtn) {
+        emptyAddBtn.addEventListener('click', () => {
+          registerNewPasskey();
+        });
+      }
+
+      // Initialize UI and synchronize browser authenticator on load
+      renderUserProfile();
+      renderPasskeys();
+      syncAcceptedCredentialsWithAuthenticator('init');
+
+      // Expose helper API on window for programmatic access / integration
+      window.dailyGrindPasskeys = {
+        getPasskeys: () => passkeys.slice(),
+        renamePasskey,
+        deletePasskey,
+        registerNewPasskey,
+        syncAcceptedCredentialsWithAuthenticator
+      };
+    })();
+  </script>
+
+</body>
+
+</html>
