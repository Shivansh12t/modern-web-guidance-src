+          <span style="font-size: 0.8rem;" id="passkey-count-badge">3 registered passkeys</span>
+        </div>
+
+        <ul class="passkey-list" id="passkey-list" aria-label="Registered Passkeys">
+          <!-- Populated by JavaScript -->
+        </ul>
+
+        <div class="empty-state" id="passkey-empty-state" style="display: none;">
+          <p>You have no registered passkeys on your account.</p>
+          <button type="button" class="btn btn-outline" id="empty-add-passkey-btn">Register a Passkey</button>
+        </div>
+
+        <div class="toast-status" id="passkey-feedback" role="alert" aria-live="assertive"></div>
+      </section>
