+
+      function loadUser() {
+        try {
+          const saved = localStorage.getItem(USER_STORAGE_KEY);
+          if (saved) {
+            return JSON.parse(saved);
+          }
+        } catch (e) {
+          // ignore storage error
+        }
+        return { ...defaultUser };
+      }
+
+      function saveUser(user) {
+        try {
+          localStorage.setItem(USER_STORAGE_KEY, JSON.stringify(user));
+        } catch (e) {
+          // ignore storage error
+        }
+      }
+
+      function loadPasskeys() {
+        try {
+          const saved = localStorage.getItem(STORAGE_KEY);
+          if (saved) {
+            const parsed = JSON.parse(saved);
+            if (Array.isArray(parsed)) {
+              return parsed;
+            }
+          }
+        } catch (e) {
+          // ignore storage error
+        }
+        return defaultPasskeys.map(k => ({ ...k }));
+      }
+
+      function savePasskeys(keys) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(keys));
+        } catch (e) {
+          // ignore storage error
+        }
+      }
+
+      let currentUser = loadUser();
+      let passkeys = loadPasskeys();
+      let editingCredentialId = null;
+
+      const passkeyListEl = document.getElementById('passkey-list');
+      const emptyStateEl = document.getElementById('passkey-empty-state');
+      const syncStatusTextEl = document.getElementById('sync-status-text');
+      const passkeyCountBadgeEl = document.getElementById('passkey-count-badge');
+      const feedbackEl = document.getElementById('passkey-feedback');
+
+      function getRpId() {
+        return window.location.hostname || 'localhost';
+      }
+
+      function showFeedback(message) {
+        if (!feedbackEl) return;
+        feedbackEl.textContent = message;
+        feedbackEl.classList.add('visible');
+      }
+
+      // Synchronize accepted credentials with the browser's authenticator via WebAuthn Signal API
+      async function syncAcceptedCredentialsWithAuthenticator(reason) {
+        const rpId = getRpId();
+        const allAcceptedCredentialIds = passkeys.map(pk => pk.credentialId);
+
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalAllAcceptedCredentials({
+              rpId: rpId,
+              userId: currentUser.id,
+              allAcceptedCredentialIds: allAcceptedCredentialIds
+            });
+            if (syncStatusTextEl) {
+              syncStatusTextEl.textContent = '✓ Browser authenticator synced (' + allAcceptedCredentialIds.length + ' accepted credentials)';
+            }
+            return true;
+          } catch (err) {
+            console.warn('Failed to signal accepted credentials:', err);
+          }
+        }
+
+        if (syncStatusTextEl) {
+          syncStatusTextEl.textContent = '✓ Registered passkeys ready (' + allAcceptedCredentialIds.length + ' active)';
+        }
+        return false;
+      }
+
+      // Signal an unknown/deleted credential if supported
+      async function signalDeletedCredential(credentialId) {
+        const rpId = getRpId();
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId,
+              credentialId: credentialId
+            });
+          } catch (err) {
+            console.warn('Failed to signal unknown credential:', err);
+          }
+        }
+        await syncAcceptedCredentialsWithAuthenticator('delete');
+      }
+
+      // Signal updated user details to the authenticator
+      async function signalUserDetailsToAuthenticator() {
+        const rpId = getRpId();
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: rpId,
+              userId: currentUser.id,
+              name: currentUser.name,
+              displayName: currentUser.displayName
+            });
+          } catch (err) {
+            console.warn('Failed to signal current user details:', err);
+          }
+        }
+      }
+
+      function renderPasskeys() {
+        if (!passkeyListEl) return;
+        passkeyListEl.innerHTML = '';
+
+        const count = passkeys.length;
+        if (passkeyCountBadgeEl) {
+          passkeyCountBadgeEl.textContent = count + (count === 1 ? ' registered passkey' : ' registered passkeys');
+        }
+
+        if (count === 0) {
+          passkeyListEl.style.display = 'none';
+          if (emptyStateEl) emptyStateEl.style.display = 'block';
+          return;
+        }
+
+        passkeyListEl.style.display = 'flex';
+        if (emptyStateEl) emptyStateEl.style.display = 'none';
+
+        passkeys.forEach((pk) => {
