+  <script>
+    function base64UrlToUint8Array(base64Url) {
+      if (base64Url instanceof Uint8Array) return base64Url;
+      if (base64Url instanceof ArrayBuffer) return new Uint8Array(base64Url);
+      if (Array.isArray(base64Url)) return new Uint8Array(base64Url);
+      const padding = '='.repeat((4 - (base64Url.length % 4)) % 4);
+      const base64 = (base64Url + padding).replace(/-/g, '+').replace(/_/g, '/');
+      const rawData = window.atob(base64);
+      const outputArray = new Uint8Array(rawData.length);
+      for (let i = 0; i < rawData.length; ++i) {
+        outputArray[i] = rawData.charCodeAt(i);
+      }
+      return outputArray;
+    }
+
+    function bufferToBase64Url(buffer) {
+      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return window.btoa(binary)
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=+$/, '');
+    }
+
+    function parseRequestOptions(rawOptions) {
+      const options = rawOptions && rawOptions.publicKey ? { ...rawOptions.publicKey } : { ...rawOptions };
+
+      if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+        try {
+          const parsed = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+          if (!parsed.userVerification) {
+            parsed.userVerification = 'required';
+          }
+          return parsed;
+        } catch (_) {
+          // Fall back to manual decoding if options are not strict JSON format
+        }
+      }
+
+      const publicKey = {
+        ...options,
+        challenge: base64UrlToUint8Array(options.challenge),
+        userVerification: options.userVerification || 'required',
+      };
+
+      if (Array.isArray(options.allowCredentials)) {
+        publicKey.allowCredentials = options.allowCredentials.map((cred) => ({
+          ...cred,
+          type: cred.type || 'public-key',
+          id: base64UrlToUint8Array(cred.id),
+        }));
+      }
+
+      return publicKey;
+    }
+
+    function serializeAssertionCredential(credential) {
+      if (credential && typeof credential.toJSON === 'function') {
+        try {
+          return credential.toJSON();
+        } catch (_) {
+          // Fall back to manual serialization
+        }
+      }
+
+      const response = credential.response;
+      return {
+        id: credential.id,
+        rawId: bufferToBase64Url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment || null,
+        clientExtensionResults:
+          typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : {},
+        response: {
+          authenticatorData: bufferToBase64Url(response.authenticatorData),
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          signature: bufferToBase64Url(response.signature),
+          userHandle: response.userHandle ? bufferToBase64Url(response.userHandle) : null,
+        },
+      };
+    }
+
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    if (reauthButton) {
+      reauthButton.addEventListener('click', async () => {
+        if (reauthStatus) {
+          reauthStatus.textContent = 'Verifying identity...';
+        }
+        try {
+          const optionsRes = await fetch('/api/reauth/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+          });
+
+          if (!optionsRes.ok) {
+            throw new Error('Failed to fetch re-authentication options');
+          }
+
+          const rawOptions = await optionsRes.json();
+          const publicKey = parseRequestOptions(rawOptions);
+
+          const credential = await navigator.credentials.get({ publicKey });
+          if (!credential) {
+            throw new Error('No credential returned from authenticator');
+          }
+
+          const payload = serializeAssertionCredential(credential);
+
+          const verifyRes = await fetch('/api/reauth/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+            body: JSON.stringify(payload),
+          });
+
+          if (!verifyRes.ok) {
+            throw new Error('Re-authentication verification failed');
+          }
+
+          if (reauthStatus) {
+            reauthStatus.textContent = 'Identity verified.';
+          }
+        } catch (err) {
+          if (reauthStatus) {
+            reauthStatus.textContent = err && err.message ? err.message : 'Re-authentication failed.';
+          }
+        }
+      });
+    }
+  </script>
+
