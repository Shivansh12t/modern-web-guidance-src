+  <script>
+    const FALLBACK_ASYNC_NOTE =
+      "Fallback checks using document.visibilityState and visibilitychange are unreliable for async scripts: the tab may have opened in the background and been foregrounded before the script executed, causing document.visibilityState to synchronously read as 'visible' and miss the initial hidden state, while event listener timestamps via performance.now() lack the precision of the Performance API's VisibilityStateEntry.startTime.";
+
+    /**
+     * Accurately determines visibility state history using the Performance API (VisibilityStateEntry).
+     */
+    function getVisibilityInfo() {
+      const entries = performance.getEntriesByType('visibility-state');
+
+      if (entries.length > 0) {
+        const firstEntry = entries[0];
+        const initiallyBackgrounded = firstEntry.name === 'hidden';
+
+        let timeBackgrounded = null;
+        for (const entry of entries) {
+          if (entry.name === 'hidden') {
+            timeBackgrounded = entry.startTime;
+            break;
+          }
+        }
+
+        const timestampMs = timeBackgrounded !== null ? timeBackgrounded : firstEntry.startTime;
+
+        return {
+          initiallyBackgrounded,
+          backgrounded: initiallyBackgrounded,
+          timeBackgrounded,
+          timestampMs,
+          timestamp: timestampMs,
+          source: 'VisibilityStateEntry',
+          note: FALLBACK_ASYNC_NOTE
+        };
+      }
+
+      return getFallbackVisibilityInfo();
+    }
+
+    /**
+     * Fallback implementation using document.visibilityState.
+     * Note: This approach is prone to race conditions if the script loads asynchronously,
+     * as the user may foreground the tab before the script executes.
+     */
+    function getFallbackVisibilityInfo() {
+      let initiallyBackgrounded = document.visibilityState === 'hidden';
+      let timeBackgrounded = initiallyBackgrounded ? 0 : null;
+
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden' && timeBackgrounded === null) {
+          timeBackgrounded = performance.now();
+        }
+      });
+
+      return {
+        get initiallyBackgrounded() {
+          return initiallyBackgrounded;
+        },
+        get backgrounded() {
+          return initiallyBackgrounded;
+        },
+        get timeBackgrounded() {
+          return timeBackgrounded;
+        },
+        get timestampMs() {
+          return timeBackgrounded !== null ? timeBackgrounded : 0;
+        },
+        get timestamp() {
+          return timeBackgrounded !== null ? timeBackgrounded : 0;
+        },
+        source: 'document.visibilityState (fallback)',
+        note: FALLBACK_ASYNC_NOTE
+      };
+    }
+
+    let visibilityReport;
+    if ('VisibilityStateEntry' in window) {
+      visibilityReport = getVisibilityInfo();
+    } else {
+      visibilityReport = getFallbackVisibilityInfo();
+    }
+
+    console.log({
+      initiallyBackgrounded: visibilityReport.initiallyBackgrounded,
+      backgrounded: visibilityReport.backgrounded,
+      timeBackgrounded: visibilityReport.timeBackgrounded,
+      timestampMs: visibilityReport.timestampMs,
+      timestamp: visibilityReport.timestamp,
+      source: visibilityReport.source,
+      note: visibilityReport.note
+    });
+  </script>
