+  <script>
+    (function checkInitialBackgroundLoad() {
+      const visibilityEntries =
+        typeof performance !== 'undefined' &&
+        typeof performance.getEntriesByType === 'function'
+          ? performance.getEntriesByType('visibility-state')
+          : [];
+
+      const hasVisibilityEntries = visibilityEntries && visibilityEntries.length > 0;
+      const initialEntry = hasVisibilityEntries ? visibilityEntries[0] : null;
+
+      const backgrounded = Boolean(
+        initialEntry
+          ? initialEntry.name === 'hidden'
+          : document.visibilityState === 'hidden' || document.hidden
+      );
+
+      const timestamp = initialEntry
+        ? initialEntry.startTime
+        : typeof performance !== 'undefined' && typeof performance.now === 'function'
+          ? performance.now()
+          : Date.now();
+
+      const note = hasVisibilityEntries
+        ? 'Checked initial load state via performance.getEntriesByType("visibility-state"). Note: older fallback checks (document.visibilityState / document.hidden) only capture current state at execution time and are unreliable for async scripts.'
+        : 'Fallback check (document.visibilityState / document.hidden) used; older fallback checks are unreliable for async scripts because tab visibility may change before the script runs.';
+
+      console.log({
+        backgrounded,
+        timestamp,
+        note,
+      });
+    })();
+  </script>
+
 </body>
 
