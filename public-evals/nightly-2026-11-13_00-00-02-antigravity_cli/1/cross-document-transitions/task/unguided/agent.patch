+          }
+          return;
+        }
+
+        let dir = null;
+        try {
+          dir = sessionStorage.getItem('transitionDirection');
+          sessionStorage.removeItem('transitionDirection');
+        } catch (err) {}
+
+        if (!dir && window.navigation && window.navigation.activation) {
