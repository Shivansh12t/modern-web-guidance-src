+  <script>
+    (function () {
+      const PAGE_ORDER = {
+        '/': 1,
+        '/index.html': 1,
+        '/page2.html': 2,
+        '/page3.html': 3
+      };
+
+      function getPageIndex(urlStr) {
+        try {
+          const url = new URL(urlStr, window.location.origin);
+          const pageParam = url.searchParams.get('page');
+          if (pageParam) {
+            const parsed = parseInt(pageParam, 10);
+            if (!isNaN(parsed)) return parsed;
+          }
+          return PAGE_ORDER[url.pathname] || 1;
+        } catch (err) {
+          return 1;
+        }
+      }
+
+      function inferDirection(fromUrl, toUrl) {
+        if (!fromUrl || !toUrl) return null;
+        const fromIdx = getPageIndex(fromUrl);
+        const toIdx = getPageIndex(toUrl);
+        if (fromIdx === toIdx) return null;
+        const diff = (toIdx - fromIdx + 3) % 3;
+        return diff === 1 ? 'next' : 'previous';
+      }
+
+      function applyDirection(direction, viewTransition) {
+        const dir = direction === 'previous' ? 'previous' : 'next';
+        document.documentElement.dataset.direction = dir;
+        document.documentElement.setAttribute('data-transition', dir);
+
+        if (viewTransition && viewTransition.types) {
+          if (typeof viewTransition.types.clear === 'function') {
+            viewTransition.types.clear();
+          }
+          if (dir === 'next') {
+            viewTransition.types.add('next');
+            viewTransition.types.add('forward');
+            viewTransition.types.add('forwards');
+            viewTransition.types.add('slide-left');
+          } else {
+            viewTransition.types.add('previous');
+            viewTransition.types.add('prev');
+            viewTransition.types.add('back');
+            viewTransition.types.add('backward');
+            viewTransition.types.add('backwards');
+            viewTransition.types.add('slide-right');
+          }
+        }
+      }
+
+      try {
+        const savedDir = sessionStorage.getItem('transitionDirection');
+        if (savedDir) {
+          applyDirection(savedDir, null);
+        }
+      } catch (err) {}
+
+      document.addEventListener('click', function (e) {
+        const link = e.target && e.target.closest ? e.target.closest('a#previous, a#next') : null;
+        if (!link) return;
+        const dir = link.id === 'previous' ? 'previous' : 'next';
+        try {
+          sessionStorage.setItem('transitionDirection', dir);
+        } catch (err) {}
+        applyDirection(dir, null);
+      }, true);
+
+      window.addEventListener('pageswap', function (e) {
+        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          if (e.viewTransition && typeof e.viewTransition.skipTransition === 'function') {
+            e.viewTransition.skipTransition();
+          }
+          return;
+        }
+
+        let dir = null;
+        try {
+          dir = sessionStorage.getItem('transitionDirection');
+        } catch (err) {}
+
+        if (!dir && e.activation) {
+          const fromUrl = e.activation.from && e.activation.from.url;
+          const toUrl = e.activation.entry && e.activation.entry.url;
+          dir = inferDirection(fromUrl, toUrl);
+        }
+
+        dir = dir || document.documentElement.dataset.direction || 'next';
+        try {
+          sessionStorage.setItem('transitionDirection', dir);
+        } catch (err) {}
+        applyDirection(dir, e.viewTransition);
+      });
+
