+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const slides = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('#gallery-thumbnails button'));
+      const snapStatusEl = document.getElementById('snap-status');
+
+      let activeIndex = 0;
+      let pendingIndex = null;
+      let hasNativePendingThisGesture = false;
+      let clickedTargetIndex = null;
+      let scrollSettleTimer = null;
+
+      function detectScrollSnapSupport() {
+        const winSupport =
+          'onscrollsnapchange' in window &&
+          window.onscrollsnapchange !== undefined &&
+          'onscrollsnapchanging' in window &&
+          window.onscrollsnapchanging !== undefined;
+        const elSupport =
+          'onscrollsnapchange' in gallery &&
+          gallery.onscrollsnapchange !== undefined &&
+          'onscrollsnapchanging' in gallery &&
+          gallery.onscrollsnapchanging !== undefined;
+        return Boolean(winSupport && elSupport);
+      }
+
+      function updateFallbackStatus() {
+        const supported = detectScrollSnapSupport();
+        gallery.dataset.snapSupport = supported ? 'native' : 'fallback';
+        gallery.dataset.fallback = supported ? 'false' : 'true';
+        gallery.classList.toggle('snap-native', supported);
+        gallery.classList.toggle('snap-fallback', !supported);
+
+        if (snapStatusEl) {
+          snapStatusEl.dataset.fallback = supported ? 'false' : 'true';
+          snapStatusEl.textContent = supported
+            ? 'Scroll Snap Events: Supported'
+            : 'Scroll Snap Events: Fallback Mode';
+        }
+        return supported;
+      }
+
+      function getSlideIndexFromTarget(target) {
+        if (!target) return -1;
+        const item = target.closest ? target.closest('.gallery-item') : target;
+        return slides.indexOf(item);
+      }
+
+      function getClosestSlideIndex() {
+        if (!slides.length) return 0;
+        const scrollLeft = gallery.scrollLeft;
+        let bestIndex = 0;
+        let minDistance = Infinity;
+
+        slides.forEach((slide, index) => {
+          const distance = Math.abs(slide.offsetLeft - scrollLeft);
+          if (distance < minDistance) {
+            minDistance = distance;
+            bestIndex = index;
+          }
+        });
+
+        return bestIndex;
+      }
+
+      function getScrollPreviewIndex() {
+        if (!slides.length) return 0;
+        const closest = getClosestSlideIndex();
+        const activeSlide = slides[activeIndex] || slides[0];
+        const deltaFromActive = gallery.scrollLeft - activeSlide.offsetLeft;
+
+        if (Math.abs(deltaFromActive) <= 5) {
+          return activeIndex;
+        }
+        if (closest !== activeIndex) {
+          return closest;
+        }
+        if (deltaFromActive > 5 && activeIndex + 1 < slides.length) {
+          return activeIndex + 1;
+        }
+        if (deltaFromActive < -5 && activeIndex - 1 >= 0) {
+          return activeIndex - 1;
+        }
+        return closest;
+      }
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        pendingIndex = index;
+
+        thumbnails.forEach((btn, i) => {
+          const isPending = i === index;
+          btn.classList.toggle('pending', isPending);
+          btn.setAttribute('data-pending', isPending ? 'true' : 'false');
+        });
+
+        slides.forEach((slide, i) => {
+          slide.setAttribute('data-pending', i === index ? 'true' : 'false');
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        if (scrollSettleTimer) {
+          clearTimeout(scrollSettleTimer);
+          scrollSettleTimer = null;
+        }
+        activeIndex = index;
+        pendingIndex = null;
+        hasNativePendingThisGesture = false;
+        clickedTargetIndex = null;
+
+        thumbnails.forEach((btn, i) => {
+          const isActive = i === index;
+          btn.classList.remove('pending');
+          btn.setAttribute('data-pending', 'false');
+          btn.classList.toggle('active', isActive);
+          btn.setAttribute('aria-current', isActive ? 'true' : 'false');
+          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
+        });
+
+        slides.forEach((slide, i) => {
+          slide.setAttribute('data-pending', 'false');
+          slide.setAttribute('data-active', i === index ? 'true' : 'false');
+        });
+      }
+
+      function resolveEventTargetIndex(event, fallbackFn) {
+        const rawTarget =
+          event.snapTargetInline ||
+          event.snapTargetBlock ||
+          event.snapTarget ||
+          (event.detail &&
+            (event.detail.snapTargetInline ||
+              event.detail.snapTargetBlock ||
+              event.detail.snapTarget ||
+              event.detail.target));
+
+        const idx = getSlideIndexFromTarget(rawTarget);
+        if (idx !== -1) return idx;
+        if (event.detail && typeof event.detail.index === 'number') {
+          return event.detail.index;
+        }
+        return fallbackFn();
+      }
+
+      // Native Scroll Snap Events
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const targetIdx = resolveEventTargetIndex(event, getScrollPreviewIndex);
+        hasNativePendingThisGesture = true;
+        setPending(targetIdx);
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const targetIdx = resolveEventTargetIndex(event, getClosestSlideIndex);
+        setActive(targetIdx);
+      });
+
+      // Fallback detection & scroll/scrollend handling
+      updateFallbackStatus();
+
+      gallery.addEventListener(
+        'scroll',
+        () => {
+          updateFallbackStatus();
+
+          if (scrollSettleTimer) {
+            clearTimeout(scrollSettleTimer);
+          }
+
+          if (!hasNativePendingThisGesture) {
+            if (clickedTargetIndex !== null) {
+              setPending(clickedTargetIndex);
+            } else {
+              const activeSlide = slides[activeIndex] || slides[0];
+              const distFromActive = Math.abs(gallery.scrollLeft - activeSlide.offsetLeft);
+              if (distFromActive > 5) {
+                const previewIdx = getScrollPreviewIndex();
+                setPending(previewIdx);
+              } else if (pendingIndex !== null && pendingIndex !== activeIndex) {
+                setPending(activeIndex);
+              }
+            }
+          }
+
+          scrollSettleTimer = setTimeout(() => {
+            setActive(getClosestSlideIndex());
+          }, 180);
+        },
+        { passive: true }
+      );
+
+      gallery.addEventListener('scrollend', () => {
+        setActive(getClosestSlideIndex());
+      });
+
+      // Thumbnail click navigation
+      thumbnails.forEach((btn, index) => {
+        btn.addEventListener('click', () => {
+          const targetSlide = slides[index];
+          if (!targetSlide) return;
+
+          const targetLeft = targetSlide.offsetLeft;
+          if (Math.abs(gallery.scrollLeft - targetLeft) > 2 || index !== activeIndex) {
+            clickedTargetIndex = index;
+            setPending(index);
+            gallery.scrollTo({
+              left: targetLeft,
+              behavior: 'smooth'
+            });
+          } else {
+            setActive(index);
+          }
+        });
+      });
+
+      // Initialize active state on first slide
+      setActive(0);
+    })();
+  </script>
+
 </body>
 
