+  <script>
+    let currentScrollId = 0;
+    const sections = document.querySelectorAll('main section[id]');
+    const navLinks = document.querySelectorAll('nav a[href^="#"], nav a[data-scroll-target]');
+    const statusRegion = document.getElementById('scroll-status');
+
+    function scrollIntoViewAsync(element, options, scroller = window) {
+      const result = element.scrollIntoView(options);
+
+      // Feature detect: in supporting browsers, scrollIntoView() returns a Promise
+      if (result instanceof Promise) {
+        return result;
+      }
+
+      // Fallback for browsers where scrollIntoView() returns undefined
+      return new Promise((resolve) => {
+        let timeoutId;
+
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+
+        const onScroll = () => {
+          // Restart the idle timer on every scroll event. If scrollend never fires
+          // (browsers without scrollend support), this resolves once scrolling goes idle.
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+
+        // If no scroll event fires within the idle window (e.g., already in view), resolve.
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    async function scrollToAndHighlight(targetElement, triggerLink) {
+      const scrollId = ++currentScrollId;
+
+      sections.forEach((sec) => {
+        sec.classList.remove('highlight');
+        sec.removeAttribute('data-scroll-complete');
+      });
+
+      await scrollIntoViewAsync(targetElement, { behavior: 'smooth', block: 'center' });
+
+      // Abort follow-up effect if another scroll was triggered while awaiting
+      if (scrollId !== currentScrollId) return;
+
+      targetElement.classList.add('highlight');
+      targetElement.setAttribute('data-scroll-complete', 'true');
+
+      navLinks.forEach((link) => {
+        const linkTargetId = link.dataset.scrollTarget || link.getAttribute('href')?.replace(/^#/, '');
+        const isCurrent = linkTargetId === targetElement.id;
+        link.classList.toggle('active', isCurrent);
+        if (isCurrent) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      targetElement.focus({ preventScroll: true });
+
+      const heading = targetElement.querySelector('h2');
+      if (statusRegion && heading) {
+        statusRegion.textContent = `Navigated to ${heading.textContent}`;
+      }
+    }
+
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+      if (!link) return;
+
+      const targetId = link.dataset.scrollTarget || link.getAttribute('href')?.replace(/^#/, '');
+      if (!targetId) return;
+
+      const targetElement = document.getElementById(targetId);
+      if (!targetElement) return;
+
+      event.preventDefault();
+      history.replaceState(null, '', `#${targetId}`);
+      scrollToAndHighlight(targetElement, link);
+    });
+  </script>
