+  <script>
+    (function () {
+      const scrollLinks = document.querySelectorAll('nav a[href^="#"], nav a[data-scroll-target], a[data-scroll-target]');
+      const sections = document.querySelectorAll('.page-section');
+      const navLinks = document.querySelectorAll('nav a');
+
+      let activeCleanup = null;
+
+      function resolveTargetElement(link) {
+        const rawTarget = link.getAttribute('data-scroll-target') || link.getAttribute('href') || '';
+        const targetId = rawTarget.replace(/^#/, '').trim();
+        if (!targetId) return null;
+        return document.getElementById(targetId);
+      }
+
+      function clearSectionEffects() {
+        sections.forEach((section) => {
+          section.classList.remove('scroll-arrived', 'is-active');
+          section.removeAttribute('data-scroll-active');
+          section.dataset.scrollState = 'idle';
+        });
+      }
+
+      function getTargetScrollTop(targetEl) {
+        const nav = document.querySelector('nav');
+        const navOffset = nav ? nav.offsetHeight + 24 : 96;
+        const rect = targetEl.getBoundingClientRect();
+        const absoluteTop = rect.top + window.pageYOffset - navOffset;
+        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+        return Math.max(0, Math.min(absoluteTop, maxScroll));
+      }
+
+      function scrollToSection(targetEl, triggerLink) {
+        if (activeCleanup) {
+          activeCleanup();
+          activeCleanup = null;
+        }
+
+        // Remove post-scroll effects and blur any focused section before starting smooth scroll
+        clearSectionEffects();
+        if (document.activeElement && document.activeElement.classList.contains('page-section')) {
+          document.activeElement.blur();
+        }
+
+        navLinks.forEach((navLink) => {
+          const isMatch = resolveTargetElement(navLink) === targetEl;
+          navLink.classList.toggle('active', isMatch);
+          if (isMatch) {
+            navLink.setAttribute('aria-current', 'true');
+          } else {
+            navLink.removeAttribute('aria-current');
+          }
+        });
+
+        targetEl.dataset.scrollState = 'scrolling';
+
+        const destinationTop = getTargetScrollTop(targetEl);
+        const startTop = window.pageYOffset;
+        const distance = Math.abs(destinationTop - startTop);
+
+        let completed = false;
+        let idleTimer = null;
+        let maxWaitTimer = null;
+        let hasScrolled = false;
+
+        function finalizeArrival() {
+          if (completed) return;
+          completed = true;
+
+          if (activeCleanup) {
+            activeCleanup();
+            activeCleanup = null;
+          }
+
+          targetEl.dataset.scrollState = 'arrived';
+          targetEl.setAttribute('data-scroll-active', 'true');
+          targetEl.classList.add('scroll-arrived', 'is-active');
+          targetEl.focus({ preventScroll: true });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', '#' + targetEl.id);
+          }
+
+          targetEl.dispatchEvent(new CustomEvent('scrollarrival', {
+            bubbles: true,
+            detail: { id: targetEl.id, trigger: triggerLink }
+          }));
+        }
+
+        function onScroll() {
+          hasScrolled = true;
+          if (idleTimer) clearTimeout(idleTimer);
+          const remaining = Math.abs(window.pageYOffset - destinationTop);
+          const delay = remaining <= 2 ? 50 : 120;
+          idleTimer = setTimeout(finalizeArrival, delay);
+        }
+
+        function onScrollEnd() {
+          if (idleTimer) clearTimeout(idleTimer);
+          finalizeArrival();
+        }
+
+        activeCleanup = function () {
+          window.removeEventListener('scroll', onScroll);
+          window.removeEventListener('scrollend', onScrollEnd);
+          if (idleTimer) clearTimeout(idleTimer);
+          if (maxWaitTimer) clearTimeout(maxWaitTimer);
+        };
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', onScrollEnd, { once: true, passive: true });
+
+        // Initiate smooth scroll
+        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
+
+        if (distance <= 2) {
+          // Already at target position: wait briefly so arrival still occurs asynchronously after scroll initiation
+          idleTimer = setTimeout(finalizeArrival, 150);
+        } else {
+          // Safety fallback in case scroll events are suppressed in reduced-motion or non-standard environments
+          maxWaitTimer = setTimeout(() => {
+            if (!hasScrolled) {
+              finalizeArrival();
+            }
+          }, 900);
+        }
+      }
+
+      scrollLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const targetEl = resolveTargetElement(link);
+          if (!targetEl) return;
+          event.preventDefault();
+          scrollToSection(targetEl, link);
+        });
+      });
+    })();
+  </script>
