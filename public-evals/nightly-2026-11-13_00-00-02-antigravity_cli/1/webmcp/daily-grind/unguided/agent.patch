+  <script>
+    (function () {
+      const orders = [];
+      const MENU_PRICES = {
+        'Maple Oat Latte': 5.50,
+        'Dark Roast Espresso': 3.75,
+        'Cold Brew': 4.75
+      };
+
+      const SIZE_UPCHARGE = {
+        'Small': -0.50,
+        'Single': -0.50,
+        'Medium': 0,
+        'Double': 0,
+        'Large': 0.75,
+        'Triple': 0.75
+      };
+
+      function normalizeDrinkName(inputName) {
+        if (!inputName) return 'Maple Oat Latte';
+        const lower = String(inputName).toLowerCase();
+        if (lower.includes('maple') || lower.includes('latte')) return 'Maple Oat Latte';
+        if (lower.includes('espresso') || lower.includes('dark')) return 'Dark Roast Espresso';
+        if (lower.includes('cold') || lower.includes('brew')) return 'Cold Brew';
+        return inputName;
+      }
+
+      function placeOrder(orderParams) {
+        const item = normalizeDrinkName(orderParams.item || orderParams.coffee || orderParams.drink);
+        const quantity = Math.max(1, parseInt(orderParams.quantity, 10) || 1);
+        const size = orderParams.size || (item === 'Dark Roast Espresso' ? 'Double' : 'Medium');
+        const basePrice = MENU_PRICES[item] || 5.00;
+        const upcharge = SIZE_UPCHARGE[size] || 0;
+        const unitPrice = basePrice + upcharge;
+        const lineTotal = unitPrice * quantity;
+
+        const details = [];
+        if (size) details.push(size);
+        if (orderParams.milk) details.push(orderParams.milk);
+        if (orderParams.temperature) details.push(orderParams.temperature);
+        if (orderParams.ice) details.push(orderParams.ice);
+        if (orderParams.sweetener) details.push(orderParams.sweetener);
+
+        const orderRecord = {
+          id: 'ORD-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
+          item,
+          quantity,
+          size,
+          options: details,
+          unitPrice,
+          totalPrice: Number(lineTotal.toFixed(2)),
+          timestamp: new Date().toISOString()
+        };
+
+        orders.push(orderRecord);
+        updateOrderUI(orderRecord);
+
+        return {
+          status: 'success',
+          message: `Ordered ${quantity}x ${size} ${item}${details.length > 1 ? ' (' + details.slice(1).join(', ') + ')' : ''} for $${orderRecord.totalPrice.toFixed(2)}.`,
+          order: orderRecord,
+          cartTotalItems: orders.reduce((sum, o) => sum + o.quantity, 0),
+          cartTotalPrice: Number(orders.reduce((sum, o) => sum + o.totalPrice, 0).toFixed(2))
+        };
+      }
+
+      function updateOrderUI(latestOrder) {
+        const cartCountEl = document.getElementById('cart-count');
+        const orderListEl = document.getElementById('order-list');
+        const orderTotalEl = document.getElementById('order-total');
+        const emptyMsgEl = document.getElementById('empty-cart-msg');
+
+        const totalQty = orders.reduce((sum, o) => sum + o.quantity, 0);
+        const totalPrice = orders.reduce((sum, o) => sum + o.totalPrice, 0);
+
+        if (cartCountEl) cartCountEl.textContent = String(totalQty);
+        if (emptyMsgEl) emptyMsgEl.style.display = orders.length ? 'none' : 'block';
+
+        if (orderListEl && latestOrder) {
+          const li = document.createElement('li');
+          li.className = 'order-item';
+          const optsText = latestOrder.options.length ? ` (${latestOrder.options.join(', ')})` : '';
+          li.innerHTML = `
+            <span><strong>${latestOrder.quantity}x ${latestOrder.item}</strong>${optsText}</span>
+            <span>$${latestOrder.totalPrice.toFixed(2)}</span>
+          `;
+          orderListEl.appendChild(li);
+        }
+
+        if (orderTotalEl) {
+          orderTotalEl.textContent = `Total: $${totalPrice.toFixed(2)}`;
+        }
+
+        // Update card-level feedback banner
+        const slugMap = {
+          'Maple Oat Latte': 'feedback-maple-oat-latte',
+          'Dark Roast Espresso': 'feedback-dark-roast-espresso',
+          'Cold Brew': 'feedback-cold-brew'
+        };
+        const feedbackId = slugMap[latestOrder.item];
+        if (feedbackId) {
+          const feedbackEl = document.getElementById(feedbackId);
+          if (feedbackEl) {
+            feedbackEl.textContent = `Added ${latestOrder.quantity}x ${latestOrder.size} ${latestOrder.item} to your order!`;
+            feedbackEl.classList.add('visible');
+          }
+        }
+      }
+
+      // Handle form submissions (both human and declarative WebMCP agent submissions)
+      document.querySelectorAll('.order-form').forEach((form) => {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const formData = new FormData(form);
+          const params = Object.fromEntries(formData.entries());
+          params.item = form.dataset.item || params.item;
+
+          const result = placeOrder(params);
+
+          // If triggered via WebMCP Declarative SubmitEvent, return structured output to the agent
+          if (typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve(result));
+          }
+        });
+      });
+
+      // Expose tools via WebMCP Imperative API (navigator.modelContext / document.modelContext)
+      const toolDefinitions = [
+        {
+          name: 'order_maple_oat_latte',
+          description: 'Place an order for a Maple Oat Latte from Seasonal Favorites with customizable size, milk, temperature, and quantity.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size (Small, Medium, or Large). Defaults to Medium.'
+              },
+              milk: {
+                type: 'string',
+                enum: ['Oat Milk', 'Almond Milk', 'Whole Milk'],
+                description: 'Milk choice. Defaults to Oat Milk.'
+              },
+              temperature: {
+                type: 'string',
+                enum: ['Hot', 'Iced'],
+                description: 'Serve Hot or Iced. Defaults to Hot.'
+              },
+              quantity: {
+                type: 'number',
+                minimum: 1,
+                description: 'Quantity to order. Defaults to 1.'
+              }
+            }
+          },
+          execute: async (params = {}) => {
+            const result = placeOrder({ ...params, item: 'Maple Oat Latte' });
+            return {
+              content: [{ type: 'text', text: result.message }],
+              ...result
+            };
+          }
+        },
+        {
+          name: 'order_dark_roast_espresso',
+          description: 'Place an order for a Dark Roast Espresso from Seasonal Favorites with customizable shot count, style, and quantity.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['Single', 'Double', 'Triple'],
+                description: 'Number of espresso shots (Single, Double, or Triple). Defaults to Double.'
+              },
+              temperature: {
+                type: 'string',
+                enum: ['Hot', 'Iced'],
+                description: 'Preparation style (Hot or Iced). Defaults to Hot.'
+              },
+              quantity: {
+                type: 'number',
+                minimum: 1,
+                description: 'Quantity to order. Defaults to 1.'
+              }
+            }
+          },
+          execute: async (params = {}) => {
+            const result = placeOrder({ ...params, item: 'Dark Roast Espresso' });
+            return {
+              content: [{ type: 'text', text: result.message }],
+              ...result
+            };
+          }
+        },
+        {
+          name: 'order_cold_brew',
+          description: 'Place an order for a 18-hour steeped Cold Brew from Seasonal Favorites with customizable size, ice level, sweetener, and quantity.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size (Small, Medium, or Large). Defaults to Medium.'
+              },
+              ice: {
+                type: 'string',
+                enum: ['Regular Ice', 'Light Ice', 'No Ice'],
+                description: 'Ice amount. Defaults to Regular Ice.'
+              },
+              sweetener: {
+                type: 'string',
+                enum: ['Unsweetened', 'Vanilla Syrup', 'Sweet Cream Cold Foam'],
+                description: 'Optional sweetener or cold foam. Defaults to Unsweetened.'
+              },
+              quantity: {
+                type: 'number',
+                minimum: 1,
+                description: 'Quantity to order. Defaults to 1.'
+              }
+            }
+          },
+          execute: async (params = {}) => {
+            const result = placeOrder({ ...params, item: 'Cold Brew' });
+            return {
+              content: [{ type: 'text', text: result.message }],
+              ...result
+            };
+          }
+        },
+        {
+          name: 'order_seasonal_coffee',
+          description: 'Order any seasonal favorite coffee (Maple Oat Latte, Dark Roast Espresso, or Cold Brew) with custom options and quantity.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              item: {
+                type: 'string',
+                enum: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'],
+                description: 'The seasonal coffee drink to order.'
+              },
+              size: {
+                type: 'string',
+                description: 'Size or shot count (e.g., Small, Medium, Large, Single, Double, Triple).'
+              },
+              quantity: {
+                type: 'number',
+                minimum: 1,
+                description: 'Number of drinks to order.'
+              }
+            },
+            required: ['item']
+          },
+          execute: async (params = {}) => {
+            const result = placeOrder(params);
+            return {
+              content: [{ type: 'text', text: result.message }],
+              ...result
+            };
+          }
+        }
+      ];
+
+      function registerAgentTools() {
+        const contexts = [navigator.modelContext, document.modelContext].filter(Boolean);
+        for (const ctx of contexts) {
+          if (typeof ctx.registerTool === 'function') {
+            for (const tool of toolDefinitions) {
+              try {
+                ctx.registerTool(tool, tool.execute);
+              } catch (err) {
+                // Ignore duplicate registration errors if navigator and document share the same registry
+              }
+            }
+          } else if (typeof ctx.provideContext === 'function') {
+            try {
+              ctx.provideContext({ tools: toolDefinitions });
+            } catch (err) {
+              // Ignore errors if already provided
+            }
+          }
+        }
+      }
+
+      registerAgentTools();
+      window.dailyGrindTools = {
+        placeOrder,
+        getOrders: () => [...orders],
+        tools: toolDefinitions
+      };
+    })();
+  </script>
