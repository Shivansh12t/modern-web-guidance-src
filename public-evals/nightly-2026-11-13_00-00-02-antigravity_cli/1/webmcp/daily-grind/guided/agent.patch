+  <script>
+    (() => {
+      const orders = [];
+      const orderItemsEl = document.getElementById('order-items');
+      const orderCountEl = document.getElementById('order-count');
+
+      const SIZES = ['Small', 'Medium', 'Large'];
+      const TEMPERATURES = ['Hot', 'Iced'];
+      const SHOTS = ['Single', 'Double', 'Triple'];
+      const ICE_LEVELS = ['Regular Ice', 'Light Ice', 'No Ice'];
+
+      const SIZE_SURCHARGE = { Small: -0.5, Medium: 0, Large: 0.75 };
+      const SHOTS_SURCHARGE = { Single: -0.5, Double: 0, Triple: 0.75 };
+
+      function renderOrders() {
+        const totalItems = orders.reduce((sum, item) => sum + item.quantity, 0);
+        orderCountEl.textContent = String(totalItems);
+        orderItemsEl.textContent = '';
+
+        if (orders.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.textContent = 'No seasonal drinks ordered yet.';
+          orderItemsEl.appendChild(emptyLi);
+          return;
+        }
+
+        for (const item of orders) {
+          const li = document.createElement('li');
+          const desc = document.createElement('span');
+          desc.textContent = `${item.quantity}x ${item.drink} (${item.details})`;
+          const price = document.createElement('strong');
+          price.textContent = `$${item.totalPrice.toFixed(2)}`;
+          li.append(desc, price);
+          orderItemsEl.appendChild(li);
+        }
+      }
+
+      function setFormSelection(form, name, value) {
+        if (value == null) return;
+        const radio = form.querySelector(`input[name="${name}"][value="${CSS.escape(String(value))}"]`);
+        if (radio) {
+          radio.checked = true;
+          return;
+        }
+        const input = form.elements.namedItem(name);
+        if (input && 'value' in input) {
+          input.value = String(value);
+        }
+      }
+
+      function addOrderItem({ form, drink, basePrice, details, unitPrice, quantity }) {
+        const totalPrice = Number(((unitPrice) * quantity).toFixed(2));
+        const orderRecord = {
+          orderId: `ORD-${Date.now()}-${orders.length + 1}`,
+          drink,
+          details,
+          quantity,
+          unitPrice: Number(unitPrice.toFixed(2)),
+          totalPrice
+        };
+        orders.push(orderRecord);
+        renderOrders();
+
+        if (form) {
+          const statusEl = form.querySelector('.order-status');
+          if (statusEl) {
+            statusEl.textContent = `Added ${quantity}x ${drink} (${details}) — $${totalPrice.toFixed(2)}`;
+          }
+        }
+        return orderRecord;
+      }
+
+      function validateFormFields(form) {
+        const errors = [];
+        const quantityInput = form.querySelector('input[name="quantity"]');
+        const qty = Number(quantityInput?.value);
+        if (!Number.isInteger(qty) || qty < 1 || qty > 10) {
+          if (quantityInput) {
+            quantityInput.setCustomValidity('Please enter a whole quantity between 1 and 10.');
+            quantityInput.setAttribute('aria-invalid', 'true');
+          }
+          errors.push({ field: 'quantity', message: 'Quantity must be an integer between 1 and 10.' });
+        } else if (quantityInput) {
+          quantityInput.setCustomValidity('');
+          quantityInput.removeAttribute('aria-invalid');
+        }
+        return errors;
+      }
+
+      document.querySelectorAll('.order-form').forEach((form) => {
+        const quantityInput = form.querySelector('input[name="quantity"]');
+        if (quantityInput) {
+          quantityInput.addEventListener('input', () => {
+            quantityInput.setCustomValidity('');
+            quantityInput.removeAttribute('aria-invalid');
+          });
+          quantityInput.addEventListener('blur', () => {
+            validateFormFields(form);
+          });
+        }
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const validationErrors = validateFormFields(form);
+
+          if (validationErrors.length > 0) {
+            const firstInvalid = form.querySelector('[aria-invalid="true"]');
+            if (firstInvalid) firstInvalid.focus();
+            if (event.agentInvoked && typeof event.respondWith === 'function') {
+              const errorString = 'Validation failed: ' + validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+              event.respondWith(Promise.resolve(errorString));
+            }
+            return;
+          }
+
+          const formData = new FormData(form);
+          const drink = form.dataset.drinkName;
+          const basePrice = Number(form.dataset.basePrice);
+          const quantity = Number(formData.get('quantity') || 1);
+          let details = '';
+          let surcharge = 0;
+
+          if (form.dataset.drinkId === 'maple-oat-latte') {
+            const size = String(formData.get('size') || 'Medium');
+            const temperature = String(formData.get('temperature') || 'Hot');
+            details = `${size}, ${temperature}`;
+            surcharge = SIZE_SURCHARGE[size] ?? 0;
+          } else if (form.dataset.drinkId === 'dark-roast-espresso') {
+            const shots = String(formData.get('shots') || 'Double');
+            details = `${shots} Shot`;
+            surcharge = SHOTS_SURCHARGE[shots] ?? 0;
+          } else if (form.dataset.drinkId === 'cold-brew') {
