--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,225 @@
+import React, { useState, useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleUtilityProps {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+  initialIsBookmarked: boolean;
+}
+
+const EMPTY_SCHEMA = { type: 'object', properties: {} } as const;
+
+const EXTRACT_CONTENT_SCHEMA = {
+  type: 'object',
+  properties: {
+    includeHeadings: {
+      type: 'boolean',
+      default: true,
+      description: 'Whether to include the structured list of section headings from the article.',
+    },
+  },
+} as const;
+
+const BOOKMARK_ACTIONS = ['toggle', 'add', 'remove'] as const;
+
+const BOOKMARK_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {
+    action: {
+      type: 'string',
+      enum: BOOKMARK_ACTIONS,
+      default: 'toggle',
+      description: 'Operation to perform on the current article bookmark status.',
+    },
+  },
+} as const;
+
+const READ_ONLY_ANNOTATIONS = { readOnlyHint: true } as const;
+const MUTATION_ANNOTATIONS = { readOnlyHint: false, consequentialHint: false } as const;
+
+export default function ArticleTools({
+  slug,
+  title,
+  summary,
+  author,
+  date,
+  category,
+  readingTime,
+  tags = [],
+  initialIsBookmarked,
+}: ArticleUtilityProps) {
+  const [isBookmarked, setIsBookmarked] = useState(initialIsBookmarked);
+  const [popularity, setPopularity] = useState<{ views: number; trending: boolean } | null>(null);
+
+  useEffect(() => {
+    const handleReadingListUpdated = (event: Event) => {
+      const customEvent = event as CustomEvent<{ readingList?: string[] }>;
+      if (customEvent.detail?.readingList) {
+        setIsBookmarked(customEvent.detail.readingList.includes(slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleReadingListUpdated);
+    return () => {
+      window.removeEventListener('reading-list-updated', handleReadingListUpdated);
+    };
+  }, [slug]);
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article_metadata',
+    description: 'Retrieves structured metadata for the currently open article, including title, author, publication date, category, reading time, and bookmark status. Use when the user asks about the current article details.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: () => {
+      return {
+        slug,
+        title,
+        summary,
+        author,
+        date,
+        category,
+        readingTimeMinutes: readingTime ?? null,
+        tags,
+        isBookmarked,
+        url: typeof window !== 'undefined' ? window.location.href : `${import.meta.env.BASE_URL}articles/${slug}`,
+      };
+    },
+  });
+
+  useWebMCP<{ includeHeadings?: boolean }, unknown>({
+    name: 'extract_current_article_content',
+    description: 'Extracts the full plain-text body, word count, estimated reading time, and section headings of the currently displayed article from the page DOM. Use when the user wants to read, summarize, or analyze the current article content.',
+    inputSchema: EXTRACT_CONTENT_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: ({ includeHeadings = true } = {}) => {
+      if (typeof document === 'undefined') {
+        return { error: 'Document is not available.' };
+      }
+      const proseEl = document.querySelector('article .prose') || document.querySelector('article');
+      if (!proseEl) {
+        return { error: 'Article content element not found on the current page.' };
+      }
+
+      const fullText = (proseEl.textContent || '').trim().replace(/\s+/g, ' ');
+      const words = fullText ? fullText.split(/\s+/).length : 0;
+      const estimatedMinutes = Math.max(1, Math.ceil(words / 200));
+
+      const headings = includeHeadings
+        ? Array.from(proseEl.querySelectorAll('h1, h2, h3, h4')).map(heading => ({
+            level: Number(heading.tagName.slice(1)),
+            text: (heading.textContent || '').trim(),
+          }))
+        : undefined;
+
+      const paragraphs = Array.from(proseEl.querySelectorAll('p'))
+        .map(p => (p.textContent || '').trim())
+        .filter(Boolean);
+
+      return {
+        slug,
+        title,
+        wordCount: words,
+        estimatedReadingTimeMinutes: readingTime ?? estimatedMinutes,
+        ...(includeHeadings ? { headings } : {}),
+        paragraphs,
+        text: fullText,
+      };
+    },
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article_popularity',
+    description: 'Fetches live readership popularity metrics (view count and trending status) for the currently open article. Use when the user asks how popular or trending the current article is.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: async (_input, { signal }) => {
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(slug)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          return { error: `Failed to fetch article popularity (status ${response.status})` };
+        }
+        const data = await response.json();
+        setPopularity({ views: data.views, trending: Boolean(data.trending) });
+        return {
+          slug,
+          title,
+          views: data.views,
+          trending: Boolean(data.trending),
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP<{ action?: (typeof BOOKMARK_ACTIONS)[number] }, unknown>({
+    name: 'bookmark_current_article',
+    description: 'Bookmarks, unbookmarks, or toggles the reading-list state of the currently open article. Use when the user wants to save or remove the current article in their reading list.',
+    inputSchema: BOOKMARK_ARTICLE_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    execute: async ({ action = 'toggle' } = {}, { signal }) => {
+      if (!BOOKMARK_ACTIONS.includes(action)) {
+        return {
+          error: 'Pass a supported bookmark action.',
+          supportedActions: BOOKMARK_ACTIONS,
+        };
+      }
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug, action }),
+          signal,
+        });
+        if (!response.ok) {
+          return { error: `Failed to update bookmark status (status ${response.status})` };
+        }
+        const data = await response.json();
+        const updatedList: string[] = data.readingList || [];
+        const nowBookmarked = updatedList.includes(slug);
+        setIsBookmarked(nowBookmarked);
+        window.dispatchEvent(
+          new CustomEvent('reading-list-updated', { detail: { readingList: updatedList } })
+        );
+        return {
+          slug,
+          title,
+          action,
+          isBookmarked: nowBookmarked,
+          readingListCount: updatedList.length,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  if (!popularity) {
+    return null;
+  }
+
+  return (
+    <div className="text-xs text-gray-500 flex items-center gap-2">
+      <span>{popularity.views.toLocaleString()} views</span>
+      {popularity.trending && (
+        <span className="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-medium">
+          Trending
+        </span>
+      )}
+    </div>
+  );
+}
