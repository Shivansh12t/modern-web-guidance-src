+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggleBtn = document.getElementById('theme-toggle');
+
+      function getStoredScheme() {
+        try {
+          const val = localStorage.getItem('color-scheme');
+          return val === 'light' || val === 'dark' ? val : null;
+        } catch {
+          return null;
+        }
+      }
+
+      toggleBtn.addEventListener('click', () => {
+        const systemScheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+        const storedScheme = getStoredScheme();
+        const currentMeta = meta.content === 'light' || meta.content === 'dark' ? meta.content : null;
+        const currentRendered = storedScheme ?? currentMeta ?? systemScheme;
+        const targetScheme = currentRendered === 'dark' ? 'light' : 'dark';
+
+        if (targetScheme !== systemScheme) {
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+          meta.content = targetScheme;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+          meta.content = 'light dark';
+        }
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          meta.content = e.newValue === 'light' || e.newValue === 'dark' ? e.newValue : 'light dark';
+        }
+      });
+    })();
+  </script>
