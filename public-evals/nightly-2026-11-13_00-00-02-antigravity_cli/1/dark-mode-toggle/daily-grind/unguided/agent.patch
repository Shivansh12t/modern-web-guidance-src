+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theme-toggle');
+      const iconSpan = toggleBtn.querySelector('.theme-toggle-icon');
+      const textSpan = toggleBtn.querySelector('.theme-toggle-text');
+      const root = document.documentElement;
+      const body = document.body;
+
+      function getEffectiveTheme() {
+        const savedTheme = localStorage.getItem('theme');
+        if (savedTheme === 'dark' || savedTheme === 'light') {
+          return savedTheme;
+        }
+        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
+          ? 'dark'
+          : 'light';
+      }
+
+      function applyTheme(theme, persist) {
+        root.setAttribute('data-theme', theme);
+        body.setAttribute('data-theme', theme);
+        body.classList.toggle('dark-mode', theme === 'dark');
+        body.classList.toggle('light-mode', theme === 'light');
+
+        const isDark = theme === 'dark';
+        toggleBtn.setAttribute('aria-pressed', String(isDark));
+        toggleBtn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
+        iconSpan.textContent = isDark ? '☀️' : '🌙';
+        textSpan.textContent = isDark ? 'Light Mode' : 'Dark Mode';
+
+        if (persist) {
+          localStorage.setItem('theme', theme);
+        }
+      }
+
+      // Initialize based on saved preference or system default
+      applyTheme(getEffectiveTheme(), false);
+
+      // Manual toggle overrides system theme
+      toggleBtn.addEventListener('click', function () {
+        const currentTheme = root.getAttribute('data-theme') || getEffectiveTheme();
+        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
+        applyTheme(nextTheme, true);
+      });
+
+      // Listen for system theme changes only if user hasn't explicitly overridden it
+      if (window.matchMedia) {
+        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
+          if (!localStorage.getItem('theme')) {
+            applyTheme(e.matches ? 'dark' : 'light', false);
+          }
+        });
+      }
+    })();
+  </script>
