+  <script>
+    (function () {
+      const items = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          href: '/menu/seasonal',
+          category: 'Seasonal Favorites',
+          price: '$5.75',
+          description: 'Creamy oat milk with a hint of pure Vermont maple syrup, combined with our rich double-shot espresso and finished with a light dusting of cinnamon.',
+          notes: 'Toasted maple, velvety oat, warm spice',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          href: '/menu/espresso',
+          category: 'Seasonal Favorites',
+          price: '$3.95',
+          description: 'Bold, smokey, and perfect for a morning boost. Freshly pulled from single-origin dark roasted beans with a rich golden crema.',
+          notes: 'Dark cocoa, roasted walnut, smoky finish',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          href: '/menu/cold-brew',
+          category: 'Seasonal Favorites',
+          price: '$4.85',
+          description: 'Steeped in small batches for 18 hours in cold filtered water for maximum smoothness and naturally sweet, low-acid flavor.',
+          notes: 'Smooth caramel, milk chocolate, crisp finish',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=800&q=80'
+        }
+      };
+
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const seasonalGrid = document.getElementById('seasonal-grid');
+      const sectionHeading = document.getElementById('section-heading');
+      const detailView = document.getElementById('item-detail-view');
+      const detailImg = document.getElementById('detail-img');
+      const detailTitle = document.getElementById('detail-title');
+      const detailCategory = document.getElementById('detail-category');
+      const detailDescription = document.getElementById('detail-description');
+      const detailPrice = document.getElementById('detail-price');
+      const detailNotes = document.getElementById('detail-notes');
+      const backBtn = document.getElementById('back-to-seasonal-btn');
+
+      function renderBreadcrumbs(trail) {
+        breadcrumbList.innerHTML = '';
+        trail.forEach(function (crumb, index) {
+          const li = document.createElement('li');
+          const isLast = index === trail.length - 1;
+          li.className = isLast ? 'breadcrumb-item active' : 'breadcrumb-item';
+          if (isLast) {
+            li.setAttribute('aria-current', 'page');
+            li.textContent = crumb.label;
+          } else {
+            const a = document.createElement('a');
+            a.href = crumb.href;
+            a.textContent = crumb.label;
+            a.setAttribute('data-breadcrumb', crumb.key);
+            li.appendChild(a);
+          }
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      function showView(level, itemKey) {
+        if (level === 'item' && items[itemKey]) {
+          const item = items[itemKey];
+          detailImg.src = item.image;
+          detailImg.alt = item.title;
+          detailTitle.textContent = item.title;
+          detailCategory.textContent = item.category;
+          detailDescription.textContent = item.description;
+          detailPrice.textContent = item.price;
+          detailNotes.innerHTML = '<strong>Tasting Notes:</strong> ' + item.notes;
+
+          seasonalGrid.style.display = 'none';
+          sectionHeading.style.display = 'none';
+          detailView.classList.add('active');
+
+          renderBreadcrumbs([
+            { key: 'home', label: 'Home', href: '/' },
+            { key: 'menu', label: 'Menu', href: '/menu' },
+            { key: 'seasonal', label: 'Seasonal Favorites', href: '/menu/seasonal' },
+            { key: itemKey, label: item.title, href: item.href }
+          ]);
+        } else if (level === 'menu') {
+          detailView.classList.remove('active');
+          seasonalGrid.style.display = 'grid';
+          sectionHeading.style.display = 'block';
+          sectionHeading.textContent = 'Menu — Seasonal Favorites';
+
+          renderBreadcrumbs([
+            { key: 'home', label: 'Home', href: '/' },
+            { key: 'menu', label: 'Menu', href: '/menu' }
+          ]);
+        } else if (level === 'home') {
+          detailView.classList.remove('active');
+          seasonalGrid.style.display = 'grid';
+          sectionHeading.style.display = 'block';
+          sectionHeading.textContent = 'Seasonal Favorites';
+
+          renderBreadcrumbs([
+            { key: 'home', label: 'Home', href: '/' },
+            { key: 'menu', label: 'Menu', href: '/menu' },
+            { key: 'seasonal', label: 'Seasonal Favorites', href: '/menu/seasonal' }
+          ]);
+        } else {
+          // Default 'seasonal' level
+          detailView.classList.remove('active');
+          seasonalGrid.style.display = 'grid';
+          sectionHeading.style.display = 'block';
+          sectionHeading.textContent = 'Seasonal Favorites';
+
+          renderBreadcrumbs([
+            { key: 'home', label: 'Home', href: '/' },
+            { key: 'menu', label: 'Menu', href: '/menu' },
+            { key: 'seasonal', label: 'Seasonal Favorites', href: '/menu/seasonal' }
+          ]);
+        }
+      }
+
+      document.querySelectorAll('.view-details-btn').forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          e.preventDefault();
+          const itemKey = btn.getAttribute('data-item');
+          showView('item', itemKey);
+        });
+      });
+
+      breadcrumbList.addEventListener('click', function (e) {
+        const link = e.target.closest('a[data-breadcrumb]');
+        if (!link) return;
+        e.preventDefault();
+        const key = link.getAttribute('data-breadcrumb');
+        showView(key);
+      });
+
+      document.querySelectorAll('a[data-nav]').forEach(function (navLink) {
+        navLink.addEventListener('click', function (e) {
+          e.preventDefault();
+          const target = navLink.getAttribute('data-nav');
+          showView(target);
+        });
+      });
+
+      if (backBtn) {
+        backBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          showView('seasonal');
+        });
+      }
+    })();
+  </script>
+
 </body>
 
