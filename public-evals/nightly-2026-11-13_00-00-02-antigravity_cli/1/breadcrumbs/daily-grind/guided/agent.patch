+  <script>
+    const menuItems = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        href: '/menu/seasonal',
+        description: 'Creamy oat milk steamed with two shots of our signature espresso and finished with pure Vermont maple syrup and a dusting of cinnamon.',
+        price: '$5.75'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        href: '/menu/espresso',
+        description: 'Bold, smokey, and full-bodied single-origin roast with notes of dark chocolate and toasted walnut, pulled to perfection for a morning boost.',
+        price: '$3.50'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        href: '/menu/cold-brew',
+        description: 'Coarse-ground artisanal beans steeped in filtered cold water for 18 hours for maximum smoothness and naturally sweet cocoa undertones.',
+        price: '$4.75'
+      }
+    };
+
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    const cardsGrid = document.getElementById('cards-grid');
+    const detailView = document.getElementById('item-detail-view');
+    const detailTitle = document.getElementById('detail-title');
+    const detailDescription = document.getElementById('detail-description');
+    const detailPrice = document.getElementById('detail-price');
+    const sectionHeading = document.getElementById('section-heading');
+    const backToSeasonalBtn = document.getElementById('back-to-seasonal');
+
+    function renderBreadcrumbs(trail) {
+      breadcrumbList.replaceChildren();
+      trail.forEach((crumb, index) => {
+        const li = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = crumb.href;
+        link.textContent = crumb.label;
+        if (index === trail.length - 1) {
+          link.setAttribute('aria-current', 'page');
+        }
+        li.appendChild(link);
+        breadcrumbList.appendChild(li);
+      });
+    }
+
+    function showCategoryView(level) {
+      detailView.hidden = true;
+      cardsGrid.hidden = false;
+
+      if (level === '/') {
+        sectionHeading.textContent = 'Seasonal Favorites';
+        renderBreadcrumbs([
+          { label: 'Home', href: '/' }
+        ]);
+      } else if (level === '/menu') {
+        sectionHeading.textContent = 'Menu — Seasonal Favorites';
+        renderBreadcrumbs([
+          { label: 'Home', href: '/' },
+          { label: 'Menu', href: '/menu' }
+        ]);
+      } else {
+        sectionHeading.textContent = 'Seasonal Favorites';
+        renderBreadcrumbs([
+          { label: 'Home', href: '/' },
+          { label: 'Menu', href: '/menu' },
+          { label: 'Seasonal Favorites', href: '/menu/seasonal' }
+        ]);
+      }
+    }
+
+    function showItemDetail(itemKey) {
+      const item = menuItems[itemKey];
+      if (!item) return;
+
+      detailTitle.textContent = item.title;
+      detailDescription.textContent = item.description;
+      detailPrice.textContent = item.price;
+      cardsGrid.hidden = true;
+      detailView.hidden = false;
+
+      renderBreadcrumbs([
+        { label: 'Home', href: '/' },
+        { label: 'Menu', href: '/menu' },
+        { label: 'Seasonal Favorites', href: '/menu/seasonal' },
+        { label: item.title, href: item.href }
+      ]);
+    }
+
+    document.querySelectorAll('[data-item-link]').forEach((link) => {
+      link.addEventListener('click', (event) => {
+        event.preventDefault();
+        showItemDetail(link.dataset.itemLink);
+      });
+    });
+
+    backToSeasonalBtn.addEventListener('click', (event) => {
+      event.preventDefault();
+      showCategoryView('/menu/seasonal');
+    });
+
+    breadcrumbList.addEventListener('click', (event) => {
+      const link = event.target.closest('a');
+      if (!link) return;
+      event.preventDefault();
+      const path = link.getAttribute('href');
+      if (path === '/' || path === '/menu' || path === '/menu/seasonal') {
+        showCategoryView(path);
+      }
+    });
+  </script>
+
 </body>
 
