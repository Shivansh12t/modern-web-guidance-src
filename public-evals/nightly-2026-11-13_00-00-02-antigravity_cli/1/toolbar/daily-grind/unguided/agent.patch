+  <script>
+    (function () {
+      const toolbar = document.getElementById('favorites-actions');
+      const favoritesList = document.getElementById('favorites-list');
+      const gridBtn = document.getElementById('grid-view-btn');
+      const listBtn = document.getElementById('list-view-btn');
+      const detailsBtn = document.getElementById('toggle-details-btn');
+      const filtersBtn = document.getElementById('toggle-filters-btn');
+      const copyBtn = document.getElementById('copy-drinks-btn');
+      const filterPanel = document.getElementById('favorites-filters');
+      const copyStatus = document.getElementById('copy-status');
+
+      if (!toolbar || !favoritesList) return;
+
+      const toolbarButtons = Array.from(toolbar.querySelectorAll('button'));
+
+      toolbar.addEventListener('keydown', function (e) {
+        const currentIndex = toolbarButtons.indexOf(document.activeElement);
+        if (currentIndex === -1) return;
+
+        let nextIndex = null;
+        if (e.key === 'ArrowRight') {
+          nextIndex = (currentIndex + 1) % toolbarButtons.length;
+        } else if (e.key === 'ArrowLeft') {
+          nextIndex = (currentIndex - 1 + toolbarButtons.length) % toolbarButtons.length;
+        } else if (e.key === 'Home') {
+          nextIndex = 0;
+        } else if (e.key === 'End') {
+          nextIndex = toolbarButtons.length - 1;
+        }
+
+        if (nextIndex !== null) {
+          e.preventDefault();
+          toolbarButtons[nextIndex].focus();
+        }
+      });
+
+      gridBtn.addEventListener('click', function () {
+        favoritesList.classList.remove('list-view');
+        gridBtn.setAttribute('aria-pressed', 'true');
+        listBtn.setAttribute('aria-pressed', 'false');
+      });
+
+      listBtn.addEventListener('click', function () {
+        favoritesList.classList.add('list-view');
+        listBtn.setAttribute('aria-pressed', 'true');
+        gridBtn.setAttribute('aria-pressed', 'false');
+      });
+
+      detailsBtn.addEventListener('click', function () {
+        const isPressed = detailsBtn.getAttribute('aria-pressed') === 'true';
+        const nextPressed = !isPressed;
+        detailsBtn.setAttribute('aria-pressed', String(nextPressed));
+        favoritesList.classList.toggle('hide-details', !nextPressed);
+      });
+
+      filtersBtn.addEventListener('click', function () {
+        const isPressed = filtersBtn.getAttribute('aria-pressed') === 'true';
+        const nextPressed = !isPressed;
+        filtersBtn.setAttribute('aria-pressed', String(nextPressed));
+        filtersBtn.setAttribute('aria-expanded', String(nextPressed));
+        filterPanel.hidden = !nextPressed;
+      });
+
+      filterPanel.addEventListener('click', function (e) {
+        const chip = e.target.closest('.filter-chip');
+        if (!chip) return;
+        const filter = chip.getAttribute('data-filter');
+        filterPanel.querySelectorAll('.filter-chip').forEach(function (btn) {
+          btn.setAttribute('aria-pressed', String(btn === chip));
+        });
+        favoritesList.querySelectorAll('.card').forEach(function (card) {
+          const matches = filter === 'all' || card.getAttribute('data-category') === filter;
+          card.hidden = !matches;
+        });
+      });
+
+      copyBtn.addEventListener('click', function () {
+        const drinks = Array.from(favoritesList.querySelectorAll('.card:not([hidden]) h3'))
+          .map(function (h3) { return h3.textContent.trim(); })
+          .join(', ');
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          navigator.clipboard.writeText(drinks).catch(function () {});
+        }
+        copyStatus.textContent = 'Copied featured drinks list: ' + drinks;
+      });
+    })();
+  </script>
+
