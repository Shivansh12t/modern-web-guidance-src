+  <script>
+    (() => {
+      const form = document.getElementById('shipping-address-form');
+      const submitBtn = document.getElementById('shipping-submit');
+      const statusBox = document.getElementById('shipping-status');
+      if (!form) return;
+
+      const controls = Array.from(form.querySelectorAll('.form-control'));
+
+      function updateFieldValidity(control) {
+        const errorEl = document.getElementById(`${control.id}-error`);
+        if (control.validity.valid) {
+          control.removeAttribute('aria-invalid');
+          if (errorEl) {
+            errorEl.textContent = '';
+            errorEl.hidden = true;
+          }
+        } else {
+          control.setAttribute('aria-invalid', 'true');
+          if (errorEl) {
+            errorEl.textContent = control.validationMessage;
+            errorEl.hidden = false;
+          }
+        }
+      }
+
+      controls.forEach((control) => {
+        let touched = false;
+        control.addEventListener('input', () => {
+          touched = true;
+          if (control.getAttribute('aria-invalid') === 'true' && control.validity.valid) {
+            updateFieldValidity(control);
+          }
+        });
+        control.addEventListener('blur', () => {
+          if (touched && control.value.trim() !== '') {
+            updateFieldValidity(control);
+          }
+        });
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        let firstInvalid = null;
+
+        controls.forEach((control) => {
+          updateFieldValidity(control);
+          if (!control.validity.valid && !firstInvalid) {
+            firstInvalid = control;
+          }
+        });
+
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+
+        submitBtn.disabled = true;
+        statusBox.textContent = 'Shipping address saved! Proceeding to payment...';
+        statusBox.hidden = false;
+      });
+    })();
+  </script>
+
