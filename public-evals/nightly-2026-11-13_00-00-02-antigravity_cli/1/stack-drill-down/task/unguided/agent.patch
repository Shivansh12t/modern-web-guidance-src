+          return { fg: subdetailView, bg: detailView };
+        }
+        if (depth === 1) {
+          return { fg: detailView, bg: homeView };
+        }
+        return null;
+      }
+
+      function onSwipeStart(clientX, clientY, target) {
+        if (state.stack[state.stack.length - 1].level === 0) return;
+        if (target && target.closest('button, a, input, select, textarea') && !target.closest('#swipe-edge-indicator')) {
+          return;
+        }
+        gesture.active = true;
+        gesture.dragging = false;
+        gesture.startX = clientX;
+        gesture.startY = clientY;
+        gesture.currentX = clientX;
+      }
+
+      function onSwipeMove(clientX, clientY) {
+        if (!gesture.active) return;
+        var deltaX = clientX - gesture.startX;
+        var deltaY = clientY - gesture.startY;
+
+        if (!gesture.dragging) {
+          // Activate horizontal swipe-back when moving right more than vertically
+          if (deltaX > 10 && Math.abs(deltaX) > Math.abs(deltaY) * 1.15) {
+            gesture.dragging = true;
+            navStack.classList.add('is-dragging');
+          } else if (Math.abs(deltaY) > 18 && Math.abs(deltaY) > Math.abs(deltaX)) {
+            gesture.active = false;
+            return;
+          } else {
+            return;
+          }
+        }
+
+        gesture.currentX = clientX;
+        var clampedX = Math.max(0, deltaX);
+        var width = window.innerWidth || 800;
+        var progress = Math.min(1, clampedX / width);
+        var views = getActiveViewsForGesture();
+        if (views) {
+          views.fg.style.transform = 'translate3d(' + clampedX + 'px, 0, 0)';
+          var bgOffset = -26 + progress * 26;
+          var bgScale = 0.96 + progress * 0.04;
+          views.bg.style.transform = 'translate3d(' + bgOffset + '%, 0, 0) scale(' + bgScale + ')';
+        }
+      }
+
+      function onSwipeEnd(clientX, clientY) {
+        if (!gesture.active) return;
+        var wasDragging = gesture.dragging;
+        var endX = typeof clientX === 'number' ? clientX : gesture.currentX;
+        var endY = typeof clientY === 'number' ? clientY : gesture.startY;
+        var deltaX = endX - gesture.startX;
+        var deltaY = endY - gesture.startY;
+
+        gesture.active = false;
+        gesture.dragging = false;
+        navStack.classList.remove('is-dragging');
+
+        var views = getActiveViewsForGesture();
+        if (views) {
+          views.fg.style.transform = '';
+          views.bg.style.transform = '';
+        }
+
+        // Complete swipe-back if dragged or swiped right past threshold (45px)
+        var isRightSwipe = deltaX > 45 && Math.abs(deltaX) > Math.abs(deltaY);
+        if ((wasDragging && deltaX > 45) || isRightSwipe) {
+          navigateBack();
+        }
+      }
+
+      // Touch Events (supports both live touchMove and synthetic touchstart -> touchend swipes)
+      navStack.addEventListener('touchstart', function (e) {
+        if (!e.touches || e.touches.length !== 1) return;
+        onSwipeStart(e.touches[0].clientX, e.touches[0].clientY, e.target);
+      }, { passive: true });
+
+      navStack.addEventListener('touchmove', function (e) {
+        if (!e.touches || e.touches.length !== 1) return;
+        onSwipeMove(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      navStack.addEventListener('touchend', function (e) {
+        var touch = (e.changedTouches && e.changedTouches[0]) || null;
+        onSwipeEnd(touch ? touch.clientX : undefined, touch ? touch.clientY : undefined);
+      }, { passive: true });
+
+      navStack.addEventListener('touchcancel', function () {
+        gesture.active = false;
+        gesture.dragging = false;
+        navStack.classList.remove('is-dragging');
+        renderStack();
+      }, { passive: true });
+
+      // Mouse / Pointer Drag Events for desktop swipe-back
+      navStack.addEventListener('mousedown', function (e) {
+        if (e.button !== 0) return;
+        onSwipeStart(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!gesture.active) return;
+        onSwipeMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', function (e) {
+        if (!gesture.active) return;
+        onSwipeEnd(e.clientX, e.clientY);
+      });
+
+      // Trackpad horizontal two-finger swipe support
+      var lastWheelBackTime = 0;
+      navStack.addEventListener('wheel', function (e) {
+        if (state.stack[state.stack.length - 1].level === 0) return;
+        var now = Date.now();
+        if (now - lastWheelBackTime < 700) return;
+        if (e.deltaX < -55 && Math.abs(e.deltaX) > Math.abs(e.deltaY) * 1.6) {
+          lastWheelBackTime = now;
+          navigateBack();
+        }
+      }, { passive: true });
+
+      // Sync UI Stack on Browser Back / Forward (popstate & hashchange)
+      function syncFromBrowserHistory() {
+        var route = parseRouteFromLocation(window.location);
+        state.stack = buildStackForRoute(route);
+        renderStack();
+      }
+
+      window.addEventListener('popstate', syncFromBrowserHistory);
+      window.addEventListener('hashchange', syncFromBrowserHistory);
+
+      /**
+       * Initialize Stack on Page Load & Seed Hierarchy History for Direct Deep Links:
+       * If a user enters directly via a deep link (e.g. /menu/seasonal or ?item=seasonal),
+       * we seed the parent stack level(s) into browser history so native browser Back
+       * and in-app Back/Swipe both traverse up the hierarchy to Home seamlessly.
+       */
+      function initApp() {
+        var initialRoute = parseRouteFromLocation(window.location);
+        var initialFullUrl = window.location.pathname + window.location.search + window.location.hash;
+
+        if (initialRoute.level > 0 && !window.history.state && window.location.protocol !== 'file:') {
+          // Seed Level 0 (Home) at the bottom of history
+          replaceHistoryUrl({ level: 0, itemId: null, subview: null, seededHierarchy: true }, '/');
+
+          if (initialRoute.level === 2 && initialRoute.itemId && ITEMS[initialRoute.itemId]) {
+            // Seed intermediate Level 1 (Item Detail) before Level 2
+            pushHistoryUrl(
+              { level: 1, itemId: initialRoute.itemId, subview: null, seededHierarchy: true },
+              ITEMS[initialRoute.itemId].path
+            );
+          }
+
+          // Restore exact deep-link URL as the active history entry
+          pushHistoryUrl(
+            {
+              level: initialRoute.level,
+              itemId: initialRoute.itemId,
+              subview: initialRoute.subview,
+              seededHierarchy: true
+            },
+            initialFullUrl
+          );
+        } else if (!window.history.state) {
+          replaceHistoryUrl({ level: 0, itemId: null, subview: null, seededHierarchy: true }, initialFullUrl);
+        }
+
+        state.stack = buildStackForRoute(initialRoute);
+        renderStack();
+      }
+
+      initApp();
+    })();
+  </script>
 </body>
 
