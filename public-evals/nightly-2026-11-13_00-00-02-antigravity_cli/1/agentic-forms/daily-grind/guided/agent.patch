+      const statusBanner = document.getElementById('agent-tool-status');
+
+      function validateFormFields() {
+        const errors = [];
+        const rawQuery = queryInput.value.trim();
+
+        if (rawQuery.length === 1 || rawQuery.length > 50) {
+          const message = 'Please enter between 2 and 50 characters for flavor notes, or leave blank.';
+          queryInput.setCustomValidity(message);
+          queryInput.setAttribute('aria-invalid', 'true');
