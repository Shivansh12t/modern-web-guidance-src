+        const decafOnly = formData.get('decaf') === 'true';
+
+        const scored = COFFEE_CATALOG.map((item) => {
+          if (decafOnly && !item.decafAvailable) {
+            return null;
+          }
+          if (milk === 'black' && !item.allowBlack) {
+            return null;
+          }
+
+          let score = 10;
+          if (roast !== 'any') {
+            if (item.roast === roast) {
+              score += 5;
+            } else {
+              return null;
+            }
+          }
+          if (temperature !== 'any') {
+            if (item.temperature === temperature) {
+              score += 5;
+            } else {
+              return null;
+            }
+          }
+          if (milk !== 'any' && item.defaultMilk === milk) {
+            score += 3;
+          }
+          if (query) {
+            const haystack = `${item.name} ${item.description} ${item.notes.join(' ')}`.toLowerCase();
+            const terms = query.split(/\s+/).filter(Boolean);
+            const matchedTerms = terms.filter((t) => haystack.includes(t));
+            if (matchedTerms.length === 0) {
+              return null;
+            }
+            score += matchedTerms.length * 4;
+          }
+
+          const upcharge = SIZE_UPCHARGE[size] ?? 0;
+          const configuredPrice = (item.basePrice + upcharge).toFixed(2);
+          const selectedMilkLabel = milk === 'any' ? item.defaultMilk : milk;
