+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const drinkSelect = document.getElementById('drink');
+      const roastSelect = document.getElementById('roast');
+      const sizeSelect = document.getElementById('size');
+      const tempSelect = document.getElementById('temperature');
+      const milkSelect = document.getElementById('milk');
+      const sweetnessSelect = document.getElementById('sweetness');
+      const quantityInput = document.getElementById('quantity');
+      const pricePreview = document.getElementById('price-preview');
+      const orderResult = document.getElementById('order-result');
+      const recommendationBox = document.getElementById('finder-recommendation');
+      const statusBadge = document.getElementById('agent-tool-status');
+      const chipButtons = document.querySelectorAll('.chip-btn');
+
+      const presets = {
+        cozy: {
+          drink: 'maple-oat-latte',
+          roast: 'medium',
+          size: 'medium',
+          temperature: 'hot',
+          milk: 'oat',
+          sweetness: 'maple',
+          reason: 'Recommended: Maple Oat Latte — velvety oat milk infused with real Vermont maple syrup.'
+        },
+        bold: {
+          drink: 'dark-roast-espresso',
+          roast: 'dark',
+          size: 'small',
+          temperature: 'hot',
+          milk: 'none',
+          sweetness: 'unsweetened',
+          reason: 'Recommended: Dark Roast Espresso — intense, smokey richness for an immediate morning boost.'
+        },
+        smooth: {
+          drink: 'cold-brew',
+          roast: 'medium',
+          size: 'large',
+          temperature: 'iced',
+          milk: 'oat',
+          sweetness: 'half-sweet',
+          reason: 'Recommended: 18-Hour Cold Brew — low-acidity, silky smooth, and served chilled over ice.'
+        },
+        bright: {
+          drink: 'pour-over',
+          roast: 'light',
+          size: 'medium',
+          temperature: 'hot',
+          milk: 'none',
+          sweetness: 'unsweetened',
+          reason: 'Recommended: Single-Origin Pour Over — highlights crisp citrus and floral tasting notes.'
+        }
+      };
+
+      function calculateTotal() {
+        const selectedDrink = drinkSelect.options[drinkSelect.selectedIndex];
+        const basePrice = selectedDrink ? parseFloat(selectedDrink.getAttribute('data-price') || '4.75') : 4.75;
+        const selectedSize = sizeSelect.options[sizeSelect.selectedIndex];
+        const upcharge = selectedSize ? parseFloat(selectedSize.getAttribute('data-upcharge') || '0') : 0;
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        const total = (basePrice + upcharge) * qty;
+        pricePreview.textContent = `Estimated Total: $${total.toFixed(2)}`;
+        return total.toFixed(2);
+      }
+
+      chipButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const key = btn.getAttribute('data-preset');
+          const preset = presets[key];
+          if (!preset) return;
+
+          chipButtons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+
+          drinkSelect.value = preset.drink;
+          roastSelect.value = preset.roast;
+          sizeSelect.value = preset.size;
+          tempSelect.value = preset.temperature;
+          milkSelect.value = preset.milk;
+          sweetnessSelect.value = preset.sweetness;
+
+          recommendationBox.textContent = preset.reason;
+          recommendationBox.style.display = 'block';
+          calculateTotal();
+        });
+      });
+
+      form.addEventListener('input', calculateTotal);
+      form.addEventListener('change', calculateTotal);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const formData = new FormData(form);
+        const drinkLabel = drinkSelect.options[drinkSelect.selectedIndex]?.text.replace(/\s*\(\$[\d.]+\)/, '') || formData.get('drink');
+        const total = calculateTotal();
+        const orderId = 'DG-' + Math.floor(100000 + Math.random() * 900000);
+
+        const summary = {
+          orderId,
+          status: 'confirmed',
+          customerName: formData.get('customerName') || 'Guest',
+          drink: formData.get('drink'),
+          drinkName: drinkLabel,
+          roast: formData.get('roast'),
+          size: formData.get('size'),
+          temperature: formData.get('temperature'),
+          milk: formData.get('milk'),
+          sweetness: formData.get('sweetness'),
+          quantity: Number(formData.get('quantity') || 1),
+          pickupLocation: formData.get('pickupLocation'),
+          notes: formData.get('notes') || '',
+          totalPrice: `$${total}`,
+          submittedByAgent: Boolean(event.agentInvoked)
+        };
+
+        orderResult.style.display = 'block';
+        orderResult.innerHTML = '';
+
+        const heading = document.createElement('h3');
+        heading.textContent = `Order Confirmed (${summary.orderId})`;
+
+        const details = document.createElement('p');
+        details.textContent = `${summary.quantity}x ${summary.size} ${summary.temperature} ${summary.drinkName} (${summary.roast} roast, ${summary.milk} milk, ${summary.sweetness}) for ${summary.customerName}. Ready for pickup at ${summary.pickupLocation} in ~5 mins. Total: ${summary.totalPrice}.`;
+
+        orderResult.appendChild(heading);
+        orderResult.appendChild(details);
+
+        if (typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(summary));
+        }
+      });
+
+      const contextTarget = document.modelContext || window;
+      if (contextTarget && typeof contextTarget.addEventListener === 'function') {
+        contextTarget.addEventListener('toolactivated', (e) => {
+          if (!e || !e.toolName || e.toolName === 'quick_order_coffee') {
+            statusBadge.textContent = 'AI Agent Active: Filling Quick-Order Form...';
+            calculateTotal();
+          }
+        });
+        contextTarget.addEventListener('toolcancel', (e) => {
+          if (!e || !e.toolName || e.toolName === 'quick_order_coffee') {
+            statusBadge.textContent = 'AI Agent Tool Ready (WebMCP Declarative Form)';
+          }
+        });
+      }
+
+      calculateTotal();
+    })();
+  </script>
 </body>
 
