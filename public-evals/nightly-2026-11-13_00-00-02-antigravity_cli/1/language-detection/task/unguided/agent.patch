+  <script>
+    (function () {
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-language-btn');
+      const resultEl = document.getElementById('language-result');
+
+      const languageNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      function getLanguageName(code) {
+        if (!code) return 'Unknown';
+        const fallbackMap = {
+          en: 'English', es: 'Spanish', fr: 'French', de: 'German',
+          it: 'Italian', pt: 'Portuguese', nl: 'Dutch', ru: 'Russian',
+          zh: 'Chinese', ja: 'Japanese', ko: 'Korean', ar: 'Arabic',
+          hi: 'Hindi', tr: 'Turkish', pl: 'Polish', sv: 'Swedish',
+          vi: 'Vietnamese', el: 'Greek', he: 'Hebrew', th: 'Thai'
+        };
+        if (languageNames) {
+          try {
+            const name = languageNames.of(code);
+            if (name && name.toLowerCase() !== code.toLowerCase()) {
+              return name;
+            }
+          } catch (e) {}
+        }
+        const base = code.split('-')[0].toLowerCase();
+        return fallbackMap[base] || code;
+      }
+
+      function detectLanguageHeuristic(text) {
+        const trimmed = text.trim();
+        if (!trimmed) return null;
+
+        // Script checks for non-Latin scripts
+        if (/[\u3040-\u309F\u30A0-\u30FF]/.test(trimmed)) return { code: 'ja', name: 'Japanese', confidence: 0.96 };
+        if (/[\uAC00-\uD7AF\u1100-\u11FF]/.test(trimmed)) return { code: 'ko', name: 'Korean', confidence: 0.96 };
+        if (/[\u4E00-\u9FFF]/.test(trimmed)) return { code: 'zh', name: 'Chinese', confidence: 0.94 };
+        if (/[\u0600-\u06FF]/.test(trimmed)) return { code: 'ar', name: 'Arabic', confidence: 0.95 };
+        if (/[\u0400-\u04FF]/.test(trimmed)) return { code: 'ru', name: 'Russian', confidence: 0.92 };
+        if (/[\u0900-\u097F]/.test(trimmed)) return { code: 'hi', name: 'Hindi', confidence: 0.95 };
+        if (/[\u0370-\u03FF]/.test(trimmed)) return { code: 'el', name: 'Greek', confidence: 0.95 };
+        if (/[\u0590-\u05FF]/.test(trimmed)) return { code: 'he', name: 'Hebrew', confidence: 0.95 };
+        if (/[\u0E00-\u0E7F]/.test(trimmed)) return { code: 'th', name: 'Thai', confidence: 0.95 };
+
+        const lower = trimmed.toLowerCase();
+        const words = lower.split(/[^\p{L}]+/u).filter(Boolean);
+
+        const profiles = [
+          {
+            code: 'es', name: 'Spanish',
+            chars: /[ñ¿¡]/,
+            words: new Set(['el', 'la', 'los', 'las', 'de', 'que', 'en', 'un', 'una', 'por', 'con', 'para', 'muy', 'bueno', 'café', 'gracias', 'hola', 'este', 'esta', 'pero', 'como', 'más', 'me', 'gusta', 'delicioso', 'servicio', 'excelente'])
+          },
+          {
+            code: 'fr', name: 'French',
+            chars: /[œæç]/,
+            words: new Set(['le', 'la', 'les', 'de', 'des', 'un', 'une', 'et', 'est', 'en', 'que', 'pour', 'dans', 'très', 'bon', 'café', 'merci', 'bonjour', 'avec', 'plus', 'ce', 'cette', 'mais', 'nous', 'vous', 'délicieux', 'excellent'])
+          },
+          {
+            code: 'de', name: 'German',
+            chars: /[äöüß]/,
+            words: new Set(['der', 'die', 'das', 'und', 'in', 'den', 'von', 'zu', 'mit', 'sich', 'auf', 'für', 'nicht', 'ist', 'ein', 'eine', 'sehr', 'gut', 'kaffee', 'danke', 'hallo', 'ich', 'wir', 'sie', 'aber', 'lecker'])
+          },
+          {
+            code: 'it', name: 'Italian',
+            chars: /[ìòù]/,
+            words: new Set(['il', 'lo', 'la', 'gli', 'le', 'di', 'che', 'in', 'un', 'una', 'per', 'con', 'non', 'molto', 'buono', 'caffè', 'grazie', 'ciao', 'questo', 'questa', 'ma', 'come', 'più', 'ottimo', 'delizioso'])
+          },
+          {
+            code: 'pt', name: 'Portuguese',
+            chars: /[ãõç]/,
+            words: new Set(['o', 'a', 'os', 'as', 'de', 'que', 'em', 'um', 'uma', 'para', 'com', 'não', 'muito', 'bom', 'café', 'obrigado', 'obrigada', 'olá', 'este', 'esta', 'mas', 'como', 'mais', 'gostoso', 'excelente'])
+          },
+          {
+            code: 'nl', name: 'Dutch',
+            chars: null,
+            words: new Set(['de', 'het', 'een', 'en', 'van', 'in', 'is', 'op', 'te', 'dat', 'voor', 'met', 'zijn', 'niet', 'aan', 'er', 'zeer', 'lekker', 'koffie', 'bedankt', 'hallo', 'goed', 'maar'])
+          },
+          {
+            code: 'en', name: 'English',
+            chars: null,
+            words: new Set(['the', 'and', 'to', 'of', 'in', 'is', 'it', 'for', 'that', 'with', 'on', 'was', 'are', 'this', 'have', 'from', 'but', 'not', 'they', 'very', 'good', 'great', 'coffee', 'love', 'best', 'thank', 'thanks', 'hello', 'delicious', 'service'])
+          }
+        ];
+
+        let best = { code: 'en', name: 'English', score: 0 };
+
+        for (const profile of profiles) {
+          let score = 0;
+          if (profile.chars && profile.chars.test(lower)) {
+            score += 2.5;
+          }
+          for (const w of words) {
+            if (profile.words.has(w)) {
+              score += 1;
+            }
+          }
+          if (score > best.score) {
+            best = { code: profile.code, name: profile.name, score };
+          }
+        }
+
+        const confidence = Math.min(0.95, Math.max(0.65, 0.6 + best.score * 0.08));
+        return { code: best.code, name: best.name, confidence };
+      }
+
+      async function detectLanguage(text) {
+        const trimmed = text.trim();
+        if (!trimmed) return null;
+
+        // Try browser built-in LanguageDetector API if available
+        try {
+          const detectorFactory =
+            (typeof LanguageDetector !== 'undefined' && LanguageDetector) ||
+            (window.ai && window.ai.languageDetector) ||
+            (window.translation && window.translation.createDetector ? { create: () => window.translation.createDetector() } : null);
+
+          if (detectorFactory && typeof detectorFactory.create === 'function') {
+            const detector = await detectorFactory.create();
+            if (detector && typeof detector.detect === 'function') {
+              const results = await detector.detect(trimmed);
+              if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage) {
+                const top = results[0];
+                const code = top.detectedLanguage;
+                return {
+                  code,
+                  name: getLanguageName(code),
+                  confidence: typeof top.confidence === 'number' ? top.confidence : 0.9
+                };
+              }
+            }
+          }
+        } catch (err) {
+          // Fallback to heuristic language detection
+        }
+
+        return detectLanguageHeuristic(trimmed);
+      }
+
+      detectBtn.addEventListener('click', async () => {
+        const text = textarea.value;
+        resultEl.style.display = 'block';
+
+        if (!text || !text.trim()) {
+          resultEl.textContent = 'Please enter a feedback message to detect its language.';
+          return;
+        }
+
+        resultEl.textContent = 'Detecting language...';
+        const detected = await detectLanguage(text);
+
+        if (!detected) {
+          resultEl.textContent = 'Could not detect the language.';
+          return;
+        }
+
+        const pct = Math.round((detected.confidence || 0.9) * 100);
+        resultEl.textContent = `Detected Language: ${detected.name} (${detected.code.toUpperCase()}) — ${pct}% confidence`;
+      });
+    })();
+  </script>
+
 </body>
 
