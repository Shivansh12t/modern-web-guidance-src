+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const textarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const resultEl = document.getElementById('detection-result');
+
+    const languageNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+      ? new Intl.DisplayNames(['en'], { type: 'language' })
+      : null;
+
+    function formatLanguage(tag) {
+      if (!tag) return 'Unknown';
+      try {
+        const name = languageNames ? languageNames.of(tag) : tag;
+        return name && name !== tag ? `${name} (${tag})` : tag;
+      } catch {
+        return tag;
+      }
+    }
+
+    function showResult(message, state = 'info') {
+      resultEl.dataset.state = state;
+      resultEl.textContent = message;
+    }
+
+    textarea.addEventListener('input', () => {
+      if (textarea.getAttribute('aria-invalid') === 'true' && textarea.value.trim().length > 0) {
+        textarea.removeAttribute('aria-invalid');
+        textarea.setCustomValidity('');
+      }
+    });
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      detectBtn.click();
+    });
+
+    let detectorInstance = null;
+
+    async function initLanguageDetection() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showResult(
+          'Client-side language detection is currently unsupported in this browser.',
+          'error'
+        );
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+
+        if (availability === 'unavailable') {
+          detectBtn.disabled = true;
+          showResult(
+            'Client-side language detection model is unavailable on this device.',
+            'error'
+          );
+          return;
+        }
+
+        detectBtn.addEventListener('click', async () => {
+          const userText = textarea.value.trim();
+
+          if (!userText) {
+            textarea.setAttribute('aria-invalid', 'true');
+            textarea.setCustomValidity('Please enter a feedback message to detect its language.');
+            showResult('Please enter a feedback message before detecting the language.', 'error');
+            textarea.focus();
+            return;
+          }
+
+          textarea.removeAttribute('aria-invalid');
+          textarea.setCustomValidity('');
+          detectBtn.disabled = true;
+
+          try {
+            if (!detectorInstance) {
+              detectorInstance = await LanguageDetector.create({
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    const progress = Math.round((e.loaded || 0) * 100);
+                    console.log(`Downloaded ${e.loaded * 100}%`);
+                    showResult(`Downloading language detection model: ${progress}%...`);
+                  });
+                },
+              });
+            }
+
+            const results = await detectorInstance.detect(userText);
+
+            for (const result of results) {
+              console.log(result.detectedLanguage, result.confidence);
+            }
+
+            if (Array.isArray(results) && results.length > 0) {
+              const topResult = results[0];
+              const readableLang = formatLanguage(topResult.detectedLanguage);
+              const confidencePct = (topResult.confidence * 100).toFixed(1);
+              textarea.setAttribute('lang', topResult.detectedLanguage);
+
+              const shortTextNotice = userText.split(/\s+/).length < 3
+                ? ' (Note: short phrases may have lower detection accuracy.)'
+                : '';
+
+              showResult(
+                `Detected language: ${readableLang} — ${confidencePct}% confidence${shortTextNotice}`
+              );
+            } else {
+              showResult('Could not determine the language of the message.', 'error');
+            }
+          } catch (err) {
+            console.error(err);
+            showResult('Unable to detect language at this time.', 'error');
+          } finally {
+            detectBtn.disabled = false;
+          }
+        });
+      } catch (err) {
+        console.error(err);
+        detectBtn.disabled = true;
+        showResult(
+          'Client-side language detection is currently unavailable.',
+          'error'
+        );
+      }
+    }
+
+    initLanguageDetection();
+  </script>
 </body>
 
