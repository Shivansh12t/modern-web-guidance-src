+  <!-- Early connection & preload hints for the A/B testing SDK -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="dns-prefetch" href="https://cdn.example.com">
+  <link rel="preload" href="https://cdn.example.com/experiment-sdk.js" as="script">
+
+  <!-- Scoped Anti-Flicker CSS: hides experiment targets until variant is applied while preserving layout box (0 CLS) -->
+  <style id="ab-anti-flicker">
+    html.ab-loading .hero,
+    html.ab-loading .hero h1,
+    html.ab-loading .hero p,
+    html.ab-loading .hero button,
+    html.ab-loading [data-experiment],
+    html.ab-loading [data-experiment-target] {
+      opacity: 0 !important;
+      visibility: hidden !important;
+      pointer-events: none !important;
+    }
+
+    .hero,
+    [data-experiment],
+    [data-experiment-target] {
+      transition: opacity 0.12s ease-out;
+    }
+  </style>
+  <noscript>
+    <style>
+      html.ab-loading .hero,
+      html.ab-loading .hero h1,
+      html.ab-loading .hero p,
+      html.ab-loading .hero button,
+      html.ab-loading [data-experiment],
+      html.ab-loading [data-experiment-target] {
+        opacity: 1 !important;
+        visibility: visible !important;
+        pointer-events: auto !important;
+      }
+    </style>
+  </noscript>
+
+  <!-- Anti-Flicker Controller & Fail-Safe Timeout -->
+  <script>
+    (function () {
+      var docEl = document.documentElement;
+      docEl.classList.add('ab-loading');
+      var revealed = false;
+      var sdkSettled = false;
+      var domReady = document.readyState !== 'loading';
+
+      function revealContent() {
+        if (revealed) return;
+        revealed = true;
+        clearTimeout(fallbackTimer);
+        docEl.classList.remove('ab-loading');
+        docEl.setAttribute('data-ab-ready', 'true');
+      }
+
+      function checkReady() {
+        if (sdkSettled && domReady) {
+          // Wait one microtask so any DOMContentLoaded listeners registered by the SDK run first
+          Promise.resolve().then(revealContent);
+        }
+      }
+
+      // Bounded fail-safe timeout so slow/unreachable networks never block LCP indefinitely
+      var fallbackTimer = setTimeout(revealContent, 600);
+
+      window.__onExperimentSdkSettled = function () {
+        sdkSettled = true;
+        checkReady();
+      };
+
+      if (!domReady) {
+        document.addEventListener('DOMContentLoaded', function () {
+          domReady = true;
+          checkReady();
+        });
+      }
+
+      window.addEventListener('experiment:ready', revealContent);
+    })();
+  </script>
+
+  <!-- A/B Testing Script -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    defer
+    onload="window.__onExperimentSdkSettled()"
+    onerror="window.__onExperimentSdkSettled()"
+  ></script>
