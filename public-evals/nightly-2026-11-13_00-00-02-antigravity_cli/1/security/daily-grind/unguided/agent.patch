+(function () {
+  'use strict';
+
+  // 1. Trusted Types default policy to mitigate DOM XSS injection sinks
+  if (window.trustedTypes && typeof window.trustedTypes.createPolicy === 'function') {
+    try {
+      if (!window.trustedTypes.defaultPolicy) {
+        window.trustedTypes.createPolicy('default', {
+          createHTML: function (input) {
+            return String(input)
+              .replace(/&/g, '&amp;')
+              .replace(/</g, '&lt;')
+              .replace(/>/g, '&gt;')
+              .replace(/"/g, '&quot;')
+              .replace(/'/g, '&#39;');
+          },
+          createScriptURL: function (input) {
+            const url = new URL(input, window.location.origin);
+            if (url.origin !== window.location.origin) {
+              throw new TypeError('Cross-origin script URLs are blocked by Trusted Types policy.');
+            }
+            return url.href;
+          },
+          createScript: function () {
+            throw new TypeError('Dynamic script evaluation is blocked by Trusted Types policy.');
+          }
+        });
+      }
+    } catch (_) {
+      // Default policy already registered or restricted by environment
+    }
+  }
+
+  // 2. Client-side Content Security Policy (CSP) violation monitoring & reporting
+  document.addEventListener('securitypolicyviolation', function (event) {
+    const payload = JSON.stringify({
+      'csp-report': {
+        'document-uri': event.documentURI,
+        'referrer': event.referrer,
+        'blocked-uri': event.blockedURI,
+        'violated-directive': event.violatedDirective,
+        'effective-directive': event.effectiveDirective,
+        'original-policy': event.originalPolicy,
+        'disposition': event.disposition,
+        'source-file': event.sourceFile,
+        'line-number': event.lineNumber,
+        'column-number': event.columnNumber,
+        'status-code': event.statusCode
+      }
+    });
+
+    if (navigator.sendBeacon) {
+      const blob = new Blob([payload], { type: 'application/csp-report' });
+      navigator.sendBeacon('/csp-report', blob);
+    } else if (window.fetch) {
+      window.fetch('/csp-report', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/csp-report' },
+        body: payload,
+        credentials: 'same-origin',
+        keepalive: true
+      }).catch(function () {});
+    }
+  });
+
+  // 3. Harden links & protect state-changing /logout route on DOM ready
+  function initSecurityMeasures() {
+    // Ensure external links cannot access window.opener (reverse tabnabbing protection)
+    const links = document.querySelectorAll('a[href]');
+    links.forEach(function (link) {
+      const href = link.getAttribute('href') || '';
+      const isExternal = /^https?:\/\//i.test(href) && !href.startsWith(window.location.origin);
+      if (isExternal || link.getAttribute('target') === '_blank') {
+        const relValues = new Set((link.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
+        relValues.add('noopener');
+        relValues.add('noreferrer');
+        link.setAttribute('rel', Array.from(relValues).join(' '));
+      }
+    });
+
+    // Convert state-changing /logout link clicks into POST requests and clear client storage
+    const logoutLinks = document.querySelectorAll('a.logout-link, a[href="/logout"]');
+    logoutLinks.forEach(function (logoutLink) {
+      logoutLink.setAttribute('rel', 'nofollow noopener noreferrer');
+      logoutLink.setAttribute('data-no-prefetch', 'true');
+
+      logoutLink.addEventListener('click', function (event) {
+        event.preventDefault();
+
+        try {
+          window.localStorage.clear();
+          window.sessionStorage.clear();
+        } catch (_) {
+          // Storage access may be restricted
+        }
+
+        const form = document.createElement('form');
+        form.method = 'POST';
+        form.action = '/logout';
+        form.style.display = 'none';
+        document.body.appendChild(form);
+        form.submit();
+      });
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initSecurityMeasures);
+  } else {
+    initSecurityMeasures();
+  }
+})();
