+  <script>
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const applySiblingFallback = (container) => {
+        if (!container) return;
+        const children = Array.from(container.children);
+        children.forEach((child, index) => {
+          child.style.setProperty('--sibling-index', index + 1);
+          child.style.setProperty('--sibling-count', children.length);
+        });
+      };
+
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach((container) => {
+        applySiblingFallback(container);
+        new MutationObserver(() => applySiblingFallback(container)).observe(container, {
+          childList: true,
+        });
+      });
+    }
+  </script>
+
