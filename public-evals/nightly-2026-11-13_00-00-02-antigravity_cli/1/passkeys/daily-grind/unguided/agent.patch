+      // WebAuthn Assertion (`navigator.credentials.get`) for Sign-In & Step-Up Reauthentication
+      async function runPasskeyAssertionCeremony(options) {
+        const targetUser = options.user || null;
+        const preferredCredentialId = options.credentialId || null;
+        const purpose = options.purpose || 'authentication';
+        const challengeBytes = randomBytes(32);
+        const challengeB64 = bufferToBase64url(challengeBytes);
+
+        let allowCredentials = [];
+        if (preferredCredentialId) {
+          allowCredentials = [{
+            id: base64urlToBuffer(preferredCredentialId),
+            type: 'public-key'
+          }];
+        } else if (targetUser && Array.isArray(targetUser.passkeys)) {
+          allowCredentials = targetUser.passkeys.map(pk => ({
+            id: base64urlToBuffer(pk.credentialId),
+            type: 'public-key',
+            transports: pk.transports || ['internal']
+          }));
+        }
+
+        const publicKeyCredentialRequestOptions = {
+          challenge: challengeBytes,
+          rpId: getRpId(),
+          timeout: 60000,
+          userVerification: 'required',
+          allowCredentials
+        };
+
+        logCeremony('navigator.credentials.get() invoked (' + purpose + ')', {
+          rpId: publicKeyCredentialRequestOptions.rpId,
+          allowCredentialsCount: allowCredentials.length,
+          userVerification: 'required',
+          challenge: challengeB64.slice(0, 16) + '...'
+        });
+
+        let assertedCred = null;
+        const canUseNative = Boolean(
+          window.PublicKeyCredential &&
+          navigator.credentials &&
+          typeof navigator.credentials.get === 'function' &&
+          !store.virtualAuthenticatorEnabled
+        );
+
+        if (canUseNative) {
+          try {
+            assertedCred = await navigator.credentials.get({
+              publicKey: publicKeyCredentialRequestOptions
+            });
+          } catch (err) {
+            logCeremony('Native WebAuthn assertion skipped/cancelled; using Virtual Passkey Authenticator', {
+              error: err && err.message ? err.message : String(err)
+            });
+          }
+        }
+
+        // Resolve matched user & passkey
+        let resolvedUser = targetUser;
+        let resolvedPasskey = null;
+
+        if (assertedCred && assertedCred.rawId) {
+          const rawIdB64 = bufferToBase64url(assertedCred.rawId);
+          for (const u of store.users) {
+            const found = u.passkeys.find(pk => pk.credentialId === rawIdB64);
+            if (found) {
+              resolvedUser = u;
+              resolvedPasskey = found;
+              break;
+            }
+          }
+        }
+
+        if (!resolvedUser) {
+          resolvedUser = store.users.find(u => u.passkeys && u.passkeys.length > 0) || null;
+        }
+
+        if (!resolvedUser || !resolvedUser.passkeys || resolvedUser.passkeys.length === 0) {
+          throw new Error('No registered passkeys found for this customer account.');
+        }
+
+        if (!resolvedPasskey) {
+          if (preferredCredentialId) {
+            resolvedPasskey = resolvedUser.passkeys.find(pk => pk.credentialId === preferredCredentialId) || resolvedUser.passkeys[0];
+          } else {
+            resolvedPasskey = resolvedUser.passkeys[0];
+          }
+        }
+
+        resolvedPasskey.signCount = (Number(resolvedPasskey.signCount) || 0) + 1;
+        resolvedPasskey.lastUsedAt = new Date().toISOString();
+        store.activePasskeyId = resolvedPasskey.credentialId;
+
+        logCeremony('AuthenticatorAssertionResponse verified', {
+          user: resolvedUser.email,
+          credentialId: resolvedPasskey.credentialId,
+          signCount: resolvedPasskey.signCount,
+          purpose
+        });
+
+        return {
+          user: resolvedUser,
+          passkey: resolvedPasskey
+        };
+      }
