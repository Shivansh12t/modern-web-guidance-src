+          strictReauth: true,
+          rewardPoints: 100,
+          createdAt: new Date().toISOString(),
+          passkeys: []
+        };
+
+        try {
+          const passkeyRecord = await runPasskeyCreationCeremony({
+            user: newUser,
+            passkeyLabel,
+            authenticatorAttachment
+          });
+
+          newUser.passkeys.push(passkeyRecord);
+          store.users.push(newUser);
+          store.currentUserId = newUser.id;
+          store.activePasskeyId = passkeyRecord.credentialId;
+          store.lastReauthAt = Date.now();
+          saveStore();
+
+          nameInput.value = '';
+          emailInput.value = '';
+          labelInput.value = '';
+
+          renderAll();
+          showStatusToast(
+            'Welcome to The Daily Grind, ' + newUser.displayName + '! Your account and passkey "' + passkeyRecord.name + '" are registered.',
+            'success'
+          );
+        } catch (err) {
+          showStatusToast('Passkey registration could not be completed: ' + (err.message || err), 'error');
+        }
+      }
+
+      // Sign-In Authentication Handler
+      async function handlePasskeySignIn(emailOverride) {
+        const emailInput = document.getElementById('signin-email');
+        const email = (typeof emailOverride === 'string' ? emailOverride : (emailInput ? emailInput.value : '')).trim().toLowerCase();
+
+        let targetUser = null;
+        if (email) {
+          targetUser = store.users.find(u => u.email.toLowerCase() === email) || null;
+          if (!targetUser) {
+            showStatusToast('No customer account found for "' + email + '". Register a new account with a passkey on the right!', 'warning');
+            return;
+          }
+        }
+
+        try {
+          const result = await runPasskeyAssertionCeremony({
+            user: targetUser,
+            purpose: email ? 'user-identified-signin' : 'discoverable-passkey-signin'
+          });
+
+          store.currentUserId = result.user.id;
+          store.lastReauthAt = Date.now();
+          saveStore();
+          renderAll();
+
+          showStatusToast(
+            'Signed in as ' + result.user.displayName + ' using passkey "' + result.passkey.name + '".',
+            'success'
+          );
+        } catch (err) {
+          showStatusToast('Passkey sign-in failed: ' + (err.message || err), 'error');
+        }
+      }
+
+      // Add Saved Passkey Handler
+      async function handleAddPasskey(event) {
+        event.preventDefault();
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const nameInput = document.getElementById('new-passkey-name');
+        const typeSelect = document.getElementById('new-passkey-type');
+        const nickname = (nameInput.value || '').trim() ||
+          (typeSelect.value === 'cross-platform' ? 'Hardware Security Key #' + (user.passkeys.length + 1) : 'Passkey Device #' + (user.passkeys.length + 1));
+        const attachment = typeSelect.value || 'platform';
+
+        const executeAdd = async () => {
+          try {
+            const newPasskey = await runPasskeyCreationCeremony({
+              user,
+              passkeyLabel: nickname,
+              authenticatorAttachment: attachment
+            });
+            user.passkeys.push(newPasskey);
+            store.activePasskeyId = newPasskey.credentialId;
+            store.lastReauthAt = Date.now();
+            saveStore();
+            nameInput.value = '';
+            renderAll();
+            showStatusToast('Added new saved passkey "' + newPasskey.name + '" to your account.', 'success');
+          } catch (err) {
+            showStatusToast('Could not add passkey: ' + (err.message || err), 'error');
+          }
+        };
+
+        if (user.strictReauth !== false && !isReauthFresh()) {
+          openReauthModal(
+            'Please verify your identity with an existing passkey before registering a new passkey on your account.',
+            executeAdd
+          );
+        } else {
+          await executeAdd();
+        }
+      }
+
+      // Rename Saved Passkey
+      function openRenamePasskeyModal(credentialId) {
+        const user = getCurrentUser();
+        if (!user) return;
+        const pk = user.passkeys.find(item => item.credentialId === credentialId);
+        if (!pk) return;
+
+        renamingCredentialId = credentialId;
+        const input = document.getElementById('rename-passkey-input');
+        input.value = pk.name;
+        document.getElementById('rename-modal-backdrop').classList.remove('hidden');
+        input.focus();
+      }
+
+      function closeRenamePasskeyModal() {
+        renamingCredentialId = null;
+        document.getElementById('rename-modal-backdrop').classList.add('hidden');
+      }
+
+      // Delete Saved Passkey (Requires Reauthentication if strict mode)
+      function handleDeletePasskey(credentialId) {
+        const user = getCurrentUser();
+        if (!user) return;
+
+        if (user.passkeys.length <= 1) {
+          showStatusToast('Cannot remove your only saved passkey. Register a backup passkey first so you never lose access.', 'warning');
+          return;
+        }
+
+        const targetPk = user.passkeys.find(pk => pk.credentialId === credentialId);
+        if (!targetPk) return;
+
+        const performDelete = () => {
+          user.passkeys = user.passkeys.filter(pk => pk.credentialId !== credentialId);
+          if (store.activePasskeyId === credentialId && user.passkeys.length > 0) {
+            store.activePasskeyId = user.passkeys[0].credentialId;
+          }
+          saveStore();
+          renderAll();
+          logCeremony('Saved passkey revoked from account', {
+            credentialId,
+            name: targetPk.name
+          });
+          showStatusToast('Removed passkey "' + targetPk.name + '" from your account.', 'info');
+        };
+
+        if (user.strictReauth !== false && !isReauthFresh()) {
+          openReauthModal(
+            'Step-up passkey reauthentication is required before revoking saved passkey "' + targetPk.name + '".',
+            performDelete
+          );
+        } else {
+          performDelete();
+        }
+      }
+
+      // Profile Updates Handler (with Reauthentication gate for sensitive changes)
+      async function handleProfileUpdate(event, forceReauth) {
+        if (event) event.preventDefault();
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const newName = (document.getElementById('profile-name').value || '').trim();
+        const newEmail = (document.getElementById('profile-email').value || '').trim().toLowerCase();
+        const newPhone = (document.getElementById('profile-phone').value || '').trim();
+        const newDrink = document.getElementById('profile-drink').value;
+        const newRoastNote = (document.getElementById('profile-roast-note').value || '').trim();
+
+        if (!newName || !newEmail) {
+          showStatusToast('Full name and email address cannot be empty.', 'warning');
+          return;
+        }
+
+        const sensitiveChanged =
+          newEmail !== (user.email || '').toLowerCase() ||
+          newPhone !== (user.phone || '');
+
+        const commitProfileSave = () => {
+          user.displayName = newName;
+          user.email = newEmail;
+          user.phone = newPhone;
+          user.favoriteDrink = newDrink;
+          user.roastNote = newRoastNote;
+          saveStore();
+          renderAll();
+          logCeremony('Customer profile updated', {
+            displayName: newName,
+            email: newEmail,
+            favoriteDrink: newDrink,
+            sensitiveChanged
+          });
+          showStatusToast('Profile and coffee preferences updated for ' + user.displayName + '.', 'success');
+        };
+
+        if (forceReauth || (sensitiveChanged && user.strictReauth !== false && !isReauthFresh())) {
+          openReauthModal(
+            sensitiveChanged
+              ? 'Changing your account email or phone number requires fresh passkey reauthentication.'
+              : 'Confirm your identity with a passkey to save your profile updates.',
+            commitProfileSave
+          );
+        } else {
+          commitProfileSave();
+        }
+      }
+
+      // Step-Up Reauthentication Modal & Ceremony
+      function openReauthModal(reasonText, onVerifiedCallback) {
+        const user = getCurrentUser();
+        if (!user) return;
+
+        pendingReauthCallback = typeof onVerifiedCallback === 'function' ? onVerifiedCallback : null;
+        document.getElementById('reauth-modal-reason').textContent =
+          reasonText || 'Verify your identity with a saved passkey to proceed with this sensitive account operation.';
+        document.getElementById('reauth-rp-id').textContent = getRpId();
+
+        const selectEl = document.getElementById('reauth-passkey-select');
+        selectEl.innerHTML = '';
+        (user.passkeys || []).forEach(pk => {
+          const opt = document.createElement('option');
+          opt.value = pk.credentialId;
+          opt.textContent = pk.name + ' (' + pk.credentialId.slice(0, 12) + '…)';
+          if (pk.credentialId === store.activePasskeyId) opt.selected = true;
+          selectEl.appendChild(opt);
+        });
+
+        document.getElementById('reauth-modal-backdrop').classList.remove('hidden');
+      }
+
+      function closeReauthModal() {
+        document.getElementById('reauth-modal-backdrop').classList.add('hidden');
+        pendingReauthCallback = null;
+      }
+
+      async function performStepUpReauthentication(options) {
+        const user = getCurrentUser();
+        if (!user) return false;
+
+        try {
+          const res = await runPasskeyAssertionCeremony({
+            user,
+            credentialId: options && options.credentialId ? options.credentialId : null,
+            purpose: 'step-up-reauthentication'
+          });
+
+          store.lastReauthAt = Date.now();
+          saveStore();
+          renderAll();
+
+          showStatusToast(
+            'Step-up passkey reauthentication verified with "' + res.passkey.name + '". Sensitive actions unlocked for 5 minutes.',
+            'success'
+          );
+          return true;
+        } catch (err) {
+          showStatusToast('Passkey reauthentication failed: ' + (err.message || err), 'error');
+          return false;
+        }
+      }
+
+      // Tab Filtering inside Authenticated Dashboard
+      function setupTabs() {
+        const tabButtons = document.querySelectorAll('.tab-btn');
+        const sections = document.querySelectorAll('[data-section]');
+
+        tabButtons.forEach(btn => {
+          btn.addEventListener('click', () => {
+            const targetTab = btn.getAttribute('data-tab');
+            tabButtons.forEach(b => {
+              const active = b === btn;
+              b.classList.toggle('active', active);
+              b.setAttribute('aria-selected', active ? 'true' : 'false');
+            });
+
+            sections.forEach(sec => {
+              if (targetTab === 'all' || sec.getAttribute('data-section') === targetTab) {
+                sec.classList.remove('hidden');
+              } else {
+                sec.classList.add('hidden');
+              }
+            });
+          });
+        });
+      }
+
+      // Initialize Event Listeners
+      function init() {
+        setupTabs();
+
+        // Virtual Authenticator toggle
+        const virtualToggle = document.getElementById('virtual-authenticator-toggle');
+        if (virtualToggle) {
+          virtualToggle.addEventListener('change', () => {
+            store.virtualAuthenticatorEnabled = virtualToggle.checked;
+            saveStore();
+            renderAll();
+            showStatusToast(
+              store.virtualAuthenticatorEnabled
+                ? 'Virtual Passkey Authenticator enabled for instant WebAuthn ceremonies.'
+                : 'Native browser/OS WebAuthn mode selected.',
+              'info'
+            );
+          });
+        }
+
+        // Dismiss status toast
+        document.getElementById('dismiss-toast-btn').addEventListener('click', () => {
+          document.getElementById('account-status-toast').classList.add('hidden');
+        });
+
+        // Clear WebAuthn ceremony log
+        document.getElementById('clear-log-btn').addEventListener('click', () => {
+          document.getElementById('webauthn-log-entries').innerHTML = '';
+        });
+
+        // Registration & Sign-In forms
+        document.getElementById('passkey-register-form').addEventListener('submit', handlePasskeyRegistration);
+        document.getElementById('passkey-signin-form').addEventListener('submit', async (e) => {
+          e.preventDefault();
+          await handlePasskeySignIn();
+        });
+        document.getElementById('discoverable-signin-btn').addEventListener('click', async () => {
+          await handlePasskeySignIn('');
+        });
+
+        // Add passkey form
+        document.getElementById('add-passkey-form').addEventListener('submit', handleAddPasskey);
+
+        // Profile update form
+        document.getElementById('profile-update-form').addEventListener('submit', (e) => handleProfileUpdate(e, false));
+        document.getElementById('save-profile-with-reauth-btn').addEventListener('click', () => handleProfileUpdate(null, true));
+
+        // Step-up reauthentication triggers
+        document.getElementById('trigger-reauth-btn').addEventListener('click', () => {
+          openReauthModal('Verify with your saved passkey to unlock a fresh 5-minute step-up security window.');
+        });
+        document.getElementById('panel-reauth-now-btn').addEventListener('click', () => {
+          openReauthModal('Perform step-up WebAuthn verification (`userVerification: "required"`) for high-security account actions.');
+        });
+        document.getElementById('expire-reauth-btn').addEventListener('click', () => {
+          store.lastReauthAt = null;
+          saveStore();
+          renderAll();
+          logCeremony('Step-up reauthentication window manually locked', {});
+          showStatusToast('Step-up reauthentication window locked. Sensitive actions now require passkey verification.', 'info');
+        });
+
+        // Protected security center actions
+        document.getElementById('security-strict-reauth-toggle').addEventListener('change', (e) => {
+          const user = getCurrentUser();
+          if (!user) return;
+          user.strictReauth = e.target.checked;
+          saveStore();
+          showStatusToast(
+            user.strictReauth
+              ? 'Strict passkey reauthentication enabled for sensitive actions.'
+              : 'Strict passkey reauthentication relaxed for this session.',
+            'info'
+          );
+        });
+
+        document.getElementById('update-payment-reauth-btn').addEventListener('click', () => {
+          const user = getCurrentUser();
+          if (!user) return;
+          const selectedCard = document.getElementById('security-payment-card').value;
+          const applyPayment = () => {
+            user.paymentMethod = selectedCard;
+            saveStore();
+            renderAll();
+            logCeremony('Default payment method updated after passkey reauth', { paymentMethod: selectedCard });
+            showStatusToast('Updated default rewards wallet payment method to ' + selectedCard + '.', 'success');
+          };
+
+          if (!isReauthFresh()) {
+            openReauthModal('Updating your default payment method requires passkey reauthentication.', applyPayment);
+          } else {
+            applyPayment();
+          }
+        });
+
+        document.getElementById('export-security-audit-btn').addEventListener('click', () => {
+          const user = getCurrentUser();
+          if (!user) return;
+          const doExport = () => {
+            logCeremony('Exported FIDO2/WebAuthn passkey security audit report', {
+              user: user.email,
+              passkeyCount: user.passkeys.length
+            });
+            showStatusToast('Passkey security audit log verified & exported for ' + user.email + '.', 'success');
+          };
+          if (!isReauthFresh()) {
+            openReauthModal('Exporting your passkey security audit report requires step-up reauthentication.', doExport);
+          } else {
+            doExport();
+          }
+        });
+
+        // Reauth Modal buttons
+        document.getElementById('reauth-modal-close').addEventListener('click', closeReauthModal);
+        document.getElementById('reauth-modal-cancel').addEventListener('click', closeReauthModal);
+        document.getElementById('reauth-modal-confirm').addEventListener('click', async () => {
+          const credId = document.getElementById('reauth-passkey-select').value;
+          const callback = pendingReauthCallback;
+          closeReauthModal();
+          const ok = await performStepUpReauthentication({ credentialId: credId });
+          if (ok && typeof callback === 'function') {
+            callback();
+          }
+        });
+
+        // Rename Modal buttons
+        document.getElementById('rename-modal-close').addEventListener('click', closeRenamePasskeyModal);
+        document.getElementById('rename-modal-cancel').addEventListener('click', closeRenamePasskeyModal);
+        document.getElementById('rename-passkey-form').addEventListener('submit', (e) => {
+          e.preventDefault();
+          const user = getCurrentUser();
+          if (!user || !renamingCredentialId) return;
+          const pk = user.passkeys.find(item => item.credentialId === renamingCredentialId);
+          const newName = (document.getElementById('rename-passkey-input').value || '').trim();
+          if (pk && newName) {
+            pk.name = newName;
+            saveStore();
+            renderAll();
+            logCeremony('Saved passkey renamed', { credentialId: pk.credentialId, name: newName });
+            showStatusToast('Passkey renamed to "' + newName + '".', 'success');
+          }
+          closeRenamePasskeyModal();
+        });
+
+        // Sign Out / Logout links
+        const handleSignOut = (e) => {
+          if (e) e.preventDefault();
+          const user = getCurrentUser();
+          const prevName = user ? user.displayName : 'Customer';
+          store.currentUserId = null;
+          store.lastReauthAt = null;
+          saveStore();
+          renderAll();
+          logCeremony('Customer signed out', { user: prevName });
+          showStatusToast('Signed out of ' + prevName + '\'s account. Sign back in anytime with your passkey.', 'info');
+        };
+
+        document.getElementById('dashboard-signout-btn').addEventListener('click', handleSignOut);
+        document.getElementById('nav-logout-btn').addEventListener('click', handleSignOut);
+
+        // Seasonal menu quick-order buttons
+        document.querySelectorAll('.quick-order-btn').forEach(btn => {
+          btn.addEventListener('click', () => {
+            const drink = btn.getAttribute('data-drink');
+            const user = getCurrentUser();
+            if (user) {
+              user.favoriteDrink = drink;
+              saveStore();
+              renderAll();
+              showStatusToast('Selected "' + drink + '" as your default Quick-Order drink in My Account!', 'success');
+            } else {
+              const regDrink = document.getElementById('register-drink');
+              if (regDrink) regDrink.value = drink;
+              showStatusToast('Sign in or register with a passkey to order your ' + drink + '!', 'info');
+            }
+          });
+        });
+
+        // Initial render + periodic countdown refresh
+        renderAll();
+        logCeremony('Daily Grind Passkey Account Module initialized', {
+          rpId: getRpId(),
+          webauthnSupported: Boolean(window.PublicKeyCredential),
+          registeredUsers: store.users.length
+        });
+
+        setInterval(() => {
+          if (getCurrentUser()) {
+            renderReauthStatus();
+          }
+        }, 1000);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
