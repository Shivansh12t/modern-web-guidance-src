+      { type: 'public-key', alg: -257 },
+    ],
+    excludeCredentials: userExistingCredentials.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal'],
+    })),
+    authenticatorSelection,
+  };
+}
+
+// 2. Passkey Registration Verification
+export async function registerVerifyFetch(encodedResponse, { customLabel } = {}) {
+  const db = loadDb();
+  if (!encodedResponse || !encodedResponse.id) {
+    return jsonResponse({ error: 'Invalid credential attestation payload.' }, 400);
+  }
+
+  const userId = db.session?.pendingUserId || db.currentUserId || db.users[0]?.id;
+  const user = db.users.find((u) => u.id === userId) || db.users[0];
+
+  const aaguid = extractAaguidFromAttestation(encodedResponse.response?.attestationObject);
+  const providerMeta = resolveProviderFromAaguid(aaguid);
+
+  const newCredential = {
+    id: encodedResponse.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: encodedResponse.response?.attestationObject || 'cHVibGljLWtleS1hdHRlc3RhdGlvbg',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid,
+    providerIcon: providerMeta.providerIcon,
+    name: customLabel || providerMeta.name,
+    transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+    registeredAt: Date.now(),
+    lastUsedAt: Date.now(),
+    counter: 0,
+  };
+
+  const existingIndex = db.credentials.findIndex((c) => c.id === newCredential.id);
+  if (existingIndex >= 0) {
+    db.credentials[existingIndex] = newCredential;
+  } else {
+    db.credentials.push(newCredential);
+  }
+
+  db.currentUserId = user.id;
+  db.reauthenticatedAt = Date.now();
+  saveDb(db);
+
+  return jsonResponse({
+    verified: true,
+    rpId: db.rpId,
+    userId: user.passkeyUserId,
+    credential: newCredential,
+    user,
+  });
+}
+
+// 3. Passkey Authentication Options (Discoverable sign-in)
+export async function loginOptionsFetch() {
+  const db = loadDb();
+  const challenge = generateBase64UrlRandom(32);
+  db.session = {
+    challenge,
+    expectedUserVerification: 'preferred',
+  };
+  saveDb(db);
+
+  return {
+    challenge,
+    rpId: db.rpId,
+    allowCredentials: [], // Discoverable credentials flow
+    userVerification: 'preferred',
+  };
+}
+
+// 4. Passkey Authentication Verification
+export async function loginVerifyFetch(encodedAssertion) {
+  const db = loadDb();
+  if (!encodedAssertion || !encodedAssertion.id) {
+    return jsonResponse({ error: 'Missing assertion credential ID.' }, 400);
+  }
+
+  const matchedCredential = db.credentials.find((c) => c.id === encodedAssertion.id);
+  if (!matchedCredential) {
+    // Explicit HTTP 404 when credential is not found so the client triggers signalUnknownCredential
+    return jsonResponse({ error: 'Credential not found on server.' }, 404);
+  }
+
+  matchedCredential.lastUsedAt = Date.now();
+  matchedCredential.counter = (matchedCredential.counter || 0) + 1;
+
+  const user =
+    db.users.find((u) => u.id === matchedCredential.passkeyUserId) || db.users[0];
+  db.currentUserId = user.id;
+  db.reauthenticatedAt = Date.now();
+  saveDb(db);
+
+  return jsonResponse({
+    verified: true,
+    rpId: db.rpId,
+    userId: user.passkeyUserId,
+    user,
+    credential: matchedCredential,
+  });
+}
+
+// 5. Password Sign-In / Registration Fallback
+export async function passwordAuthFetch({ mode = 'signin', name, displayName, password }) {
+  const db = loadDb();
+  if (!name || !password) {
+    return jsonResponse({ error: 'Email and password are required.' }, 400);
+  }
+  let user = db.users.find((u) => u.name.toLowerCase() === name.toLowerCase());
+  if (!user) {
+    const newUserId = generateBase64UrlRandom(16);
+    user = {
+      id: newUserId,
+      passkeyUserId: newUserId,
+      name,
+      displayName: displayName || name.split('@')[0],
+      favoriteRoast: 'Maple Oat Latte',
+      defaultLocation: 'Downtown Roastery — 412 Bean St',
+      rewardsPoints: mode === 'register' ? 150 : 320,
+    };
+    db.users.push(user);
+  } else if (displayName && mode === 'register') {
+    user.displayName = displayName;
+  }
+
+  db.currentUserId = user.id;
+  db.reauthenticatedAt = Date.now();
+  saveDb(db);
+
+  return jsonResponse({
+    authenticated: true,
+    rpId: db.rpId,
+    userId: user.passkeyUserId,
+    user,
+  });
+}
+
+// 6. Passkey Reauthentication Options (Constrained strictly to active user's registered credentials)
+export async function reauthOptionsFetch() {
+  const db = loadDb();
+  const user = db.users.find((u) => u.id === db.currentUserId) || db.users[0];
+  const userPasskeys = db.credentials.filter((c) => c.passkeyUserId === user.id);
+
+  const challenge = generateBase64UrlRandom(32);
+  db.session = {
+    challenge,
+    expectedUserVerification: 'preferred',
+    reauthUserId: user.id,
+  };
+  saveDb(db);
+
+  return {
+    challenge,
+    rpId: db.rpId,
+    userVerification: 'preferred',
+    // Strictly constrain allowCredentials to the signed-in user's registered passkeys
+    allowCredentials: userPasskeys.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal'],
+    })),
+  };
+}
+
+// 7. Passkey Reauthentication Verification (Verifies account ownership)
+export async function reauthVerifyFetch(encodedCredential) {
+  const db = loadDb();
+  const activeUserId = db.currentUserId || db.users[0]?.id;
+
+  if (!encodedCredential || !encodedCredential.id) {
+    return jsonResponse({ error: 'Invalid assertion response.' }, 400);
+  }
+
+  const storedCredential = db.credentials.find((c) => c.id === encodedCredential.id);
+  if (!storedCredential) {
+    // Explicit 404 so client can invoke PublicKeyCredential.signalUnknownCredential
+    return jsonResponse({ error: 'Passkey credential not found.' }, 404);
+  }
+
+  // Strictly enforce account ownership match
+  if (storedCredential.passkeyUserId !== activeUserId) {
+    return jsonResponse(
+      { error: 'Credential does not belong to the currently signed-in account.' },
+      403
+    );
+  }
+
+  storedCredential.lastUsedAt = Date.now();
+  storedCredential.counter = (storedCredential.counter || 0) + 1;
+  db.reauthenticatedAt = Date.now();
+  saveDb(db);
+
+  return jsonResponse({
+    verified: true,
+    reauthenticatedAt: db.reauthenticatedAt,
+    rpId: db.rpId,
+    credential: storedCredential,
+  });
+}
+
+// 8. List Saved Passkeys (Management CRUD)
+export async function listFetch() {
+  const db = loadDb();
+  const user = db.users.find((u) => u.id === db.currentUserId) || db.users[0];
+  const credentials = db.credentials
+    .filter((c) => c.passkeyUserId === user.id)
+    .map((cred) => {
+      const providerMeta = resolveProviderFromAaguid(cred.aaguid);
+      return {
+        ...cred,
+        providerName: providerMeta.name,
+        providerIcon: cred.providerIcon || providerMeta.providerIcon,
+      };
+    });
+
+  return jsonResponse({
+    rpId: db.rpId,
+    userId: user.passkeyUserId,
+    user,
+    credentials,
+  });
+}
+
+// 9. Rename Saved Passkey Nickname (Server-only label update)
+export async function renameCredentialFetch(credentialId, { name }) {
+  const db = loadDb();
+  const activeUserId = db.currentUserId || db.users[0]?.id;
+  const cred = db.credentials.find((c) => c.id === credentialId);
+
+  if (!cred || cred.passkeyUserId !== activeUserId) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+
+  cred.name = name.trim();
+  saveDb(db);
+  return jsonResponse(cred);
+}
+
+// 10. Delete Saved Passkey
+export async function deleteFetch(credentialId) {
+  const db = loadDb();
+  const activeUserId = db.currentUserId || db.users[0]?.id;
+  const idx = db.credentials.findIndex(
+    (c) => c.id === credentialId && c.passkeyUserId === activeUserId
+  );
+
+  if (idx === -1) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+
+  db.credentials.splice(idx, 1);
+  saveDb(db);
+  return jsonResponse({ success: true, rpId: db.rpId });
+}
+
+// 11. Update User Profile Details (Synchronizes via signalCurrentUserDetails)
+export async function updateUserFetch({ name, displayName, favoriteRoast, defaultLocation }) {
+  const db = loadDb();
+  const user = db.users.find((u) => u.id === db.currentUserId) || db.users[0];
+
+  if (typeof name === 'string' && name.trim()) {
+    user.name = name.trim();
+  }
+  if (typeof displayName === 'string' && displayName.trim()) {
+    user.displayName = displayName.trim();
+  }
+  if (typeof favoriteRoast === 'string' && favoriteRoast.trim()) {
+    user.favoriteRoast = favoriteRoast.trim();
+  }
+  if (typeof defaultLocation === 'string' && defaultLocation.trim()) {
+    user.defaultLocation = defaultLocation.trim();
+  }
+
+  saveDb(db);
+  return jsonResponse({
+    ...user,
+    rpId: db.rpId,
+    userId: user.passkeyUserId,
+  });
+}
+
+// 12. Sign Out
+export async function signOutFetch() {
+  const db = loadDb();
+  db.currentUserId = null;
+  db.reauthenticatedAt = null;
+  saveDb(db);
+  return jsonResponse({ signedOut: true, rpId: db.rpId });
+}
+
+// Also intercept native fetch('/api/...') requests so standard fetch calls resolve seamlessly
+const nativeFetch = globalThis.fetch?.bind(globalThis);
+if (nativeFetch) {
+  globalThis.fetch = async function (input, init = {}) {
+    const urlStr = typeof input === 'string' ? input : input?.url || '';
+    if (urlStr.startsWith('/api/')) {
+      const bodyObj = init.body ? JSON.parse(init.body) : {};
+      if (urlStr === '/api/register/options') {
+        const opts = await registerOptionsFetch(bodyObj);
+        return jsonResponse(opts);
+      }
+      if (urlStr === '/api/register/verify') {
+        return registerVerifyFetch(bodyObj);
+      }
+      if (urlStr === '/api/login/options') {
+        const opts = await loginOptionsFetch();
+        return jsonResponse(opts);
+      }
+      if (urlStr === '/api/login/verify') {
+        return loginVerifyFetch(bodyObj);
+      }
+      if (urlStr === '/api/reauth/options') {
+        const opts = await reauthOptionsFetch();
+        return jsonResponse(opts);
+      }
+      if (urlStr === '/api/reauth/verify') {
+        return reauthVerifyFetch(bodyObj);
+      }
+      if (urlStr === '/api/credentials' && (!init.method || init.method === 'GET')) {
+        return listFetch();
+      }
+      if (urlStr.startsWith('/api/credential/') && init.method === 'PUT') {
+        const id = decodeURIComponent(urlStr.replace('/api/credential/', ''));
+        return renameCredentialFetch(id, bodyObj);
+      }
+      if (urlStr.startsWith('/api/credential/') && init.method === 'DELETE') {
+        const id = decodeURIComponent(urlStr.replace('/api/credential/', ''));
+        return deleteFetch(id);
+      }
+      if (urlStr === '/api/user' && init.method === 'PUT') {
+        return updateUserFetch(bodyObj);
+      }
+    }
+    return nativeFetch(input, init);
+  };
+}
