+// Client-side Passkey & Account UI Controller for The Daily Grind
+import 'webauthn-polyfills';
+import {
+  getSessionStateFetch,
+  registerOptionsFetch,
+  registerVerifyFetch,
+  loginOptionsFetch,
+  loginVerifyFetch,
+  passwordAuthFetch,
+  reauthOptionsFetch,
+  reauthVerifyFetch,
+  listFetch,
+  renameCredentialFetch,
+  deleteFetch,
+  updateUserFetch,
+  signOutFetch,
+} from './api.js';
+
+// AbortControllers to prevent overlapping WebAuthn prompts
+let autofillAbortController = new AbortController();
+let reauthAbortController = new AbortController();
+
+// Default SVG icon when AAGUID is zeroed or provider has no custom icon in registry
+const DEFAULT_PASSKEY_ICON_URI =
+  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234e342e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='7.5' cy='15.5' r='5.5'/%3E%3Cpath d='m21 2-9.6 9.6'/%3E%3Cpath d='m15.5 7.5 3 3L22 7l-3-3'/%3E%3C/svg%3E";
+
+// Valid unpadded Base64URL check required before calling Signal APIs:
+// non-empty, [A-Za-z0-9_-] only, no '=' padding, and length % 4 !== 1
+export function isValidBase64Url(value) {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+function formatEpochDate(epochMs) {
+  if (!epochMs) return 'Never used';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric',
+    }).format(new Date(epochMs));
+  } catch {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+function showStatusBanner(message, type = 'info') {
+  const banner = document.getElementById('account-status-banner');
+  if (!banner) return;
+  banner.textContent = message;
+  banner.dataset.statusType = type;
+  banner.hidden = false;
+}
+
+// ============================================================================
+// Capability Detection
+// ============================================================================
+async function getPasskeyCapabilities() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    return {
+      conditionalGet: false,
+      conditionalCreate: false,
+      passkeyPlatformAuthenticator: false,
+      userVerifyingPlatformAuthenticator: false,
+    };
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    const platformSupported = Boolean(
+      capabilities.passkeyPlatformAuthenticator ??
+        capabilities.userVerifyingPlatformAuthenticator
+    );
+    return {
+      ...capabilities,
+      passkeyPlatformAuthenticator: platformSupported,
+      conditionalGet: Boolean(capabilities.conditionalGet),
+      conditionalCreate: Boolean(capabilities.conditionalCreate),
+    };
+  } catch {
+    return {
+      conditionalGet: false,
+      conditionalCreate: false,
+      passkeyPlatformAuthenticator: false,
+      userVerifyingPlatformAuthenticator: false,
+    };
+  }
+}
+
+async function gatePasskeyCreationButtons() {
+  const capabilities = await getPasskeyCapabilities();
+  const canCreatePasskey =
+    capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet;
+
+  const createPasskeyButtons = document.querySelectorAll('[data-passkey-create-btn]');
+  const fallbackNotices = document.querySelectorAll('[data-passkey-fallback-notice]');
+
+  createPasskeyButtons.forEach((btn) => {
+    if (!canCreatePasskey) {
+      btn.disabled = true;
+      btn.hidden = true;
+    } else {
+      btn.disabled = false;
+      btn.hidden = false;
+    }
+  });
+
+  fallbackNotices.forEach((notice) => {
+    notice.hidden = canCreatePasskey;
+  });
+
+  return capabilities;
+}
+
+// ============================================================================
+// Signal API Synchronization Helpers
+// ============================================================================
+export async function syncAcceptedCredentials(rpId, userId, currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+    return;
+  }
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (
+    !rpId ||
+    !isValidBase64Url(userId) ||
+    !credentialIds.every(isValidBase64Url)
+  ) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use server-provided rpId; never window.location.hostname
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function syncCurrentUserDetails(rpId, userId, name, displayName) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) {
+    return;
+  }
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn(
+      'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+    );
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId, // Always use server-provided rpId; never window.location.hostname
+      userId,
+      name,
+      displayName,
+    });
+  } catch (e) {
+    console.warn('SignalCurrentUserDetails sync warning:', e);
+  }
+}
+
+async function signalUnknownPasskey(rpId, credentialId) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalUnknownCredential) {
+    return;
+  }
+  if (!rpId || !isValidBase64Url(credentialId)) {
+    console.warn(
+      'SignalUnknownCredential skipped: server rpId and valid unpadded Base64URL credentialId are required.'
+    );
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalUnknownCredential({
+      rpId, // Always use server-provided rpId; never window.location.hostname
+      credentialId,
+    });
+  } catch (e) {
+    console.warn('SignalUnknownCredential sync warning:', e);
+  }
+}
+
+// ============================================================================
+// 1. Passkey Authentication (Conditional Autofill + Explicit Button Sign-In)
+// ============================================================================
+export async function initializeConditionalAutofill() {
+  const capabilities = await getPasskeyCapabilities();
+  if (capabilities.conditionalGet !== true) {
+    return;
+  }
+
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+
+  const loginOptionsJSON = await loginOptionsFetch();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+  try {
+    const credential = await navigator.credentials.get({
+      publicKey,
+      signal: autofillAbortController.signal,
+      mediation: 'conditional',
+    });
+
+    if (!credential) return;
+
+    const encoded = credential.toJSON();
+    try {
+      const response = await loginVerifyFetch(encoded);
+      if (!response.ok && response.status === 404) {
+        await signalUnknownPasskey(publicKey.rpId, encoded.id);
+        showStatusBanner(
+          'That passkey is no longer registered to an account and has been removed.',
+          'warning'
+        );
+        return;
+      }
+      if (response.ok) {
+        const data = await response.json();
+        showStatusBanner(`Welcome back, ${data.user.displayName}! Signed in with passkey.`, 'success');
+        await loadManagementPanel();
+      }
+    } catch (verifyErr) {
+      showStatusBanner('Could not verify passkey sign-in with the server.', 'error');
+      console.warn('Conditional get verification error:', verifyErr);
+    }
+  } catch (err) {
+    if (['NotAllowedError', 'AbortError'].includes(err.name)) {
+      return;
+    }
+    console.warn('Unexpected conditional get error:', err);
+  }
+}
+
+export async function triggerButtonAuthentication() {
+  // Abort any pending Conditional Get call to prevent passkey prompt collisions
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+
+  const loginOptionsJSON = await loginOptionsFetch();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      signal: autofillAbortController.signal,
+    });
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      showStatusBanner('Passkey sign-in was cancelled. You can try again or use your password.', 'info');
+    } else if (err.name === 'AbortError') {
+      // Aborted programmatically
+    } else {
+      showStatusBanner(`Passkey sign-in unavailable: ${err.message || err.name}`, 'warning');
+    }
+    // Re-arm Conditional autofill suggestions after cancelled explicit button prompt
+    initializeConditionalAutofill();
+    return;
+  }
+
+  if (!credential) return;
+
+  const encoded = credential.toJSON();
+  try {
+    const response = await loginVerifyFetch(encoded);
+    if (!response.ok && response.status === 404) {
+      await signalUnknownPasskey(publicKey.rpId, encoded.id);
+      showStatusBanner(
+        'This passkey is no longer recognized by The Daily Grind and was signaled for removal.',
+        'error'
+      );
+      return;
+    }
+    if (response.ok) {
+      const data = await response.json();
+      showStatusBanner(`Signed in as ${data.user.displayName} via passkey!`, 'success');
+      await loadManagementPanel();
+    } else {
+      showStatusBanner('Unable to verify passkey assertion.', 'error');
+    }
+  } catch (serverErr) {
+    showStatusBanner('A network error occurred while verifying your passkey.', 'error');
+    console.warn('Verification request error:', serverErr);
+  }
+}
+
+// ============================================================================
+// 2. Passkey Registration & Post-Login Conditional Create
+// ============================================================================
+export async function registerPasskey({
+  isPromotion = false,
+  name,
+  displayName,
+  customLabel,
+} = {}) {
+  const capabilities = await getPasskeyCapabilities();
+  if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+    showStatusBanner(
+      'Passkey creation is not supported on this device or browser. Please use password authentication.',
+      'warning'
+    );
+    return;
+  }
+
+  // Abort background conditional autofill before opening registration ceremony
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+
+  const creationOptionsJSON = await registerOptionsFetch({
+    promotion: isPromotion,
+    name,
+    displayName,
+  });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      showStatusBanner('A passkey is already registered on this authenticator for your account.', 'warning');
+    } else if (err.name === 'SecurityError') {
+      showStatusBanner('Security configuration error: RP ID or HTTPS Secure Context mismatch.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      showStatusBanner('Passkey registration was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      // Aborted
+    } else {
+      showStatusBanner(`Could not create passkey: ${err.message || err.name}`, 'error');
+    }
+    initializeConditionalAutofill();
+    return;
+  }
+
+  if (!credential) return;
+
+  // Segregated server verification try/catch for Signal API cleanup
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse, { customLabel });
+    if (!response.ok) {
+      await signalUnknownPasskey(publicKey.rp.id, encodedResponse.id);
+      showStatusBanner('Server could not verify the new passkey. Orphaned credential removed.', 'error');
+      return;
+    }
+    const result = await response.json();
+    showStatusBanner(
+      `Passkey "${result.credential.name}" registered to ${result.user.displayName}!`,
+      'success'
+    );
+    await loadManagementPanel();
+  } catch (serverErr) {
+    console.warn('Server verification network failure:', serverErr);
+    await signalUnknownPasskey(publicKey.rp.id, encodedResponse.id);
+    showStatusBanner('Network failure while saving passkey. Credential signaled as unknown.', 'error');
+  }
+}
+
+export async function triggerConditionalCreate() {
+  const capabilities = await getPasskeyCapabilities();
+  if (capabilities.conditionalCreate !== true) {
+    return;
+  }
+
+  // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+
+  // 2. Fetch creation options signaling conditional request (includes rp.id and excludeCredentials)
+  const creationOptionsJSON = await registerOptionsFetch({
+    conditional: true,
+    promotion: true,
+  });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      mediation: 'conditional',
+    });
+  } catch (e) {
+    // 4. Silently swallow expected WebAuthn exceptions during conditional creation
+    if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+      return;
+    }
+    console.warn('Unexpected conditional create error:', e);
+    return;
+  }
+
+  if (!credential) return;
+
+  // 5. Server verification step using dedicated Try/Catch block
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      await signalUnknownPasskey(publicKey.rp.id, encodedResponse.id);
+      return;
+    }
+    showStatusBanner('A passkey was automatically created for faster future sign-ins!', 'success');
+    await loadManagementPanel();
+  } catch (serverErr) {
+    console.warn('Conditional create verification network failure:', serverErr);
+    await signalUnknownPasskey(publicKey.rp.id, encodedResponse.id);
+  }
+}
+
+// ============================================================================
+// 3. Passkey Reauthentication (Step-Up Verification for Sensitive Actions)
+// ============================================================================
+export async function triggerButtonReauth({ onVerified } = {}) {
+  // Abort any background suggestion or prior reauth flows to avoid prompt collisions
+  autofillAbortController.abort();
+  autofillAbortController = new AbortController();
+  reauthAbortController.abort();
+  reauthAbortController = new AbortController();
+
+  const optionsJSON = await reauthOptionsFetch();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  if (!publicKey.allowCredentials || publicKey.allowCredentials.length === 0) {
+    showStatusBanner(
+      'Please register at least one passkey to your account before using passkey reauthentication.',
+      'warning'
+    );
+    return false;
+  }
+
+  try {
+    const credential = await navigator.credentials.get({
+      publicKey,
+      signal: reauthAbortController.signal,
+    });
+
+    if (!credential) return false;
+
+    const encodedCredential = credential.toJSON();
+    const verifyResponse = await reauthVerifyFetch(encodedCredential);
+
+    if (verifyResponse.ok) {
+      const result = await verifyResponse.json();
+      updateReauthVisualState(result.reauthenticatedAt);
+      showStatusBanner('Identity verified with your passkey. Sensitive actions are now unlocked.', 'success');
+      if (typeof onVerified === 'function') {
+        await onVerified(result);
+      }
+      await loadManagementPanel();
+      return true;
+    } else if (verifyResponse.status === 404) {
+      await signalUnknownPasskey(publicKey.rpId, encodedCredential.id);
+      showStatusBanner('That passkey is no longer recognized and was removed from your vault.', 'error');
+    } else {
+      const errData = await verifyResponse.json().catch(() => ({}));
+      showStatusBanner(errData.error || 'Reauthentication verification failed.', 'error');
+    }
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      showStatusBanner('Reauthentication cancelled. Please verify with your passkey to continue.', 'info');
+    } else if (err.name !== 'AbortError') {
+      showStatusBanner(`Reauthentication error: ${err.message || err.name}`, 'warning');
+    }
+  }
+  return false;
+}
+
+function updateReauthVisualState(reauthenticatedAt) {
+  const badge = document.getElementById('reauth-status-badge');
+  const sensitiveHint = document.getElementById('reauth-timestamp-text');
+  const isVerified = Boolean(reauthenticatedAt && Date.now() - reauthenticatedAt < 15 * 60 * 1000);
+
+  if (badge) {
+    badge.textContent = isVerified ? 'Verified via Passkey' : 'Verification Required';
+    badge.className = isVerified ? 'status-pill status-verified' : 'status-pill status-locked';
+  }
+  if (sensitiveHint) {
+    sensitiveHint.textContent = isVerified
+      ? `Last verified at ${new Date(reauthenticatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}.`
+      : 'Step-up passkey verification protects profile changes, saved payouts, and reward redemptions.';
+  }
+}
+
+// ============================================================================
+// 4. Passkey Management & User Profile Updates
+// ============================================================================
+function renderPasskeysList(credentials) {
+  const listContainer = document.getElementById('passkey-list');
+  const emptyState = document.getElementById('passkey-empty-state');
+  const countBadge = document.getElementById('passkey-count-badge');
+
+  if (countBadge) {
+    countBadge.textContent = `${credentials.length} ${credentials.length === 1 ? 'passkey' : 'passkeys'}`;
+  }
+
+  if (!listContainer) return;
+  listContainer.replaceChildren();
+
+  if (!credentials || credentials.length === 0) {
+    if (emptyState) emptyState.hidden = false;
+    return;
+  }
+  if (emptyState) emptyState.hidden = true;
+
+  credentials.forEach((cred) => {
+    const item = document.createElement('li');
+    item.className = 'passkey-item';
+    item.dataset.credentialId = cred.id;
+
+    // Provider Icon & Metadata Row
+    const mainInfo = document.createElement('div');
+    mainInfo.className = 'passkey-info';
+
+    const iconImg = document.createElement('img');
+    iconImg.className = 'passkey-provider-icon';
+    iconImg.src = cred.providerIcon || DEFAULT_PASSKEY_ICON_URI;
+    iconImg.alt = `${cred.providerName || cred.name} icon`;
+    iconImg.width = 36;
+    iconImg.height = 36;
+
+    const textCol = document.createElement('div');
+    textCol.className = 'passkey-text';
+
+    const titleRow = document.createElement('div');
+    titleRow.className = 'passkey-title-row';
+
+    const nameEl = document.createElement('strong');
+    nameEl.className = 'passkey-name';
+    nameEl.textContent = cred.name || cred.providerName || 'Unknown passkey provider';
+    titleRow.appendChild(nameEl);
+
+    if (cred.credentialBackedUp) {
+      const syncTag = document.createElement('span');
+      syncTag.className = 'passkey-tag';
+      syncTag.textContent = 'Synced';
+      titleRow.appendChild(syncTag);
+    }
+
+    const datesRow = document.createElement('div');
