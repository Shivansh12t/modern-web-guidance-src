+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { username, passkey, ceremonyMode } = body;
+
+    if (!passkey || !passkey.id) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid passkey credential payload' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (session) {
+      const existing: any[] = (await session.get('passkeys')) || [];
+      const filtered = existing.filter((p) => p.id !== passkey.id);
+      await session.set('passkeys', [passkey, ...filtered]);
+      await session.set('authenticatedUser', username || passkey.username);
+    }
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        ceremonyMode: ceremonyMode || 'native-webauthn',
+        credentialId: passkey.id,
+        username: username || passkey.username,
+        registeredAt: new Date().toISOString(),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Registration verification failed' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
