@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { credentialId, username, isReauthentication, ceremonyMode } = body;
+
+    if (!credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'Missing credentialId in assertion verification' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const verifiedAt = new Date().toISOString();
+    if (session) {
+      await session.set('authenticatedUser', username || 'ada.lovelace');
+      if (isReauthentication) {
+        await session.set('lastReauthAt', verifiedAt);
+      }
+    }
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credentialId,
+        username: username || 'ada.lovelace',
+        isReauthentication: Boolean(isReauthentication),
+        ceremonyMode: ceremonyMode || 'native-webauthn',
+        verifiedAt,
+        token: `dtt_pk_jwt_${Buffer.from(`${username || 'user'}:${verifiedAt}`).toString('base64url')}`,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Authentication assertion verification failed' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
