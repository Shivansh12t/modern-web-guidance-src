+/**
+ * Check if the user has a valid recent reauthentication within the specified TTL (default 5 minutes)
+ */
+export function isReauthFresh(maxAgeMs = 5 * 60 * 1000): {
+  isFresh: boolean;
+  lastReauthAt: string | null;
+  remainingSeconds: number;
+} {
+  if (typeof window === 'undefined') {
+    return { isFresh: false, lastReauthAt: null, remainingSeconds: 0 };
+  }
+  const ts = localStorage.getItem(STORAGE_KEYS.REAUTH_TIMESTAMP);
+  if (!ts) {
+    return { isFresh: false, lastReauthAt: null, remainingSeconds: 0 };
+  }
+  const elapsed = Date.now() - new Date(ts).getTime();
+  if (elapsed < maxAgeMs) {
+    return {
+      isFresh: true,
+      lastReauthAt: ts,
+      remainingSeconds: Math.max(0, Math.ceil((maxAgeMs - elapsed) / 1000)),
+    };
+  }
+  return { isFresh: false, lastReauthAt: ts, remainingSeconds: 0 };
+}
