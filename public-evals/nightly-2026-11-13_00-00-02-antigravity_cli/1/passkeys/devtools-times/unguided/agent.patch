@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { username, isReauthentication } = body;
+
+    const challenge = crypto.randomBytes(32).toString('base64url');
+    if (session) {
+      await session.set('webauthnAuthChallenge', challenge);
+    }
+
+    const url = new URL(request.url);
+    const rpId = url.hostname || 'localhost';
+
+    return new Response(
+      JSON.stringify({
+        challenge,
+        rpId,
+        timeout: 60000,
+        userVerification: 'required',
+        username: username || null,
+        isReauthentication: Boolean(isReauthentication),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate authentication challenge' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
