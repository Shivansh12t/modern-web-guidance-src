+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const username = body.username || 'ada.lovelace';
+    const displayName = body.displayName || username;
+    const authenticatorAttachment = body.authenticatorAttachment;
+
+    const challengeBytes = crypto.randomBytes(32);
+    const challenge = challengeBytes.toString('base64url');
+    const userId = Buffer.from(`usr_${username.toLowerCase()}`).toString('base64url');
+
+    if (session) {
+      await session.set('webauthnChallenge', challenge);
+      await session.set('webauthnUsername', username);
+    }
+
+    const url = new URL(request.url);
+    const rpId = url.hostname || 'localhost';
+
+    return new Response(
+      JSON.stringify({
+        challenge,
+        rp: {
+          name: 'The DevTools Times',
+          id: rpId,
+        },
+        user: {
+          id: userId,
+          name: username,
+          displayName,
+        },
+        pubKeyCredParams: [
+          { alg: -7, type: 'public-key' },
+          { alg: -257, type: 'public-key' },
+          { alg: -8, type: 'public-key' },
+        ],
+        timeout: 60000,
+        attestation: 'none',
+        authenticatorSelection: {
+          ...(authenticatorAttachment ? { authenticatorAttachment } : {}),
+          residentKey: 'required',
+          requireResidentKey: true,
+          userVerification: 'required',
+        },
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate registration options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
