+  id: string; // Base64URL credential ID
+  rawId: string; // Base64URL rawId
+  username: string;
+  userDisplayName: string;
+  userId: string; // Base64URL user handle
+  name: string; // Friendly device/passkey label (e.g., "Chrome on MacBook Pro", "iCloud Keychain")
+  publicKey?: string; // Base64URL SPKI or attestation object
+  algorithm: number; // COSEAlgorithmIdentifier (-7 for ES256, -257 for RS256)
+  transports: AuthenticatorTransport[];
+  authenticatorAttachment: 'platform' | 'cross-platform';
+  aaguid: string;
+  providerName: string;
+  createdAt: string; // ISO date
+  lastUsedAt: string | null; // ISO date or null
+  signCount: number;
+  backedUp: boolean;
+  backupEligible: boolean;
+  isDefault?: boolean;
+}
+
+export interface UserAccount {
+  id: string;
+  username: string;
+  email: string;
+  displayName: string;
+  role: string;
+  subscriptionTier: 'Free' | 'Digital Subscriber' | 'All-Access Patron';
+  passwordlessEnabled: boolean;
+  requireReauthForSensitiveActions: boolean;
+  lastReauthAt: string | null;
+  createdAt: string;
+}
+
+export interface SecurityAuditEvent {
+  id: string;
+  timestamp: string;
+  type:
+    | 'passkey_registered'
+    | 'passkey_authenticated'
+    | 'passkey_reauthenticated'
+    | 'passkey_renamed'
