@@ -0,0 +1,77 @@
+import type { APIRoute } from 'astro';
+
+export const GET: APIRoute = async ({ session }) => {
+  const passkeys = (await session?.get('passkeys')) || [];
+  const authenticatedUser = (await session?.get('authenticatedUser')) || 'ada.lovelace';
+  const lastReauthAt = (await session?.get('lastReauthAt')) || null;
+
+  return new Response(
+    JSON.stringify({
+      authenticatedUser,
+      lastReauthAt,
+      passkeys,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { id, name } = body;
+    if (!id || !name) {
+      return new Response(JSON.stringify({ error: 'id and name are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (session) {
+      const existing: any[] = (await session.get('passkeys')) || [];
+      const updated = existing.map((p) => (p.id === id ? { ...p, name } : p));
+      await session.set('passkeys', updated);
+    }
+
+    return new Response(JSON.stringify({ updated: true, id, name }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Update failed' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { id } = body;
+    if (!id) {
+      return new Response(JSON.stringify({ error: 'id is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (session) {
+      const existing: any[] = (await session.get('passkeys')) || [];
+      const updated = existing.filter((p) => p.id !== id);
+      await session.set('passkeys', updated);
+    }
+
+    return new Response(JSON.stringify({ deleted: true, id }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Delete failed' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
