new file mode 100644
index 0000000..3c666e9
--- /dev/null
+++ b/src/components/ReauthModal.tsx
@@ -0,0 +1,292 @@
+import React, { useState, useEffect } from 'react';
+import {
+  authenticatePasskeyCeremony,
+  getAllPasskeys,
+  getCurrentUser,
+  recordReauthSuccess,
+  appendAuditLog,
+  type StoredPasskey,
+} from '../utils/passkeys';
+
+export interface ReauthModalProps {
+  isOpen: boolean;
+  onClose: () => void;
+  onSuccess: (method: 'passkey' | 'password', credential?: StoredPasskey) => void;
+  actionTitle: string;
+  actionDescription?: string;
+  username?: string;
+  allowSimulatorFallback?: boolean;
+}
+
+export default function ReauthModal({
+  isOpen,
+  onClose,
+  onSuccess,
+  actionTitle,
+  actionDescription,
+  username,
+  allowSimulatorFallback = true,
+}: ReauthModalProps) {
+  const [selectedCredentialId, setSelectedCredentialId] = useState<string>('');
+  const [passkeys, setPasskeys] = useState<StoredPasskey[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [usePasswordFallback, setUsePasswordFallback] = useState(false);
+  const [password, setPassword] = useState('');
+
+  useEffect(() => {
+    if (!isOpen) return;
+    const currentUser = getCurrentUser();
+    const targetUser = username || currentUser.username;
+    const userPasskeys = getAllPasskeys(targetUser);
+    setPasskeys(userPasskeys);
+    const defaultPk = userPasskeys.find((p) => p.isDefault) || userPasskeys[0];
+    setSelectedCredentialId(defaultPk?.id || '');
+    setError(null);
+    setLoading(false);
+    setUsePasswordFallback(false);
+    setPassword('');
+  }, [isOpen, username]);
+
+  if (!isOpen) return null;
+
+  const handlePasskeyReauth = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      const currentUser = getCurrentUser();
+      const targetUser = username || currentUser.username;
+      const result = await authenticatePasskeyCeremony({
+        username: targetUser,
+        credentialId: selectedCredentialId || undefined,
+        isReauthentication: true,
+        reason: actionTitle,
+        userVerification: 'required',
+        allowSimulatedFallback: allowSimulatorFallback,
+      });
+      onSuccess('passkey', result.passkey);
+    } catch (err: any) {
+      setError(
+        err?.message ||
+          'Passkey verification failed. Ensure your authenticator is ready or use password fallback.'
+      );
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    if (!password || password.length < 4) {
+      setError('Please enter your account password to confirm this action.');
+      return;
+    }
+    setLoading(true);
+    try {
+      recordReauthSuccess();
+      appendAuditLog({
+        type: 'passkey_reauthenticated',
+        title: 'Reauthenticated via Password Fallback',
+        description: `Verified identity with account password for: ${actionTitle}.`,
+        status: 'success',
+      });
+      onSuccess('password');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-[99999] flex items-center justify-center bg-gray-900/60 backdrop-blur-xs p-4"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="reauth-modal-title"
+      onClick={onClose}
+    >
+      <div
+        className="bg-white border border-gray-200 rounded-xl shadow-2xl max-w-md w-full overflow-hidden"
+        onClick={(e) => e.stopPropagation()}
+      >
+        {/* Header */}
+        <div className="bg-gray-900 text-white px-6 py-4 flex items-center justify-between">
+          <div className="flex items-center space-x-2.5">
+            <span className="p-1.5 rounded-lg bg-amber-400/20 text-amber-400">
+              <svg
+                xmlns="http://www.w3.org/2000/svg"
