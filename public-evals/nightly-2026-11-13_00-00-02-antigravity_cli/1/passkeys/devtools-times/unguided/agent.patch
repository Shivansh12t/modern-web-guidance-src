+
+/**
+ * Execute a full WebAuthn Registration Ceremony (`navigator.credentials.create`)
+ * Connects to the server challenge API, invokes the browser's native WebAuthn API
+ * (compatible with Chrome DevTools WebAuthn Virtual Authenticator), and falls back
+ * gracefully if the user is in an environment without an active authenticator when fallback is allowed.
+ */
+export async function registerPasskeyCeremony(
+  options: RegisterPasskeyOptions
+): Promise<RegisterPasskeyResult> {
+  const username = options.username.trim() || 'ada.lovelace';
+  const displayName = options.displayName?.trim() || username;
+  const deviceMeta = detectDevicePasskeyName();
+  const customLabel =
+    options.passkeyLabel?.trim() ||
+    (options.authenticatorAttachment === 'cross-platform'
+      ? 'Security Key (USB / NFC)'
+      : deviceMeta.deviceName);
+
+  // 1. Fetch registration options from backend API (or generate locally if offline)
+  let challengeBytes = generateChallenge(32);
+  let rpId = typeof window !== 'undefined' ? window.location.hostname : 'localhost';
+  const userIdBytes = new TextEncoder().encode(`usr_${username.toLowerCase()}`);
+
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    const res = await fetch(`${baseUrl}api/passkeys/register-options.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username,
+        displayName,
+        authenticatorAttachment: options.authenticatorAttachment,
+      }),
+    });
+    if (res.ok) {
+      const serverOpts = await res.json();
+      if (serverOpts.challenge) {
+        challengeBytes = base64urlToBuffer(serverOpts.challenge);
+      }
+      if (serverOpts.rp?.id) {
+        rpId = serverOpts.rp.id;
+      }
+    }
+  } catch {
+    // Fallback to client-generated cryptographic challenge
+  }
+
+  const existingUserPasskeys = getAllPasskeys(username);
+  const excludeCredentials: PublicKeyCredentialDescriptor[] = existingUserPasskeys
+    .map((pk) => {
+      try {
+        return {
+          id: base64urlToBuffer(pk.rawId) as BufferSource,
+          type: 'public-key' as const,
+          transports: pk.transports,
+        };
+      } catch {
+        return null;
+      }
+    })
+    .filter(Boolean) as PublicKeyCredentialDescriptor[];
+
+  const publicKeyCreationOptions: PublicKeyCredentialCreationOptions = {
+    challenge: challengeBytes as BufferSource,
+    rp: {
+      name: 'The DevTools Times',
+      id: rpId,
+    },
+    user: {
+      id: userIdBytes as BufferSource,
+      name: username,
+      displayName,
+    },
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' }, // ES256
+      { alg: -257, type: 'public-key' }, // RS256
+      { alg: -8, type: 'public-key' }, // EdDSA
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      ...(options.authenticatorAttachment
+        ? { authenticatorAttachment: options.authenticatorAttachment }
+        : {}),
+      residentKey: options.residentKey || 'required',
+      requireResidentKey: (options.residentKey || 'required') === 'required',
+      userVerification: options.userVerification || 'required',
+    },
+  };
+
+  let createdCredential: PublicKeyCredential | null = null;
+  let nativeError: any = null;
+
+  // 2. Call native browser WebAuthn API `navigator.credentials.create`
+  if (typeof window !== 'undefined' && window.navigator?.credentials?.create) {
+    try {
+      createdCredential = (await window.navigator.credentials.create({
+        publicKey: publicKeyCreationOptions,
+      })) as PublicKeyCredential | null;
+    } catch (err: any) {
+      nativeError = err;
+    }
+  }
+
+  let newPasskey: StoredPasskey;
+  let ceremonyMode: 'native-webauthn' | 'simulated-virtual-authenticator' = 'native-webauthn';
+  let clientDataJSONB64: string | undefined;
+  let attestationObjectB64: string | undefined;
+
+  if (createdCredential) {
+    const response = createdCredential.response as AuthenticatorAttestationResponse;
+    const credId = createdCredential.id || bufferToBase64url(createdCredential.rawId);
+    const rawIdB64 = bufferToBase64url(createdCredential.rawId);
+    clientDataJSONB64 = bufferToBase64url(response.clientDataJSON);
+    attestationObjectB64 = bufferToBase64url(response.attestationObject);
+
+    const transports =
+      typeof response.getTransports === 'function'
+        ? (response.getTransports() as AuthenticatorTransport[])
+        : options.authenticatorAttachment === 'cross-platform'
+        ? (['usb', 'nfc'] as AuthenticatorTransport[])
+        : (['internal', 'hybrid'] as AuthenticatorTransport[]);
+
+    const alg =
+      typeof response.getPublicKeyAlgorithm === 'function'
+        ? response.getPublicKeyAlgorithm()
+        : -7;
+
+    const attachment =
+      (createdCredential as any).authenticatorAttachment ||
+      options.authenticatorAttachment ||
+      'platform';
+
+    newPasskey = {
+      id: credId,
+      rawId: rawIdB64,
+      username,
+      userDisplayName: displayName,
+      userId: bufferToBase64url(userIdBytes),
+      name: customLabel,
+      publicKey: attestationObjectB64,
+      algorithm: alg,
+      transports: transports.length ? transports : ['internal'],
+      authenticatorAttachment: attachment === 'cross-platform' ? 'cross-platform' : 'platform',
+      aaguid:
+        attachment === 'cross-platform'
+          ? '2fc0579f-8113-47ea-b116-bb5a8db9202a'
+          : deviceMeta.aaguid,
+      providerName:
+        attachment === 'cross-platform' ? 'Hardware Security Key' : deviceMeta.providerName,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      signCount: 0,
+      backedUp: attachment !== 'cross-platform',
+      backupEligible: attachment !== 'cross-platform',
+      isDefault: existingUserPasskeys.length === 0,
+    };
+  } else if (options.allowSimulatedFallback !== false) {
+    // If native WebAuthn threw NotAllowedError or no authenticator is attached and fallback is enabled
+    ceremonyMode = 'simulated-virtual-authenticator';
+    const randomBytes = generateChallenge(20);
+    const simulatedId = bufferToBase64url(randomBytes);
+    const attachment = options.authenticatorAttachment || 'platform';
+
+    newPasskey = {
+      id: simulatedId,
+      rawId: simulatedId,
+      username,
+      userDisplayName: displayName,
+      userId: bufferToBase64url(userIdBytes),
+      name: customLabel,
+      publicKey: bufferToBase64url(generateChallenge(64)),
+      algorithm: -7,
+      transports:
+        attachment === 'cross-platform' ? ['usb', 'nfc'] : ['internal', 'hybrid'],
+      authenticatorAttachment: attachment === 'cross-platform' ? 'cross-platform' : 'platform',
+      aaguid:
+        attachment === 'cross-platform'
+          ? '2fc0579f-8113-47ea-b116-bb5a8db9202a'
+          : deviceMeta.aaguid,
+      providerName:
+        attachment === 'cross-platform' ? 'Hardware Security Key' : deviceMeta.providerName,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      signCount: 1,
+      backedUp: attachment !== 'cross-platform',
+      backupEligible: attachment !== 'cross-platform',
+      isDefault: existingUserPasskeys.length === 0,
+    };
+  } else {
+    appendAuditLog({
+      type: 'webauthn_ceremony_failed',
+      title: 'Passkey Registration Cancelled',
+      description: nativeError?.message || 'WebAuthn credential creation was cancelled or timed out.',
+      status: 'error',
+    });
+    throw nativeError || new Error('Passkey registration failed or was cancelled.');
+  }
+
+  // 3. Verify & persist with backend endpoint + client storage
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    await fetch(`${baseUrl}api/passkeys/register-verify.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username,
+        passkey: newPasskey,
+        ceremonyMode,
+      }),
+    });
+  } catch {
+    // Continue with client persistence
+  }
+
+  const allPasskeys = getAllPasskeys();
+  savePasskeys([newPasskey, ...allPasskeys]);
+
+  // Ensure account exists and is signed in
+  const accounts = getAccounts();
+  let account = accounts.find((a) => a.username.toLowerCase() === username.toLowerCase());
+  if (!account) {
+    account = {
+      id: `usr_${Date.now()}`,
+      username,
+      email: username.includes('@') ? username : `${username}@devtoolstimes.dev`,
+      displayName,
+      role: 'Subscriber',
+      subscriptionTier: 'Digital Subscriber',
+      passwordlessEnabled: true,
+      requireReauthForSensitiveActions: true,
+      lastReauthAt: new Date().toISOString(),
+      createdAt: new Date().toISOString(),
+    };
+  }
+  setCurrentUser(account);
+
+  appendAuditLog({
+    type: 'passkey_registered',
+    title: 'Passkey Registered',
+    description: `Registered "${newPasskey.name}" (${newPasskey.providerName}) for ${username}.`,
+    credentialId: newPasskey.id,
+    deviceInfo: `${newPasskey.authenticatorAttachment === 'platform' ? 'Platform' : 'Cross-Platform'} • ${
+      ceremonyMode === 'native-webauthn' ? 'WebAuthn API' : 'Virtual Authenticator'
+    }`,
+    status: 'success',
+  });
+
+  return {
+    passkey: newPasskey,
+    ceremonyMode,
+    attestationSummary: {
+      challenge: bufferToBase64url(challengeBytes),
+      rpId,
+      origin: typeof window !== 'undefined' ? window.location.origin : 'https://localhost',
+      clientDataJSON: clientDataJSONB64,
+      attestationObject: attestationObjectB64,
+    },
+  };
+}
+
+export interface AuthenticatePasskeyOptions {
+  username?: string;
+  credentialId?: string;
+  mediation?: CredentialMediationRequirement;
+  userVerification?: UserVerificationRequirement;
+  isReauthentication?: boolean;
+  reason?: string;
+  allowSimulatedFallback?: boolean;
+  signal?: AbortSignal;
+}
+
+export interface AuthenticatePasskeyResult {
+  passkey: StoredPasskey;
+  user: UserAccount;
+  ceremonyMode: 'native-webauthn' | 'simulated-virtual-authenticator';
+  assertionSummary: {
+    challenge: string;
+    rpId: string;
+    userVerified: boolean;
+    signCount: number;
+  };
+}
+
+/**
+ * Execute a WebAuthn Authentication or Reauthentication Assertion Ceremony (`navigator.credentials.get`)
+ */
+export async function authenticatePasskeyCeremony(
+  options: AuthenticatePasskeyOptions = {}
+): Promise<AuthenticatePasskeyResult> {
+  const targetUsername = options.username?.trim();
+  const availablePasskeys = getAllPasskeys(targetUsername);
+  let challengeBytes = generateChallenge(32);
+  let rpId = typeof window !== 'undefined' ? window.location.hostname : 'localhost';
+
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    const res = await fetch(`${baseUrl}api/passkeys/auth-options.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: targetUsername,
+        isReauthentication: options.isReauthentication,
+      }),
+    });
+    if (res.ok) {
+      const serverOpts = await res.json();
+      if (serverOpts.challenge) {
+        challengeBytes = base64urlToBuffer(serverOpts.challenge);
+      }
+      if (serverOpts.rpId) {
+        rpId = serverOpts.rpId;
+      }
+    }
+  } catch {
+    // Fallback to locally generated cryptographic challenge
+  }
+
+  // Build allowCredentials list if a specific user or credential is requested
+  const allowCredentials: PublicKeyCredentialDescriptor[] = [];
+  if (options.credentialId) {
+    const match = getAllPasskeys().find((p) => p.id === options.credentialId);
+    if (match) {
+      try {
+        allowCredentials.push({
+          id: base64urlToBuffer(match.rawId) as BufferSource,
+          type: 'public-key',
+          transports: match.transports,
+        });
+      } catch {
+        // ignore invalid base64url
+      }
+    }
+  } else if (targetUsername && availablePasskeys.length > 0) {
+    for (const pk of availablePasskeys) {
+      try {
+        allowCredentials.push({
+          id: base64urlToBuffer(pk.rawId) as BufferSource,
+          type: 'public-key',
+          transports: pk.transports,
+        });
+      } catch {
+        // ignore
+      }
+    }
+  }
+
+  const publicKeyRequestOptions: PublicKeyCredentialRequestOptions = {
+    challenge: challengeBytes as BufferSource,
+    rpId,
+    timeout: 60000,
+    userVerification: options.userVerification || 'required',
+    ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+  };
+
+  let assertedCredential: PublicKeyCredential | null = null;
+  let nativeError: any = null;
+
+  if (typeof window !== 'undefined' && window.navigator?.credentials?.get) {
+    try {
+      assertedCredential = (await window.navigator.credentials.get({
+        publicKey: publicKeyRequestOptions,
+        mediation: options.mediation || 'optional',
+        ...(options.signal ? { signal: options.signal } : {}),
+      })) as PublicKeyCredential | null;
+    } catch (err: any) {
+      nativeError = err;
+    }
+  }
+
+  // If this was a background conditional mediation (autofill) request and it failed or aborted, do not simulate
+  if (options.mediation === 'conditional' && !assertedCredential) {
+    throw nativeError || new Error('Conditional mediation aborted or unavailable.');
+  }
+
+  let matchedPasskey: StoredPasskey | undefined;
+  let ceremonyMode: 'native-webauthn' | 'simulated-virtual-authenticator' = 'native-webauthn';
+
+  if (assertedCredential) {
+    const credId = assertedCredential.id || bufferToBase64url(assertedCredential.rawId);
+    const all = getAllPasskeys();
+    matchedPasskey = all.find((p) => p.id === credId || p.rawId === credId);
+
+    if (!matchedPasskey) {
+      // If a credential was asserted from the browser/DevTools virtual authenticator that wasn't in localStorage yet
+      const assertResp = assertedCredential.response as AuthenticatorAssertionResponse;
+      const userHandleStr = assertResp.userHandle
+        ? new TextDecoder().decode(assertResp.userHandle).replace(/^usr_/, '')
+        : targetUsername || getCurrentUser().username;
+      const deviceMeta = detectDevicePasskeyName();
+
+      matchedPasskey = {
+        id: credId,
+        rawId: bufferToBase64url(assertedCredential.rawId),
+        username: userHandleStr || 'ada.lovelace',
+        userDisplayName: userHandleStr || 'Ada Lovelace',
+        userId: assertResp.userHandle
+          ? bufferToBase64url(assertResp.userHandle)
+          : bufferToBase64url(new TextEncoder().encode(`usr_${userHandleStr}`)),
+        name: deviceMeta.deviceName,
+        algorithm: -7,
+        transports: ['internal'],
+        authenticatorAttachment: 'platform',
+        aaguid: deviceMeta.aaguid,
+        providerName: deviceMeta.providerName,
+        createdAt: new Date().toISOString(),
+        lastUsedAt: new Date().toISOString(),
+        signCount: 1,
+        backedUp: true,
+        backupEligible: true,
+      };
+    }
+  } else if (options.allowSimulatedFallback !== false) {
+    ceremonyMode = 'simulated-virtual-authenticator';
+    const all = getAllPasskeys();
+    if (options.credentialId) {
+      matchedPasskey = all.find((p) => p.id === options.credentialId);
+    }
+    if (!matchedPasskey && targetUsername) {
+      matchedPasskey = all.find(
+        (p) => p.username.toLowerCase() === targetUsername.toLowerCase()
+      );
+    }
+    if (!matchedPasskey) {
+      matchedPasskey = all[0];
+    }
+
+    if (!matchedPasskey) {
+      // No passkeys exist at all for this username
+      throw new Error(
+        targetUsername
+          ? `No passkeys found for "${targetUsername}". Please register a passkey first.`
+          : 'No registered passkeys found on this device.'
+      );
+    }
+  } else {
+    appendAuditLog({
+      type: 'webauthn_ceremony_failed',
+      title: options.isReauthentication ? 'Reauthentication Failed' : 'Passkey Sign-In Failed',
+      description: nativeError?.message || 'User cancelled or authenticator timed out.',
+      status: 'error',
+    });
+    throw nativeError || new Error('Passkey authentication failed or was cancelled.');
+  }
+
+  // Update lastUsedAt and signCount
+  const nowIso = new Date().toISOString();
+  const updatedPasskey: StoredPasskey = {
+    ...matchedPasskey,
+    lastUsedAt: nowIso,
+    signCount: (matchedPasskey.signCount || 0) + 1,
+  };
+
+  const allPasskeys = getAllPasskeys();
+  const existsIdx = allPasskeys.findIndex((p) => p.id === updatedPasskey.id);
+  if (existsIdx >= 0) {
+    allPasskeys[existsIdx] = updatedPasskey;
+  } else {
+    allPasskeys.unshift(updatedPasskey);
+  }
+  savePasskeys(allPasskeys);
+
+  // Verify assertion with backend API
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    await fetch(`${baseUrl}api/passkeys/auth-verify.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        credentialId: updatedPasskey.id,
+        username: updatedPasskey.username,
+        isReauthentication: options.isReauthentication,
+        ceremonyMode,
+      }),
+    });
+  } catch {
+    // continue
+  }
+
+  // Resolve user account
+  const accounts = getAccounts();
+  let user = accounts.find(
+    (a) => a.username.toLowerCase() === updatedPasskey.username.toLowerCase()
+  );
+  if (!user) {
+    user = {
+      id: `usr_${updatedPasskey.username}`,
+      username: updatedPasskey.username,
+      email: `${updatedPasskey.username}@devtoolstimes.dev`,
+      displayName: updatedPasskey.userDisplayName || updatedPasskey.username,
+      role: 'Subscriber',
+      subscriptionTier: 'Digital Subscriber',
+      passwordlessEnabled: true,
+      requireReauthForSensitiveActions: true,
+      lastReauthAt: nowIso,
+      createdAt: nowIso,
+    };
+  }
+
+  if (options.isReauthentication) {
+    recordReauthSuccess();
+    user = { ...user, lastReauthAt: nowIso };
+  }
+  setCurrentUser(user);
+
+  appendAuditLog({
+    type: options.isReauthentication ? 'passkey_reauthenticated' : 'passkey_authenticated',
+    title: options.isReauthentication
+      ? `Reauthenticated via Passkey`
+      : `Signed in with Passkey`,
+    description: options.isReauthentication
+      ? `Verified identity with "${updatedPasskey.name}" for: ${options.reason || 'sensitive account action'}.`
+      : `Authenticated as ${user.username} using "${updatedPasskey.name}".`,
+    credentialId: updatedPasskey.id,
+    deviceInfo: `${updatedPasskey.providerName} • Sign count #${updatedPasskey.signCount}`,
+    status: 'success',
+  });
+
+  return {
+    passkey: updatedPasskey,
+    user,
+    ceremonyMode,
+    assertionSummary: {
+      challenge: bufferToBase64url(challengeBytes),
+      rpId,
+      userVerified: true,
+      signCount: updatedPasskey.signCount,
+    },
+  };
+}
+
+/**
+ * Rename an existing passkey
+ */
+export function renamePasskey(credentialId: string, newName: string): StoredPasskey | null {
+  const trimmed = newName.trim();
+  if (!trimmed) return null;
+  const all = getAllPasskeys();
+  const idx = all.findIndex((p) => p.id === credentialId);
+  if (idx < 0) return null;
+
+  const oldName = all[idx].name;
+  all[idx] = {
+    ...all[idx],
+    name: trimmed,
+  };
+  savePasskeys(all);
+
+  appendAuditLog({
+    type: 'passkey_renamed',
+    title: 'Passkey Renamed',
+    description: `Renamed passkey from "${oldName}" to "${trimmed}".`,
+    credentialId,
+    status: 'success',
+  });
+
+  return all[idx];
+}
+
+/**
+ * Set a passkey as default for the user
+ */
+export function setDefaultPasskey(credentialId: string): void {
+  const all = getAllPasskeys();
+  const target = all.find((p) => p.id === credentialId);
+  if (!target) return;
+
+  const updated = all.map((p) =>
+    p.username.toLowerCase() === target.username.toLowerCase()
+      ? { ...p, isDefault: p.id === credentialId }
+      : p
+  );
+  savePasskeys(updated);
+}
+
+/**
+ * Revoke / delete a passkey
+ */
+export function revokePasskey(credentialId: string): boolean {
+  const all = getAllPasskeys();
+  const target = all.find((p) => p.id === credentialId);
+  if (!target) return false;
+
+  const remaining = all.filter((p) => p.id !== credentialId);
+  savePasskeys(remaining);
+
+  appendAuditLog({
+    type: 'passkey_revoked',
+    title: 'Passkey Revoked',
+    description: `Removed passkey "${target.name}" (${target.providerName}) from account ${target.username}.`,
+    credentialId,
+    status: 'warning',
+  });
+
+  return true;
+}
