+/**
+ * Inspect browser WebAuthn capabilities
+ */
+export async function getWebAuthnCapabilities(): Promise<{
+  supported: boolean;
+  platformAuthenticatorAvailable: boolean;
+  conditionalMediationAvailable: boolean;
+  clientCapabilities: Record<string, boolean>;
+}> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) {
+    return {
+      supported: false,
+      platformAuthenticatorAvailable: false,
+      conditionalMediationAvailable: false,
+      clientCapabilities: {},
+    };
+  }
+
+  let platformAuthenticatorAvailable = false;
+  let conditionalMediationAvailable = false;
+  let clientCapabilities: Record<string, boolean> = {};
+
+  try {
+    if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      platformAuthenticatorAvailable =
+        await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    platformAuthenticatorAvailable = false;
+  }
+
+  try {
+    if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+      conditionalMediationAvailable = await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch {
+    conditionalMediationAvailable = false;
+  }
+
+  try {
+    const pkcAny = PublicKeyCredential as any;
+    if (typeof pkcAny.getClientCapabilities === 'function') {
+      clientCapabilities = await pkcAny.getClientCapabilities();
+    }
+  } catch {
+    // Optional WebAuthn Level 3 API
+  }
+
+  return {
+    supported: true,
+    platformAuthenticatorAvailable,
+    conditionalMediationAvailable,
+    clientCapabilities,
+  };
+}
