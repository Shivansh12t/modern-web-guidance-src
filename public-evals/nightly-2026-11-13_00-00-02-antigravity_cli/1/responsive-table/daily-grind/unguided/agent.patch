+    /* Nutritional & Pricing Breakdown Table */
+    .breakdown-wrapper {
+      margin-top: 40px;
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .breakdown-title {
+      text-align: center;
+      color: var(--primary);
+      font-size: 1.35rem;
+      margin-bottom: 8px;
+    }
+
+    .breakdown-subtitle {
+      text-align: center;
+      font-size: 0.9rem;
+      color: #5d4037;
+      margin-bottom: 16px;
+    }
+
+    .table-responsive {
+      width: 100%;
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+    }
+
+    .table-responsive:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      border-collapse: collapse;
+      min-width: 580px;
+      text-align: left;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      padding: 12px 16px;
+      font-weight: 600;
+      color: var(--primary);
+      background-color: #f5f0ee;
+      border-bottom: 1px solid var(--secondary);
+      text-align: left;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 16px;
+      border-bottom: 1px solid var(--secondary);
+      vertical-align: middle;
+    }
+
+    .nutrition-table thead th {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      font-weight: 600;
+      color: var(--primary);
+      background-color: #fffdfb;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+      border-right: 1px solid var(--secondary);
+    }
+
+    .nutrition-table tbody tr:nth-child(even) {
+      background-color: #faf7f5;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) th[scope="row"] {
+      background-color: #faf7f5;
+    }
+
+    .nutrition-table tbody tr:hover,
+    .nutrition-table tbody tr:hover th[scope="row"] {
+      background-color: #f3ebe8;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .price-cell {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    @media (max-width: 600px) {
+      .breakdown-wrapper {
+        padding: 16px 12px;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+        font-size: 0.875rem;
+      }
+    }
+
