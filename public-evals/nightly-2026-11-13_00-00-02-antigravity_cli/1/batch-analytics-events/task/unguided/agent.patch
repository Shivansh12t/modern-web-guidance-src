+        Object.assign(
+          {
+            title: global.document ? global.document.title : '',
+            referrer: global.document ? global.document.referrer || null : null,
+            viewport: {
+              width: global.innerWidth || 0,
+              height: global.innerHeight || 0
+            }
+          },
+          extra || {}
+        )
+      );
+    }
+
+    function handleDocumentClick(domEvent) {
+      if (!domEvent || !domEvent.target) return;
+
+      var rawTarget =
+        domEvent.target.nodeType === 1
+          ? domEvent.target
+          : domEvent.target.parentElement;
+      if (!rawTarget) return;
+
+      var interactiveEl =
+        typeof rawTarget.closest === 'function'
+          ? rawTarget.closest(
+              'a, button, [role="button"], .btn, .card, [data-analytics-label]'
+            )
+          : null;
+      var targetEl = interactiveEl || rawTarget;
+      var anchorEl =
+        typeof rawTarget.closest === 'function' ? rawTarget.closest('a') : null;
+      var sectionEl =
+        typeof targetEl.closest === 'function'
+          ? targetEl.closest(
+              '[data-analytics-section], nav, header, main, section, footer'
+            )
+          : null;
+
+      var href = anchorEl ? anchorEl.getAttribute('href') : null;
+      if (anchorEl && href && href.charAt(0) === '/') {
+        // Prevent navigating away to non-existent static routes so rapid clicks coalesce
+        domEvent.preventDefault();
+      }
+
+      var rawLabel =
+        (targetEl.getAttribute && targetEl.getAttribute('data-analytics-label')) ||
+        targetEl.innerText ||
+        targetEl.textContent ||
+        '';
+      var cleanLabel = String(rawLabel).trim().replace(/\s+/g, ' ').slice(0, 120);
+
+      var sectionName = sectionEl
+        ? sectionEl.getAttribute('data-analytics-section') ||
+          sectionEl.tagName.toLowerCase()
+        : null;
+
+      enqueueEvent('click', {
+        tag: targetEl.tagName ? targetEl.tagName.toLowerCase() : 'unknown',
+        tagName: targetEl.tagName || 'UNKNOWN',
+        text: cleanLabel,
+        label: cleanLabel,
+        href: href,
+        elementId: targetEl.id || null,
+        className:
+          typeof targetEl.className === 'string' && targetEl.className.trim()
+            ? targetEl.className.trim()
+            : null,
+        section: sectionName,
+        selector: getElementSelector(targetEl),
+        x: typeof domEvent.clientX === 'number' ? domEvent.clientX : 0,
+        y: typeof domEvent.clientY === 'number' ? domEvent.clientY : 0,
+        coordinates: {
+          x: typeof domEvent.clientX === 'number' ? domEvent.clientX : 0,
+          y: typeof domEvent.clientY === 'number' ? domEvent.clientY : 0
+        }
+      });
+    }
+
+    function bindListeners() {
+      if (!global.document) return;
+
+      global.document.addEventListener('click', handleDocumentClick, true);
+
+      global.document.addEventListener('visibilitychange', function () {
+        if (global.document.visibilityState === 'hidden') {
+          flush({ reason: 'visibilitychange', unloading: true });
+        }
+      });
+
+      global.addEventListener('pagehide', function () {
+        flush({ reason: 'pagehide', unloading: true });
+      });
+
+      global.addEventListener('beforeunload', function () {
+        flush({ reason: 'beforeunload', unloading: true });
+      });
+    }
+
+    function init() {
+      bindListeners();
+      trackPageView();
+    }
+
+    return {
+      config: config,
+      sessionId: sessionId,
+      init: init,
+      track: enqueueEvent,
+      trackPageView: trackPageView,
+      flush: flush,
+      getQueue: function () {
+        return queue.slice();
+      },
+      getEvents: function () {
+        return allEvents.slice();
+      },
+      getSentBatches: function () {
+        return sentBatches.slice();
+      },
+      setConfig: function (overrides) {
+        Object.assign(config, overrides || {});
+      }
+    };
+  }
+
+  var tracker = createAnalyticsTracker();
+  global.DailyGrindAnalytics = tracker;
+  global.analytics = tracker;
+
+  if (global.document) {
+    if (global.document.readyState === 'loading') {
+      global.document.addEventListener('DOMContentLoaded', function () {
+        tracker.init();
+      });
+    } else {
+      tracker.init();
+    }
+  }
+})(typeof window !== 'undefined' ? window : globalThis);
