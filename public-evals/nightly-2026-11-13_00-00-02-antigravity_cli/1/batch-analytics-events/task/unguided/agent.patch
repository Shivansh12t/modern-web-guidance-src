+            flush({ reason: 'debounce' });
+          },
+          { timeout: 100 }
+        );
+      } else {
+        flush({ reason: 'debounce' });
+      }
+    }
+
+    function scheduleFlush() {
+      cancelScheduledFlush();
+
+      if (queue.length >= config.maxBatchSize) {
+        deferBackgroundFlush();
+        return;
+      }
+
+      debounceTimer = setTimeout(function () {
+        debounceTimer = null;
+        deferBackgroundFlush();
+      }, config.debounceMs);
+    }
+
+    function enqueueEvent(eventType, details) {
+      var now = Date.now();
+      var telemetryEvent = Object.assign(
+        {
+          id: generateId('evt'),
+          type: eventType,
+          event: eventType,
+          sessionId: sessionId,
+          path: global.location ? global.location.pathname || '/' : '/',
+          url: global.location ? global.location.href : '',
+          timestamp: now,
+          isoTimestamp: new Date(now).toISOString()
