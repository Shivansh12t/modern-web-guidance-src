+        details || {}
+      );
+
+      queue.push(telemetryEvent);
+      allEvents.push(telemetryEvent);
+      persistQueue();
+
+      if (global.CustomEvent && typeof global.dispatchEvent === 'function') {
+        try {
+          global.dispatchEvent(
