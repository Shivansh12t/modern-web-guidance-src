+      return Promise.resolve(null);
+    }
+
+    function flush(options) {
+      var opts = options || {};
+      cancelScheduledFlush();
+
+      if (queue.length === 0) {
+        return null;
+      }
+
+      var eventsToSend = queue.splice(0, queue.length);
+      persistQueue();
+
+      var now = Date.now();
+      var batchPayload = {
+        batchId: generateId('batch'),
+        sessionId: sessionId,
+        sentAt: now,
+        sentAtIso: new Date(now).toISOString(),
+        reason: opts.reason || 'debounce',
+        page: {
