+      sendBackgroundRequest(batchPayload, Boolean(opts.unloading));
+      return batchPayload;
+    }
+
+    function deferBackgroundFlush() {
+      if (typeof global.requestIdleCallback === 'function') {
+        idleCallbackId = global.requestIdleCallback(
+          function () {
