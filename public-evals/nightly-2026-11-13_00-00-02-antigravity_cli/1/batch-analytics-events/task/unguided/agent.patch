+    }
+  }
+
+  function getElementSelector(el) {
+    if (!el || !el.tagName) return 'unknown';
+    var selector = el.tagName.toLowerCase();
+    if (el.id) {
+      selector += '#' + el.id;
+    }
+    if (typeof el.className === 'string' && el.className.trim()) {
+      var classes = el.className.trim().split(/\s+/).slice(0, 3).join('.');
+      if (classes) {
+        selector += '.' + classes;
+      }
+    }
+    var href = el.getAttribute && el.getAttribute('href');
+    if (href) {
+      selector += '[href="' + href + '"]';
+    }
+    return selector;
+  }
+
+  function createAnalyticsTracker(customConfig) {
+    var config = Object.assign({}, DEFAULT_CONFIG, customConfig || {});
+    var sessionId = getSessionId();
+    var queue = [];
+    var allEvents = [];
+    var sentBatches = [];
+    var debounceTimer = null;
+    var idleCallbackId = null;
+
+    function persistQueue() {
+      try {
+        if (global.sessionStorage) {
+          if (queue.length > 0) {
+            global.sessionStorage.setItem(config.storageKey, JSON.stringify(queue));
+          } else {
+            global.sessionStorage.removeItem(config.storageKey);
+          }
+        }
+      } catch (_) {
+        // Ignore storage errors in restricted environments
+      }
+    }
+
+    function cancelScheduledFlush() {
+      if (debounceTimer !== null) {
+        clearTimeout(debounceTimer);
+        debounceTimer = null;
+      }
+      if (idleCallbackId !== null && typeof global.cancelIdleCallback === 'function') {
+        global.cancelIdleCallback(idleCallbackId);
+        idleCallbackId = null;
+      }
+    }
+
+    function sendBackgroundRequest(batchPayload, isUnloading) {
+      var serialized = JSON.stringify(batchPayload);
+
+      if (typeof global.fetch === 'function') {
+        try {
+          var fetchPromise = global.fetch(config.endpoint, {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+              'X-Analytics-Batch-Id': batchPayload.batchId
+            },
+            body: serialized,
+            keepalive: true,
+            priority: 'low'
+          });
+          if (fetchPromise && typeof fetchPromise.catch === 'function') {
+            fetchPromise.catch(function () {
+              // Suppress network errors so telemetry never disrupts the user experience
+            });
+          }
+          return fetchPromise;
+        } catch (_) {
+          // Fallback to sendBeacon below if fetch fails synchronously
+        }
+      }
+
