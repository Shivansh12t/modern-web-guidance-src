@@ -0,0 +1,375 @@
+(function (global) {
+  'use strict';
+
+  if (global.__dailyGrindAnalyticsInitialized && global.DailyGrindAnalytics) {
+    return;
+  }
+  global.__dailyGrindAnalyticsInitialized = true;
+
+  var DEFAULT_CONFIG = {
+    endpoint: '/api/analytics',
+    debounceMs: 400,
+    maxBatchSize: 100,
+    storageKey: 'daily_grind_analytics_queue'
+  };
+
+  function generateId(prefix) {
+    var randomPart = Math.random().toString(36).substring(2, 10);
+    var timePart = Date.now().toString(36);
+    return (prefix || 'evt') + '_' + timePart + '_' + randomPart;
+  }
+
+  function getSessionId() {
