+  <script>
+    // Fallback for older browsers that don't support CSS scroll-driven animations
+    if (
+      !CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)') &&
+      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
+    ) {
+      const nav = document.querySelector('nav');
+      const logo = document.querySelector('.logo');
+      const root = document.documentElement;
+
+      const initialHeight = 88;
+      const finalHeight = 48;
+      const scrollDistance = initialHeight - finalHeight; // 40px
+      const initialLogoScale = 1;
+      const finalLogoScale = 0.82;
+
+      const updateNavOnScroll = () => {
+        const scrollY = Math.max(0, window.scrollY);
+        const scrollPercent = Math.min(1, scrollY / scrollDistance);
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+        const newScale = initialLogoScale - (initialLogoScale - finalLogoScale) * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow = `0 4px 12px rgba(0, 0, 0, ${0.25 * scrollPercent})`;
+        root.style.scrollPaddingTop = `${newHeight}px`;
+        if (logo) {
+          logo.style.transform = `scale(${newScale})`;
+        }
+      };
+
+      window.addEventListener('scroll', updateNavOnScroll, { passive: true });
+      updateNavOnScroll();
+    }
+  </script>
+
