+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var logo = document.querySelector('.logo');
+      var logoutLink = document.querySelector('.logout-link');
+      if (!nav) return;
+
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('animation-timeline: scroll()');
+
+      var maxScroll = 150;
+      var ticking = false;
+
+      function updateNavbar() {
+        var scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
+
+        // Toggle state class for CSS fallback / styling hooks
+        if (scrollY > 30) {
+          nav.classList.add('scrolled');
+        } else {
+          nav.classList.remove('scrolled');
+        }
+
+        // For older browsers without CSS Scroll-Driven Animations,
+        // smoothly interpolate styles linked directly to the scroll position
+        if (!supportsScrollTimeline) {
+          var padRem = 1.25 - (1.25 - 0.45) * progress;
+          var shadowBlur = 6 + (14 - 6) * progress;
+          var shadowAlpha = 0.12 + (0.28 - 0.12) * progress;
+
+          nav.style.paddingTop = padRem.toFixed(3) + 'rem';
+          nav.style.paddingBottom = padRem.toFixed(3) + 'rem';
+          nav.style.boxShadow = '0 3px ' + shadowBlur.toFixed(1) + 'px rgba(0, 0, 0, ' + shadowAlpha.toFixed(2) + ')';
+
+          if (logo) {
+            var logoSize = 1.5 - (1.5 - 1.15) * progress;
+            logo.style.fontSize = logoSize.toFixed(3) + 'rem';
+          }
+
+          if (logoutLink) {
+            var btnPad = 5 - (5 - 3) * progress;
+            logoutLink.style.paddingTop = btnPad.toFixed(1) + 'px';
+            logoutLink.style.paddingBottom = btnPad.toFixed(1) + 'px';
+          }
+        }
+
+        ticking = false;
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          if (typeof window.requestAnimationFrame === 'function') {
+            window.requestAnimationFrame(updateNavbar);
+            ticking = true;
+          } else {
+            updateNavbar();
+          }
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      updateNavbar();
+    })();
+  </script>
