+}
+
+@layer base {
+  :root {
+    --section-variant: default;
+  }
+
+  section[data-featured="true"],
+  section[data-section-context="featured"],
+  .featured-section {
+    --section-variant: featured;
+  }
+}
+
+.teaser-card {
+  position: relative;
+  border-radius: 0.5rem;
+  transition: all 0.2s ease-in-out;
+}
+
+.teaser-promo-badge {
+  display: none;
+  align-items: center;
+  gap: 0.25rem;
+  padding: 0.125rem 0.625rem;
+  border-radius: 9999px;
+  font-size: 0.75rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  background-color: #f59e0b;
+  color: #111827;
+  width: fit-content;
+}
+
+.teaser-action-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.375rem;
+  padding: 0.375rem 0.875rem;
+  border-radius: 0.375rem;
+  font-size: 0.875rem;
+  font-weight: 600;
+  line-height: 1.25rem;
+  transition: all 0.15s ease-in-out;
+  background-color: transparent;
+  color: #111827;
+  border: 1.5px solid #d1d5db;
+  cursor: pointer;
+}
+
+.teaser-action-btn:hover {
+  border-color: #111827;
+  background-color: #f9fafb;
+}
+
+/* Automatic context-aware switching via CSS Container Style Queries & Semantic Parent Selectors */
+@container style(--section-variant: featured) {
+  .teaser-card {
+    background-color: #fffbeb;
+    border: 1px solid #fde68a;
+    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05);
+  }
+
+  .teaser-promo-badge {
+    display: inline-flex;
+  }
+
+  .teaser-action-btn {
+    background-color: #111827;
+    color: #ffffff;
+    border-color: #111827;
+  }
+
+  .teaser-action-btn:hover {
+    background-color: #d97706;
+    border-color: #d97706;
+    color: #ffffff;
+  }
+}
+
+section[data-featured="true"] .teaser-card,
+section[data-section-context="featured"] .teaser-card,
+.featured-section .teaser-card {
+  background-color: #fffbeb;
+  border: 1px solid #fde68a;
+  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05);
+}
+
+section[data-featured="true"] .teaser-promo-badge,
+section[data-section-context="featured"] .teaser-promo-badge,
+.featured-section .teaser-promo-badge {
+  display: inline-flex;
+}
+
+section[data-featured="true"] .teaser-action-btn,
+section[data-section-context="featured"] .teaser-action-btn,
+.featured-section .teaser-action-btn {
+  background-color: #111827;
+  color: #ffffff;
+  border-color: #111827;
+}
+
+section[data-featured="true"] .teaser-action-btn:hover,
+section[data-section-context="featured"] .teaser-action-btn:hover,
+.featured-section .teaser-action-btn:hover {
+  background-color: #d97706;
+  border-color: #d97706;
+  color: #ffffff;
+}
