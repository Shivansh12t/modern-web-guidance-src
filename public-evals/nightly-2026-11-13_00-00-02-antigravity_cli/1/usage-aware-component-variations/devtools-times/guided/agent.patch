diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..b31deb6 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1,7 +1,93 @@
 @import "tailwindcss";
 
+:root {
+  --brand-accent: #d97706;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* 1. Set the semantic context on featured layout containers */
+.featured,
+main.featured {
+  --surface: featured;
+}
+
+/* 2. Default subtle presentation */
+.teaser-card {
+  background: white;
+  border: 1px solid #f3f4f6;
+  border-radius: 0.375rem;
+}
+
+.badge,
+.teaser-badge {
+  display: none;
+  align-items: center;
+  gap: 0.25rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  padding: 0.125rem 0.5rem;
+  border-radius: 9999px;
+  background-color: #fef3c7;
+  color: #92400e;
+  width: fit-content;
+}
+
+.button,
+.teaser-button {
+  background: transparent;
+  border: 1px solid currentColor;
+  color: #374151;
+  padding: 0.375rem 0.75rem;
+  border-radius: 0.375rem;
+  font-size: 0.875rem;
+  font-weight: 500;
+  display: inline-flex;
+  align-items: center;
+  gap: 0.375rem;
+  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
+}
+
+/* 3. Selector-based contextual fallback — broad browser support with :where() for zero container specificity */
+:where(.featured) .teaser-card {
+  border-color: #fde68a;
+  background-color: #fffbeb;
+}
+
+:where(.featured) .badge,
+:where(.featured) .teaser-badge {
+  display: inline-flex;
+}
+
+:where(.featured) .button,
+:where(.featured) .teaser-button {
+  background: var(--brand-accent);
+  color: white;
+  border: 1px solid transparent;
+}
+
+/* 4. Progressive enhancement: container style queries override when supported */
+@container style(--surface: featured) {
+  .teaser-card {
+    border-color: #fde68a;
+    background-color: #fffbeb;
+  }
+
+  .badge,
+  .teaser-badge {
+    display: inline-flex;
+  }
+
+  .button,
+  .teaser-button {
+    background: var(--brand-accent);
+    color: white;
+    border: 1px solid transparent;
+  }
+}
