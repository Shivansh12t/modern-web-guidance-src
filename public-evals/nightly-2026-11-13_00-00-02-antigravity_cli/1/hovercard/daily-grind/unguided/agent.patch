+  <script>
+    (function () {
+      const wrappers = document.querySelectorAll('.hovercard-wrapper');
+
+      wrappers.forEach((wrapper) => {
+        let hideTimeout;
+        const trigger = wrapper.querySelector('.btn');
+        const hovercard = wrapper.querySelector('.hovercard');
+        const priceEl = wrapper.querySelector('.hovercard-price');
+        const specValues = wrapper.querySelectorAll('.hovercard-spec-value');
+        const sizePills = wrapper.querySelectorAll('.hovercard-size-pill');
+        const quickAddBtn = wrapper.querySelector('.hovercard-quick-add');
+
+        const openCard = () => {
+          clearTimeout(hideTimeout);
+          wrappers.forEach((other) => {
+            if (other !== wrapper) other.classList.remove('is-open');
+          });
+          wrapper.classList.add('is-open');
+        };
+
+        const closeCard = () => {
+          hideTimeout = setTimeout(() => {
+            wrapper.classList.remove('is-open');
+          }, 120);
+        };
+
+        wrapper.addEventListener('mouseenter', openCard);
+        wrapper.addEventListener('mouseleave', closeCard);
+        wrapper.addEventListener('focusin', openCard);
+        wrapper.addEventListener('focusout', (e) => {
+          if (!wrapper.contains(e.relatedTarget)) {
+            closeCard();
+          }
+        });
+
+        // Interactive size/shot selection inside hovercard preview
+        sizePills.forEach((pill) => {
+          pill.addEventListener('click', (e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            sizePills.forEach((p) => p.classList.remove('active'));
+            pill.classList.add('active');
+
+            if (priceEl && pill.dataset.price) {
+              priceEl.textContent = pill.dataset.price;
+            }
+            if (specValues.length >= 2) {
+              if (pill.dataset.caf) specValues[0].textContent = pill.dataset.caf;
+              if (pill.dataset.cal) specValues[1].textContent = pill.dataset.cal;
+            }
+          });
+        });
+
+        // Interactive Quick Add button feedback
+        if (quickAddBtn) {
+          quickAddBtn.addEventListener('click', (e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            const originalText = '+ Quick Add';
+            quickAddBtn.textContent = '✓ Added';
+            quickAddBtn.style.background = '#2e7d32';
+            quickAddBtn.style.borderColor = '#2e7d32';
+            quickAddBtn.style.color = '#ffffff';
+            setTimeout(() => {
+              quickAddBtn.textContent = originalText;
+              quickAddBtn.style.background = '';
+              quickAddBtn.style.borderColor = '';
+              quickAddBtn.style.color = '';
+            }, 1400);
+          });
+        }
+      });
+
+      // Dismiss hovercards on Escape key
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          wrappers.forEach((w) => w.classList.remove('is-open'));
+        }
+      });
+    })();
+  </script>
+
 </body>
 
