+  <script type="module">
+    const TASTING_HUBS = [
+      {
+        city: 'Tokyo',
+        region: 'Japan',
+        timeZone: 'Asia/Tokyo',
+        roastNote: 'Pour-Over Lab • Geisha & Matcha Fusion'
+      },
+      {
+        city: 'New York',
+        region: 'United States',
+        timeZone: 'America/New_York',
+        roastNote: 'Flagship Roastery • Single-Origin Espresso'
+      },
+      {
+        city: 'London',
+        region: 'United Kingdom',
+        timeZone: 'Europe/London',
+        roastNote: 'Tasting Room • Washed Kenyan Cupping'
+      },
+      {
+        city: 'Berlin',
+        region: 'Germany',
+        timeZone: 'Europe/Berlin',
+        roastNote: 'Nordic Roast Studio • Light Filter Flight'
+      },
+      {
+        city: 'Seattle',
+        region: 'United States',
+        timeZone: 'America/Los_Angeles',
+        roastNote: 'Reserve Roastery • Barrel-Aged Cold Brew'
+      },
+      {
+        city: 'Sydney',
+        region: 'Australia',
+        timeZone: 'Australia/Sydney',
+        roastNote: 'Harbour Bar • Flat White & Natural Process'
+      }
+    ];
+
+    function updateCoordinator() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const conflictNotice = document.getElementById('conflictNotice');
+      const hostSummary = document.getElementById('hostSummary');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) {
+        grid.innerHTML = '';
+        conflictNotice.hidden = true;
+        hostSummary.textContent = 'Please provide a valid date, time, and host time zone.';
+        return;
+      }
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition conflicts using disambiguation: 'reject'
+      let hasConflict = false;
+      let conflictMessage = '';
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+          conflictMessage = `Invalid or ambiguous wall-clock time (${time} on ${date} in ${timeZone}): this time falls in a Daylight Saving Time transition gap or overlap and was rejected by strict validation.`;
+        } else {
+          throw e;
+        }
+      }
+
+      // Resolve the host time safely using disambiguation: 'compatible'
+      let hostTime;
+      try {
+        hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+      } catch (err) {
+        conflictNotice.hidden = false;
+        conflictNotice.textContent = `Unable to parse date/time input: ${err.message}`;
+        grid.innerHTML = '';
+        return;
+      }
+
+      const hostFormattedTime = hostTime.toLocaleString('en-US', {
+        hour: 'numeric',
+        minute: '2-digit'
+      });
+      const hostFormattedDate = hostTime.toLocaleString('en-US', {
+        weekday: 'short',
+        month: 'short',
+        day: 'numeric',
+        year: 'numeric'
+      });
+
+      if (hasConflict) {
+        conflictNotice.hidden = false;
+        conflictNotice.textContent = `${conflictMessage} Resolved compatible time: ${hostFormattedTime} (${hostTime.offset}).`;
+      } else {
+        conflictNotice.hidden = true;
+        conflictNotice.textContent = '';
+      }
+
+      hostSummary.innerHTML = `
+        <span><strong>Host Session (${hostTime.timeZoneId}):</strong> ${hostFormattedDate} at ${hostFormattedTime} (UTC${hostTime.offset})</span>
+        <span><strong>Status:</strong> ${hasConflict ? 'DST Transition Conflict Rejected (Compatible Fallback Shown)' : 'Valid Local Time'}</span>
+      `;
+
+      grid.innerHTML = '';
+
+      for (const hub of TASTING_HUBS) {
+        const converted = hostTime.withTimeZone(hub.timeZone);
+        const displayTime = converted.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const displayDate = converted.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const isHost = hub.timeZone === timeZone;
+        const card = document.createElement('article');
+        card.className = `card${isHost ? ' is-host' : ''}${hasConflict ? ' has-conflict' : ''}`;
+        card.dataset.timezone = hub.timeZone;
+
+        card.innerHTML = `
+          <span class="card-badge">${isHost ? 'Host Roastery' : hub.region}</span>
+          <div>
+            <h3>${hub.city}</h3>
+            <p class="tz-identifier">${hub.timeZone} (UTC${converted.offset})</p>
+          </div>
+          <div>
+            <p class="converted-time">${displayTime}</p>
+            <p class="converted-date">${displayDate}</p>
+          </div>
+          <p class="tasting-note">${hub.roastNote}</p>
+        `;
+
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      dateInput.addEventListener('input', updateCoordinator);
+      dateInput.addEventListener('change', updateCoordinator);
+      timeInput.addEventListener('input', updateCoordinator);
+      timeInput.addEventListener('change', updateCoordinator);
+      hostTzSelect.addEventListener('change', updateCoordinator);
+
+      updateCoordinator();
+    }
+
+    // Check if Temporal is supported natively
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        // Load the polyfill conditionally
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        // Extend Date.prototype if needed
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
