+  <script>
+    const TARGET_HUBS = [
+      { city: 'New York', tz: 'America/New_York', roast: 'Brooklyn Reserve Espresso' },
+      { city: 'Los Angeles', tz: 'America/Los_Angeles', roast: 'West Coast Single Origin' },
+      { city: 'London', tz: 'Europe/London', roast: 'Thames Artisanal Pour-Over' },
+      { city: 'Paris', tz: 'Europe/Paris', roast: 'Left Bank Dark Roast' },
+      { city: 'Tokyo', tz: 'Asia/Tokyo', roast: 'Shibuya Precision Drip' },
+      { city: 'Sydney', tz: 'Australia/Sydney', roast: 'Harbour Flat White Blend' },
+      { city: 'Addis Ababa', tz: 'Africa/Addis_Ababa', roast: 'Yirgacheffe Heirloom' },
+      { city: 'Bogotá', tz: 'America/Bogota', roast: 'Andean Supremo Washed' }
+    ];
+
+    function getWallClockParts(epochMs, timeZone) {
+      const formatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        year: 'numeric',
+        month: '2-digit',
+        day: '2-digit',
+        hour: '2-digit',
+        minute: '2-digit',
+        second: '2-digit',
+        hourCycle: 'h23'
+      });
+      const parts = formatter.formatToParts(new Date(epochMs));
+      const map = {};
+      for (const part of parts) {
+        if (part.type !== 'literal') {
+          map[part.type] = parseInt(part.value, 10);
+        }
+      }
+      return map;
+    }
+
+    function getTimeZoneOffsetMs(epochMs, timeZone) {
+      const parts = getWallClockParts(epochMs, timeZone);
+      const wallAsUtc = Date.UTC(
+        parts.year,
+        parts.month - 1,
+        parts.day,
+        parts.hour,
+        parts.minute,
+        parts.second || 0
+      );
+      return wallAsUtc - epochMs;
+    }
+
+    function resolveHostWallTime(dateStr, timeStr, hostTz) {
+      if (!dateStr || !timeStr || !hostTz) {
+        return { valid: false, reason: 'Please enter a valid date, time, and host timezone.' };
+      }
+
+      const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr.trim());
+      const timeMatch = /^(\d{2}):(\d{2})(?::(\d{2}))?$/.exec(timeStr.trim());
+      if (!dateMatch || !timeMatch) {
+        return { valid: false, reason: 'Invalid date or time format.' };
+      }
+
+      const year = parseInt(dateMatch[1], 10);
+      const month = parseInt(dateMatch[2], 10);
+      const day = parseInt(dateMatch[3], 10);
+      const hour = parseInt(timeMatch[1], 10);
+      const minute = parseInt(timeMatch[2], 10);
+
+      if (month < 1 || month > 12 || day < 1 || day > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59) {
+        return { valid: false, reason: 'Date or time values are out of range.' };
+      }
+
+      // Check calendar date validity (e.g. Feb 30)
+      const checkDate = new Date(Date.UTC(year, month - 1, day));
+      if (
+        checkDate.getUTCFullYear() !== year ||
+        checkDate.getUTCMonth() + 1 !== month ||
+        checkDate.getUTCDate() !== day
+      ) {
+        return { valid: false, reason: 'Invalid calendar date.' };
+      }
+
+      const targetWallUtc = Date.UTC(year, month - 1, day, hour, minute, 0);
+
+      // Probe offsets around the target wall time (-36h to +36h) to find all candidate UTC instants
+      const probeOffsets = new Set();
+      for (let deltaHours = -36; deltaHours <= 36; deltaHours += 3) {
+        const probeMs = targetWallUtc + deltaHours * 3600 * 1000;
+        probeOffsets.add(getTimeZoneOffsetMs(probeMs, hostTz));
+      }
+
+      const matchingInstants = [];
+      for (const offsetMs of probeOffsets) {
+        const candidateUtc = targetWallUtc - offsetMs;
+        const actualParts = getWallClockParts(candidateUtc, hostTz);
+        if (
+          actualParts.year === year &&
+          actualParts.month === month &&
+          actualParts.day === day &&
+          actualParts.hour === hour &&
+          actualParts.minute === minute
+        ) {
+          matchingInstants.push(candidateUtc);
+        }
+      }
+
+      matchingInstants.sort((a, b) => a - b);
+
+      if (matchingInstants.length === 0) {
+        return {
+          valid: false,
+          reason: `Invalid local time: ${dateStr} ${timeStr} does not exist in ${hostTz} due to a Daylight Saving Time (DST) spring-forward transition.`
+        };
+      }
+
+      return {
+        valid: true,
+        epochMs: matchingInstants[0],
+        ambiguous: matchingInstants.length > 1
+      };
+    }
+
+    function isDstActive(epochMs, timeZone) {
+      const year = getWallClockParts(epochMs, timeZone).year;
+      const janOffset = getTimeZoneOffsetMs(Date.UTC(year, 0, 1, 12, 0, 0), timeZone);
+      const julOffset = getTimeZoneOffsetMs(Date.UTC(year, 6, 1, 12, 0, 0), timeZone);
+      if (janOffset === julOffset) {
+        return { observesDst: false, inDst: false };
+      }
+      const standardOffset = Math.min(janOffset, julOffset);
+      const currentOffset = getTimeZoneOffsetMs(epochMs, timeZone);
+      return {
+        observesDst: true,
+        inDst: currentOffset !== standardOffset
+      };
+    }
+
+    function formatTargetZone(epochMs, timeZone) {
+      const parts = getWallClockParts(epochMs, timeZone);
+      const pad = (n) => String(n).padStart(2, '0');
+      const time24 = `${pad(parts.hour)}:${pad(parts.minute)}`;
+
+      const time12Formatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        hour: 'numeric',
+        minute: '2-digit',
+        hour12: true
+      });
+      const time12 = time12Formatter.format(new Date(epochMs));
+
+      const dateFormatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        weekday: 'short',
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric'
+      });
+      const formattedDate = dateFormatter.format(new Date(epochMs));
+
+      const tzNameFormatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        timeZoneName: 'short'
+      });
+      const tzNameParts = tzNameFormatter.formatToParts(new Date(epochMs));
+      const tzAbbr = (tzNameParts.find(p => p.type === 'timeZoneName') || {}).value || timeZone;
+
+      const offsetFormatter = new Intl.DateTimeFormat('en-US', {
+        timeZone,
+        timeZoneName: 'shortOffset'
+      });
+      const offsetParts = offsetFormatter.formatToParts(new Date(epochMs));
+      const gmtOffset = (offsetParts.find(p => p.type === 'timeZoneName') || {}).value || '';
+
+      const dstInfo = isDstActive(epochMs, timeZone);
+
+      return {
+        time24,
+        time12,
+        isoDate: `${parts.year}-${pad(parts.month)}-${pad(parts.day)}`,
+        formattedDate,
+        tzAbbr,
+        gmtOffset,
+        dstInfo
+      };
+    }
+
+    function renderCoordinator() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const grid = document.getElementById('grid');
+      const errorMessage = document.getElementById('errorMessage');
+
+      const dateStr = dateInput.value;
+      const timeStr = timeInput.value;
+      const hostTz = hostTzSelect.value;
+
+      const resolution = resolveHostWallTime(dateStr, timeStr, hostTz);
+
+      if (!resolution.valid) {
+        timeInput.setCustomValidity(resolution.reason);
+        errorMessage.textContent = resolution.reason;
+        errorMessage.classList.add('visible');
+        grid.innerHTML = `
+          <div class="card error-card" data-status="invalid">
+            <h3>Invalid Event Time (DST Gap)</h3>
+            <p>${resolution.reason}</p>
+          </div>
+        `;
+        return;
+      }
+
+      timeInput.setCustomValidity('');
+      errorMessage.textContent = '';
+      errorMessage.classList.remove('visible');
+
+      // Build list of zones to render, ensuring the selected host timezone is also included if not in default list
+      const hubs = [...TARGET_HUBS];
+      if (!hubs.some(h => h.tz === hostTz)) {
+        const cityLabel = hostTz.split('/').pop().replace(/_/g, ' ');
+        hubs.unshift({ city: cityLabel, tz: hostTz, roast: 'Host Reserve Selection' });
+      }
+
+      grid.innerHTML = hubs.map(hub => {
+        const info = formatTargetZone(resolution.epochMs, hub.tz);
+        const isHost = hub.tz === hostTz;
+        const dstLabel = info.dstInfo.observesDst
+          ? (info.dstInfo.inDst ? 'DST Active' : 'Standard Time')
+          : 'No DST Observed';
+
+        return `
+          <div class="card ${isHost ? 'host-card' : ''}" data-tz="${hub.tz}" data-city="${hub.city}">
+            <h3>${hub.city}${isHost ? ' (Host)' : ''}</h3>
+            <span class="tz-badge">${hub.tz} &bull; ${info.tzAbbr} (${info.gmtOffset})</span>
+            <div class="converted-time" data-time24="${info.time24}">${info.time24} <span style="font-size: 1rem; font-weight: 500;">(${info.time12})</span></div>
+            <div class="converted-date" data-date="${info.isoDate}">${info.formattedDate}</div>
+            <div class="dst-status">${dstLabel} &bull; ${hub.roast}</div>
+          </div>
+        `;
+      }).join('');
+    }
+
+    document.getElementById('dateInput').addEventListener('input', renderCoordinator);
+    document.getElementById('dateInput').addEventListener('change', renderCoordinator);
+    document.getElementById('timeInput').addEventListener('input', renderCoordinator);
+    document.getElementById('timeInput').addEventListener('change', renderCoordinator);
+    document.getElementById('hostTzSelect').addEventListener('input', renderCoordinator);
+    document.getElementById('hostTzSelect').addEventListener('change', renderCoordinator);
+
+    renderCoordinator();
+  </script>
 </body>
 
 </html>
