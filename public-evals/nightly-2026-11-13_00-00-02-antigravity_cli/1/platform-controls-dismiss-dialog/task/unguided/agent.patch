+  <script>
+    (function () {
+      const COFFEE_DETAILS = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          badge: 'Seasonal Limited Edition',
+          price: '$5.75',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Cup of Maple Oat Latte with latte art',
+          description: 'Our signature double-shot espresso blended with velvety steamed oat milk and pure Grade A dark amber Vermont maple syrup, finished with a light dusting of spiced cinnamon sugar.',
+          notes: 'Warm Maple, Toasted Oat, Subtle Cinnamon',
+          ingredients: 'Organic Espresso, Barista Oat Milk, Pure Vermont Maple Syrup, Cinnamon (Vegan, Dairy-Free)',
+          sizes: '12 oz (210 cal) • 16 oz (270 cal)'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          badge: "Roaster's Reserve",
+          price: '$3.95',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Freshly pulled shot of Dark Roast Espresso with rich crema',
+          description: 'Slow-roasted in small batches to a deep, glistening finish, this single-origin Sumatra and Colombian blend delivers an intense, full-bodied espresso with low acidity and a rich velvety crema.',
+          notes: 'Dark Chocolate, Cedar Smoke, Molasses',
+          ingredients: '100% Arabica Dark Roast Coffee Beans, Filtered Water (Vegan, Unsweetened)',
+          sizes: 'Double Shot 2 oz (10 cal) • Quad Shot 4 oz (20 cal)'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          badge: 'House Craft',
+          price: '$4.95',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Tall glass of Cold Brew coffee poured over ice',
+          description: 'Coarsely ground Ethiopian and Guatemalan beans steeped in cold filtered water for 18 hours, producing a naturally sweet, silky-smooth coffee served over crystal-clear artisan ice.',
+          notes: 'Sweet Cocoa, Caramel, Crisp Citrus Finish',
+          ingredients: '100% Arabica Cold-Steeped Coffee, Filtered Water, Artisan Ice (Vegan, Zero Sugar)',
+          sizes: '16 oz (15 cal) • 20 oz (20 cal)'
+        }
+      };
+
+      const dialog = document.getElementById('coffee-details-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalBadge = document.getElementById('modal-badge');
+      const modalPrice = document.getElementById('modal-price');
+      const modalImage = document.getElementById('modal-image');
+      const modalDescription = document.getElementById('modal-description');
+      const modalNotes = document.getElementById('modal-notes');
+      const modalIngredients = document.getElementById('modal-ingredients');
+      const modalSizes = document.getElementById('modal-sizes');
+      const closeIconBtn = document.getElementById('modal-close-btn');
+      const dismissBtn = document.getElementById('modal-dismiss-btn');
+      const detailButtons = document.querySelectorAll('.details-btn');
+
+      let activeWatcher = null;
+      let lastTrigger = null;
+
+      function isModalOpen() {
+        return Boolean(dialog.open || dialog.hasAttribute('open'));
+      }
+
+      function closeModal() {
+        if (!isModalOpen()) return;
+        if (typeof dialog.close === 'function') {
+          dialog.close();
+        } else {
+          dialog.removeAttribute('open');
+          dialog.dispatchEvent(new Event('close'));
+        }
+      }
+
+      function openModal(coffeeKey, triggerEl) {
+        const data = COFFEE_DETAILS[coffeeKey];
+        if (!data) return;
+
+        lastTrigger = triggerEl || document.activeElement;
+
+        modalTitle.textContent = data.title;
+        modalBadge.textContent = data.badge;
+        modalPrice.textContent = data.price;
+        modalImage.src = data.image;
+        modalImage.alt = data.imageAlt;
+        modalDescription.textContent = data.description;
+        modalNotes.textContent = data.notes;
+        modalIngredients.textContent = data.ingredients;
+        modalSizes.textContent = data.sizes;
+
+        document.body.classList.add('modal-open');
+
+        if (!isModalOpen()) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+
+        // Integrate with the platform CloseWatcher API for desktop Escape & mobile back gestures
+        if ('CloseWatcher' in window) {
+          try {
+            if (activeWatcher) {
+              activeWatcher.destroy();
+            }
+            activeWatcher = new window.CloseWatcher();
+            activeWatcher.onclose = () => {
+              activeWatcher = null;
+              closeModal();
+            };
+          } catch (err) {
+            activeWatcher = null;
+          }
+        }
+
+        // Fallback history state so mobile back navigation / popstate also dismisses the modal
+        if (window.history && typeof window.history.pushState === 'function') {
+          window.history.pushState({ coffeeModal: coffeeKey }, '');
+        }
+
+        closeIconBtn.focus();
+      }
+
+      detailButtons.forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          openModal(btn.getAttribute('data-coffee'), btn);
+        });
+      });
+
+      closeIconBtn.addEventListener('click', () => closeModal());
+      dismissBtn.addEventListener('click', () => closeModal());
+
+      // Dismiss when clicking the backdrop outside the modal content
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) {
+          closeModal();
+        }
+      });
+
+      // Clean up CloseWatcher and restore focus whenever the dialog closes
+      dialog.addEventListener('close', () => {
+        if (activeWatcher) {
+          const watcher = activeWatcher;
+          activeWatcher = null;
+          watcher.destroy();
+        }
+        document.body.classList.remove('modal-open');
+        if (lastTrigger && typeof lastTrigger.focus === 'function') {
+          lastTrigger.focus();
+        }
+      });
+
+      // Fallback Escape key handler and popstate handler for back navigation
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && isModalOpen()) {
+          closeModal();
+        }
+      });
+
+      window.addEventListener('popstate', () => {
+        if (isModalOpen()) {
+          closeModal();
+        }
+      });
+    })();
+  </script>
