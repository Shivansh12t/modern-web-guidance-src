+            glCtx.bindBuffer(glCtx.ARRAY_BUFFER, f.buffer);
+            glCtx.enableVertexAttribArray(aPosition);
+            glCtx.vertexAttribPointer(aPosition, 3, glCtx.FLOAT, false, 20, 0);
+            glCtx.enableVertexAttribArray(aTexCoord);
+            glCtx.vertexAttribPointer(aTexCoord, 2, glCtx.FLOAT, false, 20, 12);
+            glCtx.bindTexture(glCtx.TEXTURE_2D, f.tex);
+            glCtx.uniform1f(uShade, f.shade);
+            glCtx.drawArrays(glCtx.TRIANGLES, 0, 6);
+          });
+
+          // Synchronize DOM form hit-testing matrix via getElementTransform
+          const cssToUnit = new DOMMatrix()
+            .scale(BOX_W / formPanel.offsetWidth, -BOX_H / formPanel.offsetHeight, 1)
+            .translate(-formPanel.offsetWidth / 2, -formPanel.offsetHeight / 2, BOX_D / 2);
+
+          const clipToViewport = new DOMMatrix()
+            .translate(cw / 2, ch / 2, 0)
+            .scale(cw / 2, -ch / 2, 1);
+
+          const screenMatrix = clipToViewport.multiply(mvp).multiply(cssToUnit);
+          const computed = canvas.getElementTransform(formPanel, screenMatrix);
+          if (computed) {
+            formPanel.style.transform = computed.toString();
+          }
+        };
+      }
+
+      // ============================================================================
+      // MODE 2: Native 2D Canvas HTML-in-Canvas (`drawElementImage` + `getElementTransform`)
+      // ============================================================================
+      function init2DHtmlInCanvasRenderer() {
+        rendererBadgeText.textContent = '2D HTML-in-Canvas Active (drawElementImage)';
+        rendererBadge.classList.remove('fallback-active');
+        fallbackNotice.classList.remove('visible');
+
+        const ctx = canvas.getContext('2d');
+        canvas.addEventListener('paint', () => {
+          // Redraw triggered when child HTML form updates
+        });
+
+        return function render2DFrame() {
+          const cw = canvas.width;
+          const ch = canvas.height;
+          ctx.clearRect(0, 0, cw, ch);
+
+          // Draw subtle floor shadow beneath the floating 3D coffee box
+          ctx.save();
+          ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';
+          ctx.beginPath();
+          ctx.ellipse(cw / 2, ch - 42, 160, 22, 0, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.restore();
+
+          syncFormElementTransformWithCanvas(cw, ch, state.rotX, state.rotY);
+
+          ctx.save();
+          const radY = (state.rotY * Math.PI) / 180;
+          const radX = (state.rotX * Math.PI) / 180;
+          const cosY = Math.cos(radY);
+          const sinY = Math.sin(radY);
+
+          // Draw visible side face for 3D depth before drawing front HTML face
+          const frontX = (cw - BOX_W * Math.abs(cosY)) / 2;
+          const frontY = (ch - BOX_H) / 2;
+          const sideWidth = BOX_D * Math.abs(sinY);
+
+          if (sinY < 0) {
+            ctx.drawImage(sideFaceCanvas, frontX + BOX_W * Math.abs(cosY), frontY + radX * 15, sideWidth, BOX_H);
+          } else {
+            ctx.drawImage(sideFaceCanvas, frontX - sideWidth, frontY + radX * 15, sideWidth, BOX_H);
+          }
+
+          if (cosY >= 0) {
+            const transform = ctx.drawElementImage(
+              formPanel,
+              frontX,
+              frontY,
+              BOX_W * cosY,
+              BOX_H
+            );
+            if (transform) {
+              formPanel.style.transform = transform.toString();
+            }
+          } else {
+            ctx.drawImage(backFaceCanvas, frontX, frontY, BOX_W * Math.abs(cosY), BOX_H);
+          }
+          ctx.restore();
+        };
+      }
+
+      // ============================================================================
+      // MODE 3: Fallback Renderer for Browsers Without Native HTML-in-Canvas Support
+      // Renders ambient 3D particles/shadow on the canvas and projects the live HTML
+      // form onto a synchronized CSS 3D coffee box so every input & button works.
+      // ============================================================================
+      function initFallback3DRenderer() {
+        rendererBadgeText.textContent = '3D CSS Projection Fallback Active';
+        rendererBadge.classList.add('fallback-active');
+        fallbackNotice.classList.add('visible');
+
+        // Move the real HTML form panel into the front face of the CSS 3D coffee box
+        fallbackViewport.classList.add('active');
+        fallbackFrontSlot.appendChild(formPanel);
+        formPanel.style.position = 'relative';
+        formPanel.style.transform = 'none';
+
+        const ctx = canvas.getContext('2d');
+        // Coffee aroma particles rendered on the background canvas
+        const particles = Array.from({ length: 24 }, (_, i) => ({
+          x: (i * 37) % canvas.width,
+          y: (i * 53) % canvas.height,
+          r: 1.5 + (i % 3),
+          speedY: 0.3 + (i % 4) * 0.15,
+          alpha: 0.15 + (i % 5) * 0.08
+        }));
+
+        return function renderFallbackFrame() {
+          const cw = canvas.width;
+          const ch = canvas.height;
+          if (ctx) {
+            ctx.clearRect(0, 0, cw, ch);
+
+            // Dynamic 3D ground shadow on the canvas beneath the rotating box
+            const shadowScale = 1 + Math.abs(Math.sin((state.rotY * Math.PI) / 180)) * 0.22;
+            const grad = ctx.createRadialGradient(cw / 2, ch - 38, 10, cw / 2, ch - 38, 195 * shadowScale);
+            grad.addColorStop(0, 'rgba(0, 0, 0, 0.55)');
+            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
+            ctx.fillStyle = grad;
+            ctx.beginPath();
+            ctx.ellipse(cw / 2, ch - 38, 185 * shadowScale, 28, 0, 0, Math.PI * 2);
+            ctx.fill();
+
+            // Subtle rising roast aroma particles
+            particles.forEach((p) => {
+              p.y -= p.speedY;
+              if (p.y < 0) p.y = ch;
+              ctx.fillStyle = `rgba(255, 171, 64, ${p.alpha})`;
+              ctx.beginPath();
+              ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
+              ctx.fill();
+            });
+          }
+
+          // Apply 3D transform to the coffee box container; the live HTML form sits on its front face
+          css3dBox.style.transform = `rotateX(${state.rotX.toFixed(2)}deg) rotateY(${state.rotY.toFixed(2)}deg)`;
+        };
+      }
+
+      // Select appropriate renderer based on feature detection
+      let renderSceneFrame;
+      if (supportsWebGLHtmlInCanvas && gl) {
+        renderSceneFrame = initWebGLHtmlInCanvasRenderer(gl);
+      } else if (supports2DHtmlInCanvas) {
+        renderSceneFrame = init2DHtmlInCanvasRenderer();
+      } else {
+        renderSceneFrame = initFallback3DRenderer();
+      }
+
+      updatePackageDetails();
+
+      // Main animation loop keeping the 3D coffee box and projected HTML form in sync
+      function animateLoop() {
+        if (state.autoRotate && !state.isDragging && !state.formFocused) {
+          state.spinTime += 0.016;
+          // Smoothly oscillate between -32deg and +32deg so the front HTML form stays readable and clickable
+          state.targetRotY = Math.sin(state.spinTime) * 30;
+          state.targetRotX = 8 + Math.cos(state.spinTime * 0.7) * 6;
+          rotYSlider.value = String(Math.round(state.targetRotY));
+          rotXSlider.value = String(Math.round(state.targetRotX));
+        }
+
+        // Smooth damping toward target angles
+        state.rotY += (state.targetRotY - state.rotY) * 0.12;
+        state.rotX += (state.targetRotX - state.rotX) * 0.12;
+
+        renderSceneFrame();
+        requestAnimationFrame(animateLoop);
+      }
+
+      requestAnimationFrame(animateLoop);
+    })();
+  </script>
 </body>
 
 </html>
