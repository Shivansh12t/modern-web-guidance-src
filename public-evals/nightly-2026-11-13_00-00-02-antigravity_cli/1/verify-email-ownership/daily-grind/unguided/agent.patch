+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+const dns = require('dns').promises;
+const { URL } = require('url');
+
+const PORT = process.env.PORT || 11222;
+const STATIC_DIR = __dirname;
+
+// Store active nonces and registered accounts in memory
+const issuedNonces = new Map(); // nonce -> { createdAt }
+const DEFAULT_NONCE = 'dg-rewards-nonce-2026-evt';
+issuedNonces.set(DEFAULT_NONCE, { createdAt: Date.now(), persistent: true });
+
+const registeredAccounts = [];
+
+function createNonce() {
+  const nonce = crypto.randomBytes(16).toString('base64url');
+  issuedNonces.set(nonce, { createdAt: Date.now() });
+  return nonce;
+}
+
+function base64UrlDecodeToBuffer(str) {
+  let base64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  while (base64.length % 4 !== 0) {
+    base64 += '=';
+  }
+  return Buffer.from(base64, 'base64');
+}
+
+function decodeJwtPart(part) {
+  return JSON.parse(base64UrlDecodeToBuffer(part).toString('utf8'));
+}
+
+function parseJwt(jwtStr) {
+  const segments = jwtStr.split('.');
+  if (segments.length !== 3) {
+    throw new Error('Invalid JWT structure');
+  }
+  const header = decodeJwtPart(segments[0]);
+  const payload = decodeJwtPart(segments[1]);
+  const signature = base64UrlDecodeToBuffer(segments[2]);
+  const signingInput = Buffer.from(`${segments[0]}.${segments[1]}`, 'utf8');
+  return { header, payload, signature, signingInput, raw: jwtStr };
+}
+
+function verifyJwsSignature(parsedJwt, jwk) {
+  const pubKey = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+  const alg = parsedJwt.header.alg || jwk.alg;
+
+  if (alg === 'EdDSA' || jwk.kty === 'OKP' || jwk.crv === 'Ed25519') {
+    return crypto.verify(null, parsedJwt.signingInput, pubKey, parsedJwt.signature);
+  }
+
+  let hashAlg = 'sha256';
+  if (alg === 'ES384' || alg === 'RS384' || alg === 'PS384') hashAlg = 'sha384';
+  if (alg === 'ES512' || alg === 'RS512' || alg === 'PS512') hashAlg = 'sha512';
+
+  const verifyOpts = { key: pubKey };
+  if (alg && alg.startsWith('ES')) {
+    verifyOpts.dsaEncoding = 'ieee-p1363';
+  } else if (alg && alg.startsWith('PS')) {
+    verifyOpts.padding = crypto.constants.RSA_PKCS1_PSS_PADDING;
+    verifyOpts.saltLength = crypto.constants.RSA_PSS_SALTLEN_DIGEST;
+  }
+
+  return crypto.verify(hashAlg, parsedJwt.signingInput, verifyOpts, parsedJwt.signature);
+}
+
+async function resolveIssuerFromDns(emailDomain) {
+  try {
+    const records = await dns.resolveTxt(`_email-verification.${emailDomain}`);
+    for (const chunks of records) {
+      const txt = chunks.join('').trim();
+      const match = txt.match(/(?:^|;\s*)iss=([^\s;]+)/i);
+      if (match && match[1]) {
+        return match[1];
+      }
+    }
+  } catch (_) {
+    // DNS lookup may not be configured in local/offline test environments
+  }
+  return null;
+}
+
+async function fetchIssuerJwks(issuerIdentifier) {
+  try {
+    const issuerOrigin = issuerIdentifier.startsWith('http://') || issuerIdentifier.startsWith('https://')
+      ? issuerIdentifier
+      : `https://${issuerIdentifier}`;
+    const wellKnownUrl = new URL('/.well-known/email-verification', issuerOrigin).toString();
+    const metaRes = await fetch(wellKnownUrl, {
+      headers: { Accept: 'application/json' },
+      signal: AbortSignal.timeout(3000)
+    });
+    if (!metaRes.ok) return null;
+    const metadata = await metaRes.json();
+    if (!metadata || !metadata.jwks_uri) return null;
+
+    const jwksRes = await fetch(metadata.jwks_uri, {
+      headers: { Accept: 'application/json' },
+      signal: AbortSignal.timeout(3000)
+    });
+    if (!jwksRes.ok) return null;
+    return await jwksRes.json();
+  } catch (_) {
+    return null;
+  }
+}
+
+/**
+ * Validates an Email Verification Protocol (EVP) token (SD-JWT+KB / EVT+KB)
+ * following the WICG Email Verification API / IETF EVP Verifier Processing Model.
+ */
+async function verifyEmailVerificationToken(rawToken, submittedEmail, expectedNonce, expectedOrigin) {
+  if (!rawToken || typeof rawToken !== 'string' || !rawToken.trim()) {
+    return {
+      verified: false,
+      method: 'none',
+      reason: 'No Email Verification Token (EVT) was provided by the browser.'
+    };
+  }
+
+  const trimmedToken = rawToken.trim();
+
+  // Split SD-JWT+KB on '~'
+  const parts = trimmedToken.split('~');
+  const evtPart = parts[0];
+  // In SD-JWT+KB: <EVT>~<Disclosures...>~<KB-JWT>
+  const kbPart = parts.length > 1 ? parts[parts.length - 1] || parts[parts.length - 2] : null;
+  const disclosures = parts.slice(1, parts.length - 1).filter(Boolean);
+
+  let evtJwt;
+  try {
+    evtJwt = parseJwt(evtPart);
+  } catch (err) {
+    return {
+      verified: false,
+      method: 'evp',
+      reason: `Malformed Email Verification Token JWT: ${err.message}`
+    };
+  }
+
+  const { header: evtHeader, payload: evtPayload } = evtJwt;
+
+  // Validate EVT header type if present (evt+jwt, ev+sd-jwt, sd+jwt, jwt)
+  if (evtHeader.typ) {
+    const validTypes = ['evt+jwt', 'ev+sd-jwt', 'sd+jwt', 'vc+sd-jwt', 'jwt'];
+    if (!validTypes.includes(String(evtHeader.typ).toLowerCase())) {
+      return {
+        verified: false,
+        method: 'evp',
+        reason: `Unexpected EVT header typ: ${evtHeader.typ}`
+      };
+    }
+  }
+
+  // Extract email from EVT payload or selective disclosures
+  let tokenEmail = evtPayload.email;
+  let emailVerifiedClaim = evtPayload.email_verified;
+
+  for (const disc of disclosures) {
+    try {
+      const decodedDisc = JSON.parse(base64UrlDecodeToBuffer(disc).toString('utf8'));
+      // Disclosure format: [salt, claim_name, claim_value]
+      if (Array.isArray(decodedDisc) && decodedDisc.length >= 3) {
+        if (decodedDisc[1] === 'email') tokenEmail = decodedDisc[2];
+        if (decodedDisc[1] === 'email_verified') emailVerifiedClaim = decodedDisc[2];
+      }
+    } catch (_) {
+      // Ignore non-JSON disclosure segment
+    }
+  }
+
+  if (emailVerifiedClaim === false) {
+    return {
+      verified: false,
+      method: 'evp',
+      reason: 'Token explicitly states email_verified is false.'
+    };
+  }
+
+  // Section 4: Email Consistency Check (case-insensitive comparison)
+  if (tokenEmail && submittedEmail) {
+    if (String(tokenEmail).trim().toLowerCase() !== String(submittedEmail).trim().toLowerCase()) {
+      return {
+        verified: false,
+        method: 'evp',
+        reason: 'Verified email in token does not match the submitted email address.'
+      };
+    }
+  }
+
+  const effectiveEmail = (tokenEmail || submittedEmail || '').trim();
+  if (!effectiveEmail || !effectiveEmail.includes('@')) {
+    return {
+      verified: false,
+      method: 'evp',
+      reason: 'Missing valid email address in token or form submission.'
+    };
+  }
+
+  // Check timestamps (exp / iat) if provided
+  const nowSec = Math.floor(Date.now() / 1000);
+  if (typeof evtPayload.exp === 'number' && evtPayload.exp < nowSec - 60) {
+    return {
+      verified: false,
+      method: 'evp',
+      reason: 'Email Verification Token has expired.'
+    };
+  }
+
+  // Validate Key Binding JWT (KB-JWT) if present
+  let kbVerified = false;
+  let kbPayload = null;
+  if (kbPart && kbPart.includes('.')) {
+    try {
+      const kbJwt = parseJwt(kbPart);
+      kbPayload = kbJwt.payload;
+
+      // Check nonce match
+      const requiredNonce = expectedNonce || kbPayload.nonce;
+      if (expectedNonce && kbPayload.nonce && kbPayload.nonce !== expectedNonce) {
+        return {
+          verified: false,
+          method: 'evp',
+          reason: 'Key Binding JWT nonce does not match expected session nonce.'
+        };
+      }
+      if (kbPayload.nonce && issuedNonces.has(kbPayload.nonce)) {
+        const entry = issuedNonces.get(kbPayload.nonce);
+        if (!entry.persistent) {
+          issuedNonces.delete(kbPayload.nonce);
+        }
+      }
+
+      // Check audience (aud) matches verifier origin if both exist
+      if (expectedOrigin && kbPayload.aud) {
+        const audOrigin = String(kbPayload.aud).replace(/\/$/, '');
+        const reqOrigin = String(expectedOrigin).replace(/\/$/, '');
+        if (audOrigin !== reqOrigin) {
+          return {
+            verified: false,
+            method: 'evp',
+            reason: `Key Binding JWT audience (${audOrigin}) does not match verifier origin (${reqOrigin}).`
+          };
+        }
+      }
+
+      // Check sd_hash integrity over "<EVT>~" (or "<EVT>~<Disclosures>~")
+      if (kbPayload.sd_hash) {
+        const sdPrefix = parts.slice(0, parts.length - 1).join('~') + '~';
+        const expectedSdHash = crypto.createHash('sha256').update(sdPrefix).digest('base64url');
+        const simpleSdHash = crypto.createHash('sha256').update(`${evtPart}~`).digest('base64url');
+        if (kbPayload.sd_hash !== expectedSdHash && kbPayload.sd_hash !== simpleSdHash) {
+          return {
+            verified: false,
+            method: 'evp',
+            reason: 'Key Binding JWT sd_hash does not match SHA-256 hash of EVT.'
+          };
+        }
+      }
+
+      // Verify KB-JWT cryptographic signature against cnf.jwk in EVT
+      if (evtPayload.cnf && evtPayload.cnf.jwk) {
+        const sigValid = verifyJwsSignature(kbJwt, evtPayload.cnf.jwk);
+        if (!sigValid) {
+          return {
+            verified: false,
+            method: 'evp',
+            reason: 'Key Binding JWT signature verification failed against EVT cnf.jwk.'
+          };
+        }
+        kbVerified = true;
+      } else {
+        kbVerified = true;
+      }
+    } catch (err) {
+      return {
+        verified: false,
+        method: 'evp',
+        reason: `Invalid Key Binding JWT: ${err.message}`
+      };
+    }
+  } else if (evtPayload.nonce && expectedNonce && evtPayload.nonce !== expectedNonce) {
+    return {
+      verified: false,
+      method: 'evp',
+      reason: 'Token nonce does not match expected session nonce.'
+    };
+  }
+
+  // Optional DNS & Issuer JWKS verification when issuer is reachable or embedded JWK is present
+  const emailDomain = effectiveEmail.split('@')[1];
+  const dnsIssuer = emailDomain ? await resolveIssuerFromDns(emailDomain) : null;
+  let issuerSignatureVerified = false;
+
+  if (evtHeader.jwk) {
+    try {
+      issuerSignatureVerified = verifyJwsSignature(evtJwt, evtHeader.jwk);
+      if (!issuerSignatureVerified) {
+        return {
+          verified: false,
+          method: 'evp',
+          reason: 'EVT issuer signature verification failed.'
+        };
+      }
+    } catch (err) {
+      return {
+        verified: false,
+        method: 'evp',
+        reason: `EVT signature verification error: ${err.message}`
+      };
+    }
+  } else if (evtPayload.iss) {
+    const jwks = await fetchIssuerJwks(dnsIssuer || evtPayload.iss);
+    if (jwks && Array.isArray(jwks.keys)) {
+      const matchingKey = jwks.keys.find(k => !evtHeader.kid || k.kid === evtHeader.kid) || jwks.keys[0];
+      if (matchingKey) {
+        try {
+          issuerSignatureVerified = verifyJwsSignature(evtJwt, matchingKey);
+          if (!issuerSignatureVerified) {
+            return {
+              verified: false,
+              method: 'evp',
+              reason: 'EVT signature did not match issuer JWKS key.'
+            };
+          }
+        } catch (err) {
+          return {
+            verified: false,
+            method: 'evp',
+            reason: `Issuer JWKS verification error: ${err.message}`
+          };
+        }
+      }
+    }
+  }
+
+  return {
+    verified: true,
+    method: 'evp',
+    email: effectiveEmail,
+    issuer: evtPayload.iss || dnsIssuer || `https://accounts.${emailDomain}`,
+    keyBindingVerified: kbVerified,
+    issuerSignatureVerified,
+    nonce: (kbPayload && kbPayload.nonce) || evtPayload.nonce || expectedNonce || DEFAULT_NONCE,
+    claims: {
+      iss: evtPayload.iss || `https://accounts.${emailDomain}`,
+      email: effectiveEmail,
+      email_verified: true,
+      iat: evtPayload.iat || nowSec
+    }
+  };
+}
+
+/**
+ * Generates a real, cryptographically signed SD-JWT+KB (EVT~KB-JWT) token
+ * for browsers/environments testing the Email Verification Protocol flow.
+ */
+function generateSignedEvtToken({ email, nonce, origin, issuer }) {
+  const emailDomain = (email && email.includes('@')) ? email.split('@')[1] : 'example.com';
+  const iss = issuer || `https://accounts.${emailDomain}`;
+  const nowSec = Math.floor(Date.now() / 1000);
+
+  // 1. Ephemeral browser key pair (Ed25519) for Key Binding
+  const browserKeys = crypto.generateKeyPairSync('ed25519');
+  const browserPublicJwk = browserKeys.publicKey.export({ format: 'jwk' });
+
+  // 2. Issuer key pair (Ed25519) for signing the EVT
+  const issuerKeys = crypto.generateKeyPairSync('ed25519');
+  const issuerPublicJwk = issuerKeys.publicKey.export({ format: 'jwk' });
+
+  const evtHeader = {
+    alg: 'EdDSA',
+    typ: 'evt+jwt',
+    kid: 'issuer-ed25519-2026',
+    jwk: issuerPublicJwk
+  };
+
+  const evtPayload = {
+    iss,
+    iat: nowSec,
+    exp: nowSec + 3600,
+    email,
+    email_verified: true,
+    cnf: {
+      jwk: browserPublicJwk
+    }
+  };
+
+  const encodeSegment = obj => Buffer.from(JSON.stringify(obj), 'utf8').toString('base64url');
+  const evtSigningInput = `${encodeSegment(evtHeader)}.${encodeSegment(evtPayload)}`;
+  const evtSignature = crypto.sign(null, Buffer.from(evtSigningInput, 'utf8'), issuerKeys.privateKey).toString('base64url');
+  const evtJwt = `${evtSigningInput}.${evtSignature}`;
+
+  // Calculate sd_hash over "<EVT>~"
+  const sdHash = crypto.createHash('sha256').update(`${evtJwt}~`).digest('base64url');
+
+  const kbHeader = {
+    alg: 'EdDSA',
+    typ: 'kb+jwt'
+  };
+
+  const kbPayload = {
+    aud: origin || `http://localhost:${PORT}`,
+    nonce: nonce || DEFAULT_NONCE,
+    iat: nowSec,
+    sd_hash: sdHash
+  };
+
+  const kbSigningInput = `${encodeSegment(kbHeader)}.${encodeSegment(kbPayload)}`;
+  const kbSignature = crypto.sign(null, Buffer.from(kbSigningInput, 'utf8'), browserKeys.privateKey).toString('base64url');
+  const kbJwt = `${kbSigningInput}.${kbSignature}`;
+
+  return `${evtJwt}~${kbJwt}`;
+}
+
+function readRequestBody(req) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    req.on('data', chunk => chunks.push(chunk));
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function parseBody(rawBody, contentType = '') {
+  if (!rawBody) return {};
+  if (contentType.includes('application/json')) {
+    try {
+      return JSON.parse(rawBody);
+    } catch (_) {
+      return {};
+    }
+  }
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const params = new URLSearchParams(rawBody);
+    const result = {};
+    for (const [k, v] of params.entries()) {
+      result[k] = v;
+    }
+    return result;
+  }
+  // Fallback: try JSON first, then URLSearchParams
+  try {
+    return JSON.parse(rawBody);
+  } catch (_) {
+    const params = new URLSearchParams(rawBody);
+    const result = {};
+    for (const [k, v] of params.entries()) {
+      result[k] = v;
+    }
+    return result;
+  }
+}
+
+function sendJson(res, statusCode, data) {
+  const payload = JSON.stringify(data, null, 2);
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store'
+  });
+  res.end(payload);
+}
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.mjs': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon'
+};
+
+async function handleSignupOrVerify(req, res, urlObj) {
+  const rawBody = await readRequestBody(req);
+  const contentType = req.headers['content-type'] || '';
+  const body = parseBody(rawBody, contentType);
+
+  const name = (body.name || body.fullName || body['full-name'] || 'Coffee Lover').trim();
+  const email = (body.email || body['email-address'] || '').trim();
+  const favoriteDrink = (body.favoriteDrink || body['favorite-drink'] || 'Maple Oat Latte').trim();
+  const birthdayMonth = (body.birthdayMonth || body['birthday-month'] || '').trim();
+  const token =
+    body.evt ||
+    body.token ||
+    body.email_verification_token ||
+    body['email-verification-token'] ||
+    body.presentationToken ||
+    '';
+  const expectedNonce = body.nonce || body.challenge || null;
+
+  const host = req.headers.host || `localhost:${PORT}`;
+  const proto = req.headers['x-forwarded-proto'] || 'http';
+  const origin = req.headers.origin || `${proto}://${host}`;
+
+  const verification = await verifyEmailVerificationToken(token, email, expectedNonce, null);
+
+  if (!email || !email.includes('@')) {
+    return sendJson(res, 400, {
+      ok: false,
+      verified: false,
+      error: 'Please provide a valid email address.'
+    });
+  }
+
+  // If this is strictly a token verification call and no valid token was provided, return verification status
+  if (urlObj.pathname.includes('verify') && !verification.verified) {
+    return sendJson(res, 400, {
+      ok: false,
+      verified: false,
+      email,
+      reason: verification.reason
+    });
+  }
+
+  const account = {
+    id: `dg-${crypto.randomBytes(4).toString('hex')}`,
+    name,
+    email: verification.email || email,
+    favoriteDrink,
+    birthdayMonth,
+    emailVerified: verification.verified,
+    verificationMethod: verification.verified ? 'Email Verification Protocol (EVP / SD-JWT+KB)' : 'unverified',
+    issuer: verification.issuer || null,
+    keyBindingVerified: Boolean(verification.keyBindingVerified),
+    welcomePoints: verification.verified ? 150 : 50,
+    tier: verification.verified ? 'Gold Bean Instant Member' : 'Pending Verification',
+    createdAt: new Date().toISOString()
+  };
+
+  registeredAccounts.push(account);
+
+  const acceptsHtml =
+    (req.headers.accept || '').includes('text/html') &&
+    !contentType.includes('application/json') &&
+    req.headers['x-requested-with'] !== 'XMLHttpRequest';
+
+  if (acceptsHtml) {
+    const badgeColor = account.emailVerified ? '#2e7d32' : '#ef6c00';
+    const statusText = account.emailVerified
+      ? 'Email Verified Instantly by Browser (No OTP or Magic Link Needed)'
+      : `Unverified (${verification.reason || 'Browser did not supply an EVT token'})`;
+
+    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+    res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Rewards Account Confirmed | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #fafafa; color: #3e2723; padding: 40px 20px; text-align: center; }
+    .card { max-width: 560px; margin: 0 auto; background: #fff; padding: 32px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
+    .badge { display: inline-block; background: ${badgeColor}; color: #fff; padding: 6px 14px; border-radius: 999px; font-size: 0.85rem; margin-bottom: 16px; }
+    .btn { display: inline-block; margin-top: 20px; background: #4e342e; color: #fff; padding: 10px 20px; border-radius: 6px; text-decoration: none; }
+  </style>
+</head>
+<body>
+  <div class="card">
+    <span class="badge">${statusText}</span>
+    <h1>Welcome to Daily Grind Rewards, ${account.name}!</h1>
+    <p>Account Email: <strong>${account.email}</strong></p>
+    <p>Rewards Balance: <strong>${account.welcomePoints} Beans</strong> (${account.tier})</p>
+    <a class="btn" href="/">Back to Homepage</a>
+  </div>
+</body>
+</html>`);
+    return;
+  }
+
+  return sendJson(res, 200, {
+    ok: true,
+    verified: verification.verified,
+    email_verified: verification.verified,
+    verification,
+    account,
+    message: verification.verified
+      ? `Email ${account.email} was cryptographically verified by the browser without an OTP or magic link.`
+      : `Account created, but browser email verification token was not validated: ${verification.reason}`
+  });
+}
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const urlObj = new URL(req.url, `http://${req.headers.host || `localhost:${PORT}`}`);
+    const pathname = urlObj.pathname;
+
+    // 1. Nonce generation endpoint for Email Verification Protocol forms
+    if (req.method === 'GET' && (pathname === '/api/rewards/nonce' || pathname === '/api/nonce')) {
+      const nonce = createNonce();
+      return sendJson(res, 200, { nonce });
+    }
+
+    // 2. Issuer Discovery /.well-known/email-verification metadata endpoint
+    if (req.method === 'GET' && pathname === '/.well-known/email-verification') {
+      const host = req.headers.host || `localhost:${PORT}`;
+      const proto = req.headers['x-forwarded-proto'] || 'http';
+      const baseUrl = `${proto}://${host}`;
+      return sendJson(res, 200, {
+        issuance_endpoint: `${baseUrl}/api/evp/issuance`,
+        jwks_uri: `${baseUrl}/.well-known/vc-public-jwks`,
+        signing_alg_values_supported: ['EdDSA', 'ES256']
+      });
+    }
+
+    // 3. Browser EVT simulation / issuance helper endpoint (generates a real signed SD-JWT+KB token)
+    if (req.method === 'POST' && (pathname === '/api/evp/issuance' || pathname === '/api/rewards/simulate-browser-evt')) {
+      const rawBody = await readRequestBody(req);
+      const body = parseBody(rawBody, req.headers['content-type'] || '');
+      const email = (body.email || 'alex.rivera@gmail.com').trim();
+      const nonce = (body.nonce || DEFAULT_NONCE).trim();
+      const host = req.headers.host || `localhost:${PORT}`;
+      const proto = req.headers['x-forwarded-proto'] || 'http';
+      const origin = body.origin || req.headers.origin || `${proto}://${host}`;
+
+      const issuanceToken = generateSignedEvtToken({ email, nonce, origin });
+      return sendJson(res, 200, {
+        ok: true,
+        issuance_token: issuanceToken,
+        evt: issuanceToken,
+        token: issuanceToken,
+        email,
+        nonce
+      });
+    }
+
+    // 4. Server verification & rewards registration endpoints
+    if (
+      req.method === 'POST' &&
+      [
+        '/api/rewards/signup',
+        '/api/rewards/register',
+        '/api/rewards/verify',
+        '/api/rewards/verify-email',
+        '/api/verify-email',
+        '/rewards/signup',
+        '/rewards/verify',
+        '/signup',
+        '/register'
+      ].includes(pathname)
+    ) {
+      return await handleSignupOrVerify(req, res, urlObj);
+    }
+
+    // 5. Static file serving
+    let safePath = path.normalize(decodeURIComponent(pathname)).replace(/^(\.\.[/\\])+/, '');
+    if (safePath === '/' || safePath === '\\') {
+      safePath = '/index.html';
+    }
+    const filePath = path.join(STATIC_DIR, safePath);
+
+    if (fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
+      const ext = path.extname(filePath).toLowerCase();
+      const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+      res.writeHead(200, { 'Content-Type': contentType });
+      fs.createReadStream(filePath).pipe(res);
+      return;
+    }
+
+    sendJson(res, 404, { error: 'Not Found', path: pathname });
+  } catch (err) {
+    sendJson(res, 500, { error: 'Internal Server Error', message: err.message });
+  }
+});
+
+if (require.main === module) {
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
+
+module.exports = {
+  server,
+  verifyEmailVerificationToken,
+  generateSignedEvtToken,
+  createNonce
+};
