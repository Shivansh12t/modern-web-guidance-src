+// Server-side session store mapping session ID -> expected single-use nonce
+const sessionNonceStore = new Map();
+const SESSION_COOKIE_NAME = 'dg_session_id';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// Allow 'EdDSA' while live issuers (e.g. Gmail) and Chrome Origin Trial builds finish transitioning.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const part of cookieHeader.split(';')) {
+    const [rawKey, ...rawVal] = part.trim().split('=');
+    if (rawKey) {
+      cookies[rawKey] = decodeURIComponent(rawVal.join('='));
+    }
+  }
+  return cookies;
+}
+
+function getOrCreateSession(req, res) {
+  const cookies = parseCookies(req.headers.cookie);
+  let sessionId = cookies[SESSION_COOKIE_NAME];
+  if (!sessionId || !/^[A-Za-z0-9_-]{20,}$/.test(sessionId)) {
+    sessionId = randomBytes(24).toString('base64url');
+  }
+  const nonce = randomBytes(32).toString('base64url');
+  sessionNonceStore.set(sessionId, {
+    nonce,
+    createdAt: Date.now(),
+  });
+
+  // Set HttpOnly, Secure, SameSite=Lax session ID cookie
+  res.setHeader(
+    'Set-Cookie',
+    `${SESSION_COOKIE_NAME}=${sessionId}; Path=/; HttpOnly; Secure; SameSite=Lax`
+  );
+  return { sessionId, nonce };
+}
+
+function consumeSessionNonce(req) {
+  const cookies = parseCookies(req.headers.cookie);
+  const sessionId = cookies[SESSION_COOKIE_NAME];
+  if (!sessionId) return null;
+  const entry = sessionNonceStore.get(sessionId);
+  // Atomically delete single-use nonce on receipt so it cannot be replayed
+  sessionNonceStore.delete(sessionId);
+  if (!entry) return null;
+  // Expire nonces older than 15 minutes
+  if (Date.now() - entry.createdAt > 15 * 60 * 1000) {
+    return null;
+  }
+  return entry.nonce;
+}
+
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+}) {
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email address domain.');
+  }
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) => r.join(''));
+  if (!txtRecords.some((txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss)) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+  const metadataResponse = await fetch(discoveryUrl);
+  if (!metadataResponse.ok) {
+    throw new Error(`Failed to fetch issuer metadata: ${metadataResponse.status}`);
+  }
+  const metadata = await metadataResponse.json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  const issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws JWKSMultipleMatchingKeys, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
+
+async function parseRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  const rawBody = Buffer.concat(chunks).toString('utf-8');
+  const contentType = req.headers['content-type'] || '';
+
+  if (contentType.includes('application/json')) {
+    try {
+      return JSON.parse(rawBody);
+    } catch {
+      return {};
+    }
+  }
+
+  // Handle application/x-www-form-urlencoded
+  const params = new URLSearchParams(rawBody);
+  return Object.fromEntries(params.entries());
+}
+
+function getExpectedOrigin(req) {
+  if (process.env.RP_ORIGIN) {
+    return process.env.RP_ORIGIN;
+  }
+  const proto = req.headers['x-forwarded-proto'] || 'http';
+  const host = req.headers['x-forwarded-host'] || req.headers.host || `localhost:${PORT}`;
+  return `${proto}://${host}`;
+}
+
+function completeAccountCreation(submittedEmail, fullName) {
+  return {
+    ok: true,
+    verified: true,
+    verificationMethod: 'evp-fast-path',
+    email: submittedEmail,
+    name: fullName,
+    message: `Welcome to Daily Grind Rewards! Your email (${submittedEmail}) was verified instantly without needing a passcode email.`,
+  };
+}
+
+function sendTraditionalVerificationEmail(submittedEmail, fullName) {
+  return {
+    ok: true,
+    verified: false,
+    verificationMethod: 'email-fallback',
+    email: submittedEmail,
+    name: fullName,
+    message: `Almost there! We've sent a confirmation email to ${submittedEmail} to finish activating your Daily Grind Rewards account.`,
+  };
+}
+
+async function handleSignupSubmission(req, res) {
+  const body = await parseRequestBody(req);
+  const submittedEmail = String(body.email || '').trim();
+  const fullName = String(body.name || body['full-name'] || '').trim();
+  const rawToken = String(body.token || '').trim();
+
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = consumeSessionNonce(req);
+  const expectedAudience = getExpectedOrigin(req);
+
+  // Issue a fresh nonce in case the client submits another form without reloading
+  const { nonce: nextNonce } = getOrCreateSession(req, res);
+
+  if (!submittedEmail || !submittedEmail.includes('@')) {
+    res.writeHead(400, {
+      'Content-Type': 'application/json; charset=utf-8',
+      'Cache-Control': 'no-store',
+    });
+    res.end(
+      JSON.stringify({
+        ok: false,
+        error: 'Please enter a valid email address in the format you@example.com.',
+        nextNonce,
+      })
+    );
+    return;
+  }
+
+  let result;
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      result = completeAccountCreation(submittedEmail, fullName);
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+      result = sendTraditionalVerificationEmail(submittedEmail, fullName);
+    }
+  } else {
+    // Fallback path: send standard OTP code or magic link email to submittedEmail.
+    result = sendTraditionalVerificationEmail(submittedEmail, fullName);
+  }
+
+  const acceptHeader = req.headers.accept || '';
+  if (acceptHeader.includes('application/json')) {
+    res.writeHead(200, {
+      'Content-Type': 'application/json; charset=utf-8',
+      'Cache-Control': 'no-store',
+    });
+    res.end(JSON.stringify({ ...result, nextNonce }));
+    return;
+  }
+
+  // HTML response fallback when submitted without AJAX
+  res.writeHead(200, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+  res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Rewards Registration | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #fafafa; color: #3e2723; padding: 3rem 1.5rem; text-align: center; }
+    .status-box { max-width: 520px; margin: 0 auto; background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
+    a { display: inline-block; margin-top: 1.25rem; color: #fff; background: #4e342e; padding: 0.75rem 1.5rem; text-decoration: none; border-radius: 5px; }
+  </style>
+</head>
+<body>
+  <main class="status-box">
+    <h1>${result.verified ? 'Rewards Account Activated' : 'Check Your Email'}</h1>
+    <p>${result.message}</p>
+    <a href="/">Return to Homepage</a>
+  </main>
+</body>
+</html>`);
+}
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+};
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+
+    if (req.method === 'POST' && (url.pathname === '/api/verify-email' || url.pathname === '/api/rewards/signup')) {
+      await handleSignupSubmission(req, res);
+      return;
+    }
+
+    if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+      const { nonce } = getOrCreateSession(req, res);
+      const htmlPath = path.join(__dirname, 'index.html');
+      let html = await fs.readFile(htmlPath, 'utf-8');
+      html = html
+        .replaceAll('SERVER_GENERATED_PER_FORM_NONCE', nonce)
+        .replaceAll('__ORIGIN_TRIAL_TOKEN__', ORIGIN_TRIAL_TOKEN);
+
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Origin-Trial': ORIGIN_TRIAL_TOKEN,
