+      content: "";
+      display: block;
+      position: sticky;
+      block-size: 1rem;
+      z-index: 1;
+      pointer-events: none;
+      opacity: 0;
+      transition: opacity 0.2s;
+    }
+
+    .reviews-scroller::before {
+      inset-block-start: -16px;
+      margin-block-end: calc(-1rem - 16px);
+      margin-inline: -16px;
+      background: radial-gradient(farthest-side at 50% 0, rgb(0 0 0 / 0.15), transparent);
+    }
+
+    .reviews-scroller::after {
+      inset-block-end: -16px;
+      margin-block-start: calc(-1rem - 16px);
+      margin-inline: -16px;
+      background: radial-gradient(farthest-side at 50% 100%, rgb(0 0 0 / 0.15), transparent);
+    }
+
+    @container scroll-state(scrollable: block-start) {
+      .reviews-scroller::before {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: block-end) {
+      .reviews-scroller::after {
+        opacity: 1;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .reviews-scroller::before,
+      .reviews-scroller::after {
+        animation: show-shadow linear both;
+        animation-timeline: scroll();
+      }
+
+      .reviews-scroller::before {
+        animation-range: 0 2rem;
+      }
+
+      .reviews-scroller::after {
+        animation-direction: reverse;
+        animation-range: calc(100% - 2rem) 100%;
+      }
+    }
+
+    @keyframes show-shadow {
+      to {
+        opacity: 1;
+      }
+    }
+
+    .reviews-scroller.more-start::before,
+    .reviews-scroller.more-end::after {
