+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-scroll-container');
+      const topHint = document.getElementById('scroll-hint-top');
+      const bottomHint = document.getElementById('scroll-hint-bottom');
+
+      if (!scrollContainer || !topHint || !bottomHint) return;
+
+      function updateScrollHints() {
+        const scrollTop = scrollContainer.scrollTop;
+        const scrollHeight = scrollContainer.scrollHeight;
+        const clientHeight = scrollContainer.clientHeight;
+
+        const canScrollUp = scrollTop > 0;
+        const canScrollDown = Math.ceil(scrollTop + clientHeight) < scrollHeight - 1;
+
+        topHint.classList.toggle('visible', canScrollUp);
+        topHint.setAttribute('aria-hidden', String(!canScrollUp));
+
+        bottomHint.classList.toggle('visible', canScrollDown);
+        bottomHint.setAttribute('aria-hidden', String(!canScrollDown));
+      }
+
+      scrollContainer.addEventListener('scroll', updateScrollHints, { passive: true });
+      window.addEventListener('resize', updateScrollHints);
+      window.addEventListener('load', updateScrollHints);
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(updateScrollHints);
+        ro.observe(scrollContainer);
+      }
+
+      updateScrollHints();
+
+      scrollContainer.addEventListener('click', function (e) {
+        const btn = e.target.closest('.helpful-btn');
+        if (!btn) return;
+        const isActive = btn.classList.toggle('active');
+        const baseCount = parseInt(btn.getAttribute('data-count') || '0', 10);
+        const nextCount = isActive ? baseCount + 1 : baseCount;
+        btn.textContent = 'Helpful (' + nextCount + ')';
+      });
+    })();
+  </script>
