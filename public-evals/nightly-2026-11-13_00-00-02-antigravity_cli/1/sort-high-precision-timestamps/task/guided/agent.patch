+  <script type="module">
+    // Out-of-order coffee order events recorded by distributed backend services
+    // with nanosecond-precision ISO 8601 UTC timestamps.
+    // Several events occur within the same millisecond (08:14:22.418s) and would
+    // collide if parsed with legacy `new Date()` or `Date.parse()`.
+    const rawCoffeeOrderEvents = [
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'barista-queue-us-east-2',
+        eventType: 'barista.ticket.dispatched',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:22.418912405Z',
+      },
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'payment-ledger-us-east-1',
+        eventType: 'payment.authorized',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:22.418204890Z',
+      },
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'edge-gateway-us-east-1',
+        eventType: 'order.received',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:22.418003120Z',
+      },
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'roastery-telemetry-01',
+        eventType: 'espresso.extraction.started',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:23.105440918Z',
+      },
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'inventory-svc-us-east-1',
+        eventType: 'beans.batch.reserved',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:22.418089744Z',
+      },
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'loyalty-engine-us-west-2',
+        eventType: 'rewards.points.accrued',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:22.418209346Z',
+      },
+      {
+        orderId: 'ORD-9042',
+        nodeId: 'pickup-notifier-edge-04',
+        eventType: 'order.ready.notification',
+        item: 'Maple Oat Latte (12oz)',
+        ts: '2026-11-13T08:14:48.902114502Z',
+      },
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    function parseAndSortOrderEvents(rawEvents) {
+      // 1. Parse recorded timestamps as Temporal.Instant to preserve full nanosecond precision.
+      const parsed = rawEvents.map((evt, batchIndex) => ({
+        ...evt,
+        batchIndex: batchIndex + 1,
+        timestamp: Temporal.Instant.from(evt.ts),
+      }));
+
+      // 2. Sort chronologically using Temporal.Instant.compare(a, b)
+      return [...parsed].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    function measureConsecutiveIntervals(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            interval: null,
+            formattedInterval: 'Initial event (0ns)',
+            isoInterval: 'PT0S',
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+        // 3. Calculate exact sub-millisecond Temporal.Duration interval since the previous event
+        const gap = curr.timestamp.since(prev.timestamp);
+
+        // 4. Display intervals with duration.toLocaleString() (delegates to Intl.DurationFormat)
+        const formattedInterval = isSimultaneous
+          ? '0ns (simultaneous)'
+          : `+${gap.toLocaleString('en-US', { style: 'narrow' })}`;
+
+        return {
+          ...curr,
+          interval: gap,
+          formattedInterval,
+          isoInterval: gap.toString(),
+        };
+      });
+    }
+
+    function renderEventTrace(analyzedEvents) {
+      const summaryEl = document.getElementById('order-events-summary');
+      const tableEl = document.getElementById('order-events-table');
+      const tbodyEl = document.getElementById('order-events-tbody');
+
+      tbodyEl.replaceChildren();
+
+      for (const [idx, evt] of analyzedEvents.entries()) {
+        const tr = document.createElement('tr');
+
+        const seqTd = document.createElement('td');
+        seqTd.textContent = `${idx + 1} (raw #${evt.batchIndex})`;
+
+        const nodeTd = document.createElement('td');
+        const nodeBadge = document.createElement('span');
+        nodeBadge.className = 'badge mono';
+        nodeBadge.textContent = evt.nodeId;
+        nodeTd.appendChild(nodeBadge);
+
+        const typeTd = document.createElement('td');
+        typeTd.className = 'mono';
+        typeTd.textContent = evt.eventType;
+
+        const itemTd = document.createElement('td');
+        itemTd.textContent = `${evt.orderId} · ${evt.item}`;
+
+        const tsTd = document.createElement('td');
+        const tsTime = document.createElement('time');
+        tsTime.className = 'mono';
+        const isoUtc = evt.timestamp.toString();
+        tsTime.setAttribute('datetime', isoUtc);
+        tsTime.textContent = isoUtc;
+        tsTd.appendChild(tsTime);
+
+        const gapTd = document.createElement('td');
+        const gapSpan = document.createElement('time');
+        gapSpan.className = 'interval-pill mono';
+        gapSpan.setAttribute('datetime', evt.isoInterval);
+        gapSpan.textContent = evt.formattedInterval;
+        gapTd.appendChild(gapSpan);
+
+        tr.append(seqTd, nodeTd, typeTd, itemTd, tsTd, gapTd);
+        tbodyEl.appendChild(tr);
+      }
+
+      if (analyzedEvents.length >= 2) {
+        const first = analyzedEvents[0].timestamp;
+        const last = analyzedEvents[analyzedEvents.length - 1].timestamp;
+        const totalSpan = last.since(first);
+
+        summaryEl.textContent =
+          `Sorted ${analyzedEvents.length} distributed events chronologically · ` +
+          `Total end-to-end order span: ${totalSpan.toLocaleString('en-US', { style: 'narrow' })} ` +
+          `(${first.toString()} → ${last.toString()})`;
+        summaryEl.hidden = false;
+      }
+
+      tableEl.hidden = false;
+    }
+
+    const loadBtn = document.getElementById('load-order-events-btn');
+    loadBtn.addEventListener('click', async () => {
+      loadBtn.disabled = true;
+      loadBtn.textContent = 'Sorting Nanosecond Events...';
+      try {
+        await ensureTemporal();
+        const sorted = parseAndSortOrderEvents(rawCoffeeOrderEvents);
+        const analyzed = measureConsecutiveIntervals(sorted);
+        renderEventTrace(analyzed);
+        loadBtn.textContent = 'Reload Order Event Batch';
+      } finally {
+        loadBtn.disabled = false;
+      }
+    });
+  </script>
