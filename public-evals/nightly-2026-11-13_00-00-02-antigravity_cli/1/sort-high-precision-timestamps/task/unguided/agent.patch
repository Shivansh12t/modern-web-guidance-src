+
+    function processAndRenderOrderEvents() {
+      // 1. Decorate each raw event with its ingestion index and exact BigInt nanosecond epoch
+      const annotatedEvents = DISTRIBUTED_ORDER_EVENTS_BATCH.map((evt, idx) => ({
+        ...evt,
+        ingestionOrder: idx + 1,
+        epochNs: parseIsoNanosecondsToBigInt(evt.timestampUtc)
+      }));
+
+      // 2. Render raw out-of-order ingestion table
+      const rawTbody = document.getElementById('raw-events-tbody');
+      rawTbody.innerHTML = annotatedEvents.map(evt => `
+        <tr>
+          <td>#${evt.ingestionOrder}</td>
+          <td class="mono">${evt.eventId}</td>
+          <td><span class="badge">${evt.service}</span></td>
+          <td class="mono">${evt.eventType}</td>
+          <td>${evt.orderId} &mdash; ${evt.item}</td>
+          <td>${formatTimestampHtml(evt.timestampUtc)}</td>
+        </tr>
+      `).join('');
+
+      // 3. Sort chronologically using exact BigInt comparison (preserving nanosecond precision)
+      const sortedEvents = [...annotatedEvents].sort((a, b) => {
+        if (a.epochNs < b.epochNs) return -1;
+        if (a.epochNs > b.epochNs) return 1;
+        return 0;
+      });
+
+      // 4. Measure intervals between consecutive sorted events
+      const intervalsNs = [];
+      const sortedWithIntervals = sortedEvents.map((evt, idx) => {
+        if (idx === 0) {
+          return { ...evt, deltaNs: null, formattedInterval: null };
+        }
+        const deltaNs = evt.epochNs - sortedEvents[idx - 1].epochNs;
+        intervalsNs.push(deltaNs);
+        return {
+          ...evt,
+          deltaNs,
+          formattedInterval: formatNanosecondInterval(deltaNs)
+        };
+      });
+
+      // 5. Render sorted events and intervals table
+      const sortedTbody = document.getElementById('sorted-events-tbody');
+      sortedTbody.innerHTML = sortedWithIntervals.map((evt, idx) => {
+        const intervalCell = evt.formattedInterval
+          ? `<div class="mono"><strong>${evt.formattedInterval.exactMs}</strong></div>
+             <div class="mono" style="font-size: 0.8rem; color: #5d4037;">${evt.formattedInterval.rawNs} (${evt.formattedInterval.breakdown})</div>`
+          : `<span class="badge">0 ns (Initial Event)</span>`;
+
+        return `
+          <tr data-event-id="${evt.eventId}" data-epoch-ns="${evt.epochNs.toString()}" data-delta-ns="${evt.deltaNs !== null ? evt.deltaNs.toString() : '0'}">
+            <td><strong>${idx + 1}</strong></td>
+            <td>#${evt.ingestionOrder}</td>
+            <td class="mono">${evt.eventId}</td>
+            <td><span class="badge">${evt.service}</span></td>
+            <td class="mono">${evt.eventType}</td>
+            <td>${formatTimestampHtml(evt.timestampUtc)}</td>
+            <td class="mono">${evt.epochNs.toString()}</td>
+            <td>${intervalCell}</td>
+          </tr>
+        `;
+      }).join('');
+
+      // 6. Compute summary metrics (total span, min interval, max interval, sub-ms collisions resolved)
+      const totalSpanNs = sortedEvents[sortedEvents.length - 1].epochNs - sortedEvents[0].epochNs;
+      const minDeltaNs = intervalsNs.reduce((min, val) => (val < min ? val : min), intervalsNs[0]);
+      const maxDeltaNs = intervalsNs.reduce((max, val) => (val > max ? val : max), intervalsNs[0]);
+      const subMsIntervalsCount = intervalsNs.filter(d => d < 1_000_000n).length;
+
+      const totalFormatted = formatNanosecondInterval(totalSpanNs);
+      const minFormatted = formatNanosecondInterval(minDeltaNs);
+      const maxFormatted = formatNanosecondInterval(maxDeltaNs);
+
+      const statsContainer = document.getElementById('telemetry-stats');
+      statsContainer.innerHTML = `
+        <div class="stat-box">
+          <div class="stat-label">Events Processed</div>
+          <div class="stat-value">${sortedEvents.length} Distributed Events</div>
+        </div>
+        <div class="stat-box">
+          <div class="stat-label">Total End-to-End Span</div>
+          <div class="stat-value mono">${totalFormatted.exactMs}</div>
+          <div class="mono" style="font-size: 0.78rem;">${totalFormatted.rawNs}</div>
+        </div>
+        <div class="stat-box">
+          <div class="stat-label">Shortest Consecutive Interval</div>
+          <div class="stat-value mono">${minFormatted.breakdown}</div>
+          <div class="mono" style="font-size: 0.78rem;">${minFormatted.rawNs} (${minFormatted.exactMs})</div>
+        </div>
+        <div class="stat-box">
+          <div class="stat-label">Sub-Millisecond Intervals (&lt;1ms)</div>
+          <div class="stat-value">${subMsIntervalsCount} of ${intervalsNs.length} intervals</div>
+          <div style="font-size: 0.78rem;">Preserved via BigInt ns sorting</div>
+        </div>
+      `;
+
+      document.getElementById('telemetry-output').style.display = 'block';
+    }
+
+    document.getElementById('load-events-btn').addEventListener('click', processAndRenderOrderEvents);
+  </script>
