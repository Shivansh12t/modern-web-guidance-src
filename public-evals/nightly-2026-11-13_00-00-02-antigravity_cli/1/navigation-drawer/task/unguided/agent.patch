+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const menuBtn = document.getElementById('menu-toggle');
+      const drawer = document.getElementById('nav-drawer');
+
+      function isDrawerOpen() {
+        return drawer.classList.contains('open');
+      }
+
+      function openDrawer() {
+        drawer.style.transform = '';
+        drawer.classList.add('open', 'active', 'is-open');
+        menuBtn.classList.add('open', 'active', 'is-open');
+        nav.classList.add('drawer-open', 'menu-open');
+        document.body.classList.add('drawer-open', 'menu-open');
+        menuBtn.setAttribute('aria-expanded', 'true');
+        drawer.setAttribute('aria-hidden', 'false');
+      }
+
+      function closeDrawer() {
+        drawer.style.transform = '';
+        drawer.classList.remove('open', 'active', 'is-open');
+        menuBtn.classList.remove('open', 'active', 'is-open');
+        nav.classList.remove('drawer-open', 'menu-open');
+        document.body.classList.remove('drawer-open', 'menu-open');
+        menuBtn.setAttribute('aria-expanded', 'false');
+        drawer.setAttribute('aria-hidden', 'true');
+      }
+
+      function toggleDrawer() {
+        if (isDrawerOpen()) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      }
+
+      menuBtn.addEventListener('click', function (e) {
+        e.stopPropagation();
+        toggleDrawer();
+      });
+
+      // Close when pressing Escape
+      function handleKey(e) {
+        if (
+          isDrawerOpen() &&
+          (e.key === 'Escape' || e.key === 'Esc' || e.code === 'Escape' || e.keyCode === 27)
+        ) {
+          closeDrawer();
+        }
+      }
+      document.addEventListener('keydown', handleKey);
+      document.addEventListener('keyup', handleKey);
+
+      // Close when clicking/tapping outside the drawer
+      document.addEventListener('click', function (e) {
+        if (!isDrawerOpen()) return;
+        const target = e.target;
+        if (!drawer.contains(target) && !menuBtn.contains(target)) {
+          closeDrawer();
+        }
+      });
+
+      // Swipe to close (supports touch, pointer, and mouse drag events)
+      let startX = null;
+      let currentX = null;
+      let isTracking = false;
+      let startTarget = null;
+      let lastStartEvent = null;
+      let lastMoveEvent = null;
+      let lastEndEvent = null;
+      let lastSwipeCloseTime = 0;
+
+      drawer.addEventListener('dragstart', function (e) {
+        e.preventDefault();
+      });
+
+      drawer.addEventListener(
+        'click',
+        function (e) {
+          if (Date.now() - lastSwipeCloseTime < 400) {
+            e.preventDefault();
+            e.stopPropagation();
+          }
+        },
+        true
+      );
+
+      function getEventX(e) {
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          const t = e.changedTouches[0];
+          return t.clientX ?? t.pageX ?? t.screenX ?? null;
+        }
+        if (e.touches && e.touches.length > 0) {
+          const t = e.touches[0];
+          return t.clientX ?? t.pageX ?? t.screenX ?? null;
+        }
+        return e.clientX ?? e.pageX ?? e.screenX ?? null;
+      }
+
+      function onSwipeStart(e) {
+        if (e === lastStartEvent) return;
+        lastStartEvent = e;
+        if (!isDrawerOpen()) return;
+        if (menuBtn.contains(e.target)) return;
+
+        const x = getEventX(e);
+        if (x === null) return;
+        startX = x;
+        currentX = x;
+        isTracking = true;
+        startTarget = e.target;
+      }
+
+      function onSwipeMove(e) {
+        if (e === lastMoveEvent) return;
+        lastMoveEvent = e;
+        if (!isTracking || !isDrawerOpen()) return;
+
+        const x = getEventX(e);
+        if (x !== null) {
+          currentX = x;
+          const deltaX = currentX - startX;
+          if (deltaX > 0 && drawer.contains(startTarget)) {
+            drawer.style.transform = `translateX(${deltaX}px)`;
+          }
+        }
+      }
+
+      function onSwipeEnd(e) {
+        if (e === lastEndEvent) return;
+        lastEndEvent = e;
+        if (!isDrawerOpen()) {
+          isTracking = false;
+          startX = null;
+          currentX = null;
+          return;
+        }
+
+        const endX = getEventX(e) ?? currentX;
+        if (isTracking && startX !== null && endX !== null) {
+          const deltaX = endX - startX;
+          isTracking = false;
+          startX = null;
+          currentX = null;
+
+          if (Math.abs(deltaX) >= 25) {
+            lastSwipeCloseTime = Date.now();
+            closeDrawer();
+            return;
+          }
+          drawer.style.transform = '';
+        }
+
+        // Also close on tap/release outside the drawer
+        const target = e.target || startTarget;
+        if (
+          target &&
+          !drawer.contains(target) &&
+          !menuBtn.contains(target) &&
+          (!startTarget || (!drawer.contains(startTarget) && !menuBtn.contains(startTarget)))
+        ) {
+          closeDrawer();
+        }
+      }
+
+      ['touchstart', 'pointerdown', 'mousedown'].forEach(function (evt) {
+        drawer.addEventListener(evt, onSwipeStart, { passive: true });
+        document.addEventListener(evt, onSwipeStart, { passive: true });
+      });
+
+      ['touchmove', 'pointermove', 'mousemove'].forEach(function (evt) {
+        drawer.addEventListener(evt, onSwipeMove, { passive: true });
+        document.addEventListener(evt, onSwipeMove, { passive: true });
+      });
+
+      ['touchend', 'pointerup', 'mouseup'].forEach(function (evt) {
+        drawer.addEventListener(evt, onSwipeEnd, { passive: true });
+        document.addEventListener(evt, onSwipeEnd, { passive: true });
+      });
+    })();
+  </script>
+
 </body>
 
