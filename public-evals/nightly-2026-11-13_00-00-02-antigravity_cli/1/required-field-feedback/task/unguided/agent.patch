+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-list-email');
+      const errorMsg = document.getElementById('mailing-list-error');
+      const successMsg = document.getElementById('mailing-list-success');
+
+      if (!form || !emailInput || !errorMsg) return;
+
+      let hasInteracted = false;
+      let hasTyped = false;
+
+      function getValidationError() {
+        const value = emailInput.value.trim();
+        if (value === '' || emailInput.validity.valueMissing) {
+          return 'Email address is required. Please enter your email.';
+        }
+        if (emailInput.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function showError(message) {
+        emailInput.classList.add('is-invalid', 'error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMsg.textContent = message;
+        errorMsg.hidden = false;
+        errorMsg.classList.add('visible');
+        if (successMsg) {
+          successMsg.hidden = true;
+          successMsg.classList.remove('visible');
+        }
+      }
+
+      function clearError() {
+        emailInput.classList.remove('is-invalid', 'error');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorMsg.hidden = true;
+        errorMsg.classList.remove('visible');
+      }
+
+      function validateField() {
+        const errorText = getValidationError();
+        if (errorText) {
+          showError(errorText);
+          return false;
+        }
+        clearError();
+        return true;
+      }
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        validateField();
+      });
+
+      emailInput.addEventListener('input', function () {
+        if (successMsg) {
+          successMsg.hidden = true;
+          successMsg.classList.remove('visible');
+        }
+        if (emailInput.value.trim() !== '') {
+          hasTyped = true;
+        }
+        const errorText = getValidationError();
+        if (!errorText) {
+          clearError();
+        } else if (hasInteracted || (hasTyped && emailInput.value.trim() === '')) {
+          showError(errorText);
+        }
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        validateField();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        if (validateField()) {
+          emailInput.value = '';
+          hasInteracted = false;
+          hasTyped = false;
+          clearError();
+          if (successMsg) {
+            successMsg.hidden = false;
+            successMsg.classList.add('visible');
+          }
+        } else {
+          emailInput.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
