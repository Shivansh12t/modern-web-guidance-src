+        } else {
+          link.dataset.linkSite = 'external';
+          link.setAttribute('rel', 'noopener noreferrer');
+          link.setAttribute('target', '_blank');
+        }
+      });
+    }
+
+    // Validate post-login or returnTo redirect parameter using schemeful same-site comparison
