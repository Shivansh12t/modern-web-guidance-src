+  <script>
+    // Trusted ordering origin and primary site configuration
+    const TRUSTED_ORDERING_URL = 'https://order.dailygrind.com';
+    const TRUSTED_SITE_URL = 'https://www.dailygrind.com';
+    const TRUSTED_SITE_DOMAIN = 'dailygrind.com';
+
+    const TRUSTED_ORDERING_ORIGIN =
+      'Origin' in globalThis ? Origin.from(TRUSTED_ORDERING_URL) : null;
+
+    function getAppOrigin() {
+      if ('Origin' in globalThis) {
+        try {
+          const selfOrigin = Origin.from(self);
+          if (!selfOrigin.opaque) {
+            return selfOrigin;
+          }
+        } catch {
+          // Fall back to configured site origin if self cannot provide a tuple origin
+        }
+        return Origin.from(TRUSTED_SITE_URL);
+      }
+      return globalThis.location?.origin && globalThis.location.origin !== 'null'
+        ? globalThis.location.href
+        : TRUSTED_SITE_URL;
+    }
+
+    const APP_ORIGIN = getAppOrigin();
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        // Synthetic new MessageEvent('message', { origin }) objects in tests lack an
+        // internal browser origin; fall back to parsing candidate.origin if it is a URL.
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    // 1. Verify exact origins for privileged cross-window ordering messages
+    function isTrustedSameOrigin(candidate, trustedReference = TRUSTED_ORDERING_ORIGIN ?? TRUSTED_ORDERING_URL) {
+      try {
+        if ('Origin' in globalThis) {
+          const candidateOrigin = extractOrigin(candidate);
+          const trustedOrigin =
+            trustedReference instanceof Origin ? trustedReference : extractOrigin(trustedReference);
+          if (candidateOrigin.opaque || trustedOrigin.opaque) {
+            return false;
+          }
+          return candidateOrigin.isSameOrigin(trustedOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(extractUrlString(trustedReference));
+        return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedUrl.origin;
+      } catch {
+        // Rejects invalid URLs, "null" strings, or unsupported objects
+        return false;
+      }
+    }
+
+    // 2. Validate schemeful same-site redirect URLs and classify links without string splitting
+    function isAllowedSameSiteUrl(candidateUrlOrElement, siteReference = APP_ORIGIN) {
+      try {
+        if ('Origin' in globalThis) {
+          const candidateOrigin = extractOrigin(candidateUrlOrElement);
+          const targetSiteOrigin =
+            siteReference instanceof Origin ? siteReference : extractOrigin(siteReference);
+          if (candidateOrigin.opaque || targetSiteOrigin.opaque) {
+            return false;
+          }
+          return candidateOrigin.isSameSite(targetSiteOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidateUrlOrElement));
+        const trustedUrl = new URL(extractUrlString(siteReference));
+        const registrableDomain =
+          trustedUrl.hostname === TRUSTED_SITE_DOMAIN ||
+          trustedUrl.hostname.endsWith(`.${TRUSTED_SITE_DOMAIN}`)
+            ? TRUSTED_SITE_DOMAIN
+            : trustedUrl.hostname;
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.protocol === trustedUrl.protocol &&
+          (candidateUrl.hostname === registrableDomain ||
+            candidateUrl.hostname.endsWith(`.${registrableDomain}`))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    // 3. Pin the opaque origin of a sandboxed iframe widget on initialization
+    let pinnedSandboxOrigin = 'Origin' in globalThis ? new Origin() : null;
+    let isSandboxPinned = false;
+
+    function resetSandboxPin() {
+      pinnedSandboxOrigin = 'Origin' in globalThis ? new Origin() : null;
+      isSandboxPinned = false;
+    }
+
+    function handleSandboxedWidgetMessage(event, expectedWidgetWindow) {
+      try {
+        if ('Origin' in globalThis) {
+          const senderOrigin = Origin.from(event);
+
+          if (!senderOrigin.opaque) {
+            return false;
+          }
+
+          // Pin the opaque origin only once on initialization from the expected sandboxed iframe
+          if (!isSandboxPinned && event.source === expectedWidgetWindow && event.data?.type === 'init') {
+            pinnedSandboxOrigin = senderOrigin;
+            isSandboxPinned = true;
+          }
+
+          // Subsequent messages from the SAME sandboxed iframe match pinnedSandboxOrigin;
+          // messages from any other sandboxed iframe (also event.origin === "null") return false.
+          return senderOrigin.isSameOrigin(pinnedSandboxOrigin);
+        }
+
+        // Fallback when the Origin API is unavailable: verify expected sandboxed Window source
+        if (event?.origin !== 'null' || !expectedWidgetWindow) {
+          return false;
+        }
+        if (!isSandboxPinned && event.source === expectedWidgetWindow && event.data?.type === 'init') {
+          pinnedSandboxOrigin = expectedWidgetWindow;
+          isSandboxPinned = true;
+        }
+        return isSandboxPinned && event.source === pinnedSandboxOrigin;
+      } catch {
+        return false;
+      }
+    }
+
+    // Classify page links as same-site or external using Origin.from(anchorElement) & isSameSite()
+    function classifyPageLinks(root = document, siteReference = APP_ORIGIN) {
+      const links = root.querySelectorAll('a[href], area[href]');
+      links.forEach((link) => {
