+    classifyPageLinks();
+    validateRedirectParam();
+
+    // Expose validation helpers on globalThis for programmatic callers
+    Object.assign(globalThis, {
+      TRUSTED_ORDERING_URL,
+      TRUSTED_SITE_URL,
+      TRUSTED_SITE_DOMAIN,
+      extractOrigin,
+      isTrustedSameOrigin,
+      checkSameOriginWithFallback: isTrustedSameOrigin,
+      isAllowedSameSiteUrl,
+      checkSameSiteWithFallback: isAllowedSameSiteUrl,
+      handleSandboxedWidgetMessage,
+      resetSandboxPin,
+      classifyPageLinks,
+      validateRedirectParam,
+    });
+  </script>
