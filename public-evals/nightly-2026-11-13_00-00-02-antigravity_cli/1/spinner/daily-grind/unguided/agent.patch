+  <script>
+    (function () {
+      const announcer = document.getElementById('loading-announcer');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const orderBtn = document.getElementById('order-now-btn');
+
+      const drinkDetailsData = {
+        'maple-oat-latte': '12oz / 16oz • 180 kcal • Espresso, steamed oat milk, pure Grade A Vermont maple syrup, and a dash of cinnamon.',
+        'dark-roast-espresso': 'Double shot (2oz) • 10 kcal • 100% single-origin Sumatra dark roast beans with rich cocoa and cedar notes.',
+        'cold-brew': '16oz / 20oz • 5 kcal • Coarse-ground Colombian blend steeped cold for 18 hours and triple-filtered.'
+      };
+
+      function announce(message) {
+        if (announcer) {
+          announcer.textContent = message;
+        }
+      }
+
+      function setButtonLoading(btn, isLoading, loadingText, defaultText, container) {
+        const textEl = btn.querySelector('.btn-text');
+        if (isLoading) {
+          btn.classList.add('is-loading');
+          btn.setAttribute('aria-busy', 'true');
+          btn.setAttribute('aria-disabled', 'true');
+          if (container) container.setAttribute('aria-busy', 'true');
+          if (textEl && loadingText) textEl.textContent = loadingText;
+        } else {
+          btn.classList.remove('is-loading');
+          btn.setAttribute('aria-busy', 'false');
+          btn.removeAttribute('aria-disabled');
+          if (container) container.setAttribute('aria-busy', 'false');
+          if (textEl && defaultText) textEl.textContent = defaultText;
+        }
+      }
+
+      if (orderBtn) {
+        orderBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          if (orderBtn.getAttribute('aria-busy') === 'true') return;
+
+          setButtonLoading(orderBtn, true, 'Starting Order...', 'Order Now');
+          announce('Starting your order, please wait...');
+
+          const targetHref = orderBtn.getAttribute('href');
+          setTimeout(function () {
+            announce('Order session ready.');
+            if (targetHref && targetHref !== '#') {
+              window.location.href = targetHref;
+            }
+          }, 1200);
+        });
+      }
+
+      const detailButtons = document.querySelectorAll('.view-details-btn');
+      detailButtons.forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          e.preventDefault();
+          if (btn.getAttribute('aria-busy') === 'true') return;
+
+          const card = btn.closest('.card');
+          const drinkKey = card ? card.getAttribute('data-drink') : '';
+          const drinkName = card && card.querySelector('h3') ? card.querySelector('h3').textContent : 'drink';
+          const detailsContainer = card ? card.querySelector('.drink-details') : null;
+
+          if (seasonalSection) seasonalSection.setAttribute('aria-busy', 'true');
+          setButtonLoading(btn, true, 'Loading Details...', 'View Details', card);
+          announce('Loading details for ' + drinkName + '...');
+
+          setTimeout(function () {
+            if (detailsContainer && drinkDetailsData[drinkKey]) {
+              detailsContainer.textContent = drinkDetailsData[drinkKey];
+              detailsContainer.classList.add('is-visible');
+            }
+            setButtonLoading(btn, false, 'Loading Details...', 'View Details', card);
+            if (seasonalSection) {
+              const anyBusy = seasonalSection.querySelector('.view-details-btn[aria-busy="true"]');
+              if (!anyBusy) seasonalSection.setAttribute('aria-busy', 'false');
+            }
+            announce('Details loaded for ' + drinkName + '.');
+          }, 800);
+        });
+      });
+    })();
+  </script>
