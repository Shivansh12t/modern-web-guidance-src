+  <script>
+    (() => {
+      const DRINK_DETAILS = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          description: 'Creamy oat milk steamed with two shots of our signature espresso and pure Grade-A Vermont maple syrup, finished with a dash of cinnamon.',
+          notes: '16 oz • 210 kcal • 100% Plant-Based • Available Hot or Iced'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          description: 'Single-origin dark roast beans pulled for a rich, velvety crema with deep notes of dark chocolate, roasted walnut, and smoky caramel.',
+          notes: 'Double Shot (2 oz) • 15 kcal • Ethically Sourced'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          description: 'Coarse-ground artisanal beans steeped in filtered cold water for 18 hours, yielding an ultra-smooth, low-acidity brew with natural cocoa undertones.',
+          notes: '16 oz • 10 kcal • Nitro Option Available'
+        }
+      };
+
+      const orderNowBtn = document.getElementById('order-now-btn');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const seasonalStatus = document.getElementById('seasonal-loading-status');
+      const seasonalStatusText = document.getElementById('seasonal-loading-text');
+      const detailButtons = document.querySelectorAll('.drink-details-btn');
+      const dialog = document.getElementById('drink-details-dialog');
+      const dialogTitle = document.getElementById('dialog-drink-title');
+      const dialogDesc = document.getElementById('dialog-drink-desc');
+      const dialogNotes = document.getElementById('dialog-drink-notes');
+      const closeDialogBtn = document.getElementById('close-dialog-btn');
+
+      function setButtonLoading(btn, isLoading, defaultLabel) {
+        const spinner = btn.querySelector('progress.loading-spinner');
+        const labelEl = btn.querySelector('.btn-label');
+
+        if (isLoading) {
+          btn.setAttribute('aria-busy', 'true');
+          btn.setAttribute('aria-disabled', 'true');
+          if (spinner) {
+            spinner.removeAttribute('hidden');
+          }
+          if (labelEl && btn.dataset.loadingLabel) {
+            labelEl.textContent = btn.dataset.loadingLabel;
+          }
+        } else {
+          btn.removeAttribute('aria-busy');
+          btn.removeAttribute('aria-disabled');
+          if (spinner) {
+            spinner.setAttribute('hidden', '');
+          }
+          if (labelEl && defaultLabel) {
+            labelEl.textContent = defaultLabel;
+          }
+        }
+      }
+
+      if (orderNowBtn) {
+        const defaultOrderLabel = orderNowBtn.querySelector('.btn-label')?.textContent || 'Order Now';
+        orderNowBtn.addEventListener('click', (event) => {
+          event.preventDefault();
+          if (orderNowBtn.getAttribute('aria-busy') === 'true') {
+            return;
+          }
+
+          setButtonLoading(orderNowBtn, true, defaultOrderLabel);
+
+          setTimeout(() => {
+            if (dialog && typeof dialog.showModal === 'function') {
+              dialogTitle.textContent = 'Your Order Is Ready to Start';
+              dialogDesc.textContent = 'We have prepared your online order session for pickup at your nearest Daily Grind café.';
+              dialogNotes.textContent = 'Estimated prep time: 5–8 minutes';
+              setButtonLoading(orderNowBtn, false, defaultOrderLabel);
+              dialog.showModal();
+            } else {
+              window.location.href = orderNowBtn.getAttribute('href');
+            }
+          }, 900);
+        });
+      }
+
+      detailButtons.forEach((btn) => {
+        const defaultLabel = btn.querySelector('.btn-label')?.textContent || 'View Details';
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          if (btn.getAttribute('aria-busy') === 'true' || seasonalSection?.getAttribute('aria-busy') === 'true') {
+            return;
+          }
+
+          const card = btn.closest('.card');
+          const drinkId = btn.dataset.drinkId;
+          const details = DRINK_DETAILS[drinkId];
+
+          setButtonLoading(btn, true, defaultLabel);
+          if (card) {
+            card.setAttribute('aria-busy', 'true');
+          }
+          if (seasonalSection) {
+            seasonalSection.setAttribute('aria-busy', 'true');
+          }
+          if (seasonalStatus) {
+            if (seasonalStatusText && details) {
+              seasonalStatusText.textContent = `Loading ${details.title} details...`;
+            }
+            seasonalStatus.removeAttribute('hidden');
+          }
+
+          setTimeout(() => {
+            setButtonLoading(btn, false, defaultLabel);
+            if (card) {
+              card.removeAttribute('aria-busy');
+            }
+            if (seasonalSection) {
+              seasonalSection.setAttribute('aria-busy', 'false');
+            }
+            if (seasonalStatus) {
+              seasonalStatus.setAttribute('hidden', '');
+            }
+
+            if (details && dialog && typeof dialog.showModal === 'function') {
+              dialogTitle.textContent = details.title;
+              dialogDesc.textContent = details.description;
+              dialogNotes.textContent = details.notes;
+              dialog.showModal();
+            }
+          }, 900);
+        });
+      });
+
+      if (closeDialogBtn && dialog) {
+        closeDialogBtn.addEventListener('click', () => {
+          dialog.close();
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
