+  <script>
+    (function () {
+      function extractCodeFromSmsText(rawText) {
+        if (!rawText) return '';
+        const text = String(rawText).trim();
+        // Match origin-bound WebOTP SMS format first (e.g., "@dailygrind.com #123456")
+        const hashMatch = text.match(/#(\d{4,8})\b/);
+        if (hashMatch) return hashMatch[1].slice(0, 6);
+        // Match standalone 6-digit passcode in an SMS message
+        const sixDigitMatch = text.match(/\b(\d{6})\b/);
+        if (sixDigitMatch) return sixDigitMatch[1];
+        // Otherwise strip non-digits up to 6 characters
+        return text.replace(/\D+/g, '').slice(0, 6);
+      }
+
+      function initOtpVerification() {
+        const input = document.querySelector('input[autocomplete="one-time-code"]');
+        if (!input) return;
+        const form = input.closest('form');
+        const statusEl = document.getElementById('otp-status');
+        const resendBtn = document.getElementById('resend-otp-btn');
+        let activeAbortController = null;
+
+        function setStatus(message, type) {
+          if (!statusEl) return;
+          statusEl.textContent = message;
+          statusEl.className = 'otp-status visible ' + (type || 'info');
+        }
+
+        function verifyCode(code) {
+          const cleanCode = extractCodeFromSmsText(code);
+          input.value = cleanCode;
+          if (/^\d{6}$/.test(cleanCode)) {
+            input.setAttribute('aria-invalid', 'false');
+            setStatus('Passcode verified! You are now signed in for Rewards and online ordering.', 'success');
+            return true;
+          } else {
+            input.setAttribute('aria-invalid', 'true');
+            setStatus('Please enter a valid 6-digit numeric verification code.', 'error');
+            input.focus();
+            return false;
+          }
+        }
+
+        function startWebOtpListener() {
+          if (!('OTPCredential' in window) && !(navigator.credentials && typeof navigator.credentials.get === 'function')) {
+            return;
+          }
+          if (activeAbortController) {
+            activeAbortController.abort();
+          }
+          const ac = new AbortController();
+          activeAbortController = ac;
+
+          navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal
+          }).then(function (otp) {
+            if (otp && otp.code) {
+              input.value = extractCodeFromSmsText(otp.code) || otp.code;
+              input.setAttribute('aria-invalid', 'false');
+              verifyCode(input.value);
+            }
+          }).catch(function () {
+            // Silently ignore AbortError or unsupported environment errors
+          });
+        }
+
+        input.addEventListener('paste', function (event) {
+          const clipboardData = event.clipboardData || window.clipboardData;
+          if (!clipboardData) return;
+          const pastedText = clipboardData.getData('text');
+          const extracted = extractCodeFromSmsText(pastedText);
+          if (extracted) {
+            event.preventDefault();
+            input.value = extracted;
+            input.setAttribute('aria-invalid', 'false');
+            if (/^\d{6}$/.test(extracted)) {
+              verifyCode(extracted);
+            }
+          }
+        });
+
+        input.addEventListener('input', function () {
+          const extracted = extractCodeFromSmsText(input.value);
+          if (input.value !== extracted) {
+            input.value = extracted;
+          }
+          if (input.getAttribute('aria-invalid') === 'true' && /^\d{6}$/.test(extracted)) {
+            input.setAttribute('aria-invalid', 'false');
+          }
+        });
+
+        if (form) {
+          form.addEventListener('submit', function (event) {
+            event.preventDefault();
+            if (activeAbortController) {
+              activeAbortController.abort();
+              activeAbortController = null;
+            }
+            verifyCode(input.value);
+          });
+        }
+
+        if (resendBtn) {
+          resendBtn.addEventListener('click', function () {
+            input.value = '';
+            input.setAttribute('aria-invalid', 'false');
+            setStatus('A new 6-digit SMS verification code has been sent to your phone.', 'info');
+            startWebOtpListener();
+            input.focus();
+          });
+        }
+
+        startWebOtpListener();
+      }
+
+      if (document.readyState === 'loading') {
+        window.addEventListener('DOMContentLoaded', initOtpVerification);
+      } else {
+        initOtpVerification();
+      }
+    })();
+  </script>
