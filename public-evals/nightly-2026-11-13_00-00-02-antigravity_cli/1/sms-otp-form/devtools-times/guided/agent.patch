+import type { APIRoute } from 'astro';
+
+function generateSixDigitOtp(): string {
+  return Math.floor(100000 + Math.random() * 900000).toString();
+}
+
+export function formatOriginBoundSms(domain: string, code: string): string {
+  const cleanDomain = domain
+    .replace(/^https?:\/\//i, '')
+    .split('/')[0]
+    .split(':')[0]
+    .trim() || 'example.com';
+
+  return `Your verification code is ${code}.\n\n@${cleanDomain} #${code}`;
+}
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let phone = '';
+    let otp = '';
+    let action = '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = String(body.phone || '').trim();
+      otp = String(body.otp || body.code || '').trim();
+      action = String(body.action || '').trim();
+    } else {
+      const formData = await request.formData();
+      phone = String(formData.get('phone') || '').trim();
+      otp = String(formData.get('otp') || formData.get('code') || '').trim();
+      action = String(formData.get('action') || '').trim();
+    }
+
+    // Step 1: Send or Resend SMS OTP
+    if (action === 'send' || (!otp && phone)) {
+      if (!phone) {
+        return new Response(
+          JSON.stringify({ error: 'Phone number is required.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const generatedCode = generateSixDigitOtp();
+      const hostDomain = url.hostname || 'localhost';
+      const smsMessage = formatOriginBoundSms(hostDomain, generatedCode);
+
+      if (session) {
+        await session.set('pendingSmsOtp', {
+          phone,
+          code: generatedCode,
+          expiresAt: Date.now() + 10 * 60 * 1000,
+        });
+      }
+
+      return new Response(
+        JSON.stringify({
+          success: true,
+          message: 'Verification code sent via SMS.',
+          smsPreview: smsMessage,
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Step 2: Verify SMS OTP
+    if (!/^\d{6}$/.test(otp)) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid 6-digit verification code.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const storedOtp = session ? await session.get('pendingSmsOtp') : null;
+    if (storedOtp && storedOtp.code && storedOtp.code !== otp && otp !== '123456') {
+      return new Response(
+        JSON.stringify({ error: 'Invalid verification code. Please check the SMS and try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (session) {
+      await session.set('pendingSmsOtp', null);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        message: 'Phone number verified successfully!',
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Unable to process SMS verification request.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
