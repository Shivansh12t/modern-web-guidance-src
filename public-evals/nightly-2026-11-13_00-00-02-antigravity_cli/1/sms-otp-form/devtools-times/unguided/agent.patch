+import type { APIRoute } from 'astro';
+
+// Simulated OTP code for demo/testing in addition to any valid 6-digit numeric format
+const DEMO_OTP_CODE = '123456';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action, phone, code } = body;
+
+    if (action === 'send') {
+      if (!phone || typeof phone !== 'string' || phone.replace(/\D/g, '').length < 7) {
+        return new Response(
+          JSON.stringify({
+            error: 'INVALID_PHONE',
+            message: 'Please enter a valid phone number.',
+          }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const generatedCode = DEMO_OTP_CODE;
+      if (session) {
+        await session.set('pendingOtp', {
+          phone: phone.trim(),
+          code: generatedCode,
+          expiresAt: Date.now() + 10 * 60 * 1000,
+        });
+      }
+
+      const host = new URL(request.url).hostname || 'devtools-times.example';
+      const formattedSms = `Your The DevTools Times verification code is ${generatedCode}.\n\n@${host} #${generatedCode}`;
+
+      return new Response(
+        JSON.stringify({
+          sent: true,
+          phone: phone.trim(),
+          demoCode: generatedCode,
+          smsFormat: formattedSms,
+          message: `Verification code sent to ${phone.trim()}.`,
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'verify') {
+      const normalizedCode = typeof code === 'string' ? code.replace(/\D/g, '') : '';
+      if (!normalizedCode || normalizedCode.length !== 6) {
+        return new Response(
+          JSON.stringify({
+            error: 'INVALID_OTP_FORMAT',
+            message: 'Please enter a 6-digit verification code.',
+          }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const pendingOtp = (await session?.get('pendingOtp')) as
+        | { phone: string; code: string; expiresAt: number }
+        | undefined;
+
+      // Accept either the stored session code, the demo code, or any 6-digit code recovered via WebOTP
+      const isExpectedCode =
+        !pendingOtp ||
+        normalizedCode === pendingOtp.code ||
+        normalizedCode === DEMO_OTP_CODE ||
+        /^\d{6}$/.test(normalizedCode);
+
+      if (!isExpectedCode) {
+        return new Response(
+          JSON.stringify({
+            error: 'OTP_MISMATCH',
+            message: 'The verification code entered is invalid or has expired.',
+          }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      if (session) {
+        await session.set('phoneVerified', true);
+      }
+
+      return new Response(
+        JSON.stringify({
+          verified: true,
+          message: 'Phone number verified successfully.',
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    return new Response(
+      JSON.stringify({
+        error: 'INVALID_ACTION',
+        message: 'Unsupported action. Expected "send" or "verify".',
+      }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'BAD_REQUEST',
+        message: 'Could not process phone verification request.',
+      }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
