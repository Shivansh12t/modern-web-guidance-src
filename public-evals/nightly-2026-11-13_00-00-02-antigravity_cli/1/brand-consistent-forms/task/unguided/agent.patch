+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-value-text');
+      const roastInput = document.getElementById('roast-preference');
+      const roastOutput = document.getElementById('roast-level-output');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMessage = document.getElementById('subscription-status');
+
+      const roastNames = {
+        1: 'Light Roast (1/5)',
+        2: 'Medium-Light Roast (2/5)',
+        3: 'Medium Roast (3/5)',
+        4: 'Medium-Dark Roast (4/5)',
+        5: 'Dark Roast (5/5)'
+      };
+
+      function updateFormState() {
+        const selectedFrequency = form.querySelector('input[name="delivery-frequency"]:checked');
+        const hasRoast = roastInput && roastInput.value !== '';
+        const hasEmailChoice = emailCheckbox && emailCheckbox.checked;
+
+        let completedSteps = 0;
+        if (selectedFrequency) completedSteps += 1;
+        if (hasRoast) completedSteps += 1;
+        if (hasEmailChoice) completedSteps += 1;
+
+        const percent = Math.round((completedSteps / 3) * 100);
+        progress.value = percent;
+        progress.textContent = percent + '%';
+        progressText.textContent = percent + '%';
+
+        if (roastInput && roastOutput) {
+          roastOutput.textContent = roastNames[roastInput.value] || ('Level ' + roastInput.value + '/5');
+        }
+      }
+
+      form.addEventListener('input', updateFormState);
+      form.addEventListener('change', updateFormState);
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        progress.value = 100;
+        progress.textContent = '100%';
+        progressText.textContent = '100%';
+        statusMessage.textContent = 'Your personalized coffee subscription preferences have been saved!';
+      });
+
+      updateFormState();
+    })();
+  </script>
