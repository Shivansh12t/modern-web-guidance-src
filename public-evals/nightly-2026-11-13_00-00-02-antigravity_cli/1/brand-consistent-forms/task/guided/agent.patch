+  <script>
+    (function () {
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const setupProgress = document.getElementById('setup-progress');
+      const progressOutput = document.getElementById('progress-output');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const freqRadios = document.querySelectorAll('input[name="delivery_frequency"]');
+      const form = document.getElementById('subscription-form');
+
+      const roastNames = {
+        0: 'Light (0%)',
+        25: 'Medium-Light (25%)',
+        50: 'Medium (50%)',
+        75: 'Medium-Dark (75%)',
+        100: 'Dark (100%)'
+      };
+
+      let roastInteracted = true;
+
+      function updateProgress() {
+        let completed = 0;
+        const total = 3;
+        if ( Array.from(freqRadios).some((r) => r.checked) ) completed++;
+        if ( roastInteracted && roastSlider.value !== '' ) completed++;
+        if ( emailCheckbox.checked ) completed++;
+
+        const pct = Math.round((completed / total) * 100);
+        setupProgress.value = pct;
+        setupProgress.textContent = pct + '%';
+        if (progressOutput) {
+          progressOutput.value = pct + '%';
+        }
+      }
+
+      if (roastSlider) {
+        roastSlider.style.setProperty('--progress', `${roastSlider.value}%`);
+        roastSlider.addEventListener('input', (e) => {
+          const val = e.target.value;
+          if (!CSS.supports('accent-color', '#4e342e')) {
+            e.target.style.setProperty('--progress', `${val}%`);
+          } else {
+            e.target.style.setProperty('--progress', `${val}%`);
+          }
+          if (roastOutput) {
+            roastOutput.value = roastNames[val] || `${val}%`;
+          }
+          updateProgress();
+        });
+      }
+
+      if (emailCheckbox) {
+        emailCheckbox.addEventListener('change', updateProgress);
+      }
+
+      freqRadios.forEach((radio) => {
+        radio.addEventListener('change', updateProgress);
+      });
+
+      if (form) {
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          setupProgress.value = 100;
+          if (progressOutput) {
+            progressOutput.value = '100% — Subscribed!';
+          }
+        });
+      }
+
+      updateProgress();
+    })();
+  </script>
