+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMsg = document.getElementById('newsletter-error');
+      const successMsg = document.getElementById('newsletter-success');
+
+      function isValidEmail(value) {
+        const trimmed = value.trim();
+        if (!trimmed) return false;
+        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed) && emailInput.checkValidity();
+      }
+
+      function clearError() {
+        emailInput.classList.remove('is-invalid');
+        emailInput.removeAttribute('aria-invalid');
+        errorMsg.classList.remove('visible');
+      }
+
+      function showError() {
+        emailInput.classList.remove('is-valid');
+        emailInput.classList.add('is-invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMsg.classList.add('visible');
+        successMsg.classList.remove('visible');
+      }
+
+      // Never show an error while the user is actively typing/focused;
+      // if an error was previously shown, clear it as soon as they start editing.
+      emailInput.addEventListener('input', function () {
+        clearError();
+        emailInput.classList.remove('is-valid');
+        successMsg.classList.remove('visible');
+      });
+
+      // Validate only when the user clicks/tabs away (on blur)
+      emailInput.addEventListener('blur', function () {
+        const val = emailInput.value.trim();
+        if (val === '') {
+          clearError();
+          emailInput.classList.remove('is-valid');
+          return;
+        }
+        if (!isValidEmail(val)) {
+          showError();
+        } else {
+          clearError();
+          emailInput.classList.add('is-valid');
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const val = emailInput.value.trim();
+        if (!isValidEmail(val)) {
+          showError();
+          return;
+        }
+        clearError();
+        emailInput.classList.remove('is-valid');
+        emailInput.value = '';
+        successMsg.classList.add('visible');
+      });
+    })();
+  </script>
+
 </body>
 
