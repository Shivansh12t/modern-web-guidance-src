+  <script>
+    (function () {
+      const carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+      const items = Array.from(carousel.querySelectorAll('.carousel-item'));
+      if (items.length === 0) return;
+
+      function updateSnappedItem() {
+        const carouselRect = carousel.getBoundingClientRect();
+        const carouselCenter = carouselRect.left + carouselRect.width / 2;
+
+        let closestItem = items[0];
+        let minDistance = Infinity;
+
+        items.forEach((item) => {
+          const rect = item.getBoundingClientRect();
+          const itemCenter = rect.left + rect.width / 2;
+          const distance = Math.abs(carouselCenter - itemCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestItem = item;
+          }
+        });
+
+        items.forEach((item) => {
+          const isSnapped = item === closestItem;
+          item.classList.toggle('is-snapped', isSnapped);
+          item.classList.toggle('snapped', isSnapped);
+          item.classList.toggle('active', isSnapped);
+          item.setAttribute('data-snapped', isSnapped ? 'true' : 'false');
+        });
+      }
+
+      carousel.addEventListener('scroll', updateSnappedItem, { passive: true });
+      carousel.addEventListener('scrollsnapchange', (e) => {
+        if (e.snapTargetInline) {
+          items.forEach((item) => {
+            const isSnapped = item === e.snapTargetInline;
+            item.classList.toggle('is-snapped', isSnapped);
+            item.classList.toggle('snapped', isSnapped);
+            item.classList.toggle('active', isSnapped);
+            item.setAttribute('data-snapped', isSnapped ? 'true' : 'false');
+          });
+        } else {
+          updateSnappedItem();
+        }
+      });
+      carousel.addEventListener('scrollsnapchanging', (e) => {
+        if (e.snapTargetInline) {
+          items.forEach((item) => {
+            const isSnapped = item === e.snapTargetInline;
+            item.classList.toggle('is-snapped', isSnapped);
+            item.classList.toggle('snapped', isSnapped);
+            item.classList.toggle('active', isSnapped);
+            item.setAttribute('data-snapped', isSnapped ? 'true' : 'false');
+          });
+        }
+      });
+      window.addEventListener('resize', updateSnappedItem);
+      updateSnappedItem();
+    })();
+  </script>
