+  <script>
+    const escapeHtml = (unsafe) =>
+      String(unsafe)
+        .replace(/&/g, '&amp;')
+        .replace(/</g, '&lt;')
+        .replace(/>/g, '&gt;')
+        .replace(/"/g, '&quot;')
+        .replace(/'/g, '&#039;');
+
+    const sanitizeHtml = (dirtyHtml) => {
+      if (window.DOMPurify) {
+        return window.DOMPurify.sanitize(dirtyHtml, { RETURN_TRUSTED_TYPE: false });
+      }
+      const parser = new DOMParser();
+      const doc = parser.parseFromString(dirtyHtml, 'text/html');
+      doc.querySelectorAll('script, iframe, object, embed, link, meta, style').forEach((el) => el.remove());
+      doc.querySelectorAll('*').forEach((el) => {
+        Array.from(el.attributes).forEach((attr) => {
+          const name = attr.name.toLowerCase();
+          const val = attr.value.trim().toLowerCase();
+          if (name.startsWith('on') || ((name === 'href' || name === 'src' || name === 'action') && val.startsWith('javascript:'))) {
+            el.removeAttribute(attr.name);
+          }
+        });
+      });
+      return doc.body.innerHTML;
+    };
+
+    let policy = null;
+    if (window.trustedTypes && window.trustedTypes.createPolicy) {
+      if (!window.trustedTypes.defaultPolicy) {
+        policy = window.trustedTypes.createPolicy('default', {
+          createHTML: (input) => sanitizeHtml(input),
+          createScriptURL: (input) => input,
+          createScript: (input) => input,
+        });
+      } else {
+        policy = window.trustedTypes.defaultPolicy;
+      }
+    }
+
+    const toSafeHtml = (htmlString) => {
+      return policy ? policy.createHTML(htmlString) : sanitizeHtml(htmlString);
+    };
+
+    const seasonalFavorites = [
+      {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        href: '/menu/seasonal',
+      },
+      {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        href: '/menu/espresso',
+      },
+      {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        href: '/menu/cold-brew',
+      },
+    ];
+
+    const createCardHtml = ({ title, description, href }) => `
+      <div class="card">
+        <h3>${escapeHtml(title)}</h3>
+        <p>${escapeHtml(description)}</p>
+        <a href="${escapeHtml(href)}" class="btn">View Details</a>
+      </div>
+    `;
+
+    const renderSeasonalFavorites = (items = seasonalFavorites) => {
+      const grid = document.getElementById('seasonal-favorites-grid') || document.querySelector('.grid');
+      if (!grid) return;
+
+      const cardsHtml = items
+        .map((item) => (typeof item === 'string' ? item : createCardHtml(item)))
+        .join('');
+
+      grid.innerHTML = toSafeHtml(cardsHtml);
+    };
+
+    window.renderSeasonalFavorites = renderSeasonalFavorites;
+    renderSeasonalFavorites();
+  </script>
