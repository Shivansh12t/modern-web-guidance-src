+  <script id="ripple-fragment-shader" type="x-shader/x-fragment">
+    precision highp float;
+
+    varying vec2 v_uv;
+    uniform sampler2D u_texture;
+    uniform vec2 u_resolution;
+    uniform vec2 u_mouse;
+    uniform vec2 u_velocity;
+    uniform float u_time;
+    uniform float u_hover;
+    uniform vec4 u_ripples[6]; // xy: normalized coords, z: startTime, w: amplitude
+
+    void main() {
+      vec2 uv = v_uv;
+      float aspect = u_resolution.x / max(u_resolution.y, 1.0);
+      vec2 aspectVec = vec2(aspect, 1.0);
+
+      vec2 totalDisplacement = vec2(0.0);
+      float chromaticShift = 0.0;
+
+      // Ambient gentle liquid wave across the HTML content
+      float ambientX = sin(uv.y * 14.0 + u_time * 2.2) * cos(uv.x * 9.0 + u_time * 1.6);
+      float ambientY = cos(uv.x * 12.0 - u_time * 1.9) * sin(uv.y * 11.0 + u_time * 1.4);
+      totalDisplacement += vec2(ambientX, ambientY) * 0.0022;
+
+      // Interactive cursor proximity ripple & wake distortion
+      vec2 toMouse = (uv - u_mouse) * aspectVec;
+      float mouseDist = length(toMouse);
+      vec2 mouseDir = mouseDist > 0.0001 ? normalize(toMouse) : vec2(0.0);
+
+      float cursorRadius = 0.35;
+      if (mouseDist < cursorRadius) {
+        float falloff = pow(1.0 - mouseDist / cursorRadius, 2.0);
+        float wave = sin(mouseDist * 48.0 - u_time * 9.0);
+        float speedFactor = clamp(length(u_velocity) * 28.0, 0.35, 2.5);
+        float strength = (0.0085 * u_hover * speedFactor) * falloff;
+        totalDisplacement += mouseDir * wave * strength;
+        totalDisplacement += u_velocity * falloff * 0.12;
+        chromaticShift += abs(wave) * strength * 0.65;
+      }
+
+      // Propagating concentric shockwave ripples (on pointer move bursts & clicks)
+      for (int i = 0; i < 6; i++) {
+        vec4 ripple = u_ripples[i];
+        float age = u_time - ripple.z;
+        if (age > 0.0 && age < 2.6 && ripple.w > 0.0) {
+          vec2 delta = (uv - ripple.xy) * aspectVec;
+          float dist = length(delta);
+          vec2 dir = dist > 0.0001 ? normalize(delta) : vec2(0.0);
+
+          float radius = age * 0.48;
+          float band = abs(dist - radius);
+          float bandwidth = 0.095 + age * 0.035;
+
+          if (band < bandwidth) {
+            float envelope = smoothstep(bandwidth, 0.0, band);
+            float decay = exp(-age * 2.1) * ripple.w;
+            float phase = sin((dist - radius) * 72.0 - age * 12.0);
+            float disp = phase * envelope * decay * 0.018;
+            totalDisplacement += dir * disp;
+            chromaticShift += abs(disp) * 0.85;
