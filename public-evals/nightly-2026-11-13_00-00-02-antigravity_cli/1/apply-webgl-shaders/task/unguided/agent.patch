+        gl.uniform1f(uHover, hoverStrength);
+        gl.uniform4fv(uRipples, ripples);
+
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+        requestAnimationFrame(render);
+      }
+
+      requestAnimationFrame(render);
+    })();
+  </script>
