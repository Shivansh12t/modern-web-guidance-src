+      // Sample RGBA with subtle dispersion on the ripple crest while preserving alpha
+      vec2 caOffset = totalDisplacement * (0.35 + chromaticShift * 18.0);
+      vec4 sampleCenter = texture2D(u_texture, clamp(distortedUv, 0.0, 1.0));
+      vec4 sampleR = texture2D(u_texture, clamp(distortedUv + caOffset, 0.0, 1.0));
+      vec4 sampleB = texture2D(u_texture, clamp(distortedUv - caOffset, 0.0, 1.0));
+
+      float alpha = max(sampleCenter.a, max(sampleR.a, sampleB.a) * 0.85);
+      vec3 color = vec3(sampleR.r, sampleCenter.g, sampleB.b);
