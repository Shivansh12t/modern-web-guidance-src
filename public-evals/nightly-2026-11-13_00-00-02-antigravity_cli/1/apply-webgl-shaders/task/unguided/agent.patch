+        const idx = (rippleIndex % MAX_RIPPLES) * 4;
+        ripples[idx] = normX;
+        ripples[idx + 1] = normY;
+        ripples[idx + 2] = getNowSeconds();
+        ripples[idx + 3] = amplitude;
+        rippleIndex++;
+      }
+
+      // Seed an initial gentle ripple on load over 'Wake Up Your Senses'
+      addRipple(0.5, 0.36, 0.85);
+
+      let mouseX = 0.5;
+      let mouseY = 0.45;
+      let targetMouseX = 0.5;
+      let targetMouseY = 0.45;
+      let velX = 0.0;
+      let velY = 0.0;
+      let hoverStrength = 0.4;
+      let targetHover = 0.4;
+      let lastRippleSpawn = 0;
+
+      hero.addEventListener('pointermove', function (e) {
+        const rect = hero.getBoundingClientRect();
+        const nx = (e.clientX - rect.left) / Math.max(rect.width, 1);
+        const ny = (e.clientY - rect.top) / Math.max(rect.height, 1);
+        velX = nx - targetMouseX;
+        velY = ny - targetMouseY;
+        targetMouseX = nx;
+        targetMouseY = ny;
+        targetHover = 1.0;
+
+        const now = performance.now();
+        const speed = Math.hypot(velX, velY);
+        if (speed > 0.018 && now - lastRippleSpawn > 140) {
+          addRipple(nx, ny, Math.min(1.1, 0.45 + speed * 8.0));
+          lastRippleSpawn = now;
+        }
+      });
+
+      hero.addEventListener('pointerenter', function () {
+        targetHover = 1.0;
+      });
+
+      hero.addEventListener('pointerleave', function () {
+        targetHover = 0.25;
+      });
+
+      hero.addEventListener('pointerdown', function (e) {
+        const rect = hero.getBoundingClientRect();
+        const nx = (e.clientX - rect.left) / Math.max(rect.width, 1);
+        const ny = (e.clientY - rect.top) / Math.max(rect.height, 1);
+        addRipple(nx, ny, 1.25);
+      });
+
+      // Preserve button hover/focus/active states and trigger a ripple around 'Order Now'
+      ctaEl.addEventListener('pointerenter', function () {
+        isButtonHovered = true;
+        syncHtmlContentTexture();
+        const heroRect = hero.getBoundingClientRect();
