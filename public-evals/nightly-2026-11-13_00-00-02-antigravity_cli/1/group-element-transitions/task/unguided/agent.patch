+                { transform: 'translate(0, 0)' }
+              ],
+              { duration: 380, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
+            );
+          }
+        });
+      }
+
+      function updateSummary() {
+        const cards = Array.from(grid.querySelectorAll('.bean-card'));
+        const count = cards.length;
+        const total = cards.reduce((sum, card) => {
+          return sum + (parseFloat(card.dataset.price) || 0);
+        }, 0);
+        const totalOz = count * 12;
+
+        countBadge.textContent = `${count} ${count === 1 ? 'Bean' : 'Beans'} Selected`;
+        totalPriceEl.textContent = `Total: $${total.toFixed(2)} (${totalOz} oz)`;
+
+        const emptyEl = grid.querySelector('.bean-empty-state');
+        if (count === 0 && !emptyEl) {
+          const empty = document.createElement('div');
+          empty.className = 'bean-empty-state';
+          empty.textContent = 'Your coffee bean box is empty. Click "+ Add Bean" or choose a Quick Add roast above to start building your selection.';
+          grid.appendChild(empty);
+        } else if (count > 0 && emptyEl) {
+          emptyEl.remove();
+        }
+      }
+
+      function createBeanCard(varietyKey) {
+        const bean = BEAN_CATALOG[varietyKey] || BEAN_CATALOG['ethiopian-yirgacheffe'];
+        const itemId = `bean-item-${nextItemCounter++}`;
+
+        const article = document.createElement('article');
+        article.className = 'bean-card';
+        article.setAttribute('role', 'listitem');
+        article.dataset.itemId = itemId;
+        article.dataset.variety = varietyKey;
+        article.dataset.price = bean.price.toFixed(2);
+        article.style.viewTransitionName = itemId;
+
+        const notesHtml = bean.notes
+          .map((note) => `<span class="bean-note-tag">${note}</span>`)
+          .join('');
+
+        article.innerHTML = `
+          <div class="bean-card-image-wrap">
+            <img src="${bean.image}" alt="${bean.name} roasted coffee beans" loading="lazy">
+            <span class="bean-roast-badge">${bean.roast}</span>
+            <span class="bean-origin-badge">${bean.origin}</span>
+          </div>
+          <div class="bean-card-body">
+            <h3>${bean.name}</h3>
+            <p class="bean-card-desc">${bean.desc}</p>
+            <div class="bean-notes">${notesHtml}</div>
+            <div class="bean-card-footer">
+              <div>
+                <span class="bean-price">$${bean.price.toFixed(2)}</span>
+                <span class="bean-weight">/ 12 oz</span>
+              </div>
+              <button type="button" class="remove-bean-btn" aria-label="Remove ${bean.name}">Remove</button>
+            </div>
+          </div>
+        `;
+        return article;
+      }
+
+      function addBean(varietyKey) {
+        let key = varietyKey;
+        if (!key || key === 'next') {
+          key = VARIETY_KEYS[cycleIndex % VARIETY_KEYS.length];
+          cycleIndex++;
+        }
+
+        runWithGroupTransition(() => {
+          const emptyEl = grid.querySelector('.bean-empty-state');
+          if (emptyEl) emptyEl.remove();
+
+          const newCard = createBeanCard(key);
+          // Insert at the start when there are already items so existing items shift positions simultaneously
+          const firstCard = grid.querySelector('.bean-card');
+          if (firstCard) {
+            grid.insertBefore(newCard, firstCard);
+          } else {
+            grid.appendChild(newCard);
+          }
+          updateSummary();
+        });
+      }
+
+      function removeBeanCard(cardEl) {
+        if (!cardEl) return;
+        runWithGroupTransition(() => {
+          cardEl.remove();
+          updateSummary();
+        });
+      }
+
+      addBeanBtn.addEventListener('click', () => {
+        addBean(varietySelect.value);
+      });
+
+      removeLastBtn.addEventListener('click', () => {
+        const cards = grid.querySelectorAll('.bean-card');
+        if (cards.length > 0) {
+          removeBeanCard(cards[cards.length - 1]);
+        }
+      });
+
+      shuffleBtn.addEventListener('click', () => {
+        const cards = Array.from(grid.querySelectorAll('.bean-card'));
+        if (cards.length < 2) return;
+        runWithGroupTransition(() => {
+          for (let i = cards.length - 1; i > 0; i--) {
+            const j = Math.floor(Math.random() * (i + 1));
+            [cards[i], cards[j]] = [cards[j], cards[i]];
+          }
+          cards.forEach((card) => grid.appendChild(card));
+        });
+      });
+
+      document.querySelectorAll('.quick-add-chip').forEach((chip) => {
+        chip.addEventListener('click', () => {
+          addBean(chip.dataset.variety);
+        });
+      });
+
+      grid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.remove-bean-btn');
+        if (removeBtn) {
+          const card = removeBtn.closest('.bean-card');
+          removeBeanCard(card);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
