     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const ALL_BEANS = [
+      {
+        id: 'bean-ethiopia',
+        name: 'Ethiopian Yirgacheffe',
+        roast: 'Light Roast',
+        origin: 'Gedeo Zone, Ethiopia',
+        notes: 'Bright bergamot, jasmine blossom, and sweetMeyer lemon finish.',
+        price: '$19.50'
+      },
+      {
+        id: 'bean-colombia',
+        name: 'Colombia Huila Supremo',
+        roast: 'Medium Roast',
+        origin: 'Huila, Colombia',
+        notes: 'Balanced caramel sweetness with toasted hazelnut and red apple.',
+        price: '$17.00'
+      },
+      {
+        id: 'bean-sumatra',
+        name: 'Sumatra Mandheling',
+        roast: 'Dark Roast',
+        origin: 'North Sumatra, Indonesia',
+        notes: 'Full-bodied and earthy with dark chocolate, cedar, and warm spice.',
+        price: '$18.50'
+      },
+      {
+        id: 'bean-guatemala',
+        name: 'Guatemala Antigua',
+        roast: 'Medium Roast',
+        origin: 'Antigua Valley, Guatemala',
+        notes: 'Velvety cocoa, brown sugar, and a crisp orange zest acidity.',
+        price: '$18.00'
+      },
+      {
+        id: 'bean-kenya',
+        name: 'Kenya AA Nyeri',
+        roast: 'Medium-Light Roast',
+        origin: 'Nyeri County, Kenya',
+        notes: 'Vibrant blackcurrant, ruby grapefruit, and winey complexity.',
+        price: '$21.00'
+      },
+      {
+        id: 'bean-costa-rica',
+        name: 'Costa Rica Tarrazú Honey',
+        roast: 'Medium Roast',
+        origin: 'Tarrazú, Costa Rica',
+        notes: 'Honeyed apricot, roasted almond, and silky milk chocolate.',
+        price: '$19.00'
+      }
+    ];
+
+    let selectedBeans = ALL_BEANS.slice(0, 4);
+
+    const gridEl = document.getElementById('bean-selection-grid');
+    const controlsEl = document.getElementById('bean-add-controls');
+
+    function createBeanCard(bean) {
+      const card = document.createElement('article');
+      card.className = 'bean-card';
+      card.dataset.id = bean.id;
+      card.style.viewTransitionName = bean.id;
+
+      const top = document.createElement('div');
+
+      const title = document.createElement('h3');
+      title.textContent = bean.name;
+
+      const meta = document.createElement('div');
+      meta.className = 'bean-meta';
+      meta.textContent = `${bean.roast} • ${bean.origin}`;
+
+      const notes = document.createElement('p');
+      notes.className = 'bean-notes';
+      notes.textContent = bean.notes;
+
+      top.append(title, meta, notes);
+
+      const footer = document.createElement('div');
+      footer.className = 'bean-footer';
+
+      const price = document.createElement('span');
+      price.className = 'bean-price';
+      price.textContent = bean.price;
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'btn btn-remove';
+      removeBtn.textContent = 'Remove';
+      removeBtn.setAttribute('aria-label', `Remove ${bean.name}`);
+      removeBtn.addEventListener('click', () => removeBean(bean.id, card));
+
+      footer.append(price, removeBtn);
+      card.append(top, footer);
+      return card;
+    }
+
+    function syncDOM() {
+      const existingCards = new Map(
+        Array.from(gridEl.children, (el) => [el.dataset.id, el])
+      );
+
+      const selectedIds = new Set(selectedBeans.map((b) => b.id));
+      for (const [id, el] of existingCards) {
+        if (!selectedIds.has(id)) {
+          el.remove();
+        }
+      }
+
+      for (const bean of selectedBeans) {
+        const card = existingCards.get(bean.id) || createBeanCard(bean);
+        gridEl.appendChild(card);
+      }
+
+      controlsEl.replaceChildren();
+      const availableBeans = ALL_BEANS.filter((b) => !selectedIds.has(b.id));
+
+      for (const bean of availableBeans) {
+        const addBtn = document.createElement('button');
+        addBtn.type = 'button';
+        addBtn.className = 'btn';
+        addBtn.textContent = `+ Add ${bean.name}`;
+        addBtn.addEventListener('click', () => addBean(bean));
+        controlsEl.appendChild(addBtn);
+      }
+
+      if (availableBeans.length > 0) {
+        const addAllBtn = document.createElement('button');
+        addAllBtn.type = 'button';
+        addAllBtn.className = 'btn btn-secondary';
+        addAllBtn.textContent = 'Add All Available';
+        addAllBtn.addEventListener('click', addAllBeans);
+        controlsEl.appendChild(addAllBtn);
+      }
+    }
+
+    function runViewTransition(updateCallback) {
+      if (document.startViewTransition) {
+        const transition = document.startViewTransition(() => {
+          updateCallback();
+        });
+        transition.ready.catch(() => {});
+      } else {
+        updateCallback();
+      }
+    }
+
+    function addBean(bean) {
+      if (selectedBeans.some((b) => b.id === bean.id)) return;
+      runViewTransition(() => {
+        selectedBeans.push(bean);
+        syncDOM();
+      });
+    }
+
+    function addAllBeans() {
+      runViewTransition(() => {
+        for (const bean of ALL_BEANS) {
+          if (!selectedBeans.some((b) => b.id === bean.id)) {
+            selectedBeans.push(bean);
+          }
+        }
+        syncDOM();
+      });
+    }
+
+    function removeBean(beanId, cardEl) {
+      const hadFocus = cardEl.contains(document.activeElement);
+      const nextFocusTarget =
+        cardEl.nextElementSibling?.querySelector('button') ??
+        cardEl.previousElementSibling?.querySelector('button');
+
+      runViewTransition(() => {
+        selectedBeans = selectedBeans.filter((b) => b.id !== beanId);
+        syncDOM();
+        if (hadFocus) {
+          (nextFocusTarget ?? controlsEl.querySelector('button'))?.focus();
+        }
+      });
+    }
+
+    syncDOM();
+  </script>
 </body>
 
 </html>
