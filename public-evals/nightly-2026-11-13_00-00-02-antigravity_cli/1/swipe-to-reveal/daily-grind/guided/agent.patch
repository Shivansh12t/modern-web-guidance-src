+  <script>
+    function setActionTabIndexes(reveal, isRevealed) {
+      const controls = reveal.querySelectorAll('.SwipeReveal-panel button, .SwipeReveal-panel a');
+      for (const control of controls) {
+        control.setAttribute('tabindex', isRevealed ? '0' : '-1');
+      }
+    }
+
+    // Accessible trigger button toggle for revealing/closing swipe action panels
+    for (const trigger of document.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]')) {
+      trigger.addEventListener('click', () => {
+        const reveal = trigger.closest('.SwipeReveal');
+        if (!reveal) return;
+
+        const label = (trigger.getAttribute('aria-label') || '').toLowerCase();
+        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+        if (isExpanded) {
+          if (label.includes('leading') || label.includes('trailing')) {
+            const leadingScrollPanelWidth = reveal.querySelector('.SwipeReveal-panel').offsetWidth;
+            reveal.scrollTo({
+              left: leadingScrollPanelWidth,
+              behavior: 'smooth',
+            });
+          } else {
+            reveal.scrollTo({
+              left: 0,
+              behavior: 'smooth',
+            });
+          }
+
+          for (const actionButton of reveal.querySelectorAll('[aria-label$="actions"]')) {
+            actionButton.setAttribute('aria-expanded', 'false');
+            actionButton.classList.remove('active', 'pending');
+          }
+          setActionTabIndexes(reveal, false);
+          return;
+        }
+
+        const panels = Array.from(reveal.querySelectorAll('.SwipeReveal-panel'));
+        if (panels.length === 0) return;
+
+        let targetScrollLeft = reveal.scrollWidth;
+
+        if (label.includes('leading')) {
+          targetScrollLeft = 0;
+        } else if (label.includes('trailing')) {
+          targetScrollLeft = reveal.scrollWidth;
+        } else if (panels.length === 1) {
+          targetScrollLeft = reveal.scrollWidth;
+        } else {
+          const content = reveal.querySelector('.SwipeReveal-content');
+          const firstTrigger = content.querySelector('[aria-label$="actions"]');
+          targetScrollLeft = trigger === firstTrigger ? 0 : reveal.scrollWidth;
+        }
+
+        reveal.scrollTo({
+          left: targetScrollLeft,
+          behavior: 'smooth',
+        });
+
+        for (const actionButton of reveal.querySelectorAll('[aria-label$="actions"]')) {
+          actionButton.setAttribute('aria-expanded', actionButton === trigger ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, true);
+      });
+    }
+
+    // Keep accessibility state and real-time feedback in sync when swiping
+    for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+      const content = reveal.querySelector('.SwipeReveal-content');
+      const panel = reveal.querySelector('.SwipeReveal-panel');
+      const triggers = reveal.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]');
+      const snapItems = [content, panel].filter(Boolean);
+
+      // Close the revealed panel when keyboard focus returns to the main content
+      if (content) {
+        content.addEventListener('focusin', (event) => {
+          if (event.target.matches(':focus-visible')) {
+            content.scrollIntoView({ block: 'nearest', inline: 'start' });
+          }
+        });
+      }
+
+      const updatePendingState = (pendingTarget) => {
+        const isPanelPending = pendingTarget === panel;
+        if (panel) {
+          panel.classList.toggle('pending', isPanelPending);
+        }
+        for (const trigger of triggers) {
+          trigger.classList.toggle('pending', isPanelPending);
+        }
+      };
+
+      const applySettledState = (snappedTarget) => {
+        const isPanelRevealed = snappedTarget === panel;
+        if (panel) {
+          panel.classList.remove('pending');
+        }
+        for (const trigger of triggers) {
+          trigger.classList.remove('pending');
+          trigger.classList.toggle('active', isPanelRevealed);
+          trigger.setAttribute('aria-expanded', isPanelRevealed ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, isPanelRevealed);
+      };
+
+      const findClosestItemIndex = () => {
+        const maxScrollLeft = Math.max(0, reveal.scrollWidth - reveal.clientWidth);
+        if (maxScrollLeft === 0) return 0;
+        const targetLocations = [0, maxScrollLeft];
+        let closestIndex = 0;
+        let minDistance = Infinity;
+
+        targetLocations.forEach((targetScrollLeft, index) => {
+          const distance = Math.abs(reveal.scrollLeft - targetScrollLeft);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+        return closestIndex;
+      };
+
+      const initActiveState = () => {
+        if (!CSS.supports('scroll-initial-target', 'nearest') && content && content.offsetLeft > 0) {
+          reveal.scrollTo({ left: content.offsetLeft, behavior: 'instant' });
+        }
+        const closestIndex = findClosestItemIndex();
+        applySettledState(snapItems[closestIndex]);
+      };
+
+      if (document.readyState === 'complete') {
+        initActiveState();
+      } else {
+        window.addEventListener('load', initActiveState, { once: true });
+      }
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        reveal.addEventListener('scrollsnapchanging', (event) => {
+          const pendingTarget = event.snapTargetInline;
+          if (!snapItems.includes(pendingTarget)) return;
+          updatePendingState(pendingTarget);
+        });
+
+        reveal.addEventListener('scrollsnapchange', (event) => {
+          const snappedTarget = event.snapTargetInline;
+          if (!snapItems.includes(snappedTarget)) return;
+          applySettledState(snappedTarget);
+        });
+      } else {
+        let scrollTimeout;
+        let rafId = null;
+
+        const promotePendingToActive = () => {
+          const closestIndex = findClosestItemIndex();
+          applySettledState(snapItems[closestIndex]);
+        };
+
+        reveal.addEventListener('scroll', () => {
+          if (rafId) return;
+          rafId = requestAnimationFrame(() => {
+            rafId = null;
+            const closestIndex = findClosestItemIndex();
+            updatePendingState(snapItems[closestIndex]);
+          });
+
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(promotePendingToActive, 100);
+        }, { passive: true });
+
+        reveal.addEventListener('scrollend', () => {
+          clearTimeout(scrollTimeout);
+          promotePendingToActive();
+        });
+      }
+    }
+
+    // Handle explicit clicks on revealed contextual action buttons (never triggered automatically on swipe)
+    const feedbackEl = document.getElementById('seasonal-action-feedback');
+    for (const actionBtn of document.querySelectorAll('.SwipeReveal-panel .swipe-action')) {
+      actionBtn.addEventListener('click', () => {
+        const drink = actionBtn.dataset.drink;
+        const action = actionBtn.dataset.action;
+        if (action === 'favorite') {
+          const isFav = actionBtn.getAttribute('aria-pressed') === 'true';
+          const nextState = !isFav;
+          actionBtn.setAttribute('aria-pressed', String(nextState));
+          actionBtn.textContent = nextState ? 'Favorited' : 'Favorite';
+          if (feedbackEl) {
+            feedbackEl.textContent = nextState
+              ? `${drink} saved to your favorites.`
+              : `${drink} removed from your favorites.`;
+          }
+        } else if (action === 'order') {
+          if (feedbackEl) {
+            feedbackEl.textContent = `${drink} added to your order.`;
+          }
+        } else if (action === 'customize') {
+          if (feedbackEl) {
+            feedbackEl.textContent = `Customizing ${drink} options...`;
+          }
+        }
+      });
+    }
+  </script>
