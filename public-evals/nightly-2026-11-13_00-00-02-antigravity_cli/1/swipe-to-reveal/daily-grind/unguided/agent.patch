+  <script>
+    (function () {
+      const ACTION_WIDTH = 180;
+      const SWIPE_THRESHOLD = 50;
+      const cards = document.querySelectorAll('.card[data-drink]');
+      const toast = document.getElementById('toast-feedback');
+      let toastTimer = null;
+
+      function showToast(message) {
+        if (!toast) return;
+        toast.textContent = message;
+        toast.classList.add('visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => {
+          toast.classList.remove('visible');
+        }, 2600);
+      }
+
+      function setCardOpen(card, isOpen) {
+        const content = card.querySelector('.card-content');
+        const actionsContainer = card.querySelector('.card-actions');
+        const actionButtons = card.querySelectorAll('.action-btn');
+        const toggleBtn = card.querySelector('.swipe-toggle-btn');
+
+        card.classList.remove('swiping');
+        content.style.transform = '';
+
+        if (isOpen) {
+          // Close other open cards first
+          cards.forEach((other) => {
+            if (other !== card && other.classList.contains('actions-open')) {
+              setCardOpen(other, false);
+            }
+          });
+          card.classList.add('actions-open');
+          actionsContainer.setAttribute('aria-hidden', 'false');
+          actionButtons.forEach((btn) => btn.setAttribute('tabindex', '0'));
+          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
+        } else {
+          card.classList.remove('actions-open');
+          actionsContainer.setAttribute('aria-hidden', 'true');
+          actionButtons.forEach((btn) => btn.setAttribute('tabindex', '-1'));
+          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
+        }
+      }
+
+      cards.forEach((card) => {
+        const content = card.querySelector('.card-content');
+        const toggleBtn = card.querySelector('.swipe-toggle-btn');
+        const drinkName = card.getAttribute('data-drink');
+
+        let startX = 0;
+        let startY = 0;
+        let currentDeltaX = 0;
+        let baseOffset = 0;
+        let isDragging = false;
+        let isHorizontalSwipe = null;
+        let didSwipeMove = false;
+
+        function onStart(clientX, clientY) {
+          startX = clientX;
+          startY = clientY;
+          currentDeltaX = 0;
+          baseOffset = card.classList.contains('actions-open') ? -ACTION_WIDTH : 0;
+          isDragging = true;
+          isHorizontalSwipe = null;
+          didSwipeMove = false;
+        }
+
+        function onMove(clientX, clientY, event) {
+          if (!isDragging) return;
+          const dx = clientX - startX;
+          const dy = clientY - startY;
+
+          if (isHorizontalSwipe === null) {
+            if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
+              isHorizontalSwipe = Math.abs(dx) > Math.abs(dy);
+            }
+          }
+
+          if (!isHorizontalSwipe) return;
+
+          if (event && event.cancelable) {
+            event.preventDefault();
+          }
+
+          didSwipeMove = true;
+          card.classList.add('swiping');
+
+          let nextOffset = baseOffset + dx;
+          // Clamp between -ACTION_WIDTH (with slight elastic resistance) and 0
+          if (nextOffset < -ACTION_WIDTH) {
+            nextOffset = -ACTION_WIDTH + (nextOffset + ACTION_WIDTH) * 0.2;
+          } else if (nextOffset > 0) {
+            nextOffset = nextOffset * 0.15;
+          }
+
+          currentDeltaX = dx;
+          content.style.transform = `translateX(${nextOffset}px)`;
+        }
+
+        function onEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+
+          if (!didSwipeMove) {
+            card.classList.remove('swiping');
+            return;
+          }
+
+          const finalOffset = baseOffset + currentDeltaX;
+          // Reveal or hide contextual actions without automatically executing any action
+          if (baseOffset === 0 && currentDeltaX < -SWIPE_THRESHOLD) {
+            setCardOpen(card, true);
+          } else if (baseOffset < 0 && currentDeltaX > SWIPE_THRESHOLD) {
+            setCardOpen(card, false);
+          } else {
+            setCardOpen(card, finalOffset <= -ACTION_WIDTH / 2);
+          }
+        }
+
+        // Touch events
+        content.addEventListener('touchstart', (e) => {
+          if (e.touches.length !== 1) return;
+          onStart(e.touches[0].clientX, e.touches[0].clientY);
+        }, { passive: true });
+
+        content.addEventListener('touchmove', (e) => {
+          if (e.touches.length !== 1) return;
+          onMove(e.touches[0].clientX, e.touches[0].clientY, e);
+        }, { passive: false });
+
+        content.addEventListener('touchend', onEnd);
+        content.addEventListener('touchcancel', onEnd);
+
+        // Mouse drag support for desktop
+        content.addEventListener('mousedown', (e) => {
+          if (e.button !== 0) return;
+          if (e.target.closest('a, button')) return;
+          onStart(e.clientX, e.clientY);
+        });
+
+        window.addEventListener('mousemove', (e) => {
+          if (!isDragging) return;
+          onMove(e.clientX, e.clientY, e);
+        });
+
+        window.addEventListener('mouseup', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+
+        // Prevent accidental link navigation when finishing a horizontal drag
+        content.addEventListener('click', (e) => {
+          if (didSwipeMove) {
+            e.preventDefault();
+            e.stopPropagation();
+            didSwipeMove = false;
+          }
+        }, true);
+
+        // Explicit toggle button for keyboard / non-swipe users
+        if (toggleBtn) {
+          toggleBtn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const isOpen = card.classList.contains('actions-open');
+            setCardOpen(card, !isOpen);
+          });
+        }
+
+        // Explicit action button clicks (only triggered when user clicks/taps an action button)
+        card.querySelectorAll('.action-btn').forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const action = btn.getAttribute('data-action');
+            if (action === 'Order') {
+              showToast(`Added ${drinkName} to your order.`);
+            } else if (action === 'Customize') {
+              showToast(`Customizing ${drinkName}...`);
+            } else if (action === 'Favorite') {
+              const isFav = btn.classList.toggle('is-favorited');
+              showToast(isFav ? `Saved ${drinkName} to favorites!` : `Removed ${drinkName} from favorites.`);
+            }
+            setCardOpen(card, false);
+          });
+        });
+      });
+
+      // Close open action trays when clicking outside cards or pressing Escape
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('.card')) {
+          cards.forEach((card) => setCardOpen(card, false));
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          cards.forEach((card) => setCardOpen(card, false));
+        }
+      });
+    })();
+  </script>
 </body>
 
