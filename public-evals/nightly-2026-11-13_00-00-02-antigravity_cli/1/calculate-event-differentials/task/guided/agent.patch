+  <script>
+    function initializePromoCountdown() {
+      const remainingEl = document.getElementById('maple-oat-remaining');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      // Obtain current time in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const userTimeZone = now.timeZoneId;
+
+      // Combine separate date and time strings via Temporal methods in the user's local time zone
+      const promoStartDate = '2026-02-01';
+      const promoEndDate = '2026-03-01';
+      const midnightTime = '00:00:00';
+
+      const start = Temporal.PlainDate.from(promoStartDate)
+        .toPlainDateTime(midnightTime)
+        .toZonedDateTime(userTimeZone);
+      const end = Temporal.PlainDate.from(promoEndDate)
+        .toPlainDateTime(midnightTime)
+        .toZonedDateTime(userTimeZone);
+
+      // Calculate elapsed time since the start of the promotion and remaining time until it ends
+      const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      const isExpired = timeRemaining.sign <= 0;
+      const isPastHalfway = Temporal.Duration.compare(timeActive, timeRemaining, { relativeTo: now }) > 0;
+
+      if (isExpired) {
+        remainingEl.textContent = 'Offer has ended (0 days, 0 hours left)';
+        remainingEl.setAttribute('datetime', 'PT0H');
+      } else {
+        const formattedRemaining = timeRemaining.toLocaleString('en-US', { style: 'long' });
+        remainingEl.textContent = `Offer ends in ${formattedRemaining}`;
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+      }
+
+      if (timeActive.sign >= 0) {
+        const formattedElapsed = timeActive.toLocaleString('en-US', { style: 'long' });
+        elapsedEl.textContent = `Time elapsed since promo start: ${formattedElapsed}`;
+        elapsedEl.setAttribute('datetime', timeActive.toString());
+        elapsedEl.dataset.pastHalfway = String(isPastHalfway);
+      } else {
+        const untilStart = now.until(start, { largestUnit: 'day', smallestUnit: 'hour' });
+        elapsedEl.textContent = `Promo starts in ${untilStart.toLocaleString('en-US', { style: 'long' })}`;
+        elapsedEl.setAttribute('datetime', untilStart.toString());
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializePromoCountdown();
+    })();
+  </script>
