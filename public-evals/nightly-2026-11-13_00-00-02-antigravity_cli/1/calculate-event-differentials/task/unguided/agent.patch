+  <script>
+    function updateMaplePromoTimer() {
+      const countdownEl = document.getElementById('maple-countdown');
+      const elapsedEl = document.getElementById('maple-elapsed');
+      if (!countdownEl || !elapsedEl) return;
+
+      const timeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(timeZone);
+
+      const promoStart = Temporal.ZonedDateTime.from({
+        timeZone,
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0
+      });
+
+      const promoEnd = Temporal.ZonedDateTime.from({
+        timeZone,
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0
+      });
+
+      const remainingDuration = now.until(promoEnd, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+        roundingMode: 'trunc'
+      });
+
+      const elapsedDuration = now.since(promoStart, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+        roundingMode: 'trunc'
+      });
+
+      const durationFormatter = typeof Intl !== 'undefined' && Intl.DurationFormat
+        ? new Intl.DurationFormat('en-US', { style: 'long' })
+        : null;
+
+      if (Temporal.ZonedDateTime.compare(now, promoEnd) >= 0) {
+        countdownEl.textContent = 'Offer ended (0 days, 0 hours left)';
+      } else {
+        const formattedRemaining = durationFormatter
+          ? durationFormatter.format({ days: remainingDuration.days, hours: remainingDuration.hours })
+          : `${remainingDuration.days} days, ${remainingDuration.hours} hours`;
+        countdownEl.textContent = `Offer ends in: ${formattedRemaining} (${remainingDuration.days}d ${remainingDuration.hours}h left)`;
+      }
+
+      const formattedElapsed = durationFormatter
+        ? durationFormatter.format({ days: elapsedDuration.days, hours: elapsedDuration.hours })
+        : `${elapsedDuration.days} days, ${elapsedDuration.hours} hours`;
+      elapsedEl.textContent = `Time elapsed since promo start: ${formattedElapsed}`;
+    }
+
+    document.addEventListener('DOMContentLoaded', updateMaplePromoTimer);
+  </script>
