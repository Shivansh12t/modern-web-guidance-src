+  <script type="module">
+    const carousel = document.querySelector('.carousel');
+    if (carousel) {
+      const track = carousel.querySelector('.carousel-track');
+      const slides = Array.from(track.children);
+      const prevBtn = carousel.querySelector('[data-direction="previous"]');
+      const nextBtn = carousel.querySelector('[data-direction="next"]');
+      const markersNav = carousel.querySelector('.carousel-markers');
+      const statusRegion = carousel.querySelector('[role="status"]');
+
+      const canLoop =
+        slides.length >= 3 &&
+        typeof CSS !== 'undefined' &&
+        CSS.supports &&
+        CSS.supports('order', 'sibling-index()');
+
+      // Build marker buttons from slide data-marker-name attributes
+      const markers = slides.map((slide, index) => {
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        const markerName = slide.dataset.markerName || `Go to slide ${index + 1}`;
+        btn.setAttribute('aria-label', markerName);
+        btn.addEventListener('click', () => {
+          scrollToSlide(slide);
+        });
+        markersNav.appendChild(btn);
+        return btn;
+      });
+
+      let activeMarkerIndex = -1;
+      let settledSlideIndex = -1;
+      let pendingTarget = null;
+      let scrollGeneration = 0;
+      let settledScrollGeneration = 0;
+      let rafId = 0;
+      let settleTimer = 0;
+
+      function getSlideCenterOffset(slide) {
+        const trackCenter = track.scrollLeft + track.clientWidth / 2;
+        const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
+        return slideCenter - trackCenter;
+      }
+
+      function getVisualSlides() {
+        return slides
+          .slice()
+          .sort((a, b) => a.offsetLeft - b.offsetLeft);
+      }
+
+      function getNearestSlide() {
+        let nearest = slides[0];
+        let minDistance = Infinity;
+        for (const slide of slides) {
+          const distance = Math.abs(getSlideCenterOffset(slide));
+          if (distance < minDistance) {
+            minDistance = distance;
+            nearest = slide;
+          }
+        }
+        return nearest;
+      }
+
+      function setActiveMarker(index) {
+        if (index === activeMarkerIndex) return;
+        if (activeMarkerIndex >= 0 && markers[activeMarkerIndex]) {
+          markers[activeMarkerIndex].removeAttribute('aria-current');
+        }
+        activeMarkerIndex = index;
+        if (markers[index]) {
+          markers[index].setAttribute('aria-current', 'true');
+        }
+      }
+
+      function disableButtonWithFocusRedirect(btn, shouldDisable, fallbackBtn) {
+        if (shouldDisable && !btn.disabled && document.activeElement === btn) {
+          btn.disabled = true;
+          if (fallbackBtn && !fallbackBtn.disabled) {
+            fallbackBtn.focus();
+          }
+        } else {
+          btn.disabled = shouldDisable;
+        }
+      }
+
+      function updateParkingAndButtons(currentSlide) {
+        const domIndex = slides.indexOf(currentSlide);
+
+        if (canLoop) {
+          const prevOffset = currentSlide.offsetLeft;
+          const prevOrderFirst = getComputedStyle(slides[0]).order;
+          const prevOrderLast = getComputedStyle(slides[slides.length - 1]).order;
+
+          track.style.setProperty('--current', String(domIndex));
+
+          const nextOrderFirst = getComputedStyle(slides[0]).order;
+          const nextOrderLast = getComputedStyle(slides[slides.length - 1]).order;
+
+          if (prevOrderFirst !== nextOrderFirst || prevOrderLast !== nextOrderLast) {
+            const newOffset = currentSlide.offsetLeft;
+            const delta = newOffset - prevOffset;
+            if (delta !== 0) {
+              track.style.scrollSnapType = 'none';
+              track.style.overflowX = 'hidden';
+              track.scrollBy({ left: delta, behavior: 'instant' });
+              track.style.scrollSnapType = '';
+              requestAnimationFrame(() => {
+                requestAnimationFrame(() => {
+                  track.style.overflowX = '';
+                });
+              });
+            }
+          }
+
+          prevBtn.disabled = false;
+          nextBtn.disabled = false;
+        } else {
+          const visualSlides = getVisualSlides();
+          const visualIndex = visualSlides.indexOf(currentSlide);
+          const atStart = visualIndex <= 0;
+          const atEnd = visualIndex >= visualSlides.length - 1;
+
+          disableButtonWithFocusRedirect(prevBtn, atStart, nextBtn);
+          disableButtonWithFocusRedirect(nextBtn, atEnd, prevBtn);
+        }
+      }
+
+      function onScrollSettled(isInitial = false) {
+        if (!isInitial && settledScrollGeneration < scrollGeneration) {
+          settledScrollGeneration = scrollGeneration;
+        }
+
+        pendingTarget = null;
+        const currentSlide = getNearestSlide();
+        const domIndex = slides.indexOf(currentSlide);
+
+        setActiveMarker(domIndex);
+        updateParkingAndButtons(currentSlide);
+
+        if (isInitial) {
+          settledSlideIndex = domIndex;
+        } else if (domIndex !== settledSlideIndex) {
+          settledSlideIndex = domIndex;
+          statusRegion.textContent = `Slide ${domIndex + 1} of ${slides.length}`;
+        }
+      }
+
+      function scrollToSlide(targetSlide) {
+        if (!targetSlide) return;
+        const targetIndex = slides.indexOf(targetSlide);
+        pendingTarget = targetSlide;
+        scrollGeneration += 1;
+        const currentGeneration = scrollGeneration;
+        setActiveMarker(targetIndex);
+
+        const offset = getSlideCenterOffset(targetSlide);
+        if (Math.abs(offset) < 1) {
+          onScrollSettled(false);
+          return;
+        }
+
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        track.scrollBy({
+          left: offset,
+          behavior: prefersReducedMotion ? 'instant' : 'smooth'
+        });
+
+        // If scrollend is not supported, debounce will catch it; if instant scroll, settle after a frame
+        if (prefersReducedMotion) {
+          requestAnimationFrame(() => {
+            if (scrollGeneration === currentGeneration) {
+              onScrollSettled(false);
+            }
+          });
+        }
+      }
+
+      prevBtn.addEventListener('click', () => {
+        const visualSlides = getVisualSlides();
+        const baseSlide = pendingTarget || getNearestSlide();
+        const currentVisualIndex = visualSlides.indexOf(baseSlide);
+        const prevSlide = visualSlides[currentVisualIndex - 1];
+        if (prevSlide) {
+          scrollToSlide(prevSlide);
+        } else if (canLoop) {
+          scrollToSlide(visualSlides[visualSlides.length - 1]);
+        }
+      });
+
+      nextBtn.addEventListener('click', () => {
+        const visualSlides = getVisualSlides();
+        const baseSlide = pendingTarget || getNearestSlide();
+        const currentVisualIndex = visualSlides.indexOf(baseSlide);
+        const nextSlide = visualSlides[currentVisualIndex + 1];
+        if (nextSlide) {
+          scrollToSlide(nextSlide);
+        } else if (canLoop) {
+          scrollToSlide(visualSlides[0]);
+        }
+      });
+
+      // Throttled live marker update during manual scroll
+      track.addEventListener('scroll', () => {
+        if (!pendingTarget && !rafId) {
+          rafId = requestAnimationFrame(() => {
+            rafId = 0;
+            if (!pendingTarget) {
+              const nearest = getNearestSlide();
+              setActiveMarker(slides.indexOf(nearest));
+            }
+          });
+        }
+
+        if (!('onscrollend' in window)) {
+          clearTimeout(settleTimer);
+          const expectedGen = scrollGeneration;
+          settleTimer = setTimeout(() => {
+            if (scrollGeneration === expectedGen) {
+              onScrollSettled(false);
+            }
+          }, 150);
+        }
+      }, { passive: true });
+
+      if ('onscrollend' in window) {
+        track.addEventListener('scrollend', () => {
+          const genAtEvent = scrollGeneration;
+          // Ignore a scrollend that arrives after a subsequent scroll has already been initiated
+          requestAnimationFrame(() => {
+            if (scrollGeneration === genAtEvent) {
+              onScrollSettled(false);
+            }
+          });
+        });
+      }
+
+      // Initial sync on load (keeping polite status region empty)
+      onScrollSettled(true);
+    }
+  </script>
