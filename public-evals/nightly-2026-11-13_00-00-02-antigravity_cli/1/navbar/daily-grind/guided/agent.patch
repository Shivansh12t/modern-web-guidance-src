+      // Remeasure while inline on every notification, but while collapsed only when the header's width has grown
+      if (isWide || currentWidth > lastHeaderWidth) {
+        updateNavigationLayout();
+      }
+      lastHeaderWidth = currentWidth;
+    });
+
+    resizeObserver.observe(header);
+    resizeObserver.observe(siteMenu);
+
+    // Submenu interaction: narrow inline disclosure vs. wide popover with hover preview
+    const hoverMedia = window.matchMedia("(hover: hover)");
+
+    submenu.addEventListener("toggle", (event) => {
+      if (!header.classList.contains("is-wide")) return;
+      const isOpen = event.newState === "open";
+      submenuTrigger.setAttribute("aria-expanded", String(isOpen));
+      if (!isOpen) {
+        isPreviewingSubmenu = false;
+      }
+
+      // Fallback positioning when CSS Anchor Positioning (position-area) is unsupported
+      if (isOpen && !CSS.supports("position-area", "block-end")) {
+        const triggerRect = submenuTrigger.getBoundingClientRect();
+        const size = submenu.getBoundingClientRect();
+        let top = triggerRect.bottom + 8;
+        if (top + size.height > window.innerHeight) {
+          top = Math.max(8, triggerRect.top - size.height - 8);
+        }
+        const left = Math.min(
+          Math.max(8, triggerRect.left),
+          Math.max(8, window.innerWidth - size.width - 8)
+        );
+        submenu.style.top = `${top}px`;
+        submenu.style.left = `${left}px`;
+      }
+    });
+
+    submenuTrigger.addEventListener("click", (event) => {
+      if (!header.classList.contains("is-wide")) {
+        // Narrow layout: toggle hidden and aria-expanded
+        const willExpand = submenu.hidden;
+        submenu.hidden = !willExpand;
+        submenuTrigger.setAttribute("aria-expanded", String(willExpand));
+        return;
+      }
+
+      // Wide layout: if currently hover-previewed, pin open instead of toggling closed
+      if (isPreviewingSubmenu) {
+        isPreviewingSubmenu = false;
+        event.preventDefault();
+      }
+    });
+
+    dropdownItem.addEventListener("pointerenter", (event) => {
+      if (
+        !header.classList.contains("is-wide") ||
+        !hoverMedia.matches ||
+        event.pointerType === "touch"
+      ) {
+        return;
+      }
+      const isOpen = submenu.matches(":is(:popover-open, .\\:popover-open)");
+      if (!isOpen) {
+        isPreviewingSubmenu = true;
+        submenu.showPopover?.({ source: submenuTrigger });
+      }
+    });
+
+    dropdownItem.addEventListener("pointerleave", (event) => {
+      if (
+        !header.classList.contains("is-wide") ||
+        event.pointerType === "touch" ||
+        !isPreviewingSubmenu
+      ) {
+        return;
+      }
+      isPreviewingSubmenu = false;
+      submenu.hidePopover?.();
+    });
+
+    dropdownItem.addEventListener("focusout", (event) => {
+      if (!header.classList.contains("is-wide")) return;
+      if (event.relatedTarget && !dropdownItem.contains(event.relatedTarget)) {
+        isPreviewingSubmenu = false;
+        if (submenu.matches(":is(:popover-open, .\\:popover-open)")) {
+          submenu.hidePopover?.();
+        }
+      }
+    });
+  </script>
+
 </body>
 
