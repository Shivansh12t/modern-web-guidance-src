+  <script>
+    (function () {
+      const nav = document.querySelector('nav[aria-label="Primary"]');
+      const menuToggle = nav.querySelector('.menu-toggle');
+      const navList = document.getElementById('primary-nav-list');
+      const submenuItem = nav.querySelector('.has-submenu');
+      const submenuToggle = nav.querySelector('.submenu-toggle');
+      const navLinks = nav.querySelectorAll('.nav-link');
+
+      // Toggle mobile navigation drawer
+      function setMobileNavOpen(isOpen) {
+        menuToggle.setAttribute('aria-expanded', String(isOpen));
+        navList.classList.toggle('nav-open', isOpen);
+        if (!isOpen) {
+          setSubmenuOpen(false);
+        }
+      }
+
+      // Toggle Menu submenu
+      function setSubmenuOpen(isOpen) {
+        submenuToggle.setAttribute('aria-expanded', String(isOpen));
+        submenuItem.classList.toggle('submenu-open', isOpen);
+      }
+
+      menuToggle.addEventListener('click', function () {
+        const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
+        setMobileNavOpen(!isExpanded);
+      });
+
+      submenuToggle.addEventListener('click', function (e) {
+        e.stopPropagation();
+        const isExpanded = submenuToggle.getAttribute('aria-expanded') === 'true';
+        setSubmenuOpen(!isExpanded);
+      });
+
+      // Active page state management
+      function setActiveLink(targetLink) {
+        navLinks.forEach(function (link) {
+          link.classList.remove('active');
+          link.removeAttribute('aria-current');
+        });
+        submenuItem.classList.remove('active');
+
+        if (targetLink) {
+          targetLink.classList.add('active');
+          targetLink.setAttribute('aria-current', 'page');
+          if (submenuItem.contains(targetLink)) {
+            submenuItem.classList.add('active');
+          }
+        }
+      }
+
+      // Sync active link on initial load based on URL pathname or hash
+      function syncActiveFromLocation() {
+        const currentPath = window.location.pathname;
+        const currentHash = window.location.hash;
+        let matchedLink = null;
+
+        navLinks.forEach(function (link) {
+          const href = link.getAttribute('href');
+          if (href === currentPath || (currentHash && href === currentHash.replace('#', ''))) {
+            matchedLink = link;
+          }
+        });
+
+        if (matchedLink) {
+          setActiveLink(matchedLink);
+        }
+      }
+
+      syncActiveFromLocation();
+
+      // Update active indicator when clicking navigation links
+      navLinks.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          // Update active state immediately and prevent 404 navigation in single-page static setup
+          e.preventDefault();
+          const href = link.getAttribute('href');
+          if (window.history && window.history.pushState) {
+            try {
+              window.history.pushState({}, '', href);
+            } catch (_) {
+              // Ignore pushState restrictions on file:// origins
+            }
+          }
+          setActiveLink(link);
+          setSubmenuOpen(false);
+          if (window.innerWidth <= 768) {
+            setMobileNavOpen(false);
+          }
+        });
+      });
+
+      // Close menus on Escape or clicking outside
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') {
+          if (submenuToggle.getAttribute('aria-expanded') === 'true') {
+            setSubmenuOpen(false);
+            submenuToggle.focus();
+          } else if (menuToggle.getAttribute('aria-expanded') === 'true') {
+            setMobileNavOpen(false);
+            menuToggle.focus();
+          }
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!nav.contains(e.target)) {
+          setSubmenuOpen(false);
+          setMobileNavOpen(false);
+        }
+      });
+
+      // Reset mobile menu state when resizing above mobile breakpoint
+      window.addEventListener('resize', function () {
+        if (window.innerWidth > 768 && menuToggle.getAttribute('aria-expanded') === 'true') {
+          setMobileNavOpen(false);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
