+  <script>
+    (function () {
+      // Confirmation Dialog Logic
+      const openDialogBtn = document.getElementById('open-dialog-btn');
+      const closeDialogBtn = document.getElementById('close-dialog-btn');
+      const logoutDialog = document.getElementById('logout-dialog');
+
+      function openConfirmDialog(event) {
+        if (event) {
+          event.preventDefault();
+        }
+        if (!logoutDialog || logoutDialog.open) return;
+        logoutDialog.classList.remove('is-closing');
+        logoutDialog.showModal();
+      }
+
+      function closeConfirmDialog() {
+        if (!logoutDialog || !logoutDialog.open) return;
+        logoutDialog.classList.add('is-closing');
+        const finishClose = () => {
+          logoutDialog.classList.remove('is-closing');
+          if (logoutDialog.open) {
+            logoutDialog.close();
+          }
+        };
+        let closed = false;
+        const onTransitionEnd = (e) => {
+          if (e.target === logoutDialog && !closed) {
+            closed = true;
+            logoutDialog.removeEventListener('transitionend', onTransitionEnd);
+            finishClose();
+          }
+        };
+        logoutDialog.addEventListener('transitionend', onTransitionEnd);
+        setTimeout(() => {
+          if (!closed) {
+            closed = true;
+            logoutDialog.removeEventListener('transitionend', onTransitionEnd);
+            finishClose();
+          }
+        }, 300);
+      }
+
+      if (openDialogBtn && logoutDialog) {
+        openDialogBtn.addEventListener('click', openConfirmDialog);
+      }
+
+      if (closeDialogBtn && logoutDialog) {
+        closeDialogBtn.addEventListener('click', closeConfirmDialog);
+      }
+
+      if (logoutDialog) {
+        // Close when clicking on the dialog backdrop
+        logoutDialog.addEventListener('click', (event) => {
+          const rect = logoutDialog.getBoundingClientRect();
+          const clickedInDialog =
+            rect.top <= event.clientY &&
+            event.clientY <= rect.top + rect.height &&
+            rect.left <= event.clientX &&
+            event.clientX <= rect.left + rect.width;
+          if (!clickedInDialog) {
+            closeConfirmDialog();
+          }
+        });
+
+        // Smooth exit on Escape key
+        logoutDialog.addEventListener('cancel', (event) => {
+          event.preventDefault();
+          closeConfirmDialog();
+        });
+      }
+
+      // Dismissible Informational Floating Notice Logic
+      const noticeTriggerBtn = document.getElementById('foobar');
+      const infoNotice = document.getElementById('info-notice');
+      const dismissNoticeBtn = document.getElementById('dismiss-notice-btn');
+      const supportsPopover = infoNotice && typeof infoNotice.showPopover === 'function';
+
+      function isNoticeOpen() {
+        if (!infoNotice) return false;
+        if (supportsPopover && infoNotice.matches(':popover-open')) return true;
+        return infoNotice.classList.contains('is-visible');
+      }
+
+      function showNotice() {
+        if (!infoNotice) return;
+        infoNotice.classList.remove('is-closing');
+        if (supportsPopover) {
+          try {
+            infoNotice.showPopover();
+          } catch (_) {
+            // Ignore if already open
+          }
+        }
+        infoNotice.classList.add('is-visible');
+      }
+
+      function hideNotice() {
+        if (!infoNotice || !isNoticeOpen()) return;
+        infoNotice.classList.add('is-closing');
+        infoNotice.classList.remove('is-visible');
+
+        const finishHide = () => {
+          infoNotice.classList.remove('is-closing');
+          if (supportsPopover && infoNotice.matches(':popover-open')) {
+            try {
+              infoNotice.hidePopover();
+            } catch (_) {
+              // Ignore if already hidden
+            }
+          }
+        };
+
+        let hidden = false;
+        const onTransitionEnd = (e) => {
+          if (e.target === infoNotice && !hidden) {
+            hidden = true;
+            infoNotice.removeEventListener('transitionend', onTransitionEnd);
+            finishHide();
+          }
+        };
+        infoNotice.addEventListener('transitionend', onTransitionEnd);
+        setTimeout(() => {
+          if (!hidden) {
+            hidden = true;
+            infoNotice.removeEventListener('transitionend', onTransitionEnd);
+            finishHide();
+          }
+        }, 300);
+      }
+
+      if (noticeTriggerBtn && infoNotice) {
+        noticeTriggerBtn.addEventListener('click', (event) => {
+          event.preventDefault();
+          if (isNoticeOpen() && !infoNotice.classList.contains('is-closing')) {
+            hideNotice();
+          } else {
+            showNotice();
+          }
+        });
+      }
+
+      if (dismissNoticeBtn && infoNotice) {
+        dismissNoticeBtn.addEventListener('click', (event) => {
+          event.preventDefault();
+          hideNotice();
+        });
+      }
+    })();
+  </script>
+
