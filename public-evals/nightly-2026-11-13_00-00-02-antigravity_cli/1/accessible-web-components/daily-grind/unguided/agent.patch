+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorited', 'active', 'checked', 'drink'];
+      }
+
+      constructor() {
+        super();
+        this._favorited = false;
+        this._syncing = false;
+        this.attachShadow({ mode: 'open' });
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+            }
+            button {
+              appearance: none;
+              background: #fff8f0;
+              border: 1px solid #d7ccc8;
+              border-radius: 999px;
+              width: 36px;
+              height: 36px;
+              padding: 0;
+              display: inline-flex;
+              align-items: center;
+              justify-content: center;
+              cursor: pointer;
+              color: #8d6e63;
+              transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
+            }
+            button:hover {
+              border-color: #ffab40;
+              color: #e65100;
+              transform: scale(1.06);
+            }
+            button:focus-visible {
+              outline: 2px solid #ffab40;
+              outline-offset: 2px;
+            }
+            button[aria-pressed="true"] {
+              background: #fff3e0;
+              border-color: #ffab40;
+              color: #d84315;
+            }
+            svg {
+              width: 18px;
+              height: 18px;
+              fill: transparent;
+              stroke: currentColor;
+              stroke-width: 2;
+              transition: fill 0.2s ease, transform 0.2s ease;
+            }
+            button[aria-pressed="true"] svg {
+              fill: currentColor;
+              transform: scale(1.1);
+            }
+          </style>
+          <button type="button" class="favorite-btn" aria-pressed="false" aria-label="Favorite">
+            <svg viewBox="0 0 24 24" aria-hidden="true">
+              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
+            </svg>
+          </button>
+        `;
+
+        this._button = this.shadowRoot.querySelector('button');
+        this.addEventListener('click', (e) => {
+          e.stopPropagation();
+          this.toggle();
+        });
+      }
+
+      connectedCallback() {
+        const initial =
+          this.hasAttribute('favorited') ||
+          this.hasAttribute('active') ||
+          this.hasAttribute('checked');
+        this._setFavorited(initial, false);
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (this._syncing || oldValue === newValue) return;
+        if (name === 'drink') {
+          this._render();
+          return;
+        }
+        if (name === 'favorited' || name === 'active' || name === 'checked') {
+          const isFav = newValue !== null && newValue !== 'false';
+          this._setFavorited(isFav, false);
+        }
+      }
+
+      get favorited() {
+        return this._favorited;
+      }
+
+      set favorited(val) {
+        this._setFavorited(Boolean(val), false);
+      }
+
+      get active() {
+        return this._favorited;
+      }
+
+      set active(val) {
+        this._setFavorited(Boolean(val), false);
+      }
+
+      get checked() {
+        return this._favorited;
+      }
+
+      set checked(val) {
+        this._setFavorited(Boolean(val), false);
+      }
+
+      get drink() {
+        return this.getAttribute('drink') || '';
+      }
+
+      set drink(val) {
+        this.setAttribute('drink', val);
+      }
+
+      toggle() {
+        this._setFavorited(!this._favorited, true);
+        return this._favorited;
+      }
+
+      _setFavorited(value, emitEvent) {
+        this._favorited = Boolean(value);
+        this._syncing = true;
+        if (this._favorited) {
+          this.setAttribute('favorited', '');
+          this.setAttribute('active', '');
+          this.setAttribute('checked', '');
+        } else {
+          this.removeAttribute('favorited');
+          this.removeAttribute('active');
+          this.removeAttribute('checked');
+        }
+        this.setAttribute('aria-pressed', String(this._favorited));
+        this._render();
+        this._syncing = false;
+
+        if (emitEvent) {
+          const detail = { favorited: this._favorited, drink: this.drink };
+          this.dispatchEvent(new CustomEvent('favorite-change', { detail, bubbles: true, composed: true }));
+          this.dispatchEvent(new CustomEvent('change', { detail, bubbles: true, composed: true }));
+        }
+      }
+
+      _render() {
+        if (!this._button) return;
+        const drinkName = this.drink;
+        const label = drinkName
+          ? (this._favorited ? `Remove ${drinkName} from favorites` : `Mark ${drinkName} as favorite`)
+          : (this._favorited ? 'Remove from favorites' : 'Mark as favorite');
+        this._button.setAttribute('aria-pressed', String(this._favorited));
+        this._button.setAttribute('aria-label', label);
+        this._button.setAttribute('title', label);
+        this._button.classList.toggle('favorited', this._favorited);
+        this._button.classList.toggle('active', this._favorited);
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
