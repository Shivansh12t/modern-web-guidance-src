+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoOffers = [
+      {
+        badge: 'Limited Time',
+        title: 'Pastry Pairing',
+        desc: 'Add a freshly baked croissant to any medium or large brew for just $2.'
+      },
+      {
+        badge: 'Member Exclusive',
+        title: 'Double Bean Points',
+        desc: 'Earn 2x reward points on all whole-bean coffee bags all weekend long.'
+      },
+      {
+        badge: 'Afternoon Pick-Me-Up',
+        title: 'Happy Hour Cold Brew',
+        desc: '50% off all cold brew and iced artisanal lattes between 2 PM and 5 PM.'
+      },
+      {
+        badge: 'Roaster Special',
+        title: 'Single-Origin Flight',
+        desc: 'Sample three seasonal pour-overs side by side at a special tasting price.'
+      }
+    ];
+
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const offer = promoOffers[promoIndex % promoOffers.length];
+      promoIndex++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <span class="promo-badge">${offer.badge}</span>
+        <h3>${offer.title}</h3>
+        <p>${offer.desc}</p>
+        <a href="/rewards" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      let removed = false;
+      const cleanup = () => {
+        if (removed) return;
+        removed = true;
+        lastCard.remove();
+      };
+
+      lastCard.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 400);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const isHidden =
+        toggleCard.classList.contains('is-hidden') ||
+        toggleCard.hasAttribute('hidden') ||
+        getComputedStyle(toggleCard).display === 'none';
+
+      if (isHidden) {
+        toggleCard.removeAttribute('hidden');
+        toggleCard.classList.remove('is-hidden', 'removing');
+        if (!toggleCard.isConnected) {
+          domContainer.prepend(toggleCard);
+        }
+      } else {
+        toggleCard.classList.add('is-hidden');
+      }
+    });
+  </script>
 </body>
 
