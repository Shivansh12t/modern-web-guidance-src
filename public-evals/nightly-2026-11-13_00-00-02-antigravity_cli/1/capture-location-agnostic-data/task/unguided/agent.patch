+  <script>
+    (function () {
+      const STORAGE_KEYS = {
+        pickupTime: 'dailyGrind.pickupReminderPlainTime',
+        anniversaryDate: 'dailyGrind.coffeeAnniversaryPlainDate'
+      };
+
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const savedTimeEl = document.getElementById('saved-pickup-time');
+      const savedDateEl = document.getElementById('saved-anniversary-date');
+
+      /**
+       * Normalizes a wall-clock time string (HH:MM) without attaching any time zone or UTC offset.
+       * Uses Temporal.PlainTime when available, falling back to direct string component parsing.
+       */
+      function toPlainTimeString(rawTime) {
+        if (!rawTime) return '08:00';
+        if (typeof Temporal !== 'undefined' && Temporal.PlainTime) {
+          const plainTime = Temporal.PlainTime.from(rawTime);
+          return (
+            String(plainTime.hour).padStart(2, '0') +
+            ':' +
+            String(plainTime.minute).padStart(2, '0')
+          );
+        }
+        const match = /^(\d{2}):(\d{2})/.exec(rawTime.trim());
+        if (!match) return '08:00';
+        return match[1] + ':' + match[2];
+      }
+
+      /**
+       * Normalizes a calendar date string (YYYY-MM-DD) without attaching any time zone or UTC offset.
+       * Uses Temporal.PlainDate when available, falling back to direct string component parsing.
+       */
+      function toPlainDateString(rawDate) {
+        if (!rawDate) return '2024-03-15';
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          const plainDate = Temporal.PlainDate.from(rawDate);
+          return plainDate.toString();
+        }
+        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(rawDate.trim());
+        if (!match) return '2024-03-15';
+        return match[1] + '-' + match[2] + '-' + match[3];
+      }
+
+      function renderSummary(plainTimeStr, plainDateStr) {
+        savedTimeEl.textContent = plainTimeStr;
+        savedDateEl.textContent = plainDateStr;
+      }
+
+      function loadPreferences() {
+        let storedTime = null;
+        let storedDate = null;
+        try {
+          storedTime = localStorage.getItem(STORAGE_KEYS.pickupTime);
+          storedDate = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+        } catch (_) {
+          // Ignore storage restrictions
+        }
+
+        const plainTimeStr = toPlainTimeString(storedTime || timeInput.value);
+        const plainDateStr = toPlainDateString(storedDate || dateInput.value);
+
+        timeInput.value = plainTimeStr;
+        dateInput.value = plainDateStr;
+        renderSummary(plainTimeStr, plainDateStr);
+      }
+
+      function savePreferences(event) {
+        if (event) event.preventDefault();
+        const plainTimeStr = toPlainTimeString(timeInput.value);
+        const plainDateStr = toPlainDateString(dateInput.value);
+
+        timeInput.value = plainTimeStr;
+        dateInput.value = plainDateStr;
+
+        try {
+          localStorage.setItem(STORAGE_KEYS.pickupTime, plainTimeStr);
+          localStorage.setItem(STORAGE_KEYS.anniversaryDate, plainDateStr);
+        } catch (_) {
+          // Ignore storage restrictions
+        }
+
+        renderSummary(plainTimeStr, plainDateStr);
+      }
+
+      timeInput.addEventListener('change', function () {
+        savePreferences();
+      });
+
+      dateInput.addEventListener('change', function () {
+        savePreferences();
+      });
+
+      form.addEventListener('submit', savePreferences);
+
+      loadPreferences();
+    })();
+  </script>
