+  <script>
+    const STORAGE_KEYS = {
+      reminderTime: 'dailyGrind.pickupReminderTime',
+      anniversaryDate: 'dailyGrind.coffeeAnniversaryDate',
+    };
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+
+      const reminderDisplay = document.getElementById('summary-reminder-display');
+      const reminderIso = document.getElementById('summary-reminder-iso');
+      const anniversaryDisplay = document.getElementById('summary-anniversary-display');
+      const anniversaryIso = document.getElementById('summary-anniversary-iso');
+      const annualDisplay = document.getElementById('summary-annual-display');
+      const annualIso = document.getElementById('summary-annual-iso');
+      const combinedDisplay = document.getElementById('summary-combined-display');
+      const combinedIso = document.getElementById('summary-combined-iso');
+
+      // Restore previously saved PlainTime / PlainDate strings if available
+      const savedTime = localStorage.getItem(STORAGE_KEYS.reminderTime);
+      const savedDate = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+      if (savedTime) {
+        timeInput.value = savedTime;
+      }
+      if (savedDate) {
+        dateInput.value = savedDate;
+      }
+
+      function updateSchedule() {
+        if (!timeInput.value || !dateInput.value) return;
+
+        // 1. Parse wall-clock time and calendar date using Temporal Plain types (no time zone offset)
+        const reminderTime = Temporal.PlainTime.from(timeInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(dateInput.value);
+
+        // 2. Read calendar/clock fields directly from Plain types (no formatToParts needed)
+        const { year, month, day } = anniversaryDate;
+        const { hour, minute } = reminderTime;
+
+        // 3. Model the recurring annual anniversary with Temporal.PlainMonthDay (explicit calendar)
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = annualAnniversary.equals(today.toPlainMonthDay());
+
+        // Convert PlainMonthDay to a PlainDate with a specific year before date comparisons/arithmetic
+        const thisYearOccurrence = annualAnniversary.toPlainDate({ year: today.year });
+        const nextCelebrationDate =
+          Temporal.PlainDate.compare(thisYearOccurrence, today) < 0
+            ? annualAnniversary.toPlainDate({ year: today.year + 1 })
+            : thisYearOccurrence;
+
+        // 4. Combine PlainDate and PlainTime into a location-agnostic PlainDateTime without string interpolation
+        const celebrationPickup = nextCelebrationDate.toPlainDateTime(reminderTime);
+
+        // 5. Display without time zone conversion so values remain identical across time zones
+        reminderDisplay.textContent = `${reminderTime.toLocaleString(undefined, {
+          hour: '2-digit',
+          minute: '2-digit',
+        })} (every day at ${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')} local wall-clock time)`;
+        reminderIso.textContent = reminderTime.toString();
+
+        anniversaryDisplay.textContent = `${anniversaryDate.toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+        })} (Year: ${year}, Month: ${month}, Day: ${day})`;
+        anniversaryIso.textContent = anniversaryDate.toString();
+
+        annualDisplay.textContent = isAnniversaryToday
+          ? `Today is your Coffee Anniversary! (${annualAnniversary.toLocaleString(undefined, { month: 'long', day: 'numeric' })})`
+          : `Celebrated annually on ${annualAnniversary.toLocaleString(undefined, {
+              month: 'long',
+              day: 'numeric',
+            })} (next on ${nextCelebrationDate.toString()})`;
+        annualIso.textContent = annualAnniversary.toString();
+
+        combinedDisplay.textContent = celebrationPickup.toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'short',
+          day: 'numeric',
+          hour: '2-digit',
+          minute: '2-digit',
+        });
+        combinedIso.textContent = celebrationPickup.toString();
+
+        // Persist canonical ISO strings (without time zone offsets)
+        localStorage.setItem(
+          STORAGE_KEYS.reminderTime,
+          `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`
+        );
+        localStorage.setItem(STORAGE_KEYS.anniversaryDate, anniversaryDate.toString());
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        updateSchedule();
+      });
+
+      timeInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('change', updateSchedule);
+
+      updateSchedule();
+    }
+
+    // Check if Temporal is supported natively; dynamically load temporal-polyfill if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
+
