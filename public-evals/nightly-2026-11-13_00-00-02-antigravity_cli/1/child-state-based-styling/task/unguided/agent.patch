+  <script>
+    document.querySelectorAll('.iced-checkbox').forEach((checkbox) => {
+      const updateCardState = () => {
+        const card = checkbox.closest('.card');
+        if (!card) return;
+        const isChecked = checkbox.checked;
+        card.classList.toggle('is-iced', isChecked);
+        const heading = card.querySelector('h3[data-base-title]');
+        if (heading) {
+          const baseTitle = heading.getAttribute('data-base-title');
+          heading.textContent = isChecked ? `Iced ${baseTitle}` : baseTitle;
+        }
+      };
+      checkbox.addEventListener('change', updateCardState);
+      updateCardState();
+    });
+  </script>
