+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        price: 5.50,
+        calories: '190 kcal',
+        notes: 'Toasted Oat, Caramel, Warm Maple',
+        description: 'Creamy steamed oat milk blended with rich espresso and pure Vermont grade-A maple syrup.',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=240&q=80',
+        alt: 'Latte art in a ceramic cup',
+        defaults: { size: 'medium', milk: 'oat', temperature: 'hot', quantity: '1', notes: '' }
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        price: 3.75,
+        calories: '15 kcal',
+        notes: 'Dark Chocolate, Smokey Cedar, Molasses',
+        description: 'Bold, smokey double-shot pulled from freshly ground single-origin Sumatra dark roast beans.',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=240&q=80',
+        alt: 'Fresh shot of dark roast espresso',
+        defaults: { size: 'small', milk: 'none', temperature: 'hot', quantity: '1', notes: '' }
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        price: 4.75,
+        calories: '25 kcal',
+        notes: 'Smooth Cocoa, Toffee, Low Acidity',
+        description: 'Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for maximum smoothness.',
+        image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=240&q=80',
+        alt: 'Iced cold brew coffee in a glass',
+        defaults: { size: 'medium', milk: 'none', temperature: 'iced', quantity: '1', notes: '' }
+      }
+    };
+
+    const SIZE_UPCHARGE = { small: -0.50, medium: 0, large: 0.75 };
+
+    const dialog = document.getElementById('drink-order-dialog');
+    const form = document.getElementById('drink-order-form');
+    const drinkSelect = document.getElementById('order-drink-select');
+    const sizeSelect = document.getElementById('order-size');
+    const milkSelect = document.getElementById('order-milk');
+    const quantityInput = document.getElementById('order-quantity');
+    const notesInput = document.getElementById('order-notes');
+    const titleEl = document.getElementById('dialog-drink-title');
+    const descEl = document.getElementById('dialog-drink-desc');
+    const tagsEl = document.getElementById('dialog-drink-tags');
+    const imgEl = document.getElementById('dialog-drink-img');
+    const submitBtn = document.getElementById('submit-order-btn');
+    const discardBtn = document.getElementById('discard-changes-btn');
+    const unsavedMsg = document.getElementById('unsaved-changes-msg');
+
+    let isDirty = false;
+    let initialSnapshot = '';
+
+    function getFormSnapshot() {
+      const data = new FormData(form);
+      return JSON.stringify(Object.fromEntries(data.entries()));
+    }
+
+    function updateDisplayAndPrice() {
+      const drinkKey = drinkSelect.value;
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      const size = sizeSelect.value;
+      const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+      const unitPrice = drink.price + (SIZE_UPCHARGE[size] || 0);
+      const total = (unitPrice * qty).toFixed(2);
+
+      titleEl.textContent = drink.name;
+      descEl.textContent = drink.description;
+      tagsEl.textContent = `$${unitPrice.toFixed(2)} • ${drink.calories} • Notes: ${drink.notes}`;
+      imgEl.src = drink.image;
+      imgEl.alt = drink.alt;
+      submitBtn.textContent = `Add to Order ($${total})`;
+    }
+
+    function setDirtyState(dirty) {
+      isDirty = dirty;
+      dialog.setAttribute('closedby', dirty ? 'none' : 'any');
+      if (!dirty) {
+        unsavedMsg.classList.remove('is-visible');
+        discardBtn.hidden = true;
+      }
+    }
+
+    function promptDiscardConfirmation() {
+      unsavedMsg.classList.add('is-visible');
+      discardBtn.hidden = false;
+      discardBtn.focus();
+    }
+
+    function populateDrinkModal(drinkKey, applyDefaults = true) {
+      const key = DRINKS[drinkKey] ? drinkKey : 'maple-oat-latte';
+      const drink = DRINKS[key];
+      drinkSelect.value = key;
+
+      if (applyDefaults) {
+        sizeSelect.value = drink.defaults.size;
+        milkSelect.value = drink.defaults.milk;
+        const tempRadio = form.querySelector(`input[name="temperature"][value="${drink.defaults.temperature}"]`);
+        if (tempRadio) tempRadio.checked = true;
+        quantityInput.value = drink.defaults.quantity;
+        notesInput.value = drink.defaults.notes;
+      }
+
+      updateDisplayAndPrice();
+    }
+
+    function openDrinkModal(drinkKey) {
+      populateDrinkModal(drinkKey, true);
+      initialSnapshot = getFormSnapshot();
+      setDirtyState(false);
+      if (!dialog.open) {
+        dialog.showModal();
+      }
+    }
+
+    document.querySelectorAll('[data-drink]').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        openDrinkModal(trigger.dataset.drink);
+      });
+    });
+
+    form.addEventListener('input', (event) => {
+      if (event.target === drinkSelect) {
+        populateDrinkModal(drinkSelect.value, false);
+      } else {
+        updateDisplayAndPrice();
+      }
+      setDirtyState(getFormSnapshot() !== initialSnapshot);
+    });
+
+    form.addEventListener('change', () => {
+      updateDisplayAndPrice();
+      setDirtyState(getFormSnapshot() !== initialSnapshot);
+    });
+
+    dialog.addEventListener('cancel', (event) => {
+      if (isDirty) {
+        event.preventDefault();
+        promptDiscardConfirmation();
+      }
+    });
+
+    document.querySelectorAll('[command="request-close"]').forEach((btn) => {
+      btn.addEventListener('click', (event) => {
+        if (isDirty) {
+          event.preventDefault();
+          promptDiscardConfirmation();
+        } else if (!('commandForElement' in HTMLButtonElement.prototype) && typeof dialog.requestClose !== 'function') {
+          dialog.close();
+        }
+      });
+    });
+
+    discardBtn.addEventListener('click', () => {
+      setDirtyState(false);
+      if (dialog.open) {
+        dialog.close('discard');
+      }
+    });
+
+    dialog.addEventListener('close', () => {
+      dialog.returnValue = '';
+      setDirtyState(false);
+    });
+
+    // Fallback for browsers without closedby support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      dialog.addEventListener('click', (event) => {
+        if (event.target !== dialog) return;
+
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+
+        if (isDialogContent) return;
+
+        if (isDirty) {
+          promptDiscardConfirmation();
+          return;
+        }
+
+        dialog.close();
+      });
+    } else {
+      dialog.addEventListener('click', (event) => {
+        if (!isDirty || event.target !== dialog) return;
+
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+
+        if (!isDialogContent) {
+          promptDiscardConfirmation();
+        }
+      });
+    }
+  </script>
+
 </body>
 
