+  <script>
+    (function () {
+      const DRINKS = {
+        'Maple Oat Latte': {
+          name: 'Maple Oat Latte',
+          category: 'Seasonal Favorite',
+          basePrice: 5.50,
+          calories: '210 kcal',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, paired with our signature double-shot espresso and a light dusting of cinnamon.',
+          tastingNotes: 'Warm Maple, Toasted Oat, Smooth Espresso',
+          image: 'https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=600&q=80',
+          defaultMilk: 'Oat Milk',
+          defaultTemp: 'Hot',
+          defaultSize: 'Medium'
+        },
+        'Dark Roast Espresso': {
+          name: 'Dark Roast Espresso',
+          category: 'Espresso Classics',
+          basePrice: 3.75,
+          calories: '15 kcal',
+          description: 'Bold, smokey, and perfect for a morning boost. Slowly roasted single-origin beans delivering a rich crema and deep dark-chocolate finish.',
+          tastingNotes: 'Dark Chocolate, Smokey Cedar, Molasses',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80',
+          defaultMilk: 'None',
+          defaultTemp: 'Hot',
+          defaultSize: 'Medium'
+        },
+        'Cold Brew': {
+          name: 'Cold Brew',
+          category: 'Cold Coffee',
+          basePrice: 4.75,
+          calories: '25 kcal',
+          description: 'Steeped for 18 hours for maximum smoothness. Coarse-ground artisanal beans filtered cold for a naturally sweet, low-acid refreshment.',
+          tastingNotes: 'Caramel, Roasted Hazelnut, Crisp Finish',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=80',
+          defaultMilk: 'None',
+          defaultTemp: 'Iced',
+          defaultSize: 'Medium'
+        }
+      };
+
+      const SIZE_UPCHARGE = {
+        Small: 0,
+        Medium: 0.75,
+        Large: 1.25
+      };
+
+      const backdrop = document.getElementById('modal-backdrop');
+      const modal = document.getElementById('drink-modal');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const discardBanner = document.getElementById('discard-banner');
+      const discardMessage = document.getElementById('discard-message');
+      const discardBtn = document.getElementById('discard-changes-btn');
+      const orderForm = document.getElementById('order-form');
+      const orderStatus = document.getElementById('order-status');
+
+      const titleEl = document.getElementById('modal-title');
+      const categoryEl = document.getElementById('modal-category');
+      const imageEl = document.getElementById('modal-image');
+      const descEl = document.getElementById('modal-description');
+      const basePriceEl = document.getElementById('modal-base-price');
+      const caloriesEl = document.getElementById('modal-calories');
+      const notesEl = document.getElementById('modal-tasting-notes');
+      const totalPriceEl = document.getElementById('modal-total-price');
+
+      const drinkSelect = document.getElementById('order-drink');
+      const sizeSelect = document.getElementById('order-size');
+      const milkSelect = document.getElementById('order-milk');
+      const quantityInput = document.getElementById('order-quantity');
+      const notesInput = document.getElementById('order-notes');
+
+      let isModalOpen = false;
+      let hasUnsavedChanges = false;
+      let lastTrigger = null;
+
+      function renderDrinkDetails(drinkName) {
+        const drink = DRINKS[drinkName] || DRINKS['Maple Oat Latte'];
+        titleEl.textContent = drink.name;
+        categoryEl.textContent = drink.category;
+        imageEl.src = drink.image;
+        imageEl.alt = drink.name;
+        descEl.textContent = drink.description;
+        basePriceEl.textContent = '$' + drink.basePrice.toFixed(2);
+        caloriesEl.textContent = drink.calories;
+        notesEl.textContent = drink.tastingNotes;
+      }
+
+      function updateTotalPrice() {
+        const drink = DRINKS[drinkSelect.value] || DRINKS['Maple Oat Latte'];
+        const sizeExtra = SIZE_UPCHARGE[sizeSelect.value] || 0;
+        let addonsExtra = 0;
+        const checkedAddons = orderForm.querySelectorAll('input[type="checkbox"]:checked');
+        checkedAddons.forEach((box) => {
+          addonsExtra += parseFloat(box.value || '0');
+        });
+        const qty = Math.max(1, parseInt(quantityInput.value || '1', 10) || 1);
+        const total = (drink.basePrice + sizeExtra + addonsExtra) * qty;
+        totalPriceEl.textContent = '$' + total.toFixed(2);
+      }
+
+      function resetFormForDrink(drinkName) {
+        const drink = DRINKS[drinkName] || DRINKS['Maple Oat Latte'];
+        drinkSelect.value = drink.name;
+        sizeSelect.value = drink.defaultSize;
+        milkSelect.value = drink.defaultMilk;
+        quantityInput.value = '1';
+        notesInput.value = '';
+
+        const tempRadios = orderForm.querySelectorAll('input[name="temperature"]');
+        tempRadios.forEach((radio) => {
+          radio.checked = radio.value === drink.defaultTemp;
+        });
+
+        const addonBoxes = orderForm.querySelectorAll('input[type="checkbox"]');
+        addonBoxes.forEach((box) => {
+          box.checked = false;
+        });
+
+        renderDrinkDetails(drink.name);
+        updateTotalPrice();
+      }
+
+      function markOptionsChanged() {
+        hasUnsavedChanges = true;
+        discardBanner.hidden = false;
+        orderStatus.hidden = true;
+        modal.setAttribute('data-dirty', 'true');
+        updateTotalPrice();
+      }
+
+      function openModal(drinkName, triggerEl) {
+        lastTrigger = triggerEl || document.activeElement;
+        hasUnsavedChanges = false;
+        isModalOpen = true;
+        discardBanner.hidden = true;
+        discardBanner.classList.remove('warning-active');
+        orderStatus.hidden = true;
+        modal.removeAttribute('data-dirty');
+
+        resetFormForDrink(drinkName);
+
+        backdrop.hidden = false;
+        modal.setAttribute('open', '');
+        document.body.classList.add('modal-open');
+        closeBtn.focus();
+      }
+
+      function closeModal() {
+        hasUnsavedChanges = false;
+        isModalOpen = false;
+        discardBanner.hidden = true;
+        discardBanner.classList.remove('warning-active');
+        orderStatus.hidden = true;
+        modal.removeAttribute('data-dirty');
+        modal.removeAttribute('open');
+        backdrop.hidden = true;
+        document.body.classList.remove('modal-open');
+
+        if (lastTrigger && typeof lastTrigger.focus === 'function') {
+          lastTrigger.focus();
+        }
+      }
+
+      function attemptDismiss(event) {
+        if (event) {
+          event.preventDefault();
+          event.stopPropagation();
+        }
+        if (!isModalOpen) return;
+
+        if (hasUnsavedChanges) {
+          discardBanner.hidden = false;
+          discardBanner.classList.add('warning-active');
+          discardMessage.textContent = 'You have unsaved order changes. Confirm with "Discard changes" to close this dialog.';
+          discardBtn.focus();
+          return;
+        }
+
+        closeModal();
+      }
+
+      // Attach listeners to trigger buttons ("Order Now" and "View Details")
+      document.querySelectorAll('[data-drink]').forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          const drinkName = btn.getAttribute('data-drink') || 'Maple Oat Latte';
+          openModal(drinkName, btn);
+        });
+      });
+
+      // Track order option changes
+      drinkSelect.addEventListener('change', () => {
+        renderDrinkDetails(drinkSelect.value);
+        markOptionsChanged();
+      });
+
+      orderForm.addEventListener('input', (event) => {
+        if (event.target && event.target.id !== 'order-drink') {
+          markOptionsChanged();
+        }
+      });
+
+      orderForm.addEventListener('change', (event) => {
+        if (event.target && event.target.id !== 'order-drink') {
+          markOptionsChanged();
+        }
+      });
+
+      // Dismiss handlers (blocked when hasUnsavedChanges is true)
+      closeBtn.addEventListener('click', attemptDismiss);
+      cancelBtn.addEventListener('click', attemptDismiss);
+
+      backdrop.addEventListener('click', (event) => {
+        if (event.target === backdrop) {
+          attemptDismiss(event);
+        }
+      });
+
+      modal.addEventListener('cancel', attemptDismiss);
+
+      document.addEventListener('keydown', (event) => {
+        if (isModalOpen && event.key === 'Escape') {
+          attemptDismiss(event);
+        }
+      });
+
+      // Confirm discarding changes
+      discardBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        closeModal();
+      });
+
+      // Form submit handler (shows confirmation inside dialog without bypassing discard requirement)
+      orderForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const drink = DRINKS[drinkSelect.value] || DRINKS['Maple Oat Latte'];
+        const qty = Math.max(1, parseInt(quantityInput.value || '1', 10) || 1);
+        orderStatus.textContent = 'Added ' + qty + 'x ' + sizeSelect.value + ' ' + drink.name + ' (' + totalPriceEl.textContent + ') to your order!';
+        orderStatus.hidden = false;
+      });
+    })();
+  </script>
 </body>
 
