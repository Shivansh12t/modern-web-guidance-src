+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryBox = document.getElementById('journal-summary');
+    const summaryContent = document.getElementById('journal-summary-content');
+    const journalTextEl = document.getElementById('journal-text');
+
+    function renderBulletPoints(text) {
+      const lines = text
+        .split(/\r?\n/)
+        .map((line) => line.trim())
+        .filter(Boolean);
+
+      const bulletItems = [];
+      for (const line of lines) {
+        const cleaned = line
+          .replace(/^([*\-•+]|\d+[.)])\s*/, '')
+          .replace(/\*\*(.*?)\*\*/g, '$1')
+          .trim();
+        if (cleaned) {
+          bulletItems.push(cleaned);
+        }
+      }
+
+      summaryContent.innerHTML = '';
+      if (bulletItems.length > 0) {
+        const ul = document.createElement('ul');
+        for (const item of bulletItems) {
+          const li = document.createElement('li');
+          li.textContent = item;
+          ul.appendChild(li);
+        }
+        summaryContent.appendChild(ul);
+      } else {
+        const p = document.createElement('p');
+        p.textContent = text;
+        summaryContent.appendChild(p);
+      }
+    }
+
+    function showStatus(message, isError = false) {
+      summaryBox.classList.add('visible');
+      summaryContent.innerHTML = '';
+      const p = document.createElement('p');
+      p.className = isError ? 'summary-status summary-error' : 'summary-status';
+      p.textContent = message;
+      summaryContent.appendChild(p);
+    }
+
+    async function summarizeWithNativeAI(sourceText) {
+      const summarizerOptions = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        sharedContext: 'An artisanal coffee roaster journal article explaining ethical coffee bean sourcing, high-altitude harvesting, processing, and quality standards.',
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (typeof e.loaded === 'number') {
+              const pct = Math.round(e.loaded * 100);
+              showStatus(`Downloading on-device AI model (${pct}%)...`);
+            }
+          });
+        }
+      };
+
+      // 1. Standard Chrome Built-in AI Summarizer API (window.Summarizer)
+      if ('Summarizer' in self && self.Summarizer) {
+        if (typeof self.Summarizer.availability === 'function') {
+          const availability = await self.Summarizer.availability();
+          if (availability === 'unavailable' || availability === 'no') {
+            throw new Error('The browser Summarizer AI model is unavailable on this device.');
+          }
+        }
+        const summarizer = await self.Summarizer.create(summarizerOptions);
+        try {
+          return await summarizer.summarize(sourceText);
+        } finally {
+          if (typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        }
+      }
+
+      // 2. Legacy window.ai.summarizer namespace
+      if (self.ai && self.ai.summarizer) {
+        if (typeof self.ai.summarizer.capabilities === 'function') {
+          const caps = await self.ai.summarizer.capabilities();
+          if (caps && caps.available === 'no') {
+            throw new Error('The browser Summarizer AI model is unavailable on this device.');
+          }
+        }
+        const summarizer = await self.ai.summarizer.create(summarizerOptions);
+        try {
+          return await summarizer.summarize(sourceText);
+        } finally {
+          if (typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        }
+      }
+
+      // 3. Built-in Prompt API (LanguageModel / window.ai.languageModel) fallback
+      const promptInput = `Summarize the following coffee bean sourcing article into 3 to 4 concise bullet points:\n\n${sourceText}`;
+      if ('LanguageModel' in self && self.LanguageModel) {
+        const session = await self.LanguageModel.create();
+        try {
+          return await session.prompt(promptInput);
+        } finally {
+          if (typeof session.destroy === 'function') {
+            session.destroy();
+          }
+        }
+      }
+
+      if (self.ai && self.ai.languageModel) {
+        const session = await self.ai.languageModel.create();
+        try {
+          return await session.prompt(promptInput);
+        } finally {
+          if (typeof session.destroy === 'function') {
+            session.destroy();
+          }
+        }
+      }
+
+      throw new Error(
+        'Browser native AI (Summarizer API) is not supported or enabled in this browser.'
+      );
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const sourceText = journalTextEl.innerText.trim();
+      if (!sourceText) return;
+
+      summarizeBtn.disabled = true;
+      const originalLabel = summarizeBtn.textContent;
+      summarizeBtn.textContent = 'Summarizing...';
+      showStatus('Generating bullet-point summary with browser AI...');
+
+      try {
+        const summaryResult = await summarizeWithNativeAI(sourceText);
+        summaryBox.classList.add('visible');
+        renderBulletPoints(summaryResult);
+        summarizeBtn.textContent = 'Re-summarize';
+      } catch (err) {
+        showStatus(
+          err && err.message
+            ? err.message
+            : 'Unable to summarize using browser native AI.',
+          true
+        );
+        summarizeBtn.textContent = originalLabel;
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
