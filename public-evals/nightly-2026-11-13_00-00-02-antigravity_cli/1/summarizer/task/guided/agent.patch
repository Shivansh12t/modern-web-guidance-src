+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summarize-status');
+      const summaryBox = document.getElementById('journal-summary');
+      const summaryList = document.getElementById('journal-summary-list');
+      const articleEl = document.getElementById('journal-article');
+
+      const summarizerOptions = {
+        sharedContext: 'An artisanal coffee roastery journal article about ethical direct-trade coffee bean sourcing, harvesting, and roasting.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'medium',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      function showStatus(message) {
+        statusEl.textContent = message;
+        statusEl.hidden = !message;
+      }
+
+      function renderBullets(summaryText) {
+        summaryList.innerHTML = '';
+        const lines = summaryText
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+
+        if (lines.length === 0 && summaryText.trim()) {
+          lines.push(summaryText.trim());
+        }
+
+        for (const point of lines) {
+          const li = document.createElement('li');
+          li.textContent = point;
+          summaryList.appendChild(li);
+        }
+        summaryBox.hidden = false;
+      }
+
+      async function checkSupport() {
+        if (!('Summarizer' in self)) {
+          summarizeBtn.disabled = true;
+          showStatus('Local summarization is currently unsupported in this browser.');
+          return false;
+        }
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            summarizeBtn.disabled = true;
+            showStatus('Local summarization is unavailable on this device.');
+            return false;
+          }
+          return availability;
+        } catch (err) {
+          summarizeBtn.disabled = true;
+          showStatus('Local summarization is currently unsupported in this browser.');
+          return false;
+        }
+      }
+
+      let cachedSummarizer = null;
+
+      checkSupport();
+
+      summarizeBtn.addEventListener('click', async () => {
+        if (!('Summarizer' in self)) {
+          summarizeBtn.disabled = true;
+          showStatus('Local summarization is currently unsupported in this browser.');
+          return;
+        }
+
+        summarizeBtn.disabled = true;
+        showStatus('Checking AI model availability...');
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            showStatus('Local summarization is unavailable on this device.');
+            return;
+          }
+
+          if (!cachedSummarizer) {
+            if (availability === 'downloadable' || availability === 'downloading') {
+              showStatus('Downloading on-device AI model...');
+            } else {
+              showStatus('Initializing on-device AI...');
+            }
+
+            cachedSummarizer = await Summarizer.create({
+              ...summarizerOptions,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  if (e.total) {
+                    const pct = Math.round((e.loaded / e.total) * 100);
+                    showStatus(`Downloading AI model: ${pct}%`);
+                  }
+                });
+              },
+            });
+          }
+
+          showStatus('Generating summary...');
+          const longText = articleEl.innerText;
+          const summary = await cachedSummarizer.summarize(longText, {
+            context: 'Summarize the coffee bean sourcing and roasting process into concise bullet points for coffee customers.',
+          });
+
+          renderBullets(summary);
+          showStatus('');
+          summarizeBtn.textContent = 'Summarize Again';
+          summarizeBtn.disabled = false;
+        } catch (error) {
+          showStatus('Unable to generate summary on this device.');
+          summarizeBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
