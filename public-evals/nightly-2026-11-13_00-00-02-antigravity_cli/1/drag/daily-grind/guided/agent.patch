+
+      handle.addEventListener('pointermove', onPointerMove);
+      handle.addEventListener('lostpointercapture', endDrag);
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      document.addEventListener('pointermove', onPointerMove);
+      document.addEventListener('pointerup', endDrag);
+      document.addEventListener('pointercancel', endDrag);
+
+      // Keyboard movement on focused drag handle
+      handle.addEventListener('keydown', (event) => {
+        const step = event.shiftKey ? KEYBOARD_FAST_STEP : KEYBOARD_STEP;
+        const rect = draggable.getBoundingClientRect();
+
+        switch (event.key) {
+          case 'ArrowLeft':
+            event.preventDefault();
+            moveTo(rect.left - step, rect.top);
+            announceMove('Quick Order Cart moved left');
+            break;
+          case 'ArrowRight':
+            event.preventDefault();
+            moveTo(rect.left + step, rect.top);
+            announceMove('Quick Order Cart moved right');
+            break;
+          case 'ArrowUp':
+            event.preventDefault();
+            moveTo(rect.left, rect.top - step);
+            announceMove('Quick Order Cart moved up');
+            break;
+          case 'ArrowDown':
+            event.preventDefault();
+            moveTo(rect.left, rect.top + step);
+            announceMove('Quick Order Cart moved down');
+            break;
+        }
+      });
+
+      // Keep position clamped on viewport or panel size changes
+      function reclampCurrentPosition() {
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      window.addEventListener('resize', reclampCurrentPosition);
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(() => {
+          if (draggable.style.left || draggable.style.top) {
+            reclampCurrentPosition();
+          }
+        }).observe(draggable);
+      }
+
+      // Single-pointer repositioning menu & keyboard help toggles
+      const posToggle = document.getElementById('position-menu-toggle');
+      const posTray = document.getElementById('cart-position-tray');
+      const helpToggle = document.getElementById('keyboard-help-toggle');
+      const helpTray = document.getElementById('cart-keyboard-help');
+      const collapseToggle = document.getElementById('cart-collapse-toggle');
+      const cartBody = document.getElementById('quick-order-body');
+
+      posToggle.addEventListener('click', () => {
+        const expanded = posToggle.getAttribute('aria-expanded') === 'true';
+        posToggle.setAttribute('aria-expanded', String(!expanded));
+        posTray.hidden = expanded;
+      });
+
+      helpToggle.addEventListener('click', () => {
+        const expanded = helpToggle.getAttribute('aria-expanded') === 'true';
+        helpToggle.setAttribute('aria-expanded', String(!expanded));
+        helpTray.hidden = expanded;
+      });
+
+      collapseToggle.addEventListener('click', () => {
+        const expanded = collapseToggle.getAttribute('aria-expanded') === 'true';
+        collapseToggle.setAttribute('aria-expanded', String(!expanded));
+        collapseToggle.innerHTML = expanded ? '+' : '&minus;';
+        collapseToggle.setAttribute(
+          'aria-label',
+          expanded ? 'Expand quick order cart' : 'Minimize quick order cart'
+        );
+        cartBody.hidden = expanded;
+      });
+
+      posTray.addEventListener('click', (event) => {
+        const btn = event.target.closest('[data-move-action]');
+        if (!btn) return;
+        const action = btn.getAttribute('data-move-action');
+        const rect = draggable.getBoundingClientRect();
+        const margin = 16;
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth - margin);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight - margin);
+
+        switch (action) {
+          case 'dock-left':
+            moveTo(margin, rect.top);
+            announceMove('Quick Order Cart docked left');
+            break;
+          case 'dock-right':
+            moveTo(maxLeft, rect.top);
+            announceMove('Quick Order Cart docked right');
+            break;
+          case 'dock-top':
+            moveTo(rect.left, 72);
+            announceMove('Quick Order Cart docked top');
+            break;
+          case 'dock-bottom':
+            moveTo(rect.left, maxTop);
+            announceMove('Quick Order Cart docked bottom');
+            break;
+          case 'move-left':
+            moveTo(rect.left - KEYBOARD_FAST_STEP, rect.top);
+            announceMove('Quick Order Cart moved left');
+            break;
+          case 'move-right':
+            moveTo(rect.left + KEYBOARD_FAST_STEP, rect.top);
+            announceMove('Quick Order Cart moved right');
+            break;
+          case 'move-up':
+            moveTo(rect.left, rect.top - KEYBOARD_FAST_STEP);
+            announceMove('Quick Order Cart moved up');
+            break;
+          case 'move-down':
+            moveTo(rect.left, rect.top + KEYBOARD_FAST_STEP);
+            announceMove('Quick Order Cart moved down');
+            break;
+        }
+      });
+
+      // Interactive Coffee Cart State & Controls
+      const cartItems = [
+        {
+          id: 'Maple Oat Latte|Medium|Oat Milk',
+          name: 'Maple Oat Latte',
+          size: 'Medium',
+          milk: 'Oat Milk',
+          unitPrice: 6.0,
+          qty: 1
+        },
+        {
+          id: 'Cold Brew|Medium|Splash of Oat',
+          name: 'Cold Brew',
+          size: 'Medium',
+          milk: 'Splash of Oat',
+          unitPrice: 4.75,
+          qty: 1
+        }
+      ];
+
+      const listEl = document.getElementById('cart-items-list');
+      const badgeEl = document.getElementById('cart-count-badge');
+      const subtotalEl = document.getElementById('cart-subtotal');
+      const taxEl = document.getElementById('cart-tax');
+      const totalEl = document.getElementById('cart-total');
+      const statusMsgEl = document.getElementById('order-status-msg');
+      const checkoutBtn = document.getElementById('checkout-btn');
+      const clearBtn = document.getElementById('clear-cart-btn');
+      const quickAddForm = document.getElementById('quick-add-form');
+
+      function formatCurrency(amount) {
+        return `$${amount.toFixed(2)}`;
+      }
+
+      function renderCart() {
+        listEl.innerHTML = '';
+        let totalQty = 0;
+        let subtotal = 0;
+
+        if (cartItems.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-empty';
+          emptyLi.textContent = 'Your coffee cart is empty. Add a drink above!';
+          listEl.appendChild(emptyLi);
+        } else {
+          cartItems.forEach((item, index) => {
+            totalQty += item.qty;
+            subtotal += item.unitPrice * item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+
+            const info = document.createElement('div');
+            info.className = 'cart-item-info';
+
+            const title = document.createElement('div');
+            title.className = 'cart-item-title';
+            title.textContent = item.name;
+
+            const meta = document.createElement('div');
+            meta.className = 'cart-item-meta';
+            meta.textContent = `${item.size} · ${item.milk} · ${formatCurrency(item.unitPrice)} ea`;
+
+            info.appendChild(title);
+            info.appendChild(meta);
+
+            const controls = document.createElement('div');
+            controls.className = 'cart-item-controls';
+
+            const decBtn = document.createElement('button');
+            decBtn.type = 'button';
+            decBtn.className = 'qty-btn';
+            decBtn.textContent = '−';
+            decBtn.setAttribute('aria-label', `Decrease quantity of ${item.name}`);
+            decBtn.addEventListener('click', () => {
+              statusMsgEl.textContent = '';
+              if (item.qty > 1) {
+                item.qty -= 1;
+              } else {
+                cartItems.splice(index, 1);
+              }
+              renderCart();
+            });
+
+            const qtySpan = document.createElement('span');
+            qtySpan.className = 'qty-value';
+            qtySpan.textContent = String(item.qty);
+
+            const incBtn = document.createElement('button');
+            incBtn.type = 'button';
+            incBtn.className = 'qty-btn';
+            incBtn.textContent = '+';
+            incBtn.setAttribute('aria-label', `Increase quantity of ${item.name}`);
+            incBtn.addEventListener('click', () => {
+              statusMsgEl.textContent = '';
+              item.qty += 1;
+              renderCart();
+            });
+
+            controls.appendChild(decBtn);
+            controls.appendChild(qtySpan);
+            controls.appendChild(incBtn);
+
+            li.appendChild(info);
+            li.appendChild(controls);
+            listEl.appendChild(li);
+          });
+        }
+
+        const tax = subtotal * 0.08;
+        const total = subtotal + tax;
+
+        badgeEl.textContent = String(totalQty);
+        badgeEl.setAttribute('aria-label', `${totalQty} ${totalQty === 1 ? 'item' : 'items'} in cart`);
+        subtotalEl.textContent = formatCurrency(subtotal);
+        taxEl.textContent = formatCurrency(tax);
+        totalEl.textContent = formatCurrency(total);
+        checkoutBtn.disabled = cartItems.length === 0;
+      }
+
+      function addDrinkToCart(name, size, milk, unitPrice) {
+        const id = `${name}|${size}|${milk}`;
+        const existing = cartItems.find((item) => item.id === id);
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          cartItems.push({ id, name, size, milk, unitPrice, qty: 1 });
+        }
+        statusMsgEl.textContent = `Added ${size} ${name} to cart!`;
+        renderCart();
+      }
+
+      quickAddForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const [drinkName, basePriceStr] = document.getElementById('drink-select').value.split('|');
+        const [sizeName, sizeUpchargeStr] = document.getElementById('size-select').value.split('|');
+        const milkName = document.getElementById('milk-select').value;
+        const unitPrice = parseFloat(basePriceStr) + parseFloat(sizeUpchargeStr);
+        addDrinkToCart(drinkName, sizeName, milkName, unitPrice);
+      });
+
+      document.querySelectorAll('[data-quick-add]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const name = btn.getAttribute('data-quick-add');
+          const price = parseFloat(btn.getAttribute('data-price'));
+          const milk = btn.getAttribute('data-milk') || 'Oat Milk';
+          if (cartBody.hidden) {
+            collapseToggle.click();
+          }
+          addDrinkToCart(name, 'Medium', milk, price);
+        });
+      });
+
+      clearBtn.addEventListener('click', () => {
+        cartItems.length = 0;
+        statusMsgEl.textContent = 'Cart cleared.';
+        renderCart();
+      });
+
+      checkoutBtn.addEventListener('click', () => {
+        if (cartItems.length === 0) return;
+        const count = cartItems.reduce((sum, item) => sum + item.qty, 0);
+        statusMsgEl.textContent = `Order confirmed! ${count} drink${count === 1 ? '' : 's'} brewing for pickup.`;
+      });
+
+      renderCart();
+    })();
+  </script>
 </body>
 
 </html>
