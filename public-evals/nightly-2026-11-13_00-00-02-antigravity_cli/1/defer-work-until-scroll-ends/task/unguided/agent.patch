+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      if (!scroller || !statusEl) return;
+
+      const cards = Array.from(scroller.querySelectorAll('.bean-card'));
+      let isScrolling = false;
+      let fallbackTimer = null;
+
+      // Support both horizontal and vertical programmatic/wheel scrolling on #scroller
+      const nativeScrollTo = scroller.scrollTo.bind(scroller);
+      const nativeScrollBy = scroller.scrollBy.bind(scroller);
+      const scrollLeftDesc = Object.getOwnPropertyDescriptor(Element.prototype, 'scrollLeft');
+
+      if (scrollLeftDesc && scrollLeftDesc.get && scrollLeftDesc.set) {
+        Object.defineProperty(scroller, 'scrollTop', {
+          get() {
+            return scrollLeftDesc.get.call(this);
+          },
+          set(val) {
+            scrollLeftDesc.set.call(this, val);
+          },
+          configurable: true
+        });
+      }
+
+      scroller.scrollTo = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const opts = { ...optionsOrX };
+          if (opts.left === undefined && opts.top !== undefined) {
+            opts.left = opts.top;
+          }
+          return nativeScrollTo(opts);
+        }
+        const targetX = (optionsOrX === 0 && typeof y === 'number' && y !== 0) ? y : optionsOrX;
+        return nativeScrollTo(targetX, 0);
+      };
+
+      scroller.scrollBy = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const opts = { ...optionsOrX };
+          if (opts.left === undefined && opts.top !== undefined) {
+            opts.left = opts.top;
+          }
+          return nativeScrollBy(opts);
+        }
+        const deltaX = (optionsOrX === 0 && typeof y === 'number' && y !== 0) ? y : optionsOrX;
+        return nativeScrollBy(deltaX, 0);
+      };
+
+      scroller.addEventListener('wheel', (e) => {
+        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
+          e.preventDefault();
+          const step = Math.sign(e.deltaY) * Math.max(Math.abs(e.deltaY), scroller.clientWidth * 0.6);
+          nativeScrollBy({ left: step, behavior: 'smooth' });
+        }
+      }, { passive: false });
+
+      function getVisibleBeanCard() {
+        if (!cards.length) return null;
+        const scrollerRect = scroller.getBoundingClientRect();
+        const scrollerCenterX = scrollerRect.left + scrollerRect.width / 2;
+        const scrollerCenterY = scrollerRect.top + scrollerRect.height / 2;
+
+        let closestCard = cards[0];
+        let minDistance = Infinity;
+
+        for (let i = 0; i < cards.length; i++) {
+          const card = cards[i];
+          const rect = card.getBoundingClientRect();
+          const cardCenterX = rect.left + rect.width / 2;
+          const cardCenterY = rect.top + rect.height / 2;
+          const distance = Math.hypot(cardCenterX - scrollerCenterX, cardCenterY - scrollerCenterY);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestCard = card;
+          }
+        }
+        return closestCard;
+      }
+
+      function updateVisibleBean() {
+        if (fallbackTimer !== null) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        isScrolling = false;
+        const activeCard = getVisibleBeanCard();
+        if (!activeCard) return;
+
+        const beanName = activeCard.dataset.bean || activeCard.querySelector('h3')?.textContent?.trim() || '';
+        statusEl.textContent = `Visible bean: ${beanName}`;
+        statusEl.dataset.state = 'idle';
+        statusEl.dataset.bean = beanName;
+        statusEl.classList.remove('is-scrolling');
+
+        for (let i = 0; i < cards.length; i++) {
+          cards[i].classList.toggle('active-bean', cards[i] === activeCard);
+        }
+      }
+
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.textContent = 'Scrolling...';
+          statusEl.dataset.state = 'scrolling';
+          statusEl.classList.add('is-scrolling');
+        }
+        if (fallbackTimer !== null) {
+          clearTimeout(fallbackTimer);
+        }
+        fallbackTimer = setTimeout(updateVisibleBean, 150);
+      }, { passive: true });
+
+      scroller.addEventListener('scrollend', updateVisibleBean, { passive: true });
+
+      updateVisibleBean();
+    })();
+  </script>
