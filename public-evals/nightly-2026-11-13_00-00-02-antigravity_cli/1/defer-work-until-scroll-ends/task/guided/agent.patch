+  <script>
+    const scroller = document.querySelector('#scroller');
+    const statusEl = document.querySelector('#status');
+    const beanCards = [...scroller.querySelectorAll('.bean-card')];
+
+    let isScrolling = false;
+    let snappedBeanCard = beanCards[0] || null;
+
+    function getBeanName(card) {
+      if (!card) return '';
+      return card.dataset.beanName || card.querySelector('h3')?.textContent.trim() || '';
+    }
+
+    // Note: For item.offsetLeft to be relative to the container,
+    // the container MUST be the offsetParent (e.g., `position: relative`).
+    function findMostVisibleBean() {
+      const containerCenter = scroller.scrollLeft + scroller.clientWidth / 2;
+      let closestCard = beanCards[0];
+      let minDistance = Infinity;
+
+      beanCards.forEach((card) => {
+        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
+        const distance = Math.abs(containerCenter - cardCenter);
+        if (distance < minDistance) {
+          minDistance = distance;
+          closestCard = card;
+        }
+      });
+
+      return closestCard;
+    }
+
+    function updateVisibleBeanStatus(targetCard) {
+      const visibleCard = targetCard || findMostVisibleBean();
+      snappedBeanCard = visibleCard;
+      const beanName = getBeanName(visibleCard);
+      isScrolling = false;
+      statusEl.dataset.scrolling = 'false';
+      statusEl.textContent = `Viewing: ${beanName}`;
+    }
+
+    // 1. Lightweight informative feedback during scroll without layout reads/thrashing
+    scroller.addEventListener('scroll', () => {
+      if (!isScrolling) {
+        isScrolling = true;
+        statusEl.dataset.scrolling = 'true';
+        statusEl.textContent = 'Scrolling...';
+      }
+    }, { passive: true });
+
+    // 2. Native scrollsnapchange when supported to track the snapped bean target
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      scroller.addEventListener('scrollsnapchange', (event) => {
+        const snappedTarget = event.snapTargetInline;
+        if (snappedTarget) {
+          updateVisibleBeanStatus(snappedTarget);
+        }
+      });
+    }
+
+    // 3. Safe callback when scrolling rests via scrollend (plus debounced fallback)
+    scroller.addEventListener('scrollend', () => {
+      updateVisibleBeanStatus();
+    });
+
+    if (!('onscrollend' in window)) {
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+
+    // Sync initial state on load
+    if (document.readyState === 'complete') {
+      updateVisibleBeanStatus();
+    } else {
+      window.addEventListener('load', () => updateVisibleBeanStatus(), { once: true });
+    }
+  </script>
