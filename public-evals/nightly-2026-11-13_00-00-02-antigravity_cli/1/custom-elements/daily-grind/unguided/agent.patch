+/**
+ * <coffee-card> Autonomous Custom Element
+ * Implements full custom element lifecycle management and two-way
+ * attribute/property reflection for string, numeric, and boolean attributes.
+ */
+(function (root) {
+  if (root.CoffeeCard && root.customElements && root.customElements.get('coffee-card')) {
+    return;
+  }
+
+  const STRING_ATTRIBUTES = ['name', 'description', 'href', 'image', 'roast', 'cta-text'];
+  const NUMERIC_ATTRIBUTES = ['price', 'rating', 'calories', 'caffeine'];
+  const BOOLEAN_ATTRIBUTES = ['featured', 'seasonal', 'sold-out', 'iced'];
+
+  const OBSERVED_ATTRIBUTES = [
+    ...STRING_ATTRIBUTES,
+    ...NUMERIC_ATTRIBUTES,
+    ...BOOLEAN_ATTRIBUTES,
+  ];
+
+  const ATTRIBUTE_TO_PROPERTY = {
+    'name': 'name',
+    'description': 'description',
+    'href': 'href',
+    'image': 'image',
+    'roast': 'roast',
+    'cta-text': 'ctaText',
+    'price': 'price',
+    'rating': 'rating',
+    'calories': 'calories',
+    'caffeine': 'caffeine',
+    'featured': 'featured',
+    'seasonal': 'seasonal',
+    'sold-out': 'soldOut',
+    'iced': 'iced',
+  };
+
+  const template = document.createElement('template');
+  template.innerHTML = `
+    <style>
+      :host {
+        display: block;
+        font-family: inherit;
+        color: var(--text, #3e2723);
+      }
+
+      :host([hidden]) {
