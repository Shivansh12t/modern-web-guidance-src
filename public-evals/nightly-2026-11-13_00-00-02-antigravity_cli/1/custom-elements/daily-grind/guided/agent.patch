+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        display: block;
+        container-type: inline-size;
+        --_card-bg: var(--card-bg, white);
+        --_card-fg: var(--card-fg, var(--text, #3e2723));
+        --_card-primary: var(--card-primary, var(--primary, #4e342e));
+        --_card-accent: var(--card-accent, var(--accent, #ffab40));
+      }
+
+      :host([hidden]) {
+        display: none;
+      }
+
+      :host([disabled]),
+      :host([sold-out]) {
+        opacity: 0.65;
+      }
+
+      .card {
+        background: var(--_card-bg);
+        color: var(--_card-fg);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        height: 100%;
+        position: relative;
+        border: 2px solid transparent;
+        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+      }
+
+      :host([featured]) .card,
+      :host([seasonal]) .card {
+        border-color: var(--_card-accent);
+      }
+
+      .badge {
+        display: inline-block;
+        align-self: center;
+        background: var(--_card-accent);
+        color: var(--_card-fg);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 2px 10px;
+        border-radius: 999px;
+        margin-bottom: 10px;
+      }
+
+      .badge[hidden] {
+        display: none;
+      }
+
+      h3 {
+        margin: 0 0 10px;
+        color: var(--_card-primary);
+      }
+
+      .description {
+        margin: 0 0 12px;
+        flex-grow: 1;
+      }
+
+      .meta {
+        display: flex;
+        justify-content: center;
+        align-items: center;
+        gap: 12px;
+        font-size: 0.9rem;
+        margin-bottom: 5px;
+      }
+
+      .meta[hidden] {
+        display: none;
+      }
+
+      .price {
+        font-weight: 700;
+        color: var(--_card-primary);
+      }
+
+      .calories {
+        color: #6d4c41;
+      }
+
+      .price[hidden],
+      .calories[hidden] {
+        display: none;
+      }
+
+      .btn {
+        display: inline-block;
+        background: var(--_card-primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        font: inherit;
+        transition: background 0.3s;
+        align-self: center;
+      }
+
+      .btn:hover {
+        background: #3e2723;
+      }
+
+      .btn[aria-disabled="true"] {
+        pointer-events: none;
+        background: #8d6e63;
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <span class="badge" part="badge" hidden></span>
+        <h3 part="heading"><slot name="title"></slot></h3>
+        <p class="description" part="description"><slot></slot></p>
+        <div class="meta" part="meta" hidden>
+          <span class="price" part="price" hidden></span>
+          <span class="calories" part="calories" hidden></span>
+        </div>
+        <a class="btn" part="button" href="#">View Details</a>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'label',
+        'description',
+        'href',
+        'cta-text',
+        'price',
+        'calories',
+        'rating',
+        'count',
+        'seasonal',
+        'featured',
+        'disabled',
+        'sold-out',
+      ];
+
+      #internals;
+      #initialized = false;
+      #abortController = null;
+      #els = {};
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals?.() ?? null;
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        shadowRoot.adoptedStyleSheets = [sheet];
+        shadowRoot.append(template.content.cloneNode(true));
+
+        this.#els = {
+          badge: shadowRoot.querySelector('.badge'),
+          headingSlot: shadowRoot.querySelector('slot[name="title"]'),
+          descriptionSlot: shadowRoot.querySelector('slot:not([name])'),
+          meta: shadowRoot.querySelector('.meta'),
+          price: shadowRoot.querySelector('.price'),
+          calories: shadowRoot.querySelector('.calories'),
+          link: shadowRoot.querySelector('.btn'),
+        };
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(value) {
+        value ? this.setAttribute('name', String(value)) : this.removeAttribute('name');
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+      set label(value) {
+        value ? this.setAttribute('label', String(value)) : this.removeAttribute('label');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(value) {
+        value ? this.setAttribute('description', String(value)) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(value) {
+        value ? this.setAttribute('href', String(value)) : this.removeAttribute('href');
+      }
+
+      get ctaText() {
+        return this.getAttribute('cta-text') ?? '';
+      }
+      set ctaText(value) {
+        value ? this.setAttribute('cta-text', String(value)) : this.removeAttribute('cta-text');
+      }
+
+      // Numeric attributes: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(value) {
+        this.setAttribute('price', String(Number(value) || 0));
+      }
+
+      get calories() {
+        return Number(this.getAttribute('calories')) || 0;
+      }
+      set calories(value) {
+        this.setAttribute('calories', String(Number(value) || 0));
+      }
+
+      get rating() {
+        return Number(this.getAttribute('rating')) || 0;
+      }
+      set rating(value) {
+        this.setAttribute('rating', String(Number(value) || 0));
+      }
+
+      get count() {
+        return Number(this.getAttribute('count')) || 0;
+      }
+      set count(value) {
+        this.setAttribute('count', String(Number(value) || 0));
+      }
+
+      // Boolean attributes: present = true, absent = false (never set to "false")
+      get seasonal() {
+        return this.hasAttribute('seasonal');
+      }
+      set seasonal(on) {
+        this.toggleAttribute('seasonal', !!on);
+      }
+
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+      set soldOut(on) {
+        this.toggleAttribute('sold-out', !!on);
+      }
+
+      connectedCallback() {
+        this.#upgradeProperties();
+        this.#setupListeners();
+        this.#render();
+        this.#initialized = true;
+      }
+
+      connectedMoveCallback() {
+        // Preserve state and listeners without teardown/re-setup on Node.moveBefore()
+        this.#render();
+      }
+
+      disconnectedCallback() {
+        this.#abortController?.abort();
+        this.#abortController = null;
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.#initialized) {
+          this.#render();
+        }
+      }
+
+      #upgradeProperties() {
+        for (const prop of [
+          'name',
+          'label',
+          'description',
+          'href',
+          'ctaText',
+          'price',
+          'calories',
+          'rating',
+          'count',
+          'seasonal',
+          'featured',
+          'disabled',
+          'soldOut',
+        ]) {
+          if (Object.prototype.hasOwnProperty.call(this, prop)) {
+            const value = this[prop];
+            delete this[prop];
+            this[prop] = value;
+          }
+        }
+      }
+
+      #setupListeners() {
+        this.#abortController?.abort();
+        this.#abortController = new AbortController();
+        const { signal } = this.#abortController;
+
+        this.#els.headingSlot.addEventListener('slotchange', () => this.#render(), { signal });
+        this.#els.descriptionSlot.addEventListener('slotchange', () => this.#render(), { signal });
+        this.#els.link.addEventListener(
+          'click',
+          (e) => {
+            if (this.disabled || this.soldOut) {
+              e.preventDefault();
+            }
+          },
+          { signal }
+        );
+      }
+
+      #render() {
+        const headingText = this.name || this.label;
+        if (this.#els.headingSlot.assignedNodes({ flatten: false }).length === 0) {
+          this.#els.headingSlot.textContent = headingText;
+        }
+
+        if (this.#els.descriptionSlot.assignedNodes({ flatten: false }).length === 0) {
+          this.#els.descriptionSlot.textContent = this.description;
+        }
+
+        const isUnavailable = this.disabled || this.soldOut;
+        const badgeText = this.soldOut
+          ? 'Sold Out'
+          : this.seasonal
+            ? 'Seasonal'
+            : this.featured
+              ? 'Featured'
+              : '';
+        this.#els.badge.hidden = !badgeText;
+        this.#els.badge.textContent = badgeText;
+
+        const hasPrice = this.hasAttribute('price') && this.price > 0;
+        const hasCalories = this.hasAttribute('calories') && this.calories > 0;
+
+        this.#els.price.hidden = !hasPrice;
+        this.#els.price.textContent = hasPrice ? `$${this.price.toFixed(2)}` : '';
+
+        this.#els.calories.hidden = !hasCalories;
+        this.#els.calories.textContent = hasCalories ? `${this.calories} cal` : '';
+
+        this.#els.meta.hidden = !hasPrice && !hasCalories;
+
+        const linkHref = this.href || '#';
+        const ctaLabel = this.soldOut ? 'Sold Out' : this.ctaText || 'View Details';
+        this.#els.link.textContent = ctaLabel;
+
+        if (isUnavailable) {
+          this.#els.link.removeAttribute('href');
+          this.#els.link.setAttribute('aria-disabled', 'true');
+          this.#els.link.tabIndex = -1;
+        } else {
+          this.#els.link.setAttribute('href', linkHref);
+          this.#els.link.removeAttribute('aria-disabled');
+          this.#els.link.removeAttribute('tabindex');
+        }
+
+        if (this.#internals) {
+          this.#internals.ariaDisabled = isUnavailable ? 'true' : null;
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
