+  <script>
+    (function () {
+      const form = document.getElementById('contact-form');
+      if (!form) return;
+
+      const fields = form.querySelectorAll('.form-field');
+      const statusEl = document.getElementById('form-status');
+
+      function validateField(wrapper, isInteracted) {
+        const control = wrapper.querySelector('input, textarea');
+        if (!control) return true;
+
+        const trimmedValue = control.value.trim();
+        let isValid = control.checkValidity() && trimmedValue.length > 0;
+
+        if (control.type === 'email' && trimmedValue.length > 0) {
+          const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+          isValid = isValid && emailPattern.test(trimmedValue);
+        }
+
+        if (isInteracted) {
+          wrapper.classList.toggle('error', !isValid);
+          control.setAttribute('aria-invalid', String(!isValid));
+        }
+
+        return isValid;
+      }
+
+      fields.forEach(function (wrapper) {
+        const control = wrapper.querySelector('input, textarea');
+        if (!control) return;
+
+        let touched = false;
+
+        control.addEventListener('blur', function () {
+          touched = true;
+          validateField(wrapper, true);
+        });
+
+        control.addEventListener('input', function () {
+          if (statusEl) statusEl.classList.remove('visible');
+          // Validate immediately if already touched or if user entered an invalid value
+          if (touched || control.value.length > 0) {
+            validateField(wrapper, true);
+          }
+        });
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        let allValid = true;
+
+        fields.forEach(function (wrapper) {
+          const valid = validateField(wrapper, true);
+          if (!valid) {
+            allValid = false;
+          }
+        });
+
+        if (allValid) {
+          if (statusEl) statusEl.classList.add('visible');
+          form.reset();
+          fields.forEach(function (wrapper) {
+            wrapper.classList.remove('error');
+            const control = wrapper.querySelector('input, textarea');
+            if (control) control.removeAttribute('aria-invalid');
+          });
+        }
+      });
+    })();
+  </script>
+
 </body>
 
