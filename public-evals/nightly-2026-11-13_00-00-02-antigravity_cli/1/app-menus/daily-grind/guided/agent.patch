+        if (isRoot) {
+          rootTriggers.forEach(t => { t.tabIndex = t === trigger ? 0 : -1; });
+          rootTriggers.filter(t => t !== trigger).map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+        }
+        showMenu(menu, trigger);
+      });
+
+      // Hide a previewed menu on blur unless focus moved into it
+      trigger.addEventListener('blur', event => {
+        if (!isOpen(menu)) return;
+        const nextFocus = event.relatedTarget;
+        if (nextFocus && (menu.contains(nextFocus) || nextFocus === trigger)) return;
+        if (isRoot && nextFocus && menubar.contains(nextFocus)) return;
+        menu.hidePopover();
+      });
+
+      if (isRoot) {
+        // Hover switches open menus on the menubar
+        trigger.addEventListener('pointerenter', () => {
+          const anyRootOpen = rootTriggers.some(t => isOpen(menuFor(t)));
+          if (!anyRootOpen) return;
+          rootTriggers.filter(t => t !== trigger).map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+          rootTriggers.forEach(t => { t.tabIndex = t === trigger ? 0 : -1; });
+          trigger.focus({ preventScroll: true, focusVisible: false });
+          showMenu(menu, trigger);
+        });
+
+        // Root trigger keyboard navigation
+        trigger.addEventListener('keydown', event => {
+          if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+            event.preventDefault();
+            moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+          } else if (event.key === 'ArrowDown') {
+            event.preventDefault();
+            if (isOpen(menu)) {
+              getMenuItems(menu)[0]?.focus({ preventScroll: true });
+            } else {
+              enterOnOpen.add(menu);
+              trigger.click();
+            }
+          } else if (event.key === 'Home' || event.key === 'End') {
+            event.preventDefault();
+            showMenu(menu, trigger);
+            const items = getMenuItems(menu);
+            const target = event.key === 'Home' ? items[0] : items[items.length - 1];
+            target?.focus({ preventScroll: true });
+          } else if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            menu.hidePopover();
+          }
+        });
+      } else {
+        // Submenu trigger safe triangle & keyboard handling
+        trigger.addEventListener('pointerleave', event => {
+          startBridge(menu, event);
+        });
+
+        trigger.addEventListener('keydown', event => {
+          if (event.key === 'ArrowRight') {
+            event.preventDefault();
+            event.stopPropagation();
+            showMenu(menu, trigger);
+            getMenuItems(menu)[0]?.focus({ preventScroll: true });
+          }
+        });
+      }
+
+      // Sync aria-expanded and focus management in toggle event
+      menu.addEventListener('toggle', event => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', String(open));
+        if (open) {
+          positionMenuFallback(menu, trigger);
+          if (enterOnOpen.has(menu)) {
+            enterOnOpen.delete(menu);
+            getMenuItems(menu)[0]?.focus({ preventScroll: true });
+          } else if (pointerTrigger === trigger || document.activeElement !== trigger) {
+            if (!menu.contains(document.activeElement)) {
+              trigger.focus({ preventScroll: true, focusVisible: false });
+            }
+          }
+        } else {
+          enterOnOpen.delete(menu);
+        }
+      });
+    });
+
+    // Menu interior interactions (keyboard, pointer hover-follows-focus, and item activation)
+    menus.forEach(menu => {
+      const group = menu.querySelector('[focusgroup~="menu"]');
+      if (!group) return;
+      const trigger = triggerForMenu.get(menu);
+      const isRootMenu = rootTriggers.includes(trigger);
+      const rootTrigger = rootTriggers.find(rt => menuFor(rt)?.contains(menu));
+
+      // Pointer move over items: hover follows focus
+      group.addEventListener('pointermove', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        const hit = document.elementFromPoint(event.clientX, event.clientY);
+        if (!hit || !item.contains(hit)) return;
+
+        if (document.activeElement !== item) {
+          clearTimeout(hoverSubmenuTimer);
+          const subMenu = item.hasAttribute('commandfor') ? menuFor(item) : null;
+          // Close any open sibling submenu when moving to another sibling item
+          getMenuItems(menu).forEach(sibling => {
+            if (sibling !== item && sibling.hasAttribute('commandfor')) {
+              const sibMenu = menuFor(sibling);
+              if (isOpen(sibMenu)) sibMenu.hidePopover();
+            }
+          });
+          if (subMenu) {
+            suppressPreviewFor = item;
+            item.focus({ preventScroll: true, focusVisible: false });
+            suppressPreviewFor = null;
+            hoverSubmenuTimer = setTimeout(() => {
+              if (document.activeElement === item) {
+                showMenu(subMenu, item);
+              }
+            }, 120);
+          } else {
+            item.focus({ preventScroll: true, focusVisible: false });
+          }
+        }
+      });
+
+      group.addEventListener('keydown', event => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu, { fromPointer: false });
+          return;
+        }
+
+        if (event.key === 'ArrowLeft') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isRootMenu) {
+            moveToRootTrigger(trigger, -1);
+          } else {
+            closeAndRestore(menu, { fromPointer: false });
+          }
+          return;
+        }
+
+        if (event.key === 'ArrowRight') {
+          const active = document.activeElement;
+          if (active && active.hasAttribute('commandfor')) return; // Handled by submenu trigger listener
+          event.preventDefault();
+          event.stopPropagation();
+          if (rootTrigger) {
+            moveToRootTrigger(rootTrigger, 1);
+          }
+          return;
+        }
+
+        if (event.key === 'Home' || event.key === 'End') {
+          if ('focusGroup' in HTMLElement.prototype) {
+            event.preventDefault();
+            event.stopPropagation();
+            const items = getMenuItems(menu);
+            const target = event.key === 'Home' ? items[0] : items[items.length - 1];
+            target?.focus({ preventScroll: true });
+          }
+          return;
+        }
+
+        // Space on a checkbox toggles and stays open (APG)
+        if (event.key === ' ' && document.activeElement?.getAttribute('role') === 'menuitemcheckbox') {
+          event.preventDefault();
+          event.stopPropagation();
+          const cb = document.activeElement;
+          const nextState = cb.getAttribute('aria-checked') !== 'true';
+          cb.setAttribute('aria-checked', String(nextState));
+          if (statusRegion) {
+            statusRegion.textContent = `${cb.textContent.trim()} ${nextState ? 'checked' : 'unchecked'}`;
+          }
+        }
+      });
+
+      // Item activation (commands, checkboxes, radios, links)
+      group.addEventListener('click', event => {
+        const item = event.target.closest('button, a[href]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        if (item.hasAttribute('commandfor')) return; // Submenu trigger handled separately
+
+        const fromPointer = event.detail > 0;
+        const role = item.getAttribute('role');
+        const rootMenu = rootTrigger ? menuFor(rootTrigger) : menu;
+
+        if (role === 'menuitemcheckbox') {
+          const nextState = item.getAttribute('aria-checked') !== 'true';
+          item.setAttribute('aria-checked', String(nextState));
+          if (statusRegion) {
+            statusRegion.textContent = `${item.textContent.trim()} ${nextState ? 'checked' : 'unchecked'}`;
+          }
+          setTimeout(() => {
+            closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+          return;
+        }
+
+        if (role === 'menuitemradio') {
+          const radioGroup = item.closest('[role="group"]') || group;
+          radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+            radio.setAttribute('aria-checked', String(radio === item));
+          });
+          if (statusRegion) {
+            statusRegion.textContent = `${item.textContent.trim()} selected`;
+          }
+          setTimeout(() => {
+            closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+          return;
+        }
+
+        if (item.tagName === 'BUTTON') {
+          const label = item.dataset.action || item.textContent.trim();
+          if (statusRegion) {
+            statusRegion.textContent = `${label} activated`;
+          }
+          closeAndRestore(rootMenu, { fromPointer });
+        } else if (item.tagName === 'A') {
+          closeAndRestore(rootMenu, { fromPointer });
+        }
+      });
+    });
+
+    // Outside focus closes every open menu; treat the menubar as inside the menu system
+    document.addEventListener('focusin', event => {
+      const target = event.target;
+      if (menubar.contains(target) || menus.some(m => m.contains(target))) return;
+      closeAllRootMenus();
+    });
+  </script>
+
 </body>
 
