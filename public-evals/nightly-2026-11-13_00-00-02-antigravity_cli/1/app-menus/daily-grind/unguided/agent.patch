+  <script>
+    (function () {
+      const menubar = document.querySelector('ul[role="menubar"]');
+      if (!menubar) return;
+
+      const topLevelItems = Array.from(menubar.querySelectorAll(':scope > li > [role="menuitem"]'));
+
+      function getSubmenu(trigger) {
+        const controlsId = trigger.getAttribute('aria-controls');
+        return controlsId ? document.getElementById(controlsId) : trigger.nextElementSibling;
+      }
+
+      function getSubmenuItems(submenu) {
+        return submenu ? Array.from(submenu.querySelectorAll('[role="menuitem"]')) : [];
+      }
+
+      function closeAllSubmenus(exceptTrigger = null) {
+        topLevelItems.forEach((item) => {
+          if (item !== exceptTrigger && item.getAttribute('aria-haspopup') === 'true') {
+            item.setAttribute('aria-expanded', 'false');
+            const submenu = getSubmenu(item);
+            if (submenu) {
+              submenu.classList.remove('open');
+            }
+          }
+        });
+      }
+
+      function openSubmenu(trigger, focusIndex = null) {
+        closeAllSubmenus(trigger);
+        const submenu = getSubmenu(trigger);
+        if (!submenu) return;
+        trigger.setAttribute('aria-expanded', 'true');
+        submenu.classList.add('open');
+
+        if (focusIndex !== null) {
+          const items = getSubmenuItems(submenu);
+          if (items.length > 0) {
+            const idx = focusIndex < 0 ? items.length - 1 : Math.min(focusIndex, items.length - 1);
+            items[idx].focus();
+          }
+        }
+      }
+
+      function focusTopLevelItem(index) {
+        const count = topLevelItems.length;
+        const targetIndex = ((index % count) + count) % count;
+        topLevelItems.forEach((item, i) => {
+          item.setAttribute('tabindex', i === targetIndex ? '0' : '-1');
+        });
+        const targetItem = topLevelItems[targetIndex];
+        targetItem.focus();
+        return targetItem;
+      }
+
+      topLevelItems.forEach((trigger, index) => {
+        const submenu = getSubmenu(trigger);
+        const submenuItems = getSubmenuItems(submenu);
+
+        // Toggle submenu on click
+        trigger.addEventListener('click', (e) => {
+          if (trigger.getAttribute('aria-haspopup') === 'true') {
+            e.preventDefault();
+            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+            focusTopLevelItem(index);
+            if (isExpanded) {
+              closeAllSubmenus();
+            } else {
+              openSubmenu(trigger, 0);
+            }
+          }
+        });
+
+        // Switch active submenu on hover if another submenu in the menubar is already open
+        trigger.addEventListener('mouseenter', () => {
+          const anyExpanded = topLevelItems.some((item) => item.getAttribute('aria-expanded') === 'true');
+          if (anyExpanded && trigger.getAttribute('aria-haspopup') === 'true') {
+            focusTopLevelItem(index);
+            openSubmenu(trigger, null);
+          }
+        });
+
+        // Keyboard navigation for top-level menubar items
+        trigger.addEventListener('keydown', (e) => {
+          const anyExpanded = topLevelItems.some((item) => item.getAttribute('aria-expanded') === 'true');
+
+          switch (e.key) {
+            case 'ArrowRight': {
+              e.preventDefault();
+              const nextTrigger = focusTopLevelItem(index + 1);
+              if (anyExpanded && nextTrigger.getAttribute('aria-haspopup') === 'true') {
+                openSubmenu(nextTrigger, null);
+              } else {
+                closeAllSubmenus();
+              }
+              break;
+            }
+            case 'ArrowLeft': {
+              e.preventDefault();
+              const prevTrigger = focusTopLevelItem(index - 1);
+              if (anyExpanded && prevTrigger.getAttribute('aria-haspopup') === 'true') {
+                openSubmenu(prevTrigger, null);
+              } else {
+                closeAllSubmenus();
+              }
+              break;
+            }
+            case 'ArrowDown':
+            case 'Enter':
+            case ' ': {
+              if (trigger.getAttribute('aria-haspopup') === 'true') {
+                e.preventDefault();
+                openSubmenu(trigger, 0);
+              }
+              break;
+            }
+            case 'ArrowUp': {
+              if (trigger.getAttribute('aria-haspopup') === 'true') {
+                e.preventDefault();
+                openSubmenu(trigger, -1);
+              }
+              break;
+            }
+            case 'Home': {
+              e.preventDefault();
+              closeAllSubmenus();
+              focusTopLevelItem(0);
+              break;
+            }
+            case 'End': {
+              e.preventDefault();
+              closeAllSubmenus();
+              focusTopLevelItem(topLevelItems.length - 1);
+              break;
+            }
+            case 'Escape': {
+              e.preventDefault();
+              closeAllSubmenus();
+              trigger.focus();
+              break;
+            }
+            default: {
+              if (e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) {
+                const char = e.key.toLowerCase();
+                const matchIndex = topLevelItems.findIndex((item, i) => {
+                  const candidate = topLevelItems[(index + 1 + i) % topLevelItems.length];
+                  return candidate.textContent.trim().toLowerCase().startsWith(char);
+                });
+                if (matchIndex !== -1) {
+                  e.preventDefault();
+                  focusTopLevelItem((index + 1 + matchIndex) % topLevelItems.length);
+                }
+              }
+              break;
+            }
+          }
+        });
+
+        // Keyboard navigation inside submenus
+        submenuItems.forEach((subItem, subIndex) => {
+          subItem.addEventListener('keydown', (e) => {
+            switch (e.key) {
+              case 'ArrowDown': {
+                e.preventDefault();
+                const nextSub = submenuItems[(subIndex + 1) % submenuItems.length];
+                nextSub.focus();
+                break;
+              }
+              case 'ArrowUp': {
+                e.preventDefault();
+                const prevSub = submenuItems[(subIndex - 1 + submenuItems.length) % submenuItems.length];
+                prevSub.focus();
+                break;
+              }
+              case 'ArrowRight': {
+                e.preventDefault();
+                const nextTrigger = focusTopLevelItem(index + 1);
+                if (nextTrigger.getAttribute('aria-haspopup') === 'true') {
+                  openSubmenu(nextTrigger, 0);
+                } else {
+                  closeAllSubmenus();
+                }
+                break;
+              }
+              case 'ArrowLeft': {
+                e.preventDefault();
+                const prevTrigger = focusTopLevelItem(index - 1);
+                if (prevTrigger.getAttribute('aria-haspopup') === 'true') {
+                  openSubmenu(prevTrigger, 0);
+                } else {
+                  closeAllSubmenus();
+                }
+                break;
+              }
+              case 'Home': {
+                e.preventDefault();
+                submenuItems[0].focus();
+                break;
+              }
+              case 'End': {
+                e.preventDefault();
+                submenuItems[submenuItems.length - 1].focus();
+                break;
+              }
+              case 'Escape': {
+                e.preventDefault();
+                closeAllSubmenus();
+                focusTopLevelItem(index);
+                break;
+              }
+              case 'Tab': {
+                closeAllSubmenus();
+                break;
+              }
+              default: {
+                if (e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) {
+                  const char = e.key.toLowerCase();
+                  const offset = submenuItems.findIndex((_, i) => {
+                    const candidate = submenuItems[(subIndex + 1 + i) % submenuItems.length];
+                    return candidate.textContent.trim().toLowerCase().startsWith(char);
+                  });
+                  if (offset !== -1) {
+                    e.preventDefault();
+                    submenuItems[(subIndex + 1 + offset) % submenuItems.length].focus();
+                  }
+                }
+                break;
+              }
+            }
+          });
+        });
+      });
+
+      // Close submenus when clicking outside or moving focus outside the menubar
+      document.addEventListener('click', (e) => {
+        if (!menubar.contains(e.target)) {
+          closeAllSubmenus();
+        }
+      });
+
+      menubar.addEventListener('focusout', (e) => {
+        requestAnimationFrame(() => {
+          if (!menubar.contains(document.activeElement)) {
+            closeAllSubmenus();
+          }
+        });
+      });
+    })();
+  </script>
 </body>
 
 </html>
