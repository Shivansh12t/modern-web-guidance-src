+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = document.querySelectorAll('.toc-sidebar a');
+    const headers = panel.querySelectorAll('.drink-section h3');
+
+    function setActiveLink(id) {
+      if (!id) return;
+      for (const link of links) {
+        const isMatch = link.getAttribute('href') === `#${id}`;
+        if (isMatch) {
+          link.setAttribute('aria-current', 'location');
+          link.classList.add('active');
+        } else {
+          link.removeAttribute('aria-current');
+          link.classList.remove('active');
+        }
+      }
+    }
+
+    // Listen for native scrollsnapchange event when a section settles into view
+    panel.addEventListener('scrollsnapchange', (event) => {
+      const snappedTarget = event.snapTargetBlock;
+      if (snappedTarget) {
+        const id = snappedTarget.id || snappedTarget.querySelector('[id]')?.id;
+        if (id) setActiveLink(id);
+      }
+    });
+
+    // Fallback for browsers without scrollsnapchange support
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const observer = new IntersectionObserver(
+        () => {
+          const scrollportTop =
+            panel.getBoundingClientRect().top + panel.clientTop;
+          const topEntry = [...headers].reduce((currentTop, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom <= scrollportTop + 1) return currentTop;
+            if (!currentTop) return header;
+            return bottom < currentTop.getBoundingClientRect().bottom
+              ? header
+              : currentTop;
+          }, undefined);
+          if (topEntry) setActiveLink(topEntry.id);
+        },
+        {
+          root: panel,
+          rootMargin: '-1px 0px 0px 0px',
+          threshold: [0, 0.9],
+        },
+      );
+
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    // Smoothly scroll to section when a TOC link is clicked
+    links.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetEl = document.getElementById(targetId);
+        if (targetEl) {
+          event.preventDefault();
+          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          targetEl.scrollIntoView({
+            behavior: prefersReducedMotion ? 'auto' : 'smooth',
+            block: 'start',
+          });
+          targetEl.focus({ preventScroll: true });
+          setActiveLink(targetId);
+          history.replaceState(null, '', href);
+        }
+      });
+    });
+  </script>
