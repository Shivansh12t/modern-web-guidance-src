+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const sections = Array.from(document.querySelectorAll('.drink-section'));
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+
+      if (!panel || sections.length === 0 || tocLinks.length === 0) return;
+
+      function setActiveSection(activeId) {
+        tocLinks.forEach((link) => {
+          const hrefId = link.getAttribute('href').slice(1);
+          const isMatch = hrefId === activeId || link.dataset.target === activeId;
+          if (isMatch) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((section) => {
+          const isMatch = section.id === activeId;
+          if (isMatch) {
+            section.classList.add('active');
+            section.setAttribute('aria-current', 'true');
+          } else {
+            section.classList.remove('active');
+            section.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function findSettledSection() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const header = section.querySelector('header') || section;
+          const rect = header.getBoundingClientRect();
+          const distance = Math.abs(rect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        return closestSection;
+      }
+
+      // Observe sections settling into view within the scroll-snapping panel
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            entries.forEach((entry) => {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
+                setActiveSection(entry.target.id);
+              }
+            });
+          },
+          {
+            root: panel,
+            threshold: [0.5, 0.75]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      // Handle scroll settle events (scrollend + debounced scroll fallback)
+      let scrollTimer = null;
+      panel.addEventListener('scroll', () => {
+        if (scrollTimer) clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(() => {
+          const settled = findSettledSection();
+          if (settled) setActiveSection(settled.id);
+        }, 80);
+      }, { passive: true });
+
+      panel.addEventListener('scrollend', () => {
+        const settled = findSettledSection();
+        if (settled) setActiveSection(settled.id);
+      });
+
+      // Smoothly scroll to the target section when a TOC link is clicked
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          setActiveSection(targetId);
+
+          const targetHeader = targetSection.querySelector('header') || targetSection;
+          const panelTop = panel.getBoundingClientRect().top;
+          const headerTop = targetHeader.getBoundingClientRect().top;
+          const scrollOffset = panel.scrollTop + (headerTop - panelTop);
+
+          panel.scrollTo({
+            top: scrollOffset,
+            behavior: 'smooth'
+          });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', href);
+          }
+        });
+      });
+
+      // Initialize state
+      setActiveSection(sections[0].id);
+    })();
+  </script>
