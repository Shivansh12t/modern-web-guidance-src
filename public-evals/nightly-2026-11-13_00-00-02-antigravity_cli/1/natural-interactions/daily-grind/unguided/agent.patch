+          'height 0.32s cubic-bezier(0.4, 0, 0.2, 1)',
+          'border-radius 0.32s cubic-bezier(0.4, 0, 0.2, 1)',
+          'background-color 0.26s ease',
+          'opacity 0.15s ease 0.2s'
+        ].join(', ');
+
+        expander.style.top = `${btnRect.top}px`;
+        expander.style.left = `${btnRect.left}px`;
+        expander.style.width = `${btnRect.width}px`;
+        expander.style.height = `${btnRect.height}px`;
+        expander.style.borderRadius = '8px';
+        expander.style.backgroundColor = '#4e342e';
+
+        const triggerToFocus = activeTriggerBtn;
+
+        setTimeout(() => {
+          expander.classList.remove('is-active', 'is-closing');
+          expander.setAttribute('aria-hidden', 'true');
+          backdrop.setAttribute('aria-hidden', 'true');
+          triggerToFocus.classList.remove('is-MorphingSource');
+          triggerToFocus.setAttribute('aria-expanded', 'false');
+          triggerToFocus.focus();
+          activeTriggerBtn = null;
+          isAnimating = false;
+        }, 330);
+      }
+
+      document.querySelectorAll('.view-details-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          openDetailFromButton(btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeDetailToButton);
+      dismissBtn.addEventListener('click', closeDetailToButton);
+      backdrop.addEventListener('click', closeDetailToButton);
+
+      orderBtn.addEventListener('click', () => {
+        const title = currentDrinkTitle || 'Seasonal Drink';
+        closeDetailToButton();
+        showToast(`Added ${title} to your order!`);
+      });
+
+      // Keep expanded dialog centered on window resize
+      window.addEventListener('resize', () => {
+        if (!activeTriggerBtn || isAnimating) return;
+        const target = computeTargetBounds();
+        expander.style.transition = 'none';
+        expander.style.top = `${target.top}px`;
+        expander.style.left = `${target.left}px`;
+        expander.style.width = `${target.width}px`;
+        expander.style.height = `${target.height}px`;
+      });
+
+      // Escape key and focus trap inside expanded dialog
+      document.addEventListener('keydown', (e) => {
+        if (!activeTriggerBtn) return;
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          closeDetailToButton();
+          return;
+        }
+        if (e.key === 'Tab') {
+          const focusables = Array.from(
+            expander.querySelectorAll('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])')
+          );
+          if (focusables.length === 0) return;
+          const first = focusables[0];
+          const last = focusables[focusables.length - 1];
+          if (e.shiftKey && document.activeElement === first) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && document.activeElement === last) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
