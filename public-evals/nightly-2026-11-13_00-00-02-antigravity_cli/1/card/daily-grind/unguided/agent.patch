+  <script>
+    (() => {
+      let totalItems = 0;
+      let totalCost = 0;
+      const orderCountEl = document.getElementById('order-count');
+      const orderTotalEl = document.getElementById('order-total');
+
+      document.querySelectorAll('.card').forEach((card) => {
+        const form = card.querySelector('.order-form');
+        const priceDisplay = card.querySelector('[data-price-display]');
+        const submitBtn = card.querySelector('.add-to-order-btn');
+        const feedbackEl = card.querySelector('.order-feedback');
+        const drinkName = card.dataset.drink;
+
+        // Update displayed price when size selection changes
+        form.addEventListener('change', (e) => {
+          if (e.target.matches('input[type="radio"]')) {
+            const price = parseFloat(e.target.dataset.price);
+            if (!Number.isNaN(price) && priceDisplay) {
+              priceDisplay.textContent = `$${price.toFixed(2)}`;
+            }
+          }
+        });
+
+        // Handle adding drink with selected size to the order
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const selectedRadio = form.querySelector('input[type="radio"]:checked');
+          if (!selectedRadio) return;
+
+          const size = selectedRadio.value;
+          const price = parseFloat(selectedRadio.dataset.price) || 0;
+
+          totalItems += 1;
+          totalCost += price;
+
+          if (orderCountEl) orderCountEl.textContent = String(totalItems);
+          if (orderTotalEl) orderTotalEl.textContent = `$${totalCost.toFixed(2)}`;
+
+          const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+          submitBtn.dataset.added = 'true';
+          submitBtn.textContent = `Added (${sizeLabel})`;
+          if (feedbackEl) {
+            feedbackEl.textContent = `Added 1 ${sizeLabel} ${drinkName} ($${price.toFixed(2)}) to your order.`;
+          }
+
+          setTimeout(() => {
+            submitBtn.dataset.added = 'false';
+            submitBtn.textContent = 'Add to Order';
+          }, 1800);
+        });
+      });
+    })();
+  </script>
