+  <script>
+    const statusRegion = document.getElementById('order-status');
+    const orderForms = document.querySelectorAll('.order-form');
+
+    orderForms.forEach((form) => {
+      const priceOutput = form.querySelector('[data-price-output]');
+      const submitBtn = form.querySelector('.order-btn');
+
+      form.addEventListener('change', (event) => {
+        if (event.target.matches('input[name="size"]') && priceOutput) {
+          priceOutput.textContent = event.target.dataset.price || '';
+        }
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(form);
+        const drink = formData.get('drink');
+        const size = formData.get('size');
+        const checkedInput = form.querySelector('input[name="size"]:checked');
+        const price = checkedInput ? checkedInput.dataset.price : '';
+
+        if (statusRegion) {
+          statusRegion.textContent = `Added ${size} ${drink} (${price}) to your order.`;
+        }
+
+        if (submitBtn) {
+          submitBtn.dataset.added = 'true';
+          submitBtn.textContent = 'Added to Order';
+          setTimeout(() => {
+            delete submitBtn.dataset.added;
+            submitBtn.textContent = 'Add to Order';
+          }, 2000);
+        }
+      });
+    });
+
+    /* Fallback for older browsers without :has() support */
+    if (!CSS.supports('selector(:has(*))')) {
+      const cards = document.querySelectorAll('.card');
+      cards.forEach((card) => {
+        if (card.querySelector(':scope > img')) {
+          card.classList.add('has-image');
+        }
+        const syncSelectedState = () => {
+          card.querySelectorAll('.size-option').forEach((opt) => {
+            const radio = opt.querySelector('input[type="radio"]');
+            opt.classList.toggle('is-selected', Boolean(radio && radio.checked));
+          });
+          const largeRadio = card.querySelector('input[name="size"][value="large"]');
+          card.classList.toggle('is-large-selected', Boolean(largeRadio && largeRadio.checked));
+        };
+        syncSelectedState();
+        card.addEventListener('change', syncSelectedState);
+      });
+    }
+  </script>
