+  <script type="module">
+    const ownedExpandedTriggers = new WeakSet();
+
+    function normalizeWhitespace(str) {
+      return (str || "").replace(/\s+/g, " ").trim();
+    }
+
+    function getAccessibleName(el) {
+      const labelledBy = el.getAttribute("aria-labelledby");
+      if (labelledBy) {
+        const text = labelledBy
+          .split(/\s+/)
+          .map((id) => document.getElementById(id)?.textContent || "")
+          .join(" ");
+        if (normalizeWhitespace(text)) return normalizeWhitespace(text);
+      }
+      const ariaLabel = el.getAttribute("aria-label");
+      if (normalizeWhitespace(ariaLabel)) return normalizeWhitespace(ariaLabel);
+
+      let textContent = el.textContent || "";
+      el.querySelectorAll("img[alt]").forEach((img) => {
+        textContent += " " + img.getAttribute("alt");
+      });
+      if (normalizeWhitespace(textContent)) return normalizeWhitespace(textContent);
+
+      return normalizeWhitespace(el.getAttribute("title"));
+    }
+
+    export function wireInterestHints(root = document) {
+      root.querySelectorAll("[interestfor]").forEach((trigger) => {
+        const targetId = trigger.getAttribute("interestfor");
+        if (!targetId) return;
+        const hint = document.getElementById(targetId);
+        if (!hint || hint.getAttribute("popover") !== "hint") return;
+
+        const hintText = normalizeWhitespace(hint.textContent);
+        const triggerName = getAccessibleName(trigger);
+
+        if (hintText && hintText === triggerName) return;
+
+        if (!hint.hasAttribute("role")) {
+          hint.setAttribute("role", "tooltip");
+        }
+
+        if (!triggerName) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", hint.id);
+          }
+          return;
+        }
+
+        const opensOnActivation =
+          trigger.getAttribute("popovertarget") === hint.id ||
+          trigger.getAttribute("commandfor") === hint.id;
+
+        if (opensOnActivation) {
+          if (!trigger.hasAttribute("aria-expanded")) {
+            let isOpen = false;
+            try {
+              isOpen = hint.matches(":popover-open, .\\:popover-open");
+            } catch {
+              isOpen = hint.classList.contains(":popover-open");
+            }
+            trigger.setAttribute("aria-expanded", String(isOpen));
+            ownedExpandedTriggers.add(trigger);
+          }
+        } else {
+          if (!trigger.hasAttribute("aria-describedby")) {
+            trigger.setAttribute("aria-describedby", hint.id);
+          }
+        }
+      });
+    }
+
+    wireInterestHints();
+    window.wireInterestHints = wireInterestHints;
+
+    document.addEventListener(
+      "toggle",
+      (event) => {
+        const hint = event.target;
+        if (!(hint instanceof HTMLElement) || !hint.id) return;
+        const isOpen = event.newState
+          ? event.newState === "open"
+          : hint.matches(":popover-open, .\\:popover-open");
+        document
+          .querySelectorAll(`[interestfor="${CSS.escape(hint.id)}"]`)
+          .forEach((trigger) => {
+            if (ownedExpandedTriggers.has(trigger)) {
+              trigger.setAttribute("aria-expanded", String(isOpen));
+            }
+          });
+      },
+      true
+    );
+
+    const probe = document.createElement("div");
+    probe.popover = "hint";
+    if (probe.popover !== "hint") {
+      document.addEventListener(
+        "beforetoggle",
+        ({ target, newState }) => {
+          const toggletip =
+            target.getAttribute("popover") === "hint" &&
+            document.querySelector(`[popovertarget="${CSS.escape(target.id)}"]`);
+          if (newState === "open" && toggletip) {
+            target.popover = "auto";
+          }
+        },
+        true
+      );
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
