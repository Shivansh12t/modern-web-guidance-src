+  <script>
+    (function () {
+      const anchor = document.getElementById('anchor');
+      const tooltip = document.getElementById('info-tooltip');
+      const arrow = tooltip ? tooltip.querySelector('.tooltip-arrow') : null;
+
+      if (!anchor || !tooltip) return;
+
+      const GAP = 10;
+      const EDGE_PADDING = 8;
+
+      function isTooltipVisible() {
+        if (typeof tooltip.matches === 'function') {
+          try {
+            if (tooltip.matches(':popover-open')) return true;
+          } catch (e) {}
+        }
+        return tooltip.classList.contains('is-open');
+      }
+
+      function updateTooltipPosition() {
+        if (!isTooltipVisible()) return;
+
+        const anchorRect = anchor.getBoundingClientRect();
+        // Reset inline positioning temporarily to measure natural size if needed
+        const tipWidth = tooltip.offsetWidth || 220;
+        const tipHeight = tooltip.offsetHeight || 60;
+        const vw = window.innerWidth;
+        const vh = window.innerHeight;
+
+        const anchorCenterX = anchorRect.left + anchorRect.width / 2;
+        const anchorCenterY = anchorRect.top + anchorRect.height / 2;
+
+        // Calculate available space in all 4 directions around the anchor
+        const spaceTop = anchorRect.top - GAP - EDGE_PADDING;
+        const spaceBottom = vh - anchorRect.bottom - GAP - EDGE_PADDING;
+        const spaceLeft = anchorRect.left - GAP - EDGE_PADDING;
+        const spaceRight = vw - anchorRect.right - GAP - EDGE_PADDING;
+
+        // Determine primary placement with dynamic flipping against viewport edges
+        let placement = 'top';
+        if (spaceTop >= tipHeight) {
+          placement = 'top';
+        } else if (spaceBottom >= tipHeight) {
+          placement = 'bottom';
+        } else if (spaceRight >= tipWidth) {
+          placement = 'right';
+        } else if (spaceLeft >= tipWidth) {
+          placement = 'left';
+        } else {
+          // Pick the side with the greatest available space
+          const maxSpace = Math.max(spaceTop, spaceBottom, spaceRight, spaceLeft);
+          if (maxSpace === spaceBottom) placement = 'bottom';
+          else if (maxSpace === spaceTop) placement = 'top';
+          else if (maxSpace === spaceRight) placement = 'right';
+          else placement = 'left';
+        }
+
+        let top = 0;
+        let left = 0;
+
+        if (placement === 'top' || placement === 'bottom') {
+          top = placement === 'top'
+            ? anchorRect.top - tipHeight - GAP
+            : anchorRect.bottom + GAP;
+
+          // Center horizontally on anchor, clamped to viewport edges
+          left = anchorCenterX - tipWidth / 2;
+          const minLeft = EDGE_PADDING;
+          const maxLeft = Math.max(EDGE_PADDING, vw - tipWidth - EDGE_PADDING);
+          left = Math.min(Math.max(left, minLeft), maxLeft);
+
+          // Point arrow directly at the anchor center
+          const arrowX = Math.min(Math.max(anchorCenterX - left, 14), tipWidth - 14);
+          tooltip.style.setProperty('--arrow-x', `${arrowX}px`);
+          tooltip.style.removeProperty('--arrow-y');
+        } else {
+          left = placement === 'left'
+            ? anchorRect.left - tipWidth - GAP
+            : anchorRect.right + GAP;
+
+          // Center vertically on anchor, clamped to viewport edges
+          top = anchorCenterY - tipHeight / 2;
+          const minTop = EDGE_PADDING;
+          const maxTop = Math.max(EDGE_PADDING, vh - tipHeight - EDGE_PADDING);
+          top = Math.min(Math.max(top, minTop), maxTop);
+
+          // Point arrow directly at the anchor center
+          const arrowY = Math.min(Math.max(anchorCenterY - top, 14), tipHeight - 14);
+          tooltip.style.setProperty('--arrow-y', `${arrowY}px`);
+          tooltip.style.removeProperty('--arrow-x');
+        }
+
+        tooltip.dataset.placement = placement;
+        if (arrow) {
+          arrow.dataset.placement = placement;
+        }
+        tooltip.style.top = `${Math.round(top)}px`;
+        tooltip.style.left = `${Math.round(left)}px`;
+        tooltip.style.margin = '0';
+      }
+
+      function showTooltip() {
+        tooltip.classList.add('is-open');
+        if (typeof tooltip.showPopover === 'function') {
+          try {
+            if (!tooltip.matches(':popover-open')) {
+              tooltip.showPopover();
+            }
+          } catch (e) {}
+        }
+        anchor.setAttribute('aria-expanded', 'true');
+        updateTooltipPosition();
+      }
+
+      function hideTooltip() {
+        tooltip.classList.remove('is-open');
+        if (typeof tooltip.hidePopover === 'function') {
+          try {
+            if (tooltip.matches(':popover-open')) {
+              tooltip.hidePopover();
+            }
+          } catch (e) {}
+        }
+        anchor.setAttribute('aria-expanded', 'false');
+      }
+
+      // Toggle on popover event (when triggered via native popovertarget click)
+      tooltip.addEventListener('toggle', () => {
+        if (isTooltipVisible()) {
+          tooltip.classList.add('is-open');
+          anchor.setAttribute('aria-expanded', 'true');
+          updateTooltipPosition();
+        } else {
+          tooltip.classList.remove('is-open');
+          anchor.setAttribute('aria-expanded', 'false');
+        }
+      });
+
+      // Also support hover and focus for standard tooltip ergonomics
+      anchor.addEventListener('mouseenter', showTooltip);
+      anchor.addEventListener('mouseleave', (e) => {
+        if (document.activeElement !== anchor) {
+          hideTooltip();
+        }
+      });
+      anchor.addEventListener('focus', showTooltip);
+      anchor.addEventListener('blur', hideTooltip);
+
+      // Fallback click handler for environments without native Popover API
+      anchor.addEventListener('click', (e) => {
+        if (typeof tooltip.showPopover !== 'function') {
+          e.preventDefault();
+          if (tooltip.classList.contains('is-open')) {
+            hideTooltip();
+          } else {
+            showTooltip();
+          }
+        } else {
+          requestAnimationFrame(updateTooltipPosition);
+        }
+      });
+
+      window.addEventListener('scroll', updateTooltipPosition, { passive: true, capture: true });
+      window.addEventListener('resize', updateTooltipPosition, { passive: true });
+    })();
+  </script>
