+          observer.disconnect();
+        }
+      });
+      observer.observe(cardsGrid, { childList: true });
+    }
+
+    // 1. Safe HTML Sanitization for untrusted customer-submitted reviews (Sanitizer API + DOMPurify fallback)
+    const REVIEW_ALLOWED_ELEMENTS = ['div', 'p', 'b', 'i', 'strong', 'em', 'span', 'blockquote'];
+    const REVIEW_ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://esm.sh/dompurify').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function renderSafeReviewHTML(container, untrustedHTML, append = false) {
+      const target = append ? document.createElement('div') : container;
+      if (append) {
+        target.className = 'review-item';
+      }
+
+      if ('setHTML' in Element.prototype) {
+        // Native Sanitizer API strips scripts, event handlers, and disallowed elements/attributes
+        target.setHTML(untrustedHTML, {
+          sanitizer: {
+            elements: REVIEW_ALLOWED_ELEMENTS,
+            attributes: REVIEW_ALLOWED_ATTRIBUTES
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        target.innerHTML = DOMPurify.sanitize(untrustedHTML, {
+          ALLOWED_TAGS: [...REVIEW_ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: REVIEW_ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+
+      if (append) {
+        container.appendChild(target);
+      }
+    }
+
