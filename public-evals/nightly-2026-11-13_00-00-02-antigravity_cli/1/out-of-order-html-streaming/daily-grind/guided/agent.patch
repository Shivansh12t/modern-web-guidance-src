+            controller.enqueue(freshServerHTML);
+            controller.close();
+          }
+        });
+        await stream.pipeTo(cardsGrid.streamHTML());
+      } else if ('setHTML' in cardsGrid) {
+        cardsGrid.setHTML(freshServerHTML);
+      } else {
+        const doc = new DOMParser().parseFromString(freshServerHTML, 'text/html');
+        cardsGrid.replaceChildren(...doc.body.childNodes);
+      }
+
+      cardsGrid.setAttribute('aria-busy', 'false');
+      if (statusRegion) {
+        statusRegion.textContent = 'Seasonal favorites menu updated.';
+      }
+    }
