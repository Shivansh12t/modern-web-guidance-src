+
+    export async function refreshSeasonalCards(endpoint = '/api/seasonal-favorites') {
+      if (!cardsGrid) return;
+
+      cardsGrid.setAttribute('aria-busy', 'true');
+      if (statusRegion) {
+        statusRegion.textContent = 'Refreshing seasonal favorites menu...';
+      }
+
+      try {
+        const response = await fetch(endpoint, { headers: { Accept: 'text/html' } });
+        if (response.ok) {
+          // Stream fresh HTML directly into the container using native streaming HTML setter APIs
+          if ('streamHTML' in cardsGrid && 'textStream' in response) {
+            await response.textStream().pipeTo(cardsGrid.streamHTML());
+          } else if ('streamHTML' in cardsGrid && response.body) {
+            await response.body
+              .pipeThrough(new TextDecoderStream())
+              .pipeTo(cardsGrid.streamHTML());
+          } else {
+            const html = await response.text();
+            if ('setHTML' in cardsGrid) {
+              cardsGrid.setHTML(html);
+            } else {
+              await renderSafeReviewHTML(cardsGrid, html);
