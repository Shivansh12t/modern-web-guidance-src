+          }
+          cardsGrid.setAttribute('aria-busy', 'false');
+          if (statusRegion) {
+            statusRegion.textContent = 'Seasonal favorites menu updated.';
+          }
+          return;
+        }
+      } catch {
+        // Fallback to simulated server stream when running against a static file server
+      }
+
+      const freshServerHTML = fallbackMenuRotation[rotationIndex % fallbackMenuRotation.length];
+      rotationIndex += 1;
+
+      if ('streamHTML' in cardsGrid) {
+        const stream = new ReadableStream({
