     }
 
+    /* Store Selector Dropdown */
+    .store-picker-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.35rem;
+      margin-top: 1.25rem;
+      width: 100%;
+      max-width: 320px;
+      text-align: left;
+    }
+
+    .store-picker-label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      letter-spacing: 0.04em;
+      color: var(--light);
+    }
+
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 0.75rem 1rem;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      background-color: var(--light);
+      color: var(--text);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    .store-select:hover {
+      border-color: var(--accent);
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+      border-color: var(--accent);
+    }
+
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    .store-select::picker(select) {
+      background-color: white;
+      color: var(--text);
+      border: 2px solid var(--secondary);
+      border-radius: 10px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.2);
+      padding: 0.5rem;
+      margin-top: 0.25rem;
+      width: anchor-size(width);
+      transition:
+        display,
+        overlay,
+        opacity cubic-bezier(0.16, 1, 0.3, 1),
+        height cubic-bezier(0.16, 1, 0.3, 1);
+      transition-duration: 0.35s;
+      transition-behavior: allow-discrete;
+      opacity: 0;
+      height: 0;
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      height: auto;
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        height: 0;
+      }
+    }
+
+    .store-select option {
+      padding: 0.625rem 0.75rem;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .store-select option:hover {
+      background-color: #f5ebe6;
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+      background-color: var(--secondary);
+      color: var(--text);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none !important;
+      }
+    }
+
