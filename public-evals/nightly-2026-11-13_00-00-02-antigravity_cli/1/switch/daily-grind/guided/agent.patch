@@ -207,6 +307,36 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const toggle = document.getElementById('order-notifications');
+    const statusBadge = document.getElementById('preference-status');
+    const STORAGE_KEY = 'dailyGrind.orderNotifications';
+
+    function syncPreferenceUI(isEnabled) {
+      if (!statusBadge) return;
+      statusBadge.textContent = isEnabled ? 'On' : 'Off';
+      statusBadge.dataset.enabled = String(isEnabled);
+    }
+
+    if (toggle) {
+      const saved = localStorage.getItem(STORAGE_KEY);
+      if (saved !== null) {
+        toggle.checked = saved === 'true';
+      }
+      syncPreferenceUI(toggle.checked);
+
+      toggle.addEventListener('change', (event) => {
+        const isEnabled = event.currentTarget.checked;
+        localStorage.setItem(STORAGE_KEY, String(isEnabled));
+        syncPreferenceUI(isEnabled);
+      });
+    }
+  </script>
+
 </body>
 
