+  <script>
+    const notificationsSwitch = document.getElementById('notifications');
+    const preferenceStatus = document.getElementById('preference-status');
+    const STORAGE_KEY = 'daily-grind:notifications-enabled';
+
+    function updatePreferenceUI(isEnabled) {
+      preferenceStatus.textContent = isEnabled
+        ? 'Notifications are enabled for seasonal roasts and order updates.'
+        : 'Notifications are currently off.';
+    }
+
+    const savedPreference = localStorage.getItem(STORAGE_KEY);
+    if (savedPreference !== null) {
+      notificationsSwitch.checked = savedPreference === 'true';
+      updatePreferenceUI(notificationsSwitch.checked);
+    }
+
+    notificationsSwitch.addEventListener('change', (event) => {
+      const isEnabled = event.currentTarget.checked;
+      localStorage.setItem(STORAGE_KEY, String(isEnabled));
+      updatePreferenceUI(isEnabled);
+    });
+  </script>
+
