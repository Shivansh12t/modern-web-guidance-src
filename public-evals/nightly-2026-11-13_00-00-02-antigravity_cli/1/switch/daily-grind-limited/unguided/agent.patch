+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_brew_notifications';
+      const toggleInput = document.getElementById('preference-toggle');
+      const stateLabel = document.getElementById('preference-state-label');
+      const feedbackText = document.getElementById('preference-feedback');
+
+      function applyPreferenceState(isEnabled) {
+        toggleInput.checked = isEnabled;
+        toggleInput.setAttribute('aria-checked', String(isEnabled));
+        const stateText = isEnabled ? 'On' : 'Off';
+        stateLabel.textContent = stateText;
+        stateLabel.setAttribute('data-state', isEnabled ? 'on' : 'off');
+        feedbackText.textContent = 'Current setting: Notifications are ' + stateText + '.';
+      }
+
+      try {
+        const savedValue = localStorage.getItem(STORAGE_KEY);
+        if (savedValue !== null) {
+          applyPreferenceState(savedValue === 'true');
+        } else {
+          applyPreferenceState(false);
+        }
+      } catch (e) {
+        applyPreferenceState(false);
+      }
+
+      toggleInput.addEventListener('change', function (event) {
+        const isEnabled = Boolean(event.target.checked);
+        applyPreferenceState(isEnabled);
+        try {
+          localStorage.setItem(STORAGE_KEY, String(isEnabled));
+        } catch (e) {
+          // Ignore storage errors in restricted environments
+        }
+      });
+    })();
+  </script>
+
