+          --price-bg: #efebe9;
+          --price-color: var(--_primary);
+        }
+      }
+
+      @layer states {
+        :host(:hover),
+        :host(:focus-within) {
+          transform: translateY(-4px);
+          box-shadow: 0 12px 28px rgba(62, 39, 35, 0.18);
+        }
+
+        :host(:hover) .card-image {
+          transform: scale(1.04);
+        }
+
+        .card-btn:hover,
+        .card-btn:focus-visible {
+          background: var(--btn-hover-bg);
+          transform: translateY(-1px);
+        }
+
+        .card-btn:focus-visible {
+          outline: 2px solid var(--_accent);
+          outline-offset: 2px;
+        }
+
+        @media (prefers-reduced-motion: reduce) {
+          :host,
+          .card-image,
+          .card-btn {
+            transition: none;
+          }
+
+          :host(:hover),
+          :host(:focus-within) {
+            transform: none;
+          }
+        }
+      }
+    </style>
+
+    <article class="card-frame" part="card">
+      <div class="card-media" part="media">
+        <slot name="media">
+          <img class="card-image" part="image" src="" alt="" loading="lazy">
+        </slot>
+        <span class="card-badge" part="badge"></span>
+      </div>
+
+      <div class="card-content" part="content">
+        <header class="card-header" part="header">
+          <slot name="title">
+            <h3>Seasonal Drink</h3>
+          </slot>
+          <span class="card-price" part="price"></span>
+        </header>
+
+        <div class="card-body" part="body">
+          <slot></slot>
+          <slot name="notes"></slot>
+        </div>
+
+        <footer class="card-footer" part="footer">
+          <span class="card-meta" part="meta"></span>
+          <a class="card-btn" part="button cta" href="#">
+            <slot name="cta">View Details</slot>
+          </a>
+        </footer>
+      </div>
+    </article>
+  </template>
+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['variant', 'badge', 'price', 'meta', 'href', 'image', 'image-alt', 'featured'];
+      }
+
+      constructor() {
+        super();
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        if (template) {
+          shadowRoot.appendChild(template.content.cloneNode(true));
+        }
+      }
+
+      connectedCallback() {
+        this.#syncAttributes();
+      }
+
+      attributeChangedCallback() {
+        if (this.isConnected) {
+          this.#syncAttributes();
+        }
+      }
+
+      #syncAttributes() {
+        const badgeEl = this.shadowRoot.querySelector('[part="badge"]');
+        const priceEl = this.shadowRoot.querySelector('[part="price"]');
+        const metaEl = this.shadowRoot.querySelector('[part="meta"]');
+        const btnEl = this.shadowRoot.querySelector('[part~="button"]');
+        const imgEl = this.shadowRoot.querySelector('[part="image"]');
+
+        if (badgeEl) {
+          badgeEl.textContent = this.getAttribute('badge') || '';
+        }
+
+        if (priceEl) {
+          priceEl.textContent = this.getAttribute('price') || '';
+        }
+
+        if (metaEl) {
+          metaEl.textContent = this.getAttribute('meta') || '';
+        }
+
+        if (btnEl) {
+          btnEl.setAttribute('href', this.getAttribute('href') || '#');
+        }
+
+        if (imgEl) {
+          const src = this.getAttribute('image') || '';
+          const alt = this.getAttribute('image-alt') || this.querySelector('[slot="title"]')?.textContent || 'Coffee drink';
+          if (src) {
+            imgEl.setAttribute('src', src);
+            imgEl.removeAttribute('hidden');
+          } else {
+            imgEl.setAttribute('hidden', '');
+          }
+          imgEl.setAttribute('alt', alt);
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
 </html>
