+  <script type="module">
+    const drinkCardSheet = new CSSStyleSheet();
+    drinkCardSheet.replaceSync(`
+      @layer reset, base, theme, variants, responsive;
+
+      @layer reset {
+        article, header, footer, div, span, a {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+      }
+
+      @layer base {
+        :host {
+          display: block;
+          container-type: inline-size;
+          container-name: drink-card;
+          /* Private shadow aliases reading inherited site theme tokens with fallbacks */
+          --_primary: var(--drink-card-primary, var(--primary, #4e342e));
+          --_secondary: var(--drink-card-secondary, var(--secondary, #d7ccc8));
+          --_accent: var(--drink-card-accent, var(--accent, #ffab40));
+          --_text: var(--drink-card-text, var(--text, #3e2723));
+          --_bg: var(--drink-card-bg, #ffffff);
+          --_radius: var(--drink-card-radius, 8px);
+          --_border-color: transparent;
+          --_shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          color: var(--_text);
+          font-family: inherit;
+          line-height: inherit;
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        article {
+          background: var(--_bg);
+          color: var(--_text);
+          border: 2px solid var(--_border-color);
+          border-radius: var(--_radius);
+          box-shadow: var(--_shadow);
+          padding: 20px;
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          text-align: center;
+          gap: 12px;
+          height: 100%;
+          overflow: clip;
+        }
+
+        .content {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 8px;
+          flex: 1;
+          width: 100%;
+        }
+
+        header {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 6px;
+        }
+
+        .badge {
+          display: inline-block;
+          font-size: 0.75rem;
+          font-weight: 600;
+          padding: 2px 10px;
+          border-radius: 999px;
+          background: var(--_secondary);
+          color: var(--_primary);
+        }
+
+        .badge[hidden] {
+          display: none;
+        }
+
+        footer {
+          margin-top: auto;
+          padding-top: 6px;
+        }
+
+        .action {
+          display: inline-block;
+          background: var(--_primary);
+          color: #ffffff;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          font: inherit;
+          font-weight: 500;
+          transition: background 0.3s ease, color 0.3s ease;
+        }
+
+        .action:hover {
+          background: var(--_text);
+        }
+
+        ::slotted([slot="media"]) {
+          width: 100%;
+          aspect-ratio: 16 / 10;
+          object-fit: cover;
+          border-radius: calc(var(--_radius) - 2px);
+          display: block;
+        }
+
+        ::slotted([slot="title"]) {
+          margin: 0;
+          color: var(--_primary);
+        }
+
+        ::slotted(p) {
+          margin: 0;
+          line-height: 1.5;
+        }
+      }
+
+      @layer theme {
+        :host {
+          border-radius: var(--_radius);
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          --_border-color: var(--_accent);
+          --_shadow: 0 6px 16px rgba(78, 52, 46, 0.16);
+          --_bg: linear-gradient(135deg, #ffffff 0%, #fff8ef 100%);
+        }
+
+        :host([variant="featured"]) .badge {
+          background: var(--_accent);
+          color: var(--_text);
+        }
+
+        :host([variant="roast"]) {
+          --_border-color: var(--_primary);
+          --_shadow: 0 4px 10px rgba(62, 39, 35, 0.14);
+        }
+
+        :host([variant="roast"]) .badge {
+          background: var(--_primary);
+          color: #ffffff;
+        }
+
+        :host([variant="refreshing"]) {
+          --_border-color: var(--_secondary);
+        }
+      }
+
+      @layer responsive {
+        @container drink-card (min-width: 480px) {
+          article {
+            display: grid;
+            grid-template-columns: minmax(180px, 240px) 1fr;
+            align-items: center;
+            text-align: start;
+            gap: 24px;
