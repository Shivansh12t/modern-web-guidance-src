+
+          header {
+            flex-direction: row;
+            flex-wrap: wrap;
+            align-items: center;
+            gap: 10px;
+          }
+        }
+      }
+    `);
+
+    const drinkCardTemplate = document.createElement('template');
+    drinkCardTemplate.innerHTML = `
+      <article part="card">
+        <slot name="media"></slot>
+        <div class="content" part="content">
+          <header part="header">
+            <span class="badge" part="badge" hidden></span>
+            <slot name="title"></slot>
+          </header>
+          <div class="description" part="description">
+            <slot></slot>
+          </div>
+          <footer part="footer">
+            <slot name="action">
+              <a class="action" part="action" href="#">View Details</a>
+            </slot>
+          </footer>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['variant', 'badge', 'href', 'action-label'];
+
+      #badgeEl;
+      #actionEl;
+      #mediaSlot;
+
+      constructor() {
+        super();
+        const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+        shadow.adoptedStyleSheets = [drinkCardSheet];
+        shadow.append(drinkCardTemplate.content.cloneNode(true));
+
+        this.#badgeEl = shadow.querySelector('.badge');
+        this.#actionEl = shadow.querySelector('.action');
+        this.#mediaSlot = shadow.querySelector('slot[name="media"]');
+
+        this.#mediaSlot.addEventListener('slotchange', () => {
+          const hasMedia = this.#mediaSlot.assignedElements().length > 0;
+          this.toggleAttribute('has-media', hasMedia);
+        });
+      }
+
+      connectedCallback() {
+        this.#syncAttributes();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue !== newValue) {
+          this.#syncAttributes();
+        }
+      }
+
+      get variant() {
+        return this.getAttribute('variant') ?? '';
+      }
+
+      set variant(val) {
+        val ? this.setAttribute('variant', val) : this.removeAttribute('variant');
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(val) {
+        val ? this.setAttribute('badge', val) : this.removeAttribute('badge');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '#';
+      }
+
+      set href(val) {
+        val ? this.setAttribute('href', val) : this.removeAttribute('href');
+      }
+
+      get actionLabel() {
+        return this.getAttribute('action-label') ?? 'View Details';
+      }
+
+      set actionLabel(val) {
+        val ? this.setAttribute('action-label', val) : this.removeAttribute('action-label');
+      }
+
+      #syncAttributes() {
+        if (this.#badgeEl) {
+          const badgeText = this.badge;
+          this.#badgeEl.textContent = badgeText;
+          this.#badgeEl.hidden = !badgeText;
+        }
+        if (this.#actionEl) {
+          this.#actionEl.setAttribute('href', this.href);
+          this.#actionEl.textContent = this.actionLabel;
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
