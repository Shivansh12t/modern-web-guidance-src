@@ -0,0 +1,139 @@
+// Client-side helper that catches blocked or failed outbound requests gracefully
+// without unhandled rejections and surfaces a clear message to the customer.
+export async function fetchWithPolicyHandling(url, { statusElement, ...fetchOptions } = {}) {
+  try {
+    const response = await fetch(url, fetchOptions);
+    const contentType = response.headers.get('content-type') || '';
+    const payload = contentType.includes('application/json')
+      ? await response.json()
+      : await response.text();
+
+    if (!response.ok) {
+      const errorText =
+        typeof payload === 'object' && payload !== null && payload.error
+          ? payload.error
+          : `HTTP ${response.status}`;
+      throw new Error(errorText);
+    }
+
+    const successMessage =
+      typeof payload === 'object' && payload !== null && payload.message
+        ? payload.message
+        : `Success: Request to ${url} completed.`;
+
+    if (statusElement) {
+      statusElement.dataset.state = 'success';
+      statusElement.textContent = successMessage;
+    }
+
+    return { ok: true, body: payload, error: null };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    if (statusElement) {
+      statusElement.dataset.state = 'error';
+      statusElement.textContent = `We couldn't complete your request to ${url}. The connection could not go through or was blocked by our outbound security policy (${message}). Please try again.`;
+    }
+    return { ok: false, body: null, error };
+  }
+}
+
+export function validateEmailInput(emailInput, errorElement) {
+  const value = emailInput.value.trim();
+  emailInput.setCustomValidity('');
+
+  if (!value) {
+    emailInput.setCustomValidity('Please enter your email address to subscribe.');
+  } else if (emailInput.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+    emailInput.setCustomValidity('Please enter a valid email address (for example, alex@example.com).');
+  }
+
+  const isValid = emailInput.checkValidity();
+  if (!isValid) {
+    emailInput.setAttribute('aria-invalid', 'true');
+    if (errorElement) {
+      errorElement.textContent = `Error: ${emailInput.validationMessage}`;
+    }
+  } else {
+    emailInput.removeAttribute('aria-invalid');
+    if (errorElement) {
+      errorElement.textContent = '';
+    }
+  }
+
+  return isValid;
+}
+
+export function initNewsletterForm(doc = document) {
+  const form = doc.getElementById('newsletter-form');
+  const emailInput = doc.getElementById('newsletter-email');
+  const errorElement = doc.getElementById('newsletter-error');
+  const statusElement = doc.getElementById('newsletter-status');
+  const submitButton = doc.getElementById('newsletter-submit');
+
+  if (!form || !emailInput) return;
+
+  // Clear existing validation errors while typing without premature warnings
+  emailInput.addEventListener('input', () => {
+    emailInput.setCustomValidity('');
+    emailInput.removeAttribute('aria-invalid');
+    if (errorElement) {
+      errorElement.textContent = '';
+    }
+  });
+
+  // Contextual validation when exiting the field if edited
+  emailInput.addEventListener('blur', () => {
+    if (emailInput.value.trim().length > 0) {
+      validateEmailInput(emailInput, errorElement);
+    }
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+
+    if (!validateEmailInput(emailInput, errorElement)) {
+      emailInput.focus();
+      return;
+    }
+
+    const targetUrl = form.getAttribute('action') || '/api/newsletter';
+    const email = emailInput.value.trim();
+
+    if (submitButton) {
+      submitButton.disabled = true;
+    }
+    if (statusElement) {
+      statusElement.dataset.state = 'pending';
+      statusElement.textContent = 'Sending your subscription request...';
+    }
+
+    try {
+      const result = await fetchWithPolicyHandling(targetUrl, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          Accept: 'application/json',
+        },
+        body: JSON.stringify({ email }),
+        statusElement,
+      });
+
+      if (result.ok) {
+        form.reset();
+        emailInput.removeAttribute('aria-invalid');
+      }
+    } finally {
+      if (submitButton) {
+        submitButton.disabled = false;
+      }
+    }
+  });
+}
+
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', () => initNewsletterForm(document));
+  } else {
+    initNewsletterForm(document);
+  }
+}
