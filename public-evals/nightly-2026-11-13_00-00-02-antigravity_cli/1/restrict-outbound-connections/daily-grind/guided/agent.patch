@@ -0,0 +1,349 @@
+import http from 'node:http';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+export const UNSPLASH_ORIGIN = 'https://images.unsplash.com';
+export const DEFAULT_STYLE_HASH = 'sha256-NwprO4c4XdAbX8gCeIoFdYkVyYJu0u4nXsXN4YUEmC4=';
+export const ALLOWLIST_DESTS = new Set([
+  'document',
+  'iframe',
+  'worker',
+  'sharedworker',
+  'serviceworker',
+]);
+
+export const subscribers = new Set();
+export const securityReports = [];
+
+// Normalize a config URL or URLPattern string for Connection-Allowlist:
+// - Rewrites ws:// and wss:// to http:// and https:// (WebSocket matching rule).
+// - Strips a bare trailing slash on origin-only URLs (e.g. from new URL(...).href)
+//   so all subpaths on the origin are permitted instead of only "/".
+export function normalizeAllowlistPattern(rawPattern) {
+  const trimmed = String(rawPattern).trim().replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\//i.test(trimmed)) {
+    throw new Error(`Pattern must include an http:// or https:// scheme: ${rawPattern}`);
+  }
+  if (/[\s,]/.test(trimmed)) {
+    throw new Error(`Pattern must be a single URLPattern without spaces or commas: ${rawPattern}`);
+  }
+  if (/[()]/.test(trimmed)) {
+    throw new Error(`Custom regex groups are rejected by Connection-Allowlist: ${rawPattern}`);
+  }
+  return trimmed.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+// Build an RFC 9651 Inner List value for Connection-Allowlist or Connection-Allowlist-Report-Only.
+export function buildConnectionAllowlistHeader({
+  allowSelf = true,
+  patterns = [UNSPLASH_ORIGIN],
+  reportTo = 'conn-reports',
+  redirects = 'block',
+  webrtc = 'block',
+} = {}) {
+  const items = allowSelf ? ['response-origin'] : [];
+  for (const pattern of patterns) {
+    const raw = String(pattern).trim();
+    if (raw === 'response-origin') {
+      if (!items.includes('response-origin')) items.push('response-origin');
+      continue;
+    }
+    const normalized = normalizeAllowlistPattern(raw);
+    items.push(`"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let header = `(${items.join(' ')})`;
+  if (redirects === 'allow') header += '; redirects=allow';
+  if (webrtc === 'allow') header += '; webrtc=allow';
+  if (reportTo) {
+    const endpointToken = String(reportTo).trim().replace(/^"+|"+$/g, '');
+    header += `; report-to=${endpointToken}`;
+  }
+  return header;
+}
+
+// Build companion Content-Security-Policy header for cross-browser defense-in-depth.
+export function buildCspHeader({
+  styleHashes = [DEFAULT_STYLE_HASH],
+  reportTo = 'conn-reports',
+} = {}) {
+  const styleSources = ["'self'", ...styleHashes.map((h) => `'${h.replace(/^'+|'+$/g, '')}'`)].join(' ');
+  const directives = [
+    "default-src 'self'",
+    "connect-src 'self'",
+    `img-src 'self' ${UNSPLASH_ORIGIN} data: blob:`,
+    `style-src ${styleSources}`,
+    "script-src 'self' 'report-sample'",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'self'",
+    "frame-ancestors 'none'",
+  ];
+  if (reportTo) {
+    directives.push(`report-to ${reportTo}`);
+  }
+  return directives.join('; ');
+}
+
+// Apply Connection-Allowlist, Reporting-Endpoints, and companion CSP headers
+// on document and worker responses.
+export function setConnectionAllowlistHeaders(res, options = {}) {
+  const {
+    secFetchDest = 'document',
+    patterns = [UNSPLASH_ORIGIN],
+    reportOnlyPatterns,
+    reportEndpointName = 'conn-reports',
+    reportEndpointUrl = '/api/security-reports',
+    redirects = 'block',
+    webrtc = 'block',
+    reportOnly = false,
+    styleHashes = [DEFAULT_STYLE_HASH],
+  } = options;
+
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers.set(name, value);
+
+  if (typeof res.appendHeader === 'function') {
+    res.appendHeader('Vary', 'Sec-Fetch-Dest');
+  } else if (typeof res.headers?.append === 'function') {
+    res.headers.append('Vary', 'Sec-Fetch-Dest');
+  } else {
+    setHeader('Vary', 'Sec-Fetch-Dest');
+  }
+
+  if (secFetchDest && !ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) {
+    return;
+  }
+
+  setHeader('Reporting-Endpoints', `${reportEndpointName}="${reportEndpointUrl}"`);
+  setHeader(
+    reportOnly ? 'Connection-Allowlist-Report-Only' : 'Connection-Allowlist',
+    buildConnectionAllowlistHeader({
+      allowSelf: true,
+      patterns,
+      reportTo: reportEndpointName,
+      redirects,
+      webrtc,
+    }),
+  );
+
+  if (!reportOnly && Array.isArray(reportOnlyPatterns)) {
+    setHeader(
+      'Connection-Allowlist-Report-Only',
+      buildConnectionAllowlistHeader({
+        allowSelf: true,
+        patterns: reportOnlyPatterns,
+        reportTo: reportEndpointName,
+        redirects,
+        webrtc,
+      }),
+    );
+  }
+
+  setHeader('Content-Security-Policy', buildCspHeader({ styleHashes, reportTo: reportEndpointName }));
+}
+
+function setCompanionSecurityHeaders(res) {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+  );
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+}
+
+function readRequestBody(req, maxBytes = 16 * 1024) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let total = 0;
+    req.on('data', (chunk) => {
+      total += chunk.length;
+      if (total > maxBytes) {
+        reject(new Error('Payload too large'));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function isValidEmail(email) {
+  if (typeof email !== 'string') return false;
+  const trimmed = email.trim();
+  if (!trimmed || trimmed.length > 254) return false;
+  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed);
+}
+
+export async function handleRequest(req, res) {
+  setCompanionSecurityHeaders(res);
+
+  const host = req.headers.host || `localhost:${process.env.PORT || 11222}`;
+  const proto = req.headers['x-forwarded-proto'] || 'http';
+  const reportEndpointUrl = `${proto}://${host}/api/security-reports`;
+  const url = new URL(req.url || '/', `${proto}://${host}`);
+  const pathname = url.pathname;
+
+  if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+    const htmlPath = path.join(__dirname, 'index.html');
+    const html = await fs.readFile(htmlPath, 'utf8');
+    const styleMatch = html.match(/<style>([\s\S]*?)<\/style>/);
+    const styleHash = styleMatch
+      ? `sha256-${crypto.createHash('sha256').update(styleMatch[1], 'utf8').digest('base64')}`
+      : DEFAULT_STYLE_HASH;
+
+    const secFetchDest = req.headers['sec-fetch-dest'] || 'document';
+    setConnectionAllowlistHeaders(res, {
+      secFetchDest,
+      patterns: [UNSPLASH_ORIGIN],
+      reportEndpointName: 'conn-reports',
+      reportEndpointUrl,
+      styleHashes: [styleHash],
+    });
+
+    res.statusCode = 200;
+    res.setHeader('Content-Type', 'text/html; charset=utf-8');
+    res.end(html);
+    return;
+  }
+
+  if (req.method === 'GET' && pathname === '/app.js') {
+    const jsPath = path.join(__dirname, 'app.js');
+    const js = await fs.readFile(jsPath, 'utf8');
+    const secFetchDest = req.headers['sec-fetch-dest'] || 'script';
+    setConnectionAllowlistHeaders(res, {
+      secFetchDest,
+      patterns: [UNSPLASH_ORIGIN],
+      reportEndpointName: 'conn-reports',
+      reportEndpointUrl,
+    });
+
+    res.statusCode = 200;
+    res.setHeader('Content-Type', 'application/javascript; charset=utf-8');
+    res.end(js);
+    return;
+  }
+
+  if (req.method === 'POST' && (pathname === '/api/newsletter' || pathname === '/newsletter')) {
+    res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+    const site = req.headers['sec-fetch-site'];
+    if (site && !['same-origin', 'same-site', 'none'].includes(String(site).toLowerCase())) {
+      res.statusCode = 403;
+      res.setHeader('Content-Type', 'application/json; charset=utf-8');
+      res.end(JSON.stringify({ ok: false, error: 'Cross-site requests are not permitted.' }));
+      return;
+    }
+
+    let rawBody = '';
+    try {
+      rawBody = await readRequestBody(req);
+    } catch {
+      res.statusCode = 413;
+      res.setHeader('Content-Type', 'application/json; charset=utf-8');
+      res.end(JSON.stringify({ ok: false, error: 'Request payload is too large.' }));
+      return;
+    }
+
+    const contentType = String(req.headers['content-type'] || '').toLowerCase();
+    let email = '';
+    if (contentType.includes('application/json')) {
+      try {
+        const parsed = JSON.parse(rawBody || '{}');
+        email = typeof parsed.email === 'string' ? parsed.email.trim() : '';
+      } catch {
+        res.statusCode = 400;
+        res.setHeader('Content-Type', 'application/json; charset=utf-8');
+        res.end(JSON.stringify({ ok: false, error: 'Invalid JSON payload.' }));
+        return;
+      }
+    } else {
+      const params = new URLSearchParams(rawBody);
+      email = (params.get('email') || '').trim();
+    }
+
+    if (!isValidEmail(email)) {
+      res.statusCode = 400;
+      res.setHeader('Content-Type', 'application/json; charset=utf-8');
+      res.end(
+        JSON.stringify({
+          ok: false,
+          error: 'Please enter a valid email address (for example, alex@example.com).',
+        }),
+      );
+      return;
+    }
+
+    subscribers.add(email.toLowerCase());
+    res.statusCode = 200;
+    res.setHeader('Content-Type', 'application/json; charset=utf-8');
+    res.end(
+      JSON.stringify({
+        ok: true,
+        email,
+        message: `Thanks for subscribing, ${email}! You're on The Daily Grind newsletter list.`,
+      }),
+    );
+    return;
+  }
+
+  if (req.method === 'POST' && pathname === '/api/security-reports') {
+    try {
+      const rawBody = await readRequestBody(req);
+      if (rawBody) {
+        const parsed = JSON.parse(rawBody);
+        securityReports.push(parsed);
+      }
+    } catch {
+      // Ignore malformed reports
+    }
+    res.statusCode = 204;
+    res.end();
+    return;
+  }
+
+  if ((req.method === 'GET' || req.method === 'POST') && pathname === '/logout') {
+    res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+    res.statusCode = 200;
+    res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+    res.end('Logged out.');
+    return;
+  }
+
+  res.statusCode = 404;
+  res.setHeader('Content-Type', 'application/json; charset=utf-8');
+  res.end(JSON.stringify({ ok: false, error: 'Not found' }));
+}
+
+export function createServer() {
+  return http.createServer((req, res) => {
+    handleRequest(req, res).catch((err) => {
+      console.error('Server error:', err);
+      if (!res.headersSent) {
+        res.statusCode = 500;
+        res.setHeader('Content-Type', 'application/json; charset=utf-8');
+      }
+      res.end(JSON.stringify({ ok: false, error: 'Internal server error' }));
+    });
+  });
+}
+
+const isMainModule =
+  process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
+
+if (isMainModule) {
+  const port = Number(process.env.PORT) || 11222;
+  const server = createServer();
+  server.listen(port, () => {
+    console.log(`Daily Grind server listening on http://localhost:${port}`);
+  });
+}
