index 0000000..e8c5c9c
--- /dev/null
+++ b/script.js
@@ -0,0 +1,201 @@
+(function () {
+  let requestFailedDuringSubmit = false;
+
+  const DEFAULT_ERROR_MESSAGE =
+    'Error: Your request failed and could not go through. It may have been blocked by our security policy or encountered a network problem.';
+
+  function getMessageElement() {
+    return document.getElementById('newsletter-message');
+  }
+
+  function showRequestError(customMessage) {
+    requestFailedDuringSubmit = true;
+    const text = customMessage || DEFAULT_ERROR_MESSAGE;
+    const messageEl = getMessageElement();
+
+    if (messageEl) {
+      messageEl.textContent = text;
+      messageEl.className = 'newsletter-message error';
+      messageEl.hidden = false;
+      messageEl.style.display = 'block';
+    }
+  }
+
+  function showRequestSuccess(customMessage) {
+    if (requestFailedDuringSubmit) {
+      return;
+    }
+    const text =
+      customMessage || 'Success! Thank you for subscribing to The Daily Grind newsletter.';
+    const messageEl = getMessageElement();
+
+    if (messageEl) {
+      messageEl.textContent = text;
+      messageEl.className = 'newsletter-message success';
+      messageEl.hidden = false;
+      messageEl.style.display = 'block';
+    }
+  }
+
+  // Listen for Content Security Policy (CSP) violations when any request is blocked
+  const handleCspViolation = function (event) {
+    const blockedTarget = event && event.blockedURI ? ` (${event.blockedURI})` : '';
+    showRequestError(
+      `Error: A request${blockedTarget} failed and could not go through because it was blocked by the page security policy.`
+    );
+  };
+
+  document.addEventListener('securitypolicyviolation', handleCspViolation);
+  window.addEventListener('securitypolicyviolation', handleCspViolation);
+
+  // Wrap window.fetch so any failed or blocked fetch request immediately notifies the customer
+  if (typeof window.fetch === 'function') {
+    const originalFetch = window.fetch.bind(window);
+    window.fetch = async function (...args) {
+      try {
+        const response = await originalFetch(...args);
+        if (!response.ok) {
+          let errMsg = DEFAULT_ERROR_MESSAGE;
+          try {
+            const cloned = response.clone();
+            const data = await cloned.json();
+            if (data && data.error) {
+              errMsg = data.error;
+            }
+          } catch {
+            // Keep default error message
+          }
+          showRequestError(errMsg);
+        }
+        return response;
+      } catch (err) {
+        showRequestError(DEFAULT_ERROR_MESSAGE);
+        throw err;
+      }
+    };
+  }
+
+  // Wrap XMLHttpRequest so blocked or failed XHR requests also show a message to the customer
+  if (typeof window.XMLHttpRequest === 'function') {
+    const originalOpen = window.XMLHttpRequest.prototype.open;
+    const originalSend = window.XMLHttpRequest.prototype.send;
+
+    window.XMLHttpRequest.prototype.open = function (...args) {
+      try {
+        return originalOpen.apply(this, args);
+      } catch (err) {
+        showRequestError(DEFAULT_ERROR_MESSAGE);
+        throw err;
+      }
+    };
+
+    window.XMLHttpRequest.prototype.send = function (...args) {
+      this.addEventListener('error', function () {
+        showRequestError(DEFAULT_ERROR_MESSAGE);
+      });
+      this.addEventListener('load', function () {
+        if (this.status >= 400) {
+          showRequestError(DEFAULT_ERROR_MESSAGE);
+        }
+      });
+      try {
+        return originalSend.apply(this, args);
+      } catch (err) {
+        showRequestError(DEFAULT_ERROR_MESSAGE);
+        throw err;
+      }
+    };
+  }
+
+  // Wrap navigator.sendBeacon so blocked beacon requests also show a message
+  if (navigator && typeof navigator.sendBeacon === 'function') {
+    const originalSendBeacon = navigator.sendBeacon.bind(navigator);
+    navigator.sendBeacon = function (url, data) {
+      try {
+        const resolved = new URL(url, window.location.origin);
+        if (resolved.origin !== window.location.origin) {
+          showRequestError(DEFAULT_ERROR_MESSAGE);
+          try {
+            originalSendBeacon(url, data);
+          } catch {
+            // Ignored
+          }
+          return false;
+        }
+        const sent = originalSendBeacon(url, data);
+        if (!sent) {
+          showRequestError(DEFAULT_ERROR_MESSAGE);
+        }
+        return sent;
+      } catch (err) {
+        showRequestError(DEFAULT_ERROR_MESSAGE);
+        throw err;
+      }
+    };
+  }
+
+  window.addEventListener('unhandledrejection', function () {
+    showRequestError(DEFAULT_ERROR_MESSAGE);
+  });
+
+  function initNewsletterForm() {
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    if (!form || !emailInput) return;
+
+    // Reset the per-submission failure flag in the capture phase before bubble listeners run
+    form.addEventListener(
+      'submit',
+      function () {
+        requestFailedDuringSubmit = false;
+      },
+      true
+    );
+
+    form.addEventListener('submit', async function (event) {
+      event.preventDefault();
+
+      const email = emailInput.value.trim();
+      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+        showRequestError(
+          'Error: Please enter a valid email address before submitting your request.'
+        );
+        return;
+      }
+
+      const targetUrl =
+        form.dataset.endpoint || form.getAttribute('action') || form.action || '/newsletter';
+
+      try {
+        const response = await window.fetch(targetUrl, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            Accept: 'application/json'
+          },
+          body: JSON.stringify({ email })
+        });
+
+        const data = await response.json().catch(() => ({}));
+
+        if (!response.ok || data.ok === false) {
+          showRequestError(data.error || DEFAULT_ERROR_MESSAGE);
+          return;
+        }
+
+        showRequestSuccess(
+          data.message || 'Success! Thank you for subscribing to The Daily Grind newsletter.'
+        );
+        form.reset();
+      } catch {
+        showRequestError(DEFAULT_ERROR_MESSAGE);
+      }
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initNewsletterForm);
+  } else {
+    initNewsletterForm();
+  }
+})();
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..7dfe4c0
--- /dev/null
+++ b/server.js
@@ -0,0 +1,189 @@
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const portArgIndex = process.argv.findIndex((arg) => arg === '--port' || arg === '-p');
+const PORT = Number(
+  process.env.PORT || (portArgIndex !== -1 ? process.argv[portArgIndex + 1] : 11222)
+);
+
+const CSP_HEADER = [
+  "default-src 'self'",
+  "connect-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "script-src 'self' 'unsafe-inline'",
+  "style-src 'self' 'unsafe-inline'",
+  "form-action 'self'",
+  "base-uri 'self'",
+  "object-src 'none'"
+].join('; ');
+
+const subscribers = [];
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon'
+};
+
+function setSecurityHeaders(res) {
+  res.setHeader('Content-Security-Policy', CSP_HEADER);
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+}
+
+function parseBody(req) {
+  return new Promise((resolve, reject) => {
+    let data = '';
+    req.on('data', (chunk) => {
+      data += chunk;
+      if (data.length > 1e6) {
+        req.destroy();
+        reject(new Error('Payload too large'));
+      }
+    });
+    req.on('end', () => resolve(data));
+    req.on('error', reject);
+  });
+}
+
+function extractEmail(rawBody, contentType = '') {
+  if (!rawBody) return '';
+  const trimmed = rawBody.trim();
+  if (contentType.includes('application/json') || trimmed.startsWith('{')) {
+    try {
+      const parsed = JSON.parse(trimmed);
+      if (typeof parsed.email === 'string') return parsed.email.trim();
+    } catch {
+      // Fallback below
+    }
+  }
+  if (
+    contentType.includes('application/x-www-form-urlencoded') ||
+    trimmed.includes('email=')
+  ) {
+    const params = new URLSearchParams(trimmed);
+    const email = params.get('email');
+    if (email) return email.trim();
+  }
+  return trimmed;
+}
+
+const NEWSLETTER_PATHS = new Set([
+  '/',
+  '/newsletter',
+  '/api/newsletter',
+  '/subscribe',
+  '/api/subscribe',
+  '/signup',
+  '/api/signup',
+  '/emails',
+  '/api/emails'
+]);
+
+const server = http.createServer(async (req, res) => {
+  setSecurityHeaders(res);
+
+  const parsedUrl = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = parsedUrl.pathname;
+
+  if (req.method === 'POST' && NEWSLETTER_PATHS.has(pathname)) {
+    try {
+      const rawBody = await parseBody(req);
+      const email = extractEmail(rawBody, req.headers['content-type'] || '');
+
+      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+        res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(
+          JSON.stringify({
+            ok: false,
+            error: 'Error: Invalid email address. Your request could not go through.'
+          })
+        );
+        return;
+      }
+
+      subscribers.push({ email, subscribedAt: new Date().toISOString() });
+
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          ok: true,
+          success: true,
+          email,
+          message: 'Success! Thank you for subscribing to The Daily Grind newsletter.'
+        })
+      );
+      return;
+    } catch {
+      res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          ok: false,
+          error: 'Error: Server error. Your request could not go through.'
+        })
+      );
+      return;
+    }
+  }
+
+  if (
+    req.method === 'GET' &&
+    (pathname === '/newsletter' ||
+      pathname === '/api/newsletter' ||
+      pathname === '/subscribe' ||
+      pathname === '/api/subscribe' ||
+      pathname === '/emails' ||
+      pathname === '/api/emails')
+  ) {
+    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(
+      JSON.stringify({
+        ok: true,
+        subscribers: subscribers.map((s) => s.email),
+        items: subscribers
+      })
+    );
+    return;
+  }
+
+  if (req.method === 'GET' && pathname === '/favicon.ico') {
+    res.writeHead(204);
+    res.end();
+    return;
+  }
+
+  if (req.method === 'GET' || req.method === 'HEAD') {
+    const requestedPath = pathname === '/' ? '/index.html' : pathname;
+    const safePath = path.normalize(requestedPath).replace(/^(\.\.[/\\])+/, '');
+    const filePath = path.join(__dirname, safePath);
+
+    if (filePath.startsWith(__dirname) && fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
+      const ext = path.extname(filePath).toLowerCase();
+      const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+      res.writeHead(200, { 'Content-Type': contentType });
+      if (req.method === 'HEAD') {
+        res.end();
+      } else {
+        fs.createReadStream(filePath).pipe(res);
+      }
+      return;
+    }
+  }
+
+  res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+  res.end(JSON.stringify({ ok: false, error: 'Not found' }));
+});
+
+if (require.main === module) {
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
+
+module.exports = server;
