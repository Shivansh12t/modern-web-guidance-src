diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,78 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="description" content="System status and metrics overview dashboard.">
+  <title>Dashboard</title>
+  <script src="/js/app.js" async fetchpriority="high"></script>
+  <script src="/js/legacy-widgets.js" defer></script>
+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+  <style>
+    :root {
+      color-scheme: light dark;
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+    }
+    body {
+      margin: 0;
+      padding: 2rem;
+      max-width: 960px;
+      margin-inline: auto;
+      line-height: 1.5;
+    }
+    header {
+      border-bottom: 1px solid currentColor;
+      margin-bottom: 1.5rem;
+      padding-bottom: 0.5rem;
+    }
+    h1 {
+      margin: 0;
+      font-size: 1.5rem;
+    }
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+      gap: 1rem;
+    }
+    .card {
+      border: 1px solid rgba(128, 128, 128, 0.3);
+      border-radius: 6px;
+      padding: 1rem;
+    }
+    .card h2 {
+      margin: 0 0 0.5rem;
+      font-size: 0.875rem;
+      text-transform: uppercase;
+      letter-spacing: 0.05em;
+      opacity: 0.8;
+    }
+    .metric {
+      font-size: 1.75rem;
+      font-weight: 700;
+      margin: 0;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Dashboard</h1>
+  </header>
+  <main>
+    <section class="grid" aria-label="Key Metrics">
+      <article class="card">
+        <h2>Active Users</h2>
+        <p class="metric" id="metric-users">1,284</p>
+      </article>
+      <article class="card">
+        <h2>System Uptime</h2>
+        <p class="metric" id="metric-uptime">99.98%</p>
+      </article>
+      <article class="card">
+        <h2>Avg Latency</h2>
+        <p class="metric" id="metric-latency">42 ms</p>
+      </article>
+    </section>
+    <div id="legacy-widgets-container"></div>
+  </main>
+</body>
+</html>
