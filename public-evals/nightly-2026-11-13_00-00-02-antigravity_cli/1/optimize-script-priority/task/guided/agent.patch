diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,60 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Dashboard</title>
+  <style>
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, sans-serif;
+      padding: 2rem;
+      line-height: 1.5;
+    }
+    main {
+      max-width: 60rem;
+      margin: 0 auto;
+    }
+    .widgets {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
+      gap: 1rem;
+      margin-top: 1.5rem;
+    }
+    .widget {
+      border: 1px solid #d1d5db;
+      border-radius: 0.5rem;
+      padding: 1rem;
+    }
+  </style>
+  <!-- Elevate the priority of the critical app logic -->
+  <script src="/js/app.js" async fetchpriority="high"></script>
+  <!-- Deprioritize non-essential tracking scripts -->
+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+</head>
+<body>
+  <header>
+    <nav aria-label="Primary">
+      <a href="/">Overview</a>
+    </nav>
+  </header>
+  <main>
+    <h1>Dashboard</h1>
+    <section class="widgets" aria-label="Key Metrics">
+      <article class="widget">
+        <h2>System Status</h2>
+        <p id="status-metric">Operational</p>
+      </article>
+      <article class="widget">
+        <h2>Legacy Widgets</h2>
+        <div id="legacy-widgets-root"></div>
+      </article>
+    </section>
+  </main>
+  <footer>
+    <p>Dashboard Platform</p>
+  </footer>
+  <!-- Deprioritize late-body parser-blocking scripts to favor critical resources -->
+  <script src="/js/legacy-widgets.js" fetchpriority="low"></script>
+</body>
+</html>
