+  <script>
+    const favoritesGrid = document.getElementById('favorites-grid');
+    const sortSelect = document.getElementById('sort-favorites');
+    const reorderStatus = document.getElementById('reorder-status');
+    const collator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
+
+    const initialCards = Array.from(favoritesGrid.children);
+    const featuredIndex = new Map(initialCards.map((card, index) => [card, index]));
+
+    function getCardTitle(card) {
+      return card.querySelector('h3')?.textContent.trim() ?? '';
+    }
+
+    function reorder(container, orderedNodes) {
+      const move = Object.hasOwn(Element.prototype, 'moveBefore')
+        ? (node) => container.moveBefore(node, null)
+        : (node) => container.append(node);
+
+      for (const node of orderedNodes) move(node);
+    }
+
+    function reorderWithTransition(list, orderedNodes) {
+      const update = () => reorder(list, orderedNodes);
+
+      if (list.startViewTransition) {
+        const transition = list.startViewTransition(update);
+        transition.ready.catch(() => {});
+      } else if (document.startViewTransition) {
+        const transition = document.startViewTransition(update);
+        transition.ready.catch(() => {});
+      } else {
+        update();
+      }
+    }
+
+    const sortDescriptions = {
+      'featured': 'featured order',
+      'name-asc': 'name, A to Z',
+      'name-desc': 'name, Z to A',
+    };
+
+    sortSelect.addEventListener('change', () => {
+      const sortValue = sortSelect.value;
+      const orderedCards = Array.from(favoritesGrid.children).sort((a, b) => {
+        if (sortValue === 'name-asc') {
+          return collator.compare(getCardTitle(a), getCardTitle(b));
+        }
+        if (sortValue === 'name-desc') {
+          return collator.compare(getCardTitle(b), getCardTitle(a));
+        }
+        return (featuredIndex.get(a) ?? 0) - (featuredIndex.get(b) ?? 0);
+      });
+
+      reorderWithTransition(favoritesGrid, orderedCards);
+      const description = sortDescriptions[sortValue] ?? sortValue;
+      reorderStatus.textContent = `Sorted by ${description}, ${orderedCards.length} items`;
+    });
+  </script>
+
