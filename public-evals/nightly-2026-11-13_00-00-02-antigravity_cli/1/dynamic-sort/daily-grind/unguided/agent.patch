+  <script>
+    (function () {
+      const grid = document.getElementById('favorites-grid');
+      const sortButtons = document.querySelectorAll('.sort-btn');
+      const sortSelect = document.getElementById('sort-select');
+
+      function getCardTitle(card) {
+        return (card.dataset.name || card.querySelector('h3')?.textContent || '').trim();
+      }
+
+      function compareCards(a, b, criterion) {
+        switch (criterion) {
+          case 'name-asc':
+            return getCardTitle(a).localeCompare(getCardTitle(b));
+          case 'name-desc':
+            return getCardTitle(b).localeCompare(getCardTitle(a));
+          case 'price-asc':
+            return parseFloat(a.dataset.price || 0) - parseFloat(b.dataset.price || 0);
+          case 'price-desc':
+            return parseFloat(b.dataset.price || 0) - parseFloat(a.dataset.price || 0);
+          case 'rating-desc':
+            return parseFloat(b.dataset.rating || 0) - parseFloat(a.dataset.rating || 0);
+          case 'featured':
+          default:
+            return parseInt(a.dataset.featured || 0, 10) - parseInt(b.dataset.featured || 0, 10);
+        }
+      }
+
+      function sortCards(criterion) {
+        if (!grid) return;
+        const cards = Array.from(grid.querySelectorAll('.card'));
+
+        // First: record initial positions (FLIP)
+        const firstRects = new Map();
+        cards.forEach((card) => {
+          // Clear any active transition before measuring
+          card.style.transition = 'none';
+          card.style.transform = '';
+          firstRects.set(card, card.getBoundingClientRect());
+        });
+
+        // Sort and reorder DOM
+        const sortedCards = cards.slice().sort((a, b) => compareCards(a, b, criterion));
+        sortedCards.forEach((card) => grid.appendChild(card));
+
+        // Last & Invert: measure new positions and apply inverse transform
+        sortedCards.forEach((card) => {
+          const first = firstRects.get(card);
+          const last = card.getBoundingClientRect();
+          const dx = first.left - last.left;
+          const dy = first.top - last.top;
+
+          if (dx !== 0 || dy !== 0) {
+            card.style.transition = 'none';
+            card.style.transform = `translate(${dx}px, ${dy}px)`;
+
+            // Play: force reflow and animate to identity transform
+            void card.offsetWidth;
+            card.style.transition = 'transform 400ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 400ms ease';
+            card.style.transform = 'translate(0, 0)';
+
+            // Also run Web Animations API if available for rich animation inspection
+            if (typeof card.animate === 'function') {
+              card.animate(
+                [
+                  { transform: `translate(${dx}px, ${dy}px)` },
+                  { transform: 'translate(0, 0)' }
+                ],
+                {
+                  duration: 400,
+                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)'
+                }
+              );
+            }
+          }
+        });
+
+        // Sync UI controls
+        sortButtons.forEach((btn) => {
+          const isActive = btn.dataset.sort === criterion;
+          btn.classList.toggle('active', isActive);
+          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
+        });
+
+        if (sortSelect && sortSelect.value !== criterion) {
+          sortSelect.value = criterion;
+        }
+      }
+
+      sortButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sortCards(btn.dataset.sort);
+        });
+      });
+
+      if (sortSelect) {
+        sortSelect.addEventListener('change', (e) => {
+          sortCards(e.target.value);
+        });
+      }
+    })();
+  </script>
