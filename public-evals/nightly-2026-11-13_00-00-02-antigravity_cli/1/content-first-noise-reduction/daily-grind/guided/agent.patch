+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Fallback for scroll-state container queries so the top bar hides on downward scroll everywhere.
+    if (!CSS.supports("container-type", "scroll-state")) {
+      const bar = document.querySelector(".top-bar");
+      let lastY = scrollY;
+      addEventListener("scroll", () => {
+        // Clamp so rubber-band overscroll at the top or bottom doesn't flip the scroll direction.
+        const y = Math.max(0, Math.min(scrollY, document.documentElement.scrollHeight - innerHeight));
+        if (y === lastY) return;
+        // Hide only after scrolling down past the bar's own height, so it doesn't flicker near the top.
+        bar?.classList.toggle("is-hidden", y > lastY && y > bar.offsetHeight);
+        lastY = y;
+      }, { passive: true });
+    }
+
+    // Expand all / Collapse all handler for the site information accordion.
+    const toggleAllAccordion = (accordion, button) => {
+      const expand = button.getAttribute("aria-expanded") !== "true";
+      for (const details of accordion.querySelectorAll(":scope > details")) {
+        details.open = expand;
+      }
+    };
+
+    document.addEventListener("command", event => {
+      if (event.command !== "--toggle-all") return;
+      toggleAllAccordion(event.target, event.source);
+    }, { capture: true });
+
+    // Fallback for browsers that do not support Invoker Commands (commandfor / command).
+    if (!Object.hasOwn(HTMLButtonElement.prototype, "commandForElement")) {
+      document.addEventListener("click", event => {
+        const button = event.target.closest('[command="--toggle-all"]');
+        if (!button) return;
+        const targetId = button.getAttribute("commandfor");
+        const accordion = targetId ? document.getElementById(targetId) : null;
+        if (accordion) toggleAllAccordion(accordion, button);
+      });
+    }
+
+    // Sync the Expand/Collapse All button state when individual details items toggle.
+    document.addEventListener("toggle", event => {
+      if (!event.target.matches(".accordion > details")) return;
+      const accordion = event.target.parentElement;
+      const button = accordion.querySelector('[command="--toggle-all"]');
+      if (!button) return;
+
+      const items = accordion.querySelectorAll(":scope > details");
+      button.setAttribute("aria-expanded", Array.prototype.every.call(items, details => details.open));
+    }, { capture: true });
