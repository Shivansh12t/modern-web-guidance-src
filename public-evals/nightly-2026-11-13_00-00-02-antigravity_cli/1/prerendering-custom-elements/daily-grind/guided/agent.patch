+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          display: flex;
+          flex-direction: column;
+          height: 100%;
+          box-sizing: border-box;
+          transition: box-shadow 0.2s, border-color 0.2s;
+          border: 2px solid transparent;
+        }
+        :host([favorited]) .card,
+        :host(:state(favorited)) .card {
+          border-color: var(--_accent);
+        }
