+          margin-top: 15px;
+        }
+        button {
+          font: inherit;
+          cursor: pointer;
+          padding: 10px 16px;
+          border-radius: 5px;
+          font-size: 0.9rem;
+          transition: background 0.2s, color 0.2s, border-color 0.2s;
+        }
+        .details-toggle {
+          background: var(--_primary);
+          color: white;
+          border: 1px solid var(--_primary);
+        }
+        .details-toggle:hover {
+          background: #3e2723;
+        }
+        .fav-toggle {
+          background: transparent;
+          color: var(--_primary);
+          border: 1px solid var(--_primary);
+        }
+        :host([favorited]) .fav-toggle,
+        :host(:state(favorited)) .fav-toggle {
+          background: var(--_accent);
+          color: var(--_text);
+          border-color: var(--_accent);
+          font-weight: 600;
+        }
+        .details-panel {
+          display: none;
+          margin-top: 15px;
+          padding-top: 12px;
+          border-top: 1px solid #eee;
+          font-size: 0.9rem;
+          text-align: left;
+        }
+        :host([open]) .details-panel,
+        :host(:state(open)) .details-panel {
+          display: block;
+        }
+        .details-link {
+          display: inline-block;
+          margin-top: 8px;
+          color: var(--_primary);
+          font-weight: 600;
+          text-decoration: underline;
+        }
+      </style>
+      <article class="card" part="card">
+        <slot name="header"></slot>
+        <div class="body">
+          <slot></slot>
+        </div>
+        <div class="actions">
+          <button type="button" id="toggle" class="details-toggle" part="details-button" aria-expanded="false" aria-controls="details-panel">View Details</button>
+          <button type="button" id="favorite" class="fav-toggle" part="favorite-button" aria-pressed="false">♡ Favorite</button>
+        </div>
+        <div id="details-panel" class="details-panel" part="details">
+          <slot name="details"></slot>
+          <slot name="link"></slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['open', 'favorited'];
+      #internals;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals?.();
+
+        // Reuse the server-rendered Declarative Shadow DOM root if present;
+        // only attach and populate a shadow root if absent (e.g. client-created or legacy engine fallback).
+        if (!this.shadowRoot) {
+          const dsdTemplate = this.querySelector('template[shadowrootmode]');
+          this.attachShadow({ mode: 'open' });
+          if (dsdTemplate) {
+            this.shadowRoot.append(dsdTemplate.content.cloneNode(true));
+            dsdTemplate.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: attach event listeners once against the existing shadow markup
+        // without re-rendering or replacing nodes.
+        this.shadowRoot.getElementById('toggle')?.addEventListener('click', () => {
+          this.open = !this.open;
+          this.dispatchEvent(new CustomEvent('details-toggle', {
+            detail: { open: this.open },
+            bubbles: true,
+            composed: true,
+          }));
+        });
+
+        this.shadowRoot.getElementById('favorite')?.addEventListener('click', () => {
+          this.favorited = !this.favorited;
+          this.dispatchEvent(new CustomEvent('favorite-toggle', {
+            detail: { favorited: this.favorited },
+            bubbles: true,
+            composed: true,
+          }));
+        });
+      }
+
+      connectedCallback() {
+        this.#syncOpenState();
+        this.#syncFavoritedState();
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(val) {
+        this.toggleAttribute('open', Boolean(val));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        this.toggleAttribute('favorited', Boolean(val));
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'open') this.#syncOpenState();
+        if (name === 'favorited') this.#syncFavoritedState();
+      }
+
+      #syncOpenState() {
+        const isOpen = this.open;
+        if (this.#internals?.states) {
+          isOpen ? this.#internals.states.add('open') : this.#internals.states.delete('open');
+        }
+        const toggleBtn = this.shadowRoot?.getElementById('toggle');
+        if (toggleBtn) {
+          toggleBtn.setAttribute('aria-expanded', String(isOpen));
+          toggleBtn.textContent = isOpen ? 'Hide Details' : 'View Details';
+        }
+      }
+
+      #syncFavoritedState() {
+        const isFav = this.favorited;
+        if (this.#internals?.states) {
+          isFav ? this.#internals.states.add('favorited') : this.#internals.states.delete('favorited');
+        }
+        const favBtn = this.shadowRoot?.getElementById('favorite');
+        if (favBtn) {
+          favBtn.setAttribute('aria-pressed', String(isFav));
+          favBtn.textContent = isFav ? '♥ Favorited' : '♡ Favorite';
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
