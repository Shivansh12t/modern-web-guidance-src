+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['expanded', 'favorited'];
+      }
+
+      constructor() {
+        super();
+        this._hydrated = false;
+        this._onDetailsClick = this.toggleDetails.bind(this);
+        this._onFavoriteClick = this.toggleFavorite.bind(this);
+      }
+
+      connectedCallback() {
+        // Hydrate existing Declarative Shadow DOM in place without re-rendering.
+        if (!this.shadowRoot) {
+          const declarativeTemplate = this.querySelector('template[shadowrootmode], template[shadowroot]');
+          if (declarativeTemplate) {
+            const mode = declarativeTemplate.getAttribute('shadowrootmode') ||
+              declarativeTemplate.getAttribute('shadowroot') ||
+              'open';
+            const root = this.attachShadow({ mode });
+            root.appendChild(declarativeTemplate.content.cloneNode(true));
+            declarativeTemplate.remove();
+          } else {
+            this.attachShadow({ mode: 'open' });
+            this._renderFallback();
+          }
+        }
+
+        this._detailsBtn = this.shadowRoot.querySelector('.details-toggle');
+        this._detailsPanel = this.shadowRoot.querySelector('.drink-details');
+        this._favBtn = this.shadowRoot.querySelector('.favorite-toggle');
+        this._heartIcon = this.shadowRoot.querySelector('.heart');
+        this._favLabel = this.shadowRoot.querySelector('.fav-label');
+
+        if (!this._hydrated) {
+          if (this._detailsBtn) {
+            this._detailsBtn.addEventListener('click', this._onDetailsClick);
+          }
+          if (this._favBtn) {
+            this._favBtn.addEventListener('click', this._onFavoriteClick);
+          }
+          this._hydrated = true;
+          this.dataset.hydrated = 'true';
+        }
+
+        this._syncDetailsUI();
+        this._syncFavoriteUI();
+      }
+
+      disconnectedCallback() {
+        if (this._detailsBtn) {
+          this._detailsBtn.removeEventListener('click', this._onDetailsClick);
+        }
+        if (this._favBtn) {
+          this._favBtn.removeEventListener('click', this._onFavoriteClick);
+        }
+        this._hydrated = false;
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || !this.shadowRoot) return;
+        if (name === 'expanded') {
+          this._syncDetailsUI();
+        } else if (name === 'favorited') {
+          this._syncFavoriteUI();
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(val) {
+        if (Boolean(val)) {
+          this.setAttribute('expanded', '');
+        } else {
+          this.removeAttribute('expanded');
+        }
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        if (Boolean(val)) {
+          this.setAttribute('favorited', '');
+        } else {
+          this.removeAttribute('favorited');
+        }
+      }
+
+      toggleDetails() {
+        this.expanded = !this.expanded;
+        this.dispatchEvent(new CustomEvent('details-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            drinkId: this.getAttribute('drink-id'),
+            name: this.getAttribute('name'),
+            expanded: this.expanded
+          }
+        }));
+      }
+
+      toggleFavorite() {
+        this.favorited = !this.favorited;
+        this.dispatchEvent(new CustomEvent('favorite-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            drinkId: this.getAttribute('drink-id'),
+            name: this.getAttribute('name'),
