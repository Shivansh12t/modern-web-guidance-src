+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      @layer base, theme;
+
+      @layer base {
+        :host {
+          display: block;
+          container-type: inline-size;
+          --_primary: var(--primary, #4e342e);
+          --_accent: var(--accent, #ffab40);
+          --_text: var(--text, #3e2723);
+          --_card-bg: var(--card-bg, #ffffff);
+        }
+
+        :host([hidden]) {
+          display: none;
+        }
+
+        *, *::before, *::after {
+          box-sizing: border-box;
+        }
+
+        .card {
+          position: relative;
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          justify-content: space-between;
+          height: 100%;
+          background: var(--_card-bg);
+          color: var(--_text);
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+
+        .badge {
+          display: inline-block;
+          background: var(--_accent);
+          color: var(--_text);
+          font-size: 0.75rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.05em;
+          padding: 3px 10px;
+          border-radius: 999px;
+          margin-bottom: 8px;
+        }
+
+        .badge[hidden] {
+          display: none;
+        }
+
+        .title {
+          margin: 0 0 10px;
+          color: var(--_primary);
+          font-size: 1.17rem;
+        }
+
+        ::slotted([slot="title"]) {
+          margin: 0;
+          color: inherit;
+          font: inherit;
+        }
+
+        .description,
+        .desc-fallback {
+          margin: 0;
+        }
+
+        .desc-fallback:empty {
+          display: none;
+        }
+
+        ::slotted(p),
+        ::slotted([slot="description"]) {
+          margin: 0;
+        }
+
+        .action-link,
+        ::slotted(a[slot="action"]) {
+          display: inline-block;
+          background: var(--_primary);
+          color: #ffffff;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          font: inherit;
+          transition: background 0.3s;
+        }
+
+        .action-link:hover,
+        ::slotted(a[slot="action"]:hover) {
+          background: var(--_text);
+        }
+
+        .action-link[hidden] {
+          display: none;
+        }
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <span class="badge" part="badge" hidden>
+          <slot name="badge"><span class="badge-fallback">Limited</span></slot>
+        </span>
+        <h3 class="title" part="title">
+          <slot name="title"><span class="title-fallback"></span></slot>
+        </h3>
+        <div class="description" part="description">
+          <slot name="description"><slot><p class="desc-fallback"></p></slot></slot>
+        </div>
+        <slot name="action">
+          <a class="action-link" part="action" href="#" hidden>View Details</a>
+        </slot>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['limited', 'badge', 'heading', 'description', 'href', 'action-label'];
+
+      #internals;
+      #badgeEl;
+      #badgeSlot;
+      #badgeFallback;
+      #titleFallback;
+      #descFallback;
+      #actionLink;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        this.#badgeEl = this.shadowRoot.querySelector('.badge');
+        this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        this.#badgeFallback = this.shadowRoot.querySelector('.badge-fallback');
+        this.#titleFallback = this.shadowRoot.querySelector('.title-fallback');
+        this.#descFallback = this.shadowRoot.querySelector('.desc-fallback');
+        this.#actionLink = this.shadowRoot.querySelector('.action-link');
+
+        this.#badgeSlot.addEventListener('slotchange', () => this.#syncBadge());
+      }
+
+      connectedCallback() {
+        this.#syncAll();
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(value) {
+        this.toggleAttribute('limited', Boolean(value));
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(value) {
+        if (value) {
+          this.setAttribute('badge', String(value));
+        } else {
+          this.removeAttribute('badge');
+        }
+      }
+
+      get heading() {
+        return this.getAttribute('heading') ?? '';
+      }
+
+      set heading(value) {
+        if (value) {
+          this.setAttribute('heading', String(value));
+        } else {
+          this.removeAttribute('heading');
+        }
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(value) {
+        if (value) {
+          this.setAttribute('description', String(value));
+        } else {
+          this.removeAttribute('description');
+        }
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+
+      set href(value) {
+        if (value) {
+          this.setAttribute('href', String(value));
+        } else {
+          this.removeAttribute('href');
+        }
+      }
+
+      get actionLabel() {
+        return this.getAttribute('action-label') ?? 'View Details';
+      }
+
+      set actionLabel(value) {
+        if (value) {
+          this.setAttribute('action-label', String(value));
+        } else {
+          this.removeAttribute('action-label');
+        }
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        switch (name) {
+          case 'limited':
+          case 'badge':
+            this.#syncBadge();
+            break;
+          case 'heading':
+            this.#syncHeading();
+            break;
+          case 'description':
+            this.#syncDescription();
+            break;
+          case 'href':
+          case 'action-label':
+            this.#syncAction();
+            break;
+        }
+      }
+
+      #syncAll() {
+        this.#syncBadge();
+        this.#syncHeading();
+        this.#syncDescription();
+        this.#syncAction();
+      }
+
+      #syncBadge() {
+        const assigned = this.#badgeSlot
+          .assignedNodes({ flatten: false })
+          .filter(
+            (node) =>
+              node.nodeType === Node.ELEMENT_NODE ||
+              (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+          );
+        const badgeText = this.getAttribute('badge') || 'Limited';
+        if (this.#badgeFallback.textContent !== badgeText) {
+          this.#badgeFallback.textContent = badgeText;
+        }
+        const shouldShow = this.hasAttribute('limited') || this.hasAttribute('badge') || assigned.length > 0;
+        this.#badgeEl.hidden = !shouldShow;
+        if (shouldShow) {
+          this.#internals.states.add('has-badge');
+        } else {
+          this.#internals.states.delete('has-badge');
+        }
+      }
+
+      #syncHeading() {
+        this.#titleFallback.textContent = this.heading;
+      }
+
+      #syncDescription() {
+        this.#descFallback.textContent = this.description;
+      }
+
+      #syncAction() {
+        if (this.hasAttribute('href')) {
+          this.#actionLink.href = this.href;
+          this.#actionLink.textContent = this.actionLabel;
+          this.#actionLink.hidden = false;
+        } else {
+          this.#actionLink.hidden = true;
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
