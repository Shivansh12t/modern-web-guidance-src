+        justify-content: space-between;
+        height: 100%;
+      }
+
+      .badge {
+        position: absolute;
+        top: 12px;
+        right: 12px;
+        background: var(--accent, #ffab40);
+        color: var(--text, #3e2723);
+        font-size: 0.75rem;
+        font-weight: bold;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 3px 10px;
+        border-radius: 999px;
+      }
+
+      .badge[hidden] {
+        display: none;
+      }
+
+      h3 {
+        margin-bottom: 10px;
+        color: var(--primary, #4e342e);
+      }
+
+      p {
+        color: var(--text, #3e2723);
+        flex-grow: 1;
+      }
+
+      .actions {
+        margin-top: 15px;
+      }
+
+      .btn,
+      ::slotted(a) {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: white !important;
+        padding: 10px 20px;
+        text-decoration: none !important;
+        border-radius: 5px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover,
+      ::slotted(a:hover) {
+        background: #3e2723;
+      }
+    </style>
+    <article class="card" part="card">
+      <span class="badge" part="badge" hidden><slot name="badge">Limited</slot></span>
+      <h3 class="card-title" part="title"><slot name="title"></slot></h3>
+      <p class="card-description" part="description"><slot name="description"></slot></p>
+      <div class="actions" part="actions">
+        <slot name="action">
+          <a class="btn" part="action-link" href="#">View Details</a>
+        </slot>
+      </div>
+    </article>
+  </template>
+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['title', 'description', 'href', 'link', 'action-href', 'action-text', 'link-text', 'badge', 'limited'];
+      }
+
+      constructor() {
+        super();
+        const shadow = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        shadow.appendChild(template.content.cloneNode(true));
+
+        this._badgeEl = shadow.querySelector('.badge');
+        this._badgeSlot = shadow.querySelector('slot[name="badge"]');
+        this._titleSlot = shadow.querySelector('slot[name="title"]');
+        this._descSlot = shadow.querySelector('slot[name="description"]');
+        this._actionLink = shadow.querySelector('.btn');
+
+        this._badgeSlot.addEventListener('slotchange', () => this._syncBadge());
+      }
+
+      connectedCallback() {
+        this._syncAll();
+      }
+
+      attributeChangedCallback() {
+        this._syncAll();
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(val) {
+        if (val) {
+          this.setAttribute('limited', '');
+        } else {
+          this.removeAttribute('limited');
+        }
+      }
+
+      get badge() {
+        return this.getAttribute('badge');
+      }
+
+      set badge(val) {
+        if (val === null || val === undefined || val === false) {
+          this.removeAttribute('badge');
+        } else {
+          this.setAttribute('badge', String(val));
+        }
+      }
+
+      _hasSlottedBadge() {
+        if (!this._badgeSlot) return false;
+        const nodes = this._badgeSlot.assignedNodes({ flatten: false });
+        return nodes.some(node => {
+          if (node.nodeType === Node.ELEMENT_NODE) {
+            return !node.hidden && node.textContent.trim().length > 0;
+          }
+          if (node.nodeType === Node.TEXT_NODE) {
+            return node.textContent.trim().length > 0;
+          }
+          return false;
+        });
+      }
+
+      _syncBadge() {
+        if (!this._badgeEl) return;
+        const hasBadgeAttr = this.hasAttribute('badge') && this.getAttribute('badge') !== 'false';
+        const hasLimitedAttr = this.hasAttribute('limited') && this.getAttribute('limited') !== 'false';
+        const hasSlotted = this._hasSlottedBadge();
+
+        if (!hasSlotted) {
+          const badgeText = this.getAttribute('badge');
+          this._badgeSlot.textContent = (badgeText && badgeText !== 'true') ? badgeText : 'Limited';
+        }
+
+        const shouldShow = hasBadgeAttr || hasLimitedAttr || hasSlotted;
+        this._badgeEl.hidden = !shouldShow;
+      }
+
+      _syncAll() {
+        if (!this.shadowRoot) return;
+
+        if (this.hasAttribute('title')) {
+          this._titleSlot.textContent = this.getAttribute('title');
+        }
+        if (this.hasAttribute('description')) {
+          this._descSlot.textContent = this.getAttribute('description');
+        }
+
+        const href = this.getAttribute('href') || this.getAttribute('link') || this.getAttribute('action-href');
+        if (href && this._actionLink) {
+          this._actionLink.setAttribute('href', href);
+        }
+
+        const actionText = this.getAttribute('action-text') || this.getAttribute('link-text');
+        if (actionText && this._actionLink) {
+          this._actionLink.textContent = actionText;
+        }
+
+        this._syncBadge();
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
