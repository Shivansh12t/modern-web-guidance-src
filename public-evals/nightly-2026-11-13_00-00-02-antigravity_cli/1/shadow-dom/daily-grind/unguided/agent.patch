+  <template id="drink-card-template">
+    <style>
+      :host {
+        display: block;
+      }
+
+      *, *::before, *::after {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      .card {
+        position: relative;
+        background: white;
