diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,103 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Video Landing Page</title>
+
+  <!-- Elevate priority for the video poster image acting as the LCP candidate -->
+  <link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+
+  <!-- Preload critical header font (fonts default to high priority, so omit fetchpriority="high") -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+
+  <!-- Preload secondary UI font at low priority to avoid contending with critical LCP and header assets -->
+  <link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+  <!-- Inline critical CSS to avoid render-blocking stylesheet requests -->
+  <style>
+    @font-face {
+      font-family: "Brand Font";
+      src: url("brand-font.woff2") format("woff2");
+      font-display: swap;
+    }
+
+    @font-face {
+      font-family: "Secondary Font";
+      src: url("secondary-font.woff2") format("woff2");
+      font-display: swap;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+    }
+
+    body {
+      margin: 0;
+      font-family: "Secondary Font", system-ui, -apple-system, sans-serif;
+      font-size-adjust: from-font;
+      background-color: #0b0c10;
+      color: #f8f9fa;
+      line-height: 1.5;
+    }
+
+    header, main, footer {
+      max-width: 960px;
+      margin-inline: auto;
+      padding: 1.5rem;
+    }
+
+    h1 {
+      font-family: "Brand Font", system-ui, -apple-system, sans-serif;
+      font-size-adjust: from-font;
+      font-size: clamp(2rem, 4vw, 3rem);
+      margin-block: 0 0.5rem;
+      letter-spacing: -0.02em;
+    }
+
+    .subtitle {
+      margin-block: 0 1.5rem;
+      color: #adb5bd;
+    }
+
+    video {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 16 / 9;
+      background-color: #161922;
+      border-radius: 0.5rem;
+    }
+
+    footer {
+      font-size: 0.875rem;
+      color: #868e96;
+      border-top: 1px solid #1f2430;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Next-Gen Video</h1>
+  </header>
+
+  <main>
+    <p class="subtitle">Instant, high-efficiency playback engineered for minimal load delay.</p>
+    <video
+      controls
+      width="1280"
+      height="720"
+      poster="poster.jpg"
+      preload="none"
+    >
+      <source src="video.webm" type="video/webm">
+      <source src="video.mp4" type="video/mp4">
+      <track src="captions.vtt" kind="captions" srclang="en" label="English">
+    </video>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 Video Platform. Built for optimal Core Web Vitals.</p>
+  </footer>
+</body>
+</html>
