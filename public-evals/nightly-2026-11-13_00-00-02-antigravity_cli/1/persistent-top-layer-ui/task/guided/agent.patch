+  <script type="module">
+    // MANDATORY: Feature detect 'commandForElement' on HTMLButtonElement.prototype.
+    // Conditionally load the invokers-polyfill from a CDN only in browsers lacking native support.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dialog)) dialog.close(); });
+      }
+    }
+
+    const feedbackDialog = document.getElementById('feedback-modal');
+    const moveModalBtn = document.getElementById('move-modal-btn');
+    const locationStatus = document.getElementById('modal-location-status');
+
+    const sections = [
+      document.getElementById('favorites-section'),
+      document.getElementById('footer-section'),
+      document.getElementById('hero-section')
+    ];
+
+    moveModalBtn.addEventListener('click', () => {
+      const currentParent = feedbackDialog.parentElement;
+      const currentIndex = sections.indexOf(currentParent);
+      const targetParent = sections[(currentIndex + 1) % sections.length];
+
+      // Check if moveBefore is supported
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+      } else {
+        // Fallback: traditional move.
+        // Note: This WILL close <dialog>, popover, and fullscreen elements.
+        const wasOpen = feedbackDialog.hasAttribute('open') || feedbackDialog.matches(':popover-open');
+        targetParent.insertBefore(feedbackDialog, null);
+
+        // Manually restore state if possible
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+      }
+
+      const sectionName = targetParent.dataset.sectionName || targetParent.tagName.toLowerCase();
+      locationStatus.textContent = `DOM Parent: ${sectionName} (#${targetParent.id})`;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      const choice = feedbackDialog.returnValue;
+      feedbackDialog.returnValue = '';
+      if (choice === 'submit') {
+        document.getElementById('feedback-form').reset();
+      }
+    });
+  </script>
