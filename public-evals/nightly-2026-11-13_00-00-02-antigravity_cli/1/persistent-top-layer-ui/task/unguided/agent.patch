+  <script>
+    (function () {
+      const modal = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const closeBtn = document.getElementById('close-feedback-btn');
+      const form = document.getElementById('feedback-form');
+      const statusEl = document.getElementById('feedback-status');
+      const currentSectionNameEl = document.getElementById('current-section-name');
+      const currentSectionIdEl = document.getElementById('current-section-id');
+      const sections = Array.from(document.querySelectorAll('main .page-section'));
+
+      function updateSectionIndicators() {
+        const currentParentSection = modal.closest('section');
+        sections.forEach((sec, idx) => {
+          const isHost = sec === currentParentSection;
+          sec.classList.toggle('has-modal', isHost);
+          const badge = sec.querySelector('[data-section-indicator]');
+          if (badge) {
+            badge.textContent = isHost ? 'Modal Host Section' : 'Section ' + (idx + 1);
+          }
+        });
+
+        if (currentParentSection) {
+          const title = currentParentSection.getAttribute('data-section-title') || currentParentSection.id;
+          currentSectionNameEl.textContent = title;
+          currentSectionIdEl.textContent = '#' + currentParentSection.id;
+          modal.setAttribute('data-current-section', currentParentSection.id);
+        }
+      }
+
+      function openModal() {
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+        updateSectionIndicators();
+      }
+
+      function relocateModal() {
+        const currentSection = modal.closest('section');
+        const currentIndex = sections.indexOf(currentSection);
+        const nextIndex = (currentIndex + 1) % sections.length;
+        const targetSection = sections[nextIndex];
+
+        if (!targetSection || targetSection === currentSection) {
+          return;
+        }
+
+        // Use atomic DOM move (moveBefore) to preserve modal open/top-layer state and focus across reparenting
+        if (typeof targetSection.moveBefore === 'function') {
+          targetSection.moveBefore(modal, null);
+        } else {
+          const activeEl = document.activeElement;
+          const wasOpen = modal.open;
+          targetSection.appendChild(modal);
+          if (wasOpen && !modal.open) {
+            if (typeof modal.showModal === 'function') {
+              modal.showModal();
+            } else {
+              modal.setAttribute('open', '');
+            }
+          }
+          if (activeEl && modal.contains(activeEl) && typeof activeEl.focus === 'function') {
+            activeEl.focus();
+          }
+        }
+
+        updateSectionIndicators();
+      }
+
+      moveBtn.addEventListener('click', relocateModal);
+
+      openBtn.addEventListener('click', openModal);
+
+      closeBtn.addEventListener('click', () => {
+        if (modal.open) {
+          if (typeof modal.close === 'function') {
+            modal.close();
+          } else {
+            modal.removeAttribute('open');
+          }
+        }
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        statusEl.textContent = 'Thank you for sharing your feedback!';
+      });
+
+      // Open the feedback modal overlay on load so it is active immediately
+      openModal();
+    })();
+  </script>
