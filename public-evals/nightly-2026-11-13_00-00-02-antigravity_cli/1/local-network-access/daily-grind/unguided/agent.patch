+  <script>
+    (function () {
+      const logEl = document.getElementById('equipment-log');
+      const secureBadge = document.getElementById('secure-context-badge');
+      const localPermBadge = document.getElementById('local-permission-badge');
+      const loopbackPermBadge = document.getElementById('loopback-permission-badge');
+      const brewerStatusBadge = document.getElementById('brewer-status-badge');
+      const helperStatusBadge = document.getElementById('helper-status-badge');
+
+      const brewerEndpointInput = document.getElementById('brewer-endpoint');
+      const brewerProfileSelect = document.getElementById('brewer-profile');
+      const helperEndpointInput = document.getElementById('helper-endpoint');
+      const helperPresetSelect = document.getElementById('helper-preset');
+
+      function appendLog(message) {
+        if (!logEl) return;
+        const entry = document.createElement('div');
+        entry.className = 'log-entry';
+        const time = new Date().toLocaleTimeString();
+        const tsSpan = document.createElement('span');
+        tsSpan.className = 'timestamp';
+        tsSpan.textContent = '[' + time + ']';
+        entry.appendChild(tsSpan);
+        entry.appendChild(document.createTextNode(' ' + message));
+        logEl.prepend(entry);
+      }
+
+      function normalizeEndpointUrl(raw, defaultUrl) {
+        const trimmed = (raw || '').trim();
+        if (!trimmed) return defaultUrl;
+        if (/^https?:\/\//i.test(trimmed)) return trimmed;
+        return 'http://' + trimmed;
+      }
+
+      function updateBadge(badgeEl, text, variant) {
+        if (!badgeEl) return;
+        badgeEl.textContent = text;
+        badgeEl.className = 'badge' + (variant ? ' ' + variant : '');
+      }
+
+      function checkSecureContext() {
+        if (window.isSecureContext) {
+          updateBadge(secureBadge, 'Secure Context (LNA Ready)', 'secure');
+          appendLog('Secure context verified (window.isSecureContext = true). Local Network Access is supported.');
+        } else {
+          updateBadge(secureBadge, 'Insecure Context (HTTPS Required)', 'insecure');
+          appendLog('Warning: Page is not in a secure context. Browsers require HTTPS for Local Network Access requests.');
+        }
+      }
+
+      /**
+       * Query Local Network Access permissions using the split permission names:
+       * - 'local-network' for private LAN devices (e.g., 192.168.1.x)
+       * - 'loopback-network' for local machine companion apps (e.g., 127.0.0.1)
+       * Falls back to 'local-network-access' if the browser uses the legacy alias.
+       */
+      async function queryLnaPermission(permissionName, badgeEl) {
+        if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
+          updateBadge(badgeEl, 'Permissions API Unavailable', 'prompt');
+          appendLog('Permissions API unavailable while checking ' + permissionName + '.');
+          return null;
+        }
+
+        try {
+          const status = await navigator.permissions.query({ name: permissionName });
+          const applyState = () => {
+            updateBadge(
+              badgeEl,
+              permissionName + ': ' + status.state,
+              status.state === 'granted' ? 'granted' : status.state === 'denied' ? 'denied' : 'prompt'
+            );
+          };
+          applyState();
+          status.onchange = () => {
+            applyState();
+            appendLog('Permission state changed for ' + permissionName + ': ' + status.state);
+          };
+          appendLog('Queried permission "' + permissionName + '" -> state: ' + status.state);
+          return status.state;
+        } catch (primaryErr) {
+          try {
+            const fallbackStatus = await navigator.permissions.query({ name: 'local-network-access' });
+            updateBadge(
+              badgeEl,
+              permissionName + ' (via local-network-access): ' + fallbackStatus.state,
+              fallbackStatus.state === 'granted' ? 'granted' : fallbackStatus.state === 'denied' ? 'denied' : 'prompt'
+            );
+            appendLog('Queried fallback permission "local-network-access" for ' + permissionName + ' -> state: ' + fallbackStatus.state);
+            return fallbackStatus.state;
+          } catch (fallbackErr) {
+            updateBadge(badgeEl, 'Prompt on Request', 'prompt');
+            appendLog('Permission query for "' + permissionName + '" not pre-queryable (' + primaryErr.message + '); browser will prompt on fetch.');
+            return null;
