+              pressure: profile === 'espresso-9bar' ? '9.0 bar' : '1.5 bar',
+              state: isBrewAction ? 'Brewing (' + profile + ')' : 'Standby (Simulated)'
+            });
+            appendLog(
+              'LAN fetch({ targetAddressSpace: "local" }) to ' + url + ' completed LNA check; hardware endpoint unreachable (' + err.message + '), showing simulated telemetry.'
+            );
+          }
+        }
+      }
+
+      function updateBrewerTelemetry(data) {
