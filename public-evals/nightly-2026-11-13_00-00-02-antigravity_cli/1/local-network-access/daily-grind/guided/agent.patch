+  <script type="module">
+    const activeSockets = {
+      'local-network': null,
+      'loopback-network': null,
+    };
+
+    /**
+     * Updates the permission badge and remediation UI for a granular LNA permission.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @param {'granted' | 'prompt' | 'denied'} state
+     */
+    function updatePermissionUI(permissionName, state) {
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const badgePill = document.querySelector(`[data-permission-badge="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+
+      if (statusBadge) {
+        statusBadge.textContent = state;
+      }
+      if (badgePill) {
+        badgePill.dataset.state = state;
+      }
+      if (remediationBox) {
+        remediationBox.hidden = state !== 'denied';
+      }
+    }
+
+    /**
+     * Cross-browser permission check for the granular LNA permissions ('local-network' | 'loopback-network').
+     * Never queries the legacy 'local-network-access' alias, which crashes older Chrome renderers.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @param {() => void} [onGrantedCallback]
+     * @returns {Promise<'granted' | 'prompt' | 'denied'>}
+     */
+    export async function checkNetworkPermission(permissionName, onGrantedCallback) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+          if (status.state === 'granted' && typeof onGrantedCallback === 'function') {
+            onGrantedCallback();
+          }
+        });
+
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name in browsers without LNA support; fall back to 'prompt'
+        // so connections are only initiated upon explicit user gesture.
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    /**
+     * Connects to the shop Wi-Fi coffee brewer on the local LAN using targetAddressSpace: 'local'.
+     * @param {string} deviceUrl
+     */
+    export async function fetchLocalBrewerStatus(deviceUrl = 'http://192.168.1.100:8080/api/status') {
+      const request = new Request(deviceUrl, {
+        method: 'GET',
+        mode: 'cors',
+        // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+        targetAddressSpace: 'local',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Wi-Fi brewer responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Connects to the companion desktop brewing helper on the loopback interface using targetAddressSpace: 'loopback'.
+     * @param {string} daemonUrl
+     */
+    export async function fetchLoopbackBrewHelper(daemonUrl = 'http://127.0.0.1:45678/health') {
+      const request = new Request(daemonUrl, {
+        method: 'GET',
+        mode: 'cors',
+        // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+        targetAddressSpace: 'loopback',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Desktop brewing helper responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Opens a real-time telemetry WebSocket to a local LAN or loopback brewing endpoint.
+     * Passes only subprotocol string(s) as the second argument (never a targetAddressSpace options object).
+     * @param {string} wsUrl
+     */
+    export function openBrewTelemetrySocket(wsUrl) {
+      return new WebSocket(wsUrl, ['v1.telemetry']);
+    }
+
+    async function handleConnectBrewer() {
+      const urlInput = document.getElementById('lan-brewer-url');
+      const outputEl = document.getElementById('lan-brewer-output');
+      const connectBtn = document.getElementById('connect-lan-brewer-btn');
+      const targetUrl = urlInput?.value.trim() || 'http://192.168.1.100:8080/api/status';
+
+      if (outputEl) {
+        outputEl.textContent = `Connecting to shop Wi-Fi brewer at ${targetUrl} (targetAddressSpace: 'local')...`;
+      }
+      if (connectBtn) {
+        connectBtn.disabled = true;
+      }
+
+      try {
+        const data = await fetchLocalBrewerStatus(targetUrl);
+        if (outputEl) {
+          outputEl.textContent = `Connected to Wi-Fi Brewer:\n${JSON.stringify(data, null, 2)}`;
+        }
+      } catch (err) {
+        await checkNetworkPermission('local-network');
+        if (outputEl) {
+          outputEl.textContent =
+            `Could not reach Wi-Fi brewer at ${targetUrl} (${err?.message || 'Network Error'}).\n` +
+            `Troubleshooting:\n` +
+            `1. Confirm the brewer is powered on and connected to the shop's private Wi-Fi LAN (192.168.1.x).\n` +
+            `2. Verify that "Local network" permission is allowed in your browser's Site settings.\n` +
+            `3. Ensure this page is served over HTTPS (Secure Context).`;
+        }
+      } finally {
+        if (connectBtn) {
+          connectBtn.disabled = false;
+        }
+      }
+    }
+
+    async function handleConnectDesktopHelper() {
+      const urlInput = document.getElementById('loopback-helper-url');
+      const outputEl = document.getElementById('loopback-helper-output');
+      const connectBtn = document.getElementById('connect-loopback-helper-btn');
+      const targetUrl = urlInput?.value.trim() || 'http://127.0.0.1:45678/health';
+
+      if (outputEl) {
+        outputEl.textContent = `Connecting to desktop brewing helper at ${targetUrl} (targetAddressSpace: 'loopback')...`;
+      }
+      if (connectBtn) {
+        connectBtn.disabled = true;
+      }
+
+      try {
+        const data = await fetchLoopbackBrewHelper(targetUrl);
+        if (outputEl) {
+          outputEl.textContent = `Connected to Desktop Helper:\n${JSON.stringify(data, null, 2)}`;
+        }
+      } catch (err) {
+        await checkNetworkPermission('loopback-network');
+        if (outputEl) {
+          outputEl.textContent =
+            `Could not reach companion desktop helper at ${targetUrl} (${err?.message || 'Network Error'}).\n` +
+            `Troubleshooting:\n` +
+            `1. Ensure the Daily Grind Desktop Brewing Helper app is running on your computer (127.0.0.1).\n` +
+            `2. Verify that "Loopback network" permission is allowed in your browser's Site settings.\n` +
+            `3. Ensure this page is served over HTTPS (Secure Context).`;
+        }
+      } finally {
+        if (connectBtn) {
+          connectBtn.disabled = false;
+        }
+      }
+    }
+
+    function toggleTelemetryStream(permissionName, inputId, outputId, buttonId, label) {
+      const wsInput = document.getElementById(inputId);
+      const outputEl = document.getElementById(outputId);
+      const btnEl = document.getElementById(buttonId);
+      const existing = activeSockets[permissionName];
+
+      if (existing && existing.readyState <= WebSocket.OPEN) {
+        existing.close();
+        activeSockets[permissionName] = null;
+        if (btnEl) btnEl.textContent = label;
+        if (outputEl) outputEl.textContent = 'Telemetry stream closed.';
+        return;
+      }
+
+      const wsUrl = wsInput?.value.trim();
+      if (!wsUrl) return;
+
+      if (outputEl) {
+        outputEl.textContent = `Opening WebSocket stream to ${wsUrl}...`;
+      }
+
+      try {
+        const socket = openBrewTelemetrySocket(wsUrl);
+        activeSockets[permissionName] = socket;
+        if (btnEl) btnEl.textContent = 'Stop Stream';
+
+        socket.addEventListener('open', () => {
+          if (outputEl) {
+            outputEl.textContent = `Live telemetry connected (${wsUrl}). Waiting for brew events...`;
+          }
+        });
+
+        socket.addEventListener('message', (event) => {
+          if (outputEl) {
+            outputEl.textContent = `Live Telemetry:\n${event.data}`;
+          }
+        });
+
+        socket.addEventListener('error', async () => {
+          await checkNetworkPermission(permissionName);
+          if (outputEl) {
+            outputEl.textContent =
+              `WebSocket stream failed for ${wsUrl}. Check that the endpoint is running, on the expected network, and allowed in browser Local/Loopback Network permissions.`;
+          }
+        });
+
+        socket.addEventListener('close', () => {
+          activeSockets[permissionName] = null;
+          if (btnEl) btnEl.textContent = label;
+        });
+      } catch (err) {
+        if (outputEl) {
+          outputEl.textContent = `Unable to open WebSocket (${err?.message || 'Error'}).`;
+        }
+      }
+    }
+
+    async function initEquipmentPanel() {
+      const insecureWarning = document.getElementById('insecure-context-warning');
+      if (insecureWarning && !window.isSecureContext) {
+        insecureWarning.hidden = false;
+      }
+
+      document
+        .getElementById('connect-lan-brewer-btn')
+        ?.addEventListener('click', handleConnectBrewer);
+
+      document
+        .getElementById('connect-loopback-helper-btn')
+        ?.addEventListener('click', handleConnectDesktopHelper);
+
+      document
+        .getElementById('stream-lan-brewer-btn')
+        ?.addEventListener('click', () =>
+          toggleTelemetryStream(
+            'local-network',
+            'lan-brewer-ws-url',
+            'lan-brewer-output',
+            'stream-lan-brewer-btn',
+            'Start Live Telemetry'
+          )
+        );
+
+      document
+        .getElementById('stream-loopback-helper-btn')
+        ?.addEventListener('click', () =>
+          toggleTelemetryStream(
+            'loopback-network',
+            'loopback-helper-ws-url',
+            'loopback-helper-output',
+            'stream-loopback-helper-btn',
+            'Stream Scale Weight'
+          )
+        );
+
+      // Pre-check granular permissions without firing network requests when state is 'prompt' or 'denied'.
+      // Automatically connect only if permission has already been granted.
+      const lanState = await checkNetworkPermission('local-network', handleConnectBrewer);
+      if (lanState === 'granted') {
+        handleConnectBrewer();
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network', handleConnectDesktopHelper);
+      if (loopbackState === 'granted') {
+        handleConnectDesktopHelper();
+      }
+    }
+
+    initEquipmentPanel();
+  </script>
 </body>
 
