+                  ({logs.length} {logs.length === 1 ? 'event' : 'events'})
+                </span>
+              </div>
+              {logs.length > 0 && (
+                <button
+                  type="button"
+                  onClick={() => setLogs([])}
+                  className="text-[11px] text-gray-500 hover:text-gray-800 cursor-pointer"
+                >
+                  Clear Log
+                </button>
+              )}
+            </div>
+            <div className="max-h-36 overflow-y-auto divide-y divide-gray-100 font-mono text-xs">
+              {logs.length === 0 ? (
+                <div className="px-4 py-3 text-gray-400">
+                  No connection requests sent yet. Select an endpoint above to initiate a Local Network
+                  Access handshake.
+                </div>
+              ) : (
+                logs.map((entry) => (
+                  <div key={entry.id} className="px-4 py-2 flex items-start gap-2.5">
+                    <span className="text-gray-400 shrink-0">[{entry.timestamp}]</span>
+                    <span
+                      className={`uppercase text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0 ${
+                        entry.target === 'lan-device'
+                          ? 'bg-blue-50 text-blue-700 border border-blue-200'
+                          : entry.target === 'companion-cli'
+                          ? 'bg-purple-50 text-purple-700 border border-purple-200'
+                          : 'bg-gray-100 text-gray-700 border border-gray-200'
+                      }`}
+                    >
+                      {entry.target === 'lan-device'
+                        ? 'LAN (local)'
+                        : entry.target === 'companion-cli'
+                        ? 'CLI (loopback)'
+                        : 'LNA'}
+                    </span>
+                    <div className="flex-1 min-w-0">
+                      <p
+                        className={
+                          entry.level === 'error'
+                            ? 'text-red-700'
+                            : entry.level === 'success'
+                            ? 'text-emerald-700 font-semibold'
+                            : entry.level === 'warning'
+                            ? 'text-amber-700'
+                            : 'text-gray-800'
+                        }
+                      >
+                        {entry.message}
+                      </p>
+                      {entry.detail && (
+                        <p className="text-[11px] text-gray-500 truncate">{entry.detail}</p>
+                      )}
+                    </div>
+                  </div>
+                ))
+              )}
+            </div>
+          </div>
+        </div>
+      )}
+    </section>
+  );
+}
