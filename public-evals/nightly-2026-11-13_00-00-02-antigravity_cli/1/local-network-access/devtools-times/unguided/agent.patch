@@ -0,0 +1,1292 @@
+import React, { useState, useEffect, useCallback, useRef } from 'react';
+import type { TargetAddressSpace, LocalNetworkPermissionName } from '../../global';
+
+export type PermissionStateValue = PermissionState | 'checking' | 'unsupported';
+
+export type ConnectionState =
+  | 'idle'
+  | 'connecting'
+  | 'connected'
+  | 'permission-denied'
+  | 'error';
+
+export interface TelemetryData {
+  device?: string;
+  version?: string;
+  uptime?: string;
+  addressSpace: TargetAddressSpace;
+  endpoint: string;
+  latencyMs: number;
+  statusCode?: number;
+  timestamp: string;
+  metrics?: Record<string, string | number | boolean>;
+  raw?: unknown;
+}
+
+export interface DiagnosticLogEntry {
+  id: string;
+  timestamp: string;
+  target: 'lan-device' | 'companion-cli' | 'system';
+  addressSpace?: TargetAddressSpace;
+  level: 'info' | 'success' | 'warning' | 'error';
+  message: string;
+  detail?: string;
+}
+
+interface EndpointValidation {
+  valid: boolean;
+  warning?: string;
+  normalizedUrl: string;
+  detectedHost: string;
+}
+
+const DEFAULT_LAN_URL = 'http://192.168.1.100:8080/diagnostics';
+const DEFAULT_CLI_URL = 'http://127.0.0.1:4242/status';
+
+const LAN_PRESETS = [
+  { label: '192.168.1.100 (Test Rig)', url: 'http://192.168.1.100:8080/diagnostics' },
+  { label: '192.168.1.50 (Wi-Fi Probe)', url: 'http://192.168.1.50:8080/telemetry' },
+  { label: 'devtools-bench.local', url: 'http://devtools-bench.local:8080/diagnostics' },
+];
+
+const CLI_PRESETS = [
+  { label: '127.0.0.1:4242 (Companion CLI)', url: 'http://127.0.0.1:4242/status' },
+  { label: '127.0.0.1:9229 (Inspector)', url: 'http://127.0.0.1:9229/json/version' },
+  { label: 'localhost:4242 (Trace Agent)', url: 'http://localhost:4242/diagnostics' },
+];
+
+/**
+ * Validates and classifies an endpoint URL against the expected Local Network Access address space.
+ */
+export function validateEndpointForAddressSpace(
+  rawInput: string,
+  expectedSpace: 'local' | 'loopback'
+): EndpointValidation {
+  const trimmed = rawInput.trim();
+  if (!trimmed) {
+    return {
+      valid: false,
+      warning: 'Please enter a valid HTTP/HTTPS endpoint URL.',
+      normalizedUrl: '',
+      detectedHost: '',
+    };
+  }
+
+  const withProtocol = /^https?:\/\//i.test(trimmed) ? trimmed : `http://${trimmed}`;
+
+  try {
+    const parsed = new URL(withProtocol);
+    const host = parsed.hostname.toLowerCase();
+
+    const isLoopback =
+      host === 'localhost' ||
+      host === '::1' ||
+      host === '[::1]' ||
+      /^127\.(\d{1,3})\.(\d{1,3})\.(\d{1,3})$/.test(host);
+
+    const isPrivateLan =
+      /^192\.168\.(\d{1,3})\.(\d{1,3})$/.test(host) ||
+      /^10\.(\d{1,3})\.(\d{1,3})\.(\d{1,3})$/.test(host) ||
+      /^172\.(1[6-9]|2\d|3[0-1])\.(\d{1,3})\.(\d{1,3})$/.test(host) ||
+      /^169\.254\.(\d{1,3})\.(\d{1,3})$/.test(host) ||
+      host.endsWith('.local') ||
+      host.endsWith('.lan') ||
+      host.endsWith('.home.arpa');
+
+    if (expectedSpace === 'local') {
+      if (isLoopback) {
+        return {
+          valid: true,
+          warning:
+            'This host looks like a loopback address (127.0.0.1/localhost). Use a private LAN IP (e.g. 192.168.1.x) for targetAddressSpace: "local", or use the Companion CLI panel.',
+          normalizedUrl: parsed.toString(),
+          detectedHost: host,
+        };
+      }
+      if (!isPrivateLan) {
+        return {
+          valid: true,
+          warning:
+            'Custom hostname detected. The browser will verify after DNS resolution that it resolves to a private LAN IP matching targetAddressSpace: "local".',
+          normalizedUrl: parsed.toString(),
+          detectedHost: host,
+        };
+      }
+    }
+
+    if (expectedSpace === 'loopback') {
+      if (isPrivateLan) {
+        return {
+          valid: true,
+          warning:
+            'This host looks like a private Wi-Fi LAN IP (e.g. 192.168.1.x). Use 127.0.0.1 or localhost for targetAddressSpace: "loopback", or use the Hardware Test Device panel.',
+          normalizedUrl: parsed.toString(),
+          detectedHost: host,
+        };
+      }
+      if (!isLoopback) {
+        return {
+          valid: true,
+          warning:
+            'Hostname is not 127.0.0.1 or localhost. The browser will verify after DNS resolution that it resolves to the loopback interface (targetAddressSpace: "loopback").',
+          normalizedUrl: parsed.toString(),
+          detectedHost: host,
+        };
+      }
+    }
+
+    return {
+      valid: true,
+      normalizedUrl: parsed.toString(),
+      detectedHost: host,
+    };
+  } catch {
+    return {
+      valid: false,
+      warning: 'Malformed URL. Example: http://192.168.1.100:8080/diagnostics',
+      normalizedUrl: trimmed,
+      detectedHost: '',
+    };
+  }
+}
+
+/**
+ * Queries a granular Local Network Access permission ('local-network' or 'loopback-network')
+ * with fallback to the overarching 'local-network-access' permission descriptor.
+ */
+async function queryLnaPermission(
+  primaryName: 'local-network' | 'loopback-network'
+): Promise<{ status: PermissionStatus | null; state: PermissionStateValue; usedDescriptor: string }> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return { status: null, state: 'unsupported', usedDescriptor: primaryName };
+  }
+
+  const descriptorsToTry: LocalNetworkPermissionName[] = [
+    primaryName,
+    'local-network-access',
+  ];
+
+  for (const descriptorName of descriptorsToTry) {
+    try {
+      const status = await navigator.permissions.query({
+        name: descriptorName as PermissionName,
+      });
+      return {
+        status,
+        state: status.state,
+        usedDescriptor: descriptorName,
+      };
+    } catch {
+      // Try next fallback descriptor if the browser does not recognize this permission name
+    }
+  }
+
+  return { status: null, state: 'unsupported', usedDescriptor: primaryName };
+}
+
+interface Props {
+  compact?: boolean;
+}
+
+export default function DeveloperDiagnosticsWidget({ compact = false }: Props) {
+  // Hardware Test Device on Private Wi-Fi LAN (local address space)
+  const [lanUrl, setLanUrl] = useState<string>(DEFAULT_LAN_URL);
+  const [lanPermission, setLanPermission] = useState<PermissionStateValue>('checking');
+  const [lanPermissionDescriptor, setLanPermissionDescriptor] = useState<string>('local-network');
+  const [lanConnectionState, setLanConnectionState] = useState<ConnectionState>('idle');
+  const [lanTelemetry, setLanTelemetry] = useState<TelemetryData | null>(null);
+  const [lanError, setLanError] = useState<string | null>(null);
+  const [lanAutoReconnect, setLanAutoReconnect] = useState<boolean>(false);
+
+  // Local Companion CLI on Reader's Machine (loopback address space)
+  const [cliUrl, setCliUrl] = useState<string>(DEFAULT_CLI_URL);
+  const [cliPermission, setCliPermission] = useState<PermissionStateValue>('checking');
+  const [cliPermissionDescriptor, setCliPermissionDescriptor] = useState<string>('loopback-network');
+  const [cliConnectionState, setCliConnectionState] = useState<ConnectionState>('idle');
+  const [cliTelemetry, setCliTelemetry] = useState<TelemetryData | null>(null);
+  const [cliError, setCliError] = useState<string | null>(null);
+  const [cliAutoReconnect, setCliAutoReconnect] = useState<boolean>(false);
+
+  // Diagnostics Console & Setup Helper Drawer
+  const [logs, setLogs] = useState<DiagnosticLogEntry[]>([]);
+  const [showSetupGuide, setShowSetupGuide] = useState<boolean>(false);
+  const [isExpanded, setIsExpanded] = useState<boolean>(!compact);
+
+  const lanAbortRef = useRef<AbortController | null>(null);
+  const cliAbortRef = useRef<AbortController | null>(null);
+
+  const appendLog = useCallback(
+    (
+      target: DiagnosticLogEntry['target'],
+      level: DiagnosticLogEntry['level'],
+      message: string,
+      detail?: string,
+      addressSpace?: TargetAddressSpace
+    ) => {
+      const entry: DiagnosticLogEntry = {
+        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
+        timestamp: new Date().toLocaleTimeString(),
+        target,
+        addressSpace,
+        level,
+        message,
+        detail,
+      };
+      setLogs((prev) => [entry, ...prev.slice(0, 29)]);
+    },
+    []
+  );
+
+  // Refresh permission states via Permissions API without triggering network requests
+  const refreshPermissions = useCallback(async () => {
+    const [lanResult, cliResult] = await Promise.all([
+      queryLnaPermission('local-network'),
+      queryLnaPermission('loopback-network'),
+    ]);
+
+    setLanPermission(lanResult.state);
+    setLanPermissionDescriptor(lanResult.usedDescriptor);
+
+    setCliPermission(cliResult.state);
+    setCliPermissionDescriptor(cliResult.usedDescriptor);
+
+    return { lanResult, cliResult };
+  }, []);
+
+  /**
+   * Connect to the Hardware Test Device on the reader's private Wi-Fi LAN (e.g., 192.168.1.x)
+   * using fetch() with targetAddressSpace: 'local'.
+   */
+  const connectLanDevice = useCallback(
+    async (triggeredByUserGesture = true) => {
+      const validation = validateEndpointForAddressSpace(lanUrl, 'local');
+      if (!validation.valid) {
+        setLanError(validation.warning || 'Invalid LAN URL.');
+        setLanConnectionState('error');
+        return;
+      }
+
+      // Guard background/auto requests if permission is not already granted
+      if (!triggeredByUserGesture && lanPermission !== 'granted') {
+        appendLog(
+          'lan-device',
+          'info',
+          'Skipped automatic LAN request because local-network permission is not yet granted. Waiting for user gesture.',
+          `Current permission (${lanPermissionDescriptor}): ${lanPermission}`,
+          'local'
+        );
+        return;
+      }
+
+      if (lanAbortRef.current) {
+        lanAbortRef.current.abort();
+      }
+      const controller = new AbortController();
+      lanAbortRef.current = controller;
+      const timeoutId = setTimeout(() => controller.abort(), 5000);
+
+      setLanConnectionState('connecting');
+      setLanError(null);
+
+      appendLog(
+        'lan-device',
+        'info',
+        `Connecting to LAN hardware device at ${validation.normalizedUrl}`,
+        `fetch("${validation.normalizedUrl}", { mode: "cors", targetAddressSpace: "local" })`,
+        'local'
+      );
+
+      const startTime = performance.now();
+
+      try {
+        const request = new Request(validation.normalizedUrl, {
+          method: 'GET',
+          mode: 'cors',
+          targetAddressSpace: 'local',
+          headers: {
+            Accept: 'application/json',
+          },
+        });
+
+        const response = await fetch(request, {
+          mode: 'cors',
+          targetAddressSpace: 'local',
+          signal: controller.signal,
+        });
+
+        clearTimeout(timeoutId);
+        const latencyMs = Math.round(performance.now() - startTime);
+
+        let payload: Record<string, unknown> = {};
+        const contentType = response.headers.get('content-type') || '';
+        if (contentType.includes('application/json')) {
+          payload = (await response.json()) as Record<string, unknown>;
+        } else {
+          const text = await response.text();
+          payload = { responseText: text.slice(0, 200) };
+        }
+
+        if (!response.ok) {
+          throw new Error(`HTTP ${response.status} ${response.statusText}`);
+        }
+
+        const telemetry: TelemetryData = {
+          device:
+            typeof payload.device === 'string'
+              ? payload.device
+              : `LAN Hardware Probe (${validation.detectedHost})`,
+          version: typeof payload.version === 'string' ? payload.version : 'fw-2.4.1-lan',
+          uptime: typeof payload.uptime === 'string' ? payload.uptime : 'Connected',
+          addressSpace: 'local',
+          endpoint: validation.normalizedUrl,
+          latencyMs,
+          statusCode: response.status,
+          timestamp: new Date().toLocaleTimeString(),
+          metrics:
+            typeof payload.metrics === 'object' && payload.metrics !== null
+              ? (payload.metrics as Record<string, string | number | boolean>)
+              : {
+                  rssiDbm: -54,
+                  heapFreeKb: 184,
+                  addressSpace: 'local',
+                },
+          raw: payload,
+        };
+
+        setLanTelemetry(telemetry);
+        setLanConnectionState('connected');
+        await refreshPermissions();
+
+        appendLog(
+          'lan-device',
+          'success',
+          `Connected to ${telemetry.device} (${latencyMs} ms)`,
+          `HTTP ${response.status} • targetAddressSpace: "local"`,
+          'local'
+        );
+      } catch (err: unknown) {
+        clearTimeout(timeoutId);
+        const latencyMs = Math.round(performance.now() - startTime);
+        const { lanResult } = await refreshPermissions();
+
+        const errorMessage =
+          err instanceof Error ? err.message : 'Network error connecting to LAN device';
+
+        if (lanResult.state === 'denied') {
+          const deniedMsg =
+            'Browser blocked access because the "local-network" permission was denied. Enable Local Network Access in your browser site settings and retry.';
+          setLanError(deniedMsg);
+          setLanConnectionState('permission-denied');
+          appendLog(
+            'lan-device',
+            'error',
+            'Local Network Access permission denied (local-network)',
+            deniedMsg,
+            'local'
+          );
+        } else {
+          const detailedMsg =
+            err instanceof DOMException && err.name === 'AbortError'
+              ? `Connection timed out after ${latencyMs} ms reaching ${validation.normalizedUrl} (targetAddressSpace: "local"). Verify the hardware test device is online on your private Wi-Fi LAN.`
+              : `Request failed (${errorMessage}). Ensure the hardware device at ${validation.detectedHost} is reachable on your private Wi-Fi LAN, serves CORS headers (Access-Control-Allow-Origin and Access-Control-Allow-Private-Network: true), and local-network permission was granted.`;
+          setLanError(detailedMsg);
+          setLanConnectionState('error');
+          appendLog(
+            'lan-device',
+            'error',
+            `LAN device connection failed (${latencyMs} ms)`,
+            detailedMsg,
+            'local'
+          );
+        }
+      }
+    },
+    [lanUrl, lanPermission, lanPermissionDescriptor, appendLog, refreshPermissions]
+  );
+
+  /**
+   * Connect to the Local Companion CLI running on the reader's machine (127.0.0.1)
+   * using fetch() with targetAddressSpace: 'loopback'.
+   */
+  const connectCompanionCli = useCallback(
+    async (triggeredByUserGesture = true) => {
+      const validation = validateEndpointForAddressSpace(cliUrl, 'loopback');
+      if (!validation.valid) {
+        setCliError(validation.warning || 'Invalid Loopback CLI URL.');
+        setCliConnectionState('error');
+        return;
+      }
+
+      // Guard background/auto requests if permission is not already granted
+      if (!triggeredByUserGesture && cliPermission !== 'granted') {
+        appendLog(
+          'companion-cli',
+          'info',
+          'Skipped automatic loopback request because loopback-network permission is not yet granted. Waiting for user gesture.',
+          `Current permission (${cliPermissionDescriptor}): ${cliPermission}`,
+          'loopback'
+        );
+        return;
+      }
+
+      if (cliAbortRef.current) {
+        cliAbortRef.current.abort();
+      }
+      const controller = new AbortController();
+      cliAbortRef.current = controller;
+      const timeoutId = setTimeout(() => controller.abort(), 5000);
+
+      setCliConnectionState('connecting');
+      setCliError(null);
+
+      appendLog(
+        'companion-cli',
+        'info',
+        `Connecting to local companion CLI at ${validation.normalizedUrl}`,
+        `fetch("${validation.normalizedUrl}", { mode: "cors", targetAddressSpace: "loopback" })`,
+        'loopback'
+      );
+
+      const startTime = performance.now();
+
+      try {
+        const request = new Request(validation.normalizedUrl, {
+          method: 'GET',
+          mode: 'cors',
+          targetAddressSpace: 'loopback',
+          headers: {
+            Accept: 'application/json',
+          },
+        });
+
+        const response = await fetch(request, {
+          mode: 'cors',
+          targetAddressSpace: 'loopback',
+          signal: controller.signal,
+        });
+
+        clearTimeout(timeoutId);
+        const latencyMs = Math.round(performance.now() - startTime);
+
+        let payload: Record<string, unknown> = {};
+        const contentType = response.headers.get('content-type') || '';
+        if (contentType.includes('application/json')) {
+          payload = (await response.json()) as Record<string, unknown>;
+        } else {
+          const text = await response.text();
+          payload = { responseText: text.slice(0, 200) };
+        }
+
+        if (!response.ok) {
+          throw new Error(`HTTP ${response.status} ${response.statusText}`);
+        }
+
+        const telemetry: TelemetryData = {
+          device:
+            typeof payload.device === 'string'
+              ? payload.device
+              : `DevTools Companion CLI (${validation.detectedHost})`,
+          version: typeof payload.version === 'string' ? payload.version : 'cli-v1.8.0',
+          uptime: typeof payload.uptime === 'string' ? payload.uptime : 'Active',
+          addressSpace: 'loopback',
+          endpoint: validation.normalizedUrl,
+          latencyMs,
+          statusCode: response.status,
+          timestamp: new Date().toLocaleTimeString(),
+          metrics:
+            typeof payload.metrics === 'object' && payload.metrics !== null
+              ? (payload.metrics as Record<string, string | number | boolean>)
+              : {
+                  pid: 4242,
+                  cdpPort: 9229,
+                  addressSpace: 'loopback',
+                },
+          raw: payload,
+        };
+
+        setCliTelemetry(telemetry);
+        setCliConnectionState('connected');
+        await refreshPermissions();
+
+        appendLog(
+          'companion-cli',
+          'success',
+          `Connected to ${telemetry.device} (${latencyMs} ms)`,
+          `HTTP ${response.status} • targetAddressSpace: "loopback"`,
+          'loopback'
+        );
+      } catch (err: unknown) {
+        clearTimeout(timeoutId);
+        const latencyMs = Math.round(performance.now() - startTime);
+        const { cliResult } = await refreshPermissions();
+
+        const errorMessage =
+          err instanceof Error ? err.message : 'Network error connecting to Companion CLI';
+
+        if (cliResult.state === 'denied') {
+          const deniedMsg =
+            'Browser blocked access because the "loopback-network" permission was denied. Enable Loopback / Local Network Access in your browser site settings and retry.';
+          setCliError(deniedMsg);
+          setCliConnectionState('permission-denied');
+          appendLog(
+            'companion-cli',
+            'error',
+            'Loopback Network Access permission denied (loopback-network)',
+            deniedMsg,
+            'loopback'
+          );
+        } else {
+          const detailedMsg =
+            err instanceof DOMException && err.name === 'AbortError'
+              ? `Connection timed out after ${latencyMs} ms reaching ${validation.normalizedUrl} (targetAddressSpace: "loopback"). Ensure your local companion CLI is running on 127.0.0.1.`
+              : `Request failed (${errorMessage}). Ensure the companion CLI is listening on ${validation.detectedHost}, responds with CORS + Access-Control-Allow-Private-Network: true headers, and loopback-network permission was granted.`;
+          setCliError(detailedMsg);
+          setCliConnectionState('error');
+          appendLog(
+            'companion-cli',
+            'error',
+            `Companion CLI connection failed (${latencyMs} ms)`,
+            detailedMsg,
+            'loopback'
+          );
+        }
+      }
+    },
+    [cliUrl, cliPermission, cliPermissionDescriptor, appendLog, refreshPermissions]
+  );
+
+  const connectBothEndpoints = useCallback(async () => {
+    await Promise.all([connectLanDevice(true), connectCompanionCli(true)]);
+  }, [connectLanDevice, connectCompanionCli]);
+
+  const disconnectLan = useCallback(() => {
+    if (lanAbortRef.current) {
+      lanAbortRef.current.abort();
+    }
+    setLanConnectionState('idle');
+    setLanTelemetry(null);
+    setLanError(null);
+    appendLog('lan-device', 'info', 'Disconnected from private Wi-Fi LAN hardware device.', undefined, 'local');
+  }, [appendLog]);
+
+  const disconnectCli = useCallback(() => {
+    if (cliAbortRef.current) {
+      cliAbortRef.current.abort();
+    }
+    setCliConnectionState('idle');
+    setCliTelemetry(null);
+    setCliError(null);
+    appendLog('companion-cli', 'info', 'Disconnected from local companion CLI (127.0.0.1).', undefined, 'loopback');
+  }, [appendLog]);
+
+  // Query Permissions API on mount & attach reactive listeners without making unsolicited network requests
+  useEffect(() => {
+    let isMounted = true;
+    let lanStatusObj: PermissionStatus | null = null;
+    let cliStatusObj: PermissionStatus | null = null;
+
+    const handleLanPermissionChange = () => {
+      if (!isMounted || !lanStatusObj) return;
+      setLanPermission(lanStatusObj.state);
+      appendLog(
+        'lan-device',
+        lanStatusObj.state === 'denied' ? 'warning' : 'info',
+        `Permission state for "${lanPermissionDescriptor}" changed to "${lanStatusObj.state}"`,
+        undefined,
+        'local'
+      );
+      if (lanStatusObj.state === 'denied') {
+        setLanConnectionState('permission-denied');
+      }
+    };
+
+    const handleCliPermissionChange = () => {
+      if (!isMounted || !cliStatusObj) return;
+      setCliPermission(cliStatusObj.state);
+      appendLog(
+        'companion-cli',
+        cliStatusObj.state === 'denied' ? 'warning' : 'info',
+        `Permission state for "${cliPermissionDescriptor}" changed to "${cliStatusObj.state}"`,
+        undefined,
+        'loopback'
+      );
+      if (cliStatusObj.state === 'denied') {
+        setCliConnectionState('permission-denied');
+      }
+    };
+
+    (async () => {
+      const { lanResult, cliResult } = await refreshPermissions();
+      if (!isMounted) return;
+
+      lanStatusObj = lanResult.status;
+      cliStatusObj = cliResult.status;
+
+      if (lanStatusObj) {
+        lanStatusObj.addEventListener('change', handleLanPermissionChange);
+      }
+      if (cliStatusObj) {
+        cliStatusObj.addEventListener('change', handleCliPermissionChange);
+      }
+
+      appendLog(
+        'system',
+        'info',
+        `Local Network Access pre-check complete: local-network=${lanResult.state}, loopback-network=${cliResult.state}`,
+        'Requests are gated behind explicit user gestures unless permission is already granted.'
+      );
+    })();
+
+    return () => {
+      isMounted = false;
+      if (lanStatusObj) {
+        lanStatusObj.removeEventListener('change', handleLanPermissionChange);
+      }
+      if (cliStatusObj) {
+        cliStatusObj.removeEventListener('change', handleCliPermissionChange);
+      }
+      if (lanAbortRef.current) {
+        lanAbortRef.current.abort();
+      }
+      if (cliAbortRef.current) {
+        cliAbortRef.current.abort();
+      }
+    };
+  }, [appendLog, refreshPermissions, lanPermissionDescriptor, cliPermissionDescriptor]);
+
