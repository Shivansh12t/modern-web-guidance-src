+import React, { useState, useEffect, useRef, useCallback, useId } from 'react';
+import {
+  queryLnaPermissionSafe,
+  fetchLocalDeviceStatus,
+  fetchLoopbackDaemon,
+  openDiagnosticsWebSocket,
+  type LnaPermissionName,
+} from '../utils/localNetwork';
+
+type ConnectionStatus = 'idle' | 'connecting' | 'connected' | 'error';
+
+interface EndpointState {
+  url: string;
+  wsUrl: string;
+  permissionState: PermissionState;
+  status: ConnectionStatus;
+  wsStatus: ConnectionStatus;
+  payload: Record<string, unknown> | null;
+  errorMessage: string | null;
+  lastCheckedAt: string | null;
+  telemetryMessages: string[];
+}
+
+export interface DiagnosticsConnectionWidgetProps {
+  /** Render either a compact header trigger + modal dialog or an inline panel */
+  variant?: 'header' | 'inline';
+}
+
+export default function DiagnosticsConnectionWidget({
+  variant = 'header',
+}: DiagnosticsConnectionWidgetProps) {
+  const dialogRef = useRef<HTMLDialogElement | null>(null);
+  const dialogTitleId = useId();
+  const lanInputId = useId();
+  const lanWsInputId = useId();
+  const cliInputId = useId();
+  const cliWsInputId = useId();
+
+  const lanSocketRef = useRef<WebSocket | null>(null);
+  const cliSocketRef = useRef<WebSocket | null>(null);
+
+  const [isSecure, setIsSecure] = useState<boolean>(true);
+
+  const [lanState, setLanState] = useState<EndpointState>({
+    url: 'http://192.168.1.42:8080/api/diagnostics',
+    wsUrl: 'ws://192.168.1.42:8080/stream',
+    permissionState: 'prompt',
+    status: 'idle',
+    wsStatus: 'idle',
+    payload: null,
+    errorMessage: null,
+    lastCheckedAt: null,
+    telemetryMessages: [],
+  });
+
+  const [cliState, setCliState] = useState<EndpointState>({
+    url: 'http://127.0.0.1:45678/health',
+    wsUrl: 'ws://127.0.0.1:45678/events',
+    permissionState: 'prompt',
+    status: 'idle',
+    wsStatus: 'idle',
+    payload: null,
+    errorMessage: null,
+    lastCheckedAt: null,
+    telemetryMessages: [],
+  });
+
+  const handleConnectLan = useCallback(async (targetUrl: string) => {
+    setLanState((prev) => ({
+      ...prev,
+      status: 'connecting',
+      errorMessage: null,
+    }));
+
+    try {
+      const data = await fetchLocalDeviceStatus(targetUrl);
+      setLanState((prev) => ({
+        ...prev,
+        status: 'connected',
+        payload: data,
+        errorMessage: null,
+        lastCheckedAt: new Date().toLocaleTimeString(),
+      }));
+    } catch (err) {
+      const message =
+        err instanceof Error
+          ? err.message
+          : 'Unable to reach hardware test device on private Wi-Fi LAN.';
+      const updatedPerm = await queryLnaPermissionSafe('local-network');
+      setLanState((prev) => ({
+        ...prev,
+        permissionState: updatedPerm,
+        status: 'error',
+        errorMessage: `${message} Verify the hardware device at ${targetUrl} is powered on, on the same Wi-Fi LAN, sends Access-Control-Allow-Origin, and is allowed under Local network permission.`,
+        lastCheckedAt: new Date().toLocaleTimeString(),
+      }));
+    }
+  }, []);
+
+  const handleConnectCli = useCallback(async (targetUrl: string) => {
+    setCliState((prev) => ({
+      ...prev,
+      status: 'connecting',
+      errorMessage: null,
+    }));
+
+    try {
+      const data = await fetchLoopbackDaemon(targetUrl);
+      setCliState((prev) => ({
+        ...prev,
+        status: 'connected',
+        payload: data,
+        errorMessage: null,
+        lastCheckedAt: new Date().toLocaleTimeString(),
+      }));
+    } catch (err) {
+      const message =
+        err instanceof Error
+          ? err.message
+          : 'Unable to reach local companion CLI on loopback interface.';
+      const updatedPerm = await queryLnaPermissionSafe('loopback-network');
+      setCliState((prev) => ({
+        ...prev,
+        permissionState: updatedPerm,
+        status: 'error',
+        errorMessage: `${message} Verify the companion CLI daemon (e.g. npx @devtools-times/companion-cli --port 45678) is running on 127.0.0.1 and allowed under Loopback network permission.`,
+        lastCheckedAt: new Date().toLocaleTimeString(),
+      }));
+    }
+  }, []);
+
+  // Pre-check granular LNA permissions ('local-network' and 'loopback-network')
+  // Only auto-connect if permission is already 'granted'; never fire on load when 'prompt'
+  useEffect(() => {
+    if (typeof window !== 'undefined') {
+      setIsSecure(window.isSecureContext);
+    }
+
+    let isMounted = true;
+
+    async function initPermissions() {
+      const localPerm = await queryLnaPermissionSafe('local-network', (newState) => {
+        if (isMounted) {
+          setLanState((prev) => ({ ...prev, permissionState: newState }));
+        }
+      });
+
+      const loopbackPerm = await queryLnaPermissionSafe('loopback-network', (newState) => {
+        if (isMounted) {
+          setCliState((prev) => ({ ...prev, permissionState: newState }));
+        }
+      });
+
+      if (!isMounted) return;
+
+      setLanState((prev) => ({ ...prev, permissionState: localPerm }));
+      setCliState((prev) => ({ ...prev, permissionState: loopbackPerm }));
+
+      // Automatically connect only if the granular permission is already 'granted'
+      if (localPerm === 'granted') {
+        handleConnectLan('http://192.168.1.42:8080/api/diagnostics');
+      }
+      if (loopbackPerm === 'granted') {
+        handleConnectCli('http://127.0.0.1:45678/health');
+      }
+    }
+
+    initPermissions();
+
+    return () => {
+      isMounted = false;
+      lanSocketRef.current?.close();
+      cliSocketRef.current?.close();
+    };
+  }, [handleConnectLan, handleConnectCli]);
+
+  // Light-dismiss fallback for browsers without native <dialog closedby="any"> support
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog || typeof HTMLDialogElement === 'undefined') return;
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const handleBackdropClick = (event: MouseEvent) => {
+        if (event.target !== dialog) return;
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent =
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width;
+        if (isDialogContent) return;
+        dialog.close();
+      };
+      dialog.addEventListener('click', handleBackdropClick);
+      return () => {
+        dialog.removeEventListener('click', handleBackdropClick);
+      };
+    }
+  }, []);
+
+  const handleToggleLanStream = () => {
+    if (lanSocketRef.current && lanState.wsStatus === 'connected') {
+      lanSocketRef.current.close();
+      lanSocketRef.current = null;
+      setLanState((prev) => ({ ...prev, wsStatus: 'idle' }));
+      return;
+    }
+
+    setLanState((prev) => ({ ...prev, wsStatus: 'connecting', errorMessage: null }));
+    try {
+      const ws = openDiagnosticsWebSocket(lanState.wsUrl, ['v1.telemetry']);
+      lanSocketRef.current = ws;
+
+      ws.addEventListener('open', () => {
+        setLanState((prev) => ({
+          ...prev,
+          wsStatus: 'connected',
+          telemetryMessages: [
+            `[${new Date().toLocaleTimeString()}] Stream connected to ${prev.wsUrl}`,
+            ...prev.telemetryMessages.slice(0, 4),
+          ],
+        }));
+      });
+
+      ws.addEventListener('message', (event) => {
+        setLanState((prev) => ({
+          ...prev,
+          telemetryMessages: [
+            `[${new Date().toLocaleTimeString()}] ${String(event.data)}`,
+            ...prev.telemetryMessages.slice(0, 4),
+          ],
+        }));
+      });
+
+      ws.addEventListener('error', () => {
+        setLanState((prev) => ({
+          ...prev,
+          wsStatus: 'error',
+          errorMessage: `WebSocket stream to ${prev.wsUrl} failed. Ensure the LAN test device accepts ws:// connections with subprotocol v1.telemetry and Local network permission is allowed.`,
+        }));
+      });
+
+      ws.addEventListener('close', () => {
+        setLanState((prev) => ({
+          ...prev,
+          wsStatus: prev.wsStatus === 'error' ? 'error' : 'idle',
+        }));
+      });
+    } catch (err) {
+      setLanState((prev) => ({
+        ...prev,
+        wsStatus: 'error',
+        errorMessage:
+          err instanceof Error ? err.message : 'Invalid WebSocket URL for LAN device.',
+      }));
+    }
+  };
+
+  const handleToggleCliStream = () => {
+    if (cliSocketRef.current && cliState.wsStatus === 'connected') {
+      cliSocketRef.current.close();
+      cliSocketRef.current = null;
+      setCliState((prev) => ({ ...prev, wsStatus: 'idle' }));
+      return;
+    }
+
+    setCliState((prev) => ({ ...prev, wsStatus: 'connecting', errorMessage: null }));
+    try {
+      const ws = openDiagnosticsWebSocket(cliState.wsUrl, ['v1.companion']);
+      cliSocketRef.current = ws;
+
+      ws.addEventListener('open', () => {
+        setCliState((prev) => ({
+          ...prev,
+          wsStatus: 'connected',
+          telemetryMessages: [
+            `[${new Date().toLocaleTimeString()}] Stream connected to ${prev.wsUrl}`,
+            ...prev.telemetryMessages.slice(0, 4),
+          ],
+        }));
+      });
+
+      ws.addEventListener('message', (event) => {
+        setCliState((prev) => ({
+          ...prev,
+          telemetryMessages: [
+            `[${new Date().toLocaleTimeString()}] ${String(event.data)}`,
+            ...prev.telemetryMessages.slice(0, 4),
+          ],
+        }));
+      });
+
+      ws.addEventListener('error', () => {
+        setCliState((prev) => ({
+          ...prev,
+          wsStatus: 'error',
+          errorMessage: `WebSocket stream to ${prev.wsUrl} failed. Ensure the local companion CLI is listening on loopback and Loopback network permission is allowed.`,
+        }));
+      });
+
+      ws.addEventListener('close', () => {
+        setCliState((prev) => ({
+          ...prev,
+          wsStatus: prev.wsStatus === 'error' ? 'error' : 'idle',
+        }));
+      });
+    } catch (err) {
+      setCliState((prev) => ({
+        ...prev,
+        wsStatus: 'error',
+        errorMessage:
+          err instanceof Error ? err.message : 'Invalid WebSocket URL for Companion CLI.',
+      }));
+    }
+  };
+
+  const openModal = () => {
+    const dialog = dialogRef.current;
+    if (dialog && !dialog.open) {
+      dialog.showModal();
+    }
+  };
+
+  const closeModal = () => {
+    const dialog = dialogRef.current;
+    if (dialog && dialog.open) {
+      dialog.close();
+    }
+  };
+
+  const renderPermissionBadge = (
+    permissionName: LnaPermissionName,
+    state: PermissionState
+  ) => {
+    const badgeStyles: Record<PermissionState, string> = {
