diff --git a/src/utils/localNetwork.ts b/src/utils/localNetwork.ts
new file mode 100644
index 0000000..2272cea
--- /dev/null
+++ b/src/utils/localNetwork.ts
@@ -0,0 +1,98 @@
+/**
+ * Local Network Access (LNA) utilities for connecting to hardware test devices
+ * on a private Wi-Fi LAN (`local-network` / `targetAddressSpace: 'local'`) and
+ * a local companion CLI daemon on the machine's loopback interface
+ * (`loopback-network` / `targetAddressSpace: 'loopback'`).
+ */
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+export interface LnaRequestInit extends RequestInit {
+  targetAddressSpace?: TargetAddressSpace;
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions
+ * (`'local-network'` or `'loopback-network'`).
+ * Never queries the legacy `'local-network-access'` alias, which crashes older Chrome versions.
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    if (onChange) {
+      status.addEventListener('change', () => {
+        onChange(status.state);
+      });
+    }
+    return status.state;
+  } catch {
+    // Unrecognized permission name in browsers without LNA support; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Connects to a hardware test device on the private Wi-Fi LAN (e.g., 192.168.1.x or .local) over HTTP.
+ * Explicitly declares `targetAddressSpace: 'local'` for Mixed Content exemption and DNS address space verification.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/diagnostics',
+  signal?: AbortSignal
+): Promise<Record<string, unknown>> {
+  const init: LnaRequestInit = {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+    signal,
+  };
+  const request = new Request(deviceUrl, init as RequestInit);
+  const response = await fetch(request, init as RequestInit);
+  if (!response.ok) {
+    throw new Error(`LAN test device responded with HTTP ${response.status}`);
+  }
+  return (await response.json()) as Record<string, unknown>;
+}
+
+/**
+ * Connects to a local companion CLI daemon running on the user's loopback interface (127.0.0.1, [::1], or localhost).
+ * Explicitly declares `targetAddressSpace: 'loopback'` for Mixed Content exemption and DNS address space verification.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  signal?: AbortSignal
+): Promise<Record<string, unknown>> {
+  const init: LnaRequestInit = {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+    signal,
+  };
+  const request = new Request(daemonUrl, init as RequestInit);
+  const response = await fetch(request, init as RequestInit);
+  if (!response.ok) {
+    throw new Error(`Companion CLI responded with HTTP ${response.status}`);
+  }
+  return (await response.json()) as Record<string, unknown>;
+}
+
+/**
+ * Opens a WebSocket telemetry stream to a local LAN device or loopback companion CLI.
+ * Only subprotocol string(s) are passed as the second argument (never an options object).
+ */
+export function openDiagnosticsWebSocket(
+  wsUrl: string,
+  subprotocols: string[] = ['v1.devtools-diagnostics']
+): WebSocket {
+  return new WebSocket(wsUrl, subprotocols);
+}
