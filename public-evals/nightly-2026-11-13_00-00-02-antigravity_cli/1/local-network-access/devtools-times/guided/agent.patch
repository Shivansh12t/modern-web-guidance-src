+      denied: 'bg-red-100 text-red-800 border-red-300',
+    };
+    return (
+      <span
+        data-permission-status={permissionName}
+        className={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs font-mono font-semibold border ${badgeStyles[state]}`}
+      >
+        <span
+          className={`w-1.5 h-1.5 rounded-full ${
+            state === 'granted'
+              ? 'bg-emerald-600'
+              : state === 'denied'
+                ? 'bg-red-600'
+                : 'bg-amber-500'
+          }`}
+        />
+        {permissionName}: {state}
+      </span>
+    );
+  };
+
+  const renderConnectionBadge = (status: ConnectionStatus) => {
+    const styles: Record<ConnectionStatus, string> = {
+      idle: 'bg-gray-100 text-gray-700',
+      connecting: 'bg-blue-100 text-blue-800',
+      connected: 'bg-emerald-100 text-emerald-800',
+      error: 'bg-red-100 text-red-800',
+    };
+    const labels: Record<ConnectionStatus, string> = {
+      idle: 'Disconnected',
+      connecting: 'Connecting…',
+      connected: 'Connected',
+      error: 'Connection Failed',
+    };
+    return (
+      <span className={`px-2 py-0.5 rounded text-xs font-semibold ${styles[status]}`}>
+        {labels[status]}
+      </span>
+    );
+  };
+
+  const overallConnectedCount =
+    (lanState.status === 'connected' ? 1 : 0) +
+    (cliState.status === 'connected' ? 1 : 0);
+
+  const diagnosticsContent = (
+    <div className="space-y-5 text-left font-sans">
+      {!isSecure && (
+        <div
+          role="alert"
+          className="p-3 rounded-md bg-red-50 border border-red-200 text-xs text-red-800"
+        >
+          <strong>Insecure Context Detected:</strong> Local Network Access (
+          <code className="font-mono">local-network</code> and{' '}
+          <code className="font-mono">loopback-network</code>) requires a Secure
+          Context (<code className="font-mono">https://</code>). Browsers automatically
+          deny LNA permissions in insecure <code className="font-mono">http://</code>{' '}
+          top-level contexts.
+        </div>
+      )}
+
+      <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
+        {/* Card 1: Hardware Test Device on Private Wi-Fi LAN */}
+        <section
+          aria-label="Private Wi-Fi LAN Hardware Test Device"
+          className="border border-gray-200 rounded-lg p-4 bg-gray-50/60 flex flex-col justify-between space-y-4"
+        >
+          <div className="space-y-3">
+            <div className="flex flex-wrap items-center justify-between gap-2">
+              <div className="flex items-center gap-2">
+                <span className="p-1.5 rounded bg-gray-900 text-amber-400">
+                  <svg
+                    xmlns="http://www.w3.org/2000/svg"
+                    className="h-4 w-4"
+                    fill="none"
+                    viewBox="0 0 24 24"
+                    stroke="currentColor"
+                    strokeWidth={2}
+                  >
+                    <path
+                      strokeLinecap="round"
+                      strokeLinejoin="round"
+                      d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"
+                    />
+                  </svg>
+                </span>
+                <div>
+                  <h4 className="text-sm font-bold text-gray-900">
+                    Hardware Test Device (Wi-Fi LAN)
+                  </h4>
+                  <p className="text-xs text-gray-500">
+                    Address Space: <code className="font-mono">targetAddressSpace: &apos;local&apos;</code>
+                  </p>
+                </div>
+              </div>
+              {renderConnectionBadge(lanState.status)}
+            </div>
+
+            <div className="flex flex-wrap items-center gap-2">
+              {renderPermissionBadge('local-network', lanState.permissionState)}
+              <span className="text-[11px] text-gray-500">
+                RFC 1918 (<code className="font-mono">192.168.1.x</code>) /{' '}
+                <code className="font-mono">.local</code> mDNS
+              </span>
+            </div>
+
+            {lanState.permissionState === 'prompt' && (
+              <p className="text-xs text-gray-600 bg-white p-2.5 rounded border border-gray-200">
+                Connecting lets The DevTools Times read live profiling &amp; frame-timing
+                telemetry directly from your hardware test device on your private Wi-Fi
+                LAN. Your browser will ask for <strong>Local network</strong> permission
+                when you click Connect.
+              </p>
+            )}
+
+            <div
+              data-remediation="local-network"
+              hidden={lanState.permissionState !== 'denied'}
+              className="p-2.5 rounded bg-red-50 border border-red-200 text-xs text-red-800 space-y-1"
+            >
+              <p className="font-semibold">
+                Local network access is blocked in browser settings.
+              </p>
+              <p>
+                To re-enable: click the site information / tune icon in your browser&apos;s
+                address bar → open <strong>Site settings</strong> → change{' '}
+                <strong>Local network</strong> from <em>Block</em> to <em>Allow</em>, then
+                retry below.
+              </p>
+            </div>
+
+            <div className="space-y-2">
+              <div>
+                <label
+                  htmlFor={lanInputId}
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  LAN Device HTTP Diagnostics Endpoint
+                </label>
+                <input
+                  id={lanInputId}
+                  type="url"
+                  value={lanState.url}
+                  onChange={(e) =>
+                    setLanState((prev) => ({ ...prev, url: e.target.value }))
+                  }
+                  placeholder="http://192.168.1.42:8080/api/diagnostics"
+                  className="w-full px-2.5 py-1.5 text-xs font-mono bg-white border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-amber-400"
+                />
+              </div>
+
+              <div>
+                <label
+                  htmlFor={lanWsInputId}
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  LAN Telemetry WebSocket (<code className="font-mono">ws://</code> IP literal / <code className="font-mono">.local</code>)
+                </label>
+                <input
+                  id={lanWsInputId}
+                  type="url"
+                  value={lanState.wsUrl}
+                  onChange={(e) =>
+                    setLanState((prev) => ({ ...prev, wsUrl: e.target.value }))
+                  }
+                  placeholder="ws://192.168.1.42:8080/stream"
+                  className="w-full px-2.5 py-1.5 text-xs font-mono bg-white border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-amber-400"
+                />
+              </div>
+            </div>
+
+            {lanState.errorMessage && (
+              <div
+                role="status"
+                className="p-2.5 rounded bg-amber-50 border border-amber-200 text-xs text-amber-900"
+              >
+                {lanState.errorMessage}
+              </div>
+            )}
+
+            {lanState.payload && (
+              <div className="p-2.5 rounded bg-gray-900 text-emerald-300 text-xs font-mono overflow-x-auto max-h-32">
+                <pre>{JSON.stringify(lanState.payload, null, 2)}</pre>
+              </div>
+            )}
+
+            {lanState.telemetryMessages.length > 0 && (
+              <div className="p-2 rounded bg-gray-900 text-gray-200 text-[11px] font-mono space-y-0.5 max-h-24 overflow-y-auto">
+                {lanState.telemetryMessages.map((msg, idx) => (
+                  <div key={idx}>{msg}</div>
+                ))}
+              </div>
+            )}
+          </div>
+
+          <div className="pt-2 border-t border-gray-200 flex flex-wrap items-center gap-2">
+            <button
+              type="button"
+              onClick={() => handleConnectLan(lanState.url)}
+              disabled={lanState.status === 'connecting'}
+              className="px-3 py-1.5 bg-gray-900 hover:bg-gray-800 disabled:opacity-50 text-white text-xs font-semibold rounded transition cursor-pointer"
+            >
+              {lanState.status === 'connecting'
+                ? 'Connecting to LAN…'
+                : 'Connect LAN Device'}
+            </button>
+            <button
+              type="button"
+              onClick={handleToggleLanStream}
+              className="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-800 border border-gray-300 text-xs font-semibold rounded transition cursor-pointer"
+            >
+              {lanState.wsStatus === 'connected'
+                ? 'Stop WS Stream'
+                : 'Stream via WebSocket'}
+            </button>
+            {lanState.lastCheckedAt && (
+              <span className="text-[11px] text-gray-500 ml-auto">
+                Checked {lanState.lastCheckedAt}
+              </span>
+            )}
+          </div>
+        </section>
+
+        {/* Card 2: Local Companion CLI on Loopback (127.0.0.1) */}
+        <section
+          aria-label="Local Companion CLI on Loopback"
+          className="border border-gray-200 rounded-lg p-4 bg-gray-50/60 flex flex-col justify-between space-y-4"
+        >
+          <div className="space-y-3">
+            <div className="flex flex-wrap items-center justify-between gap-2">
+              <div className="flex items-center gap-2">
+                <span className="p-1.5 rounded bg-gray-900 text-amber-400">
+                  <svg
+                    xmlns="http://www.w3.org/2000/svg"
+                    className="h-4 w-4"
+                    fill="none"
+                    viewBox="0 0 24 24"
+                    stroke="currentColor"
+                    strokeWidth={2}
+                  >
+                    <path
+                      strokeLinecap="round"
+                      strokeLinejoin="round"
+                      d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
+                    />
+                  </svg>
+                </span>
+                <div>
+                  <h4 className="text-sm font-bold text-gray-900">
+                    Local Companion CLI (Loopback)
+                  </h4>
+                  <p className="text-xs text-gray-500">
+                    Address Space: <code className="font-mono">targetAddressSpace: &apos;loopback&apos;</code>
+                  </p>
+                </div>
+              </div>
+              {renderConnectionBadge(cliState.status)}
+            </div>
+
+            <div className="flex flex-wrap items-center gap-2">
+              {renderPermissionBadge('loopback-network', cliState.permissionState)}
+              <span className="text-[11px] text-gray-500">
+                Loopback (<code className="font-mono">127.0.0.1</code> /{' '}
+                <code className="font-mono">[::1]</code> /{' '}
+                <code className="font-mono">localhost</code>)
+              </span>
+            </div>
+
+            {cliState.permissionState === 'prompt' && (
+              <p className="text-xs text-gray-600 bg-white p-2.5 rounded border border-gray-200">
+                Connecting lets The DevTools Times communicate with the local companion
+                CLI daemon running on your machine (<code className="font-mono">127.0.0.1</code>)
+                for trace capture and symbol resolution. Your browser will ask for{' '}
+                <strong>Loopback network</strong> permission when you click Connect.
+              </p>
+            )}
+
+            <div
+              data-remediation="loopback-network"
+              hidden={cliState.permissionState !== 'denied'}
+              className="p-2.5 rounded bg-red-50 border border-red-200 text-xs text-red-800 space-y-1"
+            >
+              <p className="font-semibold">
+                Loopback network access is blocked in browser settings.
+              </p>
+              <p>
+                To re-enable: click the site information / tune icon in your browser&apos;s
+                address bar → open <strong>Site settings</strong> → change{' '}
+                <strong>Loopback network</strong> from <em>Block</em> to <em>Allow</em>,
+                then retry below.
+              </p>
+            </div>
+
+            <div className="space-y-2">
+              <div>
+                <label
+                  htmlFor={cliInputId}
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  Companion CLI HTTP Health Endpoint
+                </label>
+                <input
+                  id={cliInputId}
+                  type="url"
+                  value={cliState.url}
+                  onChange={(e) =>
+                    setCliState((prev) => ({ ...prev, url: e.target.value }))
+                  }
+                  placeholder="http://127.0.0.1:45678/health"
+                  className="w-full px-2.5 py-1.5 text-xs font-mono bg-white border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-amber-400"
+                />
+              </div>
+
+              <div>
+                <label
+                  htmlFor={cliWsInputId}
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  Companion CLI Event Stream (<code className="font-mono">ws://127.0.0.1</code>)
+                </label>
+                <input
+                  id={cliWsInputId}
+                  type="url"
+                  value={cliState.wsUrl}
+                  onChange={(e) =>
+                    setCliState((prev) => ({ ...prev, wsUrl: e.target.value }))
+                  }
+                  placeholder="ws://127.0.0.1:45678/events"
+                  className="w-full px-2.5 py-1.5 text-xs font-mono bg-white border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-amber-400"
+                />
+              </div>
+            </div>
+
+            {cliState.errorMessage && (
+              <div
+                role="status"
+                className="p-2.5 rounded bg-amber-50 border border-amber-200 text-xs text-amber-900"
+              >
+                {cliState.errorMessage}
+              </div>
+            )}
+
+            {cliState.payload && (
+              <div className="p-2.5 rounded bg-gray-900 text-emerald-300 text-xs font-mono overflow-x-auto max-h-32">
+                <pre>{JSON.stringify(cliState.payload, null, 2)}</pre>
+              </div>
+            )}
+
+            {cliState.telemetryMessages.length > 0 && (
+              <div className="p-2 rounded bg-gray-900 text-gray-200 text-[11px] font-mono space-y-0.5 max-h-24 overflow-y-auto">
+                {cliState.telemetryMessages.map((msg, idx) => (
+                  <div key={idx}>{msg}</div>
+                ))}
+              </div>
+            )}
+          </div>
+
+          <div className="pt-2 border-t border-gray-200 flex flex-wrap items-center gap-2">
+            <button
+              type="button"
+              onClick={() => handleConnectCli(cliState.url)}
+              disabled={cliState.status === 'connecting'}
+              className="px-3 py-1.5 bg-gray-900 hover:bg-gray-800 disabled:opacity-50 text-white text-xs font-semibold rounded transition cursor-pointer"
+            >
+              {cliState.status === 'connecting'
+                ? 'Connecting to CLI…'
+                : 'Connect Companion CLI'}
+            </button>
+            <button
+              type="button"
+              onClick={handleToggleCliStream}
+              className="px-3 py-1.5 bg-white hover:bg-gray-100 text-gray-800 border border-gray-300 text-xs font-semibold rounded transition cursor-pointer"
+            >
+              {cliState.wsStatus === 'connected'
+                ? 'Stop WS Stream'
+                : 'Stream CLI Events'}
+            </button>
+            {cliState.lastCheckedAt && (
+              <span className="text-[11px] text-gray-500 ml-auto">
+                Checked {cliState.lastCheckedAt}
+              </span>
+            )}
+          </div>
+        </section>
+      </div>
+
+      {/* Local testing tips footer */}
+      <div className="rounded-md bg-gray-100 border border-gray-200 p-3 text-xs text-gray-600 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
+        <div>
+          <span className="font-semibold text-gray-800">Local Dev Tip:</span> Serving from{' '}
+          <code className="font-mono">localhost</code> is already in the{' '}
+          <code className="font-mono">loopback</code> address space. To test LNA prompts
+          locally, launch Chromium with{' '}
+          <code className="font-mono bg-white px-1 py-0.5 rounded border border-gray-300">
+            --ip-address-space-overrides=127.0.0.1:8080=public,[::1]:8080=public
+          </code>{' '}
+          or toggle <strong>Local network</strong> &amp; <strong>Loopback network</strong>{' '}
+          in browser Site settings.
+        </div>
+      </div>
+    </div>
+  );
+
+  if (variant === 'inline') {
+    return (
+      <section
+        aria-label="Developer Diagnostics Connection Bridge"
+        className="my-6 border border-gray-300 rounded-lg bg-white shadow-sm overflow-hidden"
+      >
+        <div className="bg-gray-900 text-white px-4 py-3 flex flex-wrap items-center justify-between gap-2">
+          <div className="flex items-center gap-2">
+            <span className="w-2.5 h-2.5 rounded-full bg-amber-400" />
+            <h3 className="text-sm font-bold tracking-wide uppercase">
+              Developer Diagnostics Bridge (Local Network &amp; Loopback)
+            </h3>
+          </div>
+          <span className="text-xs text-gray-300 font-mono">
+            LNA Active Endpoints: {overallConnectedCount}/2
+          </span>
+        </div>
+        <div className="p-4 md:p-5">{diagnosticsContent}</div>
+      </section>
+    );
+  }
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={openModal}
+        className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-gray-300 bg-gray-50 hover:bg-amber-50 hover:border-amber-400 text-xs font-semibold text-gray-800 transition cursor-pointer"
+        title="Connect to a hardware test device on Wi-Fi LAN or local companion CLI (127.0.0.1)"
+      >
+        <span
+          className={`w-2 h-2 rounded-full ${
+            overallConnectedCount > 0 ? 'bg-emerald-500' : 'bg-amber-500'
+          }`}
+        />
+        <span>Device &amp; CLI Diagnostics</span>
+        {overallConnectedCount > 0 && (
+          <span className="px-1.5 py-0.2 bg-emerald-100 text-emerald-800 rounded text-[10px] font-mono">
+            {overallConnectedCount}/2
+          </span>
+        )}
+      </button>
+
+      <dialog
+        ref={dialogRef}
+        {...({ closedby: 'any' } as React.DialogHTMLAttributes<HTMLDialogElement>)}
+        aria-labelledby={dialogTitleId}
+        className="m-auto w-full max-w-4xl rounded-xl bg-white p-0 shadow-2xl border border-gray-200 text-gray-900"
+      >
+        <div className="bg-gray-900 text-white px-5 py-4 flex items-center justify-between border-b border-gray-800">
+          <div>
+            <h2 id={dialogTitleId} className="text-base font-bold">
+              Developer Diagnostics Connection Hub
+            </h2>
+            <p className="text-xs text-gray-300">
+              Connect your browser directly to a Wi-Fi LAN hardware test device (
+              <code className="font-mono">local-network</code>) and local companion CLI (
+              <code className="font-mono">loopback-network</code>)
+            </p>
+          </div>
+          <form method="dialog">
+            <button
+              type="submit"
+              onClick={closeModal}
+              aria-label="Close developer diagnostics dialog"
+              className="p-1.5 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition cursor-pointer"
+            >
+              <svg
+                xmlns="http://www.w3.org/2000/svg"
+                className="h-5 w-5"
+                fill="none"
+                viewBox="0 0 24 24"
+                stroke="currentColor"
+                strokeWidth={2}
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  d="M6 18L18 6M6 6l12 12"
+                />
+              </svg>
+            </button>
+          </form>
+        </div>
+
+        <div className="p-5 max-h-[80vh] overflow-y-auto">{diagnosticsContent}</div>
+      </dialog>
+    </>
+  );
+}
