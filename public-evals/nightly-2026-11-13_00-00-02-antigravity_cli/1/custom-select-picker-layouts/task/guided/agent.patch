+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const roastPicker = document.getElementById('roast-picker');
+      if (!roastPicker) return;
+
+      // Support Left/Right arrow navigation in the 3-column grid picker using actual geometry
+      roastPicker.addEventListener('keydown', (e) => {
+        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+        const options = Array.from(roastPicker.querySelectorAll('option'));
+        const activeOption = document.activeElement?.tagName === 'OPTION'
+          ? document.activeElement
+          : roastPicker.selectedOptions[0];
+        if (!activeOption || !options.includes(activeOption)) return;
+
+        const currentRect = activeOption.getBoundingClientRect();
+        if (currentRect.width === 0 && currentRect.height === 0) return;
+
+        const direction = e.key === 'ArrowRight' ? 1 : -1;
+        let nearest = null;
+        let minDistance = Infinity;
+
+        for (const opt of options) {
+          if (opt === activeOption) continue;
+          const rect = opt.getBoundingClientRect();
+          const dx = rect.left - currentRect.left;
+          if (direction > 0 && dx > 4 && dx < minDistance) {
+            minDistance = dx;
+            nearest = opt;
+          } else if (direction < 0 && dx < -4 && Math.abs(dx) < minDistance) {
+            minDistance = Math.abs(dx);
+            nearest = opt;
+          }
+        }
+
+        if (nearest) {
+          e.preventDefault();
+          nearest.focus();
+          roastPicker.value = nearest.value;
+        }
+      });
+    });
+  </script>
