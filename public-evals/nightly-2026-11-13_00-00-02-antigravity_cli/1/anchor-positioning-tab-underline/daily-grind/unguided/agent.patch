+  <script>
+    (function () {
+      const navList = document.getElementById('nav-list');
+      const navItems = Array.from(navList.querySelectorAll('.nav-item'));
+      const indicator = document.getElementById('nav-indicator');
+
+      function updateIndicator(activeItem, animate = true) {
+        if (!activeItem || !indicator) return;
+
+        const listRect = navList.getBoundingClientRect();
+        const itemRect = activeItem.getBoundingClientRect();
+        const offsetLeft = itemRect.left - listRect.left;
+
+        if (!animate) {
+          indicator.style.transition = 'none';
+        }
+
+        indicator.style.width = `${itemRect.width}px`;
+        indicator.style.transform = `translateX(${offsetLeft}px)`;
+
+        if (!animate) {
+          // Force reflow to apply initial position before restoring transitions
+          indicator.offsetHeight;
+          indicator.style.transition = '';
+        }
+      }
+
+      function setActiveItem(selectedItem, animate = true) {
+        navItems.forEach((item) => {
+          const isSelected = item === selectedItem;
+          item.classList.toggle('active', isSelected);
+          if (isSelected) {
+            item.setAttribute('aria-current', 'page');
+          } else {
+            item.removeAttribute('aria-current');
+          }
+        });
+        updateIndicator(selectedItem, animate);
+      }
+
+      navItems.forEach((item) => {
+        item.addEventListener('click', (event) => {
+          event.preventDefault();
+          setActiveItem(item, true);
+        });
+      });
+
+      const initialActive = navList.querySelector('.nav-item.active') || navItems[0];
+      updateIndicator(initialActive, false);
+
+      window.addEventListener('resize', () => {
+        const currentActive = navList.querySelector('.nav-item.active');
+        updateIndicator(currentActive, false);
+      });
+    })();
+  </script>
