+  <script>
+    (() => {
+      const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+      const supportsMoveBefore = Object.hasOwn(Element.prototype, 'moveBefore');
+
+      const gridEl = document.getElementById('favorites-grid');
+      const statusEl = document.getElementById('favorites-status');
+      const restoreBtn = document.getElementById('restore-cards-btn');
+      const sortButtons = document.querySelectorAll('[data-sort]');
+      const shuffleBtn = document.getElementById('shuffle-cards-btn');
+
+      const removedCardWrappers = [];
+      let customItemCounter = 100;
+
+      function announce(message) {
+        if (statusEl) {
+          statusEl.textContent = message;
+        }
+      }
+
+      function runScopedTransition(scopeEl, updateDOM) {
+        if (!supportsScopedTransition) {
+          updateDOM();
+          return;
+        }
+        const transition = scopeEl.startViewTransition(() => {
+          updateDOM();
+        });
+        transition.ready.catch(() => {});
+      }
+
+      function reorderNodes(container, orderedNodes) {
+        const move = supportsMoveBefore
+          ? (node) => container.moveBefore(node, null)
+          : (node) => container.append(node);
+
+        for (const node of orderedNodes) {
+          move(node);
+        }
+      }
+
+      function updateSortPressed(activeKey) {
+        for (const btn of sortButtons) {
+          btn.setAttribute('aria-pressed', String(btn.dataset.sort === activeKey));
+        }
+      }
+
+      // Sort buttons for the Seasonal Favorites grid
+      for (const btn of sortButtons) {
+        btn.addEventListener('click', () => {
+          const sortKey = btn.dataset.sort;
+          const wrappers = Array.from(gridEl.children);
+          wrappers.sort((a, b) => {
+            if (sortKey === 'name') {
+              return a.dataset.name.localeCompare(b.dataset.name);
+            }
+            if (sortKey === 'price') {
+              return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
+            }
+            return parseInt(a.dataset.featured, 10) - parseInt(b.dataset.featured, 10);
+          });
+
+          runScopedTransition(gridEl, () => {
+            reorderNodes(gridEl, wrappers);
+          });
+          updateSortPressed(sortKey);
+          announce(`Sorted seasonal drinks by ${btn.textContent.trim()}, ${wrappers.length} drinks shown`);
+        });
+      }
+
+      // Shuffle drink cards
+      shuffleBtn?.addEventListener('click', () => {
+        const wrappers = Array.from(gridEl.children);
+        if (wrappers.length < 2) return;
+
+        const originalOrder = wrappers.slice();
+        for (let i = wrappers.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [wrappers[i], wrappers[j]] = [wrappers[j], wrappers[i]];
+        }
+        if (wrappers.every((node, idx) => node === originalOrder[idx])) {
+          wrappers.push(wrappers.shift());
+        }
+
+        runScopedTransition(gridEl, () => {
+          reorderNodes(gridEl, wrappers);
+        });
+        updateSortPressed('');
+        announce(`Shuffled seasonal drinks, ${wrappers.length} drinks shown`);
+      });
+
+      // Restore removed drink cards
+      restoreBtn?.addEventListener('click', () => {
+        if (removedCardWrappers.length === 0) return;
+
+        runScopedTransition(gridEl, () => {
+          while (removedCardWrappers.length > 0) {
+            const wrapper = removedCardWrappers.shift();
+            gridEl.append(wrapper);
+          }
+          const wrappers = Array.from(gridEl.children).sort(
+            (a, b) => parseInt(a.dataset.featured, 10) - parseInt(b.dataset.featured, 10)
+          );
+          reorderNodes(gridEl, wrappers);
+          restoreBtn.hidden = true;
+        });
+        updateSortPressed('featured');
+        announce(`Restored all seasonal drinks, ${gridEl.children.length} drinks shown`);
+      });
+
+      function createCustomizationElement(label) {
+        customItemCounter += 1;
+        const li = document.createElement('li');
+        li.className = 'customization-item';
+        li.dataset.itemId = `custom-${customItemCounter}`;
+
+        const span = document.createElement('span');
+        span.textContent = label;
+
+        const controls = document.createElement('div');
+        controls.className = 'customization-item-controls';
+
+        const upBtn = document.createElement('button');
+        upBtn.type = 'button';
+        upBtn.className = 'icon-btn';
+        upBtn.dataset.itemAction = 'up';
+        upBtn.setAttribute('aria-label', `Move ${label} up`);
+        upBtn.textContent = '↑';
+
+        const downBtn = document.createElement('button');
+        downBtn.type = 'button';
+        downBtn.className = 'icon-btn';
+        downBtn.dataset.itemAction = 'down';
+        downBtn.setAttribute('aria-label', `Move ${label} down`);
+        downBtn.textContent = '↓';
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'icon-btn danger';
+        removeBtn.dataset.itemAction = 'remove';
+        removeBtn.setAttribute('aria-label', `Remove ${label}`);
+        removeBtn.textContent = '✕';
+
+        controls.append(upBtn, downBtn, removeBtn);
+        li.append(span, controls);
+        return li;
+      }
+
+      // Event delegation for card-level and item-level actions
+      gridEl.addEventListener('click', (event) => {
+        const button = event.target.closest('button');
+        if (!button) return;
+
+        const wrapperEl = button.closest('.card-wrapper');
+        const cardEl = button.closest('.card');
+        if (!wrapperEl || !cardEl) return;
+
+        const drinkName = wrapperEl.dataset.name;
+
+        // 1. Card-level actions
+        const cardAction = button.dataset.cardAction;
+        if (cardAction === 'move-prev' || cardAction === 'move-next') {
+          const wrappers = Array.from(gridEl.children);
+          const idx = wrappers.indexOf(wrapperEl);
+          const targetIdx = cardAction === 'move-prev' ? idx - 1 : idx + 1;
+          if (targetIdx < 0 || targetIdx >= wrappers.length) return;
+
+          [wrappers[idx], wrappers[targetIdx]] = [wrappers[targetIdx], wrappers[idx]];
+          runScopedTransition(gridEl, () => {
+            reorderNodes(gridEl, wrappers);
+            button.focus();
+          });
+          updateSortPressed('');
+          announce(`Moved ${drinkName} to position ${targetIdx + 1} of ${wrappers.length}`);
+          return;
+        }
+
+        if (cardAction === 'remove-card') {
+          const hadFocus = wrapperEl.contains(document.activeElement);
+          const nextFocusTarget =
+            wrapperEl.nextElementSibling?.querySelector('[data-card-action="remove-card"]') ??
+            wrapperEl.previousElementSibling?.querySelector('[data-card-action="remove-card"]') ??
+            restoreBtn;
+
+          runScopedTransition(gridEl, () => {
+            removedCardWrappers.push(wrapperEl);
+            wrapperEl.remove();
+            restoreBtn.hidden = false;
+            if (hadFocus) {
+              nextFocusTarget?.focus();
+            }
+          });
+          announce(`Removed ${drinkName}. ${gridEl.children.length} drinks remaining`);
+          return;
+        }
+
+        if (cardAction === 'reverse-items') {
+          const listEl = cardEl.querySelector('.customizations-list');
+          if (!listEl || listEl.children.length < 2) return;
+          const items = Array.from(listEl.children).reverse();
+          // Scope to listEl since only the list item order changes
+          runScopedTransition(listEl, () => {
+            reorderNodes(listEl, items);
+          });
+          announce(`Reversed customizations for ${drinkName}`);
+          return;
+        }
+
+        // 2. Add a customization item (scoped to cardEl so card height animates smoothly)
+        const addItemLabel = button.dataset.addItem;
+        if (addItemLabel) {
+          const listEl = cardEl.querySelector('.customizations-list');
+          if (!listEl) return;
+          const newItem = createCustomizationElement(addItemLabel);
+          runScopedTransition(cardEl, () => {
+            listEl.append(newItem);
+          });
+          announce(`Added ${addItemLabel} to ${drinkName}`);
+          return;
+        }
+
+        // 3. Individual customization item actions (move up/down, remove)
+        const itemAction = button.dataset.itemAction;
+        if (itemAction) {
+          const itemEl = button.closest('.customization-item');
+          const listEl = cardEl.querySelector('.customizations-list');
+          if (!itemEl || !listEl) return;
+          const itemName = itemEl.querySelector('span')?.textContent?.trim() || 'item';
+
+          if (itemAction === 'up' || itemAction === 'down') {
+            const items = Array.from(listEl.children);
+            const idx = items.indexOf(itemEl);
+            const targetIdx = itemAction === 'up' ? idx - 1 : idx + 1;
+            if (targetIdx < 0 || targetIdx >= items.length) return;
+
+            [items[idx], items[targetIdx]] = [items[targetIdx], items[idx]];
+            // Scope to listEl since only list order changes
+            runScopedTransition(listEl, () => {
+              reorderNodes(listEl, items);
+              button.focus();
+            });
+            announce(`Moved ${itemName} to position ${targetIdx + 1} in ${drinkName}`);
+            return;
+          }
+
+          if (itemAction === 'remove') {
+            const hadFocus = itemEl.contains(document.activeElement);
+            const nextFocusTarget =
+              itemEl.nextElementSibling?.querySelector('[data-item-action="remove"]') ??
+              itemEl.previousElementSibling?.querySelector('[data-item-action="remove"]') ??
+              cardEl.querySelector('[data-add-item]') ??
+              cardEl.querySelector('button');
+
+            // Scope to outer cardEl so the card smoothly transitions its height change
+            runScopedTransition(cardEl, () => {
+              itemEl.remove();
+              if (hadFocus) {
+                nextFocusTarget?.focus();
+              }
+            });
+            announce(`Removed ${itemName} from ${drinkName}`);
+          }
+        }
+      });
+    })();
+  </script>
