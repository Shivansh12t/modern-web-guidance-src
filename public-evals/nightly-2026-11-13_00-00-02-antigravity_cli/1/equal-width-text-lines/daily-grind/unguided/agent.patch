+  <script>
+    (function () {
+      const lockup = document.getElementById('hero-lockup');
+      if (!lockup) return;
+      const lines = Array.from(lockup.querySelectorAll('.hero-line'));
+
+      function fitHeroLines() {
+        const targetWidth = lockup.clientWidth;
+        if (!targetWidth) return;
+
+        lines.forEach((line) => {
+          const baseSize = 100;
+          line.style.fontSize = baseSize + 'px';
+          const initialWidth = line.getBoundingClientRect().width;
+          if (!initialWidth) return;
+
+          let fittedSize = (baseSize * targetWidth) / initialWidth;
+          line.style.fontSize = fittedSize + 'px';
+
+          const refinedWidth = line.getBoundingClientRect().width;
+          if (refinedWidth > 0) {
+            fittedSize = (fittedSize * targetWidth) / refinedWidth;
+            line.style.fontSize = fittedSize.toFixed(3) + 'px';
+          }
+        });
+      }
+
+      fitHeroLines();
+      window.addEventListener('resize', fitHeroLines);
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(fitHeroLines).observe(lockup);
+      }
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitHeroLines);
+      }
+    })();
+  </script>
