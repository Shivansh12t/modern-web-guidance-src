+  <!-- In-Page Sign-In Modal -->
+  <div class="auth-modal-backdrop" id="auth-modal" aria-hidden="true" role="dialog" aria-labelledby="auth-modal-title">
+    <div class="auth-modal">
+      <button type="button" class="auth-close" id="auth-close-btn" aria-label="Close sign in">&times;</button>
+      <h2 id="auth-modal-title">Welcome Back</h2>
+      <p class="subtitle" id="auth-modal-subtitle">Sign in using your saved passkey or password without leaving this page.</p>
+
+      <form id="inline-signin-form" action="/login" method="POST">
+        <div class="form-group">
+          <label for="signin-username">Email or Username</label>
+          <input
+            type="text"
+            id="signin-username"
+            name="username"
+            autocomplete="username webauthn"
+            placeholder="you@example.com"
+            required
+          >
+        </div>
+        <div class="form-group">
+          <label for="signin-password">Password</label>
+          <input
+            type="password"
+            id="signin-password"
+            name="password"
+            autocomplete="current-password"
+            placeholder="••••••••"
+          >
+        </div>
+        <button type="submit" class="btn btn-block">Sign In</button>
+      </form>
+
+      <div class="auth-divider">or</div>
+      <button type="button" class="btn btn-block btn-passkey" id="passkey-signin-btn">
+        Sign in with a Passkey
+      </button>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      let currentUser = null;
+      let pendingDestination = null;
+      let conditionalAbortController = null;
+
+      const modal = document.getElementById('auth-modal');
+      const closeBtn = document.getElementById('auth-close-btn');
+      const signinForm = document.getElementById('inline-signin-form');
+      const usernameInput = document.getElementById('signin-username');
+      const passwordInput = document.getElementById('signin-password');
+      const passkeyBtn = document.getElementById('passkey-signin-btn');
+      const quickSigninBtn = document.getElementById('quick-signin-btn');
+      const navAuthAction = document.getElementById('nav-auth-action');
+      const statusText = document.getElementById('auth-status-text');
+      const subtitle = document.getElementById('auth-modal-subtitle');
+
+      function updateSignedInUI(userLabel) {
+        currentUser = userLabel || 'Returning Customer';
+        statusText.textContent = 'Signed in as ' + currentUser + ' — enjoy your rewards & quick ordering!';
+        quickSigninBtn.style.display = 'none';
+        navAuthAction.textContent = 'Logout';
+        navAuthAction.setAttribute('href', '/logout');
+        closeModal();
+
+        if (pendingDestination) {
+          const dest = pendingDestination;
+          pendingDestination = null;
+          statusText.textContent = 'Signed in as ' + currentUser + ' (' + dest + ' unlocked on page).';
+        }
+      }
+
+      function signOut() {
+        currentUser = null;
+        if (navigator.credentials && navigator.credentials.preventSilentAccess) {
+          navigator.credentials.preventSilentAccess().catch(function () {});
+        }
+        statusText.textContent = 'Returning customer? Sign in instantly with your saved passkey or password.';
+        quickSigninBtn.style.display = 'inline-block';
+        navAuthAction.textContent = 'Sign In';
+      }
+
+      function openModal(contextLabel) {
+        if (contextLabel) {
+          subtitle.textContent = 'Sign in to access ' + contextLabel + ' right from this page.';
+        } else {
+          subtitle.textContent = 'Sign in using your saved passkey or password without leaving this page.';
+        }
+        modal.classList.add('active');
+        modal.setAttribute('aria-hidden', 'false');
+        usernameInput.focus();
+        requestCredentialSignIn({ mediation: 'optional', modalFlow: true });
+      }
+
+      function closeModal() {
+        modal.classList.remove('active');
+        modal.setAttribute('aria-hidden', 'true');
+      }
+
+      function getPublicKeyLoadOptions() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        }
+        return {
+          challenge: challenge,
+          timeout: 60000,
+          userVerification: 'preferred'
+        };
+      }
+
+      async function requestCredentialSignIn(options) {
+        if (!navigator.credentials || !navigator.credentials.get) {
+          return null;
+        }
+
+        const mediation = (options && options.mediation) || 'optional';
+
+        try {
+          if (conditionalAbortController && mediation !== 'conditional') {
+            conditionalAbortController.abort();
+            conditionalAbortController = null;
+          }
+
+          const credOptions = {
+            mediation: mediation,
+            password: true,
+            publicKey: getPublicKeyLoadOptions()
+          };
+
+          if (mediation === 'conditional') {
+            conditionalAbortController = new AbortController();
+            credOptions.signal = conditionalAbortController.signal;
+          }
+
+          const cred = await navigator.credentials.get(credOptions);
+          if (cred) {
+            const label = cred.name || cred.id || 'Passkey Member';
+            updateSignedInUI(label);
+            return cred;
+          }
+        } catch (err) {
+          // Fallback to requesting password or publicKey individually if combined call isn't supported
+          try {
+            if (options && options.passkeyOnly) {
+              const pkCred = await navigator.credentials.get({
+                publicKey: getPublicKeyLoadOptions()
+              });
+              if (pkCred) {
+                updateSignedInUI(pkCred.id || 'Passkey Member');
+                return pkCred;
+              }
+            } else {
+              const pwCred = await navigator.credentials.get({
+                password: true,
+                mediation: mediation
+              });
+              if (pwCred) {
+                updateSignedInUI(pwCred.name || pwCred.id);
+                return pwCred;
+              }
+            }
+          } catch (_) {
+            // User dismissed or browser requires manual form entry
+          }
+        }
+        return null;
+      }
+
+      // Attempt non-intrusive ambient / conditional credentials check on browse
+      window.addEventListener('DOMContentLoaded', async function () {
+        // 1. Try silent credential mediation for returning users browsing the page
+        const signedInCred = await requestCredentialSignIn({ mediation: 'optional' });
+
+        // 2. Set up WebAuthn conditional UI autofill if available
+        if (!signedInCred && window.PublicKeyCredential && PublicKeyCredential.isConditionalMediationAvailable) {
+          try {
+            const available = await PublicKeyCredential.isConditionalMediationAvailable();
+            if (available) {
+              requestCredentialSignIn({ mediation: 'conditional' });
+            }
+          } catch (_) {}
+        }
+      });
+
+      // Intercept clicks on Rewards, My Account, Order Now so returning users sign in inline without redirecting
+      document.querySelectorAll('[data-auth-trigger]').forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          if (!currentUser) {
+            e.preventDefault();
+            const label = link.textContent.trim();
+            pendingDestination = label;
+            openModal(label);
+          }
+        });
+      });
+
+      quickSigninBtn.addEventListener('click', function () {
+        openModal();
+      });
+
+      navAuthAction.addEventListener('click', function (e) {
+        e.preventDefault();
+        if (currentUser) {
+          signOut();
+        } else {
+          openModal();
+        }
+      });
+
+      closeBtn.addEventListener('click', closeModal);
+      modal.addEventListener('click', function (e) {
+        if (e.target === modal) closeModal();
+      });
+
+      passkeyBtn.addEventListener('click', function () {
+        requestCredentialSignIn({ mediation: 'required', passkeyOnly: true });
+      });
+
+      signinForm.addEventListener('submit', async function (e) {
+        e.preventDefault();
+        const username = usernameInput.value.trim();
+        const password = passwordInput.value;
+        if (!username) return;
+
+        if (window.PasswordCredential && password) {
+          try {
+            const cred = new PasswordCredential({
+              id: username,
+              password: password,
+              name: username
+            });
+            await navigator.credentials.store(cred);
+          } catch (_) {}
+        }
+
+        updateSignedInUI(username);
+      });
+    })();
+  </script>
+
 </body>
 
