+      if (!fallbackDialog.open) {
+        fallbackDialog.showModal();
+      }
+      usernameInput.focus();
+      announceStatus(
+        errorMessage || 'No saved device credentials selected. Sign in dialog opened.'
+      );
+    }
+
+    // Attach Immediate UI quick sign-in handler to browsing actions and navigation links
+    for (const triggerEl of document.querySelectorAll('[data-quick-signin]')) {
+      triggerEl.addEventListener('click', async (event) => {
+        const returnAction = triggerEl.dataset.quickSignin;
+
+        // If already signed in, complete micro-actions or in-page hub updates immediately
+        if (document.body.dataset.signedIn === 'true') {
+          if (returnAction === 'favorite') {
+            event.preventDefault();
+            const nextPressed = triggerEl.getAttribute('aria-pressed') !== 'true';
+            triggerEl.setAttribute('aria-pressed', String(nextPressed));
+            triggerEl.textContent = nextPressed ? 'Saved' : 'Save';
+            const itemName = triggerEl.dataset.itemName || 'item';
+            announceStatus(
+              nextPressed ? `Saved ${itemName} to favorites.` : `Removed ${itemName} from favorites.`
+            );
+          }
+          return;
+        }
+
+        event.preventDefault();
+        if (isAuthenticating) return;
+
+        const context = { returnAction, returnFocusEl: triggerEl };
+        isAuthenticating = true;
+        try {
+          const user = await authenticateWithImmediateUi();
+          completeAuthenticatedAction(user, context);
+        } catch (err) {
+          if (err.name === 'NotAllowedError') {
+            showFallbackSignInUi(context);
+            return;
+          }
+          if (err.code === 'UNKNOWN_CREDENTIAL') {
+            showFallbackSignInUi(
+              context,
+              'That passkey is no longer recognized. Please sign in with your password or another passkey.'
+            );
+            return;
+          }
+          console.error('Authentication error:', err);
+          showFallbackSignInUi(
+            context,
+            'Unable to complete quick sign-in. Please sign in using the form below.'
+          );
+        } finally {
+          isAuthenticating = false;
+        }
+      });
+    }
+
+    // Show/hide password toggle inside the fallback sign-in form
+    togglePasswordBtn.addEventListener('click', () => {
+      const showing = passwordInput.type === 'text';
+      passwordInput.type = showing ? 'password' : 'text';
+      togglePasswordBtn.setAttribute('aria-pressed', String(!showing));
+      togglePasswordBtn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
+      togglePasswordBtn.textContent = showing ? 'Show' : 'Hide';
+    });
+
+    // Fallback password form submission
+    fallbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (isAuthenticating) return;
+
+      fallbackErrorEl.hidden = true;
+      isAuthenticating = true;
+      try {
+        const verifyResponse = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: usernameInput.value.trim(),
+            password: passwordInput.value,
+          }),
+        });
+
+        if (!verifyResponse.ok) {
+          throw new Error('Invalid email/username or password.');
+        }
+
+        const user = await verifyResponse.json();
+        const context = pendingAuthContext;
+        pendingAuthContext = null;
+        fallbackDialog.close();
+        fallbackForm.reset();
+        completeAuthenticatedAction(user, context);
+      } catch (err) {
+        fallbackErrorEl.textContent = err.message || 'Password sign-in failed. Please try again.';
+        fallbackErrorEl.hidden = false;
+        announceStatus(fallbackErrorEl.textContent);
+      } finally {
+        isAuthenticating = false;
+      }
+    });
+
+    // Standard modal passkey sign-in inside the fallback dialog (does NOT use uiMode: 'immediate'
+    // so cross-device QR codes and external hardware security keys remain available)
+    modalPasskeyBtn.addEventListener('click', async () => {
+      if (isAuthenticating) return;
+      if (autofillAbortController) {
+        autofillAbortController.abort();
+      }
+      autofillAbortController = new AbortController();
+      fallbackErrorEl.hidden = true;
+      isAuthenticating = true;
+
+      try {
+        const optionsResponse = await fetch('/api/login/options', { method: 'POST' });
+        if (!optionsResponse.ok) {
+          throw new Error('Failed to fetch passkey options');
+        }
+        const optionsJSON = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        const cred = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+
+        if (!cred) {
+          throw new DOMException('No credential returned', 'NotAllowedError');
+        }
+
+        const encoded = cred.toJSON();
+        const verifyResponse = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+
+        if (verifyResponse.status === 404) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          }
+          throw new Error('This passkey is no longer registered. Please sign in with your password.');
+        }
+
+        if (!verifyResponse.ok) {
+          throw new Error('Passkey verification failed.');
+        }
+
+        const user = await verifyResponse.json();
+        const context = pendingAuthContext;
+        pendingAuthContext = null;
+        fallbackDialog.close();
+        completeAuthenticatedAction(user, context);
+      } catch (err) {
+        if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+          return;
+        }
+        fallbackErrorEl.textContent = err.message || 'Passkey sign-in failed.';
+        fallbackErrorEl.hidden = false;
+        announceStatus(fallbackErrorEl.textContent);
+      } finally {
+        isAuthenticating = false;
+      }
+    });
+
+    // In-place Logout handler
+    logoutLinkEl.addEventListener('click', (event) => {
+      event.preventDefault();
+      document.body.dataset.signedIn = 'false';
+      userBadgeEl.textContent = '';
+      userBadgeItemEl.hidden = true;
+      signinNavItemEl.hidden = false;
+      customerHubEl.hidden = true;
+      for (const favBtn of document.querySelectorAll('.btn-favorite[aria-pressed="true"]')) {
+        favBtn.setAttribute('aria-pressed', 'false');
+        favBtn.textContent = 'Save';
+      }
+      const signinLink = document.getElementById('signin-link');
+      if (signinLink) {
+        signinLink.focus();
+      }
+      announceStatus('You have been signed out.');
+    });
+  </script>
+
 </body>
 
 </html>
