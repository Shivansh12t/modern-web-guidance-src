+<style>
+    .article-card {
+        container: card / inline-size;
+    }
+
+    /* Default stacked layout for standard cards */
+    .article-card:not(.article-card--large) .article-card__inner {
+        display: flex;
+        flex-direction: column;
+    }
+
+    /* Media query fallback for older browsers without container query support */
+    @media (min-width: 768px) {
+        .article-card--large .article-card__inner {
+            grid-template-columns: repeat(3, minmax(0, 1fr));
+        }
+        .article-card--large .article-card__content {
+            grid-column: span 1 / span 1;
+        }
+        .article-card--large .article-card__media {
+            grid-column: span 2 / span 2;
+        }
+    }
+
+    /* Overwrite with container queries where supported */
+    @supports (container-type: inline-size) {
+        @media (min-width: 768px) {
+            .article-card--large .article-card__inner {
+                grid-template-columns: 1fr;
+            }
+            .article-card--large .article-card__content,
+            .article-card--large .article-card__media {
+                grid-column: auto;
+            }
+        }
+
+        /* Standard card adapts to horizontal layout when its own container is wide */
+        @container card (min-width: 480px) {
+            .article-card:not(.article-card--large):has(.article-card__media) .article-card__inner {
+                flex-direction: row;
+                align-items: stretch;
+                gap: 1.5rem;
+            }
+
+            .article-card:not(.article-card--large) .article-card__media {
+                width: 40%;
+            }
+
+            .article-card:not(.article-card--large) .article-card__content {
+                margin-top: 0;
+            }
+        }
+
+        /* Conditionally hide summary in very narrow card containers */
+        @container card (max-width: 240px) {
+            .article-card__summary {
+                display: none;
+            }
+        }
+
+        /* Fluid typography scaled to container inline-size (max <= 2.5x min for WCAG 1.4.4) */
+        .article-card:not(.article-card--large) .article-card__title {
+            font-size: clamp(1.125rem, 4cqi, 1.75rem);
+        }
+
+        .article-card--large .article-card__title {
+            font-size: clamp(1.75rem, 4.5cqi, 2.75rem);
+        }
+
+        /* Large card switches to 3-column side-by-side layout based on its own width */
+        @container card (min-width: 768px) {
+            .article-card--large .article-card__inner {
+                grid-template-columns: repeat(3, minmax(0, 1fr));
+            }
+            .article-card--large .article-card__content {
+                grid-column: span 1 / span 1;
+            }
+            .article-card--large .article-card__media {
+                grid-column: span 2 / span 2;
+            }
+        }
+    }
+</style>
