+        if (progressBar) {
+          progressBar.value = targetStep;
+          progressBar.textContent = `Step ${targetStep} of ${steps.length}`;
+        }
+
+        const activeStepEl = form.querySelector(`.form-step[data-step="${targetStep}"]`);
+        const stepHeading = activeStepEl?.querySelector('.step-heading');
+        if (stepHeading) {
+          stepHeading.focus();
+        }
+      };
+
+      form.querySelectorAll('[data-next-step]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const nextStep = Number(btn.dataset.nextStep);
+          if (validateStep(currentStep)) {
+            goToStep(nextStep);
+          }
+        });
+      });
+
+      form.querySelectorAll('[data-prev-step]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const prevStep = Number(btn.dataset.prevStep);
+          goToStep(prevStep);
+        });
+      });
+
+      // IME-safe Enter key handling for single-line inputs on intermediate steps
+      form.addEventListener('keydown', (e) => {
+        if (e.key !== 'Enter' || e.isComposing || e.keyCode === 229) return;
+        const target = e.target;
+        if (!target.matches?.('input:not([type="checkbox"], [type="radio"])')) return;
+
+        if (currentStep < steps.length) {
+          e.preventDefault();
+          if (validateStep(currentStep)) {
+            goToStep(currentStep + 1);
+          }
+        }
+      });
+
+      // 7. Form Submission with Honeypot Check, Full Validation, Double-Post Prevention & Safe DOM Updates
+      const submitBtn = document.getElementById('rewards-submit-btn');
+      const statusBox = document.getElementById('rewards-submission-status');
+      const statusHeading = document.getElementById('submission-status-heading');
+      const statusMsg = document.getElementById('submission-status-message');
+      const honeypot = document.getElementById('member-referral-url');
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+
+        // Silently reject automated bot submissions that filled the hidden honeypot
+        if (honeypot && honeypot.value.trim() !== '') {
+          return;
+        }
+
+        // Validate all steps sequentially and route focus to the first invalid control if any fail
+        for (let stepNum = 1; stepNum <= steps.length; stepNum++) {
+          const stepEl = form.querySelector(`.form-step[data-step="${stepNum}"]`);
+          const controls = Array.from(stepEl.querySelectorAll('input, select, textarea'));
+          const hasInvalid = controls.some((ctrl) => !ctrl.checkValidity());
+          if (hasInvalid) {
+            if (currentStep !== stepNum) {
+              goToStep(stepNum);
+            }
+            validateStep(stepNum);
+            return;
+          }
+        }
+
+        // Disable submit button AFTER valid submission to prevent double-posts
+        if (submitBtn) {
+          submitBtn.disabled = true;
+          submitBtn.setAttribute('aria-busy', 'true');
+          submitBtn.textContent = 'Creating Rewards Account...';
+        }
+
+        const formData = new FormData(form);
+        const memberName = String(formData.get('full_name') || '').trim();
+        const memberEmail = String(formData.get('email') || '').trim();
+
+        // Use textContent (never innerHTML) to prevent DOM XSS when rendering user input
+        if (statusBox && statusMsg) {
+          statusMsg.textContent = `Thank you, ${memberName}! Your Daily Grind Rewards account (${memberEmail}) is active with 50 welcome bonus beans.`;
+          statusBox.hidden = false;
+          if (statusHeading) {
+            statusHeading.focus();
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
