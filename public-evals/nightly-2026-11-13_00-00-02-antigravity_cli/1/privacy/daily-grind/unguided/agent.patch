+            // Immediately clear sensitive email input from DOM
+            if (emailInput) emailInput.value = '';
+
+            if (feedback) {
+              feedback.className = 'alert-banner alert-success active';
+              feedback.textContent =
+                'Order ' + orderCode + ' queued for "' + sanitizedAlias + '" at ' +
+                minimizedOrderPayload.roastery + '. Plaintext email was discarded; only minimized state is stored.';
+            }
+            appendLog(sanitizerLogs, 'Created minimized order ' + orderCode + ' (PII stripped, 2h auto-expiry set).');
+            renderInspectorViews();
+          });
+        }
+
+        // Ephemeral mode switch
+        const ephemeralToggle = document.getElementById('ephemeral-mode-toggle');
+        if (ephemeralToggle) {
+          ephemeralToggle.addEventListener('change', function () {
+            appendLog(
+              sanitizerLogs,
+              'Switched storage tier to ' + (ephemeralToggle.checked ? 'Ephemeral sessionStorage' : '24h TTL localStorage')
+            );
+            renderInspectorViews();
+          });
+        }
+
+        // Test PII Redaction Button
+        const testPiiBtn = document.getElementById('test-pii-scrub-btn');
+        if (testPiiBtn) {
+          testPiiBtn.addEventListener('click', function () {
+            const samplePayload = {
+              note: 'Call me at 415-555-0199 or email coffee.lover@example.com with card 4532 0151 1283 0366'
+            };
+            SecureStorage.setItem('pii_redaction_demo', samplePayload, 10 * 60 * 1000);
+          });
+        }
+
+        // Export Data Button (Right of Data Portability)
+        const exportBtn = document.getElementById('export-data-btn');
+        if (exportBtn) {
+          exportBtn.addEventListener('click', function () {
+            const data = SecureStorage.exportAll();
+            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
+            const url = URL.createObjectURL(blob);
+            const a = document.createElement('a');
+            a.href = url;
+            a.download = 'daily-grind-privacy-export.json';
