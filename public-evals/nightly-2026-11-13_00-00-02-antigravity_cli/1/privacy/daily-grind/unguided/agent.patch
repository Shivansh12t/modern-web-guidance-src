+        getItem: function (key) {
+          const fullKey = PRIVACY_CONFIG.storagePrefix + key;
+          const now = Date.now();
+
+          let raw = null;
+          try {
+            raw = window.sessionStorage.getItem(fullKey) || window.localStorage.getItem(fullKey);
+          } catch (e) {
+            raw = null;
+          }
+
+          let envelope = raw ? JSON.parse(raw) : memoryVault.get(fullKey);
+          if (!envelope) return null;
+
+          if (envelope.expiresAtEpoch && now > envelope.expiresAtEpoch) {
+            this.removeItem(key);
+            appendLog(sanitizerLogs, 'Auto-purged expired storage key: ' + key);
+            return null;
+          }
+          return envelope.data;
+        },
+
+        removeItem: function (key) {
+          const fullKey = PRIVACY_CONFIG.storagePrefix + key;
+          memoryVault.delete(fullKey);
+          try {
+            window.sessionStorage.removeItem(fullKey);
+            window.localStorage.removeItem(fullKey);
+          } catch (e) { /* ignore */ }
+          renderInspectorViews();
+        },
+
+        purgeExpiredAndUnauthorized: function () {
+          const now = Date.now();
+          [window.localStorage, window.sessionStorage].forEach(function (store) {
+            if (!store) return;
+            try {
+              for (let i = store.length - 1; i >= 0; i--) {
+                const k = store.key(i);
+                if (!k) continue;
+                if (k.indexOf(PRIVACY_CONFIG.storagePrefix) === 0) {
+                  const parsed = JSON.parse(store.getItem(k));
+                  if (parsed && parsed.expiresAtEpoch && now > parsed.expiresAtEpoch) {
+                    store.removeItem(k);
+                    appendLog(sanitizerLogs, 'TTL expired key purged: ' + k);
+                  }
+                }
+              }
+            } catch (e) { /* ignore */ }
+          });
+        },
+
+        purgeAll: function (reason) {
+          memoryVault.clear();
+          [window.localStorage, window.sessionStorage].forEach(function (store) {
+            if (!store) return;
+            try {
+              for (let i = store.length - 1; i >= 0; i--) {
+                const k = store.key(i);
+                if (k && k.indexOf(PRIVACY_CONFIG.storagePrefix) === 0) {
+                  store.removeItem(k);
+                }
+              }
+            } catch (e) { /* ignore */ }
+          });
