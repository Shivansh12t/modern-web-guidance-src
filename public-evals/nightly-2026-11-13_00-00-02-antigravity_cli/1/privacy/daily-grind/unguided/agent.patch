+        }
+
+        // Erase All Data Button (Right to Erasure)
+        const eraseBtn = document.getElementById('erase-all-data-btn');
+        if (eraseBtn) {
+          eraseBtn.addEventListener('click', function () {
+            SecureStorage.purgeAll('Right to Erasure Triggered');
+            const feedback = document.getElementById('order-feedback');
+            if (feedback) {
+              feedback.className = 'alert-banner alert-warning active';
+              feedback.textContent = 'All client-side storage, session tokens, and cookies have been permanently erased.';
+            }
+          });
+        }
+
+        // Secure Logout Form Handler (POST semantics + full state wipe)
+        const logoutForm = document.getElementById('secure-logout-form');
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            SecureStorage.purgeAll('Secure Logout');
+            const feedback = document.getElementById('order-feedback');
+            if (feedback) {
+              feedback.className = 'alert-banner alert-success active';
+              feedback.textContent = 'Securely logged out. All session & local storage artifacts have been wiped.';
+            }
+          });
+        }
+
+        // Privacy Control Center Buttons
+        const savePrefsBtn = document.getElementById('save-privacy-prefs-btn');
+        if (savePrefsBtn) {
+          savePrefsBtn.addEventListener('click', function () {
+            saveConsentPreferences();
+          });
+        }
+
+        const rejectAllBtn = document.getElementById('reject-all-optional-btn');
+        if (rejectAllBtn) {
+          rejectAllBtn.addEventListener('click', function () {
+            const funcToggle = document.getElementById('consent-functional');
+            const anaToggle = document.getElementById('consent-analytics');
+            const extToggle = document.getElementById('consent-external-media');
+            if (funcToggle) funcToggle.checked = false;
+            if (anaToggle) anaToggle.checked = false;
+            if (extToggle) extToggle.checked = false;
+            saveConsentPreferences();
+          });
+        }
+
+        // Third-Party Audit Interactive Buttons
+        const runAuditBtn = document.getElementById('run-dom-audit-btn');
+        if (runAuditBtn) {
+          runAuditBtn.addEventListener('click', function () {
+            auditDOMThirdParties();
+          });
+        }
+
+        const simulateTrackerBtn = document.getElementById('simulate-tracker-btn');
+        if (simulateTrackerBtn) {
+          simulateTrackerBtn.addEventListener('click', function () {
+            // Attempt a simulated tracker beacon & fetch that our firewall intercepts and blocks
+            navigator.sendBeacon('https://www.google-analytics.com/collect?v=1&tid=UA-XXXXX-Y', 't=pageview');
+            window.fetch('https://connect.facebook.net/en_US/fbevents.js').catch(function () {
+              // Expected rejection from Privacy by Design Firewall
+            });
+          });
+        }
+
+        // Consent Banner Controls
+        const banner = document.getElementById('consent-banner');
+        const openBannerBtn = document.getElementById('open-privacy-center-btn');
+        const bannerReject = document.getElementById('banner-reject-all');
+        const bannerCustomize = document.getElementById('banner-customize');
+        const bannerAcceptFunc = document.getElementById('banner-accept-functional');
+
+        if (openBannerBtn && banner) {
+          openBannerBtn.addEventListener('click', function () {
+            banner.classList.add('visible');
+          });
+        }
+        if (bannerReject && banner) {
+          bannerReject.addEventListener('click', function () {
+            if (rejectAllBtn) rejectAllBtn.click();
+            banner.classList.remove('visible');
+          });
+        }
+        if (bannerCustomize && banner) {
+          bannerCustomize.addEventListener('click', function () {
+            banner.classList.remove('visible');
+            const section = document.getElementById('privacy-center');
+            if (section && section.scrollIntoView) section.scrollIntoView({ behavior: 'smooth' });
+          });
+        }
+        if (bannerAcceptFunc && banner) {
+          bannerAcceptFunc.addEventListener('click', function () {
+            const funcToggle = document.getElementById('consent-functional');
+            if (funcToggle) funcToggle.checked = true;
+            saveConsentPreferences();
+            banner.classList.remove('visible');
+          });
+        }
+      }
+
+      /* =========================================================================
+       * 8. INITIALIZATION
+       * ========================================================================= */
+      function initPrivacyByDesign() {
+        scrubUrlParameters();
+        installNetworkFirewall();
+        SecureStorage.purgeExpiredAndUnauthorized();
+        loadConsentPreferences();
+        auditDOMThirdParties();
+        setupOrderAndPrivacyHandlers();
+        renderInspectorViews();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPrivacyByDesign);
+      } else {
+        initPrivacyByDesign();
+      }
+    })();
+  </script>
