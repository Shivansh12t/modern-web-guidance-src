+                feedback.className = 'alert-banner alert-warning active';
+                feedback.textContent = 'Please provide a pickup alias or initials so we can call your order.';
+              }
+              return;
+            }
+
+            // Scrub any accidental PII entered into the alias field
+            const sanitizedAlias = scrubPIIFromString(rawAlias);
+            const rawEmail = emailInput ? emailInput.value.trim() : '';
+            const emailHash = rawEmail ? await sha256Pseudonymize(rawEmail) : 'none (paperless counter code)';
+            const orderCode = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+
+            const minimizedOrderPayload = {
+              orderToken: orderCode,
+              pickupAlias: sanitizedAlias,
+              beverage: itemSelect ? itemSelect.value : 'Maple Oat Latte',
+              roastery: storeSelect ? storeSelect.value : 'Downtown Roastery',
+              emailHash: emailHash
+            };
+
+            SecureStorage.setItem('active_pickup_order', minimizedOrderPayload, 2 * 60 * 60 * 1000); // 2h TTL for active pickup
+
+            if (optInRewards && optInRewards.checked) {
+              const consentFunc = document.getElementById('consent-functional');
+              if (consentFunc) consentFunc.checked = true;
+              saveConsentPreferences();
+              const stampHash = await sha256Pseudonymize(rawEmail || sanitizedAlias);
