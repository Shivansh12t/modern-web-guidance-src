+          renderInspectorViews();
+        },
+
+        exportAll: function () {
+          const snapshot = {};
+          memoryVault.forEach(function (val, key) {
+            snapshot[key] = val;
+          });
+          [window.sessionStorage, window.localStorage].forEach(function (store) {
+            if (!store) return;
+            try {
+              for (let i = 0; i < store.length; i++) {
+                const k = store.key(i);
+                if (k && k.indexOf(PRIVACY_CONFIG.storagePrefix) === 0) {
+                  snapshot[k] = JSON.parse(store.getItem(k));
+                }
+              }
+            } catch (e) { /* ignore */ }
+          });
+          return snapshot;
+        }
+      };
+
+      /* =========================================================================
+       * 5. GLOBAL PRIVACY CONTROL (GPC) / DNT DETECTION & CONSENT MANAGER
+       * ========================================================================= */
+      function detectPrivacySignals() {
+        const gpcEnabled = Boolean(navigator.globalPrivacyControl === true);
+        const dntEnabled = Boolean(
+          navigator.doNotTrack === '1' ||
+          window.doNotTrack === '1' ||
+          navigator.msDoNotTrack === '1'
+        );
+        return {
+          gpc: gpcEnabled,
+          dnt: dntEnabled,
+          restricted: gpcEnabled || dntEnabled
+        };
+      }
+
+      const defaultConsentState = {
+        necessary: true,
+        functional: false,
+        analytics: false,
+        externalMedia: false,
+        gpcHonored: false,
+        updatedAt: new Date().toISOString()
+      };
+
+      function loadConsentPreferences() {
+        const signals = detectPrivacySignals();
+        const stored = SecureStorage.getItem('consent_prefs') || Object.assign({}, defaultConsentState);
+
+        // If browser sends GPC or DNT, force analytics and external tracking off
+        if (signals.restricted) {
+          stored.analytics = false;
+          stored.externalMedia = false;
+          stored.gpcHonored = true;
+        }
+
+        // Update UI badge
+        const gpcBadge = document.getElementById('gpc-status-badge');
+        if (gpcBadge) {
+          if (signals.restricted) {
+            gpcBadge.textContent = 'GPC / DNT Signal Detected: Opt-Out Enforced';
+            gpcBadge.className = 'badge badge-secure';
+          } else {
+            gpcBadge.textContent = 'GPC / DNT: Not Set (Strict Opt-In Default Active)';
+          }
+        }
+
+        // Sync UI toggles
+        const funcToggle = document.getElementById('consent-functional');
+        const anaToggle = document.getElementById('consent-analytics');
+        const extToggle = document.getElementById('consent-external-media');
+
+        if (funcToggle) funcToggle.checked = Boolean(stored.functional);
+        if (anaToggle) {
+          anaToggle.checked = Boolean(stored.analytics);
+          if (signals.restricted) anaToggle.disabled = true;
+        }
+        if (extToggle) {
+          extToggle.checked = Boolean(stored.externalMedia);
+          if (signals.restricted) extToggle.disabled = true;
+        }
+
+        return stored;
+      }
+
+      function saveConsentPreferences(customState) {
+        const signals = detectPrivacySignals();
+        const funcToggle = document.getElementById('consent-functional');
+        const anaToggle = document.getElementById('consent-analytics');
+        const extToggle = document.getElementById('consent-external-media');
+
+        const nextState = customState || {
+          necessary: true,
+          functional: funcToggle ? funcToggle.checked : false,
+          analytics: signals.restricted ? false : (anaToggle ? anaToggle.checked : false),
+          externalMedia: signals.restricted ? false : (extToggle ? extToggle.checked : false),
+          gpcHonored: signals.restricted,
+          updatedAt: new Date().toISOString()
+        };
+
+        SecureStorage.setItem('consent_prefs', nextState);
+        if (!nextState.functional) {
+          SecureStorage.removeItem('loyalty_token');
+        }
+
+        const statusLabel = document.getElementById('consent-last-updated');
+        if (statusLabel) {
+          statusLabel.textContent =
+            'Preferences saved at ' + new Date().toLocaleTimeString() +
+            ' (Functional: ' + (nextState.functional ? 'ON' : 'OFF') +
+            ', Analytics: ' + (nextState.analytics ? 'ON' : 'OFF') +
+            ', External Media: ' + (nextState.externalMedia ? 'ON' : 'OFF') + ')';
+        }
+        appendLog(auditLogs, 'Updated granular consent state (Strict Opt-In enforced).');
+        loadConsentPreferences();
+        renderInspectorViews();
+      }
+
+      /* =========================================================================
+       * 6. THIRD-PARTY AUDIT & RUNTIME NETWORK / DOM RESOURCE FIREWALL
+       * ========================================================================= */
+      function isUrlAllowed(rawUrl, resourceType) {
+        try {
+          const resolved = new URL(rawUrl, window.location.origin);
+          // Block known tracker patterns unconditionally
+          for (let i = 0; i < PRIVACY_CONFIG.blockedTrackerPatterns.length; i++) {
+            if (PRIVACY_CONFIG.blockedTrackerPatterns[i].test(resolved.href)) {
+              return { allowed: false, reason: 'Matched known tracker blocklist (' + resolved.hostname + ')' };
+            }
+          }
+          // Same-origin is always allowed
+          if (resolved.origin === window.location.origin) {
+            return { allowed: true, reason: 'Same-origin resource' };
+          }
+          // Unsplash is only permitted for passive images, never scripts or fetch
+          if (resolved.origin === 'https://images.unsplash.com' && resourceType === 'image') {
+            return { allowed: true, reason: 'Allowlisted stock image origin (no credentials)' };
+          }
+          // Check if user explicitly opted into external media for non-tracker embeds
+          const prefs = SecureStorage.getItem('consent_prefs') || defaultConsentState;
+          if (prefs.externalMedia && resourceType === 'embed') {
+            return { allowed: true, reason: 'User opted into external media' };
+          }
+          return { allowed: false, reason: 'Unauthorized third-party origin (' + resolved.origin + ')' };
+        } catch (e) {
+          return { allowed: false, reason: 'Malformed URL blocked' };
+        }
+      }
+
+      function installNetworkFirewall() {
+        // Wrap window.fetch to prevent unauthorized third-party data exfiltration
+        if (typeof window.fetch === 'function') {
+          const originalFetch = window.fetch.bind(window);
+          window.fetch = function (input, init) {
+            const targetUrl = typeof input === 'string' ? input : (input && input.url ? input.url : '');
+            const check = isUrlAllowed(targetUrl, 'fetch');
+            if (!check.allowed) {
+              appendLog(auditLogs, 'BLOCKED fetch() to ' + targetUrl + ' -> ' + check.reason);
+              renderInspectorViews();
+              return Promise.reject(new Error('Privacy by Design Firewall blocked request to ' + targetUrl));
+            }
+            // Enforce privacy-preserving defaults on allowed fetch calls
+            const safeInit = Object.assign({
+              credentials: 'same-origin',
+              referrerPolicy: 'strict-origin-when-cross-origin'
+            }, init || {});
+            appendLog(auditLogs, 'ALLOWED same-origin fetch() to ' + targetUrl);
+            renderInspectorViews();
+            return originalFetch(input, safeInit);
+          };
+        }
+
+        // Wrap navigator.sendBeacon to block silent background telemetry beacons
+        if (navigator && typeof navigator.sendBeacon === 'function') {
+          const originalBeacon = navigator.sendBeacon.bind(navigator);
+          navigator.sendBeacon = function (url, data) {
+            const check = isUrlAllowed(url, 'beacon');
+            if (!check.allowed) {
+              appendLog(auditLogs, 'BLOCKED navigator.sendBeacon() to ' + url + ' -> ' + check.reason);
+              renderInspectorViews();
+              return false;
+            }
+            return originalBeacon(url, data);
+          };
+        }
+
+        // Listen for CSP violations
+        document.addEventListener('securitypolicyviolation', function (e) {
+          appendLog(
+            auditLogs,
+            'CSP Violation Blocked: directive [' + e.violatedDirective + '] blocked [' + (e.blockedURI || 'inline') + ']'
+          );
+          renderInspectorViews();
+        });
+      }
+
+      function auditDOMThirdParties() {
+        let externalLinksHardened = 0;
+        let unauthorizedNodesRemoved = 0;
+
+        // 1. Harden all anchor links
+        document.querySelectorAll('a[href]').forEach(function (link) {
+          const href = link.getAttribute('href') || '';
+          if (/^https?:\/\//i.test(href)) {
+            const check = isUrlAllowed(href, 'link');
+            link.setAttribute('rel', 'noopener noreferrer');
+            link.setAttribute('referrerpolicy', 'no-referrer');
+            externalLinksHardened++;
+            if (!check.allowed) {
+              appendLog(auditLogs, 'Hardened external link with rel="noopener noreferrer" & no-referrer: ' + href);
+            }
+          }
+        });
+
+        // 2. Audit scripts, iframes, and images
+        document.querySelectorAll('script[src], iframe[src], img[src]').forEach(function (el) {
+          const src = el.getAttribute('src');
+          if (!src) return;
+          const tag = el.tagName.toLowerCase();
+          const type = tag === 'img' ? 'image' : (tag === 'iframe' ? 'embed' : 'script');
+          const check = isUrlAllowed(src, type);
+          if (!check.allowed) {
+            el.removeAttribute('src');
+            el.setAttribute('data-blocked-src', src);
+            unauthorizedNodesRemoved++;
+            appendLog(auditLogs, 'QUARANTINED unauthorized <' + tag + '> resource: ' + src + ' (' + check.reason + ')');
+          }
+        });
+
+        appendLog(
+          auditLogs,
+          'DOM Third-Party Audit completed: ' +
+          unauthorizedNodesRemoved + ' unauthorized trackers found, ' +
+          externalLinksHardened + ' external links hardened.'
+        );
+        renderInspectorViews();
+      }
+
+      /* =========================================================================
+       * 7. UI INSPECTOR & INTERACTIVE PRIVACY WORKFLOWS
+       * ========================================================================= */
+      function renderInspectorViews() {
+        const storageView = document.getElementById('storage-inspector-view');
+        if (storageView) {
+          const snapshot = SecureStorage.exportAll();
+          const keys = Object.keys(snapshot);
+          if (keys.length === 0) {
+            storageView.textContent = '// Vault is empty (Zero persistent client data stored)';
+          } else {
+            storageView.textContent = JSON.stringify(snapshot, null, 2);
+          }
+        }
+
+        const sanitizerView = document.getElementById('sanitizer-log-view');
+        if (sanitizerView) {
+          sanitizerView.textContent = sanitizerLogs.length
+            ? sanitizerLogs.join('\n')
+            : '// Sanitizer active and monitoring inputs.';
+        }
+
+        const auditView = document.getElementById('audit-log-view');
+        if (auditView) {
+          auditView.textContent = auditLogs.length
+            ? auditLogs.join('\n')
+            : '// Runtime Firewall active.';
+        }
+      }
+
+      function setupOrderAndPrivacyHandlers() {
+        // Drink selector buttons populate the Express Order form
+        document.querySelectorAll('.select-drink-btn').forEach(function (btn) {
+          btn.addEventListener('click', function () {
+            const drink = btn.getAttribute('data-drink');
+            const select = document.getElementById('selected-item');
+            if (select && drink) {
+              select.value = drink;
+            }
+            const orderSection = document.getElementById('quick-order');
+            if (orderSection && orderSection.scrollIntoView) {
+              orderSection.scrollIntoView({ behavior: 'smooth' });
+            }
+            const aliasInput = document.getElementById('pickup-alias');
+            if (aliasInput) aliasInput.focus();
+          });
+        });
+
+        // Data-Minimized Order Form Submission
+        const orderForm = document.getElementById('minimized-order-form');
+        if (orderForm) {
+          orderForm.addEventListener('submit', async function (e) {
+            e.preventDefault();
+            const aliasInput = document.getElementById('pickup-alias');
+            const itemSelect = document.getElementById('selected-item');
+            const storeSelect = document.getElementById('pickup-store');
+            const emailInput = document.getElementById('receipt-email');
+            const optInRewards = document.getElementById('opt-in-rewards');
+            const feedback = document.getElementById('order-feedback');
+
+            const rawAlias = aliasInput ? aliasInput.value.trim() : '';
