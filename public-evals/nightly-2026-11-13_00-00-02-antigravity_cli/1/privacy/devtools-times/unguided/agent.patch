diff --git a/src/components/PrivacyConsentBanner.tsx b/src/components/PrivacyConsentBanner.tsx
new file mode 100644
index 0000000..ba48757
--- /dev/null
+++ b/src/components/PrivacyConsentBanner.tsx
@@ -0,0 +1,172 @@
+import React, { useState, useEffect } from 'react';
+
+const CONSENT_STORAGE_KEY = 'devtools_times_privacy_consent';
+
+export interface ConsentPreferences {
+  analytics: boolean;
+  ads: boolean;
+  updatedAt: string;
+}
+
+export default function PrivacyConsentBanner() {
+  const [showBanner, setShowBanner] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [analyticsConsent, setAnalyticsConsent] = useState(false);
+  const [adsConsent, setAdsConsent] = useState(false);
+
+  useEffect(() => {
+    try {
+      const stored = localStorage.getItem(CONSENT_STORAGE_KEY);
+      if (stored) {
+        const parsed: ConsentPreferences = JSON.parse(stored);
+        setAnalyticsConsent(Boolean(parsed.analytics));
+        setAdsConsent(Boolean(parsed.ads));
+        setShowBanner(false);
+      } else {
+        setShowBanner(true);
+      }
+    } catch {
+      setShowBanner(true);
+    }
+
+    const handleOpenPreferences = () => {
+      setShowModal(true);
+      setShowBanner(false);
+    };
+
+    window.addEventListener('open-privacy-preferences', handleOpenPreferences);
+    return () => {
+      window.removeEventListener('open-privacy-preferences', handleOpenPreferences);
+    };
+  }, []);
+
+  const savePreferences = (analytics: boolean, ads: boolean) => {
+    const prefs: ConsentPreferences = {
+      analytics,
+      ads,
+      updatedAt: new Date().toISOString(),
+    };
+    try {
+      localStorage.setItem(CONSENT_STORAGE_KEY, JSON.stringify(prefs));
+    } catch {
+      // Ignore storage errors
+    }
+    setAnalyticsConsent(analytics);
+    setAdsConsent(ads);
+    setShowBanner(false);
+    setShowModal(false);
+    window.dispatchEvent(new CustomEvent('privacy-consent-updated', { detail: prefs }));
+  };
+
+  if (!showBanner && !showModal) {
+    return null;
+  }
+
+  return (
+    <div
+      className="fixed bottom-0 inset-x-0 z-[9999] bg-white border-t border-gray-300 shadow-lg p-4 md:p-6"
+      role="region"
+      aria-label="Privacy and Cookie Preferences"
+      data-skip-tracking="true"
+    >
+      <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
+        <div className="text-xs md:text-sm text-gray-700 max-w-3xl">
+          <p className="font-semibold text-gray-900 mb-1">Privacy by Design &amp; Data Minimization</p>
+          <p>
+            We respect your privacy. By default, optional third-party analytics and advertising scripts are disabled.
+            Essential session state is used only when you save articles to your reading list. Review our{' '}
+            <a href={`${import.meta.env.BASE_URL}legal/privacy`} className="underline hover:text-gray-900">
+              Privacy Policy
+            </a>{' '}
+            for full transparency.
+          </p>
+          {showModal && (
+            <div className="mt-4 space-y-2 border-t border-gray-200 pt-3">
+              <div className="flex items-center gap-2">
+                <input
+                  id="consent-essential"
+                  type="checkbox"
+                  checked
+                  disabled
+                  className="w-4 h-4 rounded border-gray-300"
+                />
+                <label htmlFor="consent-essential" className="text-xs font-medium text-gray-700">
+                  Strictly Necessary (Reading list &amp; security headers — always active)
+                </label>
+              </div>
+              <div className="flex items-center gap-2">
+                <input
+                  id="consent-analytics"
+                  type="checkbox"
+                  checked={analyticsConsent}
+                  onChange={(e) => setAnalyticsConsent(e.target.checked)}
+                  className="w-4 h-4 rounded border-gray-300"
+                />
+                <label htmlFor="consent-analytics" className="text-xs font-medium text-gray-700">
+                  Optional Third-Party Analytics (Disabled by default; respects Do Not Track / Global Privacy Control)
+                </label>
+              </div>
+              <div className="flex items-center gap-2">
+                <input
+                  id="consent-ads"
+                  type="checkbox"
+                  checked={adsConsent}
+                  onChange={(e) => setAdsConsent(e.target.checked)}
+                  className="w-4 h-4 rounded border-gray-300"
+                />
+                <label htmlFor="consent-ads" className="text-xs font-medium text-gray-700">
+                  Optional Third-Party Advertising Slots (Disabled by default)
+                </label>
+              </div>
+            </div>
+          )}
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2 shrink-0">
+          {!showModal ? (
+            <>
+              <button
+                type="button"
+                onClick={() => savePreferences(false, false)}
+                className="px-3 py-2 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+              >
+                Essential Only (Recommended)
+              </button>
+              <button
+                type="button"
+                onClick={() => setShowModal(true)}
+                className="px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200"
+              >
+                Customize Preferences
+              </button>
+              <button
+                type="button"
+                onClick={() => savePreferences(true, false)}
+                className="px-3 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50"
+              >
+                Allow Analytics
+              </button>
+            </>
+          ) : (
+            <>
+              <button
+                type="button"
+                onClick={() => savePreferences(false, false)}
+                className="px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200"
+              >
+                Reject All Optional
+              </button>
+              <button
+                type="button"
+                onClick={() => savePreferences(analyticsConsent, adsConsent)}
+                className="px-3 py-2 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+              >
+                Save Preferences
+              </button>
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
