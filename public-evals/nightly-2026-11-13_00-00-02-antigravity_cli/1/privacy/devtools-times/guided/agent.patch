--- /dev/null
+++ b/src/pages/api/security-reports.ts
@@ -0,0 +1,39 @@
+import type { APIRoute } from 'astro';
+
+// Scrub PII, tokens, and query parameters before logging security reports
+function scrubSensitiveUrl(rawUrl: unknown): string {
+  if (typeof rawUrl !== 'string' || !rawUrl) return '';
+  try {
+    const parsed = new URL(rawUrl, 'https://astro-news-pytrpecapa-uc.a.run.app');
+    parsed.search = '';
+    parsed.hash = '';
+    parsed.username = '';
+    parsed.password = '';
+    return parsed.toString();
+  } catch {
+    return '[redacted-url]';
+  }
+}
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const payload = await request.json().catch(() => null);
+    const reports = Array.isArray(payload) ? payload : payload ? [payload] : [];
+    const sanitized = reports.map((report) => ({
+      type: report?.type || 'unknown',
+      url: scrubSensitiveUrl(report?.url || report?.body?.documentURL),
+      blockedURL: scrubSensitiveUrl(report?.body?.blockedURL || report?.body?.connection),
+      disposition: report?.body?.disposition || 'enforce',
+    }));
+
+    return new Response(JSON.stringify({ received: sanitized.length }), {
+      status: 202,
+      headers: {
+        'Content-Type': 'application/json',
+        'Cache-Control': 'no-store',
+      },
+    });
+  } catch {
+    return new Response(null, { status: 204 });
+  }
+};
