+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      const statusBadgeEl = document.getElementById('roast-status-badge');
+
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+
+      // Simulation state
+      let currentTemp = 195.0;
+      let tempDirection = 1;
+      const beanCount = 36;
+      const beans = [];
+
+      // Initialize coffee beans
+      for (let i = 0; i < beanCount; i++) {
+        beans.push({
+          x: Math.random() * canvas.width,
+          y: Math.random() * canvas.height,
+          vx: (Math.random() - 0.5) * 3.5,
+          vy: (Math.random() - 0.5) * 3.5 - 0.5,
+          radiusX: 9 + Math.random() * 4,
+          radiusY: 6 + Math.random() * 2.5,
+          angle: Math.random() * Math.PI * 2,
+          angularVelocity: (Math.random() - 0.5) * 0.08,
+          roastShade: Math.random()
+        });
+      }
+
+      function getBeanColor(temp, shadeOffset) {
+        // Interpolate from light cinnamon roast to dark espresso roast based on temperature (175°C - 225°C)
+        const normalized = Math.max(0, Math.min(1, (temp - 175) / 50 + (shadeOffset - 0.5) * 0.15));
+        const r = Math.round(165 - normalized * 105);
+        const g = Math.round(110 - normalized * 75);
+        const b = Math.round(70 - normalized * 50);
+        return `rgb(${r}, ${g}, ${b})`;
+      }
+
+      function renderFrame() {
+        if (!isRunning) return;
+
+        const w = canvas.width;
+        const h = canvas.height;
+
+        ctx.clearRect(0, 0, w, h);
+
+        // Draw subtle heat glow at bottom of the drum
+        const grad = ctx.createLinearGradient(0, h * 0.5, 0, h);
+        grad.addColorStop(0, 'rgba(255, 109, 0, 0)');
+        grad.addColorStop(1, 'rgba(255, 109, 0, 0.15)');
+        ctx.fillStyle = grad;
+        ctx.fillRect(0, 0, w, h);
+
+        // Update and draw each roasting coffee bean
+        for (let i = 0; i < beans.length; i++) {
+          const b = beans[i];
+
+          // Drum tumbling physics
+          b.vy += 0.07; // gravity
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.angularVelocity;
+
+          // Bounce off walls and drum paddles
+          if (b.x < b.radiusX) {
+            b.x = b.radiusX;
+            b.vx = Math.abs(b.vx) * 0.9;
+          } else if (b.x > w - b.radiusX) {
+            b.x = w - b.radiusX;
+            b.vx = -Math.abs(b.vx) * 0.9;
+          }
+
+          if (b.y > h - b.radiusX) {
+            b.y = h - b.radiusX;
+            // Agitate upward like a rotating roaster drum
+            b.vy = -(2.5 + Math.random() * 2.8);
+            b.vx += (Math.random() - 0.5) * 1.5;
+            b.vx = Math.max(-4, Math.min(4, b.vx));
+          } else if (b.y < b.radiusX) {
+            b.y = b.radiusX;
+            b.vy = Math.abs(b.vy) * 0.8;
+          }
+
+          // Draw bean body
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.radiusX, b.radiusY, 0, 0, Math.PI * 2);
+          ctx.fillStyle = getBeanColor(currentTemp, b.roastShade);
+          ctx.fill();
+          ctx.lineWidth = 1;
+          ctx.strokeStyle = 'rgba(30, 15, 10, 0.7)';
+          ctx.stroke();
+
+          // Draw coffee bean center crease
+          ctx.beginPath();
+          ctx.moveTo(-b.radiusX * 0.75, 0);
+          ctx.quadraticCurveTo(0, b.radiusY * 0.35, b.radiusX * 0.75, 0);
+          ctx.strokeStyle = 'rgba(25, 12, 8, 0.85)';
+          ctx.lineWidth = 1.4;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        animationFrameId = requestAnimationFrame(renderFrame);
+      }
+
+      function updateTemperature() {
+        // Cycle temperature between 185°C (First Crack) and 220°C (Second Crack)
+        const delta = (Math.random() * 1.2 + 0.3) * tempDirection;
+        currentTemp += delta;
+        if (currentTemp >= 220.0) {
+          currentTemp = 220.0;
+          tempDirection = -1;
+        } else if (currentTemp <= 185.0) {
+          currentTemp = 185.0;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°C`;
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+
+        if (statusBadgeEl) {
+          statusBadgeEl.textContent = 'Active';
+          statusBadgeEl.classList.remove('paused');
+        }
+
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(renderFrame);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 800);
+        }
+      }
+
+      function pauseSimulation() {
+        if (!isRunning) return;
+        isRunning = false;
+
+        if (statusBadgeEl) {
+          statusBadgeEl.textContent = 'Paused';
+          statusBadgeEl.classList.add('paused');
+        }
+
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Pause/resume when widget rendering state changes or scrolls out of/into view
+      const supportsContentVisibilityEvent = 'oncontentvisibilityautostatechange' in widget || 'ContentVisibilityAutoStateChangeEvent' in window;
+
+      widget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          pauseSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      // Robust fallback using IntersectionObserver (for browsers without contentvisibilityautostatechange
+      // and to guarantee immediate viewport visibility detection)
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          for (const entry of entries) {
+            if (entry.target === widget) {
+              if (entry.isIntersecting) {
+                startSimulation();
+              } else {
+                pauseSimulation();
+              }
+            }
+          }
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else if (!supportsContentVisibilityEvent) {
+        // Legacy fallback if neither ContentVisibilityAutoStateChangeEvent nor IntersectionObserver is supported
+        function checkViewportScroll() {
+          const rect = widget.getBoundingClientRect();
+          const inView = rect.bottom > 0 && rect.top < (window.innerHeight || document.documentElement.clientHeight);
+          if (inView) {
+            startSimulation();
+          } else {
+            pauseSimulation();
+          }
+        }
+        window.addEventListener('scroll', checkViewportScroll, { passive: true });
+        window.addEventListener('resize', checkViewportScroll, { passive: true });
+        checkViewportScroll();
+      }
+    })();
+  </script>
