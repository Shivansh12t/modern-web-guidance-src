+  <script>
+    const roastingWidget = document.getElementById('roasting-widget');
+    const canvas = document.getElementById('roast-canvas');
+    const ctx = canvas.getContext('2d');
+    const tempValueEl = document.getElementById('roast-temp-value');
+
+    let animationFrameId = null;
+    let tempIntervalId = null;
+    let currentTemp = 385.0;
+    let tempDirection = 1;
+
+    // Create simulated coffee beans
+    const beans = Array.from({ length: 28 }, () => ({
+      x: Math.random() * (canvas.width - 40) + 20,
+      y: Math.random() * (canvas.height - 40) + 20,
+      vx: (Math.random() - 0.5) * 3.5,
+      vy: (Math.random() - 0.5) * 3.5,
+      angle: Math.random() * Math.PI * 2,
+      vAngle: (Math.random() - 0.5) * 0.08,
+      rx: 10 + Math.random() * 4,
+      ry: 7 + Math.random() * 2,
+      shade: Math.floor(Math.random() * 25)
+    }));
+
+    function drawFrame() {
+      ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+      // Subtle heat glow at the bottom of the drum
+      const grad = ctx.createLinearGradient(0, canvas.height * 0.6, 0, canvas.height);
+      grad.addColorStop(0, 'rgba(255, 109, 0, 0)');
+      grad.addColorStop(1, 'rgba(255, 109, 0, 0.18)');
+      ctx.fillStyle = grad;
+      ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+      for (const bean of beans) {
+        bean.x += bean.vx;
+        bean.y += bean.vy;
+        bean.angle += bean.vAngle;
+
+        if (bean.x < bean.rx || bean.x > canvas.width - bean.rx) bean.vx *= -1;
+        if (bean.y < bean.ry || bean.y > canvas.height - bean.ry) bean.vy *= -1;
+
+        ctx.save();
+        ctx.translate(bean.x, bean.y);
+        ctx.rotate(bean.angle);
+
+        // Bean body
+        ctx.fillStyle = `rgb(${75 + bean.shade}, ${45 + bean.shade}, ${35 + bean.shade})`;
+        ctx.beginPath();
+        ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Bean center crease
+        ctx.strokeStyle = '#24140e';
+        ctx.lineWidth = 1.5;
+        ctx.beginPath();
+        ctx.moveTo(-bean.rx * 0.75, 0);
+        ctx.quadraticCurveTo(0, 2.5, bean.rx * 0.75, 0);
+        ctx.stroke();
+
+        ctx.restore();
+      }
+
+      animationFrameId = requestAnimationFrame(drawFrame);
+    }
+
+    function updateTemperature() {
+      const delta = (Math.random() * 1.4 + 0.3) * tempDirection;
+      currentTemp += delta;
+      if (currentTemp >= 435) tempDirection = -1;
+      if (currentTemp <= 380) tempDirection = 1;
+      tempValueEl.textContent = `${currentTemp.toFixed(1)}°F`;
+    }
+
+    function startSimulation() {
+      if (animationFrameId === null) {
+        animationFrameId = requestAnimationFrame(drawFrame);
+      }
+      if (tempIntervalId === null) {
+        tempIntervalId = setInterval(updateTemperature, 1000);
+      }
+    }
+
+    function stopSimulation() {
+      if (animationFrameId !== null) {
+        cancelAnimationFrame(animationFrameId);
+        animationFrameId = null;
+      }
+      if (tempIntervalId !== null) {
+        clearInterval(tempIntervalId);
+        tempIntervalId = null;
+      }
+    }
+
+    // Listen directly to contentvisibilityautostatechange on the element
+    roastingWidget.addEventListener('contentvisibilityautostatechange', (event) => {
+      if (event.skipped) {
+        stopSimulation();
+      } else {
+        startSimulation();
+      }
+    });
+
+    // Fallback using IntersectionObserver for older browsers lacking content-visibility support
+    const isSupported = 'contentVisibility' in document.documentElement.style;
+
+    if (!isSupported) {
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          if (entry.isIntersecting) {
+            startSimulation();
+          } else {
+            stopSimulation();
+          }
+        });
+      }, {
+        rootMargin: '200px'
+      });
+
+      observer.observe(roastingWidget);
+    }
+  </script>
 </body>
 
