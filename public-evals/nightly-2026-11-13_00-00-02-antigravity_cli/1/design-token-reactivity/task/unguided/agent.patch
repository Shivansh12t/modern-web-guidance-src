+  <script>
+    const toggleBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    if (toggleBtn && targetContainer) {
+      toggleBtn.addEventListener('click', () => {
+        const currentDensity = getComputedStyle(targetContainer)
+          .getPropertyValue('--card-density')
+          .trim();
+        const isSpacious = currentDensity === 'spacious';
+        const nextDensity = isSpacious ? 'compact' : 'spacious';
+
+        targetContainer.style.setProperty('--card-density', nextDensity);
+        toggleBtn.setAttribute('aria-pressed', String(!isSpacious));
+        toggleBtn.textContent = !isSpacious ? 'Compact Layout' : 'Spacious Layout';
+      });
+    }
+  </script>
