+  <script src="https://cdn.jsdelivr.net/npm/three-html-render/dist/polyfill.js"></script>
+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const exportElement = document.getElementById('export_element');
+      const messageControl = document.getElementById('card-message-control');
+      const recipientControl = document.getElementById('card-recipient-control');
+      const amountControl = document.getElementById('card-amount-control');
+      const inlineMessage = document.getElementById('inline-card-message');
+      const inlineRecipient = document.getElementById('inline-card-recipient');
+      const amountDisplay = document.getElementById('card-amount-display');
+      const colorPicker = document.getElementById('card-bg-color');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export-card-btn');
+      const fallbackNotice = document.getElementById('canvas-fallback-notice');
+
+      // 1. Check if HTML-in-Canvas is supported in the browser
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+      if (!supportsHtmlInCanvas) {
+        if (typeof installHtmlInCanvasPolyfill === 'function') {
+          installHtmlInCanvasPolyfill();
+        }
+        if (fallbackNotice) {
+          fallbackNotice.style.display = 'block';
+        }
+      }
+
+      const ctx = canvas.getContext('2d');
+
+      function requestCanvasPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else if (typeof canvas.onpaint === 'function') {
+          canvas.onpaint({ changedElements: [exportElement] });
+        }
+      }
+
+      // Render the HTML content to the canvas inside a canvas.onpaint event handler
+      canvas.onpaint = () => {
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        if (typeof ctx.drawElementImage === 'function') {
+          // Draw the #export_element at x:0, y:0; browser syncs DOM location for hit-testing
+          ctx.drawElementImage(exportElement, 0, 0);
+        }
+      };
+
+      // Scale canvas grid to match the device scale factor to prevent blurriness
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        requestCanvasPaint();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      // Sync message inputs (sidebar control <-> inline card input)
+      messageControl.addEventListener('input', (e) => {
+        inlineMessage.value = e.target.value;
+        inlineMessage.setAttribute('value', e.target.value);
+        requestCanvasPaint();
+      });
+
+      inlineMessage.addEventListener('input', (e) => {
+        messageControl.value = e.target.value;
+        inlineMessage.setAttribute('value', e.target.value);
+        requestCanvasPaint();
+      });
+
+      // Sync recipient inputs (sidebar control <-> inline card input)
+      recipientControl.addEventListener('input', (e) => {
+        inlineRecipient.value = e.target.value;
+        inlineRecipient.setAttribute('value', e.target.value);
+        requestCanvasPaint();
+      });
+
+      inlineRecipient.addEventListener('input', (e) => {
+        recipientControl.value = e.target.value;
+        inlineRecipient.setAttribute('value', e.target.value);
+        requestCanvasPaint();
+      });
+
+      // Sync gift amount
+      amountControl.addEventListener('change', (e) => {
+        amountDisplay.textContent = e.target.value;
+        requestCanvasPaint();
+      });
+
+      // Background color updates
+      function setCardBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        colorPicker.value = color;
+        colorSwatches.forEach((swatch) => {
+          swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+        });
+        requestCanvasPaint();
+      }
+
+      colorSwatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          setCardBackgroundColor(swatch.dataset.color);
+        });
+      });
+
+      colorPicker.addEventListener('input', (e) => {
+        setCardBackgroundColor(e.target.value);
+      });
+
+      // Export the canvas design as an image file
+      exportBtn.addEventListener('click', () => {
+        requestCanvasPaint();
+        const dataURL = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        link.download = 'daily-grind-gift-card.png';
+        link.href = dataURL;
+        link.click();
+      });
+    })();
+  </script>
 </body>
 
