+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const messageInput = document.getElementById('card-message-input');
+      const messageText = document.getElementById('card-message-text');
+      const colorInput = document.getElementById('card-bg-color');
+      const swatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export-btn');
+
+      function wrapText(context, text, x, y, maxWidth, lineHeight) {
+        const words = (text || '').split(/\s+/);
+        const lines = [];
+        let currentLine = '';
+
+        for (let i = 0; i < words.length; i++) {
+          const testLine = currentLine ? currentLine + ' ' + words[i] : words[i];
+          const metrics = context.measureText(testLine);
+          if (metrics.width > maxWidth && currentLine) {
+            lines.push(currentLine);
+            currentLine = words[i];
+          } else {
+            currentLine = testLine;
+          }
+        }
+        if (currentLine) {
+          lines.push(currentLine);
+        }
+
+        const totalHeight = (lines.length - 1) * lineHeight;
+        let startY = y - totalHeight / 2;
+
+        for (let i = 0; i < lines.length; i++) {
+          context.fillText(lines[i], x, startY + i * lineHeight);
+        }
+      }
+
+      function drawRoundedRect(context, x, y, width, height, radius) {
+        context.beginPath();
+        context.moveTo(x + radius, y);
+        context.lineTo(x + width - radius, y);
+        context.quadraticCurveTo(x + width, y, x + width, y + radius);
+        context.lineTo(x + width, y + height - radius);
+        context.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
+        context.lineTo(x + radius, y + height);
+        context.quadraticCurveTo(x, y + height, x, y + height - radius);
+        context.lineTo(x, y + radius);
+        context.quadraticCurveTo(x, y, x + radius, y);
+        context.closePath();
+      }
+
+      function drawCardFallback(targetCtx) {
+        const w = canvas.width;
+        const h = canvas.height;
+        const bgColor = exportElement.style.backgroundColor || colorInput.value || '#4e342e';
+        const customMessage = (messageText ? messageText.textContent : exportElement.textContent) || 'Enjoy a warm cup on me!';
+
+        targetCtx.clearRect(0, 0, w, h);
+
+        // Card background
+        drawRoundedRect(targetCtx, 0, 0, w, h, 16);
+        targetCtx.fillStyle = bgColor;
+        targetCtx.fill();
+
+        // Card border
+        targetCtx.lineWidth = 2;
+        targetCtx.strokeStyle = 'rgba(255, 171, 64, 0.45)';
+        targetCtx.stroke();
+
+        // Header divider
+        targetCtx.beginPath();
+        targetCtx.moveTo(32, 68);
+        targetCtx.lineTo(w - 32, 68);
+        targetCtx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        targetCtx.lineWidth = 1;
+        targetCtx.stroke();
+
+        // Brand title
+        targetCtx.fillStyle = '#ffab40';
+        targetCtx.font = 'bold 18px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        targetCtx.textAlign = 'left';
+        targetCtx.textBaseline = 'middle';
+        targetCtx.fillText('THE DAILY GRIND', 32, 42);
+
+        // Gift card badge
+        const badgeText = '$25 GIFT CARD';
+        targetCtx.font = 'bold 14px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        const badgeWidth = targetCtx.measureText(badgeText).width + 24;
+        const badgeX = w - 32 - badgeWidth;
+        const badgeY = 27;
+        const badgeH = 28;
+
+        drawRoundedRect(targetCtx, badgeX, badgeY, badgeWidth, badgeH, 14);
+        targetCtx.fillStyle = 'rgba(255, 171, 64, 0.2)';
+        targetCtx.fill();
+        targetCtx.lineWidth = 1;
+        targetCtx.strokeStyle = '#ffab40';
+        targetCtx.stroke();
+
+        targetCtx.fillStyle = '#ffab40';
+        targetCtx.textAlign = 'center';
+        targetCtx.fillText(badgeText, badgeX + badgeWidth / 2, badgeY + badgeH / 2 + 1);
+
+        // Custom message / name
+        targetCtx.fillStyle = '#ffffff';
+        targetCtx.font = '600 24px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        targetCtx.textAlign = 'center';
+        targetCtx.textBaseline = 'middle';
+        wrapText(targetCtx, customMessage.trim(), w / 2, h / 2 + 4, w - 72, 32);
+
+        // Footer divider
+        targetCtx.beginPath();
+        targetCtx.moveTo(32, h - 56);
+        targetCtx.lineTo(w - 32, h - 56);
+        targetCtx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
+        targetCtx.lineWidth = 1;
+        targetCtx.stroke();
+
+        // Footer text
+        targetCtx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        targetCtx.font = '13px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        targetCtx.textAlign = 'left';
+        targetCtx.fillText('Artisanal Coffee Co.', 32, h - 34);
+        targetCtx.textAlign = 'right';
+        targetCtx.fillText('Redeemable at all locations', w - 32, h - 34);
+      }
+
+      function renderHtmlInCanvas() {
+        if (typeof ctx.drawElementImage === 'function') {
+          try {
+            if (typeof ctx.reset === 'function') {
+              ctx.reset();
+            } else {
+              ctx.clearRect(0, 0, canvas.width, canvas.height);
+            }
+            const transform = ctx.drawElementImage(exportElement, 0, 0);
+            if (transform) {
+              exportElement.style.transform = transform.toString();
+            }
+            return true;
+          } catch (e) {
+            // Element paint record may not be ready yet; fallback until next paint event
+          }
+        } else if (typeof ctx.drawElement === 'function') {
+          try {
+            if (typeof ctx.reset === 'function') {
+              ctx.reset();
+            } else {
+              ctx.clearRect(0, 0, canvas.width, canvas.height);
+            }
+            const transform = ctx.drawElement(exportElement, 0, 0);
+            if (transform) {
+              exportElement.style.transform = transform.toString();
+            }
+            return true;
+          } catch (e) {
+            // Fallback until next paint event
+          }
+        }
+        return false;
+      }
+
+      function updateCanvas() {
+        if (!renderHtmlInCanvas()) {
+          drawCardFallback(ctx);
+        }
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      }
+
+      canvas.addEventListener('paint', function () {
+        if (!renderHtmlInCanvas()) {
+          drawCardFallback(ctx);
+        }
+      });
+
+      messageInput.addEventListener('input', function () {
+        const val = messageInput.value || 'Enjoy a warm cup on me!';
+        messageText.textContent = val;
+        updateCanvas();
+      });
+
+      messageText.addEventListener('input', function () {
+        messageInput.value = messageText.textContent;
+        updateCanvas();
+      });
+
+      function setCardColor(color) {
+        colorInput.value = color;
+        exportElement.style.backgroundColor = color;
+        swatches.forEach(function (swatch) {
+          swatch.classList.toggle('active', swatch.getAttribute('data-color').toLowerCase() === color.toLowerCase());
+        });
+        updateCanvas();
+      }
+
+      colorInput.addEventListener('input', function () {
+        setCardColor(colorInput.value);
+      });
+
+      colorInput.addEventListener('change', function () {
+        setCardColor(colorInput.value);
+      });
+
+      swatches.forEach(function (swatch) {
+        swatch.addEventListener('click', function () {
+          setCardColor(swatch.getAttribute('data-color'));
+        });
+      });
+
+      exportBtn.addEventListener('click', function () {
+        updateCanvas();
+        let dataUrl;
+        try {
+          dataUrl = canvas.toDataURL('image/png');
+        } catch (err) {
+          const fallbackCanvas = document.createElement('canvas');
+          fallbackCanvas.width = canvas.width;
+          fallbackCanvas.height = canvas.height;
+          drawCardFallback(fallbackCanvas.getContext('2d'));
+          dataUrl = fallbackCanvas.toDataURL('image/png');
+        }
+        const link = document.createElement('a');
+        link.download = 'coffee-gift-card.png';
+        link.href = dataUrl;
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+      });
+
+      // Initialize card background and initial canvas render
+      exportElement.style.backgroundColor = colorInput.value;
+      updateCanvas();
+    })();
+  </script>
+
 </body>
 
