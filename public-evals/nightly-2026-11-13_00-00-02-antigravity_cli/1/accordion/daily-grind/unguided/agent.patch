+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const faqSection = document.getElementById('coffee-faq');
+      if (!faqSection) return;
+
+      const items = faqSection.querySelectorAll('.accordion-item');
+
+      function closeItem(item) {
+        const button = item.querySelector('.accordion-header');
+        const panel = item.querySelector('.accordion-panel');
+        item.classList.remove('active');
+        if (button) button.setAttribute('aria-expanded', 'false');
+        if (panel) panel.style.maxHeight = null;
+      }
+
+      function openItem(item) {
+        const button = item.querySelector('.accordion-header');
+        const panel = item.querySelector('.accordion-panel');
+        item.classList.add('active');
+        if (button) button.setAttribute('aria-expanded', 'true');
+        if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
+      }
+
+      // Initialize the default active item height accurately
+      items.forEach((item) => {
+        if (item.classList.contains('active')) {
+          openItem(item);
+        } else {
+          closeItem(item);
+        }
+
+        const header = item.querySelector('.accordion-header');
+        header.addEventListener('click', () => {
+          const isOpen = item.classList.contains('active');
+
+          // Close all items so only one stays open at a time
+          items.forEach((otherItem) => closeItem(otherItem));
+
+          // Open the clicked item if it wasn't already open
+          if (!isOpen) {
+            openItem(item);
+          }
+        });
+      });
+
+      // Recalculate open panel height on window resize
+      window.addEventListener('resize', () => {
+        const activePanel = faqSection.querySelector('.accordion-item.active .accordion-panel');
+        if (activePanel) {
+          activePanel.style.maxHeight = activePanel.scrollHeight + 'px';
+        }
+      });
+    });
+  </script>
+
 </body>
 
