+
+    .carousel-subtitle {
+      text-align: center;
+      color: var(--primary);
+      margin-block-end: 24px;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: scroll;
+      scroll-snap-type: x mandatory;
+      padding-block: 32px;
+      padding-inline: max(20px, calc(50% - 140px));
+      margin-inline: -20px;
+      touch-action: manipulation;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .scroller {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .scroller > * {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+    }
+
+    .product-card img {
+      inline-size: 100%;
+      block-size: 180px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-block-end: 12px;
+    }
+
+    .product-price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin-block-top: 8px;
+    }
+
+    @keyframes animate {
+      0% {
+        scale: 0.75;
+      }
+      50% {
+        scale: 1;
+      }
+      100% {
+        scale: 0.75;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .scroller > * {
+          animation: animate auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
