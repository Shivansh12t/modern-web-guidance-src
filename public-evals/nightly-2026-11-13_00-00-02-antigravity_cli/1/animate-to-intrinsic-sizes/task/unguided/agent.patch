+  <script>
+    (function () {
+      const supportsInterpolateSize =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('interpolate-size', 'allow-keywords');
+
+      const faqTrigger = document.getElementById('faq-trigger');
+      const faqContent = document.getElementById('faq-content');
+
+      if (faqTrigger && faqContent) {
+        faqTrigger.addEventListener('click', function () {
+          const isOpen = faqContent.classList.contains('is-open');
+          const nextState = !isOpen;
+
+          faqTrigger.setAttribute('aria-expanded', String(nextState));
+          faqContent.setAttribute('aria-hidden', String(!nextState));
+
+          if (supportsInterpolateSize) {
+            faqContent.classList.toggle('is-open', nextState);
+          } else {
+            if (nextState) {
+              faqContent.classList.add('is-open');
+              faqContent.style.height = '0px';
+              void faqContent.offsetHeight;
+              faqContent.style.height = faqContent.scrollHeight + 'px';
+
+              const onEnd = function (e) {
+                if (e.propertyName === 'height') {
+                  if (faqContent.classList.contains('is-open')) {
+                    faqContent.style.height = 'auto';
+                  }
+                  faqContent.removeEventListener('transitionend', onEnd);
+                }
+              };
+              faqContent.addEventListener('transitionend', onEnd);
+            } else {
+              faqContent.style.height = faqContent.scrollHeight + 'px';
+              void faqContent.offsetHeight;
+              faqContent.classList.remove('is-open');
+              faqContent.style.height = '0px';
+            }
+          }
+        });
+      }
+
+      const promoAlert = document.getElementById('promo-alert');
+      const alertDismiss = document.getElementById('alert-dismiss');
+
+      if (promoAlert && alertDismiss) {
+        alertDismiss.addEventListener('click', function () {
+          if (promoAlert.classList.contains('is-dismissed')) {
+            return;
+          }
+
+          promoAlert.setAttribute('aria-hidden', 'true');
+
+          if (supportsInterpolateSize) {
+            promoAlert.classList.add('is-dismissed');
+          } else {
+            promoAlert.style.height = promoAlert.scrollHeight + 'px';
+            void promoAlert.offsetHeight;
+            promoAlert.classList.add('is-dismissed');
+            promoAlert.style.height = '0px';
+          }
+        });
+      }
+    })();
+  </script>
