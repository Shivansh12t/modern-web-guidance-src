+  <script>
+    const alertElement = document.getElementById('promo-alert');
+    const alertDismissBtn = document.getElementById('alert-dismiss');
+
+    function dismissAlert() {
+      if (!alertElement) return;
+      alertElement.classList.add('is-dismissed');
+      const transitions = alertElement.getAnimations().filter((animation) => animation instanceof CSSTransition);
+      Promise.allSettled(transitions.map((transition) => transition.finished)).then(() => {
+        if (alertElement.classList.contains('is-dismissed')) {
+          alertElement.hidden = true;
+        }
+      });
+    }
+
+    alertDismissBtn?.addEventListener('click', dismissAlert);
+
+    const triggerBtn = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+
+    triggerBtn?.addEventListener('click', () => {
+      const isExpanded = triggerBtn.getAttribute('aria-expanded') === 'true';
+      const nextExpanded = !isExpanded;
+      triggerBtn.setAttribute('aria-expanded', String(nextExpanded));
+
+      if (!faqContent) return;
+      if (nextExpanded) {
+        faqContent.inert = false;
+        faqContent.classList.add('is-expanded');
+      } else {
+        faqContent.classList.remove('is-expanded');
+        const transitions = faqContent.getAnimations().filter((animation) => animation instanceof CSSTransition);
+        Promise.allSettled(transitions.map((transition) => transition.finished)).then(() => {
+          if (!faqContent.classList.contains('is-expanded')) {
+            faqContent.inert = true;
+          }
+        });
+      }
+    });
+  </script>
