+  <script type="module">
+    const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+      1312: 'ML-DSA-44',
+      1952: 'ML-DSA-65',
+      2592: 'ML-DSA-87',
+    };
+
+    const ARTIFACT_CONTEXTS = {
+      receipt: 'daily-grind-order-receipt-v1',
+      voucher: 'daily-grind-gift-voucher-v1',
+    };
+
+    const textEncoder = new TextEncoder();
+
+    export function supportsPostQuantumSignatures() {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('sign', 'ML-DSA-65')
+      );
+    }
+
+    export async function generateSigningKeyPair() {
+      if (supportsPostQuantumSignatures()) {
+        const keyPair = await crypto.subtle.generateKey('ML-DSA-65', false, ['sign', 'verify']);
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+        );
+        return {
+          suite: 'ML-DSA-65',
+          keyFormat: 'raw-public',
+          keyPair,
+          publicKeyBytes,
+        };
+      }
+
+      // Classical fallback: Ed25519
+      const keyPair = await crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']);
+      const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+      return {
+        suite: 'Ed25519',
+        keyFormat: 'raw',
+        keyPair,
+        publicKeyBytes,
+      };
+    }
+
+    function frameFallbackInput(payloadBytes, contextBytes) {
+      if (contextBytes.byteLength > 255) {
+        throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+      }
+      const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+      framed[0] = contextBytes.byteLength;
+      framed.set(contextBytes, 1);
+      framed.set(payloadBytes, 1 + contextBytes.byteLength);
+      return framed;
+    }
+
+    export async function signPayload(
+      privateKey,
+      payloadBytes,
+      contextBytes = new Uint8Array(0),
+    ) {
+      if (privateKey.algorithm.name.startsWith('ML-DSA')) {
+        const sig = await crypto.subtle.sign(
+          { name: privateKey.algorithm.name, context: contextBytes },
+          privateKey,
+          payloadBytes,
+        );
+        return new Uint8Array(sig);
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+      return new Uint8Array(sig);
+    }
+
+    export async function verifyPayload(
+      publicKeyOrBytes,
+      signatureBytes,
+      payloadBytes,
+      contextBytes = new Uint8Array(0),
+    ) {
+      const publicKey =
+        publicKeyOrBytes instanceof CryptoKey
+          ? publicKeyOrBytes
+          : await (() => {
+              const bytes =
+                publicKeyOrBytes instanceof Uint8Array
+                  ? publicKeyOrBytes
+                  : new Uint8Array(publicKeyOrBytes);
+              const mlDsaName = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+              return mlDsaName
+                ? crypto.subtle.importKey('raw-public', bytes, mlDsaName, true, ['verify'])
+                : crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+            })();
+
+      if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+        return crypto.subtle.verify(
+          { name: publicKey.algorithm.name, context: contextBytes },
+          publicKey,
+          signatureBytes,
+          payloadBytes,
+        );
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+    }
+
+    function bytesToBase64(bytes) {
+      if (typeof bytes.toBase64 === 'function') {
+        return bytes.toBase64();
+      }
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary);
+    }
+
+    function base64ToBytes(base64) {
+      const cleaned = base64.trim();
+      if (typeof Uint8Array.fromBase64 === 'function') {
+        return Uint8Array.fromBase64(cleaned);
+      }
+      const binary = atob(cleaned);
+      const bytes = new Uint8Array(binary.length);
+      for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+      }
+      return bytes;
+    }
+
+    // Expose helpers on window for programmatic inspection/testing
+    window.DailyGrindCrypto = {
+      supportsPostQuantumSignatures,
+      generateSigningKeyPair,
+      signPayload,
+      verifyPayload,
+      ARTIFACT_CONTEXTS,
+    };
+
+    // UI State & Wiring
+    let activeKeyBundle = null;
+
+    const suiteBadgeEl = document.getElementById('active-suite-badge');
+    const suiteMetaEl = document.getElementById('active-suite-meta');
+    const rotateKeypairBtn = document.getElementById('rotate-keypair-btn');
+    const artifactTypeSelect = document.getElementById('signer-artifact-type');
+    const receiptFieldsEl = document.getElementById('receipt-fields');
+    const voucherFieldsEl = document.getElementById('voucher-fields');
+    const signerPayloadPreview = document.getElementById('signer-payload-preview');
+    const signArtifactBtn = document.getElementById('sign-artifact-btn');
+
+    const verifierContextSelect = document.getElementById('verifier-context');
+    const verifierPayloadEl = document.getElementById('verifier-payload');
+    const verifierPublicKeyEl = document.getElementById('verifier-public-key');
+    const verifierSignatureEl = document.getElementById('verifier-signature');
+    const verifyArtifactBtn = document.getElementById('verify-artifact-btn');
+    const tamperPayloadBtn = document.getElementById('tamper-payload-btn');
+    const swapContextBtn = document.getElementById('swap-context-btn');
+    const verificationResultEl = document.getElementById('verification-result');
+
+    function buildPayloadFromInputs() {
+      const kind = artifactTypeSelect.value;
+      if (kind === 'voucher') {
+        return JSON.stringify(
+          {
+            type: 'gift-voucher',
+            issuer: 'The Daily Grind Coffee Co.',
+            voucherCode: document.getElementById('voucher-code').value.trim(),
+            recipient: document.getElementById('voucher-recipient').value.trim(),
+            amount: document.getElementById('voucher-amount').value.trim(),
+            expiresOn: document.getElementById('voucher-expires').value.trim(),
+          },
+          null,
+          2,
+        );
+      }
+
+      return JSON.stringify(
+        {
+          type: 'order-receipt',
+          issuer: 'The Daily Grind Coffee Co.',
+          orderId: document.getElementById('receipt-order-id').value.trim(),
+          customer: document.getElementById('receipt-customer').value.trim(),
+          item: document.getElementById('receipt-item').value,
+          total: document.getElementById('receipt-total').value.trim(),
+          issuedAt: '2026-11-13T08:30:00Z',
+        },
+        null,
+        2,
+      );
+    }
+
+    function updateSignerPreview() {
+      const isVoucher = artifactTypeSelect.value === 'voucher';
+      receiptFieldsEl.hidden = isVoucher;
+      voucherFieldsEl.hidden = !isVoucher;
+      signerPayloadPreview.value = buildPayloadFromInputs();
+    }
+
+    function setVerificationMessage(state, text) {
+      verificationResultEl.dataset.state = state;
+      verificationResultEl.textContent = text;
+    }
+
+    async function rotateStoreKeys() {
+      activeKeyBundle = await generateSigningKeyPair();
+      const isPQ = activeKeyBundle.suite.startsWith('ML-DSA');
+      suiteBadgeEl.textContent = isPQ
+        ? `${activeKeyBundle.suite} (Post-Quantum)`
+        : `${activeKeyBundle.suite} (Classical Fallback)`;
+      suiteMetaEl.textContent = `Key export format: '${activeKeyBundle.keyFormat}' (${activeKeyBundle.publicKeyBytes.byteLength} bytes)`;
+      verifierPublicKeyEl.value = bytesToBase64(activeKeyBundle.publicKeyBytes);
+    }
+
+    async function signCurrentArtifact() {
+      if (!activeKeyBundle) {
+        await rotateStoreKeys();
+      }
+      updateSignerPreview();
+      const kind = artifactTypeSelect.value;
+      const contextName = ARTIFACT_CONTEXTS[kind];
+      const contextBytes = textEncoder.encode(contextName);
+      const payloadString = signerPayloadPreview.value;
+      const payloadBytes = textEncoder.encode(payloadString);
+
+      const signatureBytes = await signPayload(
+        activeKeyBundle.keyPair.privateKey,
+        payloadBytes,
+        contextBytes,
+      );
+
+      verifierContextSelect.value = contextName;
+      verifierPayloadEl.value = payloadString;
+      verifierPublicKeyEl.value = bytesToBase64(activeKeyBundle.publicKeyBytes);
+      verifierSignatureEl.value = bytesToBase64(signatureBytes);
+
+      await runVerification();
+    }
+
+    async function runVerification() {
+      try {
+        const contextName = verifierContextSelect.value;
+        const contextBytes = textEncoder.encode(contextName);
+        const payloadBytes = textEncoder.encode(verifierPayloadEl.value);
+        const publicKeyBytes = base64ToBytes(verifierPublicKeyEl.value);
+        const signatureBytes = base64ToBytes(verifierSignatureEl.value);
+
+        const isValid = await verifyPayload(
+          publicKeyBytes,
+          signatureBytes,
+          payloadBytes,
+          contextBytes,
+        );
+
+        if (isValid) {
+          setVerificationMessage(
+            'valid',
+            `Verified Authentic (${activeKeyBundle ? activeKeyBundle.suite : 'WebCrypto'}): Signature is valid (${signatureBytes.byteLength} bytes) for context "${contextName}".`,
+          );
+        } else {
+          setVerificationMessage(
+            'invalid',
+            `Verification Failed: Signature rejected for context "${contextName}". The payload, signature, public key, or domain context does not match.`,
+          );
+        }
+      } catch (err) {
+        setVerificationMessage(
+          'invalid',
+          `Verification Error: ${err instanceof Error ? err.message : String(err)}`,
+        );
+      }
+    }
+
+    artifactTypeSelect.addEventListener('change', () => {
+      updateSignerPreview();
+    });
+
+    for (const inputId of [
+      'receipt-order-id',
+      'receipt-customer',
+      'receipt-item',
+      'receipt-total',
+      'voucher-code',
+      'voucher-recipient',
+      'voucher-amount',
+      'voucher-expires',
+    ]) {
+      document.getElementById(inputId).addEventListener('input', updateSignerPreview);
+    }
+
+    rotateKeypairBtn.addEventListener('click', async () => {
+      await rotateStoreKeys();
+      await signCurrentArtifact();
+    });
+
+    signArtifactBtn.addEventListener('click', () => {
+      signCurrentArtifact();
+    });
+
+    verifyArtifactBtn.addEventListener('click', () => {
+      runVerification();
+    });
+
+    tamperPayloadBtn.addEventListener('click', async () => {
+      try {
+        const parsed = JSON.parse(verifierPayloadEl.value);
+        if (parsed.total) {
+          parsed.total = '$0.01';
+        } else if (parsed.amount) {
+          parsed.amount = '$999.00';
+        } else {
+          parsed.tampered = true;
+        }
+        verifierPayloadEl.value = JSON.stringify(parsed, null, 2);
+      } catch {
+        verifierPayloadEl.value += '\n// tampered';
+      }
+      await runVerification();
+    });
+
+    swapContextBtn.addEventListener('click', async () => {
+      verifierContextSelect.value =
+        verifierContextSelect.value === ARTIFACT_CONTEXTS.receipt
+          ? ARTIFACT_CONTEXTS.voucher
+          : ARTIFACT_CONTEXTS.receipt;
+      await runVerification();
+    });
+
+    // Initialize on load
+    updateSignerPreview();
+    signCurrentArtifact();
+  </script>
