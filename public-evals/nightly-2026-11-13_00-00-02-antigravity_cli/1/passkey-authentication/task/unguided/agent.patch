+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbortController = null;
+
+      function toBuffer(val) {
+        if (val instanceof ArrayBuffer) return new Uint8Array(val);
+        if (ArrayBuffer.isView(val)) return val;
+        if (Array.isArray(val)) return new Uint8Array(val);
+        if (typeof val === 'string') {
+          const base64 = val.replace(/-/g, '+').replace(/_/g, '/');
+          const pad = base64.length % 4 === 0 ? '' : '='.repeat(4 - (base64.length % 4));
+          try {
+            const binary = atob(base64 + pad);
+            const bytes = new Uint8Array(binary.length);
+            for (let i = 0; i < binary.length; i++) {
+              bytes[i] = binary.charCodeAt(i);
+            }
+            return bytes;
+          } catch (e) {
+            return new TextEncoder().encode(val);
+          }
+        }
+        return new Uint8Array(0);
+      }
+
+      function bufferToBase64url(buf) {
+        if (!buf) return null;
+        if (typeof buf === 'string') return buf;
+        let bytes;
+        if (buf instanceof Uint8Array) {
+          bytes = buf;
+        } else if (buf instanceof ArrayBuffer) {
+          bytes = new Uint8Array(buf);
+        } else if (ArrayBuffer.isView(buf)) {
+          bytes = new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength);
+        } else if (Array.isArray(buf)) {
+          bytes = new Uint8Array(buf);
+        } else {
+          return String(buf);
+        }
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function preparePublicKeyOptions(rawOptions) {
+        const source = (rawOptions && rawOptions.publicKey) ? rawOptions.publicKey : (rawOptions || {});
+        const publicKey = {
+          ...source,
+          challenge: toBuffer(source.challenge || 'default-challenge')
+        };
+
+        if (Array.isArray(source.allowCredentials)) {
+          publicKey.allowCredentials = source.allowCredentials.map(function (cred) {
+            return {
+              ...cred,
+              id: toBuffer(cred.id)
+            };
+          });
+        }
+
+        return publicKey;
+      }
+
+      function serializeCredential(cred) {
+        if (!cred) return {};
+        const resp = cred.response || {};
+        const serialized = {
+          ...cred,
+          id: cred.id,
+          rawId: bufferToBase64url(cred.rawId || cred.id),
+          type: cred.type || 'public-key',
+          clientExtensionResults: typeof cred.getClientExtensionResults === 'function'
+            ? cred.getClientExtensionResults()
+            : (cred.clientExtensionResults || {}),
+          response: {
+            ...(typeof resp === 'object' ? resp : {}),
+            clientDataJSON: bufferToBase64url(resp.clientDataJSON),
+            authenticatorData: bufferToBase64url(resp.authenticatorData),
+            signature: bufferToBase64url(resp.signature),
+            userHandle: resp.userHandle ? bufferToBase64url(resp.userHandle) : null
+          }
+        };
+        if (cred.authenticatorAttachment) {
+          serialized.authenticatorAttachment = cred.authenticatorAttachment;
+        }
+        return serialized;
+      }
+
+      function setStatus(message, isSuccess) {
+        if (!authStatus) return;
+        authStatus.textContent = message;
+        authStatus.classList.remove('success', 'error');
+        authStatus.classList.add(isSuccess ? 'success' : 'error');
+        authStatus.dataset.authenticated = isSuccess ? 'true' : 'false';
+      }
+
+      async function fetchLoginOptions() {
+        const res = await fetch('/api/login/options');
+        if (!res.ok) {
+          throw new Error('Failed to fetch login options');
+        }
+        const rawOptions = await res.json();
+        return preparePublicKeyOptions(rawOptions);
+      }
+
+      async function verifyCredential(credential) {
+        const payload = serializeCredential(credential);
+        const verifyRes = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify(payload)
+        });
+
+        let verifyData = null;
+        const text = await verifyRes.text();
+        if (text) {
+          try {
+            verifyData = JSON.parse(text);
+          } catch (e) {
+            verifyData = { message: text };
+          }
+        }
+
+        const isExplicitFailure = verifyData && (
+          verifyData.verified === false ||
+          verifyData.success === false ||
+          verifyData.authenticated === false
+        );
+
+        if (!verifyRes.ok || isExplicitFailure) {
+          const errMsg = (verifyData && (verifyData.error || verifyData.message)) || 'Authentication failed';
+          setStatus(errMsg, false);
+          return;
+        }
+
+        const userPart = (verifyData && (verifyData.username || (verifyData.user && verifyData.user.username)))
+          ? ' Welcome, ' + (verifyData.username || verifyData.user.username) + '!'
+          : '';
+        const customMessage = (verifyData && verifyData.message) ? verifyData.message + ' - ' : '';
+        setStatus(customMessage + 'Authenticated successfully! Passkey verified and signed in.' + userPart, true);
+      }
+
+      async function startConditionalAuth() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+        if (conditionalAbortController) {
+          return;
+        }
+
+        const controller = new AbortController();
+        conditionalAbortController = controller;
+
+        try {
+          if (
+            window.PublicKeyCredential &&
+            typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+          ) {
+            try {
+              await window.PublicKeyCredential.isConditionalMediationAvailable();
+            } catch (e) {
+              // Ignore check errors in headless/mock environments
+            }
+          }
+
+          const publicKey = await fetchLoginOptions();
+          const credential = await navigator.credentials.get({
+            publicKey: publicKey,
+            mediation: 'conditional',
+            signal: controller.signal
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (!err || err.name !== 'AbortError') {
+            // Conditional mediation failed or was dismissed
+          }
+        } finally {
+          if (conditionalAbortController === controller) {
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      async function startDirectBiometricAuth() {
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        try {
+          const publicKey = await fetchLoginOptions();
+          const credential = await navigator.credentials.get({
+            publicKey: publicKey
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          setStatus((err && err.message) || 'Passkey authentication failed', false);
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', function () {
+          startConditionalAuth();
+        });
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', function (event) {
+          event.preventDefault();
+          startDirectBiometricAuth();
+        });
+      }
+    })();
+  </script>
+
