+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7"
+      }
+    }
+  </script>
+  <script type="module">
+    try {
+      await import("webauthn-polyfills");
+    } catch {
+      // Polyfill import is optional when native capabilities are supported or offline
+    }
+
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    const signinForm = document.getElementById("signin-form");
+
+    let autofillAbortController = new AbortController();
+
+    async function optionsFetch() {
+      const response = await fetch("/api/login/options", {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          "Accept": "application/json",
+        },
+        credentials: "same-origin",
+      });
+      if (!response.ok) {
+        throw new Error(`Failed to fetch login options (${response.status})`);
+      }
+      return response.json();
+    }
+
+    async function loginVerifyFetch(encodedCredential) {
+      return fetch("/api/login/verify", {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          "Accept": "application/json",
+        },
+        credentials: "same-origin",
+        body: JSON.stringify(encodedCredential),
+      });
+    }
+
+    async function handleVerificationResponse(response, publicKey, encoded) {
+      if (response.ok) {
+        let data = null;
+        try {
+          data = await response.json();
+        } catch {
+          // Response may not be JSON
+        }
+        const message =
+          (data && (data.message || data.status || (data.user && `Welcome back, ${data.user}!`))) ||
+          "Authenticated successfully with passkey!";
+        authStatus.textContent = message;
+        return;
+      }
+
+      if (response.status === 404) {
+        authStatus.textContent = "Passkey not recognized. It may have been removed.";
+        if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId,
+            credentialId: encoded.id,
+          });
+        }
+        return;
+      }
+
+      authStatus.textContent = "Passkey verification failed. Please try again.";
+    }
+
+    async function initializeConditionalAutofill() {
+      if (
+        !window.PublicKeyCredential ||
+        typeof PublicKeyCredential.getClientCapabilities !== "function"
+      ) {
+        return;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalGet === true) {
+          const loginOptionsJSON = await optionsFetch();
+          const publicKey =
+            PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+          let credential;
+          try {
+            credential = await navigator.credentials.get({
+              publicKey,
+              signal: autofillAbortController.signal,
+              mediation: "conditional",
+            });
+          } catch (err) {
+            if (["NotAllowedError", "AbortError"].includes(err.name)) {
+              return;
+            }
+            console.error("Unexpected conditional get error:", err);
+            return;
+          }
+
+          if (!credential) {
+            return;
+          }
+
+          const encoded = credential.toJSON();
+          try {
+            const response = await loginVerifyFetch(encoded);
+            await handleVerificationResponse(response, publicKey, encoded);
+          } catch (serverErr) {
+            console.error("Verification request error:", serverErr);
+            authStatus.textContent = "Could not verify passkey with the server.";
+          }
+        }
+      } catch (err) {
+        console.error("Failed to initialize conditional autofill:", err);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let publicKey;
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        publicKey =
+          PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+      } catch (err) {
+        console.error("Failed to fetch passkey options:", err);
+        authStatus.textContent = "Unable to start passkey sign-in.";
+        initializeConditionalAutofill();
+        return;
+      }
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === "NotAllowedError") {
+          authStatus.textContent = "Passkey sign-in was cancelled.";
+        } else if (err.name === "AbortError") {
+          console.log("The authentication operation was aborted.");
+        } else {
+          console.error("Passkey authentication error:", err);
+          authStatus.textContent = "Passkey authentication failed.";
+        }
+        initializeConditionalAutofill();
+        return;
+      }
+
+      if (!credential) {
+        initializeConditionalAutofill();
+        return;
+      }
+
+      const encoded = credential.toJSON();
+      try {
+        const response = await loginVerifyFetch(encoded);
+        await handleVerificationResponse(response, publicKey, encoded);
+      } catch (serverErr) {
+        console.error("Verification request error:", serverErr);
+        authStatus.textContent = "Could not verify passkey with the server.";
+      }
+    }
+
+    if (authButton) {
+      authButton.addEventListener("click", triggerButtonAuthentication);
+    }
+
+    if (signinForm) {
+      signinForm.addEventListener("submit", (event) => {
+        event.preventDefault();
+      });
+    }
+
+    if (document.readyState === "loading") {
+      window.addEventListener("DOMContentLoaded", initializeConditionalAutofill);
+    } else {
+      initializeConditionalAutofill();
+    }
+  </script>
 </body>
 
 </html>
