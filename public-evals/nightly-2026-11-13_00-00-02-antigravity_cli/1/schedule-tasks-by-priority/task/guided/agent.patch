+  <script type="module">
+    // Feature-detect scheduler.postTask and conditionally load scheduler-polyfill if needed
+    if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+      try {
+        await import('scheduler-polyfill');
+      } catch {
+        // Fallback shim when offline/without external bundle so scheduler.postTask & TaskController work seamlessly
+        const priorityRank = { 'user-blocking': 0, 'user-visible': 1, 'background': 2 };
+        const pendingQueue = [];
+        let flushScheduled = false;
+
+        function flushQueue() {
+          flushScheduled = false;
+          pendingQueue.sort((a, b) => {
+            const pa = priorityRank[a.getPriority()] ?? 1;
+            const pb = priorityRank[b.getPriority()] ?? 1;
+            return pa !== pb ? pa - pb : a.seq - b.seq;
+          });
+          const next = pendingQueue.shift();
+          if (!next) return;
+          if (pendingQueue.length > 0) {
+            flushScheduled = true;
+            setTimeout(flushQueue, 0);
+          }
+          if (next.signal?.aborted) {
+            next.reject(new DOMException('Task aborted', 'AbortError'));
+            return;
+          }
+          Promise.resolve()
+            .then(() => next.callback())
+            .then(next.resolve, next.reject);
+        }
+
+        if (!('TaskController' in window)) {
+          window.TaskController = class TaskController extends AbortController {
+            constructor(init = {}) {
+              super();
+              this._priority = init.priority || 'user-visible';
+              this.signal.priority = this._priority;
+            }
+            setPriority(newPriority) {
+              this._priority = newPriority;
+              this.signal.priority = newPriority;
+            }
+          };
+        }
+
+        let seqCounter = 0;
+        window.scheduler = window.scheduler || {};
+        window.scheduler.postTask = function (callback, options = {}) {
+          return new Promise((resolve, reject) => {
+            if (options.signal?.aborted) {
+              reject(new DOMException('Task aborted', 'AbortError'));
+              return;
+            }
+            pendingQueue.push({
+              callback,
+              signal: options.signal,
+              seq: ++seqCounter,
+              getPriority: () => options.priority || options.signal?.priority || 'user-visible',
+              resolve,
+              reject,
+            });
+            if (!flushScheduled) {
+              flushScheduled = true;
+              setTimeout(flushQueue, 0);
+            }
+          });
+        };
+      }
+    }
+
+    // Yield helper using scheduler.yield() with setTimeout fallback
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        await scheduler.yield();
+      } else {
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+    }
+
+    const logList = document.getElementById('queue-log-list');
+    const emptyMsg = document.getElementById('empty-queue-msg');
+    const statQueued = document.getElementById('stat-queued');
+    const statCompleted = document.getElementById('stat-completed');
+    const statYields = document.getElementById('stat-yields');
+    const statOrder = document.getElementById('stat-order');
+    const activeIndicator = document.getElementById('active-task-indicator');
+    const schedulerStatus = document.getElementById('scheduler-status');
+
+    let taskIdCounter = 0;
+    let queuedCount = 0;
+    let completedCount = 0;
+    let totalYields = 0;
+    const executionOrder = [];
+    const activeControllers = new Map();
+
+    function updateStats() {
+      statQueued.textContent = String(queuedCount);
+      statCompleted.textContent = String(completedCount);
+      statYields.textContent = String(totalYields);
+      statOrder.textContent = executionOrder.length > 0 ? executionOrder.slice(-6).join(' → ') : '—';
+    }
+
+    // Heavy computation broken into <=50ms chunks using a deadline and scheduler.yield()
+    async function runChunkedWork(durationMs, onProgress, signal) {
+      const startTime = performance.now();
+      let elapsed = 0;
+      // Set a time-based deadline 50 milliseconds into the future (long task boundary)
+      let deadline = performance.now() + 50;
+
+      while (elapsed < durationMs) {
+        if (signal?.aborted) {
+          throw new DOMException('Task aborted', 'AbortError');
+        }
+
+        // Perform simulated synchronous unit of work (~5ms slice)
+        const sliceEnd = performance.now() + 5;
+        while (performance.now() < sliceEnd) {
+          // Simulated computation
+          Math.sqrt(Math.random() * 10000);
+        }
+
+        elapsed = performance.now() - startTime;
+        const pct = Math.min(100, Math.round((elapsed / durationMs) * 100));
+        onProgress(pct);
+
+        // MANDATORY: Yield to the main thread periodically when the 50ms deadline is exceeded
+        if (performance.now() >= deadline && elapsed < durationMs) {
+          totalYields++;
+          updateStats();
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+    }
+
+    function createLogRow(task) {
+      if (emptyMsg && emptyMsg.parentNode) {
+        emptyMsg.remove();
+      }
+      const li = document.createElement('li');
+      li.className = 'queue-item';
+      li.id = `task-row-${task.id}`;
+      li.dataset.priority = task.priority;
+
+      const left = document.createElement('div');
+      left.className = 'queue-item-left';
+
+      const idSpan = document.createElement('strong');
+      idSpan.textContent = `#${task.id}`;
+
+      const badge = document.createElement('span');
+      badge.className = `priority-tag tag-${task.priority}`;
+      badge.textContent = task.priority;
+
+      const nameSpan = document.createElement('span');
+      nameSpan.textContent = task.label;
+
+      left.append(idSpan, badge, nameSpan);
+
+      const right = document.createElement('div');
+      right.className = 'queue-item-right';
+
+      const progressSpan = document.createElement('span');
+      progressSpan.className = 'task-progress';
+      progressSpan.textContent = '0%';
+
+      const stateSpan = document.createElement('span');
+      stateSpan.className = 'task-state state-queued';
+      stateSpan.textContent = 'Queued';
+
+      right.append(progressSpan, stateSpan);
+      li.append(left, right);
+      logList.prepend(li);
+
+      return { li, progressSpan, stateSpan, badge };
+    }
+
+    function enqueueOperation({ label, shortCode, priority, durationMs }) {
+      const id = ++taskIdCounter;
+      queuedCount++;
+      updateStats();
+
+      // Use TaskController so queued tasks can be dynamically reprioritized or aborted
+      const controller = new TaskController({ priority });
+      activeControllers.set(id, controller);
+
+      const taskMeta = { id, label, shortCode, priority, durationMs };
+      const ui = createLogRow(taskMeta);
+
+      // Omit `priority` option when passing `controller.signal` so controller priority is authoritative
+      const taskPromise = scheduler.postTask(async () => {
+        queuedCount = Math.max(0, queuedCount - 1);
+        executionOrder.push(`${shortCode}#${id}`);
+        ui.stateSpan.className = 'task-state state-running';
+        ui.stateSpan.textContent = 'Running';
+        activeIndicator.textContent = `Running: ${label} (#${id})`;
+        schedulerStatus.textContent = `Processing ${priority} task...`;
+        updateStats();
+
+        const t0 = performance.now();
+        await runChunkedWork(
+          durationMs,
+          (pct) => {
+            ui.progressSpan.textContent = `${pct}%`;
+          },
+          controller.signal
+        );
+        const totalMs = Math.round(performance.now() - t0);
+
+        completedCount++;
+        ui.progressSpan.textContent = `${totalMs}ms`;
+        ui.stateSpan.className = 'task-state state-completed';
+        ui.stateSpan.textContent = 'Completed';
+        activeControllers.delete(id);
+
+        if (activeControllers.size === 0) {
+          activeIndicator.textContent = 'Idle';
+          schedulerStatus.textContent = 'Main Thread Responsive';
+        }
+        updateStats();
+      }, { signal: controller.signal });
+
+      taskPromise.catch((err) => {
+        activeControllers.delete(id);
+        if (err && err.name === 'AbortError') {
+          ui.stateSpan.className = 'task-state state-aborted';
+          ui.stateSpan.textContent = 'Cancelled';
+        } else {
+          ui.stateSpan.className = 'task-state state-aborted';
+          ui.stateSpan.textContent = 'Error';
+        }
+        if (activeControllers.size === 0) {
+          activeIndicator.textContent = 'Idle';
+          schedulerStatus.textContent = 'Main Thread Responsive';
+        }
+        updateStats();
+      });
+
+      return taskPromise;
+    }
+
+    // Button handlers for individual and batch tasks
+    document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+      enqueueOperation({
+        label: 'Urgent Checkout Payment & Receipt Validation',
+        shortCode: 'URGENT',
+        priority: 'user-blocking',
+        durationMs: 120,
+      });
+    });
+
+    document.getElementById('btn-standard-menu').addEventListener('click', () => {
+      enqueueOperation({
+        label: 'Standard Seasonal Menu & Inventory Sync',
+        shortCode: 'MENU',
+        priority: 'user-visible',
+        durationMs: 140,
+      });
+    });
+
+    document.getElementById('btn-bg-telemetry').addEventListener('click', () => {
+      enqueueOperation({
+        label: 'Background Telemetry & Bean Roast Analytics Logging',
+        shortCode: 'TELEM',
+        priority: 'background',
+        durationMs: 160,
+      });
+    });
+
+    document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+      // Enqueue mixed tasks in reverse urgency order within the same tick;
+      // scheduler.postTask executes them in priority order:
+      // user-blocking (Urgent Checkout) -> user-visible (Standard Menu) -> background (Telemetry)
+      enqueueOperation({
+        label: 'Batch: Background Telemetry Flush',
+        shortCode: 'TELEM',
+        priority: 'background',
+        durationMs: 150,
+      });
+      enqueueOperation({
+        label: 'Batch: Standard Menu Price Refresh',
+        shortCode: 'MENU',
+        priority: 'user-visible',
+        durationMs: 130,
+      });
+      enqueueOperation({
+        label: 'Batch: Urgent Express Checkout',
+        shortCode: 'URGENT',
+        priority: 'user-blocking',
+        durationMs: 110,
+      });
+      enqueueOperation({
+        label: 'Batch: Standard Loyalty Points Update',
+        shortCode: 'MENU',
+        priority: 'user-visible',
+        durationMs: 120,
+      });
+      enqueueOperation({
+        label: 'Batch: Urgent Barista POS Order Lock',
+        shortCode: 'URGENT',
+        priority: 'user-blocking',
+        durationMs: 100,
+      });
+    });
+
+    document.getElementById('btn-clear-queue').addEventListener('click', () => {
+      for (const [, controller] of activeControllers) {
+        controller.abort();
+      }
+      activeControllers.clear();
+      queuedCount = 0;
+      executionOrder.length = 0;
+      logList.replaceChildren();
+      if (emptyMsg) {
+        logList.appendChild(emptyMsg);
+      }
+      activeIndicator.textContent = 'Idle';
+      schedulerStatus.textContent = 'Main Thread Responsive';
+      updateStats();
+    });
+  </script>
