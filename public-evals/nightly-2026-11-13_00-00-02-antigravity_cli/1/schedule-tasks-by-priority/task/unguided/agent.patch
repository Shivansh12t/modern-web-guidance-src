+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      const TASK_CONFIGS = {
+        checkout: {
+          type: 'checkout',
+          label: 'Urgent Checkout Task',
+          description: 'Processing payment & order confirmation',
+          priority: 'user-blocking',
+          chunks: 3,
+          chunkDurationMs: 4
+        },
+        menu: {
+          type: 'menu',
+          label: 'Standard Menu Update',
+          description: 'Syncing seasonal drink inventory & pricing',
+          priority: 'user-visible',
+          chunks: 3,
+          chunkDurationMs: 4
+        },
+        telemetry: {
+          type: 'telemetry',
+          label: 'Background Telemetry Logging',
+          description: 'Flushing anonymized analytics & brew metrics',
+          priority: 'background',
+          chunks: 3,
+          chunkDurationMs: 4
+        }
+      };
+
+      let taskCounter = 0;
+      let queuedCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+
+      const logEl = document.getElementById('ops-log');
+      const queuedCountEl = document.getElementById('ops-queued-count');
+      const completedCountEl = document.getElementById('ops-completed-count');
+      const yieldCountEl = document.getElementById('ops-yield-count');
+      const lastActionEl = document.getElementById('ops-last-action');
+      const uiStatusTextEl = document.getElementById('ui-responsiveness-text');
+
+      // Fallback priority queue when scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackScheduled = false;
+
+      function updateCounters() {
+        queuedCountEl.textContent = String(queuedCount);
+        completedCountEl.textContent = String(completedCount);
+        yieldCountEl.textContent = String(yieldCount);
+      }
+
+      async function yieldToMain() {
+        yieldCount++;
+        updateCounters();
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+          return globalThis.scheduler.yield();
+        }
+        return Promise.resolve();
+      }
+
+      function scheduleWithPriority(callback, priority) {
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.postTask === 'function') {
+          return globalThis.scheduler.postTask(callback, { priority });
+        }
+
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            weight: PRIORITY_WEIGHTS[priority] ?? 1,
+            resolve,
+            reject
+          });
+          fallbackQueue.sort((a, b) => a.weight - b.weight);
+
+          if (!fallbackScheduled) {
+            fallbackScheduled = true;
+            setTimeout(async () => {
+              fallbackScheduled = false;
+              while (fallbackQueue.length > 0) {
+                const next = fallbackQueue.shift();
+                try {
+                  const res = await next.callback();
+                  next.resolve(res);
+                } catch (err) {
+                  next.reject(err);
+                }
+              }
+            }, 0);
+          }
+        });
+      }
+
+      function performChunkWork(durationMs) {
+        const start = performance.now();
+        while (performance.now() - start < durationMs) {
+          // Busy-wait chunk kept brief (<5ms) before yielding to keep UI responsive
+        }
+      }
+
+      function createLogItem(taskId, config) {
+        const emptyEl = document.getElementById('ops-log-empty');
+        if (emptyEl) {
+          emptyEl.remove();
+        }
+
+        const li = document.createElement('li');
+        li.className = `ops-log-item priority-${config.priority}`;
+        li.dataset.taskId = String(taskId);
+        li.dataset.taskType = config.type;
+        li.dataset.priority = config.priority;
+        li.dataset.status = 'running';
+
+        const left = document.createElement('div');
+        const badge = document.createElement('span');
+        badge.className = 'priority-badge';
+        badge.textContent = config.priority;
+
+        const title = document.createElement('strong');
+        title.className = 'task-title';
+        title.textContent = `${config.label} (#${taskId})`;
+
+        const desc = document.createElement('span');
+        desc.className = 'task-meta';
+        desc.textContent = ` — ${config.description}`;
+
+        left.appendChild(badge);
+        left.appendChild(title);
+        left.appendChild(desc);
+
+        const right = document.createElement('span');
+        right.className = 'task-meta task-status';
+        right.textContent = 'Running (Chunk 1/' + config.chunks + ')';
+
+        li.appendChild(left);
+        li.appendChild(right);
+        logEl.appendChild(li);
+
+        return { li, statusEl: right };
+      }
+
+      function enqueueOperation(typeKey) {
+        const config = TASK_CONFIGS[typeKey];
+        if (!config) return Promise.resolve();
+
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateCounters();
+        lastActionEl.textContent = `Queued: ${config.label} (${config.priority})`;
+
+        return scheduleWithPriority(async () => {
+          const startTime = performance.now();
+          uiStatusTextEl.textContent = `UI Status: Responsive — Yielding during ${config.label}`;
+          const { li, statusEl } = createLogItem(taskId, config);
+
+          for (let i = 1; i <= config.chunks; i++) {
+            statusEl.textContent = `Running (Chunk ${i}/${config.chunks})`;
+            performChunkWork(config.chunkDurationMs);
+            if (i < config.chunks) {
+              await yieldToMain();
+            }
+          }
+
+          const elapsed = Math.max(1, Math.round(performance.now() - startTime));
+          li.dataset.status = 'completed';
+          statusEl.textContent = `Completed (${elapsed}ms)`;
+
+          queuedCount = Math.max(0, queuedCount - 1);
+          completedCount++;
+          updateCounters();
+
+          if (queuedCount === 0) {
+            uiStatusTextEl.textContent = 'UI Status: Responsive (Task Yielding Active)';
+            lastActionEl.textContent = `Completed all tasks`;
+          }
+        }, config.priority);
+      }
+
+      function runBatchOperations() {
+        lastActionEl.textContent = 'Batch queued (Mixed priorities -> executing in priority order)';
+        // Queue mixed tasks starting with lowest priority so prioritization reorders them:
+        // user-blocking (Urgent Checkout) -> user-visible (Standard Menu Update) -> background (Background Telemetry)
+        enqueueOperation('telemetry');
+        enqueueOperation('menu');
+        enqueueOperation('checkout');
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        enqueueOperation('checkout');
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        enqueueOperation('menu');
+      });
+
+      document.getElementById('btn-telemetry').addEventListener('click', () => {
+        enqueueOperation('telemetry');
+      });
+
+      document.getElementById('btn-batch-tasks').addEventListener('click', () => {
+        runBatchOperations();
+      });
+
+      document.getElementById('btn-clear-log').addEventListener('click', () => {
+        logEl.innerHTML = '<li class="ops-log-empty" id="ops-log-empty">No operations executed yet. Trigger a task or batch above.</li>';
+        completedCount = 0;
+        yieldCount = 0;
+        updateCounters();
+        lastActionEl.textContent = 'Log cleared';
+      });
+    })();
+  </script>
 </body>
 
