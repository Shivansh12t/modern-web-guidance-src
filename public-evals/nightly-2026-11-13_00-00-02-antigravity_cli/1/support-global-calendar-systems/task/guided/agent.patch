+  <script>
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function resolveCalendarId(preferredId, fallbacks = []) {
+      if (isCalendarSupported(preferredId)) {
+        return preferredId;
+      }
+      for (const fallbackId of fallbacks) {
+        if (isCalendarSupported(fallbackId)) {
+          return fallbackId;
+        }
+      }
+      return preferredId;
+    }
+
+    function renderCalendarCard(cardEl, selectedIsoDate, todayIsoDate, preferredCalendarId, fallbacks = [], includeEra = false) {
+      const resolvedCalendarId = resolveCalendarId(preferredCalendarId, fallbacks);
+      const supported = isCalendarSupported(resolvedCalendarId);
+
+      const targetDate = supported
+        ? selectedIsoDate.withCalendar(resolvedCalendarId)
+        : selectedIsoDate;
+
+      const todayInCalendar = supported
+        ? todayIsoDate.withCalendar(targetDate.calendarId)
+        : todayIsoDate;
+
+      const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+      const relativeStatus = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      const formatOptions = {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric'
+      };
+      if (includeEra) {
+        formatOptions.era = 'long';
+      }
+
+      const localizedDisplay = targetDate.toLocaleString(
+        `en-u-ca-${targetDate.calendarId}`,
+        formatOptions
+      );
+
+      const timelineEl = cardEl.querySelector('[data-field="timeline"]');
+      if (timelineEl) {
+        timelineEl.textContent = relativeStatus;
+        timelineEl.setAttribute('data-status', relativeStatus);
+      }
+
+      const localizedEl = cardEl.querySelector('[data-field="localized-date"]');
+      if (localizedEl) {
+        localizedEl.textContent = localizedDisplay;
+      }
+
+      const yearEl = cardEl.querySelector('[data-field="year"]');
+      if (yearEl) {
+        yearEl.textContent = String(targetDate.year);
+      }
+
+      const monthEl = cardEl.querySelector('[data-field="month"]');
+      if (monthEl) {
+        monthEl.textContent = String(targetDate.month);
+      }
+
+      const monthCodeEl = cardEl.querySelector('[data-field="monthCode"]');
+      if (monthCodeEl) {
+        monthCodeEl.textContent = targetDate.monthCode;
+      }
+
+      const monthsInYearEl = cardEl.querySelector('[data-field="monthsInYear"]');
+      if (monthsInYearEl) {
+        monthsInYearEl.textContent = String(targetDate.monthsInYear);
+      }
+
+      const monthsListEl = cardEl.querySelector('[data-field="months-list"]');
+      if (monthsListEl) {
+        monthsListEl.innerHTML = '';
+        for (let m = 1; m <= targetDate.monthsInYear; m++) {
+          const monthDate = targetDate.with({ month: m, day: 1 });
+          const li = document.createElement('li');
+          if (monthDate.monthCode === targetDate.monthCode) {
+            li.classList.add('current-month');
+          }
+
+          const codeSpan = document.createElement('span');
+          codeSpan.textContent = `Month ${m} (${monthDate.monthCode})`;
+
+          const daysSpan = document.createElement('span');
+          daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+          li.append(codeSpan, daysSpan);
+          monthsListEl.appendChild(li);
+        }
+      }
+    }
+
+    function updateAllCalendars(isoString) {
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = Temporal.PlainDate.from(isoString);
+      } catch {
+        selectedIsoDate = Temporal.Now.plainDateISO();
+      }
+      const todayIsoDate = Temporal.Now.plainDateISO();
+
+      const islamicCard = document.getElementById('islamic-date');
+      const hebrewCard = document.getElementById('hebrew-date');
+      const japaneseCard = document.getElementById('japanese-date');
+
+      if (islamicCard) {
+        renderCalendarCard(
+          islamicCard,
+          selectedIsoDate,
+          todayIsoDate,
+          'islamic-umalqura',
+          ['islamic-civil', 'islamic'],
+          false
+        );
+      }
+      if (hebrewCard) {
+        renderCalendarCard(
+          hebrewCard,
+          selectedIsoDate,
+          todayIsoDate,
+          'hebrew',
+          [],
+          false
+        );
+      }
+      if (japaneseCard) {
+        renderCalendarCard(
+          japaneseCard,
+          selectedIsoDate,
+          todayIsoDate,
+          'japanese',
+          [],
+          true
+        );
+      }
+    }
+
+    function initializeCalendarConverter() {
+      const form = document.getElementById('calendar-converter-form');
+      const dateInput = document.getElementById('calendar-date-input');
+      if (!dateInput) return;
+
+      const todayIso = Temporal.Now.plainDateISO();
+      if (!dateInput.value) {
+        dateInput.value = todayIso.toString();
+      }
+
+      updateAllCalendars(dateInput.value);
+
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+        if (dateInput.value) {
+          updateAllCalendars(dateInput.value);
+        }
+      });
+
+      dateInput.addEventListener('change', () => {
+        if (dateInput.value) {
+          updateAllCalendars(dateInput.value);
+        }
+      });
+
+      if (form) {
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          if (dateInput.value) {
+            updateAllCalendars(dateInput.value);
+          }
+        });
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeCalendarConverter();
+    })();
+  </script>
 </body>
 
