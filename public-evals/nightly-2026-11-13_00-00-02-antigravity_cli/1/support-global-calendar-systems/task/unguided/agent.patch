+  <script>
+    (function () {
+      const picker = document.getElementById('calendar-date-picker');
+      const statusBanner = document.getElementById('date-relative-status');
+
+      const calendars = [
+        {
+          cardId: 'islamic-card',
+          dateElId: 'islamic-date',
+          calendarId: 'islamic-civil',
+          formatOptions: { calendar: 'islamic-civil', dateStyle: 'long' }
+        },
+        {
+          cardId: 'hebrew-card',
+          dateElId: 'hebrew-date',
+          calendarId: 'hebrew',
+          formatOptions: { calendar: 'hebrew', dateStyle: 'long' }
+        },
+        {
+          cardId: 'japanese-card',
+          dateElId: 'japanese-date',
+          calendarId: 'japanese',
+          formatOptions: { calendar: 'japanese', year: 'numeric', month: 'long', day: 'numeric', era: 'long' }
+        }
+      ];
+
+      function getTodayPlainDate() {
+        return Temporal.Now.plainDateISO();
+      }
+
+      function renderCalendars(isoDateString) {
+        if (!isoDateString) return;
+
+        let selectedDate;
+        try {
+          selectedDate = Temporal.PlainDate.from(isoDateString);
+        } catch (err) {
+          return;
+        }
+
+        const today = getTodayPlainDate();
+        const cmp = Temporal.PlainDate.compare(selectedDate, today);
+        const relativeStatus = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+        statusBanner.textContent = relativeStatus;
+        statusBanner.classList.toggle('today', relativeStatus === 'Today');
+
+        for (const cfg of calendars) {
+          const card = document.getElementById(cfg.cardId);
+          const dateEl = document.getElementById(cfg.dateElId);
+          if (!card || !dateEl) continue;
+
+          const converted = selectedDate.withCalendar(cfg.calendarId);
+          const localized = converted.toLocaleString('en-US', cfg.formatOptions);
+
+          dateEl.textContent = localized;
+
+          const cardStatus = card.querySelector('.card-status');
+          if (cardStatus) {
+            cardStatus.textContent = relativeStatus;
+            cardStatus.classList.toggle('today', relativeStatus === 'Today');
+          }
+
+          card.querySelector('.year-val').textContent = String(converted.year);
+          card.querySelector('.month-val').textContent = String(converted.month);
+          card.querySelector('.month-code-val').textContent = converted.monthCode;
+          card.querySelector('.months-in-year-val').textContent = String(converted.monthsInYear);
+
+          const monthsList = card.querySelector('.months-list');
+          monthsList.innerHTML = '';
+
+          for (let m = 1; m <= converted.monthsInYear; m++) {
+            const monthDate = converted.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            li.className = 'month-chip' + (m === converted.month ? ' active-month' : '');
+            li.innerHTML = `<span class="month-code">${monthDate.monthCode}</span> <span class="month-days">${monthDate.daysInMonth} days</span>`;
+            monthsList.appendChild(li);
+          }
+        }
+      }
+
+      const initialDate = getTodayPlainDate().toString();
+      picker.value = initialDate;
+      renderCalendars(initialDate);
+
+      picker.addEventListener('input', (e) => {
+        renderCalendars(e.target.value);
+      });
+      picker.addEventListener('change', (e) => {
+        renderCalendars(e.target.value);
+      });
+    })();
+  </script>
+
 </body>
 
