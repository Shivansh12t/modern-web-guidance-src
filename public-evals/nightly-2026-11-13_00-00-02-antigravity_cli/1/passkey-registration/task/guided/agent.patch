+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const statusMessage = document.getElementById('passkey-status');
+
+    function setStatus(message, isError = false) {
+      if (!statusMessage) return;
+      statusMessage.textContent = message;
+      statusMessage.style.color = isError ? '#b71c1c' : 'var(--primary)';
+      statusMessage.hidden = !message;
+    }
+
+    async function checkPasskeyCapabilities() {
+      if (
+        !window.PublicKeyCredential ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        if (registerButton) registerButton.disabled = true;
+        return;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (
+          !capabilities.passkeyPlatformAuthenticator ||
+          !capabilities.conditionalGet
+        ) {
+          if (registerButton) registerButton.disabled = true;
+        }
+      } catch (err) {
+        console.error('Failed to query WebAuthn client capabilities:', err);
+        if (registerButton) registerButton.disabled = true;
+      }
+    }
+
+    async function registerPasskey() {
+      setStatus('');
+
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ promotion: true }),
+      });
+
+      if (!optionsResponse.ok) {
+        setStatus('Unable to fetch passkey creation options.', true);
+        return;
+      }
+
+      const creationOptionsJSON = await optionsResponse.json();
+      const publicKey =
+        PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          setStatus('A passkey already exists for this account.', true);
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          setStatus('Configuration RP ID or Secure Context error.', true);
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+          setStatus('Passkey creation was cancelled.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+          setStatus('The passkey creation operation was aborted.');
+        } else {
+          console.error('Passkey creation failed:', err);
+          setStatus('Passkey creation failed.', true);
+        }
+        return;
+      }
+
+      const encodedResponse = credential.toJSON();
+      try {
+        const response = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!response.ok) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id,
+              credentialId: encodedResponse.id,
+            });
+          }
+          setStatus('Failed to verify passkey registration.', true);
+          return;
+        }
+
+        setStatus('Passkey created and verified successfully!');
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        }
+        setStatus('Network error while verifying passkey registration.', true);
+      }
+    }
+
+    checkPasskeyCapabilities();
+
+    if (registerButton) {
+      registerButton.addEventListener('click', () => {
+        registerPasskey();
+      });
+    }
+  </script>
