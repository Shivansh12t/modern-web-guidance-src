+  <script>
+    const sweetnessSlider = document.getElementById('sweetness-level');
+    const sweetnessOutput = document.getElementById('sweetness-output');
+    const orderForm = document.getElementById('coffee-order-form');
+    const orderStatus = document.getElementById('order-status');
+    const customerNameInput = document.getElementById('customer-name');
+
+    if (sweetnessSlider && sweetnessOutput) {
+      sweetnessSlider.addEventListener('input', (e) => {
+        const val = `${e.target.value}%`;
+        sweetnessOutput.textContent = val;
+        if (!CSS.supports('accent-color', '#4e342e')) {
+          e.target.style.setProperty('--progress', val);
+        }
+      });
+    }
+
+    if (customerNameInput) {
+      customerNameInput.addEventListener('invalid', () => {
+        customerNameInput.setCustomValidity('Please enter a name between 2 and 50 characters for your cup.');
+      });
+      customerNameInput.addEventListener('input', () => {
+        customerNameInput.setCustomValidity('');
+      });
+    }
+
+    if (orderForm) {
+      orderForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!orderForm.checkValidity()) {
+          const firstInvalid = orderForm.querySelector(':invalid');
+          if (firstInvalid) firstInvalid.focus();
+          return;
+        }
+        const formData = new FormData(orderForm);
+        const name = formData.get('customer_name');
+        const drinkSelect = document.getElementById('drink-base');
+        const drinkLabel = drinkSelect.options[drinkSelect.selectedIndex].text;
+        const pickupTime = formData.get('pickup_time');
+
+        if (orderStatus) {
+          orderStatus.hidden = false;
+          orderStatus.textContent = `Order confirmed for ${name}: ${drinkLabel} scheduled for pickup at ${pickupTime}.`;
+        }
+      });
+    }
+  </script>
