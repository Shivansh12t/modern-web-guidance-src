+  <script>
+    (function () {
+      const section = document.getElementById('craft-parallax');
+      if (!section) return;
+
+      const layers = Array.from(section.querySelectorAll('[data-parallax-speed]')).map((el) => ({
+        el,
+        speed: parseFloat(el.getAttribute('data-parallax-speed')) || 0
+      }));
+
+      const toggleBtn = document.getElementById('parallax-motion-toggle');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      let isPausedByUser = false;
+      let isIntersecting = true;
+      let rafId = null;
+
+      function isMotionDisabled() {
+        return reducedMotionQuery.matches || isPausedByUser;
+      }
+
+      function resetTransforms() {
+        for (let i = 0; i < layers.length; i++) {
+          layers[i].el.style.transform = 'translate3d(0, 0, 0)';
+        }
+      }
+
+      function updateParallax() {
+        rafId = null;
+        if (isMotionDisabled() || !isIntersecting) {
+          return;
+        }
+
+        const rect = section.getBoundingClientRect();
+        const viewportCenter = window.innerHeight / 2;
+        const sectionCenter = rect.top + rect.height / 2;
+        const deltaFromCenter = sectionCenter - viewportCenter;
+
+        for (let i = 0; i < layers.length; i++) {
+          const offset = Math.round(deltaFromCenter * layers[i].speed * 100) / 100;
+          layers[i].el.style.transform = 'translate3d(0, ' + offset + 'px, 0)';
+        }
+      }
+
+      function requestTick() {
+        if (rafId === null && !isMotionDisabled() && isIntersecting) {
+          rafId = window.requestAnimationFrame(updateParallax);
+        }
+      }
+
+      function syncControlState() {
+        if (!toggleBtn) return;
+        const disabled = isMotionDisabled();
+        toggleBtn.setAttribute('aria-pressed', String(disabled));
+        toggleBtn.textContent = disabled ? 'Enable Parallax Motion' : 'Pause Parallax Motion';
+        if (disabled) {
+          resetTransforms();
+        } else {
+          requestTick();
+        }
+      }
+
+      if (toggleBtn) {
+        toggleBtn.addEventListener('click', function () {
+          isPausedByUser = !isPausedByUser;
+          syncControlState();
+        });
+      }
+
+      if (typeof reducedMotionQuery.addEventListener === 'function') {
+        reducedMotionQuery.addEventListener('change', function (e) {
+          isPausedByUser = e.matches;
+          syncControlState();
+        });
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          function (entries) {
+            entries.forEach(function (entry) {
+              isIntersecting = entry.isIntersecting;
+              if (isIntersecting) {
+                requestTick();
+              }
+            });
+          },
+          { rootMargin: '100px 0px' }
+        );
+        observer.observe(section);
+      }
+
+      window.addEventListener('scroll', requestTick, { passive: true });
+      window.addEventListener('resize', requestTick, { passive: true });
+
+      isPausedByUser = reducedMotionQuery.matches;
+      syncControlState();
+    })();
+  </script>
+
