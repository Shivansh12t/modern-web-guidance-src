+    <p class="foreground-timer">Active viewing time: <span id="foreground-time">0s</span></p>
   </footer>
 
+  <script>
+    let accumulatedForegroundTime = 0;
+    let foregroundStartTime = document.visibilityState === 'visible' ? Date.now() : null;
+
+    function handleVisibilityChange() {
+      const now = Date.now();
+      if (document.visibilityState === 'hidden') {
+        if (foregroundStartTime !== null) {
+          accumulatedForegroundTime += now - foregroundStartTime;
+          foregroundStartTime = null;
+        }
+      } else if (document.visibilityState === 'visible') {
+        if (foregroundStartTime === null) {
+          foregroundStartTime = now;
+        }
+      }
+    }
+
+    /**
+     * Calculates the total time (in milliseconds) the page has spent in the foreground.
+     * @returns {number} Total foreground time in milliseconds.
+     */
+    function calculateTotalForegroundTime() {
+      let total = accumulatedForegroundTime;
+      if (foregroundStartTime !== null && document.visibilityState === 'visible') {
+        total += Date.now() - foregroundStartTime;
+      }
+      return total;
+    }
+
+    function formatForegroundTime(ms) {
+      const totalSeconds = Math.floor(ms / 1000);
+      const hours = Math.floor(totalSeconds / 3600);
+      const minutes = Math.floor((totalSeconds % 3600) / 60);
+      const seconds = totalSeconds % 60;
+
+      if (hours > 0) {
+        return `${hours}h ${minutes}m ${seconds}s`;
+      }
+      if (minutes > 0) {
+        return `${minutes}m ${seconds}s`;
+      }
+      return `${seconds}s`;
+    }
+
+    function resetForegroundTime() {
+      accumulatedForegroundTime = 0;
+      foregroundStartTime = document.visibilityState === 'visible' ? Date.now() : null;
+    }
+
+    function updateForegroundTimeDisplay() {
+      const displayEl = document.getElementById('foreground-time');
+      if (displayEl) {
+        displayEl.textContent = formatForegroundTime(calculateTotalForegroundTime());
+      }
+    }
+
+    document.addEventListener('visibilitychange', () => {
+      handleVisibilityChange();
+      updateForegroundTimeDisplay();
+    });
+
+    window.addEventListener('pagehide', () => {
+      if (foregroundStartTime !== null) {
+        accumulatedForegroundTime += Date.now() - foregroundStartTime;
+        foregroundStartTime = null;
+      }
+    });
+
+    setInterval(() => {
+      if (document.visibilityState === 'visible') {
+        updateForegroundTimeDisplay();
+      }
+    }, 1000);
+
+    window.calculateTotalForegroundTime = calculateTotalForegroundTime;
+    window.getTotalForegroundTime = calculateTotalForegroundTime;
+    window.getForegroundTime = calculateTotalForegroundTime;
+    window.formatForegroundTime = formatForegroundTime;
+    window.resetForegroundTime = resetForegroundTime;
+  </script>
+
