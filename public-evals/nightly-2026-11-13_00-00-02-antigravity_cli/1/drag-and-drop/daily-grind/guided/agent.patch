+
+        if (moveEarlier && index === 0) return;
+        if (!moveEarlier && index === cards.length - 1) return;
+
+        const referenceNode = moveEarlier
+          ? cards[index - 1]
+          : cards[index + 2] || null;
+
+        const oldRects = new Map();
+        for (const c of cards) {
+          oldRects.set(c, c.getBoundingClientRect());
+        }
+
+        moveNode(card, referenceNode);
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        handle.focus({ preventScroll: true });
+        animateFlip(oldRects, card, gen);
+
+        const updatedCards = getCards();
+        const newPos = updatedCards.indexOf(card) + 1;
+        announce(
+          `Moved ${getCardTitle(card)} ${directionLabel} to position ${newPos} of ${updatedCards.length}.`
+        );
+      }
+
+      // Pointer event listeners
+      list.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.isPrimary === false) return;
+        if (pointerDrag !== null) return;
+
+        const target = event.target;
+        if (!(target instanceof Element)) return;
+        const handle = target.closest('.drag-handle');
+        if (!handle || !list.contains(handle)) return;
+        const card = handle.closest('.card');
+        if (!card) return;
+
+        if (keyboardGrab) {
+          endKeyboardGrab(true);
+        }
+
+        event.preventDefault();
+        const gen = bumpGen(card);
+        card.getAnimations().forEach((anim) => anim.finish());
+        delete card.dataset.releasing;
+
+        const cards = getCards();
+        const startIndex = cards.indexOf(card);
+        const cardRect = card.getBoundingClientRect();
+
+        pointerDrag = {
+          card,
+          handle,
+          pointerId: event.pointerId,
+          startX: event.clientX,
+          startY: event.clientY,
+          lastX: event.clientX,
+          lastY: event.clientY,
+          startScrollLeft: list.scrollLeft,
+          startScrollTop: list.scrollTop,
+          cardWidth: cardRect.width,
+          startIndex,
+          referenceNode: card.nextElementSibling,
+          rafId: null,
+          gen
+        };
+
+        card.dataset.dragging = 'true';
+        document.documentElement.classList.add('is-dragging');
+
+        if (typeof handle.setPointerCapture === 'function') {
+          try {
+            handle.setPointerCapture(event.pointerId);
+          } catch {
+            // Ignore in synthetic environments where pointerId is not active
+          }
+        }
+
+        startAutoScrollLoop();
+      });
+
+      document.addEventListener('pointermove', (event) => {
+        if (!pointerDrag || event.pointerId !== pointerDrag.pointerId) return;
+        pointerDrag.lastX = event.clientX;
+        pointerDrag.lastY = event.clientY;
+        updatePointerDragPosition();
+        updatePointerDropSpot();
+      });
+
+      document.addEventListener('pointerup', (event) => {
+        if (!pointerDrag || event.pointerId !== pointerDrag.pointerId) return;
+        finishPointerDrag(true);
+      });
+
+      document.addEventListener('pointercancel', (event) => {
+        if (!pointerDrag || event.pointerId !== pointerDrag.pointerId) return;
+        finishPointerDrag(false);
+      });
+
+      list.addEventListener('lostpointercapture', (event) => {
+        if (!pointerDrag || event.pointerId !== pointerDrag.pointerId) return;
+        if (isMovingDOM) return;
+        finishPointerDrag(true);
+      });
+
+      // Keyboard events
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && pointerDrag) {
+          event.preventDefault();
+          finishPointerDrag(false);
+          return;
+        }
+      });
+
+      list.addEventListener('keydown', (event) => {
+        const target = event.target;
+        if (!(target instanceof Element)) return;
+        const handle = target.closest('.drag-handle');
+        if (!handle || !list.contains(handle)) return;
+        const card = handle.closest('.card');
+        if (!card) return;
+
+        if (event.key === ' ' || event.key === 'Enter') {
+          event.preventDefault();
+          if (keyboardGrab && keyboardGrab.card === card) {
+            endKeyboardGrab(true);
+          } else {
+            startKeyboardGrab(card, handle);
+          }
+          return;
+        }
+
+        if (!keyboardGrab || keyboardGrab.card !== card) return;
+
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          endKeyboardGrab(false);
+        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+          event.preventDefault();
+          moveKeyboardGrab(event.key);
+        } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
+          // Ignore perpendicular axis keys while grabbed in a horizontal row
+          event.preventDefault();
+        }
+      });
+
+      list.addEventListener('focusout', (event) => {
+        if (isMovingDOM || !keyboardGrab) return;
+        if (event.target === keyboardGrab.handle) {
+          endKeyboardGrab(true);
+        }
+      });
+
+      // Reveal whole item when keyboard focus enters an item
+      list.addEventListener('focusin', (event) => {
+        const target = event.target;
+        if (!(target instanceof Element) || !target.matches(':focus-visible')) return;
+        const card = target.closest('.card');
+        if (!card || card.getAnimations().length > 0) return;
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      });
+    })();
+  </script>
 </body>
 
