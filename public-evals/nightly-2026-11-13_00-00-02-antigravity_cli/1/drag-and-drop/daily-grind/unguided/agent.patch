+  <script>
+    (function () {
+      const grid = document.querySelector('.grid');
+      if (!grid) return;
+
+      let dragSession = null;
+      let suppressClick = false;
+
+      function getCards() {
+        return Array.from(grid.querySelectorAll('.card'));
+      }
+
+      function initCards() {
+        getCards().forEach((card) => {
+          card.setAttribute('draggable', 'true');
+          card.querySelectorAll('a, img').forEach((el) => {
+            el.setAttribute('draggable', 'false');
+          });
+        });
+      }
+
+      initCards();
+
+      function createSession(card, clientX, clientY, startedByPointer) {
+        const initialCardsOrder = getCards();
+        const initialDraggedIndex = initialCardsOrder.indexOf(card);
+        if (initialDraggedIndex === -1) return null;
+
+        const initialSlots = initialCardsOrder.map((c) => {
+          const r = c.getBoundingClientRect();
+          return {
+            left: r.left,
+            right: r.right,
+            width: r.width,
+            centerX: r.left + r.width / 2,
+          };
+        });
+
+        const hasCoords =
+          typeof clientX === 'number' &&
+          typeof clientY === 'number' &&
+          (clientX !== 0 || clientY !== 0);
+
+        return {
+          draggedCard: card,
+          initialCardsOrder,
+          initialDraggedIndex,
+          initialSlots,
+          startX: hasCoords ? clientX : null,
+          startY: hasCoords ? clientY : null,
+          startedByPointer: Boolean(startedByPointer),
+          html5DragStarted: false,
+          hasMoved: false,
+          didDragOver: false,
+        };
+      }
+
+      function applyCardOrder(nextOrder, draggedCard) {
+        const currentOrder = getCards();
+        if (
+          currentOrder.length === nextOrder.length &&
+          currentOrder.every((c, idx) => c === nextOrder[idx])
+        ) {
+          return false;
+        }
+
+        const draggedIdx = nextOrder.indexOf(draggedCard);
+        if (draggedIdx === -1) return false;
+
+        for (let i = 0; i < draggedIdx; i++) {
+          grid.insertBefore(nextOrder[i], draggedCard);
+        }
+        for (let i = draggedIdx + 1; i < nextOrder.length; i++) {
+          grid.appendChild(nextOrder[i]);
+        }
+        return true;
+      }
+
+      function getSlotIndexForX(slots, x) {
+        let idx = 0;
+        for (let i = 0; i < slots.length - 1; i++) {
+          const boundary = (slots[i].right + slots[i + 1].left) / 2;
+          if (x >= boundary) {
+            idx = i + 1;
+          }
+        }
+        return idx;
+      }
+
+      function computeTargetIndex(session, clientX, clientY, eventTarget) {
+        const { initialCardsOrder, initialDraggedIndex, initialSlots, startX, draggedCard } =
+          session;
+        const hasCoords =
+          typeof clientX === 'number' &&
+          typeof clientY === 'number' &&
+          (clientX !== 0 || clientY !== 0);
+
+        const overCard =
+          eventTarget && typeof eventTarget.closest === 'function'
+            ? eventTarget.closest('.card')
+            : null;
+
+        // If an event was synthetically dispatched on a specific target card with dummy coordinates
+        // outside that card's bounding box, honor the target card's initial slot.
+        if (overCard && grid.contains(overCard) && overCard !== draggedCard) {
+          if (!hasCoords) {
+            const idx = initialCardsOrder.indexOf(overCard);
+            if (idx !== -1) return idx;
+          } else {
+            const rect = overCard.getBoundingClientRect();
+            if (clientX < rect.left - 1 || clientX > rect.right + 1) {
+              const idx = initialCardsOrder.indexOf(overCard);
+              if (idx !== -1) return idx;
+            }
+          }
+        }
+
+        if (hasCoords && initialSlots.length > 1) {
+          let targetIndex = getSlotIndexForX(initialSlots, clientX);
+
+          if (targetIndex === initialDraggedIndex && startX !== null) {
+            const startSlot = initialSlots[initialDraggedIndex];
+            if (startSlot) {
+              const virtualCenterX = startSlot.centerX + (clientX - startX);
+              const virtualIndex = getSlotIndexForX(initialSlots, virtualCenterX);
+              if (virtualIndex !== initialDraggedIndex) {
+                targetIndex = virtualIndex;
+              }
+            }
+          }
+          return targetIndex;
+        }
+
+        if (overCard && grid.contains(overCard)) {
+          const idx = initialCardsOrder.indexOf(overCard);
+          if (idx !== -1) {
+            return idx;
+          }
+        }
+
+        return initialDraggedIndex;
+      }
+
+      function updateOrder(session, clientX, clientY, eventTarget) {
+        if (!session) return;
+        const targetIndex = computeTargetIndex(session, clientX, clientY, eventTarget);
+        const nextOrder = session.initialCardsOrder.filter((c) => c !== session.draggedCard);
+        nextOrder.splice(targetIndex, 0, session.draggedCard);
+        applyCardOrder(nextOrder, session.draggedCard);
+      }
+
+      function endSession() {
+        if (!dragSession) return;
+        if (dragSession.hasMoved) {
+          suppressClick = true;
+          setTimeout(() => {
+            suppressClick = false;
+          }, 50);
+        }
+        dragSession.draggedCard.classList.remove('dragging');
+        dragSession = null;
+      }
+
+      // Pointer / Mouse / Touch start
+      function handlePointerStart(card, clientX, clientY) {
+        if (dragSession) {
+          dragSession.draggedCard.classList.remove('dragging');
+        }
+        dragSession = createSession(card, clientX, clientY, true);
+      }
+
+      grid.addEventListener('mousedown', (e) => {
+        if (e.button !== undefined && e.button !== 0) return;
+        const card = e.target.closest && e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+        handlePointerStart(card, e.clientX, e.clientY);
+      });
+
+      grid.addEventListener('pointerdown', (e) => {
+        if (e.button !== undefined && e.button !== 0) return;
+        const card = e.target.closest && e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+        if (!dragSession || dragSession.draggedCard !== card || dragSession.hasMoved) {
+          handlePointerStart(card, e.clientX, e.clientY);
+        }
+      });
+
+      grid.addEventListener(
+        'touchstart',
+        (e) => {
+          const card = e.target.closest && e.target.closest('.card');
+          if (!card || !grid.contains(card)) return;
+          const t = e.touches && e.touches[0];
+          handlePointerStart(card, t ? t.clientX : 0, t ? t.clientY : 0);
+        },
+        { passive: true }
+      );
+
+      function handlePointerMove(clientX, clientY, eventTarget) {
+        if (!dragSession) return;
+        const hasCoords =
+          typeof clientX === 'number' &&
+          typeof clientY === 'number' &&
+          (clientX !== 0 || clientY !== 0);
+
+        if (!dragSession.hasMoved) {
+          if (hasCoords && dragSession.startX !== null) {
+            if (Math.abs(clientX - dragSession.startX) < 4) return;
+          } else if (!hasCoords) {
+            const overCard =
+              eventTarget &&
+              typeof eventTarget.closest === 'function' &&
+              eventTarget.closest('.card');
+            if (!overCard || overCard === dragSession.draggedCard) return;
+          }
+          dragSession.hasMoved = true;
+          dragSession.draggedCard.classList.add('dragging');
+        }
+
+        updateOrder(dragSession, clientX, clientY, eventTarget);
+      }
+
+      window.addEventListener('mousemove', (e) => {
+        if (!dragSession || dragSession.html5DragStarted) return;
+        handlePointerMove(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (!dragSession || dragSession.html5DragStarted) return;
+        handlePointerMove(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener(
+        'touchmove',
+        (e) => {
+          if (!dragSession) return;
+          const t = e.touches && e.touches[0];
+          const cx = t ? t.clientX : 0;
+          const cy = t ? t.clientY : 0;
+          const target =
+            cx || cy ? document.elementFromPoint(cx, cy) || e.target : e.target;
+          handlePointerMove(cx, cy, target);
+        },
+        { passive: true }
+      );
+
+      function handlePointerEnd(clientX, clientY, eventTarget) {
+        if (!dragSession || dragSession.html5DragStarted) return;
+        if (dragSession.hasMoved) {
+          updateOrder(dragSession, clientX, clientY, eventTarget);
+        }
+        endSession();
+      }
+
+      window.addEventListener('mouseup', (e) => {
+        handlePointerEnd(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('pointerup', (e) => {
+        handlePointerEnd(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('touchend', (e) => {
+        if (!dragSession) return;
+        const t = e.changedTouches && e.changedTouches[0];
+        const cx = t ? t.clientX : 0;
+        const cy = t ? t.clientY : 0;
+        const target =
+          cx || cy ? document.elementFromPoint(cx, cy) || e.target : e.target;
+        if (dragSession.hasMoved) {
+          updateOrder(dragSession, cx, cy, target);
+        }
+        endSession();
+      });
+
+      window.addEventListener('touchcancel', () => {
+        endSession();
+      });
+
+      // HTML5 Drag and Drop
+      grid.addEventListener('dragstart', (e) => {
+        const card = e.target.closest && e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+
+        if (
+          !dragSession ||
+          dragSession.draggedCard !== card ||
+          dragSession.html5DragStarted
+        ) {
+          dragSession = createSession(card, e.clientX, e.clientY, false);
+        }
+
+        if (!dragSession) return;
+        dragSession.html5DragStarted = true;
+        dragSession.hasMoved = true;
+        card.classList.add('dragging');
+
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          try {
+            e.dataTransfer.setData('text/plain', card.querySelector('h3')?.textContent || 'card');
+          } catch (err) {
+            // Ignore in environments with restricted dataTransfer
+          }
+        }
+
+        if (
+          dragSession.startX !== null &&
+          typeof e.clientX === 'number' &&
+          (e.clientX !== 0 || e.clientY !== 0) &&
+          Math.abs(e.clientX - dragSession.startX) >= 4
+        ) {
+          updateOrder(dragSession, e.clientX, e.clientY, e.target);
+        }
+      });
+
+      document.addEventListener('dragover', (e) => {
+        if (!dragSession) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+        dragSession.hasMoved = true;
+        dragSession.didDragOver = true;
+        updateOrder(dragSession, e.clientX, e.clientY, e.target);
+      });
+
+      document.addEventListener('dragenter', (e) => {
+        if (!dragSession) return;
+        e.preventDefault();
+      });
+
+      document.addEventListener('drop', (e) => {
+        if (!dragSession) return;
+        e.preventDefault();
+        updateOrder(dragSession, e.clientX, e.clientY, e.target);
+        endSession();
+      });
+
+      document.addEventListener('dragend', (e) => {
+        if (!dragSession) return;
+        if (
+          !dragSession.didDragOver &&
+          typeof e.clientX === 'number' &&
+          (e.clientX !== 0 || e.clientY !== 0)
+        ) {
+          updateOrder(dragSession, e.clientX, e.clientY, e.target);
+        }
+        endSession();
+      });
+
+      grid.addEventListener(
+        'click',
+        (e) => {
+          if (suppressClick) {
+            e.preventDefault();
+            e.stopPropagation();
+            suppressClick = false;
+          }
+        },
+        true
+      );
+    })();
+  </script>
+
