@@ -0,0 +1,208 @@
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'ar', label: 'Arabic' },
+  { code: 'bg', label: 'Bulgarian' },
+  { code: 'bn', label: 'Bengali' },
+  { code: 'cs', label: 'Czech' },
+  { code: 'da', label: 'Danish' },
+  { code: 'de', label: 'German' },
+  { code: 'el', label: 'Greek' },
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Spanish' },
+  { code: 'fi', label: 'Finnish' },
+  { code: 'fr', label: 'French' },
+  { code: 'he', label: 'Hebrew' },
+  { code: 'hi', label: 'Hindi' },
+  { code: 'hr', label: 'Croatian' },
+  { code: 'hu', label: 'Hungarian' },
+  { code: 'id', label: 'Indonesian' },
+  { code: 'it', label: 'Italian' },
+  { code: 'ja', label: 'Japanese' },
+  { code: 'kn', label: 'Kannada' },
+  { code: 'ko', label: 'Korean' },
+  { code: 'lt', label: 'Lithuanian' },
+  { code: 'mr', label: 'Marathi' },
+  { code: 'nl', label: 'Dutch' },
+  { code: 'no', label: 'Norwegian' },
+  { code: 'pl', label: 'Polish' },
+  { code: 'pt', label: 'Portuguese' },
+  { code: 'ro', label: 'Romanian' },
+  { code: 'ru', label: 'Russian' },
+  { code: 'sk', label: 'Slovak' },
+  { code: 'sl', label: 'Slovenian' },
+  { code: 'sv', label: 'Swedish' },
+  { code: 'ta', label: 'Tamil' },
+  { code: 'te', label: 'Telugu' },
+  { code: 'th', label: 'Thai' },
+  { code: 'tr', label: 'Turkish' },
+  { code: 'uk', label: 'Ukrainian' },
+  { code: 'vi', label: 'Vietnamese' },
+  { code: 'zh', label: 'Chinese' },
+  { code: 'zh-Hant', label: 'Chinese (Traditional)' },
+];
+
+export type AvailabilityStatus = 'available' | 'downloadable' | 'downloading' | 'unavailable' | 'unsupported';
+
+const translatorCache = new Map<string, TranslatorInstance>();
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && typeof self.Translator !== 'undefined';
+}
+
+export async function checkTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<AvailabilityStatus> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    return 'unsupported';
+  }
+  if (sourceLanguage === targetLanguage) {
+    return 'available';
+  }
+  const options: TranslatorAvailabilityOptions = {
+    sourceLanguage,
+    targetLanguage,
+  };
+  try {
+    return await self.Translator.availability(options);
+  } catch {
+    return 'unavailable';
+  }
+}
+
+export async function getOrCreateTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onDownloadProgress?: (percent: number) => void
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    throw new Error('Client-side translation is currently unsupported in this browser.');
+  }
+
+  const cacheKey = `${sourceLanguage}->${targetLanguage}`;
+  const cached = translatorCache.get(cacheKey);
+  if (cached) {
+    return cached;
+  }
+
+  const options: TranslatorAvailabilityOptions = {
+    sourceLanguage,
+    targetLanguage,
+  };
+
+  const availability = await self.Translator.availability(options);
+  if (availability === 'unavailable') {
+    throw new Error(`Translation between ${sourceLanguage} and ${targetLanguage} is unavailable on this device.`);
+  }
+
+  const translator = await self.Translator.create({
+    ...options,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        const pct = Math.round((e.loaded ?? 0) * 100);
+        onDownloadProgress?.(pct);
+      });
+    },
+  });
+
+  translatorCache.set(cacheKey, translator);
+  return translator;
+}
+
+const originalTextMap = new WeakMap<Text, string>();
+const currentTextLanguageMap = new WeakMap<Text, string>();
+
+const SKIP_TAGS = new Set(['SCRIPT', 'STYLE', 'CODE', 'PRE', 'NOSCRIPT', 'SVG', 'TEXTAREA', 'INPUT', 'SELECT']);
+
+function collectTranslatableTextNodes(root: Element): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const text = node.nodeValue?.trim();
+      if (!text) return NodeFilter.FILTER_REJECT;
+      let parent = node.parentElement;
+      while (parent && parent !== root) {
+        if (
+          SKIP_TAGS.has(parent.tagName) ||
+          parent.hasAttribute('data-no-translate') ||
+          parent.getAttribute('translate') === 'no'
+        ) {
+          return NodeFilter.FILTER_REJECT;
+        }
+        parent = parent.parentElement;
+      }
+      if (
+        root.hasAttribute('data-no-translate') ||
+        root.getAttribute('translate') === 'no' ||
+        SKIP_TAGS.has(root.tagName)
+      ) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+
+  let current = walker.nextNode();
+  while (current) {
+    nodes.push(current as Text);
+    current = walker.nextNode();
+  }
+  return nodes;
+}
+
+export async function translateElementContent(
+  element: Element,
+  translator: TranslatorInstance,
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<void> {
+  const textNodes = collectTranslatableTextNodes(element);
+  for (const textNode of textNodes) {
+    const rawValue = textNode.nodeValue ?? '';
+    if (!originalTextMap.has(textNode)) {
+      originalTextMap.set(textNode, rawValue);
+    }
+
+    const currentLang = currentTextLanguageMap.get(textNode) || 'en';
+    if (currentLang === targetLanguage) {
+      continue;
+    }
+
+    // Use the current text if it matches sourceLanguage, or fall back to original text if source is 'en'
+    const baseText =
+      sourceLanguage === 'en'
+        ? originalTextMap.get(textNode) ?? rawValue
+        : rawValue;
+
+    const leadingMatch = baseText.match(/^\s*/);
+    const trailingMatch = baseText.match(/\s*$/);
+    const leadingWhitespace = leadingMatch ? leadingMatch[0] : '';
+    const trailingWhitespace = trailingMatch ? trailingMatch[0] : '';
+    const trimmed = baseText.trim();
+
+    if (!trimmed) continue;
+
+    const translated = await translator.translate(trimmed);
+    textNode.nodeValue = `${leadingWhitespace}${translated}${trailingWhitespace}`;
+    currentTextLanguageMap.set(textNode, targetLanguage);
+  }
+  element.setAttribute('lang', targetLanguage);
+  element.setAttribute('data-translated-lang', targetLanguage);
+}
+
+export function restoreElementOriginalContent(element: Element): void {
+  const textNodes = collectTranslatableTextNodes(element);
+  for (const textNode of textNodes) {
+    const original = originalTextMap.get(textNode);
+    if (original !== undefined) {
+      textNode.nodeValue = original;
+      currentTextLanguageMap.set(textNode, 'en');
+    }
+  }
+  element.setAttribute('lang', 'en');
+  element.removeAttribute('data-translated-lang');
+}
