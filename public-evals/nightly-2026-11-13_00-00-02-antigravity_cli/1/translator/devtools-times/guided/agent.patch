diff --git a/src/components/ArticleTranslateControl.tsx b/src/components/ArticleTranslateControl.tsx
new file mode 100644
index 0000000..b704542
--- /dev/null
+++ b/src/components/ArticleTranslateControl.tsx
@@ -0,0 +1,328 @@
+import React, { useState, useEffect, useId, useRef } from 'react';
+import { LanguageIcon, ArrowPathIcon, ArrowsRightLeftIcon } from '@heroicons/react/24/outline';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  checkTranslationAvailability,
+  getOrCreateTranslator,
+  translateElementContent,
+  restoreElementOriginalContent,
+  type AvailabilityStatus,
+} from '../utils/translator';
+
+export interface ArticleTranslateControlProps {
+  /**
+   * Optional CSS selector to scope translation to a specific container
+   * (e.g. '#article-content-root'). If omitted, translates the closest
+   * `[data-translatable-scope]` ancestor, or all `[data-translatable]` elements on the page.
+   */
+  scopeSelector?: string;
+  /**
+   * Compact mode for inline placement on article teasers or headers.
+   */
+  compact?: boolean;
+  /**
+   * Default source language (BCP 47 code). Defaults to 'en'.
+   */
+  defaultSourceLanguage?: string;
+  /**
+   * Default target language (BCP 47 code). Defaults to 'es'.
+   */
+  defaultTargetLanguage?: string;
+  /**
+   * Label shown for the control.
+   */
+  label?: string;
+}
+
+export default function ArticleTranslateControl({
+  scopeSelector,
+  compact = false,
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+  label = 'Translate on-device',
+}: ArticleTranslateControlProps) {
+  const uid = useId();
+  const rootRef = useRef<HTMLDivElement>(null);
+
+  const [supported, setSupported] = useState<boolean>(true);
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>(defaultTargetLanguage);
+  const [availability, setAvailability] = useState<AvailabilityStatus>('available');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [activeLanguage, setActiveLanguage] = useState<string>('en');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [isExpanded, setIsExpanded] = useState<boolean>(!compact);
+
+  useEffect(() => {
+    const apiSupported = isTranslatorSupported();
+    setSupported(apiSupported);
+    if (!apiSupported) {
+      setAvailability('unsupported');
+    }
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+    if (!supported) return;
+
+    setErrorMessage(null);
+    checkTranslationAvailability(sourceLanguage, targetLanguage).then((status) => {
+      if (!cancelled) {
+        setAvailability(status);
+      }
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [supported, sourceLanguage, targetLanguage]);
+
+  const getTargetElements = (): Element[] => {
+    if (scopeSelector) {
+      const scoped = document.querySelectorAll(scopeSelector);
+      if (scoped.length > 0) {
+        return Array.from(scoped);
+      }
+    }
+    if (rootRef.current) {
+      const closestScope = rootRef.current.closest('[data-translatable-scope]');
+      if (closestScope) {
+        const innerTargets = closestScope.querySelectorAll('[data-translatable]');
+        return innerTargets.length > 0 ? Array.from(innerTargets) : [closestScope];
+      }
+    }
+    return Array.from(document.querySelectorAll('[data-translatable]'));
+  };
+
+  const handleTranslate = async () => {
+    setErrorMessage(null);
+    const elements = getTargetElements();
+    if (elements.length === 0) return;
+
+    if (targetLanguage === 'en' && sourceLanguage === 'en') {
+      elements.forEach((el) => restoreElementOriginalContent(el));
+      setActiveLanguage('en');
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      setErrorMessage('Please select different source and target languages.');
+      return;
+    }
+
+    setIsTranslating(true);
+    setDownloadProgress(null);
+
+    try {
+      const translator = await getOrCreateTranslator(
+        sourceLanguage,
+        targetLanguage,
+        (pct) => setDownloadProgress(pct)
+      );
+      setDownloadProgress(null);
+
+      for (const el of elements) {
+        await translateElementContent(el, translator, sourceLanguage, targetLanguage);
+      }
+      setActiveLanguage(targetLanguage);
+      setAvailability('available');
+    } catch (err: any) {
+      setErrorMessage(
+        err?.message || 'Unable to translate content using the on-device Translator API.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    setErrorMessage(null);
+    const elements = getTargetElements();
+    elements.forEach((el) => restoreElementOriginalContent(el));
+    setSourceLanguage('en');
+    setActiveLanguage('en');
+  };
+
+  const handleSwapLanguages = () => {
+    if (sourceLanguage === targetLanguage) return;
+    const prevSource = sourceLanguage;
+    const prevTarget = targetLanguage;
+    setSourceLanguage(prevTarget);
+    setTargetLanguage(prevSource);
+  };
+
+  if (compact && !isExpanded) {
+    return (
+      <div ref={rootRef} data-no-translate="true" translate="no" className="inline-flex items-center">
+        <button
+          type="button"
+          onClick={() => setIsExpanded(true)}
+          className="inline-flex items-center gap-1 text-xs font-medium text-gray-600 hover:text-amber-700 bg-gray-100 hover:bg-amber-50 px-2 py-1 rounded transition-colors"
+          title={
+            supported
+              ? 'Translate this teaser on-device'
+              : 'Client-side translation is currently unsupported in this browser'
+          }
+        >
+          <LanguageIcon className="w-3.5 h-3.5" />
+          <span>{activeLanguage !== 'en' ? `Translated (${activeLanguage.toUpperCase()})` : 'Translate'}</span>
+        </button>
+      </div>
+    );
+  }
+
+  const isDisabled =
+    !supported ||
+    availability === 'unavailable' ||
+    isTranslating ||
+    sourceLanguage === targetLanguage;
+
+  return (
+    <div
+      ref={rootRef}
+      data-no-translate="true"
+      translate="no"
+      className={
+        compact
+          ? 'mt-2 p-2.5 bg-gray-50 border border-gray-200 rounded-md text-xs space-y-2'
+          : 'my-4 p-3.5 bg-amber-50/50 border border-amber-200/80 rounded-lg text-sm'
+      }
+    >
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <div className="flex items-center gap-1.5 font-semibold text-gray-800">
+          <LanguageIcon className={compact ? 'w-4 h-4 text-amber-700' : 'w-5 h-5 text-amber-700'} />
+          <span>{label}</span>
+          {activeLanguage !== 'en' && (
+            <span className="ml-1 px-1.5 py-0.5 text-[11px] font-medium bg-amber-100 text-amber-900 rounded">
+              {SUPPORTED_LANGUAGES.find((l) => l.code === activeLanguage)?.label ?? activeLanguage}
+            </span>
+          )}
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="flex items-center gap-1">
+            <label htmlFor={`${uid}-source`} className="sr-only">
+              Source language
+            </label>
+            <select
+              id={`${uid}-source`}
+              value={sourceLanguage}
+              onChange={(e) => setSourceLanguage(e.target.value)}
+              disabled={!supported || isTranslating}
+              aria-label="Source language"
+              className="bg-white border border-gray-300 text-gray-800 rounded px-2 py-1 text-xs focus:ring-2 focus:ring-amber-400 focus:outline-none disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.label} ({lang.code})
+                </option>
+              ))}
+            </select>
+
+            <button
+              type="button"
+              onClick={handleSwapLanguages}
+              disabled={!supported || isTranslating}
+              aria-label="Swap languages"
+              title="Swap source and target languages"
+              className="p-1 text-gray-500 hover:text-amber-700 disabled:opacity-40 rounded hover:bg-gray-200/60 transition-colors"
+            >
+              <ArrowsRightLeftIcon className="w-3.5 h-3.5" />
+            </button>
+
+            <label htmlFor={`${uid}-target`} className="sr-only">
+              Target language
+            </label>
+            <select
+              id={`${uid}-target`}
+              value={targetLanguage}
+              onChange={(e) => setTargetLanguage(e.target.value)}
+              disabled={!supported || isTranslating}
+              aria-label="Target language"
+              className="bg-white border border-gray-300 text-gray-800 rounded px-2 py-1 text-xs focus:ring-2 focus:ring-amber-400 focus:outline-none disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.label} ({lang.code})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={isDisabled}
+            className="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-amber-600 text-white font-semibold px-3 py-1 rounded text-xs transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
+          >
+            {isTranslating ? (
+              <>
+                <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" />
+                <span>
+                  {downloadProgress !== null
+                    ? `Downloading model (${downloadProgress}%)...`
+                    : 'Translating...'}
+                </span>
+              </>
+            ) : (
+              <span>
+                {availability === 'downloadable' || availability === 'downloading'
+                  ? 'Download & Translate'
+                  : 'Translate'}
+              </span>
+            )}
+          </button>
+
+          {activeLanguage !== 'en' && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              disabled={isTranslating}
+              className="inline-flex items-center gap-1 text-xs font-medium text-gray-700 hover:text-gray-900 underline px-1.5 py-1"
+            >
+              Original (English)
+            </button>
+          )}
+
+          {compact && (
+            <button
+              type="button"
+              onClick={() => setIsExpanded(false)}
+              className="text-gray-400 hover:text-gray-600 px-1 text-xs"
+              aria-label="Close translation options"
+            >
+              ✕
+            </button>
+          )}
+        </div>
+      </div>
+
+      {!supported && (
+        <p className="text-xs text-amber-800 mt-1.5" role="status">
+          Client-side translation is currently unsupported in this browser. Open in Chrome 138+ or Edge 148+ on desktop to use the built-in Translator API.
+        </p>
+      )}
+
+      {supported && availability === 'unavailable' && (
+        <p className="text-xs text-amber-800 mt-1.5" role="status">
+          Translation model for this language pair is unavailable on this device.
+        </p>
+      )}
+
+      {supported && (availability === 'downloadable' || availability === 'downloading') && !isTranslating && (
+        <p className="text-xs text-gray-600 mt-1" role="status">
+          On-device language pack ready to download on click (100% private, stays in your browser).
+        </p>
+      )}
+
+      {errorMessage && (
+        <p className="text-xs text-red-600 mt-1.5" role="alert">
+          {errorMessage}
+        </p>
+      )}
+    </div>
+  );
+}
