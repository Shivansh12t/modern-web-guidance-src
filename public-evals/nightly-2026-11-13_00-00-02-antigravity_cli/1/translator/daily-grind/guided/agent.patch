+  <script>
+    (() => {
+      const langSelect = document.getElementById('target-language');
+      const translateBtn = document.getElementById('start-translation-btn');
+      const statusEl = document.getElementById('translation-status');
+      const progressEl = document.getElementById('translation-progress');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English strings so users can restore or translate between any language pair
+      const originalTexts = new Map(
+        translatableElements.map((el) => [el, el.textContent.trim().replace(/\s+/g, ' ')])
+      );
+
+      let currentLanguage = 'en';
+      const translatorCache = new Map();
+
+      function updateStatus(message, state = 'info') {
+        statusEl.textContent = message;
+        statusEl.dataset.state = state;
+      }
+
+      function applyLanguageAttributes(langCode) {
+        for (const el of translatableElements) {
+          if (langCode === 'en') {
+            el.removeAttribute('lang');
+          } else {
+            el.setAttribute('lang', langCode);
+          }
+        }
+      }
+
+      function restoreOriginalEnglish() {
+        for (const [el, text] of originalTexts.entries()) {
+          el.textContent = text;
+        }
+        applyLanguageAttributes('en');
+        currentLanguage = 'en';
+        progressEl.hidden = true;
+        updateStatus('Showing original English content.');
+      }
+
+      // Check if the built-in Translator API is supported in the global scope
+      if (!('Translator' in self)) {
+        langSelect.disabled = true;
+        translateBtn.disabled = true;
+        updateStatus(
+          'Client-side translation is currently unsupported in this browser. Open in Chrome 138+ or Edge 148+ on desktop to use on-device AI translation.',
+          'error'
+        );
+        return;
+      }
+
+      async function checkTargetAvailability(targetLanguage) {
+        if (targetLanguage === 'en') {
+          translateBtn.disabled = false;
+          translateBtn.textContent = 'Restore Original';
+          updateStatus('Ready to restore original English text.');
+          return 'available';
+        }
+
+        const options = {
+          sourceLanguage: 'en',
+          targetLanguage,
+        };
+
+        try {
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            translateBtn.disabled = true;
+            translateBtn.textContent = 'Unavailable';
+            updateStatus(
+              `Translation model for "${targetLanguage}" is unavailable on this device.`,
+              'error'
+            );
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Download & Translate';
+            updateStatus(
+              `Language pack (${targetLanguage.toUpperCase()}) is ${availability}. Click "Download & Translate" to start on-device translation.`
+            );
+          } else {
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Translate On-Device';
+            updateStatus(
+              `On-device model for ${targetLanguage.toUpperCase()} is available and ready.`
+            );
+          }
+
+          return availability;
+        } catch (err) {
+          translateBtn.disabled = true;
+          updateStatus(
+            'Client-side translation is currently unavailable for the selected language pair.',
+            'error'
+          );
+          return 'unavailable';
+        }
+      }
+
+      langSelect.addEventListener('change', async () => {
+        const targetLanguage = langSelect.value;
+        await checkTargetAvailability(targetLanguage);
+      });
+
+      // User gesture handler (click) required when availability is 'downloadable' or 'downloading'
+      translateBtn.addEventListener('click', async () => {
+        const targetLanguage = langSelect.value;
+
+        if (targetLanguage === 'en') {
+          restoreOriginalEnglish();
+          return;
+        }
+
+        const options = {
+          sourceLanguage: 'en',
+          targetLanguage,
+        };
+
+        translateBtn.disabled = true;
+        langSelect.disabled = true;
+
+        try {
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            updateStatus(
+              `Translation model for "${targetLanguage}" is unavailable on this device.`,
+              'error'
+            );
+            return;
+          }
+
+          const cacheKey = `${options.sourceLanguage}-${options.targetLanguage}`;
+          let translator = translatorCache.get(cacheKey);
+
+          if (!translator) {
+            if (availability === 'downloadable' || availability === 'downloading') {
+              progressEl.hidden = false;
+              progressEl.value = 0;
+            }
+
+            translator = await Translator.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const percent = Math.round((e.loaded || 0) * 100);
+                  progressEl.hidden = false;
+                  progressEl.value = percent;
+                  console.log(`Downloaded ${percent}%`);
+                });
+              },
+            });
+
+            translatorCache.set(cacheKey, translator);
+          }
+
+          progressEl.hidden = true;
+
+          for (const [el, sourceText] of originalTexts.entries()) {
+            const translated = await translator.translate(sourceText);
+            el.textContent = translated;
+          }
+
+          applyLanguageAttributes(targetLanguage);
+          currentLanguage = targetLanguage;
+          updateStatus(
+            `Translated menu descriptions and story to ${langSelect.options[langSelect.selectedIndex].text} on-device.`
+          );
+        } catch (error) {
+          progressEl.hidden = true;
+          updateStatus(
+            `Could not complete on-device translation: ${error.message || 'Model unavailable.'}`,
+            'error'
+          );
+        } finally {
+          langSelect.disabled = false;
+          translateBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
