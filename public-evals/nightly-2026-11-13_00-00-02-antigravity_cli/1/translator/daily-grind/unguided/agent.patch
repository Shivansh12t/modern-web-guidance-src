+      const progressLabelEl = document.getElementById('translation-progress-label');
+
+      // Capture original English text for all translatable elements
+      const translatableElements = Array.from(document.querySelectorAll('[data-i18n]'));
+      const originalTexts = new Map();
+      translatableElements.forEach((el) => {
+        originalTexts.set(el, el.textContent.trim());
+      });
+
+      // Cache translator instances and translated strings per target language
+      const translatorCache = new Map();
+      const translationMemory = new Map();
+
+      function getOnDeviceTranslatorNamespace() {
+        if ('Translator' in self && self.Translator && typeof self.Translator.create === 'function') {
+          return self.Translator;
+        }
+        if (self.ai && self.ai.translator && typeof self.ai.translator.create === 'function') {
+          return self.ai.translator;
+        }
+        if ('translation' in self && self.translation && typeof self.translation.createTranslator === 'function') {
+          return {
+            availability: (opts) => self.translation.canTranslate(opts),
+            create: (opts) => self.translation.createTranslator(opts)
+          };
+        }
+        return null;
+      }
+
+      function updateBanner({ visible, badgeText, badgeType, message, progress }) {
+        if (!visible) {
+          bannerEl.hidden = true;
+          return;
+        }
+        bannerEl.hidden = false;
+        badgeEl.textContent = badgeText || 'On-Device AI';
+        badgeEl.className = 'status-badge' + (badgeType ? ' ' + badgeType : '');
+        statusTextEl.textContent = message || '';
+
+        if (typeof progress === 'number') {
+          progressWrapperEl.hidden = false;
+          const pct = Math.max(0, Math.min(100, Math.round(progress)));
+          progressBarEl.value = pct;
+          progressLabelEl.textContent = pct + '%';
+        } else {
+          progressWrapperEl.hidden = true;
+        }
+      }
+
+      function setTranslatingUIState(isTranslating) {
+        const cards = document.querySelectorAll('.card');
+        const storySection = document.getElementById('story-section');
+        cards.forEach((card) => card.classList.toggle('translating', isTranslating));
+        if (storySection) {
+          storySection.classList.toggle('translating', isTranslating);
+        }
+      }
+
+      async function getOrCreateTranslator(targetLanguage) {
+        if (translatorCache.has(targetLanguage)) {
+          return translatorCache.get(targetLanguage);
+        }
+
+        const api = getOnDeviceTranslatorNamespace();
+        if (!api) {
+          return null;
+        }
+
+        const languagePair = {
+          sourceLanguage: SOURCE_LANG,
+          targetLanguage
+        };
+
+        if (typeof api.availability === 'function') {
+          const availability = await api.availability(languagePair);
+          if (availability === 'unavailable' || availability === 'no') {
+            return null;
+          }
+          if (availability === 'downloadable' || availability === 'downloading' || availability === 'after-download') {
+            updateBanner({
+              visible: true,
+              badgeText: 'Downloading Model',
+              badgeType: 'downloading',
+              message: `Downloading on-device ${targetLanguage.toUpperCase()} language pack...`,
+              progress: 0
+            });
+          }
+        }
+
+        const translator = await api.create({
+          ...languagePair,
+          monitor(monitor) {
+            if (!monitor || typeof monitor.addEventListener !== 'function') return;
+            monitor.addEventListener('downloadprogress', (event) => {
+              let pct = 0;
+              if (typeof event.loaded === 'number') {
+                if (typeof event.total === 'number' && event.total > 0 && event.loaded > 1) {
+                  pct = (event.loaded / event.total) * 100;
+                } else if (event.loaded <= 1) {
+                  pct = event.loaded * 100;
+                } else {
+                  pct = event.loaded;
+                }
+              }
+              updateBanner({
+                visible: true,
+                badgeText: 'Downloading Model',
+                badgeType: 'downloading',
+                message: `Downloading on-device ${targetLanguage.toUpperCase()} language pack...`,
+                progress: pct
+              });
+            });
+          }
+        });
+
+        if (translator && translator.ready) {
+          await translator.ready;
+        }
+
+        translatorCache.set(targetLanguage, translator);
+        return translator;
+      }
+
+      async function translatePageContent(targetLanguage) {
+        // Restore original English content immediately if English is selected
+        if (targetLanguage === SOURCE_LANG) {
+          translatableElements.forEach((el) => {
+            el.textContent = originalTexts.get(el);
+          });
+          document.documentElement.lang = SOURCE_LANG;
+          updateBanner({ visible: false });
+          return;
+        }
+
+        setTranslatingUIState(true);
+        updateBanner({
+          visible: true,
+          badgeText: 'Translating',
+          badgeType: 'downloading',
+          message: `Translating coffee menu descriptions and story into ${targetLanguage.toUpperCase()} on-device...`
+        });
+
+        try {
+          const translator = await getOrCreateTranslator(targetLanguage);
+
+          if (translator && typeof translator.translate === 'function') {
+            if (!translationMemory.has(targetLanguage)) {
+              translationMemory.set(targetLanguage, new Map());
+            }
+            const langCache = translationMemory.get(targetLanguage);
+
+            for (const el of translatableElements) {
+              const sourceText = originalTexts.get(el);
+              if (!sourceText) continue;
+
+              if (langCache.has(sourceText)) {
+                el.textContent = langCache.get(sourceText);
+              } else {
+                const translated = await translator.translate(sourceText);
+                langCache.set(sourceText, translated);
+                el.textContent = translated;
+              }
+            }
+
+            document.documentElement.lang = targetLanguage;
+            updateBanner({
+              visible: true,
+              badgeText: 'On-Device AI',
+              badgeType: 'ready',
+              message: `Translated menu descriptions and story to ${targetLanguage.toUpperCase()} using the browser's built-in Translator API.`
+            });
+            return;
+          }
+        } catch (err) {
+          console.warn('Browser Translator API error, falling back to local dictionary:', err);
+        } finally {
+          setTranslatingUIState(false);
+        }
+
+        // On-device local dictionary fallback when browser Translator API is unavailable
+        const dictionary = FALLBACK_TRANSLATIONS[targetLanguage];
+        if (dictionary) {
+          translatableElements.forEach((el) => {
+            const key = el.getAttribute('data-i18n');
+            if (key && dictionary[key]) {
+              el.textContent = dictionary[key];
+            }
+          });
+          document.documentElement.lang = targetLanguage;
+          updateBanner({
+            visible: true,
+            badgeText: 'On-Device Pack',
+            badgeType: 'fallback',
+            message: `Translated menu descriptions and story to ${targetLanguage.toUpperCase()} using built-in on-device language pack.`
+          });
+        } else {
+          updateBanner({
+            visible: true,
+            badgeText: 'Unavailable',
+            badgeType: 'unavailable',
+            message: `On-device translation for ${targetLanguage.toUpperCase()} is not available on this browser.`
+          });
+        }
+      }
+
+      languageSelect.addEventListener('change', (event) => {
+        translatePageContent(event.target.value);
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
