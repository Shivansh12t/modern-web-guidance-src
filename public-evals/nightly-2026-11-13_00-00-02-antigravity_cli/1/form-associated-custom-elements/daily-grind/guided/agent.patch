+          btn.disabled = this.#disabled;
+          btn.innerHTML = '<span aria-hidden="true">★</span>';
+          starsContainer.append(btn);
+        }
+      }
+
+      #updateUI() {
+        if (!this.shadowRoot) return;
+        const buttons = [...this.shadowRoot.querySelectorAll('button.star')];
+        const selectedNum = Number(this.#value) || 0;
+
+        buttons.forEach((btn, idx) => {
+          const starNum = idx + 1;
+          const isSelected = starNum === selectedNum;
+          const isFilled = starNum <= selectedNum;
+          btn.classList.toggle('filled', isFilled);
+          btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
+          const shouldBeTabbable = selectedNum > 0 ? isSelected : starNum === 1;
+          btn.tabIndex = shouldBeTabbable ? 0 : -1;
+        });
+
+        const readout = this.shadowRoot.querySelector('.rating-readout');
+        if (readout) {
+          readout.textContent = selectedNum > 0
+            ? `${selectedNum} of ${this.#max} ${selectedNum === 1 ? 'star' : 'stars'}`
+            : 'No rating selected';
+        }
+      }
+    }
+
+    customElements.define('star-rating', StarRating);
+
+    // Form validation ARIA sync, :user-invalid fallback, fieldset toggle, and submission handler
+    (() => {
+      const form = document.getElementById('coffee-feedback-form');
+      const fieldset = document.getElementById('feedback-fieldset');
+      const toggleFieldsetBtn = document.getElementById('toggle-fieldset-btn');
+      const statusBox = document.getElementById('feedback-status');
+      const submitBtn = document.getElementById('submit-feedback-btn');
+
+      // List the field's error message (the id in data-error) in aria-describedby only while
+      // it's shown: text that aria-describedby references is announced even when it's hidden.
+      const linkError = (el, shown) => {
+        const errorId = el.dataset?.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+
+      // One polite live region for the page announces an error that appears when the user
+      // leaves or changes a field.
+      const announcer = document.createElement('div');
+      announcer.setAttribute('aria-live', 'polite');
+      announcer.classList.add('visually-hidden');
+      document.body.append(announcer);
+      let announceTimer;
+      let announcedField;
+
+      const spokenText = (node) => {
+        const copy = node.cloneNode(true);
+        copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
+        copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
+        return copy.textContent.replace(/\s+/g, ' ').trim();
+      };
+
+      const announceError = (el) => {
+        const error = document.getElementById(el.dataset.error);
+        if (!error) return;
+        const labelEl = el.labels?.[0] || (el.id ? document.querySelector(`label[for="${el.id}"]`) : null);
+        const label = labelEl ? `${spokenText(labelEl)}: ` : '';
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announcedField = el;
+        announceTimer = setTimeout(() => {
+          announcer.textContent = label + spokenText(error);
+        }, 500);
+      };
+
+      const supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+      const dirtyState = new WeakMap();
+      const flagged = new WeakSet();
+      const announced = new WeakSet();
+
+      const isFieldControl = (el) => el?.matches?.('input, select, textarea, star-rating');
+
+      const checkIsUserInvalid = (el) => {
+        if (el.matches('star-rating')) {
+          return el.matches(':state(user-invalid)') || el.classList.contains('user-invalid-fallback');
+        }
+        if (supportsUserInvalid) {
+          return el.matches(':user-invalid');
+        }
+        return el.classList.contains('user-invalid-fallback');
+      };
+
+      const syncAria = (el, announce = false) => {
+        if (!isFieldControl(el)) return;
+        const invalid = checkIsUserInvalid(el);
+        if (invalid) {
+          if (announce && !announced.has(el)) {
+            announceError(el);
+            announced.add(el);
+          }
+          el.setAttribute('aria-invalid', 'true');
+          linkError(el, true);
+          flagged.add(el);
+        } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
+          el.setAttribute('aria-invalid', 'false');
+          linkError(el, false);
+          flagged.delete(el);
+          announced.delete(el);
+          if (announcedField === el) {
+            clearTimeout(announceTimer);
+            announcer.textContent = '';
+          }
+        }
+      };
+
+      const updateFallbackState = (input) => {
+        if (!input.validity) return;
+        const isValid = input.validity.valid;
+        input.classList.toggle('user-invalid-fallback', !isValid);
+        input.classList.toggle('user-valid-fallback', isValid);
+      };
+
+      // Start every field at aria-invalid="false".
+      form.querySelectorAll('input, select, textarea, star-rating').forEach((el) => syncAria(el));
+
+      form.addEventListener('blur', (e) => {
+        const el = e.target;
+        if (!isFieldControl(el)) return;
+        if (!supportsUserInvalid || el.matches('star-rating')) {
+          const state = dirtyState.get(el) || { hasInteracted: false, hasBlurred: false };
+          state.hasBlurred = true;
+          dirtyState.set(el, state);
+          if (state.hasInteracted) {
+            updateFallbackState(el);
+          }
+        }
+        syncAria(el, true);
+      }, true);
+
+      form.addEventListener('input', (e) => {
+        const el = e.target;
+        if (!isFieldControl(el)) return;
+        if (!supportsUserInvalid || el.matches('star-rating')) {
+          const state = dirtyState.get(el) || { hasInteracted: false, hasBlurred: false };
+          state.hasInteracted = true;
+          dirtyState.set(el, state);
+          if (state.hasBlurred || el.classList.contains('user-invalid-fallback')) {
+            updateFallbackState(el);
+          }
+        }
+        if (el.hasAttribute('aria-invalid')) syncAria(el);
+      });
+
+      form.addEventListener('change', (e) => {
+        const el = e.target;
+        if (!isFieldControl(el)) return;
+        if (!supportsUserInvalid || el.matches('star-rating')) {
+          const state = dirtyState.get(el) || { hasInteracted: false, hasBlurred: false };
+          state.hasInteracted = true;
+          dirtyState.set(el, state);
+          updateFallbackState(el);
+        }
+        syncAria(el, true);
+      }, true);
+
+      form.addEventListener('invalid', (e) => {
+        const el = e.target;
+        if (!isFieldControl(el)) return;
+        dirtyState.set(el, { hasInteracted: true, hasBlurred: true });
+        updateFallbackState(el);
+        announced.add(el);
+        syncAria(el);
+      }, true);
+
+      form.addEventListener('reset', () => {
+        statusBox.hidden = true;
+        statusBox.textContent = '';
+        submitBtn.disabled = false;
+        setTimeout(() => {
+          form.querySelectorAll('input, select, textarea, star-rating').forEach((el) => {
+            dirtyState.delete(el);
+            el.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+            syncAria(el);
+          });
+        });
+      }, true);
+
+      // Toggle disabled state on the parent <fieldset> to exercise formDisabledCallback
+      toggleFieldsetBtn.addEventListener('click', () => {
+        const nextDisabled = !fieldset.disabled;
+        fieldset.disabled = nextDisabled;
+        toggleFieldsetBtn.setAttribute('aria-pressed', String(nextDisabled));
+        toggleFieldsetBtn.textContent = nextDisabled ? 'Unlock Fieldset' : 'Lock Fieldset';
+      });
+
+      // Handle form submission via FormData (natively includes <star-rating>'s value)
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!form.checkValidity()) {
+          form.reportValidity();
+          return;
+        }
+        const data = new FormData(form);
+        const name = data.get('customer_name');
+        const drinkChoice = document.getElementById('drink-choice');
+        const drinkLabel = drinkChoice.options[drinkChoice.selectedIndex]?.text || data.get('drink');
+        const rating = data.get('rating');
+
+        statusBox.textContent = `Thank you, ${name}! Your ${rating}-star review for ${drinkLabel} has been submitted.`;
+        statusBox.hidden = false;
+      });
+    })();
+  </script>
+
 </body>
 
