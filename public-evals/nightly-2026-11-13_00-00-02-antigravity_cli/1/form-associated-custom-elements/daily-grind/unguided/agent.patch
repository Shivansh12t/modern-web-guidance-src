+  <script>
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'required', 'disabled', 'max', 'name'];
+      }
+
+      constructor() {
+        super();
+        this._internals = this.attachInternals();
+        this._shadowRoot = this.attachShadow({ mode: 'open', delegatesFocus: true });
+
+        this._value = '';
+        this._defaultValue = '';
+        this._hoverValue = 0;
+        this._disabled = false;
+        this._required = false;
+        this._max = 5;
+        this._initialized = false;
+
+        this._render();
+      }
+
+      connectedCallback() {
+        if (!this._initialized) {
+          this._defaultValue = this.getAttribute('value') || '';
+          if (!this._value && this._defaultValue) {
+            this._value = this._defaultValue;
+          }
+          this._initialized = true;
+        }
+
+        if (!this.hasAttribute('tabindex') && !this._disabled) {
+          this.setAttribute('tabindex', '0');
+        }
+        if (!this.hasAttribute('role')) {
+          this.setAttribute('role', 'slider');
+        }
+
+        this._required = this.hasAttribute('required');
+        this._disabled = this.hasAttribute('disabled') || this.matches(':disabled');
+        if (this.hasAttribute('max')) {
+          const parsedMax = parseInt(this.getAttribute('max'), 10);
+          if (!Number.isNaN(parsedMax) && parsedMax > 0) {
+            this._max = parsedMax;
+          }
+        }
+
+        this._syncState();
+        this._addEventListeners();
+      }
+
+      disconnectedCallback() {
+        this._removeEventListeners();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+
+        switch (name) {
+          case 'value':
+            if (!this._initialized) {
+              this._defaultValue = newValue || '';
+            }
+            this.value = newValue || '';
+            break;
+          case 'required':
+            this._required = newValue !== null;
+            this._updateValidity();
+            this._updateAria();
+            break;
+          case 'disabled':
+            this._disabled = newValue !== null || this.matches(':disabled');
+            this._updateDisabledUI();
+            this._updateValidity();
+            break;
+          case 'max': {
+            const parsed = parseInt(newValue, 10);
+            this._max = !Number.isNaN(parsed) && parsed > 0 ? parsed : 5;
+            this._renderStars();
+            this._syncState();
+            break;
+          }
+        }
+      }
+
+      // Form-associated lifecycle callbacks
+      formAssociatedCallback(form) {
+        this._syncState();
+      }
+
+      formDisabledCallback(disabled) {
+        this._disabled = disabled || this.hasAttribute('disabled');
+        this._updateDisabledUI();
+        this._updateValidity();
+      }
+
+      formResetCallback() {
+        const defaultVal = this.getAttribute('value') || this._defaultValue || '';
+        this._value = defaultVal;
+        this._hoverValue = 0;
+        this._syncState();
+      }
+
+      formStateRestoreCallback(state, mode) {
+        this.value = state !== null && state !== undefined ? String(state) : '';
+      }
+
+      // Properties & Constraint Validation API
+      get form() {
+        return this._internals.form;
+      }
+
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', String(val));
+        }
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this._internals.validity;
+      }
+
+      get validationMessage() {
+        return this._internals.validationMessage;
+      }
+
+      get willValidate() {
+        return this._internals.willValidate;
+      }
+
+      checkValidity() {
+        return this._internals.checkValidity();
+      }
+
+      reportValidity() {
+        return this._internals.reportValidity();
+      }
+
+      setCustomValidity(message) {
+        if (message) {
+          this._internals.setValidity({ customError: true }, message, this._getValidationAnchor());
+        } else {
+          this._updateValidity();
+        }
+      }
+
+      get value() {
+        return this._value;
+      }
+
+      set value(val) {
+        const normalized = val === null || val === undefined || val === '' || val === 0 || val === '0'
+          ? ''
+          : String(val);
+        this._value = normalized;
+        this._syncState();
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        if (val) {
+          this.setAttribute('required', '');
+        } else {
+          this.removeAttribute('required');
+        }
+      }
+
+      get disabled() {
+        return this._disabled;
+      }
+
+      set disabled(val) {
+        if (val) {
+          this.setAttribute('disabled', '');
+        } else {
+          this.removeAttribute('disabled');
+        }
+      }
+
+      get max() {
+        return this._max;
+      }
+
+      set max(val) {
+        this.setAttribute('max', String(val));
+      }
+
+      _getValidationAnchor() {
+        return this._shadowRoot.querySelector('.star-btn') || this._shadowRoot.querySelector('.stars-container') || undefined;
+      }
+
+      _syncState() {
+        const formVal = this._value ? this._value : null;
+        this._internals.setFormValue(formVal, this._value);
+        this._updateValidity();
+        this._updateStarsUI();
+        this._updateDisabledUI();
+        this._updateAria();
+      }
+
+      _updateValidity() {
+        const numVal = Number(this._value);
+        const hasValidRating = this._value !== '' && !Number.isNaN(numVal) && numVal >= 1 && numVal <= this._max;
+
+        if (this._required && !hasValidRating) {
+          this._internals.setValidity(
+            { valueMissing: true },
+            'Please select a star rating for your coffee.',
+            this._getValidationAnchor()
+          );
+        } else {
+          this._internals.setValidity({});
+        }
+      }
+
+      _updateAria() {
+        this.setAttribute('aria-valuemin', '1');
+        this.setAttribute('aria-valuemax', String(this._max));
+        this.setAttribute('aria-valuenow', this._value || '0');
+        this.setAttribute('aria-required', this._required ? 'true' : 'false');
+        this.setAttribute('aria-disabled', this._disabled ? 'true' : 'false');
+      }
+
+      _updateDisabledUI() {
+        const container = this._shadowRoot.querySelector('.stars-container');
+        const buttons = this._shadowRoot.querySelectorAll('.star-btn');
+        if (container) {
+          container.classList.toggle('disabled', this._disabled);
+        }
+        buttons.forEach((btn) => {
+          btn.disabled = this._disabled;
+        });
+        if (this._disabled) {
+          this.removeAttribute('tabindex');
+        } else if (!this.hasAttribute('tabindex')) {
+          this.setAttribute('tabindex', '0');
+        }
+      }
+
+      _updateStarsUI() {
+        const activeVal = this._hoverValue > 0 ? this._hoverValue : (Number(this._value) || 0);
+        const buttons = this._shadowRoot.querySelectorAll('.star-btn');
+        const label = this._shadowRoot.querySelector('.rating-text');
+
+        buttons.forEach((btn) => {
+          const starVal = Number(btn.dataset.value);
+          const isFilled = starVal <= activeVal;
+          const isSelected = starVal === Number(this._value);
+          btn.classList.toggle('filled', isFilled);
+          btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
+        });
+
+        if (label) {
+          if (activeVal > 0) {
+            label.textContent = `${activeVal} of ${this._max} stars`;
+          } else {
+            label.textContent = 'No rating selected';
+          }
+        }
+      }
+
+      _selectRating(rating) {
+        if (this._disabled) return;
+        const clamped = Math.max(1, Math.min(this._max, Number(rating)));
+        const nextVal = String(clamped);
+        const changed = this._value !== nextVal;
+        this.value = nextVal;
+        if (changed) {
+          this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+          this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        }
+      }
+
+      _onKeyDown = (e) => {
+        if (this._disabled) return;
+        const current = Number(this._value) || 0;
+        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          this._selectRating(Math.min(this._max, current + 1));
+        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+          e.preventDefault();
+          if (current <= 1) {
+            this.value = '';
+            this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+            this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+          } else {
+            this._selectRating(current - 1);
+          }
+        } else if (e.key >= '1' && e.key <= String(this._max)) {
+          e.preventDefault();
+          this._selectRating(Number(e.key));
+        }
+      };
+
+      _addEventListeners() {
+        this.addEventListener('keydown', this._onKeyDown);
+      }
+
+      _removeEventListeners() {
+        this.removeEventListener('keydown', this._onKeyDown);
+      }
+
+      _renderStars() {
+        const starsWrapper = this._shadowRoot.querySelector('.stars-list');
+        if (!starsWrapper) return;
+        starsWrapper.innerHTML = '';
+
+        for (let i = 1; i <= this._max; i++) {
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.className = 'star-btn';
+          btn.dataset.value = String(i);
+          btn.setAttribute('role', 'radio');
+          btn.setAttribute('aria-label', `${i} ${i === 1 ? 'star' : 'stars'}`);
+          btn.setAttribute('aria-checked', 'false');
+          btn.innerHTML = `
+            <svg viewBox="0 0 24 24" class="star-icon" aria-hidden="true">
+              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
+            </svg>
+          `;
+
+          btn.addEventListener('click', () => {
+            this._selectRating(i);
+          });
+
+          btn.addEventListener('mouseenter', () => {
+            if (this._disabled) return;
+            this._hoverValue = i;
+            this._updateStarsUI();
+          });
+
+          starsWrapper.appendChild(btn);
+        }
+
+        starsWrapper.addEventListener('mouseleave', () => {
+          if (this._disabled) return;
+          this._hoverValue = 0;
+          this._updateStarsUI();
+        });
+      }
+
+      _render() {
+        this._shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+              font-family: inherit;
+              outline: none;
+            }
+
+            .stars-container {
+              display: inline-flex;
+              align-items: center;
+              gap: 12px;
+              padding: 4px 0;
+            }
+
+            .stars-container.disabled {
+              cursor: not-allowed;
+              opacity: 0.55;
+            }
+
+            .stars-list {
+              display: inline-flex;
+              gap: 4px;
+            }
+
+            .star-btn {
+              background: transparent;
+              border: none;
+              padding: 4px;
+              cursor: pointer;
+              color: #d7ccc8;
+              transition: transform 0.15s ease, color 0.15s ease;
+              border-radius: 4px;
+              display: inline-flex;
+              align-items: center;
+              justify-content: center;
+            }
+
+            .star-btn:focus-visible,
+            :host(:focus-visible) .stars-list {
+              outline: 2px solid #ffab40;
+              outline-offset: 2px;
+              border-radius: 4px;
+            }
+
+            .star-btn.filled {
+              color: #ffab40;
+            }
+
+            .star-btn:not(:disabled):hover {
+              transform: scale(1.15);
+            }
+
+            .star-btn:disabled {
+              cursor: not-allowed;
+            }
+
+            .star-icon {
+              width: 30px;
+              height: 30px;
+              fill: currentColor;
+              stroke: #4e342e;
+              stroke-width: 1px;
+            }
+
+            .rating-text {
+              font-size: 0.9rem;
+              color: #5d4037;
+              min-width: 120px;
+            }
+          </style>
+          <div class="stars-container" part="container">
+            <div class="stars-list" role="radiogroup" aria-label="Star rating"></div>
+            <span class="rating-text" part="label">No rating selected</span>
+          </div>
+        `;
+        this._renderStars();
+      }
+    }
+
+    if (!customElements.get('star-rating')) {
+      customElements.define('star-rating', StarRating);
+    }
+
+    // Handle feedback form submission and reset
+    const feedbackForm = document.getElementById('coffee-feedback-form');
+    const feedbackResult = document.getElementById('feedback-result');
+
+    if (feedbackForm && feedbackResult) {
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(feedbackForm);
+        const name = formData.get('customerName');
+        const drink = formData.get('drink');
+        const rating = formData.get('rating');
+        const comments = formData.get('comments');
+
+        feedbackResult.textContent = `Thank you, ${name}! Your ${rating}-star review for ${drink}${comments ? ` ("${comments}")` : ''} has been submitted.`;
+        feedbackResult.classList.add('visible');
+      });
+
+      feedbackForm.addEventListener('reset', () => {
+        feedbackResult.textContent = '';
+        feedbackResult.classList.remove('visible');
+      });
+    }
+  </script>
