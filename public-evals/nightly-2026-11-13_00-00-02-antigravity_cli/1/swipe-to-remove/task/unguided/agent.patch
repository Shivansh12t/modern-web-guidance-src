+  <script>
+    (function () {
+      const DEFAULT_BG = '#d7ccc8';
+      const ACTION_BG = '#d32f2f';
+
+      function getClientX(event) {
+        if (event.touches && event.touches.length > 0) {
+          return event.touches[0].clientX ?? event.touches[0].pageX ?? 0;
+        }
+        if (event.changedTouches && event.changedTouches.length > 0) {
+          return event.changedTouches[0].clientX ?? event.changedTouches[0].pageX ?? 0;
+        }
+        return event.clientX ?? event.pageX ?? 0;
+      }
+
+      function initSwipeableItem(item) {
+        if (item.classList.contains('is-initialized')) {
+          return;
+        }
+
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) {
+          return;
+        }
+
+        item.classList.add('is-initialized');
+        item.style.backgroundColor = DEFAULT_BG;
+
+        let isDragging = false;
+        let isRemoving = false;
+        let startX = 0;
+        let deltaX = 0;
+        let autoRemoveTimer = null;
+
+        function getThreshold() {
+          const width = item.offsetWidth || 300;
+          return Math.min(80, width * 0.25);
+        }
+
+        function setTranslate(x, animate) {
+          const transitionValue = animate ? 'transform 200ms ease-out' : 'none';
+          track.style.transition = transitionValue;
+          content.style.transition = transitionValue;
+          const half = x / 2;
+          track.style.transform = `translateX(${half}px)`;
+          content.style.transform = `translateX(${half}px)`;
+        }
+
+        function setActionState(active) {
+          if (active) {
+            item.classList.add('is-past-threshold', 'is-active');
+            item.style.backgroundColor = ACTION_BG;
+          } else {
+            item.classList.remove('is-past-threshold', 'is-active');
+            item.style.backgroundColor = DEFAULT_BG;
+          }
+        }
+
+        function collapseAndRemove() {
+          if (isRemoving) {
+            return;
+          }
+          isRemoving = true;
+          isDragging = false;
+          if (autoRemoveTimer) {
+            clearTimeout(autoRemoveTimer);
+            autoRemoveTimer = null;
+          }
+
+          setActionState(true);
+          item.classList.add('is-removing');
+
+          const width = item.offsetWidth || 400;
+          const direction = deltaX < 0 ? -1 : 1;
+          setTranslate(direction * width, true);
+
+          const startHeight = item.offsetHeight;
+          item.style.height = `${startHeight}px`;
+          void item.offsetHeight;
+
+          item.style.transition = 'height 300ms ease, margin 300ms ease, padding 300ms ease, opacity 300ms ease';
+          item.style.height = '0px';
+          item.style.marginTop = '0px';
+          item.style.marginBottom = '0px';
+          item.style.paddingTop = '0px';
+          item.style.paddingBottom = '0px';
+
+          let removed = false;
+          const finalizeRemoval = () => {
+            if (removed) {
+              return;
+            }
+            removed = true;
+            if (item.parentNode) {
+              item.remove();
+            }
+          };
+
+          item.addEventListener('transitionend', (e) => {
+            if (e.propertyName === 'height') {
+              finalizeRemoval();
+            }
+          });
+          setTimeout(finalizeRemoval, 340);
+        }
+
+        function handleStart(event) {
+          if (isRemoving || isDragging) {
+            return;
+          }
+          if (event.type === 'mousedown' && event.button !== 0) {
+            return;
+          }
+          isDragging = true;
+          startX = getClientX(event);
+          deltaX = 0;
+          item.classList.add('is-dragging');
+          setTranslate(0, false);
+        }
+
+        function handleMove(event) {
+          if (!isDragging || isRemoving) {
+            return;
+          }
+          const currentX = getClientX(event);
+          deltaX = currentX - startX;
+          setTranslate(deltaX, false);
+
+          const pastThreshold = Math.abs(deltaX) >= getThreshold();
+          setActionState(pastThreshold);
+
+          if (autoRemoveTimer) {
+            clearTimeout(autoRemoveTimer);
+            autoRemoveTimer = null;
+          }
+          if (pastThreshold) {
+            autoRemoveTimer = setTimeout(() => {
+              if (isDragging && !isRemoving && Math.abs(deltaX) >= getThreshold()) {
+                collapseAndRemove();
+              }
+            }, 180);
+          }
+        }
+
+        function handleEnd(event) {
+          if (!isDragging || isRemoving) {
+            return;
+          }
+          if (autoRemoveTimer) {
+            clearTimeout(autoRemoveTimer);
+            autoRemoveTimer = null;
+          }
+          if (deltaX === 0 && event) {
+            const endX = getClientX(event);
+            if (endX !== 0 || startX !== 0) {
+              deltaX = endX - startX;
+            }
+          }
+          isDragging = false;
+          item.classList.remove('is-dragging');
+
+          if (Math.abs(deltaX) >= getThreshold()) {
+            collapseAndRemove();
+          } else {
+            setActionState(false);
+            setTranslate(0, true);
+          }
+        }
+
+        item.addEventListener('pointerdown', handleStart);
+        item.addEventListener('mousedown', handleStart);
+        item.addEventListener('touchstart', handleStart, { passive: true });
+
+        window.addEventListener('pointermove', handleMove);
+        window.addEventListener('mousemove', handleMove);
+        window.addEventListener('touchmove', handleMove, { passive: true });
+        item.addEventListener('pointermove', handleMove);
+        item.addEventListener('mousemove', handleMove);
+        item.addEventListener('touchmove', handleMove, { passive: true });
+
+        window.addEventListener('pointerup', handleEnd);
+        window.addEventListener('mouseup', handleEnd);
+        window.addEventListener('touchend', handleEnd);
+        window.addEventListener('pointercancel', handleEnd);
+        window.addEventListener('touchcancel', handleEnd);
+        item.addEventListener('pointerup', handleEnd);
+        item.addEventListener('mouseup', handleEnd);
+        item.addEventListener('touchend', handleEnd);
+      }
+
+      function initAllSwipeableLists() {
+        const items = document.querySelectorAll('.SwipeableList .SwipeableList-item');
+        items.forEach(initSwipeableItem);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initAllSwipeableLists);
+      } else {
+        initAllSwipeableLists();
+      }
+    })();
+  </script>
 </body>
 
