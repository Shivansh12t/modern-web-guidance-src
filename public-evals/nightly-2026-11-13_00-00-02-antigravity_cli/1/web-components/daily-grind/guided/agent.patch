+/**
+ * Helper to apply styles to a ShadowRoot using shared adoptedStyleSheets when supported,
+ * with a fallback to a <style> tag.
+ */
+function adoptStyles(shadowRoot, cssText, cachedSheet) {
+  if (supportsAdoptedStyleSheets) {
+    if (!cachedSheet) {
+      cachedSheet = new CSSStyleSheet();
+      cachedSheet.replaceSync(cssText);
+    }
+    shadowRoot.adoptedStyleSheets = [cachedSheet];
+    return cachedSheet;
+  }
+  const styleEl = document.createElement('style');
+  styleEl.textContent = cssText;
+  shadowRoot.prepend(styleEl);
+  return null;
+}
