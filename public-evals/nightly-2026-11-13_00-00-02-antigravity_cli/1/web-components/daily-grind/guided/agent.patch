+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'price',
+    'roast',
+    'image',
+    'image-alt',
+    'href',
+    'notes',
+    'favorited',
+    'disabled',
+  ];
+
+  #internals;
+  #cartCount = 0;
+  #notesExpanded = false;
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.#internals = 'attachInternals' in this ? this.attachInternals() : null;
+
+    // Support Declarative Shadow DOM hydration if already present; otherwise clone template
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+    }
+    coffeeCardSheet = adoptStyles(this.shadowRoot, coffeeCardCSS, coffeeCardSheet);
+
+    // Bind internal listeners once in constructor so moving the element doesn't duplicate handlers
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    const actionBtn = this.shadowRoot.querySelector('.action-btn');
+    const notesBtn = this.shadowRoot.querySelector('.notes-toggle');
+    const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+
+    favBtn?.addEventListener('click', () => this.toggleFavorite());
+    actionBtn?.addEventListener('click', () => this.addToOrder());
+    notesBtn?.addEventListener('click', () => this.toggleNotes());
+    titleSlot?.addEventListener('slotchange', () => this.#syncUI());
+  }
+
+  connectedCallback() {
+    this.#initialized = true;
+    this.#syncUI();
+  }
+
+  connectedMoveCallback() {
+    // Preserve state when relocated with Node.moveBefore() without tearing down
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.#initialized) {
+      this.#syncUI();
+    }
+  }
+
+  // Reflected properties
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(v) {
+    v ? this.setAttribute('name', v) : this.removeAttribute('name');
+  }
+
+  get price() {
+    return Number(this.getAttribute('price')) || 0;
+  }
+  set price(v) {
+    this.setAttribute('price', String(v));
+  }
+
+  get roast() {
+    return this.getAttribute('roast') ?? 'medium';
+  }
+  set roast(v) {
+    v ? this.setAttribute('roast', v) : this.removeAttribute('roast');
+  }
+
+  get image() {
+    return this.getAttribute('image') ?? '';
+  }
+  set image(v) {
+    v ? this.setAttribute('image', v) : this.removeAttribute('image');
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '/menu';
+  }
+  set href(v) {
+    v ? this.setAttribute('href', v) : this.removeAttribute('href');
+  }
+
+  get notes() {
+    return this.getAttribute('notes') ?? '';
+  }
+  set notes(v) {
+    v ? this.setAttribute('notes', v) : this.removeAttribute('notes');
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(on) {
+    this.toggleAttribute('favorited', Boolean(on));
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+  set disabled(on) {
+    this.toggleAttribute('disabled', Boolean(on));
+  }
+
+  get cartCount() {
+    return this.#cartCount;
+  }
+
+  toggleFavorite() {
+    if (this.disabled) return;
+    this.favorited = !this.favorited;
+    this.#announce(
+      this.favorited
+        ? `${this.#resolvedName()} saved to favorites.`
+        : `${this.#resolvedName()} removed from favorites.`
+    );
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.#resolvedName(),
+          favorited: this.favorited,
+        },
+      })
+    );
+  }
+
+  addToOrder() {
+    if (this.disabled) return;
+    this.#cartCount += 1;
+    if (supportsCustomStates && this.#internals) {
+      this.#internals.states.add('in-cart');
+    }
+    this.#syncUI();
+    this.#announce(`Added ${this.#resolvedName()} to order (${this.#cartCount} in cart).`);
+    this.dispatchEvent(
+      new CustomEvent('coffee-order', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.#resolvedName(),
+          price: this.price || 4.75,
+          roast: this.roast,
+          count: this.#cartCount,
+        },
+      })
+    );
+  }
+
+  toggleNotes() {
+    this.#notesExpanded = !this.#notesExpanded;
+    if (supportsCustomStates && this.#internals) {
+      if (this.#notesExpanded) {
+        this.#internals.states.add('expanded');
+      } else {
+        this.#internals.states.delete('expanded');
+      }
+    }
+    this.#syncUI();
+  }
+
+  #resolvedName() {
+    if (this.name) return this.name;
+    const titleSlot = this.shadowRoot?.querySelector('slot[name="title"]');
+    const assigned = titleSlot?.assignedElements?.() ?? [];
+    if (assigned.length > 0) {
+      return assigned[0].textContent.trim();
+    }
+    return 'Artisanal Coffee';
+  }
+
+  #announce(message) {
+    const statusEl = this.shadowRoot?.querySelector('.sr-status');
+    if (statusEl) {
+      statusEl.textContent = message;
+    }
+  }
+
+  #syncUI() {
+    if (!this.shadowRoot) return;
+    const itemName = this.#resolvedName();
+    const isFav = this.favorited;
+    const isDisabled = this.disabled;
+
+    // Sync custom states via ElementInternals
+    if (supportsCustomStates && this.#internals) {
+      if (isFav) {
+        this.#internals.states.add('favorited');
+      } else {
+        this.#internals.states.delete('favorited');
+      }
+    }
+    if (this.#internals && supportsAriaReflection) {
+      this.#internals.ariaDisabled = isDisabled ? 'true' : 'false';
+    }
+
+    // Fallback title
+    const fallbackTitle = this.shadowRoot.querySelector('.fallback-title');
+    if (fallbackTitle) {
+      fallbackTitle.textContent = itemName;
+    }
+
+    // Price
+    const priceEl = this.shadowRoot.querySelector('.price');
+    if (priceEl) {
+      const priceVal = this.price || 4.75;
+      priceEl.textContent = `$${priceVal.toFixed(2)}`;
+    }
+
+    // Roast badge
+    const roastEl = this.shadowRoot.querySelector('.roast-pill');
+    if (roastEl) {
+      roastEl.textContent = `${this.roast} roast`;
+    }
+
+    // Image
+    const imgEl = this.shadowRoot.querySelector('.media-img');
+    if (imgEl) {
+      const fallbackImg =
+        'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80';
+      const targetSrc = this.image || fallbackImg;
+      if (imgEl.getAttribute('src') !== targetSrc) {
+        imgEl.setAttribute('src', targetSrc);
+      }
+      imgEl.setAttribute(
+        'alt',
+        this.getAttribute('image-alt') || `${itemName} served in a ceramic cup`
+      );
+    }
+
+    // Favorite button state & accessible label
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    const favIcon = this.shadowRoot.querySelector('.fav-icon');
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(isFav));
+      favBtn.setAttribute(
+        'aria-label',
+        isFav ? `Remove ${itemName} from favorites` : `Save ${itemName} to favorites`
+      );
+      favBtn.disabled = isDisabled;
+    }
+    if (favIcon) {
+      favIcon.textContent = isFav ? '♥' : '♡';
+    }
+
+    // Tasting notes panel & button
+    const notesText = this.shadowRoot.querySelector('.notes-text');
+    const notesPanel = this.shadowRoot.querySelector('.details-panel');
+    const notesBtn = this.shadowRoot.querySelector('.notes-toggle');
+    const hasNotes = Boolean(this.notes);
+
+    if (notesText) {
+      notesText.textContent = this.notes || 'Balanced body, smooth crema, clean finish.';
+    }
+    if (notesPanel) {
+      notesPanel.dataset.open = String(this.#notesExpanded);
+    }
+    if (notesBtn) {
+      notesBtn.hidden = !hasNotes;
+      notesBtn.setAttribute('aria-expanded', String(this.#notesExpanded));
+      notesBtn.setAttribute('aria-label', `Tasting notes for ${itemName}`);
+      notesBtn.textContent = this.#notesExpanded ? 'Hide Notes' : 'Tasting Notes';
+      notesBtn.disabled = isDisabled;
+    }
+
+    // Action CTA button
+    const actionBtn = this.shadowRoot.querySelector('.action-btn');
+    const ctaText = this.shadowRoot.querySelector('.cta-text');
+    if (actionBtn) {
+      actionBtn.disabled = isDisabled;
+    }
+    if (ctaText) {
+      ctaText.textContent =
+        this.#cartCount > 0 ? `Add Another (${this.#cartCount} in bag)` : 'Add to Order';
+    }
+
+    // Link
+    const linkEl = this.shadowRoot.querySelector('.details-link');
+    if (linkEl) {
+      linkEl.setAttribute('href', this.href);
+      linkEl.setAttribute('aria-label', `View details for ${itemName}`);
+    }
+  }
+}
