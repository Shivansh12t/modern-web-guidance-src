+/**
+ * The Daily Grind — Reusable, Accessible Web Components
+ *
+ * Components included:
+ * 1. <coffee-card>: Encapsulated product card with Shadow DOM, slots, adoptedStyleSheets,
+ *    container queries, @layer, ::part, private custom property aliases, and custom states (:state(favorited), :state(in-cart)).
+ * 2. <roast-selector>: Interactive, accessible category/roast filter widget using ElementInternals ARIA mixin
+ *    and keyboard navigation.
+ * 3. <grind-selector>: Form-Associated Custom Element (FACE) for selecting coffee grind or size in quick-order forms.
+ * 4. <order-summary>: Interactive cart and quick-order feedback bar listening to card events.
+ */
+
+const supportsAdoptedStyleSheets =
+  'adoptedStyleSheets' in Document.prototype &&
+  'replaceSync' in CSSStyleSheet.prototype;
+
+const supportsCustomStates =
+  typeof ElementInternals !== 'undefined' &&
+  'states' in ElementInternals.prototype;
+
+const supportsFACE =
+  'attachInternals' in HTMLElement.prototype &&
+  typeof ElementInternals !== 'undefined' &&
+  'setFormValue' in ElementInternals.prototype;
+
+const supportsAriaReflection =
+  typeof ElementInternals !== 'undefined' &&
+  'role' in ElementInternals.prototype;
