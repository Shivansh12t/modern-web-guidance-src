+let coffeeCardSheet = null;
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article class="card" part="card">
+    <div class="media-wrap" part="media">
+      <img class="media-img" part="image" src="" alt="" loading="lazy" />
+      <div class="badge-wrap">
+        <span class="roast-pill" part="roast-badge"></span>
+        <slot name="badge"></slot>
+      </div>
+      <button type="button" class="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Save to favorites">
+        <span aria-hidden="true" class="fav-icon">♡</span>
+      </button>
+    </div>
+    <div class="content" part="body">
+      <div class="header-row">
+        <slot name="title"><h3 class="fallback-title"></h3></slot>
+        <span class="price" part="price"></span>
+      </div>
+      <div class="description">
+        <slot></slot>
+      </div>
+      <div class="details-panel" id="tasting-panel" part="details-panel">
+        <strong>Tasting Notes:</strong> <span class="notes-text"></span>
+      </div>
+      <div class="actions" part="actions">
+        <button type="button" class="action-btn" part="cta">
+          <span class="cta-text">Add to Order</span>
+        </button>
+        <button type="button" class="notes-toggle" part="notes-button" aria-expanded="false" aria-controls="tasting-panel">
+          Notes
+        </button>
+        <a class="details-link" part="link" href="/menu">View Details</a>
+      </div>
+      <div class="sr-status" role="status" aria-live="polite"></div>
+    </div>
+  </article>
