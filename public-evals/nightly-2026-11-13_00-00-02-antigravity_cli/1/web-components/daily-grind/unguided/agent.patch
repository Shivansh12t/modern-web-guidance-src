+  </style>
+
+  <section aria-labelledby="menu-heading">
+    <div class="section-header">
+      <h2 id="menu-heading" part="heading">Seasonal Favorites</h2>
+      <p class="subtitle" part="subtitle">Crafted with freshly roasted single-origin and signature blends.</p>
