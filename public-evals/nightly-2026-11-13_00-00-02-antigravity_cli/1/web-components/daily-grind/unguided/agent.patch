+      align-items: center;
+    }
+
+    .fallback-list a,
+    ::slotted(a) {
+      color: #ffffff;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.25s ease;
+    }
+
+    .fallback-list a:hover,
+    ::slotted(a:hover) {
+      color: var(--nav-accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--nav-accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    @media (max-width: 720px) {
+      .brand-row {
+        width: 100%;
+      }
+
+      .menu-toggle {
+        display: inline-flex;
+        align-items: center;
+        gap: 6px;
+      }
+
+      .nav-links {
+        display: none;
+        width: 100%;
+        padding-top: 10px;
+      }
+
+      .nav-links[data-open="true"] {
+        display: flex;
+        flex-direction: column;
+        align-items: flex-start;
+      }
+
+      .fallback-list {
+        flex-direction: column;
+        align-items: flex-start;
+      }
+    }
+  </style>
+
+  <nav aria-label="Primary Navigation">
+    <div class="brand-row">
+      <a href="/" class="logo" part="logo">THE DAILY GRIND</a>
+      <button
+        type="button"
+        class="menu-toggle"
+        aria-expanded="false"
+        aria-controls="primary-nav-links"
+        aria-label="Toggle navigation menu"
+      >
+        Menu
+      </button>
+    </div>
+
+    <div class="nav-links" id="primary-nav-links" data-open="false">
+      <slot>
+        <ul class="fallback-list">
+          <li><a href="/menu">Menu</a></li>
+          <li><a href="/locations">Locations</a></li>
+          <li><a href="/rewards">Rewards</a></li>
+          <li><a href="/account">My Account</a></li>
+          <li><a href="/logout" class="logout-link">Logout</a></li>
+        </ul>
+      </slot>
+    </div>
+  </nav>
+`;
+
+export class DgNavbar extends HTMLElement {
+  static get observedAttributes() {
+    return ['brand'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._open = false;
+    this._els = {
+      logo: this.shadowRoot.querySelector('.logo'),
+      toggle: this.shadowRoot.querySelector('.menu-toggle'),
+      links: this.shadowRoot.querySelector('.nav-links'),
+    };
+
+    this._onToggle = this._onToggle.bind(this);
+  }
+
+  connectedCallback() {
+    this._els.toggle.addEventListener('click', this._onToggle);
+    if (this.hasAttribute('brand')) {
+      this._els.logo.textContent = this.getAttribute('brand');
+    }
+  }
+
+  disconnectedCallback() {
+    this._els.toggle.removeEventListener('click', this._onToggle);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (name === 'brand' && oldVal !== newVal && this._els.logo) {
+      this._els.logo.textContent = newVal || 'THE DAILY GRIND';
+    }
+  }
+
+  _onToggle() {
+    this._open = !this._open;
+    this._els.toggle.setAttribute('aria-expanded', String(this._open));
+    this._els.links.dataset.open = String(this._open);
+  }
+}
+
+if (!customElements.get('dg-navbar')) {
+  customElements.define('dg-navbar', DgNavbar);
+}
