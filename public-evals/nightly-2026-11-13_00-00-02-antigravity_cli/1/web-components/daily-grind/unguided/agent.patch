+const BREW_METHODS = {
+  'pour-over': {
+    label: 'Pour Over',
+    ratio: 16,
+    grind: 'Medium-Fine (sea salt)',
+    temp: '200°F (93°C)',
+    time: '3:00 – 3:30 min',
+    tip: 'Bloom with 2x coffee weight in water for 30 seconds before pouring in slow concentric circles.',
+  },
+  espresso: {
+    label: 'Espresso',
+    ratio: 2,
+    grind: 'Fine (powdered sugar)',
+    temp: '201°F (94°C)',
+    time: '25 – 30 sec',
+    tip: 'Use 18g dose per double shot with firm, level tamping for rich hazelnut crema.',
+    cupMl: 36,
+  },
+  'french-press': {
+    label: 'French Press',
+    ratio: 15,
+    grind: 'Coarse (cracked pepper)',
+    temp: '200°F (93°C)',
+    time: '4:00 min',
+    tip: 'Steep for 4 minutes, gently break the crust, skim foam, and plunge slowly.',
+  },
+  'cold-brew': {
+    label: 'Cold Brew',
+    ratio: 8,
+    grind: 'Extra Coarse',
+    temp: 'Cold Filtered Water',
+    time: '18 hours',
+    tip: 'Steep covered at room temperature or refrigerated for 18 hours, then dilute 1:1 over ice.',
+  },
+};
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      --brew-primary: var(--primary, #4e342e);
+      --brew-secondary: var(--secondary, #d7ccc8);
+      --brew-accent: var(--accent, #ffab40);
+      --brew-text: var(--text, #3e2723);
+      margin: 48px 0;
+    }
+
+    .brew-section {
+      background: #ffffff;
+      border-radius: 14px;
+      padding: 32px;
+      box-shadow: 0 4px 16px rgba(62, 39, 35, 0.09);
+      border: 1px solid rgba(78, 52, 46, 0.12);
+    }
+
+    .header {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    h2 {
+      color: var(--brew-primary);
+      margin: 0 0 8px;
+      font-size: 1.85rem;
+    }
+
+    .header p {
+      margin: 0;
+      color: #5d4037;
+    }
+
+    .method-tabs {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 10px;
+      margin-bottom: 28px;
+    }
+
+    .method-btn {
+      padding: 10px 18px;
+      border-radius: 8px;
+      border: 1px solid var(--brew-secondary);
+      background: #fafafa;
+      color: var(--brew-text);
+      font-weight: 600;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: all 0.2s ease;
+      font-family: inherit;
+    }
+
+    .method-btn[aria-selected="true"] {
+      background: var(--brew-primary);
+      color: #ffffff;
+      border-color: var(--brew-primary);
+    }
+
+    .method-btn:focus-visible,
+    .cups-range:focus-visible {
+      outline: 3px solid var(--brew-accent);
+      outline-offset: 2px;
+    }
+
+    .calculator-body {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+      gap: 24px;
+      align-items: center;
+    }
+
+    .slider-box {
+      background: #fbf8f6;
+      padding: 20px;
+      border-radius: 10px;
+      border: 1px solid rgba(78, 52, 46, 0.1);
+    }
+
+    .slider-label {
+      display: flex;
+      justify-content: space-between;
+      font-weight: 700;
+      margin-bottom: 10px;
+      color: var(--brew-primary);
+    }
+
+    .cups-range {
+      width: 100%;
+      accent-color: var(--brew-primary);
+      cursor: pointer;
+    }
+
+    .tip-box {
+      margin-top: 16px;
+      font-size: 0.9rem;
+      color: #4e342e;
+      background: #fff8e1;
+      border-left: 4px solid var(--brew-accent);
+      padding: 10px 12px;
+      border-radius: 0 6px 6px 0;
+    }
