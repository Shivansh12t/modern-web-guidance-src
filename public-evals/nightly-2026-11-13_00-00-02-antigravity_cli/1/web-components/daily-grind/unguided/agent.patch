+        <a href="/order-online" class="checkout-btn">Proceed to Pickup Checkout</a>
+      </div>
+    </div>
+  </div>
+`;
+
+export class OrderDrawer extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._items = new Map();
+    this._isOpen = false;
+
+    this._els = {
+      trigger: this.shadowRoot.querySelector('.floating-trigger'),
+      badge: this.shadowRoot.querySelector('.badge-count'),
+      backdrop: this.shadowRoot.querySelector('.backdrop'),
+      closeBtn: this.shadowRoot.querySelector('.close-btn'),
+      emptyMsg: this.shadowRoot.querySelector('.empty-msg'),
+      itemList: this.shadowRoot.querySelector('.item-list'),
+      subtotalVal: this.shadowRoot.querySelector('.subtotal-val'),
+      pointsVal: this.shadowRoot.querySelector('.points-val'),
+    };
+
+    this._onAddEvent = this._onAddEvent.bind(this);
+    this._onTriggerClick = this._onTriggerClick.bind(this);
+    this._onClose = this._onClose.bind(this);
+    this._onBackdropClick = this._onBackdropClick.bind(this);
+    this._onKeyDown = this._onKeyDown.bind(this);
+  }
+
+  connectedCallback() {
+    document.addEventListener('coffee-add-to-cart', this._onAddEvent);
+    this._els.trigger.addEventListener('click', this._onTriggerClick);
+    this._els.closeBtn.addEventListener('click', this._onClose);
+    this._els.backdrop.addEventListener('click', this._onBackdropClick);
+    document.addEventListener('keydown', this._onKeyDown);
+    this._render();
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('coffee-add-to-cart', this._onAddEvent);
+    this._els.trigger.removeEventListener('click', this._onTriggerClick);
+    this._els.closeBtn.removeEventListener('click', this._onClose);
+    this._els.backdrop.removeEventListener('click', this._onBackdropClick);
+    document.removeEventListener('keydown', this._onKeyDown);
+  }
+
+  _onAddEvent(event) {
+    const detail = event.detail;
+    if (!detail || !detail.id) return;
+
+    const existing = this._items.get(detail.id);
+    if (existing) {
+      existing.quantity += 1;
+    } else {
+      this._items.set(detail.id, {
+        ...detail,
+        quantity: 1,
+      });
+    }
+
+    this._render();
+  }
+
+  _onTriggerClick() {
+    this._setOpen(!this._isOpen);
+  }
+
+  _onClose() {
+    this._setOpen(false);
+    this._els.trigger.focus();
+  }
+
+  _onBackdropClick(event) {
+    if (event.target === this._els.backdrop) {
+      this._onClose();
+    }
+  }
+
+  _onKeyDown(event) {
+    if (event.key === 'Escape' && this._isOpen) {
+      this._onClose();
+    }
+  }
+
+  _setOpen(open) {
+    this._isOpen = open;
+    this._els.backdrop.hidden = !open;
+    this._els.trigger.setAttribute('aria-expanded', String(open));
+    if (open) {
+      this._els.closeBtn.focus();
+    }
+  }
+
+  _changeQty(id, delta) {
+    const entry = this._items.get(id);
+    if (!entry) return;
+    entry.quantity += delta;
+    if (entry.quantity <= 0) {
+      this._items.delete(id);
+    }
+    this._render();
+  }
+
+  _render() {
+    let totalCount = 0;
+    let subtotal = 0;
+
+    this._els.itemList.innerHTML = '';
+
+    this._items.forEach((item) => {
+      totalCount += item.quantity;
+      subtotal += item.price * item.quantity;
+
+      const li = document.createElement('li');
+      li.className = 'item';
+      li.innerHTML = `
+        <div class="item-info">
+          <h4></h4>
+          <div class="item-meta"></div>
+        </div>
+        <div class="qty-controls">
+          <button type="button" class="qty-btn dec-btn" aria-label="Decrease quantity">-</button>
+          <span class="qty-val" aria-live="polite"></span>
+          <button type="button" class="qty-btn inc-btn" aria-label="Increase quantity">+</button>
+        </div>
+      `;
+
+      li.querySelector('h4').textContent = item.name;
+      li.querySelector('.item-meta').textContent = `${item.sizeLabel} • $${item.price.toFixed(2)} each`;
+      li.querySelector('.qty-val').textContent = String(item.quantity);
+
+      li.querySelector('.dec-btn').addEventListener('click', () =>
+        this._changeQty(item.id, -1)
+      );
+      li.querySelector('.inc-btn').addEventListener('click', () =>
+        this._changeQty(item.id, 1)
+      );
+
+      this._els.itemList.appendChild(li);
+    });
+
+    this._els.badge.textContent = String(totalCount);
+    this._els.emptyMsg.hidden = totalCount > 0;
+    this._els.subtotalVal.textContent = `$${subtotal.toFixed(2)}`;
+    this._els.pointsVal.textContent = String(Math.round(subtotal * 2));
+  }
+}
+
+if (!customElements.get('order-drawer')) {
+  customElements.define('order-drawer', OrderDrawer);
+}
