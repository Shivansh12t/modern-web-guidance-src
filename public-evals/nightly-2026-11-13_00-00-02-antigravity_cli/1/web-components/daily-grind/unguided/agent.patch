+    .metric-label {
+      display: block;
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      color: #6d4c41;
+      margin-bottom: 4px;
+    }
+
+    .metric-value {
+      font-size: 1.15rem;
+      font-weight: 700;
+      color: var(--brew-primary);
+    }
+  </style>
+
+  <section class="brew-section" aria-labelledby="brew-heading">
+    <div class="header">
