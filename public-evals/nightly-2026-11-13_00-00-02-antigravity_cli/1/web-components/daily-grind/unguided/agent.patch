+        </button>
+        <button type="button" role="tab" class="filter-btn" data-filter="seasonal" aria-selected="false" tabindex="-1">
+          Seasonal
+        </button>
+        <button type="button" role="tab" class="filter-btn" data-filter="espresso" aria-selected="false" tabindex="-1">
+          Espresso
+        </button>
+        <button type="button" role="tab" class="filter-btn" data-filter="cold-brew" aria-selected="false" tabindex="-1">
+          Cold Brew
+        </button>
+        <button type="button" role="tab" class="filter-btn" data-filter="favorites" aria-selected="false" tabindex="-1">
