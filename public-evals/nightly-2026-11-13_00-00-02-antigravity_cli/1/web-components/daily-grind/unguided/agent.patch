+`;
+
+export class CoffeeMenu extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'subtitle', 'active-filter'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._activeFilter = 'all';
+    this._searchQuery = '';
+
+    this._els = {
+      heading: this.shadowRoot.querySelector('#menu-heading'),
+      subtitle: this.shadowRoot.querySelector('.subtitle'),
+      tabList: this.shadowRoot.querySelector('.filter-tabs'),
+      tabs: Array.from(this.shadowRoot.querySelectorAll('.filter-btn')),
+      searchInput: this.shadowRoot.querySelector('.search-input'),
+      status: this.shadowRoot.querySelector('.results-status'),
+      slot: this.shadowRoot.querySelector('slot'),
+      emptyState: this.shadowRoot.querySelector('.empty-state'),
+      resetBtn: this.shadowRoot.querySelector('.reset-btn'),
+    };
+
+    this._onTabClick = this._onTabClick.bind(this);
+    this._onTabKeyDown = this._onTabKeyDown.bind(this);
+    this._onSearchInput = this._onSearchInput.bind(this);
+    this._onReset = this._onReset.bind(this);
+    this._onSlotChange = this._onSlotChange.bind(this);
+    this._onFavoriteToggle = this._onFavoriteToggle.bind(this);
+  }
+
+  connectedCallback() {
+    this._els.tabs.forEach((tab) =>
+      tab.addEventListener('click', this._onTabClick)
+    );
+    this._els.tabList.addEventListener('keydown', this._onTabKeyDown);
+    this._els.searchInput.addEventListener('input', this._onSearchInput);
+    this._els.resetBtn.addEventListener('click', this._onReset);
+    this._els.slot.addEventListener('slotchange', this._onSlotChange);
+    this.addEventListener('coffee-favorite', this._onFavoriteToggle);
+
+    this._syncAttributes();
+    this._applyFilter();
+  }
+
+  disconnectedCallback() {
+    this._els.tabs.forEach((tab) =>
+      tab.removeEventListener('click', this._onTabClick)
+    );
+    this._els.tabList.removeEventListener('keydown', this._onTabKeyDown);
+    this._els.searchInput.removeEventListener('input', this._onSearchInput);
+    this._els.resetBtn.removeEventListener('click', this._onReset);
+    this._els.slot.removeEventListener('slotchange', this._onSlotChange);
+    this.removeEventListener('coffee-favorite', this._onFavoriteToggle);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.isConnected) {
+      this._syncAttributes();
+      this._applyFilter();
+    }
+  }
+
+  _syncAttributes() {
+    if (this.hasAttribute('heading')) {
+      this._els.heading.textContent = this.getAttribute('heading');
+    }
+    if (this.hasAttribute('subtitle')) {
+      this._els.subtitle.textContent = this.getAttribute('subtitle');
+    }
+    if (this.hasAttribute('active-filter')) {
+      this._activeFilter = this.getAttribute('active-filter') || 'all';
+    }
+  }
+
+  _getSlottedCards() {
+    return this._els.slot
+      .assignedElements({ flatten: true })
+      .filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+  }
+
+  _onSlotChange() {
+    this._applyFilter();
+  }
+
+  _onFavoriteToggle() {
+    if (this._activeFilter === 'favorites') {
+      this._applyFilter();
+    }
+  }
+
+  _onTabClick(event) {
+    const filter = event.currentTarget.dataset.filter || 'all';
+    this._setActiveFilter(filter);
+  }
+
+  _onTabKeyDown(event) {
+    const currentIndex = this._els.tabs.indexOf(
+      this.shadowRoot.activeElement
+    );
+    if (currentIndex === -1) return;
+
+    let nextIndex = currentIndex;
+    if (event.key === 'ArrowRight') {
+      nextIndex = (currentIndex + 1) % this._els.tabs.length;
+    } else if (event.key === 'ArrowLeft') {
+      nextIndex =
+        (currentIndex - 1 + this._els.tabs.length) % this._els.tabs.length;
+    } else if (event.key === 'Home') {
+      nextIndex = 0;
+    } else if (event.key === 'End') {
+      nextIndex = this._els.tabs.length - 1;
+    } else {
+      return;
+    }
+
+    event.preventDefault();
+    const targetTab = this._els.tabs[nextIndex];
+    targetTab.focus();
+    this._setActiveFilter(targetTab.dataset.filter || 'all');
+  }
+
+  _onSearchInput(event) {
+    this._searchQuery = (event.target.value || '').trim().toLowerCase();
+    this._applyFilter();
+  }
+
+  _onReset() {
+    this._els.searchInput.value = '';
+    this._searchQuery = '';
+    this._setActiveFilter('all');
+  }
+
+  _setActiveFilter(filter) {
+    this._activeFilter = filter;
+    this._els.tabs.forEach((tab) => {
+      const isSelected = tab.dataset.filter === filter;
+      tab.setAttribute('aria-selected', String(isSelected));
+      tab.setAttribute('tabindex', isSelected ? '0' : '-1');
+    });
+    this._applyFilter();
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-filter-change', {
+        bubbles: true,
+        composed: true,
+        detail: { filter, query: this._searchQuery },
+      })
+    );
+  }
+
+  _applyFilter() {
+    const cards = this._getSlottedCards();
+    let visibleCount = 0;
+
+    cards.forEach((card) => {
+      const category = (card.getAttribute('category') || '').toLowerCase();
+      const name = (
+        card.getAttribute('name') ||
+        card.getAttribute('title') ||
+        ''
+      ).toLowerCase();
+      const desc = (
+        card.getAttribute('description') ||
+        card.textContent ||
+        ''
+      ).toLowerCase();
+      const notes = (card.getAttribute('notes') || '').toLowerCase();
+      const isFav = card.hasAttribute('favorited');
+
+      const matchesCategory =
+        this._activeFilter === 'all' ||
+        (this._activeFilter === 'favorites' && isFav) ||
+        category === this._activeFilter;
+
+      const matchesSearch =
+        !this._searchQuery ||
+        name.includes(this._searchQuery) ||
+        desc.includes(this._searchQuery) ||
+        notes.includes(this._searchQuery);
+
+      const visible = matchesCategory && matchesSearch;
+      card.hidden = !visible;
+      if (visible) visibleCount++;
+    });
+
+    this._els.emptyState.hidden = visibleCount > 0 || cards.length === 0;
+    this._els.status.textContent =
+      cards.length > 0
+        ? `Showing ${visibleCount} of ${cards.length} artisanal drinks`
+        : '';
+  }
+}
+
+if (!customElements.get('coffee-menu')) {
+  customElements.define('coffee-menu', CoffeeMenu);
+}
