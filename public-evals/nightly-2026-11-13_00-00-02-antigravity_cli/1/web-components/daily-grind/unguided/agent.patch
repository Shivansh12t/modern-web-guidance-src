+    type="button"
+    class="floating-trigger"
+    aria-haspopup="dialog"
+    aria-expanded="false"
+    aria-label="Open coffee order summary"
+  >
+    <span>Your Cup Order</span>
+    <span class="badge-count" aria-live="polite">0</span>
+  </button>
+
+  <div class="backdrop" hidden>
+    <div
+      class="drawer"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="drawer-title"
