+
+    <div class="controls" role="region" aria-label="Filter and search menu">
+      <div class="filter-tabs" role="tablist" aria-label="Coffee categories">
+        <button type="button" role="tab" class="filter-btn" data-filter="all" aria-selected="true" tabindex="0">
