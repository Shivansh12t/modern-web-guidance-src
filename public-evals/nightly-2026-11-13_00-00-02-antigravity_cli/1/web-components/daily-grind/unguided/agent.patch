+          <span class="cups-count">2 Cups</span>
+        </label>
+        <input
+          id="cups-slider"
+          class="cups-range"
+          type="range"
+          min="1"
+          max="8"
+          step="1"
+          value="2"
+          aria-valuemin="1"
+          aria-valuemax="8"
+          aria-valuenow="2"
+        />
+        <div class="tip-box">
+          <strong>Barista Tip:</strong> <span class="tip-text"></span>
+        </div>
+      </div>
+
+      <div class="metrics-grid">
+        <div class="metric-card">
+          <span class="metric-label">Coffee Dose</span>
+          <span class="metric-value dose-val">30g</span>
+        </div>
+        <div class="metric-card">
+          <span class="metric-label">Water Yield</span>
+          <span class="metric-value water-val">480 ml</span>
+        </div>
+        <div class="metric-card">
+          <span class="metric-label">Grind Setting</span>
+          <span class="metric-value grind-val">Medium-Fine</span>
+        </div>
+        <div class="metric-card">
+          <span class="metric-label">Steep / Brew Time</span>
+          <span class="metric-value time-val">3:00 – 3:30 min</span>
+        </div>
+      </div>
+    </div>
+  </section>
+`;
+
+export class BrewGuide extends HTMLElement {
+  static get observedAttributes() {
+    return ['method', 'servings'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._method = 'pour-over';
+    this._servings = 2;
+
+    this._els = {
+      tabList: this.shadowRoot.querySelector('.method-tabs'),
+      tabs: Array.from(this.shadowRoot.querySelectorAll('.method-btn')),
+      slider: this.shadowRoot.querySelector('#cups-slider'),
+      methodName: this.shadowRoot.querySelector('.method-name'),
+      cupsCount: this.shadowRoot.querySelector('.cups-count'),
+      tipText: this.shadowRoot.querySelector('.tip-text'),
+      doseVal: this.shadowRoot.querySelector('.dose-val'),
+      waterVal: this.shadowRoot.querySelector('.water-val'),
+      grindVal: this.shadowRoot.querySelector('.grind-val'),
+      timeVal: this.shadowRoot.querySelector('.time-val'),
+    };
+
+    this._onTabClick = this._onTabClick.bind(this);
+    this._onTabKeyDown = this._onTabKeyDown.bind(this);
+    this._onSliderInput = this._onSliderInput.bind(this);
+  }
+
+  connectedCallback() {
+    this._els.tabs.forEach((tab) =>
+      tab.addEventListener('click', this._onTabClick)
+    );
+    this._els.tabList.addEventListener('keydown', this._onTabKeyDown);
+    this._els.slider.addEventListener('input', this._onSliderInput);
+
+    if (this.hasAttribute('method')) {
+      const m = this.getAttribute('method');
+      if (BREW_METHODS[m]) this._method = m;
+    }
+    if (this.hasAttribute('servings')) {
+      const s = parseInt(this.getAttribute('servings'), 10);
+      if (Number.isFinite(s) && s >= 1 && s <= 8) {
+        this._servings = s;
+        this._els.slider.value = String(s);
+      }
+    }
+
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._els.tabs.forEach((tab) =>
+      tab.removeEventListener('click', this._onTabClick)
+    );
+    this._els.tabList.removeEventListener('keydown', this._onTabKeyDown);
+    this._els.slider.removeEventListener('input', this._onSliderInput);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal || !this.isConnected) return;
+    if (name === 'method' && BREW_METHODS[newVal]) {
+      this._method = newVal;
+    } else if (name === 'servings') {
+      const s = parseInt(newVal, 10);
+      if (Number.isFinite(s) && s >= 1 && s <= 8) {
+        this._servings = s;
+        this._els.slider.value = String(s);
+      }
+    }
+    this._render();
+  }
+
+  _onTabClick(event) {
+    const method = event.currentTarget.dataset.method;
+    if (!method || !BREW_METHODS[method]) return;
+    this._method = method;
+    this._render();
+  }
+
+  _onTabKeyDown(event) {
+    const currentIndex = this._els.tabs.indexOf(this.shadowRoot.activeElement);
+    if (currentIndex === -1) return;
+
+    let nextIndex = currentIndex;
+    if (event.key === 'ArrowRight') {
+      nextIndex = (currentIndex + 1) % this._els.tabs.length;
+    } else if (event.key === 'ArrowLeft') {
+      nextIndex =
+        (currentIndex - 1 + this._els.tabs.length) % this._els.tabs.length;
+    } else {
+      return;
+    }
+
+    event.preventDefault();
+    const nextTab = this._els.tabs[nextIndex];
+    nextTab.focus();
+    this._method = nextTab.dataset.method;
+    this._render();
+  }
+
+  _onSliderInput(event) {
+    this._servings = parseInt(event.target.value, 10) || 1;
+    this._els.slider.setAttribute('aria-valuenow', String(this._servings));
+    this._render();
+  }
+
+  _render() {
+    const config = BREW_METHODS[this._method] || BREW_METHODS['pour-over'];
+
+    this._els.tabs.forEach((tab) => {
+      const selected = tab.dataset.method === this._method;
+      tab.setAttribute('aria-selected', String(selected));
+      tab.setAttribute('tabindex', selected ? '0' : '-1');
+    });
+
+    const isEspresso = this._method === 'espresso';
+    const unitLabel = isEspresso
+      ? `${this._servings} Double Shot${this._servings > 1 ? 's' : ''}`
+      : `${this._servings} Cup${this._servings > 1 ? 's' : ''}`;
+
+    const waterMl = isEspresso ? this._servings * 36 : this._servings * 240;
+    const coffeeGrams = Math.round(waterMl / config.ratio);
+
+    this._els.methodName.textContent = config.label;
+    this._els.cupsCount.textContent = unitLabel;
+    this._els.tipText.textContent = config.tip;
+    this._els.doseVal.textContent = `${coffeeGrams} g`;
+    this._els.waterVal.textContent = `${waterMl} ml`;
+    this._els.grindVal.textContent = config.grind;
+    this._els.timeVal.textContent = config.time;
+  }
+}
+
+if (!customElements.get('brew-guide')) {
+  customElements.define('brew-guide', BrewGuide);
+}
