+
+      <div class="actions">
+        <button type="button" class="btn btn-primary add-btn" part="add-button">
+          Add to Order
+        </button>
+        <a class="btn btn-secondary details-link" part="details-link" href="#">
+          View Details
+        </a>
+      </div>
+
+      <div class="status-toast" role="status" aria-live="polite"></div>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'name',
+      'title',
+      'description',
+      'price',
+      'category',
+      'badge',
+      'roast',
+      'notes',
+      'calories',
+      'image',
+      'href',
+      'favorited',
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._selectedSize = 'M';
+    this._detailsOpen = false;
+    this._toastTimer = null;
+
+    this._els = {
+      img: this.shadowRoot.querySelector('.card-img'),
+      badge: this.shadowRoot.querySelector('.badge'),
+      favBtn: this.shadowRoot.querySelector('.favorite-btn'),
+      title: this.shadowRoot.querySelector('.card-title'),
+      price: this.shadowRoot.querySelector('.price'),
+      description: this.shadowRoot.querySelector('.description'),
+      descFallback: this.shadowRoot.querySelector('.desc-fallback'),
+      slot: this.shadowRoot.querySelector('slot'),
+      metaTags: this.shadowRoot.querySelector('.meta-tags'),
+      sizeBtns: Array.from(this.shadowRoot.querySelectorAll('.size-btn')),
+      detailsToggle: this.shadowRoot.querySelector('.details-toggle'),
+      detailsPanel: this.shadowRoot.querySelector('.details-panel'),
+      detailRoast: this.shadowRoot.querySelector('.detail-roast'),
+      detailNotes: this.shadowRoot.querySelector('.detail-notes'),
+      detailCalories: this.shadowRoot.querySelector('.detail-calories'),
+      addBtn: this.shadowRoot.querySelector('.add-btn'),
+      detailsLink: this.shadowRoot.querySelector('.details-link'),
+      statusToast: this.shadowRoot.querySelector('.status-toast'),
+    };
+
+    this._onFavClick = this._onFavClick.bind(this);
+    this._onSizeClick = this._onSizeClick.bind(this);
+    this._onAddClick = this._onAddClick.bind(this);
+    this._onDetailsToggle = this._onDetailsToggle.bind(this);
+  }
+
+  connectedCallback() {
+    this._els.favBtn.addEventListener('click', this._onFavClick);
+    this._els.sizeBtns.forEach((btn) =>
+      btn.addEventListener('click', this._onSizeClick)
+    );
+    this._els.addBtn.addEventListener('click', this._onAddClick);
+    this._els.detailsToggle.addEventListener('click', this._onDetailsToggle);
+
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._els.favBtn.removeEventListener('click', this._onFavClick);
+    this._els.sizeBtns.forEach((btn) =>
+      btn.removeEventListener('click', this._onSizeClick)
+    );
+    this._els.addBtn.removeEventListener('click', this._onAddClick);
+    this._els.detailsToggle.removeEventListener('click', this._onDetailsToggle);
+    if (this._toastTimer) {
+      clearTimeout(this._toastTimer);
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) {
+      this._render();
+    }
+  }
+
+  get itemName() {
+    return this.getAttribute('name') || this.getAttribute('title') || 'Artisanal Coffee';
+  }
+
+  get basePrice() {
+    const raw = parseFloat(this.getAttribute('price') || '4.75');
+    return Number.isFinite(raw) ? raw : 4.75;
+  }
+
+  get currentPrice() {
+    const mult = SIZE_MULTIPLIERS[this._selectedSize] || SIZE_MULTIPLIERS.M;
+    return Math.max(0, this.basePrice + mult.delta);
+  }
+
+  get category() {
+    return (this.getAttribute('category') || 'all').toLowerCase();
+  }
+
+  _onFavClick() {
+    const isFav = this.hasAttribute('favorited');
+    if (isFav) {
+      this.removeAttribute('favorited');
+    } else {
+      this.setAttribute('favorited', '');
+    }
+
+    const nowFav = this.hasAttribute('favorited');
+    this._updateFavoriteUI(nowFav);
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.itemName,
+          favorited: nowFav,
+        },
+      })
+    );
+  }
+
+  _onSizeClick(event) {
+    const size = event.currentTarget.dataset.size;
+    if (!size || !SIZE_MULTIPLIERS[size]) return;
+    this._selectedSize = size;
+
+    this._els.sizeBtns.forEach((btn) => {
+      const active = btn.dataset.size === size;
+      btn.setAttribute('aria-pressed', String(active));
+    });
+
+    this._updatePriceUI();
+  }
+
+  _onAddClick() {
+    const detail = {
+      id: `${this.itemName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${this._selectedSize.toLowerCase()}`,
+      name: this.itemName,
+      size: this._selectedSize,
+      sizeLabel: SIZE_MULTIPLIERS[this._selectedSize].label,
+      price: Number(this.currentPrice.toFixed(2)),
+      image: this.getAttribute('image') || DEFAULT_IMAGE,
+      href: this.getAttribute('href') || '/menu',
+    };
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-add-to-cart', {
+        bubbles: true,
+        composed: true,
+        detail,
+      })
+    );
+
+    this._els.statusToast.textContent = `Added ${this._selectedSize} ${this.itemName} to order`;
+    if (this._toastTimer) clearTimeout(this._toastTimer);
+    this._toastTimer = setTimeout(() => {
+      this._els.statusToast.textContent = '';
+    }, 3000);
+  }
+
+  _onDetailsToggle() {
+    this._detailsOpen = !this._detailsOpen;
+    this._els.detailsPanel.hidden = !this._detailsOpen;
+    this._els.detailsToggle.setAttribute('aria-expanded', String(this._detailsOpen));
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-view-details', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.itemName,
+          open: this._detailsOpen,
+          roast: this.getAttribute('roast') || 'Medium Roast',
+          notes: this.getAttribute('notes') || 'Rich, balanced, aromatic',
+          calories: this.getAttribute('calories') || '90 kcal',
+        },
+      })
+    );
+  }
+
+  _updateFavoriteUI(isFav) {
+    this._els.favBtn.setAttribute('aria-pressed', String(isFav));
+    this._els.favBtn.setAttribute(
+      'aria-label',
+      isFav
+        ? `Remove ${this.itemName} from favorites`
+        : `Save ${this.itemName} to favorites`
+    );
+    this._els.favBtn.innerHTML = `<span aria-hidden="true">${isFav ? '&#9829;' : '&#9825;'}</span>`;
+  }
+
+  _updatePriceUI() {
+    this._els.price.textContent = `$${this.currentPrice.toFixed(2)}`;
+  }
+
+  _render() {
+    const name = this.itemName;
+    const descAttr = this.getAttribute('description');
+    const badge = this.getAttribute('badge') || this.getAttribute('category') || 'Artisanal';
+    const image = this.getAttribute('image') || DEFAULT_IMAGE;
+    const href = this.getAttribute('href') || '/menu';
+    const roast = this.getAttribute('roast') || 'Medium Roast';
+    const notes = this.getAttribute('notes') || 'Rich, balanced, aromatic';
+    const calories = this.getAttribute('calories') || '90 kcal';
+
+    this._els.title.textContent = name;
+    this._els.img.src = image;
+    this._els.img.alt = name;
+
+    this._els.badge.textContent = badge;
+    this._els.badge.hidden = !badge;
+
+    if (this._els.descFallback) {
+      this._els.descFallback.textContent = descAttr || '';
+    }
+
+    this._els.metaTags.innerHTML = '';
+    const tags = [roast, ...notes.split(',').map((s) => s.trim()).slice(0, 2)].filter(Boolean);
+    tags.forEach((tagText) => {
+      const span = document.createElement('span');
+      span.className = 'tag';
+      span.textContent = tagText;
+      this._els.metaTags.appendChild(span);
+    });
+
+    this._els.detailRoast.textContent = roast;
+    this._els.detailNotes.textContent = notes;
+    this._els.detailCalories.textContent = calories;
+
+    this._els.detailsLink.href = href;
+    this._els.detailsLink.setAttribute('aria-label', `View details for ${name}`);
+    this._els.detailsToggle.setAttribute('aria-expanded', String(this._detailsOpen));
+    this._els.addBtn.setAttribute('aria-label', `Add ${name} to order`);
+
+    this._updateFavoriteUI(this.hasAttribute('favorited'));
+    this._updatePriceUI();
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
