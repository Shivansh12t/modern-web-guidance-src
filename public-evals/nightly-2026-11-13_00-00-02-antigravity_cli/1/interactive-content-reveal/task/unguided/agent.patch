+  <script>
+    (function () {
+      const cards = document.querySelectorAll('.product-card');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const updateSpotlightPosition = (card, clientX, clientY) => {
+        const rect = card.getBoundingClientRect();
+        const x = clientX - rect.left;
+        const y = clientY - rect.top;
+        card.style.setProperty('--mouse-x', `${x}px`);
+        card.style.setProperty('--mouse-y', `${y}px`);
+
+        const reveal = card.querySelector('.spotlight-reveal');
+        if (reveal) {
+          const revealRect = reveal.getBoundingClientRect();
+          card.style.setProperty('--reveal-offset-x', `${revealRect.left - rect.left}px`);
+          card.style.setProperty('--reveal-offset-y', `${revealRect.top - rect.top}px`);
+        }
+      };
+
+      const activateSpotlight = (card) => {
+        if (reducedMotionQuery.matches) {
+          card.style.setProperty('--inner-size', '1000px');
+          card.style.setProperty('--outer-size', '1000px');
+        } else {
+          card.style.setProperty('--inner-size', '90px');
+          card.style.setProperty('--outer-size', '160px');
+        }
+      };
+
+      const deactivateSpotlight = (card) => {
+        card.style.setProperty('--inner-size', '0px');
+        card.style.setProperty('--outer-size', '0px');
+      };
+
+      cards.forEach((card) => {
+        // Initialize custom properties
+        card.style.setProperty('--mouse-x', '50%');
+        card.style.setProperty('--mouse-y', '50%');
+        card.style.setProperty('--inner-size', '0px');
+        card.style.setProperty('--outer-size', '0px');
+
+        const handleMove = (e) => {
+          updateSpotlightPosition(card, e.clientX, e.clientY);
+        };
+
+        const handleEnter = (e) => {
+          if (typeof e.clientX === 'number' && typeof e.clientY === 'number') {
+            updateSpotlightPosition(card, e.clientX, e.clientY);
+          }
+          activateSpotlight(card);
+        };
+
+        const handleLeave = () => {
+          deactivateSpotlight(card);
+        };
+
+        card.addEventListener('pointermove', handleMove);
+        card.addEventListener('mousemove', handleMove);
+        card.addEventListener('pointerenter', handleEnter);
+        card.addEventListener('mouseenter', handleEnter);
+        card.addEventListener('pointerleave', handleLeave);
+        card.addEventListener('mouseleave', handleLeave);
+
+        card.addEventListener('focusin', () => {
+          const rect = card.getBoundingClientRect();
+          updateSpotlightPosition(card, rect.left + rect.width / 2, rect.top + rect.height / 2);
+          activateSpotlight(card);
+        });
+
+        card.addEventListener('focusout', (e) => {
+          if (!card.contains(e.relatedTarget)) {
+            deactivateSpotlight(card);
+          }
+        });
+      });
+    })();
+  </script>
