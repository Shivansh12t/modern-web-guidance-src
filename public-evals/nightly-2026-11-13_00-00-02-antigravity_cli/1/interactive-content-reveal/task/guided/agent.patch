+  <script>
+    document.querySelectorAll('.product-card').forEach((card) => {
+      // Store the card's bounding rect
+      let rect = card.getBoundingClientRect();
+
+      // Update the rect when the card is resized
+      const resizeObserver = new ResizeObserver(() => {
+        rect = card.getBoundingClientRect();
+      });
+      resizeObserver.observe(card);
+
+      card.addEventListener('pointerenter', () => {
+        rect = card.getBoundingClientRect();
+      });
+
+      const updatePointerPosition = (e) => {
+        if (!rect.width || !rect.height) {
+          rect = card.getBoundingClientRect();
+        }
+        // Calculate position as a percentage of the card
+        const x = ((e.clientX - rect.left) / rect.width) * 100;
+        const y = ((e.clientY - rect.top) / rect.height) * 100;
+
+        // Update the position properties
+        card.style.setProperty('--mouse-x', `${x}%`);
+        card.style.setProperty('--mouse-y', `${y}%`);
+      };
+
+      card.addEventListener('pointermove', updatePointerPosition);
+    });
+  </script>
