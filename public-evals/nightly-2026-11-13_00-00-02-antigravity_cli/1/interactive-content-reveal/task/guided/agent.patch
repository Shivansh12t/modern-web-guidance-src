+        black var(--inner-size, 0%),
+        transparent var(--outer-size, 0%)
+      );
+
+      /* Ensure the mask doesn't repeat if the element is large */
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+
+      /* Make the mask layer non-interactive */
+      pointer-events: none;
+    }
