+  <script>
+    (function () {
+      const initialOrders = {
+        queued: [
+          {
+            id: 'ord-101',
+            number: '#101',
+            drink: 'Maple Oat Latte',
+            size: '16oz',
+            customer: 'Maya Lin',
+            notes: 'Extra hot, light foam',
+            time: '2m ago'
+          },
+          {
+            id: 'ord-102',
+            number: '#102',
+            drink: 'Iced Matcha Cortado',
+            size: '12oz',
+            customer: 'Devon Brooks',
+            notes: 'Almond milk, half sweet',
+            time: '1m ago'
+          },
+          {
+            id: 'ord-103',
+            number: '#103',
+            drink: 'Double Espresso Macchiato',
+            size: '8oz',
+            customer: 'Elena Rostova',
+            notes: 'Single origin Ethiopian',
+            time: 'Just now'
+          }
+        ],
+        brewing: [
+          {
+            id: 'ord-099',
+            number: '#099',
+            drink: 'Cold Brew Tonic',
+            size: '16oz',
+            customer: 'Liam Carter',
+            notes: 'Express bar, orange peel',
+            time: '4m ago'
+          },
+          {
+            id: 'ord-100',
+            number: '#100',
+            drink: 'Honey Cinnamon Flat White',
+            size: '12oz',
+            customer: 'Sofia Patel',
+            notes: 'Oat milk, cinnamon dusting',
+            time: '3m ago'
+          }
+        ],
+        ready: [
+          {
+            id: 'ord-097',
+            number: '#097',
+            drink: 'Dark Roast Pour Over',
+            size: '12oz',
+            customer: 'Noah Kim',
+            notes: 'Black, for here cup',
+            time: '7m ago'
+          },
+          {
+            id: 'ord-098',
+            number: '#098',
+            drink: 'Caramel Cardamom Latte',
+            size: '16oz',
+            customer: 'Chloe Vance',
+            notes: 'Whipped cream, mobile pickup',
+            time: '5m ago'
+          }
+        ]
+      };
+
+      // Isolated column controllers so each column manages and renders only its own state
+      const columnControllers = {};
+      let activeDrag = null;
+
+      function createCardElement(order, status) {
+        const card = document.createElement('article');
+        card.className = 'card';
+        card.draggable = true;
+        card.id = order.id;
+        card.dataset.orderId = order.id;
+        card.dataset.status = status;
+
+        card.innerHTML = `
+          <div class="order-meta">
+            <span class="order-id">${order.number} &bull; ${order.size}</span>
+            <span>${order.time}</span>
+          </div>
+          <h3>${order.drink}</h3>
+          <div class="order-customer">For: ${order.customer}</div>
+          <p class="order-notes">${order.notes}</p>
+        `;
+
+        card.addEventListener('dragstart', (e) => {
+          const currentStatus = card.dataset.status;
+          activeDrag = {
+            orderId: order.id,
+            sourceStatus: currentStatus
+          };
+          card.classList.add('dragging');
+          if (e.dataTransfer) {
+            e.dataTransfer.effectAllowed = 'move';
+            e.dataTransfer.setData('text/plain', order.id);
+          }
+        });
+
+        card.addEventListener('dragend', () => {
+          card.classList.remove('dragging');
+          document.querySelectorAll('.board-column.drag-over').forEach((col) => {
+            col.classList.remove('drag-over');
+          });
+          activeDrag = null;
+        });
+
+        return card;
+      }
+
+      class IsolatedColumn {
+        constructor(columnEl, status, orders) {
+          this.columnEl = columnEl;
+          this.status = status;
+          this.orders = orders.slice();
+          this.cardsContainer = columnEl.querySelector('[data-cards-for="' + status + '"]');
+          this.countBadge = columnEl.querySelector('[data-count-for="' + status + '"]');
+          this.cardNodes = new Map();
+
+          this.bindEvents();
+          this.render();
+        }
+
+        bindEvents() {
+          this.columnEl.addEventListener('dragover', (e) => {
+            e.preventDefault();
+            if (e.dataTransfer) {
+              e.dataTransfer.dropEffect = 'move';
+            }
+            if (!this.columnEl.classList.contains('drag-over')) {
+              this.columnEl.classList.add('drag-over');
+            }
+          });
+
+          this.columnEl.addEventListener('dragleave', (e) => {
+            if (!this.columnEl.contains(e.relatedTarget)) {
+              this.columnEl.classList.remove('drag-over');
+            }
+          });
+
+          this.columnEl.addEventListener('drop', (e) => {
+            e.preventDefault();
+            this.columnEl.classList.remove('drag-over');
+
+            const droppedOrderId =
+              (activeDrag && activeDrag.orderId) ||
+              (e.dataTransfer && e.dataTransfer.getData('text/plain'));
+
+            if (!droppedOrderId) return;
+
+            let sourceStatus = activeDrag && activeDrag.sourceStatus;
+            if (!sourceStatus) {
+              for (const key of Object.keys(columnControllers)) {
+                if (columnControllers[key].hasOrder(droppedOrderId)) {
+                  sourceStatus = key;
+                  break;
+                }
+              }
+            }
+
+            if (!sourceStatus || sourceStatus === this.status) {
+              return;
+            }
+
+            const sourceColumn = columnControllers[sourceStatus];
+            const movedOrder = sourceColumn.removeOrder(droppedOrderId);
+            if (movedOrder) {
+              this.addOrder(movedOrder);
+            }
+          });
+        }
+
+        hasOrder(orderId) {
+          return this.orders.some((o) => o.id === orderId);
+        }
+
+        removeOrder(orderId) {
+          const idx = this.orders.findIndex((o) => o.id === orderId);
+          if (idx === -1) return null;
+          const [removed] = this.orders.splice(idx, 1);
+          this.render();
+          return removed;
+        }
+
+        addOrder(order) {
+          this.orders.push(order);
+          this.render();
+        }
+
+        // Renders only this column's DOM nodes and count badge in complete isolation
+        render() {
+          this.countBadge.textContent = String(this.orders.length);
+
+          const currentIds = new Set(this.orders.map((o) => o.id));
+          for (const [id, node] of this.cardNodes.entries()) {
+            if (!currentIds.has(id)) {
+              if (node.parentNode === this.cardsContainer) {
+                this.cardsContainer.removeChild(node);
+              }
+              this.cardNodes.delete(id);
+            }
+          }
+
+          this.orders.forEach((order) => {
+            let node = this.cardNodes.get(order.id);
+            if (!node) {
+              node = createCardElement(order, this.status);
+              this.cardNodes.set(order.id, node);
+              this.cardsContainer.appendChild(node);
+            } else {
+              node.dataset.status = this.status;
+              node.classList.remove('dragging');
+              if (node.parentNode !== this.cardsContainer) {
+                this.cardsContainer.appendChild(node);
+              }
+            }
+          });
+        }
+      }
+
+      ['queued', 'brewing', 'ready'].forEach((status) => {
+        const colEl = document.querySelector('.board-column[data-status="' + status + '"]');
+        if (colEl) {
+          columnControllers[status] = new IsolatedColumn(colEl, status, initialOrders[status] || []);
+        }
+      });
+    })();
+  </script>
 </body>
 
