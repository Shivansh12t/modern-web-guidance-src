+        if (pointerState.handle) {
+          pointerState.handle.classList.add('dragging');
+        }
+        document.documentElement.classList.add('is-dragging');
+      }
+
+      pointerState.card.style.translate = `${dx}px ${dy}px`;
+
+      // Hit-test destination column underneath the dragged card
+      const prevPointerEvents = pointerState.card.style.pointerEvents;
+      pointerState.card.style.pointerEvents = 'none';
+      const hitEl = document.elementFromPoint(event.clientX, event.clientY);
+      pointerState.card.style.pointerEvents = prevPointerEvents;
+
+      const hoveredColumn = hitEl?.closest('.board-column');
+      clearDropIndicators();
+      if (hoveredColumn) {
+        pointerState.targetColumn = hoveredColumn;
+        hoveredColumn.classList.add('drag-over');
+        hoveredColumn.setAttribute('data-drop-target', 'true');
+        const refCard = findReferenceCardInColumn(hoveredColumn, event.clientY, pointerState.card);
+        pointerState.referenceCard = refCard;
+        if (refCard) {
+          refCard.classList.add('drop-before');
+        }
+      }
+    });
+
+    document.addEventListener('pointerup', (event) => {
+      if (!pointerState || event.pointerId !== pointerState.pointerId) return;
+      const { card, handle, active, targetColumn, referenceCard } = pointerState;
+      cleanupPointerDrag(true);
+
+      if (active && targetColumn) {
+        const changed = performDomMove(card, targetColumn, referenceCard);
+        if (changed) {
+          card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+          if (handle) {
+            handle.focus({ preventScroll: true });
+          }
+          const colName = targetColumn.querySelector('h3')?.textContent?.trim() || targetColumn.dataset.status;
+          const posIndex = getColumnCards(targetColumn).indexOf(card) + 1;
+          const supportsMoveBefore = 'moveBefore' in Element.prototype;
+          announce(
+            `${getCardTitle(card)} moved to ${colName}, position ${posIndex}.`,
+            supportsMoveBefore ? 80 : 500
+          );
+        }
+      }
+    });
+
+    document.addEventListener('pointercancel', (event) => {
+      if (pointerState && event.pointerId === pointerState.pointerId) {
+        cleanupPointerDrag(true);
+      }
+    });
+
+    // 3. Single-Pointer Action Buttons & Keyboard Grab-Move-Drop Reordering
+    let keyboardGrabState = null;
+
+    function updateHandleKeyHint(card, grabbed) {
+      const hint = card.querySelector('.key-hint');
+      if (hint) {
+        hint.textContent = grabbed
+          ? 'Arrows to move · Space to drop · Esc to cancel'
+          : 'Space to reorder';
+      }
+    }
+
+    board.addEventListener('click', (event) => {
+      const moveBtn = event.target.closest('.move-btn');
+      if (!moveBtn) return;
+
+      const card = moveBtn.closest('.board-column > .card');
+      const currentCol = card?.closest('.board-column');
+      if (!card || !currentCol) return;
+
+      const currentIdx = columns.indexOf(currentCol);
+      const dir = moveBtn.dataset.moveDir === 'prev' ? -1 : 1;
+      const nextCol = columns[currentIdx + dir];
+      if (!nextCol) return;
+
+      const runMove = () => {
+        const changed = performDomMove(card, nextCol, null);
+        if (changed) {
+          card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+          const targetBtn = card.querySelector(`[data-move-dir="${moveBtn.dataset.moveDir}"]`);
+          const fallbackBtn = card.querySelector(`[data-move-dir="${dir === 1 ? 'prev' : 'next'}"]`);
+          const btnToFocus = targetBtn && !targetBtn.disabled ? targetBtn : fallbackBtn;
+          btnToFocus?.focus({ preventScroll: true });
+          const colName = nextCol.querySelector('h3')?.textContent?.trim() || nextCol.dataset.status;
+          announce(`${getCardTitle(card)} moved to ${colName}.`, 'moveBefore' in Element.prototype ? 80 : 500);
+        }
+      };
+
+      if (document.startViewTransition && !reducedMotionQuery.matches) {
+        document.startViewTransition(runMove);
+      } else {
+        runMove();
+      }
+    });
+
+    board.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && pointerState?.active) {
+        event.preventDefault();
+        const title = getCardTitle(pointerState.card);
+        cleanupPointerDrag(true);
+        announce(`${title} drag cancelled.`);
+        return;
+      }
+
+      const handle = event.target.closest('.drag-handle');
+      if (!handle) return;
+      const card = handle.closest('.board-column > .card');
+      const currentCol = card?.closest('.board-column');
+      if (!card || !currentCol) return;
+
+      const isGrabbed = handle.getAttribute('aria-pressed') === 'true';
+
+      if (event.key === ' ' || event.key === 'Enter') {
+        event.preventDefault();
+        if (!isGrabbed) {
+          keyboardGrabState = {
+            card,
+            handle,
+            originColumn: currentCol,
+            originNextSibling: card.nextElementSibling,
+          };
+          handle.setAttribute('aria-pressed', 'true');
+          updateHandleKeyHint(card, true);
+          announce(
+            `${getCardTitle(card)} grabbed in ${currentCol.querySelector('h3')?.textContent}. Use Left and Right arrows to change column, Up and Down arrows to reorder, Space to drop, Escape to cancel.`
+          );
+        } else {
+          handle.setAttribute('aria-pressed', 'false');
+          updateHandleKeyHint(card, false);
+          const colName = currentCol.querySelector('h3')?.textContent?.trim();
+          const pos = getColumnCards(currentCol).indexOf(card) + 1;
+          keyboardGrabState = null;
+          announce(`${getCardTitle(card)} dropped in ${colName}, position ${pos}.`);
+        }
+        return;
+      }
+
+      if (event.key === 'Escape' && isGrabbed && keyboardGrabState) {
+        event.preventDefault();
+        const { originColumn, originNextSibling } = keyboardGrabState;
+        performDomMove(card, originColumn, originNextSibling);
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        handle.setAttribute('aria-pressed', 'false');
+        updateHandleKeyHint(card, false);
+        handle.focus({ preventScroll: true });
+        keyboardGrabState = null;
+        announce(`${getCardTitle(card)} reorder cancelled.`, 'moveBefore' in Element.prototype ? 80 : 500);
+        return;
+      }
+
+      if (!isGrabbed) return;
+
+      const colIndex = columns.indexOf(currentCol);
+      const colCards = getColumnCards(currentCol);
+      const cardIndex = colCards.indexOf(card);
+      let moved = false;
+
+      if (event.key === 'ArrowRight' && colIndex < columns.length - 1) {
+        event.preventDefault();
+        moved = performDomMove(card, columns[colIndex + 1], null);
+      } else if (event.key === 'ArrowLeft' && colIndex > 0) {
+        event.preventDefault();
+        moved = performDomMove(card, columns[colIndex - 1], null);
+      } else if (event.key === 'ArrowUp' && cardIndex > 0) {
+        event.preventDefault();
+        moved = performDomMove(card, currentCol, colCards[cardIndex - 1]);
+      } else if (event.key === 'ArrowDown' && cardIndex < colCards.length - 1) {
+        event.preventDefault();
+        moved = performDomMove(card, currentCol, colCards[cardIndex + 1].nextElementSibling);
+      }
+
+      if (moved) {
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        handle.focus({ preventScroll: true });
+        const newCol = card.closest('.board-column');
+        const colName = newCol.querySelector('h3')?.textContent?.trim();
+        const pos = getColumnCards(newCol).indexOf(card) + 1;
+        announce(
+          `${getCardTitle(card)} moved to ${colName}, position ${pos}.`,
+          'moveBefore' in Element.prototype ? 80 : 500
+        );
+      }
+    });
+
+    board.addEventListener('focusin', (event) => {
+      const handle = event.target.closest('.drag-handle');
+      if (!handle || !handle.matches(':focus-visible')) return;
+      const card = handle.closest('.card');
+      if (card && card.getAnimations().length === 0) {
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      }
+    });
+
+    // 4. Add Walk-In Order Form
+    let nextOrderNum = 104;
+    newOrderForm?.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const drinkInput = document.getElementById('new-drink-name');
+      const customerInput = document.getElementById('new-customer-name');
+      const drinkName = drinkInput.value.trim();
+      const customerName = customerInput.value.trim();
+      if (!drinkName || !customerName) return;
+
+      const orderId = String(nextOrderNum++);
+      const queuedColumn = document.getElementById('column-queued');
+      const article = document.createElement('article');
+      article.id = `order-${orderId}`;
+      article.className = 'card';
+      article.draggable = true;
+      article.dataset.orderId = orderId;
+      article.style.viewTransitionName = `order-card-${orderId}`;
+
+      article.innerHTML = `
+        <img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=480&q=80" alt="" width="320" height="180" loading="lazy">
+        <header>
+          <div class="card-meta-row">
+            <span class="order-badge"></span>
+            <span class="order-stage-pill" data-stage-label>Queued</span>
+          </div>
+          <h3></h3>
+          <p class="customer-line"></p>
+        </header>
+        <div class="card-details">
+          <ul class="modifier-tags" aria-label="Drink customizations">
+            <li>12oz House Cup</li>
+            <li>Fresh Espresso</li>
+          </ul>
+          <p class="order-notes">Walk-in counter order.</p>
+        </div>
+        <footer>
+          <button type="button" class="drag-handle" aria-pressed="false">
+            <span aria-hidden="true">⠿</span> Hold to Drag
+          </button>
+          <span class="key-hint" aria-hidden="true">Space to reorder</span>
+          <div class="card-actions">
+            <button type="button" class="move-btn" data-move-dir="prev" disabled>←</button>
+            <button type="button" class="move-btn" data-move-dir="next">Brew →</button>
+          </div>
+        </footer>
+      `;
+
+      article.querySelector('img').alt = `${drinkName} drink order`;
+      article.querySelector('.order-badge').textContent = `#${orderId}`;
+      article.querySelector('h3').textContent = drinkName;
+      article.querySelector('.customer-line').textContent = `For ${customerName} · Just now`;
+      article.querySelector('.drag-handle').setAttribute(
+        'aria-label',
+        `Reorder or move #${orderId} ${drinkName}. Press Space to grab, arrow keys to move.`
+      );
+      article.querySelector('[data-move-dir="prev"]').setAttribute(
+        'aria-label',
+        `Move #${orderId} ${drinkName} to previous column`
+      );
+      article.querySelector('[data-move-dir="next"]').setAttribute(
+        'aria-label',
+        `Move #${orderId} ${drinkName} to next column`
+      );
+
+      const insertOrder = () => {
+        queuedColumn.appendChild(article);
+        updateBoardMetadata();
+      };
+
+      if (document.startViewTransition && !reducedMotionQuery.matches) {
+        document.startViewTransition(insertOrder);
+      } else {
+        insertOrder();
+      }
+
+      drinkInput.value = '';
+      customerInput.value = '';
+      announce(`Added #${orderId} ${drinkName} for ${customerName} to Queued.`);
+    });
+
+    updateBoardMetadata();
+  </script>
 </body>
 
 </html>
