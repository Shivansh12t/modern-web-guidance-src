+      min-height: 48px;
+      border: 2px solid var(--border);
+      border-radius: 4px;
+      background-color: white;
+      color: var(--text);
+    }
+
+    .search-input:focus-visible,
+    .search-submit:focus-visible,
+    .reveal-search-btn:focus-visible,
+    nav a:focus-visible,
+    .btn:focus-visible,
