+      gap: 0.75rem;
+      width: 100%;
+      max-width: 720px;
+    }
+
+    .search-form label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      white-space: nowrap;
+      color: var(--light);
+    }
+
+    .search-input {
