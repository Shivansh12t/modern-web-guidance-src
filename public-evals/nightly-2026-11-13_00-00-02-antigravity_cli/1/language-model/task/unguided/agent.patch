+  <script>
+    // System context for The Daily Grind Barista
+    const BARISTA_SYSTEM_PROMPT = `You are a friendly, knowledgeable artisanal barista at The Daily Grind Coffee Co.
+Answer customer questions specifically about our signature drinks:
+1. Maple Oat Latte: Made with creamy steamed barista-grade oat milk, two shots of our signature espresso, a hint of pure Vermont Grade A dark maple syrup, and a light dusting of cinnamon. Available hot or iced. Dairy-free and vegan.
+2. Cold Brew: Coarse-ground single-origin Colombian beans steeped in filtered cold water for 18 hours for maximum smoothness, low acidity, and rich chocolatey notes. Served over ice, optionally with oat milk or sweet cream.
+Keep answers helpful, concise, and focused on our menu.`;
+
+    // JSON Schema constraint for structured sentiment analysis output
+    const SENTIMENT_RESPONSE_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: {
+          type: 'number',
+          description: 'Sentiment score ranging from -1.0 (very negative) to 1.0 (very positive), or 1 to 10'
+        },
+        category: {
+          type: 'string',
+          enum: ['positive', 'neutral', 'negative'],
+          description: 'Overall sentiment category of the customer feedback'
+        }
+      },
+      required: ['score', 'category'],
+      additionalProperties: false
+    };
+
+    // Session state & resource management
+    let activeBaristaSession = null;
+    let clonedBaristaSession = null;
+    const unneededSessions = new Set();
+    let currentAbortController = null;
+
+    // UI Elements
+    const askBtn = document.getElementById('ask-the-barista');
+    const cancelBtn = document.getElementById('cancel-barista-btn');
+    const questionInput = document.getElementById('barista-question');
+    const baristaAnswer = document.getElementById('barista-answer');
+    const modelStatusEl = document.getElementById('model-status');
+    const contextUsageEl = document.getElementById('context-usage');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressBar = document.getElementById('model-download-progress');
+    const progressLabel = document.getElementById('download-progress-label');
+
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentOutput = document.getElementById('sentiment-output');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+    const sessionCountStatus = document.getElementById('session-count-status');
+    const branchContextUsage = document.getElementById('branch-context-usage');
+    const branchOutput = document.getElementById('branch-output');
+
+    /**
+     * Checks if the Built-in AI LanguageModel API is supported and available.
+     */
+    async function checkModelAvailability(options = {}) {
+      if (typeof LanguageModel === 'undefined') {
+        modelStatusEl.textContent = 'Model status: Built-in AI (LanguageModel API) is not supported in this browser.';
+        return 'unavailable';
+      }
+
+      const availability = await LanguageModel.availability(options);
+      modelStatusEl.textContent = `Model status: ${availability}`;
+      return availability;
+    }
+
+    /**
+     * Updates context token usage display for active and cloned sessions.
+     */
+    function updateUsageMetrics() {
+      if (activeBaristaSession) {
+        const usage = activeBaristaSession.inputUsage ?? 0;
+        const quota = activeBaristaSession.inputQuota ?? 0;
+        contextUsageEl.textContent = `Context usage: ${usage} / ${quota} tokens`;
+      } else {
+        contextUsageEl.textContent = 'Context usage: 0 / 0 tokens';
+      }
+
+      if (clonedBaristaSession) {
+        const branchUsage = clonedBaristaSession.inputUsage ?? 0;
+        const branchQuota = clonedBaristaSession.inputQuota ?? 0;
+        branchContextUsage.textContent = `Cloned session tokens: ${branchUsage} / ${branchQuota}`;
+      } else {
+        branchContextUsage.textContent = 'Cloned session tokens: N/A';
+      }
+
+      const totalActive = (activeBaristaSession ? 1 : 0) + (clonedBaristaSession ? 1 : 0) + unneededSessions.size;
+      sessionCountStatus.textContent = `Active sessions: ${totalActive} (${unneededSessions.size} queued for cleanup)`;
+    }
+
+    /**
+     * Creates a reusable download progress monitor callback for LanguageModel.create().
+     */
+    function createDownloadMonitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        progressContainer.hidden = false;
+        const fraction = typeof e.loaded === 'number' ? e.loaded : 0;
+        const percent = Math.round(fraction * 100);
+        progressBar.value = fraction;
+        progressLabel.textContent = `Downloading AI model: ${percent}%`;
+        if (fraction >= 1) {
+          setTimeout(() => {
+            progressContainer.hidden = true;
+          }, 1000);
+        }
+      });
+    }
+
+    /**
+     * Attaches quotaoverflow listener to manage context window limits gracefully.
+     */
+    function attachSessionListeners(session) {
+      if (session && typeof session.addEventListener === 'function') {
+        session.addEventListener('quotaoverflow', () => {
+          modelStatusEl.textContent = 'Model status: Context quota overflow — older messages truncated.';
+          updateUsageMetrics();
+        });
+      }
+    }
+
+    /**
+     * Ensures an active barista session exists, creating one with progress monitoring if needed.
+     */
+    async function getOrCreateBaristaSession(signal) {
+      const availability = await checkModelAvailability();
+      if (availability === 'unavailable') {
+        throw new Error('Built-in AI model is unavailable on this device.');
+      }
+
+      if (!activeBaristaSession) {
+        activeBaristaSession = await LanguageModel.create({
+          initialPrompts: [
+            { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+          ],
+          monitor: createDownloadMonitor,
+          signal
+        });
+        attachSessionListeners(activeBaristaSession);
+        updateUsageMetrics();
+      }
+      return activeBaristaSession;
+    }
+
+    /**
+     * Destroys a session safely and releases resources.
+     */
+    function destroySession(session) {
+      if (session && typeof session.destroy === 'function') {
+        try {
+          session.destroy();
+        } catch (err) {
+          console.warn('Error destroying session:', err);
+        }
+      }
+    }
+
+    /**
+     * Clean up all unneeded sessions to free memory/GPU resources.
+     */
+    function cleanupUnneededSessions() {
+      let cleanedCount = 0;
+      for (const oldSession of unneededSessions) {
+        destroySession(oldSession);
+        cleanedCount++;
+      }
+      unneededSessions.clear();
+
+      if (clonedBaristaSession) {
+        destroySession(clonedBaristaSession);
+        clonedBaristaSession = null;
+        cleanedCount++;
+      }
+
+      updateUsageMetrics();
+      return cleanedCount;
+    }
+
+    // Event Listener: Ask the Barista (Streaming response)
+    askBtn.addEventListener('click', async () => {
+      const question = questionInput.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+
+      // Check model availability before starting
+      const availability = await checkModelAvailability();
+      if (availability === 'unavailable') {
+        baristaAnswer.textContent = 'Sorry, the built-in AI model is currently unavailable on this browser or device.';
+        return;
+      }
+
+      // Abort any previous in-flight generation
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+      const { signal } = currentAbortController;
+
+      askBtn.disabled = true;
+      cancelBtn.hidden = false;
+      baristaAnswer.textContent = '';
+
+      try {
+        const targetSession = clonedBaristaSession || await getOrCreateBaristaSession(signal);
+
+        // Optionally measure input usage before prompting if supported
+        if (typeof targetSession.measureInputUsage === 'function') {
+          await targetSession.measureInputUsage(question, { signal });
+        }
+
+        const stream = targetSession.promptStreaming(question, { signal });
+        for await (const chunk of stream) {
+          baristaAnswer.textContent += chunk;
+          updateUsageMetrics();
+        }
+        updateUsageMetrics();
+      } catch (error) {
+        if (error.name === 'AbortError') {
+          baristaAnswer.textContent += '\n[Generation stopped by user]';
+        } else {
+          baristaAnswer.textContent = `Error: ${error.message}`;
+        }
+      } finally {
+        askBtn.disabled = false;
+        cancelBtn.hidden = true;
+        currentAbortController = null;
+      }
+    });
+
+    // Event Listener: Stop in-flight generation
+    cancelBtn.addEventListener('click', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+    });
+
+    // Event Listener: Customer Feedback Sentiment Analyzer (Structured JSON with responseConstraint)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedbackText = feedbackInput.value.trim() || 'The Maple Oat Latte and Cold Brew were absolutely delicious!';
+      sentimentBtn.disabled = true;
+      sentimentOutput.textContent = 'Analyzing feedback...';
+
+      let analyzerSession = null;
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          sentimentOutput.textContent = JSON.stringify({
+            error: 'Built-in AI model is unavailable',
+            score: 0,
+            category: 'neutral'
+          }, null, 2);
+          return;
+        }
+
+        analyzerSession = await LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'You are a customer feedback sentiment analyzer for a coffee shop. Respond strictly with JSON matching the provided schema containing score and category.'
+            }
+          ],
+          monitor: createDownloadMonitor
+        });
+
+        const rawResult = await analyzerSession.prompt(
+          `Analyze the sentiment of the following customer feedback: "${feedbackText}"`,
+          { responseConstraint: SENTIMENT_RESPONSE_SCHEMA }
+        );
+
+        const parsedResult = JSON.parse(rawResult);
+        sentimentOutput.textContent = JSON.stringify(parsedResult, null, 2);
+      } catch (error) {
+        sentimentOutput.textContent = `Error analyzing feedback: ${error.message}`;
+      } finally {
+        // Always destroy one-off analyzer sessions immediately after completion
+        destroySession(analyzerSession);
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // Event Listener: Conversation Branching (Clone active session, track context, clean up old clones)
+    cloneBtn.addEventListener('click', async () => {
+      cloneBtn.disabled = true;
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          branchOutput.textContent = 'Cannot clone session: Built-in AI model is unavailable.';
+          return;
+        }
+
+        const baseSession = await getOrCreateBaristaSession();
+
+        // If a previous cloned session exists, mark it as unneeded and clean it up
+        if (clonedBaristaSession) {
+          unneededSessions.add(clonedBaristaSession);
+          clonedBaristaSession = null;
+          cleanupUnneededSessions();
+        }
+
+        const cloneController = new AbortController();
+        clonedBaristaSession = await baseSession.clone({
+          signal: cloneController.signal
+        });
+        attachSessionListeners(clonedBaristaSession);
+        updateUsageMetrics();
+
+        const usage = clonedBaristaSession.inputUsage ?? 0;
+        const quota = clonedBaristaSession.inputQuota ?? 0;
+        branchOutput.textContent = `Session cloned successfully! Ready to branch conversation (Context usage: ${usage} / ${quota} tokens).`;
+      } catch (error) {
+        branchOutput.textContent = `Error cloning session: ${error.message}`;
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    // Event Listener: Manual Cleanup of Unneeded Sessions
+    cleanupBtn.addEventListener('click', () => {
+      const cleaned = cleanupUnneededSessions();
+      branchOutput.textContent = `Cleaned up ${cleaned} unneeded session(s) and released resources.`;
+    });
+
+    // Clean up all active AI sessions on page unload to prevent memory leaks
+    window.addEventListener('pagehide', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      cleanupUnneededSessions();
+      destroySession(activeBaristaSession);
+      activeBaristaSession = null;
+    });
+  </script>
 </body>
 
