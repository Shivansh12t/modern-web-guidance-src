+
+        for (const cand of candidates) {
+          const overlapLeft = Math.max(source.left, cand.left);
+          const overlapRight = Math.min(source.right, cand.right);
+          const overlapWidth = Math.max(0, overlapRight - overlapLeft);
+
+          const dx = Math.abs(source.cx - cand.cx);
+          const dy = verticalDir > 0 ? cand.top - source.bottom : source.top - cand.bottom;
+          const clampedDy = Math.max(0, dy);
+
+          // Weight horizontal alignment heavily so Down/Up stays in column
+          const score = clampedDy * 1.5 + dx * 3.0 - overlapWidth * 2.5;
+          if (score < bestScore) {
+            bestScore = score;
+            best = cand;
+          }
+        }
+
+        return best;
+      }
+
+      /**
+       * Updates roving tabindex across all cards and optionally moves DOM focus.
+       */
+      function setActiveCard(targetCard, shouldFocus = true) {
+        const cards = getCards();
+        if (!targetCard || !cards.includes(targetCard)) return;
+
+        cards.forEach((card, idx) => {
+          const isTarget = card === targetCard;
+          card.setAttribute('tabindex', isTarget ? '0' : '-1');
+          card.setAttribute('data-spatial-active', isTarget ? 'true' : 'false');
+
+          // Synchronize inner action link tabindex so Tab moves cleanly out of the grid
+          const innerLink = card.querySelector('a, button');
+          if (innerLink) {
+            innerLink.setAttribute('tabindex', '-1');
+          }
+
+          if (isTarget && liveRegion) {
+            const titleEl = card.querySelector('h3');
+            const title = titleEl ? titleEl.textContent.trim() : `Card ${idx + 1}`;
+            liveRegion.textContent = `${title}, ${idx + 1} of ${cards.length}`;
+          }
+        });
+
+        if (shouldFocus) {
+          targetCard.focus();
+        }
+      }
+
+      /**
+       * Resolves which card currently owns focus (either the card itself or a descendant inside it).
+       */
+      function getFocusedCard(targetElement) {
+        if (!targetElement || !(targetElement instanceof Element)) return null;
+        return targetElement.closest('.card');
+      }
+
+      // Keyboard navigation listener on the grid container
+      grid.addEventListener('keydown', (event) => {
+        const navKeys = ['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'];
+
+        if (navKeys.includes(event.key)) {
+          if (event.altKey || event.ctrlKey || event.metaKey) return;
+
+          const currentCard =
+            getFocusedCard(event.target) ||
+            getFocusedCard(document.activeElement) ||
+            grid.querySelector('.card[tabindex="0"]') ||
+            getCards()[0];
+
+          if (!currentCard) return;
+
+          event.preventDefault();
+          const nextCard = findNextSpatialCard(currentCard, event.key);
+          if (nextCard && nextCard !== currentCard) {
+            setActiveCard(nextCard, true);
+          } else if (nextCard === currentCard) {
+            setActiveCard(currentCard, true);
+          }
+          return;
+        }
+
+        // Enter or Space on a focused card triggers its primary link/action
+        if (event.key === 'Enter' || event.key === ' ') {
+          const currentCard = getFocusedCard(event.target);
+          if (currentCard && event.target === currentCard) {
+            const primaryLink = currentCard.querySelector('a.btn, a[href], button');
+            if (primaryLink) {
+              event.preventDefault();
+              primaryLink.click();
+            }
+          }
+        }
+      });
+
+      // Keep roving tabindex synchronized when a user clicks or focuses a card directly
+      grid.addEventListener('focusin', (event) => {
+        const card = getFocusedCard(event.target);
+        if (card) {
+          setActiveCard(card, false);
+        }
+      });
+
+      grid.addEventListener('click', (event) => {
+        const card = getFocusedCard(event.target);
+        if (card) {
+          setActiveCard(card, false);
+        }
+      });
+
+      /**
+       * Switches the card grid layout mode and preserves roving focus state.
+       */
+      function setLayoutMode(mode) {
+        const validModes = ['grid', 'compact', 'two-column', 'list', 'masonry'];
+        const normalizedMode = validModes.includes(mode) ? mode : 'grid';
+
+        grid.setAttribute('data-layout', normalizedMode);
+        validModes.forEach((m) => grid.classList.remove(`layout-${m}`));
+        grid.classList.add(`layout-${normalizedMode}`);
+
+        layoutButtons.forEach((btn) => {
+          const isMatch = btn.getAttribute('data-layout-mode') === normalizedMode;
+          btn.classList.toggle('active', isMatch);
+          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+        });
+
+        if (liveRegion) {
+          liveRegion.textContent = `Layout changed to ${normalizedMode} view`;
+        }
+      }
+
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          setLayoutMode(mode);
+        });
+      });
+
+      // Ensure initial roving tabindex state is valid even if cards are dynamically added
+      function ensureInitialRovingTabindex() {
+        const cards = getCards();
+        if (cards.length === 0) return;
+
+        let active = cards.find((c) => c.getAttribute('tabindex') === '0') || cards[0];
+        setActiveCard(active, false);
+      }
+
+      const observer = new MutationObserver(() => {
+        const cards = getCards();
+        if (cards.length === 0) return;
+        const hasFocusable = cards.some((c) => c.getAttribute('tabindex') === '0');
+        cards.forEach((c) => {
+          if (!c.hasAttribute('tabindex')) {
+            c.setAttribute('tabindex', '-1');
+          }
+        });
+        if (!hasFocusable) {
+          setActiveCard(cards[0], false);
+        }
+      });
+
+      observer.observe(grid, { childList: true });
+      ensureInitialRovingTabindex();
+
+      // Expose helper API on window for programmatic layout switching or testing
+      window.CardGridSpatialNav = {
+        setLayoutMode,
+        findNextSpatialCard,
+        setActiveCard,
+        getCards,
+      };
+    })();
+  </script>
 </body>
 
 </html>
