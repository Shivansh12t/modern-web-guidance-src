+  <script>
+    (() => {
+      const FOCUSABLE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled):not([type="hidden"])',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[tabindex]:not([disabled])'
+      ].join(', ');
+
+      const DIRECTION_BY_KEY = {
+        ArrowRight: 'right',
+        ArrowLeft: 'left',
+        ArrowDown: 'down',
+        ArrowUp: 'up'
+      };
+
+      const EDGE_TOLERANCE = 2;
+      const FALLBACK_PERP_WEIGHT = 2.5;
+
+      function getVisibleCandidates(container) {
+        return Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR)).filter((el) => {
+          if (el.matches(':disabled, [inert], [inert] *')) {
+            return false;
+          }
+          if (typeof el.checkVisibility === 'function' && !el.checkVisibility()) {
+            return false;
+          }
+          return true;
+        });
+      }
+
+      function setRovingFocus(candidates, activeItem, shouldFocus = false) {
+        for (const item of candidates) {
+          item.setAttribute('tabindex', item === activeItem ? '0' : '-1');
+        }
+        if (shouldFocus && activeItem) {
+          activeItem.focus();
+          activeItem.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+      }
+
+      function ensureSingleTabStop(container) {
+        const candidates = getVisibleCandidates(container);
+        if (candidates.length === 0) return;
+        const currentTabStop = candidates.find((el) => el.getAttribute('tabindex') === '0') || candidates[0];
+        setRovingFocus(candidates, currentTabStop, false);
+      }
+
+      function findNextSpatialCandidate(current, candidates, direction) {
+        const currentRect = current.getBoundingClientRect();
+        const isHorizontal = direction === 'left' || direction === 'right';
+
+        const currentPerpStart = isHorizontal ? currentRect.top : currentRect.left;
+        const currentPerpEnd = isHorizontal ? currentRect.bottom : currentRect.right;
+        const currentPerpCenter = (currentPerpStart + currentPerpEnd) / 2;
+
+        const aligned = [];
+        const unaligned = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+
+          const rect = candidate.getBoundingClientRect();
+
+          let inDirection = false;
+          let gap = 0;
+
+          if (direction === 'right') {
+            inDirection = rect.left >= currentRect.right - EDGE_TOLERANCE;
+            gap = Math.max(0, rect.left - currentRect.right);
+          } else if (direction === 'left') {
+            inDirection = rect.right <= currentRect.left + EDGE_TOLERANCE;
+            gap = Math.max(0, currentRect.left - rect.right);
+          } else if (direction === 'down') {
+            inDirection = rect.top >= currentRect.bottom - EDGE_TOLERANCE;
+            gap = Math.max(0, rect.top - currentRect.bottom);
+          } else if (direction === 'up') {
+            inDirection = rect.bottom <= currentRect.top + EDGE_TOLERANCE;
+            gap = Math.max(0, currentRect.top - rect.bottom);
+          }
+
+          if (!inDirection) continue;
+
+          const candPerpStart = isHorizontal ? rect.top : rect.left;
+          const candPerpEnd = isHorizontal ? rect.bottom : rect.right;
+          const candPerpCenter = (candPerpStart + candPerpEnd) / 2;
+
+          const overlap = Math.min(currentPerpEnd, candPerpEnd) - Math.max(currentPerpStart, candPerpStart);
+          const perpCenterOffset = Math.abs(candPerpCenter - currentPerpCenter);
+
+          const entry = {
+            candidate,
+            gap,
+            perpCenterOffset,
+            candPerpStart
+          };
+
+          if (overlap > 0) {
+            aligned.push(entry);
+          } else {
+            unaligned.push(entry);
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > EDGE_TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            if (Math.abs(a.perpCenterOffset - b.perpCenterOffset) > EDGE_TOLERANCE) {
+              return a.perpCenterOffset - b.perpCenterOffset;
+            }
+            return a.candPerpStart - b.candPerpStart;
+          });
+          return aligned[0].candidate;
+        }
+
+        if (unaligned.length > 0) {
+          unaligned.sort((a, b) => {
+            const scoreA = a.gap + FALLBACK_PERP_WEIGHT * a.perpCenterOffset;
+            const scoreB = b.gap + FALLBACK_PERP_WEIGHT * b.perpCenterOffset;
+            if (Math.abs(scoreA - scoreB) > EDGE_TOLERANCE) {
+              return scoreA - scoreB;
+            }
+            return a.candPerpStart - b.candPerpStart;
+          });
+          return unaligned[0].candidate;
+        }
+
+        return null;
+      }
+
+      function initSpatialContainer(container) {
+        ensureSingleTabStop(container);
+
+        container.addEventListener('focusin', (e) => {
+          const target = e.composedPath()[0];
+          if (!(target instanceof Element)) return;
+          const candidates = getVisibleCandidates(container);
+          if (candidates.includes(target)) {
+            setRovingFocus(candidates, target, false);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          const direction = DIRECTION_BY_KEY[e.key];
+          if (!direction) return;
+
+          if (e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+          const target = e.composedPath()[0];
+          if (!(target instanceof Element)) return;
+          if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) {
+            return;
+          }
+
+          const candidates = getVisibleCandidates(container);
+          const current = document.activeElement;
+          if (!current || !candidates.includes(current)) {
+            return;
+          }
+
+          const nextCandidate = findNextSpatialCandidate(current, candidates, direction);
+          if (!nextCandidate) {
+            return;
+          }
+
+          e.preventDefault();
+          setRovingFocus(candidates, nextCandidate, true);
+        });
+      }
+
+      document.querySelectorAll('.grid[role="grid"]').forEach(initSpatialContainer);
+
+      const grid = document.querySelector('.grid[role="grid"]');
+      const layoutButtons = document.querySelectorAll('.layout-btn[data-layout-mode]');
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          if (!mode || !grid) return;
+          grid.setAttribute('data-layout', mode);
+          grid.classList.remove('grid--grid', 'grid--featured', 'grid--compact', 'grid--list');
+          if (mode !== 'grid') {
+            grid.classList.add(`grid--${mode}`);
+          }
+          layoutButtons.forEach((otherBtn) => {
+            otherBtn.setAttribute('aria-pressed', String(otherBtn === btn));
+          });
+          ensureSingleTabStop(grid);
+        });
+      });
+    })();
+  </script>
 </body>
 
