+  <script type="module">
+    const ownedExpandedTriggers = new WeakSet();
+
+    function normalizeText(value) {
+      return (value ?? "").replace(/\s+/g, " ").trim();
+    }
+
+    function getTextWithImageAlt(node) {
+      if (node.nodeType === Node.TEXT_NODE) {
+        return node.textContent ?? "";
+      }
+      if (node.nodeType !== Node.ELEMENT_NODE) {
+        return "";
+      }
+      if (node.tagName === "IMG") {
+        return node.getAttribute("alt") ?? "";
+      }
+      let result = "";
+      for (const child of node.childNodes) {
+        result += getTextWithImageAlt(child);
+      }
+      return result;
+    }
+
+    function getAccessibleName(element) {
+      const labelledBy = element.getAttribute("aria-labelledby");
+      if (labelledBy) {
+        const name = labelledBy
+          .trim()
+          .split(/\s+/)
+          .map((id) => document.getElementById(id)?.textContent ?? "")
+          .join(" ");
+        return normalizeText(name);
+      }
+      if (element.hasAttribute("aria-label")) {
+        return normalizeText(element.getAttribute("aria-label"));
+      }
+      const textContent = normalizeText(getTextWithImageAlt(element));
+      if (textContent) {
+        return textContent;
+      }
+      return normalizeText(element.getAttribute("title"));
+    }
+
+    function isPopoverOpen(popover) {
+      try {
+        return popover.matches(":is(:popover-open, .\\:popover-open)");
+      } catch {
+        return popover.classList.contains(":popover-open");
+      }
+    }
+
+    export function wireInterestHints(root = document) {
+      for (const trigger of root.querySelectorAll("[interestfor]")) {
+        const targetId = trigger.getAttribute("interestfor");
+        if (!targetId) continue;
+        const hint = document.getElementById(targetId);
+        if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+        const triggerName = getAccessibleName(trigger);
+        const hintText = normalizeText(getTextWithImageAlt(hint));
+        if (triggerName && triggerName === hintText) continue;
+
+        if (!hint.hasAttribute("role")) {
+          hint.setAttribute("role", "tooltip");
+        }
+
+        if (!triggerName) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", targetId);
+          }
+        } else if (
+          trigger.getAttribute("popovertarget") === targetId ||
+          trigger.getAttribute("commandfor") === targetId
+        ) {
+          if (!trigger.hasAttribute("aria-expanded")) {
+            trigger.setAttribute("aria-expanded", String(isPopoverOpen(hint)));
+            ownedExpandedTriggers.add(trigger);
+          }
+        } else if (!trigger.hasAttribute("aria-describedby")) {
+          trigger.setAttribute("aria-describedby", targetId);
+        }
+      }
+    }
+
+    window.wireInterestHints = wireInterestHints;
+    wireInterestHints();
+
+    document.addEventListener(
+      "toggle",
+      (event) => {
+        const hint = event.target;
+        if (!(hint instanceof HTMLElement) || !hint.id || hint.getAttribute("popover") !== "hint") {
+          return;
+        }
+        const open = event.newState ? event.newState === "open" : isPopoverOpen(hint);
+        for (const trigger of document.querySelectorAll(
+          `[interestfor="${CSS.escape(hint.id)}"]`
+        )) {
+          if (ownedExpandedTriggers.has(trigger)) {
+            trigger.setAttribute("aria-expanded", String(open));
+          }
+        }
+      },
+      true
+    );
+
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+  </script>
