+  <script>
+    (function () {
+      const tabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+
+      function syncTabState(tab, isOpen) {
+        const panel = tab.querySelector('.tab-panel');
+        if (isOpen) {
+          tab.classList.add('active');
+          tab.setAttribute('aria-selected', 'true');
+          if (panel) {
+            panel.removeAttribute('hidden');
+          }
+        } else {
+          tab.classList.remove('active');
+          tab.setAttribute('aria-selected', 'false');
+          if (panel) {
+            panel.setAttribute('hidden', 'until-found');
+          }
+        }
+      }
+
+      function setActiveTab(activeTab) {
+        tabs.forEach((tab) => {
+          const isTarget = tab === activeTab;
+          if (isTarget) {
+            if (!tab.open) {
+              tab.open = true;
+            }
+            syncTabState(tab, true);
+          } else {
+            if (tab.open) {
+              tab.open = false;
+            }
+            syncTabState(tab, false);
+          }
+        });
+      }
+
+      const observer = new MutationObserver(() => {
+        tabs.forEach((tab) => {
+          syncTabState(tab, tab.open);
+        });
+      });
+
+      tabs.forEach((tab) => {
+        observer.observe(tab, { attributes: true, attributeFilter: ['open'] });
+        const summary = tab.querySelector('summary');
+        const panel = tab.querySelector('.tab-panel');
+
+        if (summary) {
+          summary.addEventListener('click', () => {
+            if (!tab.open) {
+              tabs.forEach((t) => syncTabState(t, t === tab));
+            }
+          });
+        }
+
+        tab.addEventListener('click', (event) => {
+          if (event.target === tab && !tab.open) {
+            setActiveTab(tab);
+          }
+        });
+
+        tab.addEventListener('toggle', () => {
+          if (tab.open) {
+            setActiveTab(tab);
+          } else {
+            syncTabState(tab, false);
+          }
+        });
+
+        tab.addEventListener('beforematch', () => {
+          setActiveTab(tab);
+        });
+
+        if (panel) {
+          panel.addEventListener('beforematch', () => {
+            setActiveTab(tab);
+          });
+        }
+      });
+
+      const couponBtn = document.getElementById('reveal-coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (!couponPanel) return;
+        couponPanel.removeAttribute('hidden');
+        if (couponBtn) {
+          couponBtn.setAttribute('aria-expanded', 'true');
+        }
+      }
+
+      if (couponBtn && couponPanel) {
+        couponBtn.addEventListener('click', () => {
+          revealCoupon();
+        });
+
+        couponPanel.addEventListener('beforematch', () => {
+          revealCoupon();
+        });
+      }
+    })();
+  </script>
