+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const COOKIE_NAME = 'dg_shared_config';
+      const SAME_SITE_DOMAIN = '.dailygrind.example.com';
+      const NEW_ORIGIN = 'https://new-app.dailygrind.example.com';
+      const OLD_ORIGIN = 'https://old-app.dailygrind.example.com';
+
+      const milkSelect = document.getElementById('pref-milk');
+      const roastSelect = document.getElementById('pref-roast');
+      const syncStatus = document.getElementById('config-sync-status');
+      const banner = document.getElementById('migration-fallback-banner');
+      const migrateLink = document.getElementById('migrate-new-origin-link');
+      const dismissBtn = document.getElementById('dismiss-migration-banner');
+
+      function readSharedCookie() {
+        const match = document.cookie
+          .split('; ')
+          .find((row) => row.startsWith(COOKIE_NAME + '='));
+        if (!match) return null;
+        try {
+          return JSON.parse(decodeURIComponent(match.split('=')[1]));
+        } catch {
+          return null;
+        }
+      }
+
+      function writeSharedCookie(config) {
+        const encoded = encodeURIComponent(JSON.stringify(config));
+        const maxAge = 60 * 60 * 24 * 365;
+        // Share across same-site registrable domain (.dailygrind.example.com) and current host fallback
+        document.cookie = `${COOKIE_NAME}=${encoded}; path=/; max-age=${maxAge}; SameSite=Lax`;
+        if (location.hostname.endsWith('dailygrind.example.com')) {
+          document.cookie = `${COOKIE_NAME}=${encoded}; domain=${SAME_SITE_DOMAIN}; path=/; max-age=${maxAge}; SameSite=Lax; Secure`;
+        }
+      }
+
+      function loadUserConfig() {
+        // 1. Check URL migration payload (?migrated_config=...)
+        const params = new URLSearchParams(location.search);
+        const urlPayload = params.get('migrated_config');
+        if (urlPayload) {
+          try {
+            const parsed = JSON.parse(atob(urlPayload));
+            saveUserConfig(parsed, 'Migrated from Predecessor Origin');
+            const cleanUrl = new URL(location.href);
+            cleanUrl.searchParams.delete('migrated_config');
+            history.replaceState(null, '', cleanUrl.toString());
+            return parsed;
+          } catch {
+            // Fall through to storage/cookie
+          }
+        }
+
+        // 2. Check origin LocalStorage
+        try {
+          const localRaw = localStorage.getItem(STORAGE_KEY);
+          if (localRaw) {
+            return JSON.parse(localRaw);
+          }
+        } catch {
+          // Ignore storage access errors
+        }
+
+        // 3. Check same-site shared cookie transferred during origin migration
+        const cookieConfig = readSharedCookie();
+        if (cookieConfig) {
+          try {
+            localStorage.setItem(STORAGE_KEY, JSON.stringify(cookieConfig));
+          } catch {}
+          if (syncStatus) syncStatus.textContent = 'Restored from Same-Site Origin';
+          return cookieConfig;
+        }
+
+        return { milk: 'oat', roast: 'medium' };
+      }
+
+      function updateMigrationLink(config) {
+        if (!migrateLink) return;
+        try {
+          const targetUrl = new URL('/index.html', NEW_ORIGIN);
+          targetUrl.searchParams.set('migrated_config', btoa(JSON.stringify(config)));
+          migrateLink.href = targetUrl.toString();
+        } catch {}
+      }
+
+      function saveUserConfig(config, label) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+        } catch {}
+        writeSharedCookie(config);
+        updateMigrationLink(config);
+        if (syncStatus) {
+          syncStatus.textContent = label || 'Saved & Synced Across Origins';
+        }
+      }
+
+      // Cross-origin message listener for postMessage state transfer between old and new same-site origins
+      window.addEventListener('message', (event) => {
+        if (event.origin !== OLD_ORIGIN && event.origin !== NEW_ORIGIN && event.origin !== location.origin) {
+          return;
+        }
+        if (event.data && event.data.type === 'DAILY_GRIND_MIGRATE_CONFIG' && event.data.config) {
+          const incoming = event.data.config;
+          if (milkSelect && incoming.milk) milkSelect.value = incoming.milk;
+          if (roastSelect && incoming.roast) roastSelect.value = incoming.roast;
+          saveUserConfig(incoming, 'Synced via Cross-Origin Handover');
+        }
+      });
+
+      const currentConfig = loadUserConfig();
+      if (milkSelect && currentConfig.milk) milkSelect.value = currentConfig.milk;
+      if (roastSelect && currentConfig.roast) roastSelect.value = currentConfig.roast;
+      updateMigrationLink(currentConfig);
+
+      function handlePreferenceChange() {
+        saveUserConfig({
+          milk: milkSelect ? milkSelect.value : 'oat',
+          roast: roastSelect ? roastSelect.value : 'medium'
+        });
+      }
+
+      if (milkSelect) milkSelect.addEventListener('change', handlePreferenceChange);
+      if (roastSelect) roastSelect.addEventListener('change', handlePreferenceChange);
+
+      if (dismissBtn && banner) {
+        dismissBtn.addEventListener('click', () => {
+          banner.hidden = true;
+        });
+      }
+    })();
+  </script>
+
 </body>
 
