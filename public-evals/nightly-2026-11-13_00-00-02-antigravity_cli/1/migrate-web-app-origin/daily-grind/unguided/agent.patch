--- /dev/null
+++ b/migration.js
@@ -0,0 +1,247 @@
+(function () {
+  const STORAGE_KEY = 'dailyGrindUserConfig';
+
+  const DEFAULT_CONFIG = {
+    favoriteDrink: 'Maple Oat Latte',
+    milkPreference: 'Oat Milk',
+    defaultLocation: 'Downtown Roastery',
+    theme: 'roast-light',
+    orderNotifications: true,
+    preserveWindowPlacement: true,
+    shortcuts: [
+      { name: 'Order Now', url: '/order-online', enabled: true },
+      { name: 'Browse Menu', url: '/menu', enabled: true },
+      { name: 'My Rewards', url: '/rewards', enabled: true },
+      { name: 'My Account', url: '/account', enabled: true }
+    ],
+    migratedFromOrigin: null,
+    targetOrigin: 'https://app.dailygrind.com',
+    lastUpdated: new Date().toISOString()
+  };
+
+  function encodeConfigPayload(config) {
+    const json = JSON.stringify(config);
+    return btoa(encodeURIComponent(json));
+  }
+
+  function decodeConfigPayload(encoded) {
+    try {
+      const json = decodeURIComponent(atob(encoded));
+      const parsed = JSON.parse(json);
+      if (parsed && typeof parsed === 'object') {
+        return parsed;
+      }
+    } catch (_) {
+      // Ignore malformed payload
+    }
+    return null;
+  }
+
+  function loadUserConfig() {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (raw) {
+        return { ...DEFAULT_CONFIG, ...JSON.parse(raw) };
+      }
+    } catch (_) {
+      // Fallback to default config
+    }
+    return { ...DEFAULT_CONFIG };
+  }
+
+  function saveUserConfig(partialConfig) {
+    const current = loadUserConfig();
+    const updated = {
+      ...current,
+      ...partialConfig,
+      lastUpdated: new Date().toISOString()
+    };
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
+    } catch (_) {
+      // Ignore storage quota errors
+    }
+    return updated;
+  }
+
+  function importConfigFromUrl() {
+    const params = new URLSearchParams(window.location.search);
+    const encoded = params.get('migrate_config');
+    const sourceOrigin = params.get('from_origin');
+
+    if (encoded) {
+      const imported = decodeConfigPayload(encoded);
+      if (imported) {
+        const merged = saveUserConfig({
+          ...imported,
+          migratedFromOrigin: sourceOrigin || imported.migratedFromOrigin || 'https://old.dailygrind.com'
+        });
+        params.delete('migrate_config');
+        params.delete('from_origin');
+        const cleanQuery = params.toString();
+        const cleanUrl =
+          window.location.pathname +
+          (cleanQuery ? '?' + cleanQuery : '') +
+          window.location.hash;
+        if (window.history && window.history.replaceState) {
+          window.history.replaceState({}, document.title, cleanUrl);
+        }
+        return { migrated: true, config: merged };
+      }
+    }
+    return { migrated: false, config: loadUserConfig() };
+  }
+
+  function buildMigrationUrl(targetOrigin, config) {
+    const currentConfig = config || loadUserConfig();
+    const base = (targetOrigin || currentConfig.targetOrigin || 'https://app.dailygrind.com').replace(/\/+$/, '');
+    const payload = encodeConfigPayload(currentConfig);
+    const url = new URL(base + '/');
+    url.searchParams.set('migrate_config', payload);
+    url.searchParams.set('from_origin', window.location.origin);
+    return url.toString();
+  }
+
+  // Listen for cross-origin configuration transfer handshake via postMessage
+  window.addEventListener('message', (event) => {
+    const data = event.data;
+    if (!data || typeof data !== 'object') return;
+
+    if (data.type === 'DAILY_GRIND_REQUEST_CONFIG') {
+      const config = loadUserConfig();
+      if (event.source && typeof event.source.postMessage === 'function') {
+        event.source.postMessage(
+          {
+            type: 'DAILY_GRIND_CONFIG_PAYLOAD',
+            origin: window.location.origin,
+            config
+          },
+          event.origin || '*'
+        );
+      }
+    } else if (data.type === 'DAILY_GRIND_CONFIG_PAYLOAD' && data.config) {
+      const merged = saveUserConfig({
+        ...data.config,
+        migratedFromOrigin: data.origin || 'https://old.dailygrind.com'
+      });
+      renderConfigUI(merged, 'Configuration synced from ' + (data.origin || 'previous origin') + '.');
+    }
+  });
+
+  function registerServiceWorker() {
+    if ('serviceWorker' in navigator) {
+      navigator.serviceWorker.register('/sw.js').catch(() => {});
+    }
+  }
+
+  function renderConfigUI(config, statusMessage) {
+    const drinkInput = document.getElementById('config-favorite-drink');
+    const milkInput = document.getElementById('config-milk-preference');
+    const locationInput = document.getElementById('config-default-location');
+    const targetOriginInput = document.getElementById('config-target-origin');
+    const notificationsInput = document.getElementById('config-notifications');
+    const statusEl = document.getElementById('migration-status-banner');
+    const migrationLinkEl = document.getElementById('migration-transfer-link');
+    const shortcutsListEl = document.getElementById('os-shortcuts-list');
+
+    if (drinkInput) drinkInput.value = config.favoriteDrink || DEFAULT_CONFIG.favoriteDrink;
+    if (milkInput) milkInput.value = config.milkPreference || DEFAULT_CONFIG.milkPreference;
+    if (locationInput) locationInput.value = config.defaultLocation || DEFAULT_CONFIG.defaultLocation;
+    if (targetOriginInput) targetOriginInput.value = config.targetOrigin || DEFAULT_CONFIG.targetOrigin;
+    if (notificationsInput) notificationsInput.checked = Boolean(config.orderNotifications);
+
+    if (migrationLinkEl) {
+      migrationLinkEl.href = buildMigrationUrl(config.targetOrigin, config);
+    }
+
+    if (shortcutsListEl && Array.isArray(config.shortcuts)) {
+      shortcutsListEl.innerHTML = config.shortcuts
+        .map(
+          (s) =>
+            `<li class="shortcut-pill"><strong>${s.name}</strong> <code>${s.url}</code> <span class="badge-preserved">Preserved</span></li>`
+        )
+        .join('');
+    }
+
+    if (statusEl && statusMessage) {
+      statusEl.textContent = statusMessage;
+      statusEl.hidden = false;
+    }
+  }
+
+  function initUI() {
+    registerServiceWorker();
+    const { migrated, config } = importConfigFromUrl();
+
+    if (!localStorage.getItem(STORAGE_KEY)) {
+      saveUserConfig(config);
+    }
+
+    renderConfigUI(
+      config,
+      migrated
+        ? `User configuration and OS-level shortcuts preserved from ${config.migratedFromOrigin || 'previous origin'}.`
+        : ''
+    );
+
+    const form = document.getElementById('user-config-form');
+    if (form) {
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const drinkInput = document.getElementById('config-favorite-drink');
+        const milkInput = document.getElementById('config-milk-preference');
+        const locationInput = document.getElementById('config-default-location');
+        const targetOriginInput = document.getElementById('config-target-origin');
+        const notificationsInput = document.getElementById('config-notifications');
+
+        const updated = saveUserConfig({
+          favoriteDrink: drinkInput ? drinkInput.value : config.favoriteDrink,
+          milkPreference: milkInput ? milkInput.value : config.milkPreference,
+          defaultLocation: locationInput ? locationInput.value : config.defaultLocation,
+          targetOrigin: targetOriginInput ? targetOriginInput.value : config.targetOrigin,
+          orderNotifications: notificationsInput ? notificationsInput.checked : config.orderNotifications
+        });
+
+        renderConfigUI(
+          updated,
+          'User configuration saved locally and staged for Web App Origin Migration.'
+        );
+      });
+    }
+
+    const transferBtn = document.getElementById('trigger-origin-transfer-btn');
+    if (transferBtn) {
+      transferBtn.addEventListener('click', () => {
+        const latest = loadUserConfig();
+        const migrationUrl = buildMigrationUrl(latest.targetOrigin, latest);
+        const migrationLinkEl = document.getElementById('migration-transfer-link');
+        if (migrationLinkEl) {
+          migrationLinkEl.href = migrationUrl;
+        }
+        const payloadPreview = document.getElementById('migration-payload-preview');
+        if (payloadPreview) {
+          payloadPreview.textContent = migrationUrl;
+          payloadPreview.hidden = false;
+        }
+        renderConfigUI(
+          latest,
+          `Ready to transfer installed PWA and user configuration to ${latest.targetOrigin}.`
+        );
+      });
+    }
+  }
+
+  window.DailyGrindMigration = {
+    loadUserConfig,
+    saveUserConfig,
+    encodeConfigPayload,
+    decodeConfigPayload,
+    buildMigrationUrl
+  };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initUI);
+  } else {
+    initUI();
+  }
+})();
