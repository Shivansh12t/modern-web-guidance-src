+        color: #cbd5e1;
+        line-height: 1.5;
+      }
+      .palette-label {
+        font-size: 0.75rem;
+        font-weight: 600;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        color: #94a3b8;
