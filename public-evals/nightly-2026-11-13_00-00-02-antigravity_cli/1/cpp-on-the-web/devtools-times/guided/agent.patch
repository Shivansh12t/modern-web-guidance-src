+        width: 100%;
+        aspect-ratio: 4 / 3;
+        background: #000;
+        border-radius: 0.5rem;
+        overflow: hidden;
+        border: 1px solid #334155;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+      }
+      canvas#smallpt-canvas {
+        width: 100%;
+        height: 100%;
+        object-fit: contain;
+        display: block;
+      }
+      .canvas-meta {
+        margin-top: 0.5rem;
+        display: flex;
+        justify-content: space-between;
+        font-size: 0.75rem;
+        color: #94a3b8;
+      }
+    </style>
+  </head>
+  <body>
+    <main class="card" id="smallpt-pathtracer" data-status="initializing" data-render-count="0">
+      <div>
+        <div class="badge">
+          <span class="dot" id="smallpt-dot"></span>
+          WebAssembly Path Tracer (C++)
+        </div>
+        <h1>smallpt Global Illumination</h1>
+        <p class="desc">
+          Kevin Beason's 99-line C++ Monte Carlo path tracer compiled to WebAssembly with Emscripten,
+          executing off the main thread in a Web Worker with diffuse, specular, and dielectric refraction.
+        </p>
+
+        <div class="palette-label">Scene Sphere Colors</div>
+        <div class="palette-grid" id="smallpt-palette"></div>
+
+        <div class="controls">
+          <button id="randomize-colors-btn" type="button">
+            Randomize Sphere Colors
+          </button>
+        </div>
+
+        <div class="status-row">
+          <span id="smallpt-status-text">Initializing WebAssembly module...</span>
+          <span id="smallpt-progress-pct">0%</span>
+        </div>
+        <div class="progress-track">
+          <div class="progress-bar" id="smallpt-progress-bar"></div>
+        </div>
+      </div>
+
+      <div>
+        <div class="canvas-wrap">
+          <canvas
+            id="smallpt-canvas"
+            width="320"
+            height="240"
+            aria-label="smallpt C++ path tracer rendered Cornell Box scene"
+          ></canvas>
+        </div>
+        <div class="canvas-meta">
+          <span>Resolution: 320&times;240 (2&times;2 subpixel tent filter)</span>
+          <span>Cornell Box: 9 spheres (DIFF / SPEC / REFR)</span>
+        </div>
+      </div>
+    </main>
+
+    <script type="module">
+      const canvas = document.getElementById('smallpt-canvas');
+      const ctx = canvas.getContext('2d');
+      const btn = document.getElementById('randomize-colors-btn');
+      const statusText = document.getElementById('smallpt-status-text');
+      const progressPct = document.getElementById('smallpt-progress-pct');
+      const progressBar = document.getElementById('smallpt-progress-bar');
+      const paletteEl = document.getElementById('smallpt-palette');
+      const container = document.getElementById('smallpt-pathtracer');
+      const dot = document.getElementById('smallpt-dot');
+
+      const worker = new Worker(new URL('./src/wasm/worker.js', import.meta.url), {
+        type: 'module',
+      });
+
+      let clickCount = 0;
+      let renderCount = 0;
+
+      function renderPalette(sphereColors) {
+        if (!Array.isArray(sphereColors)) return;
+        paletteEl.replaceChildren(
+          ...sphereColors.map((s) => {
+            const item = document.createElement('div');
+            item.className = 'swatch-item';
+            const swatch = document.createElement('span');
+            swatch.className = 'swatch-color';
+            swatch.style.backgroundColor = s.hex;
+            const label = document.createElement('span');
+            label.textContent = s.name;
+            item.append(swatch, label);
+            return item;
+          }),
+        );
+      }
+
+      worker.onmessage = (event) => {
+        const data = event.data;
+        if (data.type === 'frame') {
+          const clamped =
+            data.pixels instanceof Uint8ClampedArray
+              ? data.pixels
+              : new Uint8ClampedArray(data.pixels);
+          const imageData = new ImageData(clamped, data.width, data.height);
+          ctx.putImageData(imageData, 0, 0);
+
+          renderPalette(data.sphereColors);
+
+          const pct = Math.min(100, Math.round((data.pass / data.totalPasses) * 100));
+          progressPct.textContent = `${pct}%`;
+          progressBar.style.width = `${pct}%`;
+
+          if (data.pass === 1) {
+            renderCount += 1;
+            container.dataset.renderCount = String(renderCount);
+          }
+
+          if (data.isComplete) {
+            container.dataset.status = 'complete';
+            dot.classList.add('complete');
+            statusText.textContent = `Rendered ${data.totalSpp} samples/pixel in ${(data.elapsedMs / 1000).toFixed(2)}s`;
+          } else {
+            container.dataset.status = 'rendering';
+            dot.classList.remove('complete');
+            statusText.textContent = `Rendering pass ${data.pass}/${data.totalPasses} (${data.totalSpp} spp)...`;
+          }
+        } else if (data.type === 'error') {
+          container.dataset.status = 'error';
+          statusText.textContent = `Error: ${data.message}`;
+        }
+      };
+
+      btn.addEventListener('click', () => {
+        clickCount += 1;
+        const rand = crypto.getRandomValues(new Uint32Array(1))[0];
+        const seed = (rand ^ (clickCount * 2654435761)) >>> 0;
+        container.dataset.status = 'rendering';
+        dot.classList.remove('complete');
+        worker.postMessage({
+          type: 'render',
+          width: 320,
+          height: 240,
+          sampsPerPass: 1,
+          targetPasses: 4,
+          randomize: true,
+          seed,
+        });
+      });
+
+      container.dataset.status = 'rendering';
+      worker.postMessage({
+        type: 'render',
+        width: 320,
+        height: 240,
+        sampsPerPass: 1,
+        targetPasses: 4,
+        randomize: false,
+      });
+    </script>
+  </body>
+</html>
