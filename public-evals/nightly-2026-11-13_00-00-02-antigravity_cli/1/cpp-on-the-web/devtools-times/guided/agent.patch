+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+let currentJobId = 0;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+const SPHERE_NAMES = [
+  'Left Wall',
+  'Right Wall',
+  'Back Wall',
+  'Front Wall',
+  'Floor',
+  'Ceiling',
+  'Mirror Sphere',
+  'Glass Sphere',
+  'Light',
+];
+
+function extractSphereColors(wasm, colorsPtr) {
+  wasm._get_sphere_colors(colorsPtr);
+  const raw = new Uint8Array(wasm.HEAPU8.buffer, colorsPtr, 27);
+  const indices = [0, 1, 2, 4, 5, 6, 7];
+  return indices.map((idx) => ({
+    index: idx,
+    name: SPHERE_NAMES[idx],
+    r: raw[idx * 3 + 0],
+    g: raw[idx * 3 + 1],
+    b: raw[idx * 3 + 2],
+    hex:
+      '#' +
+      [raw[idx * 3 + 0], raw[idx * 3 + 1], raw[idx * 3 + 2]]
+        .map((v) => v.toString(16).padStart(2, '0'))
+        .join(''),
+  }));
+}
+
+async function runRenderJob(jobId, options) {
+  const {
+    width = 320,
+    height = 240,
+    sampsPerPass = 1,
+    targetPasses = 4,
+    randomize = false,
+    reset = false,
+    seed = Date.now() >>> 0,
+  } = options;
+
+  const wasm = await getWasm();
+  if (jobId !== currentJobId) return;
+
+  const byteLength = width * height * 4;
+  const accumByteLength = width * height * 3 * 8;
+  const rgbaPtr = wasm._malloc(byteLength);
+  const accumPtr = wasm._malloc(accumByteLength);
+  const colorsPtr = wasm._malloc(27);
+
+  const startTime = performance.now();
+
+  try {
+    if (reset) {
+      wasm._reset_sphere_colors();
+    } else if (randomize) {
+      wasm._randomize_sphere_colors(seed >>> 0);
+    }
+
+    const sphereColors = extractSphereColors(wasm, colorsPtr);
+
+    for (let pass = 0; pass < targetPasses; pass++) {
+      if (jobId !== currentJobId) break;
+
+      const passStart = performance.now();
+      wasm._render_progressive_pass(
+        rgbaPtr,
+        accumPtr,
+        width,
+        height,
+        sampsPerPass,
+        pass,
+      );
+      const now = performance.now();
+
+      // Read wasm.HEAPU8 fresh after Wasm call in case memory grew
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        rgbaPtr,
+        byteLength,
+      ).slice();
+
+      const isComplete = pass + 1 === targetPasses;
+      self.postMessage(
+        {
+          type: 'frame',
+          jobId,
+          pixels,
+          width,
+          height,
+          pass: pass + 1,
+          totalPasses: targetPasses,
+          totalSpp: (pass + 1) * sampsPerPass * 4,
+          passMs: Math.round(now - passStart),
+          elapsedMs: Math.round(now - startTime),
+          isComplete,
+          sphereColors,
+        },
+        [pixels.buffer],
+      );
+
+      if (!isComplete) {
+        await new Promise((resolve) => setTimeout(resolve, 0));
+      }
+    }
+  } finally {
+    wasm._free(colorsPtr);
+    wasm._free(accumPtr);
+    wasm._free(rgbaPtr);
+  }
+}
+
+self.addEventListener('message', (event) => {
+  const data = event.data || {};
+  if (data.type === 'render') {
+    currentJobId += 1;
+    const jobId = currentJobId;
+    runRenderJob(jobId, data).catch((error) => {
+      self.postMessage({
+        type: 'error',
+        jobId,
+        message: error instanceof Error ? error.message : String(error),
+      });
+    });
+  }
+});
