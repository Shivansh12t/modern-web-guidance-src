diff --git a/src/wasm/smallpt.cpp b/src/wasm/smallpt.cpp
new file mode 100644
index 0000000..270f91f
--- /dev/null
+++ b/src/wasm/smallpt.cpp
@@ -0,0 +1,216 @@
+#define _XOPEN_SOURCE 700
+#include <math.h>   // smallpt, a Path Tracer by Kevin Beason, 2008
+#include <stdlib.h> // Make : g++ -O3 -fopenmp smallpt.cpp -o smallpt
+#include <stdio.h>  //        Remove "-fopenmp" for g++ version < 4.2
+#include <stdint.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) {
+    if (depth<50 && erand48(Xi)<p) f=f*(1/p);
+    else return obj.e; // R.R.
+  }
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+static Vec hsv_to_rgb(double h, double s, double v) {
+  double c = v * s;
+  double hp = fmod(h * 6.0, 6.0);
+  double x = c * (1.0 - fabs(fmod(hp, 2.0) - 1.0));
+  double m = v - c;
+  Vec rgb;
+  if (hp < 1.0) rgb = Vec(c, x, 0);
+  else if (hp < 2.0) rgb = Vec(x, c, 0);
+  else if (hp < 3.0) rgb = Vec(0, c, x);
+  else if (hp < 4.0) rgb = Vec(0, x, c);
+  else if (hp < 5.0) rgb = Vec(x, 0, c);
+  else rgb = Vec(c, 0, x);
+  return Vec(rgb.x + m, rgb.y + m, rgb.z + m);
+}
+
+extern "C" {
+
+void reset_sphere_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec(0, 0, 0);
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+  spheres[8].c = Vec(0, 0, 0);
+}
+
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+void get_sphere_colors(uint8_t* out_rgb) {
+  if (!out_rgb) return;
+  for (int i = 0; i < 9; i++) {
+    out_rgb[i * 3 + 0] = static_cast<uint8_t>(toInt(spheres[i].c.x));
+    out_rgb[i * 3 + 1] = static_cast<uint8_t>(toInt(spheres[i].c.y));
+    out_rgb[i * 3 + 2] = static_cast<uint8_t>(toInt(spheres[i].c.z));
+  }
+}
+
+void randomize_sphere_colors(uint32_t seed) {
+  unsigned short Xi[3] = {
+    static_cast<unsigned short>((seed & 0xFFFF) ^ 0x330E),
+    static_cast<unsigned short>(((seed >> 16) & 0xFFFF) ^ 0xABCD),
+    static_cast<unsigned short>(((seed * 2654435761U) >> 8) & 0xFFFF)
+  };
+  // Advance PRNG a few times to mix seed thoroughly
+  for (int i = 0; i < 8; i++) erand48(Xi);
+
+  double base_hue = erand48(Xi);
+  // Left & Right walls: rich saturated complementary/triadic hues
+  spheres[0].c = hsv_to_rgb(fmod(base_hue, 1.0), 0.65 + 0.25 * erand48(Xi), 0.70 + 0.18 * erand48(Xi));
+  spheres[1].c = hsv_to_rgb(fmod(base_hue + 0.38 + 0.24 * erand48(Xi), 1.0), 0.65 + 0.25 * erand48(Xi), 0.70 + 0.18 * erand48(Xi));
+  // Back wall & Floor: softer tinted diffuse surfaces
+  spheres[2].c = hsv_to_rgb(fmod(base_hue + 0.18 + 0.64 * erand48(Xi), 1.0), 0.25 + 0.35 * erand48(Xi), 0.72 + 0.18 * erand48(Xi));
+  spheres[4].c = hsv_to_rgb(fmod(base_hue + 0.50 + 0.30 * erand48(Xi), 1.0), 0.20 + 0.35 * erand48(Xi), 0.72 + 0.18 * erand48(Xi));
+  // Ceiling: bright lightly-tinted diffuse surface
+  spheres[5].c = hsv_to_rgb(erand48(Xi), 0.10 + 0.20 * erand48(Xi), 0.80 + 0.15 * erand48(Xi));
+  // Mirror sphere (6) & Glass sphere (7): high-value vibrant specular/refractive tints
+  spheres[6].c = hsv_to_rgb(erand48(Xi), 0.45 + 0.45 * erand48(Xi), 0.98);
+  spheres[7].c = hsv_to_rgb(fmod(base_hue + 0.72, 1.0), 0.45 + 0.45 * erand48(Xi), 0.98);
+}
+
+void render_progressive_pass(uint8_t* out_rgba, double* accum_rgb, int w, int h, int samps, int pass_index) {
+  if (w <= 0 || h <= 0 || !out_rgba || !accum_rgb) return;
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  double inv_pass = 1.0 / (pass_index + 1);
+  unsigned short pass_seed = static_cast<unsigned short>((pass_index * 2654435761U) & 0xFFFF);
+
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    for (unsigned short x=0; x<w; x++) {         // Loop cols
+      unsigned short Xi[3] = {
+        static_cast<unsigned short>(x ^ pass_seed),
+        static_cast<unsigned short>(y + pass_index * 17),
+        static_cast<unsigned short>(y * y * y + pass_index * 31)
+      };
+      int i = (h - y - 1) * w + x;
+      Vec pixel_sample(0, 0, 0);
+      for (int sy=0; sy<2; sy++)                 // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++){              // 2x2 subpixel cols
+          r = Vec();
+          for (int s=0; s<samps; s++){
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          pixel_sample = pixel_sample + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+      int idx3 = i * 3;
+      if (pass_index == 0) {
+        accum_rgb[idx3 + 0] = pixel_sample.x;
+        accum_rgb[idx3 + 1] = pixel_sample.y;
+        accum_rgb[idx3 + 2] = pixel_sample.z;
+      } else {
+        accum_rgb[idx3 + 0] += pixel_sample.x;
+        accum_rgb[idx3 + 1] += pixel_sample.y;
+        accum_rgb[idx3 + 2] += pixel_sample.z;
+      }
+      int idx4 = i * 4;
+      out_rgba[idx4 + 0] = static_cast<uint8_t>(toInt(accum_rgb[idx3 + 0] * inv_pass));
+      out_rgba[idx4 + 1] = static_cast<uint8_t>(toInt(accum_rgb[idx3 + 1] * inv_pass));
+      out_rgba[idx4 + 2] = static_cast<uint8_t>(toInt(accum_rgb[idx3 + 2] * inv_pass));
+      out_rgba[idx4 + 3] = 255;
+    }
+  }
+}
+
+void render_frame(uint8_t* out_rgba, int w, int h, int samps) {
+  if (w <= 0 || h <= 0 || !out_rgba) return;
+  double* accum_rgb = static_cast<double*>(malloc(static_cast<size_t>(w) * static_cast<size_t>(h) * 3 * sizeof(double)));
+  if (!accum_rgb) return;
+  render_progressive_pass(out_rgba, accum_rgb, w, h, samps, 0);
+  free(accum_rgb);
+}
+
+}
