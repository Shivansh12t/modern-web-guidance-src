+      button#randomize-colors-btn {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding: 0.65rem 1.25rem;
+        border-radius: 0.5rem;
+        border: none;
+        font-weight: 600;
+        font-size: 0.875rem;
