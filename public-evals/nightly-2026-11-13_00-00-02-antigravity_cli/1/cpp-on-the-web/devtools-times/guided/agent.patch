@@ -0,0 +1,300 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColor {
+  index: number;
+  name: string;
+  r: number;
+  g: number;
+  b: number;
+  hex: string;
+}
+
+interface WorkerFrameMessage {
+  type: 'frame';
+  jobId: number;
+  pixels: Uint8ClampedArray;
+  width: number;
+  height: number;
+  pass: number;
+  totalPasses: number;
+  totalSpp: number;
+  passMs: number;
+  elapsedMs: number;
+  isComplete: boolean;
+  sphereColors: SphereColor[];
+}
+
+interface WorkerErrorMessage {
+  type: 'error';
+  jobId: number;
+  message: string;
+}
+
+type WorkerMessage = WorkerFrameMessage | WorkerErrorMessage;
+
+const CANVAS_WIDTH = 320;
+const CANVAS_HEIGHT = 240;
+
+const DEFAULT_SPHERE_COLORS: SphereColor[] = [
+  { index: 0, name: 'Left Wall', r: 224, g: 136, b: 136, hex: '#e08888' },
+  { index: 1, name: 'Right Wall', r: 136, g: 136, b: 224, hex: '#8888e0' },
+  { index: 2, name: 'Back Wall', r: 224, g: 224, b: 224, hex: '#e0e0e0' },
+  { index: 4, name: 'Floor', r: 224, g: 224, b: 224, hex: '#e0e0e0' },
+  { index: 5, name: 'Ceiling', r: 224, g: 224, b: 224, hex: '#e0e0e0' },
+  { index: 6, name: 'Mirror Sphere', r: 255, g: 255, b: 255, hex: '#ffffff' },
+  { index: 7, name: 'Glass Sphere', r: 255, g: 255, b: 255, hex: '#ffffff' },
+];
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const clickCountRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'initializing' | 'rendering' | 'complete' | 'error'>('initializing');
+  const [passInfo, setPassInfo] = useState({ pass: 0, totalPasses: 4, totalSpp: 0, elapsedMs: 0 });
+  const [targetPasses, setTargetPasses] = useState<number>(4);
+  const [sphereColors, setSphereColors] = useState<SphereColor[]>(DEFAULT_SPHERE_COLORS);
+  const [renderCount, setRenderCount] = useState<number>(0);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+
+  useEffect(() => {
+    const worker = new Worker(new URL('../wasm/worker.js', import.meta.url), {
+      type: 'module',
+    });
+    workerRef.current = worker;
+
+    worker.onmessage = (event: MessageEvent<WorkerMessage>) => {
+      const data = event.data;
+      if (data.type === 'frame') {
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const clamped =
+              data.pixels instanceof Uint8ClampedArray
+                ? data.pixels
+                : new Uint8ClampedArray(data.pixels);
+            const imageData = new ImageData(clamped, data.width, data.height);
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+        if (data.sphereColors && data.sphereColors.length > 0) {
+          setSphereColors(data.sphereColors);
+        }
+        setPassInfo({
+          pass: data.pass,
+          totalPasses: data.totalPasses,
+          totalSpp: data.totalSpp,
+          elapsedMs: data.elapsedMs,
+        });
+        if (data.pass === 1) {
+          setRenderCount((prev) => prev + 1);
+        }
+        setStatus(data.isComplete ? 'complete' : 'rendering');
+      } else if (data.type === 'error') {
+        setErrorMsg(data.message);
+        setStatus('error');
+      }
+    };
+
+    worker.onerror = (err) => {
+      setErrorMsg(err.message || 'Web Worker error while running smallpt WebAssembly module.');
+      setStatus('error');
+    };
+
+    setStatus('rendering');
+    worker.postMessage({
+      type: 'render',
+      width: CANVAS_WIDTH,
+      height: CANVAS_HEIGHT,
+      sampsPerPass: 1,
+      targetPasses: 4,
+      randomize: false,
+    });
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, []);
+
+  const handleRandomize = useCallback(() => {
+    const worker = workerRef.current;
+    if (!worker) return;
+
+    clickCountRef.current += 1;
+    const randomVal =
+      typeof crypto !== 'undefined' && typeof crypto.getRandomValues === 'function'
+        ? crypto.getRandomValues(new Uint32Array(1))[0]
+        : Math.floor(Math.random() * 0xffffffff);
+    const seed = (randomVal ^ (clickCountRef.current * 2654435761)) >>> 0;
+
+    setStatus('rendering');
+    setErrorMsg(null);
+    worker.postMessage({
+      type: 'render',
+      width: CANVAS_WIDTH,
+      height: CANVAS_HEIGHT,
+      sampsPerPass: 1,
+      targetPasses,
+      randomize: true,
+      seed,
+    });
+  }, [targetPasses]);
+
+  const handleQualityChange = useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
+    const newPasses = Number(e.target.value) || 4;
+    setTargetPasses(newPasses);
+    const worker = workerRef.current;
+    if (!worker) return;
+
+    setStatus('rendering');
+    worker.postMessage({
+      type: 'render',
+      width: CANVAS_WIDTH,
+      height: CANVAS_HEIGHT,
+      sampsPerPass: 1,
+      targetPasses: newPasses,
+      randomize: false,
+    });
+  }, []);
+
+  const progressPercent =
+    passInfo.totalPasses > 0 ? Math.min(100, Math.round((passInfo.pass / passInfo.totalPasses) * 100)) : 0;
+
+  return (
+    <section
+      id="smallpt-pathtracer"
+      aria-labelledby="smallpt-heading"
+      data-status={status}
+      data-render-count={renderCount}
+      className="bg-slate-900 text-white rounded-xl shadow-lg border border-slate-800 overflow-hidden my-6"
+    >
+      <div className="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
+        {/* Left column: Controls & Telemetry */}
+        <div className="lg:col-span-5 flex flex-col justify-between space-y-5">
+          <div>
+            <div className="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/15 text-amber-300 border border-amber-500/30">
+              <span
+                className={`w-2 h-2 rounded-full ${
+                  status === 'rendering' || status === 'initializing'
+                    ? 'bg-amber-400 animate-pulse'
+                    : status === 'complete'
+                    ? 'bg-emerald-400'
+                    : 'bg-rose-400'
+                }`}
+              />
+              WebAssembly Path Tracer (C++)
+            </div>
+
+            <h2 id="smallpt-heading" className="mt-3 text-2xl md:text-3xl font-brand text-white tracking-tight">
+              smallpt Global Illumination
+            </h2>
+            <p className="mt-2 text-sm text-slate-300 leading-relaxed">
+              Kevin Beason&apos;s 99-line C++ Monte Carlo path tracer compiled to WebAssembly with Emscripten,
+              executing off the main thread in a Web Worker with diffuse, specular, and dielectric refraction.
+            </p>
+          </div>
+
+          {/* Sphere Color Palette */}
+          <div>
+            <div className="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
+              Scene Sphere Colors
+            </div>
+            <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-2">
+              {sphereColors.map((sphere) => (
+                <div
+                  key={sphere.index}
+                  className="flex items-center gap-2 bg-slate-800/80 border border-slate-700/70 rounded-md px-2.5 py-1.5"
+                >
+                  <span
+                    className="w-3.5 h-3.5 rounded-full flex-shrink-0 border border-white/20 shadow-xs"
+                    style={{ backgroundColor: sphere.hex }}
+                  />
+                  <span className="text-xs text-slate-200 truncate" title={`${sphere.name}: ${sphere.hex}`}>
+                    {sphere.name}
+                  </span>
+                </div>
+              ))}
+            </div>
+          </div>
+
+          {/* Controls */}
+          <div className="pt-2 space-y-3">
+            <div className="flex flex-wrap items-center gap-3">
+              <button
+                id="randomize-colors-btn"
+                type="button"
+                onClick={handleRandomize}
+                className="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-950 shadow-md transition-colors cursor-pointer"
+              >
+                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                  <path
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
+                  />
+                </svg>
+                Randomize Sphere Colors
+              </button>
+
+              <label className="inline-flex items-center gap-2 text-xs text-slate-300 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2">
+                <span>Quality:</span>
+                <select
+                  id="smallpt-samples-select"
+                  value={targetPasses}
+                  onChange={handleQualityChange}
+                  className="bg-transparent text-white font-medium focus:outline-none cursor-pointer"
+                >
+                  <option value={1} className="bg-slate-900">4 spp (Fast)</option>
+                  <option value={4} className="bg-slate-900">16 spp (Standard)</option>
+                  <option value={8} className="bg-slate-900">32 spp (Refined)</option>
+                </select>
+              </label>
+            </div>
+
+            {/* Progress & Metrics */}
+            <div className="space-y-1.5">
+              <div className="flex justify-between text-xs text-slate-400">
+                <span id="smallpt-status-text">
+                  {status === 'initializing' && 'Initializing WebAssembly module...'}
+                  {status === 'rendering' &&
+                    `Rendering pass ${passInfo.pass}/${passInfo.totalPasses} (${passInfo.totalSpp} spp)...`}
+                  {status === 'complete' &&
+                    `Rendered ${passInfo.totalSpp} samples/pixel in ${(passInfo.elapsedMs / 1000).toFixed(2)}s`}
+                  {status === 'error' && `Error: ${errorMsg}`}
+                </span>
+                <span>{progressPercent}%</span>
+              </div>
+              <div className="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
+                <div
+                  className="h-full bg-amber-400 transition-all duration-200"
+                  style={{ width: `${progressPercent}%` }}
+                />
+              </div>
+            </div>
+          </div>
+        </div>
+
+        {/* Right column: Canvas Output */}
+        <div className="lg:col-span-7 flex flex-col items-center justify-center">
+          <div className="relative w-full max-w-[640px] aspect-[4/3] bg-black rounded-lg overflow-hidden border border-slate-700 shadow-2xl flex items-center justify-center">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={CANVAS_WIDTH}
+              height={CANVAS_HEIGHT}
+              aria-label="smallpt C++ path tracer rendered Cornell Box scene"
+              className="w-full h-full object-contain"
+              style={{ imageRendering: 'auto' }}
+            />
+          </div>
+          <div className="mt-2 flex items-center justify-between w-full max-w-[640px] text-xs text-slate-400">
+            <span>Resolution: {CANVAS_WIDTH}&times;{CANVAS_HEIGHT} (2&times;2 subpixel tent filter)</span>
+            <span>Cornell Box: 9 spheres (DIFF / SPEC / REFR)</span>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
