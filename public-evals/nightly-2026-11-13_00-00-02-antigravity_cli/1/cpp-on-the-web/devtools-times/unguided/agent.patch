+    </style>
+  </head>
+  <body>
+    <main class="card">
+      <div class="layout">
+        <div>
+          <div class="canvas-wrap">
+            <canvas id="smallpt-canvas" width="320" height="240"></canvas>
+            <div id="smallpt-badge" class="badge">Initializing WebAssembly...</div>
+          </div>
+          <div class="meta-row">
+            <span id="smallpt-stats">320×240 · Global Illumination</span>
+            <span id="smallpt-run-indicator">Run #1</span>
+          </div>
+        </div>
+        <div class="info">
+          <div class="tag">WebAssembly C++ Path Tracer · smallpt</div>
+          <h1>Interactive <code>smallpt</code> Global Illumination Renderer</h1>
+          <p>
+            Compiled from Kevin Beason's open-source C++ path tracer (<code>smallpt.cpp</code>) to WebAssembly.
+            Renders the Cornell box scene client-side in the browser with diffuse, mirror, and glass spheres.
+          </p>
+          <button id="randomize-colors-btn" data-testid="randomize-sphere-colors" type="button">
+            Run Again with Randomized Sphere Colors
+          </button>
+          <div id="smallpt-swatches" class="swatches">
+            <div class="swatch"><span data-swatch-id="0" class="dot" style="background:#BF4040"></span><span>Left</span><span data-swatch-hex="0" class="hex">#BF4040</span></div>
+            <div class="swatch"><span data-swatch-id="1" class="dot" style="background:#4040BF"></span><span>Right</span><span data-swatch-hex="1" class="hex">#4040BF</span></div>
+            <div class="swatch"><span data-swatch-id="2" class="dot" style="background:#BFBFBF"></span><span>Back</span><span data-swatch-hex="2" class="hex">#BFBFBF</span></div>
+            <div class="swatch"><span data-swatch-id="4" class="dot" style="background:#BFBFBF"></span><span>Floor</span><span data-swatch-hex="4" class="hex">#BFBFBF</span></div>
+            <div class="swatch"><span data-swatch-id="6" class="dot" style="background:#FFFFFF"></span><span>Mirror</span><span data-swatch-hex="6" class="hex">#FFFFFF</span></div>
+            <div class="swatch"><span data-swatch-id="7" class="dot" style="background:#FFFFFF"></span><span>Glass</span><span data-swatch-hex="7" class="hex">#FFFFFF</span></div>
+          </div>
+        </div>
+      </div>
+    </main>
+
+    <script>
+      (function () {
+        const WIDTH = 320;
+        const HEIGHT = 240;
+        const TARGET_SPP = 16;
+        let wasmMod = null;
+        let rafId = null;
+        let runCount = 0;
+        let activeJobId = 0;
+
+        function toHexChannel(val) {
+          const n = Math.max(0, Math.min(255, Math.round(Math.pow(Math.max(0, Math.min(1, val)), 1 / 2.2) * 255)));
+          return n.toString(16).padStart(2, '0').toUpperCase();
+        }
+
+        function updateSwatches(mod) {
+          for (const id of [0, 1, 2, 4, 6, 7]) {
+            const r = mod._get_sphere_color(id, 0);
+            const g = mod._get_sphere_color(id, 1);
+            const b = mod._get_sphere_color(id, 2);
+            const hex = '#' + toHexChannel(r) + toHexChannel(g) + toHexChannel(b);
+            const dot = document.querySelector(`[data-swatch-id="${id}"]`);
+            const label = document.querySelector(`[data-swatch-hex="${id}"]`);
+            if (dot) dot.style.backgroundColor = hex;
+            if (label) label.textContent = hex;
+          }
+        }
+
+        function blitToCanvas(mod, canvas) {
+          const ctx = canvas.getContext('2d');
+          const ptr = mod._get_pixel_buffer();
+          const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, WIDTH * HEIGHT * 4);
+          ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels), WIDTH, HEIGHT), 0, 0);
+        }
+
+        function startRenderSequence(mod, randomize) {
+          const canvas = document.getElementById('smallpt-canvas');
+          if (!canvas) return;
+          if (rafId !== null) {
+            cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+          activeJobId++;
+          const currentJobId = activeJobId;
+          runCount++;
+          const seed = ((Date.now() & 0xffff) ^ (runCount * 26547)) >>> 0 || 1;
+          if (randomize) mod._randomize_sphere_colors(seed);
+          else mod._reset_sphere_colors();
+          updateSwatches(mod);
+
+          const badge = document.getElementById('smallpt-badge');
+          const stats = document.getElementById('smallpt-stats');
+          const runIndicator = document.getElementById('smallpt-run-indicator');
+          if (runIndicator) runIndicator.textContent = `Run #${runCount}`;
+
+          const startTime = performance.now();
+          mod._init_render(WIDTH, HEIGHT);
+          let currentSpp = mod._render_fast_pass(WIDTH, HEIGHT, seed);
+          blitToCanvas(mod, canvas);
+          canvas.setAttribute('data-rendered', 'true');
+          canvas.setAttribute('data-run-count', String(runCount));
+          canvas.setAttribute('data-spp', String(currentSpp));
+
+          function stepProgressive() {
+            if (currentJobId !== activeJobId) return;
+            currentSpp = mod._render_fast_pass(WIDTH, HEIGHT, seed + currentSpp * 97);
+            blitToCanvas(mod, canvas);
+            canvas.setAttribute('data-spp', String(currentSpp));
+            const elapsedMs = Math.round(performance.now() - startTime);
+            if (currentSpp < TARGET_SPP) {
+              if (badge) badge.textContent = `Rendering · ${currentSpp}/${TARGET_SPP} spp`;
+              if (stats) stats.textContent = `${WIDTH}×${HEIGHT} · ${currentSpp} spp · ${elapsedMs} ms`;
+              rafId = requestAnimationFrame(stepProgressive);
+            } else {
+              if (badge) badge.textContent = `Complete · ${currentSpp} spp (${elapsedMs} ms)`;
+              if (stats) stats.textContent = `${WIDTH}×${HEIGHT} · ${currentSpp} spp · ${elapsedMs} ms`;
+              rafId = null;
+            }
+          }
+          rafId = requestAnimationFrame(stepProgressive);
+        }
+
+        async function loadWasm() {
+          const candidateDirs = ['./public/wasm/', './wasm/', '/devtools-times/wasm/', '/wasm/'];
+          for (const dir of candidateDirs) {
+            try {
+              const res = await fetch(dir + 'smallpt.wasm', { method: 'HEAD' });
+              if (res.ok) {
+                await new Promise((resolve, reject) => {
+                  const s = document.createElement('script');
+                  s.src = dir + 'smallpt.js';
+                  s.onload = resolve;
+                  s.onerror = reject;
+                  document.head.appendChild(s);
+                });
+                const mod = await window.createSmallptModule({
+                  locateFile: (p) => dir + p,
+                });
+                wasmMod = mod;
+                window.smallptWasm = mod;
+                return mod;
+              }
+            } catch (e) {}
+          }
+          throw new Error('Failed to load smallpt.wasm');
+        }
+
+        document.getElementById('randomize-colors-btn').addEventListener('click', () => {
+          if (wasmMod) startRenderSequence(wasmMod, true);
+        });
+
+        loadWasm().then((mod) => startRenderSequence(mod, false));
+      })();
+    </script>
+  </body>
+</html>
