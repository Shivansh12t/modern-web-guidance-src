@@ -0,0 +1,287 @@
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <emscripten/emscripten.h>
+
+// Kevin Beason's smallpt, a Path Tracer in C++ (http://www.kevinbeason.com/smallpt/)
+// Compiled to WebAssembly for client-side browser execution.
+
+struct Vec {
+  double x, y, z; // position, also color (r,g,b)
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) { x = x_; y = y_; z = z_; }
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec& norm() { return *this = *this * (1 / sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; } // cross:
+  Vec operator%(Vec &b) { return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x); }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR }; // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_) :
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p - r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0; else det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+Sphere spheres[] = { // Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) { return int(pow(clamp(x), 1 / 2.2) * 255 + .5); }
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+  double n = sizeof(spheres) / sizeof(Sphere), d, inf = t = 1e20;
+  for (int i = int(n); i--;) if ((d = spheres[i].intersect(r)) && d < t) { t = d; id = i; }
+  return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+  double t;                               // distance to intersection
+  int id = 0;                             // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z; // max refl
+  if (++depth > 5) {
+    if (depth < 32 && erand48(Xi) < p) f = f * (1 / p);
+    else return obj.e; // R.R.
+  }
+  if (obj.refl == DIFF) {                  // Ideal DIFFUSE reflection
+    double r1 = 2 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth, Xi));
+  Ray reflRay(x, r.d - n * 2 * n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl) > 0;                // Ray from outside going in?
+  double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re, RP = Re / P, TP = Tr / (1 - P);
+  return obj.e + f.mult(depth > 2 ? (erand48(Xi) < P ?   // Russian roulette
+    radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+    radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+static int current_w = 0;
+static int current_h = 0;
+static int accumulated_samples = 0;
+static Vec *accum_buffer = nullptr;
+static uint8_t *rgba_buffer = nullptr;
+
+static double rand01(unsigned int &state) {
+  state = state * 1664525u + 1013904223u;
+  return (double)(state & 0x00FFFFFFu) / (double)0x01000000u;
+}
+
+static Vec hsv_to_rgb(double h, double s, double v) {
+  double c = v * s;
+  double hp = fmod(h * 6.0, 6.0);
+  double x = c * (1.0 - fabs(fmod(hp, 2.0) - 1.0));
+  double m = v - c;
+  double r = 0, g = 0, b = 0;
+  if (hp < 1.0)      { r = c; g = x; b = 0; }
+  else if (hp < 2.0) { r = x; g = c; b = 0; }
+  else if (hp < 3.0) { r = 0; g = c; b = x; }
+  else if (hp < 4.0) { r = 0; g = x; b = c; }
+  else if (hp < 5.0) { r = x; g = 0; b = c; }
+  else               { r = c; g = 0; b = x; }
+  return Vec(r + m, g + m, b + m);
+}
+
+static void update_rgba_buffer(int w, int h) {
+  double inv_samples = accumulated_samples > 0 ? (1.0 / (double)accumulated_samples) : 1.0;
+  for (int i = 0; i < w * h; i++) {
+    rgba_buffer[i * 4 + 0] = (uint8_t)toInt(accum_buffer[i].x * inv_samples);
+    rgba_buffer[i * 4 + 1] = (uint8_t)toInt(accum_buffer[i].y * inv_samples);
+    rgba_buffer[i * 4 + 2] = (uint8_t)toInt(accum_buffer[i].z * inv_samples);
+    rgba_buffer[i * 4 + 3] = 255;
+  }
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void reset_sphere_colors() {
+  spheres[0].c = Vec(.75, .25, .25);      // Left
+  spheres[1].c = Vec(.25, .25, .75);      // Right
+  spheres[2].c = Vec(.75, .75, .75);      // Back
+  spheres[3].c = Vec(0, 0, 0);            // Front
+  spheres[4].c = Vec(.75, .75, .75);      // Bottom
+  spheres[5].c = Vec(.75, .75, .75);      // Top
+  spheres[6].c = Vec(1, 1, 1) * .999;     // Mirror sphere
+  spheres[7].c = Vec(1, 1, 1) * .999;     // Glass sphere
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < 9) {
+    spheres[id].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color(int id, int channel) {
+  if (id < 0 || id >= 9) return 0.0;
+  if (channel == 0) return spheres[id].c.x;
+  if (channel == 1) return spheres[id].c.y;
+  if (channel == 2) return spheres[id].c.z;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned int state = seed ? seed : 1337u;
+  double base_hue = rand01(state);
+  // Left wall sphere
+  spheres[0].c = hsv_to_rgb(fmod(base_hue + 0.05 * rand01(state), 1.0), 0.70 + 0.25 * rand01(state), 0.72 + 0.20 * rand01(state));
+  // Right wall sphere
+  spheres[1].c = hsv_to_rgb(fmod(base_hue + 0.38 + 0.25 * rand01(state), 1.0), 0.70 + 0.25 * rand01(state), 0.72 + 0.20 * rand01(state));
+  // Back wall sphere
+  spheres[2].c = hsv_to_rgb(fmod(base_hue + 0.68 + 0.20 * rand01(state), 1.0), 0.35 + 0.45 * rand01(state), 0.72 + 0.20 * rand01(state));
+  // Bottom floor sphere
+  spheres[4].c = hsv_to_rgb(fmod(base_hue + 0.18 + 0.30 * rand01(state), 1.0), 0.25 + 0.45 * rand01(state), 0.72 + 0.20 * rand01(state));
+  // Top ceiling sphere
+  spheres[5].c = hsv_to_rgb(fmod(base_hue + 0.52 + 0.30 * rand01(state), 1.0), 0.20 + 0.35 * rand01(state), 0.78 + 0.18 * rand01(state));
+  // Mirror foreground sphere (Sphere 6)
+  spheres[6].c = hsv_to_rgb(fmod(base_hue + 0.25 + 0.50 * rand01(state), 1.0), 0.55 + 0.40 * rand01(state), 0.96);
+  // Glass foreground sphere (Sphere 7)
+  spheres[7].c = hsv_to_rgb(fmod(base_hue + 0.75 + 0.50 * rand01(state), 1.0), 0.50 + 0.45 * rand01(state), 0.98);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_render(int w, int h) {
+  if (w != current_w || h != current_h || !accum_buffer || !rgba_buffer) {
+    delete[] accum_buffer;
+    delete[] rgba_buffer;
+    current_w = w;
+    current_h = h;
+    accum_buffer = new Vec[w * h];
+    rgba_buffer = new uint8_t[w * h * 4];
+  }
+  for (int i = 0; i < w * h; i++) {
+    accum_buffer[i] = Vec(0, 0, 0);
+    rgba_buffer[i * 4 + 0] = 0;
+    rgba_buffer[i * 4 + 1] = 0;
+    rgba_buffer[i * 4 + 2] = 0;
+    rgba_buffer[i * 4 + 3] = 255;
+  }
+  accumulated_samples = 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int render_fast_pass(int w, int h, unsigned int seed_offset) {
+  if (w != current_w || h != current_h || !accum_buffer || !rgba_buffer) {
+    init_render(w, h);
+  }
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135;
+
+  int pass_base = accumulated_samples;
+  for (int y = 0; y < h; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)(y + seed_offset),
+      (unsigned short)(pass_base * 313 + y * 17 + seed_offset),
+      (unsigned short)(y * y * y + pass_base * 997 + seed_offset * 131)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      int sub = (x + y * 2 + pass_base) & 3;
+      int sx = sub & 1;
+      int sy = (sub >> 1) & 1;
+      double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+      double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+      Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+              cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+      Vec r = radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi);
+      accum_buffer[i] = accum_buffer[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z));
+    }
+  }
+  accumulated_samples += 1;
+  update_rgba_buffer(w, h);
+  return accumulated_samples;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int render_samples(int w, int h, int samps, unsigned int seed_offset) {
+  if (w != current_w || h != current_h || !accum_buffer || !rgba_buffer) {
+    init_render(w, h);
+  }
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm()); // cam pos, dir
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135, r;
+
+  int pass_base = accumulated_samples;
+  for (int y = 0; y < h; y++) {                       // Loop over image rows
+    unsigned short Xi[3] = {
+      (unsigned short)(y + seed_offset),
+      (unsigned short)(pass_base * 313 + y * 17 + seed_offset),
+      (unsigned short)(y * y * y + pass_base * 997 + seed_offset * 131)
+    };
+    for (unsigned short x = 0; x < w; x++) {          // Loop cols
+      int i = (h - y - 1) * w + x;
+      Vec subpixel_sum(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {                // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++, r = Vec()) {   // 2x2 subpixel cols
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          subpixel_sum = subpixel_sum + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * (double)samps;
+        }
+      }
+      accum_buffer[i] = accum_buffer[i] + subpixel_sum;
+    }
+  }
+
+  accumulated_samples += 4 * samps;
+  update_rgba_buffer(w, h);
+  return accumulated_samples;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_pixel_buffer() {
+  return rgba_buffer;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps, unsigned int seed) {
+  init_render(w, h);
+  render_samples(w, h, samps, seed);
+  return rgba_buffer;
+}
+
