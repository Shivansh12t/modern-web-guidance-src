+        font-size: 0.95rem;
+      }
+      button {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        background: #f59e0b;
+        color: #020617;
+        font-weight: 700;
+        font-size: 0.95rem;
+        border: none;
+        border-radius: 0.5rem;
+        padding: 0.75rem 1.25rem;
+        cursor: pointer;
+        transition: background 0.15s ease;
+      }
+      button:hover {
+        background: #fbbf24;
+      }
+      button:active {
+        background: #d97706;
+      }
+      .swatches {
+        margin-top: 1.5rem;
+        padding-top: 1.25rem;
+        border-top: 1px solid #1e293b;
+        display: grid;
+        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+        gap: 0.5rem;
+        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+        font-size: 0.75rem;
+      }
+      .swatch {
+        display: flex;
+        align-items: center;
+        gap: 0.5rem;
+        background: #0f172a;
+        border: 1px solid #1e293b;
+        padding: 0.375rem 0.625rem;
+        border-radius: 0.25rem;
+      }
+      .dot {
+        width: 0.875rem;
+        height: 0.875rem;
+        border-radius: 9999px;
+        border: 1px solid rgba(255, 255, 255, 0.25);
+        flex-shrink: 0;
+      }
