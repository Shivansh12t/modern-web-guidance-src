+++ b/src/components/SmallptPathTracer.astro
@@ -0,0 +1,293 @@
+---
+const baseUrl = import.meta.env.BASE_URL || '/devtools-times/';
+const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+---
+
+<section
+  id="smallpt-section"
+  class="bg-slate-950 text-white rounded-xl shadow-lg border border-slate-800 overflow-hidden mb-8"
+>
+  <div class="p-6 md:p-8">
+    <div class="flex flex-col lg:flex-row gap-8 items-center lg:items-start">
+      <!-- Left Column: Canvas Output -->
+      <div class="flex flex-col items-center w-full lg:w-auto flex-shrink-0">
+        <div class="relative rounded-lg overflow-hidden border-2 border-slate-700 bg-black shadow-2xl">
+          <canvas
+            id="smallpt-canvas"
+            width="320"
+            height="240"
+            class="block w-[320px] sm:w-[440px] h-[240px] sm:h-[330px] object-contain"
+            style="image-rendering: auto;"
+          ></canvas>
+          <div
+            id="smallpt-badge"
+            class="absolute top-2.5 left-2.5 bg-slate-900/85 backdrop-blur-sm text-amber-400 text-xs font-mono px-2.5 py-1 rounded border border-slate-700"
+          >
+            Initializing WebAssembly...
+          </div>
+        </div>
+        <div class="mt-2.5 flex items-center justify-between w-full text-xs text-slate-400 font-mono px-1">
+          <span id="smallpt-stats">320×240 · Monte Carlo Global Illumination</span>
+          <span id="smallpt-run-indicator">Run #1 (Default Cornell Box)</span>
+        </div>
+      </div>
+
+      <!-- Right Column: Controls, Sphere Palette, and Technical Details -->
+      <div class="flex-1 flex flex-col justify-between w-full">
+        <div>
+          <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-amber-400 bg-amber-400/10 border border-amber-400/30 px-2.5 py-1 rounded mb-3">
+            <span>WebAssembly C++ Path Tracer</span>
+            <span>·</span>
+            <span>smallpt by Kevin Beason</span>
+          </div>
+          <h2 class="text-2xl md:text-3xl font-brand font-bold text-white leading-tight">
+            Interactive <code class="text-amber-400 font-mono text-xl md:text-2xl">smallpt</code> Global Illumination Renderer
+          </h2>
+          <p class="mt-2 text-sm md:text-base text-slate-300 leading-relaxed">
+            Compiled from Kevin Beason&apos;s open-source C++ path tracer (<code class="text-amber-300 font-mono text-xs">smallpt.cpp</code>) to WebAssembly using Emscripten. Simulates diffuse interreflection, specular mirror reflection, and dielectric glass refraction with caustics directly in your browser.
+          </p>
+
+          <!-- Primary Action Button -->
+          <div class="mt-5 flex flex-wrap items-center gap-3">
+            <button
+              id="randomize-colors-btn"
+              data-testid="randomize-sphere-colors"
+              type="button"
+              class="inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-950 font-bold text-sm md:text-base px-5 py-3 rounded-lg shadow-md transition-colors cursor-pointer"
+            >
+              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
+                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
+              </svg>
+              <span>Run Again with Randomized Sphere Colors</span>
+            </button>
+          </div>
+
+          <!-- Active Sphere Colors Swatches -->
+          <div class="mt-6 pt-5 border-t border-slate-800">
+            <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-3">
+              Active Scene Sphere Colors (Wasm Memory)
+            </div>
+            <div id="smallpt-swatches" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs font-mono">
+              <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 rounded px-2.5 py-1.5">
+                <span data-swatch-id="0" class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background: rgb(191, 64, 64);"></span>
+                <span class="text-slate-300 truncate">Left Sphere</span>
+                <span data-swatch-hex="0" class="text-slate-500 ml-auto">#BF4040</span>
+              </div>
+              <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 rounded px-2.5 py-1.5">
+                <span data-swatch-id="1" class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background: rgb(64, 64, 191);"></span>
+                <span class="text-slate-300 truncate">Right Sphere</span>
+                <span data-swatch-hex="1" class="text-slate-500 ml-auto">#4040BF</span>
+              </div>
+              <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 rounded px-2.5 py-1.5">
+                <span data-swatch-id="2" class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background: rgb(191, 191, 191);"></span>
+                <span class="text-slate-300 truncate">Back Sphere</span>
+                <span data-swatch-hex="2" class="text-slate-500 ml-auto">#BFBFBF</span>
+              </div>
+              <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 rounded px-2.5 py-1.5">
+                <span data-swatch-id="4" class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background: rgb(191, 191, 191);"></span>
+                <span class="text-slate-300 truncate">Floor Sphere</span>
+                <span data-swatch-hex="4" class="text-slate-500 ml-auto">#BFBFBF</span>
+              </div>
+              <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 rounded px-2.5 py-1.5">
+                <span data-swatch-id="6" class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background: rgb(255, 255, 255);"></span>
+                <span class="text-slate-300 truncate">Mirror Sphere</span>
+                <span data-swatch-hex="6" class="text-slate-500 ml-auto">#FFFFFF</span>
+              </div>
+              <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-800 rounded px-2.5 py-1.5">
+                <span data-swatch-id="7" class="w-4 h-4 rounded-full border border-white/20 flex-shrink-0" style="background: rgb(255, 255, 255);"></span>
+                <span class="text-slate-300 truncate">Glass Sphere</span>
+                <span data-swatch-hex="7" class="text-slate-500 ml-auto">#FFFFFF</span>
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  </div>
+</section>
+
+<script is:inline src={`${normalizedBase}wasm/smallpt.js`}></script>
+<script is:inline define:vars={{ normalizedBase }}>
+  (function () {
+    const WIDTH = 320;
+    const HEIGHT = 240;
+    const TARGET_SPP = 16;
+
+    let wasmMod = null;
+    let wasmInitPromise = null;
+    let rafId = null;
+    let runCount = 0;
+    let activeJobId = 0;
+
+    function toHexChannel(val) {
+      const n = Math.max(0, Math.min(255, Math.round(Math.pow(Math.max(0, Math.min(1, val)), 1 / 2.2) * 255)));
+      return n.toString(16).padStart(2, '0').toUpperCase();
+    }
+
+    function updateSwatches(mod) {
+      const ids = [0, 1, 2, 4, 6, 7];
+      for (const id of ids) {
+        const r = mod._get_sphere_color(id, 0);
+        const g = mod._get_sphere_color(id, 1);
+        const b = mod._get_sphere_color(id, 2);
+        const hex = '#' + toHexChannel(r) + toHexChannel(g) + toHexChannel(b);
+        const dot = document.querySelector(`[data-swatch-id="${id}"]`);
+        const label = document.querySelector(`[data-swatch-hex="${id}"]`);
+        if (dot) dot.style.backgroundColor = hex;
+        if (label) label.textContent = hex;
+      }
+    }
+
+    function blitToCanvas(mod, canvas) {
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+      const ptr = mod._get_pixel_buffer();
+      const byteLength = WIDTH * HEIGHT * 4;
+      const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, byteLength);
+      const imageData = new ImageData(new Uint8ClampedArray(pixels), WIDTH, HEIGHT);
+      ctx.putImageData(imageData, 0, 0);
+    }
+
+    function startRenderSequence(mod, randomize) {
+      const canvas = document.getElementById('smallpt-canvas');
+      if (!canvas) return;
+
+      if (rafId !== null) {
+        cancelAnimationFrame(rafId);
+        rafId = null;
+      }
+
+      activeJobId++;
+      const currentJobId = activeJobId;
+      runCount++;
+
+      const seed = ((Date.now() & 0xffff) ^ (runCount * 26547)) >>> 0 || 1;
+      if (randomize) {
+        mod._randomize_sphere_colors(seed);
+      } else {
+        mod._reset_sphere_colors();
+      }
+
+      updateSwatches(mod);
+
+      const badge = document.getElementById('smallpt-badge');
+      const stats = document.getElementById('smallpt-stats');
+      const runIndicator = document.getElementById('smallpt-run-indicator');
+
+      if (runIndicator) {
+        runIndicator.textContent = randomize
+          ? `Run #${runCount} (Randomized Sphere Colors)`
+          : `Run #${runCount} (Default Cornell Box)`;
+      }
+
+      const startTime = performance.now();
+      mod._init_render(WIDTH, HEIGHT);
+
+      // Synchronous first pass so the canvas immediately displays the rendered output
+      let currentSpp = mod._render_fast_pass(WIDTH, HEIGHT, seed);
+      blitToCanvas(mod, canvas);
+
+      const firstPassMs = Math.round(performance.now() - startTime);
+      canvas.setAttribute('data-rendered', 'true');
+      canvas.setAttribute('data-run-count', String(runCount));
+      canvas.setAttribute('data-spp', String(currentSpp));
+
+      if (badge) {
+        badge.textContent = `Rendering · ${currentSpp}/${TARGET_SPP} spp`;
+      }
+      if (stats) {
+        stats.textContent = `${WIDTH}×${HEIGHT} · ${currentSpp} spp · ${firstPassMs} ms`;
+      }
+
+      function stepProgressive() {
+        if (currentJobId !== activeJobId) return;
+        const currentCanvas = document.getElementById('smallpt-canvas');
+        if (!currentCanvas) return;
+
+        currentSpp = mod._render_fast_pass(WIDTH, HEIGHT, seed + currentSpp * 97);
+        blitToCanvas(mod, currentCanvas);
+        currentCanvas.setAttribute('data-spp', String(currentSpp));
+
+        const elapsedMs = Math.round(performance.now() - startTime);
+        const curBadge = document.getElementById('smallpt-badge');
+        const curStats = document.getElementById('smallpt-stats');
+
+        if (currentSpp < TARGET_SPP) {
+          if (curBadge) curBadge.textContent = `Rendering · ${currentSpp}/${TARGET_SPP} spp`;
+          if (curStats) curStats.textContent = `${WIDTH}×${HEIGHT} · ${currentSpp} spp · ${elapsedMs} ms`;
+          rafId = requestAnimationFrame(stepProgressive);
+        } else {
+          if (curBadge) curBadge.textContent = `Complete · ${currentSpp} spp (${elapsedMs} ms)`;
+          if (curStats) curStats.textContent = `${WIDTH}×${HEIGHT} · ${currentSpp} spp · ${elapsedMs} ms`;
+          rafId = null;
+        }
+      }
+
+      rafId = requestAnimationFrame(stepProgressive);
+    }
+
+    async function ensureWasmLoaded() {
+      if (wasmMod) return wasmMod;
+      if (wasmInitPromise) return wasmInitPromise;
+
+      wasmInitPromise = (async () => {
+        if (typeof window.createSmallptModule !== 'function') {
+          await new Promise((resolve, reject) => {
+            const s = document.createElement('script');
+            s.src = `${normalizedBase}wasm/smallpt.js`;
+            s.onload = resolve;
+            s.onerror = reject;
+            document.head.appendChild(s);
+          });
+        }
+        const mod = await window.createSmallptModule({
+          locateFile: function (path) {
+            return `${normalizedBase}wasm/${path}`;
+          },
+        });
+        wasmMod = mod;
+        window.smallptWasm = mod;
+        return mod;
+      })();
+
+      return wasmInitPromise;
+    }
+
+    function bindAndRun() {
+      const btn = document.getElementById('randomize-colors-btn');
+      if (btn && !btn.hasAttribute('data-smallpt-bound')) {
+        btn.setAttribute('data-smallpt-bound', 'true');
+        btn.addEventListener('click', function () {
+          if (wasmMod) {
+            startRenderSequence(wasmMod, true);
+          } else {
+            ensureWasmLoaded().then(function (mod) {
+              startRenderSequence(mod, true);
+            });
+          }
+        });
+      }
+
+      const canvas = document.getElementById('smallpt-canvas');
+      if (canvas && !canvas.hasAttribute('data-smallpt-initialized')) {
+        canvas.setAttribute('data-smallpt-initialized', 'true');
+        ensureWasmLoaded().then(function (mod) {
+          startRenderSequence(mod, false);
+        });
+      }
+    }
+
+    window.runSmallptWithRandomizedColors = function () {
+      if (wasmMod) {
+        startRenderSequence(wasmMod, true);
+      } else {
+        ensureWasmLoaded().then(function (mod) {
+          startRenderSequence(mod, true);
+        });
+      }
+    };
+
+    bindAndRun();
+    document.addEventListener('astro:page-load', bindAndRun);
+  })();
+</script>
