+  <script src="smallpt.js"></script>
+  <script>
+    (function () {
+      const SPHERE_METADATA = [
+        { index: 0, name: 'Left Wall Sphere', role: 'DIFF' },
+        { index: 1, name: 'Right Wall Sphere', role: 'DIFF' },
+        { index: 2, name: 'Back Wall Sphere', role: 'DIFF' },
+        { index: 4, name: 'Floor Sphere', role: 'DIFF' },
+        { index: 5, name: 'Ceiling Sphere', role: 'DIFF' },
+        { index: 6, name: 'Left Mirror Sphere', role: 'SPEC' },
+        { index: 7, name: 'Right Glass Sphere', role: 'REFR' }
+      ];
+
+      const canvas = document.getElementById('render-canvas');
+      const ctx = canvas.getContext('2d');
+      const statusDot = document.getElementById('status-dot');
+      const statusText = document.getElementById('status-text');
+      const progressBar = document.getElementById('progress-bar');
+
+      const statRes = document.getElementById('stat-res');
+      const statSpp = document.getElementById('stat-spp');
+      const statTime = document.getElementById('stat-time');
+      const statProgress = document.getElementById('stat-progress');
+
+      const randomizeBtn = document.getElementById('randomize-btn');
+      const refineBtn = document.getElementById('refine-btn');
+      const resetBtn = document.getElementById('reset-btn');
+      const resolutionSelect = document.getElementById('resolution-select');
+      const samplesSelect = document.getElementById('samples-select');
+      const spherePaletteEl = document.getElementById('sphere-palette');
+
+      let wasmReady = false;
+      let currentRenderId = 0;
+      let passCounter = 1;
+
+      function toDisplaySrgbHex(r, g, b) {
+        const gamma = (v) => Math.min(255, Math.max(0, Math.floor(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255 + 0.5)));
+        const hr = gamma(r).toString(16).padStart(2, '0');
+        const hg = gamma(g).toString(16).padStart(2, '0');
+        const hb = gamma(b).toString(16).padStart(2, '0');
+        return `#${hr}${hg}${hb}`.toUpperCase();
+      }
+
+      function updateSpherePaletteUI() {
+        if (!wasmReady) return;
+        spherePaletteEl.innerHTML = '';
+        for (const item of SPHERE_METADATA) {
+          const r = Module._get_sphere_color_r(item.index);
+          const g = Module._get_sphere_color_g(item.index);
+          const b = Module._get_sphere_color_b(item.index);
+          const hex = toDisplaySrgbHex(r, g, b);
+
+          const row = document.createElement('div');
+          row.className = 'sphere-item';
+          row.innerHTML = `
+            <div class="sphere-info">
+              <span class="sphere-swatch" style="background-color: ${hex};"></span>
+              <span class="sphere-name">${item.name}</span>
+            </div>
+            <span class="sphere-meta">${item.role} &bull; ${hex}</span>
+          `;
+          spherePaletteEl.appendChild(row);
+        }
+      }
+
+      function getSelectedResolution() {
+        const [w, h] = resolutionSelect.value.split('x').map(Number);
+        return { w, h };
+      }
+
+      function getSelectedSamps() {
+        return parseInt(samplesSelect.value, 10) || 2;
+      }
+
+      function blitWasmBufferToCanvas(w, h) {
+        const ptr = Module._get_rgba_buffer();
+        const byteLength = w * h * 4;
+        const wasmBytes = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, byteLength);
+        const imageData = new ImageData(new Uint8ClampedArray(wasmBytes), w, h);
+        ctx.putImageData(imageData, 0, 0);
+      }
+
+      function startRender({ resetBuffer = true } = {}) {
+        if (!wasmReady) return;
+
+        currentRenderId++;
+        const renderId = currentRenderId;
+        const { w, h } = getSelectedResolution();
+        const samps = getSelectedSamps();
+        passCounter++;
+
+        if (canvas.width !== w || canvas.height !== h) {
+          canvas.width = w;
+          canvas.height = h;
+          resetBuffer = true;
+        }
+
+        if (resetBuffer) {
+          Module._init_renderer(w, h);
+        }
+
+        updateSpherePaletteUI();
+
+        statRes.textContent = `${w} \u00D7 ${h}`;
+        const existingSamples = Module._get_total_samples();
+        const targetSamples = existingSamples + samps * 4;
+
+        statusDot.className = 'status-dot rendering';
+        statusText.textContent = `Tracing paths (${targetSamples} SPP)...`;
+        progressBar.style.width = '0%';
+        statProgress.textContent = '0%';
+
+        const startTime = performance.now();
+        let currentRow = 0;
+        // Choose chunk height so UI stays responsive at 60fps while maximizing throughput
+        const rowsPerStep = Math.max(4, Math.min(24, Math.floor(4000 / (w * samps))));
+
+        function step() {
+          if (renderId !== currentRenderId) return; // superseded by a new render
+
+          const nextRow = Math.min(h, currentRow + rowsPerStep);
+          Module._render_rows(currentRow, nextRow, samps, passCounter);
+          currentRow = nextRow;
+
+          blitWasmBufferToCanvas(w, h);
+
+          const elapsedSec = ((performance.now() - startTime) / 1000).toFixed(2);
+          const pct = Math.round((currentRow / h) * 100);
+          progressBar.style.width = `${pct}%`;
+          statProgress.textContent = `${pct}%`;
+          statTime.textContent = `${elapsedSec} s`;
+
+          if (currentRow < h) {
+            requestAnimationFrame(step);
+          } else {
+            Module._finish_pass(samps);
+            const totalSpp = Module._get_total_samples();
+            statSpp.textContent = `${totalSpp} SPP`;
+            statusDot.className = 'status-dot ready';
+            statusText.textContent = `Render Complete (${totalSpp} SPP in ${elapsedSec}s)`;
+          }
+        }
+
+        requestAnimationFrame(step);
+      }
+
+      function onWasmReady() {
+        if (wasmReady) return;
+        wasmReady = true;
+        randomizeBtn.disabled = false;
+        refineBtn.disabled = false;
+        resetBtn.disabled = false;
+        startRender({ resetBuffer: true });
+      }
+
+      randomizeBtn.addEventListener('click', () => {
+        if (!wasmReady) return;
+        const seed = Math.floor(Math.random() * 0x7FFFFFFF) ^ Date.now();
+        Module._randomize_sphere_colors(seed >>> 0);
+        startRender({ resetBuffer: true });
+      });
+
+      refineBtn.addEventListener('click', () => {
+        if (!wasmReady) return;
+        startRender({ resetBuffer: false });
+      });
+
+      resetBtn.addEventListener('click', () => {
+        if (!wasmReady) return;
+        Module._reset_default_colors();
+        startRender({ resetBuffer: true });
+      });
+
+      resolutionSelect.addEventListener('change', () => {
+        startRender({ resetBuffer: true });
+      });
+
+      samplesSelect.addEventListener('change', () => {
+        startRender({ resetBuffer: true });
+      });
+
+      // Hook into Emscripten runtime initialization
+      if (typeof Module !== 'undefined') {
+        if (Module._render && Module.HEAPU8) {
+          onWasmReady();
+        } else {
+          const prevCallback = Module.onRuntimeInitialized;
+          Module.onRuntimeInitialized = function () {
+            if (typeof prevCallback === 'function') prevCallback();
+            onWasmReady();
+          };
+        }
+      }
+    })();
+  </script>
 </body>
 
 </html>
