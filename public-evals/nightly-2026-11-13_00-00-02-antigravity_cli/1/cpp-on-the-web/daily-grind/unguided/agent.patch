+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Make : g++ -O3 -fopenmp smallpt.cpp -o smallpt
+//        Remove "-fopenmp" for g++ version < 4.2
+// Adapted for WebAssembly (Emscripten) with progressive scanline rendering,
+// interactive controls, and randomized sphere colors.
+
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if no hit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+// Default Cornell Box scene from Kevin Beason's smallpt (9 spheres)
+static const Vec default_colors[9] = {
+  Vec(.75,.25,.25),          // 0: Left wall (Red)
+  Vec(.25,.25,.75),          // 1: Right wall (Blue)
+  Vec(.75,.75,.75),          // 2: Back wall (Grey)
+  Vec(),                     // 3: Front wall (Black)
+  Vec(.75,.75,.75),          // 4: Bottom floor (Grey)
+  Vec(.75,.75,.75),          // 5: Top ceiling (Grey)
+  Vec(1,1,1)*.999,           // 6: Mirror sphere
+  Vec(1,1,1)*.999,           // 7: Glass sphere
+  Vec()                      // 8: Ceiling Area Light
+};
+
+static const int default_refl[9] = {
+  DIFF, DIFF, DIFF, DIFF, DIFF, DIFF, SPEC, REFR, DIFF
+};
+
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+
+// Explicit non-recursive/iterative or bounded recursive radiance to avoid Wasm stack overflow
+Vec radiance(const Ray &r_, int depth_, unsigned short *Xi){
+  Ray r = r_;
+  int depth = depth_;
+  Vec acc_color(0, 0, 0);
+  Vec throughput(1, 1, 1);
+
+  while (true) {
+    double t;                               // distance to intersection
+    int id=0;                               // id of intersected object
+    if (!intersect(r, t, id)) return acc_color; // if miss, return accumulated color
+    const Sphere &obj = spheres[id];        // the hit object
+    Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+    double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+
+    acc_color = acc_color + throughput.mult(obj.e);
+
+    if (++depth>5) {
+      if (erand48(Xi)<p && depth < 100) {
+        f=f*(1/p);
+      } else {
+        return acc_color; // R.R.
+      }
+    }
+
+    if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+      double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+      Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+      Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+      throughput = throughput.mult(f);
+      r = Ray(x, d);
+      continue;
+    } else if (obj.refl == SPEC) {          // Ideal SPECULAR reflection
+      throughput = throughput.mult(f);
+      r = Ray(x, r.d-n*2*n.dot(r.d));
+      continue;
+    }
+
+    Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+    bool into = n.dot(nl)>0;                // Ray from outside going in?
+    double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+    if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0) {  // Total internal reflection
+      throughput = throughput.mult(f);
+      r = reflRay;
+      continue;
+    }
+    Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+    double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+    double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+
+    if (erand48(Xi)<P) {
+      throughput = throughput.mult(f) * RP;
+      r = reflRay;
+    } else {
+      throughput = throughput.mult(f) * TP;
+      r = Ray(x, tdir);
+    }
+  }
+}
+
+// Buffers for WebAssembly rendering
+static int g_width = 0;
+static int g_height = 0;
+static Vec *g_accum = NULL;
+static uint8_t *g_rgba = NULL;
+static int g_total_samples = 0; // total samples per subpixel accumulated so far
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+int get_sphere_count() {
+  return sizeof(spheres) / sizeof(Sphere);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  for (int i = 0; i < 9; i++) {
+    spheres[i].c = default_colors[i];
+    spheres[i].refl = (Refl_t)default_refl[i];
+  }
+  if (g_accum && g_width > 0 && g_height > 0) {
+    for (int i = 0; i < g_width * g_height; i++) {
+      g_accum[i] = Vec(0, 0, 0);
+    }
+    g_total_samples = 0;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  int n = get_sphere_count();
+  if (index >= 0 && index < n) {
+    spheres[index].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_refl(int index, int refl_type) {
+  int n = get_sphere_count();
+  if (index >= 0 && index < n && refl_type >= 0 && refl_type <= 2) {
+    spheres[index].refl = (Refl_t)refl_type;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int index) {
+  if (index >= 0 && index < get_sphere_count()) return spheres[index].c.x;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int index) {
+  if (index >= 0 && index < get_sphere_count()) return spheres[index].c.y;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int index) {
+  if (index >= 0 && index < get_sphere_count()) return spheres[index].c.z;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_sphere_refl(int index) {
+  if (index >= 0 && index < get_sphere_count()) return (int)spheres[index].refl;
+  return 0;
+}
+
+// Helper for HSL to RGB conversion in C++ for vivid randomized palettes
+static double hue2rgb(double p, double q, double t) {
+  if (t < 0.0) t += 1.0;
+  if (t > 1.0) t -= 1.0;
+  if (t < 1.0/6.0) return p + (q - p) * 6.0 * t;
+  if (t < 1.0/2.0) return q;
+  if (t < 2.0/3.0) return p + (q - p) * (2.0/3.0 - t) * 6.0;
+  return p;
+}
+
+static Vec hsl_to_rgb(double h, double s, double l) {
+  double r, g, b;
+  if (s == 0.0) {
+    r = g = b = l;
+  } else {
+    double q = l < 0.5 ? l * (1.0 + s) : l + s - l * s;
+    double p = 2.0 * l - q;
+    r = hue2rgb(p, q, h + 1.0/3.0);
+    g = hue2rgb(p, q, h);
+    b = hue2rgb(p, q, h - 1.0/3.0);
+  }
+  return Vec(r, g, b);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 31337) & 0xFFFF)
+  };
+
+  // Randomize Left wall (0) and Right wall (1) with vibrant complementary/triadic hues
+  double base_hue = erand48(Xi);
+  double right_hue = fmod(base_hue + 0.35 + erand48(Xi) * 0.3, 1.0);
+  spheres[0].c = hsl_to_rgb(base_hue, 0.65 + erand48(Xi) * 0.25, 0.45 + erand48(Xi) * 0.15);
+  spheres[1].c = hsl_to_rgb(right_hue, 0.65 + erand48(Xi) * 0.25, 0.45 + erand48(Xi) * 0.15);
+
+  // Back wall (2), Floor (4), Ceiling (5) - subtle tinted neutrals or soft pastels
+  double back_hue = fmod(base_hue + 0.5, 1.0);
+  spheres[2].c = hsl_to_rgb(back_hue, 0.15 + erand48(Xi) * 0.25, 0.70 + erand48(Xi) * 0.12);
+  spheres[4].c = hsl_to_rgb(erand48(Xi), 0.10 + erand48(Xi) * 0.20, 0.72 + erand48(Xi) * 0.10);
+  spheres[5].c = hsl_to_rgb(erand48(Xi), 0.10 + erand48(Xi) * 0.15, 0.75 + erand48(Xi) * 0.10);
+
+  // Mirror sphere (6) - tinted metallic / colored specular or vibrant diffuse
+  double s6_hue = erand48(Xi);
+  spheres[6].c = hsl_to_rgb(s6_hue, 0.75 + erand48(Xi) * 0.24, 0.65 + erand48(Xi) * 0.25);
+
+  // Glass sphere (7) - tinted refractive crystal or colored sphere
+  double s7_hue = fmod(s6_hue + 0.25 + erand48(Xi) * 0.5, 1.0);
+  spheres[7].c = hsl_to_rgb(s7_hue, 0.75 + erand48(Xi) * 0.24, 0.70 + erand48(Xi) * 0.22);
+
+  // Clear accumulation buffer if initialized
+  if (g_accum && g_width > 0 && g_height > 0) {
+    for (int i = 0; i < g_width * g_height; i++) {
+      g_accum[i] = Vec(0, 0, 0);
+    }
+    g_total_samples = 0;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* init_renderer(int w, int h) {
+  if (w <= 0) w = 256;
+  if (h <= 0) h = 192;
+  if (g_width != w || g_height != h || !g_accum || !g_rgba) {
+    if (g_accum) free(g_accum);
+    if (g_rgba) free(g_rgba);
+    g_width = w;
+    g_height = h;
+    g_accum = (Vec*)malloc(sizeof(Vec) * w * h);
+    g_rgba = (uint8_t*)malloc(sizeof(uint8_t) * w * h * 4);
+  }
+  for (int i = 0; i < w * h; i++) {
+    g_accum[i] = Vec(0, 0, 0);
+    g_rgba[i * 4 + 0] = 0;
+    g_rgba[i * 4 + 1] = 0;
+    g_rgba[i * 4 + 2] = 0;
+    g_rgba[i * 4 + 3] = 255;
+  }
+  g_total_samples = 0;
+  return g_rgba;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_rgba_buffer() {
+  return g_rgba;
+}
+
+// Render a slice of scanlines [y_start, y_end) for `samps` samples per subpixel,
+// either overwriting or accumulating into the current buffer.
+// Note: in original smallpt, each pixel has 2x2 subpixels, and each subpixel takes `samps` samples
+// (total 4 * samps rays per pixel).
+EMSCRIPTEN_KEEPALIVE
+void render_rows(int y_start, int y_end, int samps, int pass_seed) {
+  if (!g_accum || !g_rgba || g_width <= 0 || g_height <= 0) return;
+  if (y_start < 0) y_start = 0;
+  if (y_end > g_height) y_end = g_height;
+  if (samps < 1) samps = 1;
+
+  int w = g_width;
+  int h = g_height;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  double weight_Completed = (double)g_total_samples;
+  double weight_New = (double)samps;
+  double inv_Total = 1.0 / (weight_Completed + weight_New);
+
+  for (int y = y_start; y < y_end; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)((y + pass_seed * 131) & 0xFFFF),
+      (unsigned short)((y * y + pass_seed * 997) & 0xFFFF),
+      (unsigned short)((y * y * y + pass_seed * 7919) & 0xFFFF)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec pixel_radiance(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++) {   // 2x2 subpixel cols
+          r = Vec();
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          pixel_radiance = pixel_radiance + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+
+      Vec combined = (g_accum[i] * weight_Completed + pixel_radiance * weight_New) * inv_Total;
+      g_accum[i] = combined;
+
+      g_rgba[i * 4 + 0] = (uint8_t)toInt(combined.x);
+      g_rgba[i * 4 + 1] = (uint8_t)toInt(combined.y);
+      g_rgba[i * 4 + 2] = (uint8_t)toInt(combined.z);
+      g_rgba[i * 4 + 3] = 255;
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void finish_pass(int samps) {
+  if (samps > 0) {
+    g_total_samples += samps;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_total_samples() {
+  return g_total_samples * 4; // total rays per pixel (since 2x2 subpixels)
+}
+
+// Synchronous full-frame render helper (matches simple one-call render)
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps, int seed) {
+  init_renderer(w, h);
+  render_rows(0, h, samps, seed);
+  finish_pass(samps);
+  return g_rgba;
+}
+
+} // extern "C"
+
+#ifndef __EMSCRIPTEN__
+int main(int argc, char *argv[]){
+  int w=1024, h=768, samps = argc==2 ? atoi(argv[1])/4 : 1; // # samples
+  init_renderer(w, h);
+  render_rows(0, h, samps, 0);
+  finish_pass(samps);
+  FILE *f = fopen("image.ppm", "w");         // Write image to PPM file.
+  fprintf(f, "P3\n%d %d\n%d\n", w, h, 255);
+  for (int i=0; i<w*h; i++)
+    fprintf(f,"%d %d %d ", g_rgba[i*4], g_rgba[i*4+1], g_rgba[i*4+2]);
