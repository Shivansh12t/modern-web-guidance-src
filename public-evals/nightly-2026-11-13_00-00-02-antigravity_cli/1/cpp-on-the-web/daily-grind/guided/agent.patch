+
+      if (worker) {
+        worker.postMessage({
+          width,
+          height,
+          samples,
+          colors: currentColors,
+          runId: runCounter,
+        });
+      } else {
+        renderFallbackOnMainThread(width, height, samples, currentColors, runCounter);
