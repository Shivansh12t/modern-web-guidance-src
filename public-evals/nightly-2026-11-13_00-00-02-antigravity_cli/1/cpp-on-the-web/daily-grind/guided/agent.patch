+
+      if (Array.isArray(colors) && colors.length >= 24) {
+        const colorPtr = wasm._malloc(24 * 8);
+        try {
+          const floatView = new Float64Array(wasm.HEAPF64.buffer, colorPtr, 24);
+          for (let i = 0; i < 24; i++) floatView[i] = colors[i];
+          wasm._set_sphere_colors(colorPtr, 8);
+        } finally {
+          wasm._free(colorPtr);
