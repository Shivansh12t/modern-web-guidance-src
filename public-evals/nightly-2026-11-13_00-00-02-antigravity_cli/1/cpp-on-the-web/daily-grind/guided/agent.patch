+    function toDisplayHex(r, g, b) {
+      const toChannel = (v) =>
+        Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255)
+          .toString(16)
+          .padStart(2, '0');
+      return `#${toChannel(r)}${toChannel(g)}${toChannel(b)}`;
+    }
+
