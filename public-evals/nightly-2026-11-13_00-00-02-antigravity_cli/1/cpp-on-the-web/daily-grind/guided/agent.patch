+++ b/smallpt-worker.js
@@ -0,0 +1,69 @@
+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (event) => {
+  const { width = 320, height = 240, samples = 8, colors = null, runId = 0 } = event.data;
+
+  try {
+    const wasm = await getWasm();
+    const startTime = performance.now();
+
+    if (Array.isArray(colors) && colors.length >= 24) {
+      const colorByteLength = 24 * 8; // 24 doubles
+      const colorPtr = wasm._malloc(colorByteLength);
+      try {
+        const floatView = new Float64Array(wasm.HEAPF64.buffer, colorPtr, 24);
+        for (let i = 0; i < 24; i++) {
+          floatView[i] = colors[i];
+        }
+        wasm._set_sphere_colors(colorPtr, 8);
+      } finally {
+        wasm._free(colorPtr);
+      }
+    } else {
+      wasm._reset_default_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const pixelPtr = wasm._malloc(byteLength);
+
+    try {
+      wasm._render_smallpt(pixelPtr, width, height, samples);
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        pixelPtr,
+        byteLength,
+      ).slice();
+      const durationMs = Math.round(performance.now() - startTime);
+
+      self.postMessage(
+        {
+          type: 'done',
+          runId,
+          width,
+          height,
+          samples,
+          durationMs,
+          pixels,
+        },
+        [pixels.buffer],
+      );
+    } finally {
+      wasm._free(pixelPtr);
+    }
+  } catch (err) {
+    self.postMessage({
+      type: 'error',
+      runId,
+      message: err instanceof Error ? err.message : String(err),
+    });
+  }
+});
