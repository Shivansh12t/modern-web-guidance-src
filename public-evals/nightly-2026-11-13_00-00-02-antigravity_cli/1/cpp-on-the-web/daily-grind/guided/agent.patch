+      for (let i = 0; i < 8; i++) {
+        if (i === 3) {
+          // Keep camera-side front wall dark so interior stays well-lit without washing out contrast
+          next[i * 3 + 0] = 0;
+          next[i * 3 + 1] = 0;
+          next[i * 3 + 2] = 0;
+          continue;
+        }
+        const hue = Math.random() * 360;
+        const sat = i >= 6 ? 0.65 + Math.random() * 0.3 : 0.55 + Math.random() * 0.35;
+        const light = i >= 6 ? 0.65 + Math.random() * 0.25 : 0.45 + Math.random() * 0.3;
+        const [r, g, b] = hslToRgb(hue, sat, light);
+        next[i * 3 + 0] = Number(r.toFixed(3));
+        next[i * 3 + 1] = Number(g.toFixed(3));
+        next[i * 3 + 2] = Number(b.toFixed(3));
