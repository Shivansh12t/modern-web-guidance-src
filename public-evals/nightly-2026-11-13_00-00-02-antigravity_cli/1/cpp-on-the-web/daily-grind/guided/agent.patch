+          runId,
+          width,
+          height,
+          samples,
+          durationMs,
+          pixels,
+        });
+      } finally {
+        wasm._free(pixelPtr);
+      }
+    }
+
+    function handleRenderResult(data) {
+      if (data.type === 'done') {
+        const imageData = new ImageData(data.pixels, data.width, data.height);
+        ctx.putImageData(imageData, 0, 0);
+        statusBox.textContent = `Rendered ${data.width}×${data.height} (${data.samples * 4} total samples/pixel via 2×2 subpixels) in ${data.durationMs} ms using WebAssembly.`;
