+        display: block;
+        position: relative;
+        padding-inline-end: 2.5rem;
+      }
+
+      .copyable .copy {
+        position: absolute;
+        inset-block-start: 0.5rem;
+        inset-inline-end: 0.5rem;
+      }
+
+      .copyable .copy-button {
+        opacity: 0;
