+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const stage = document.getElementById('canvas-stage');
+      const uiElement = document.getElementById('cup-customizer-ui');
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('cup-milk');
+      const syrupSelect = document.getElementById('cup-syrup');
+      const liveSummary = document.getElementById('cup-live-summary');
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      // Fallback strategy if HTML-in-Canvas is not supported in the browser:
+      // Move the interactive HTML controls out of the canvas and overlay them via CSS.
+      if (!supportsHtmlInCanvas) {
+        stage.classList.add('fallback-overlay');
+        stage.appendChild(uiElement);
+      }
+
+      const MILK_COLORS = {
+        'Oat Milk': '#e6d2b5',
+        'Whole Milk': '#f3e5ab',
+        'Almond Milk': '#dfcaa0',
+        'Soy Milk': '#ebe0c5'
+      };
+
+      const SYRUP_COLORS = {
+        'Vermont Maple': '#c66900',
+        'Madagascar Vanilla': '#f4c430',
+        'Salted Caramel': '#d4882a',
+        'Roasted Hazelnut': '#795548',
+        'No Syrup': 'transparent'
+      };
+
+      function updateOrderSummary() {
+        const rawName = nameInput.value.trim();
+        const displayName = rawName || 'Guest';
+        const milk = milkSelect.value;
+        const syrup = syrupSelect.value;
+        liveSummary.textContent = '';
+        liveSummary.append('Order for ');
+        const strong = document.createElement('strong');
+        strong.textContent = displayName;
+        liveSummary.append(strong, `: ${milk} + ${syrup}`);
+        requestCanvasRender();
+      }
+
+      function drawCoffeeCupScene() {
+        ctx.reset();
+
+        const cssWidth = canvas.clientWidth || 480;
+        const cssHeight = canvas.clientHeight || 500;
+        const scaleX = canvas.width / cssWidth;
+        const scaleY = canvas.height / cssHeight;
+
+        ctx.save();
+        ctx.scale(scaleX, scaleY);
+
+        const cx = cssWidth / 2;
+
+        // Soft shadow under the cup
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.12)';
+        ctx.beginPath();
+        ctx.ellipse(cx, 462, 95, 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Steam wisps
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-35, 0, 35].forEach((offset, idx) => {
+          ctx.beginPath();
+          ctx.moveTo(cx + offset, 58);
+          ctx.quadraticCurveTo(cx + offset - 10, 38 - idx * 3, cx + offset + 4, 22);
+          ctx.stroke();
+        });
+
+        // Cup body trapezoid
+        const topY = 104;
+        const bottomY = 452;
+        const topHalfW = 132;
+        const bottomHalfW = 92;
+
+        ctx.fillStyle = '#f7f2eb';
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        ctx.moveTo(cx - topHalfW, topY);
+        ctx.lineTo(cx + topHalfW, topY);
+        ctx.lineTo(cx + bottomHalfW, bottomY);
+        ctx.lineTo(cx - bottomHalfW, bottomY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Liquid/milk & syrup indicator band near top of cup
+        const milkColor = MILK_COLORS[milkSelect.value] || '#e6d2b5';
+        ctx.fillStyle = milkColor;
+        ctx.beginPath();
+        ctx.moveTo(cx - topHalfW + 6, topY + 12);
+        ctx.lineTo(cx + topHalfW - 6, topY + 12);
+        ctx.lineTo(cx + topHalfW - 12, topY + 46);
+        ctx.lineTo(cx - topHalfW + 12, topY + 46);
+        ctx.closePath();
+        ctx.fill();
+
+        // Syrup swirl accent
+        const syrupColor = SYRUP_COLORS[syrupSelect.value] || 'transparent';
+        if (syrupColor !== 'transparent') {
+          ctx.strokeStyle = syrupColor;
+          ctx.lineWidth = 4;
+          ctx.beginPath();
+          ctx.moveTo(cx - 85, topY + 29);
+          ctx.bezierCurveTo(cx - 30, topY + 18, cx + 30, topY + 40, cx + 85, topY + 27);
+          ctx.stroke();
+        }
+
+        // Cardboard kraft sleeve backdrop behind the interactive HTML controls
+        const sleeveTopY = 166;
+        const sleeveBottomY = 404;
+        const sleeveTopHalfW = 122;
+        const sleeveBottomHalfW = 99;
+
+        ctx.fillStyle = '#c8a986';
+        ctx.strokeStyle = '#5d4037';
+        ctx.lineWidth = 2.5;
+        ctx.beginPath();
+        ctx.moveTo(cx - sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(cx + sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(cx + sleeveBottomHalfW, sleeveBottomY);
+        ctx.lineTo(cx - sleeveBottomHalfW, sleeveBottomY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Cup Lid
+        ctx.fillStyle = '#4e342e';
+        ctx.beginPath();
+        ctx.roundRect(cx - topHalfW - 12, topY - 22, (topHalfW + 12) * 2, 24, 8);
+        ctx.fill();
+
+        ctx.fillStyle = '#3e2723';
+        ctx.beginPath();
+        ctx.roundRect(cx - topHalfW + 4, topY - 36, (topHalfW - 4) * 2, 16, [6, 6, 0, 0]);
+        ctx.fill();
+
+        // Draw live interactive HTML inputs and text inside the cup sleeve
+        // drawElementImage automatically syncs DOM geometry and hit-test bounds in 2D context
+        if (supportsHtmlInCanvas && typeof ctx.drawElementImage === 'function') {
+          const uiWidth = uiElement.offsetWidth || 220;
+          const uiX = Math.round(cx - uiWidth / 2);
+          const uiY = 185;
+          ctx.drawElementImage(uiElement, uiX, uiY);
+        }
+
+        ctx.restore();
+      }
+
+      function requestCanvasRender() {
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          drawCoffeeCupScene();
+        }
+      }
+
+      canvas.onpaint = () => {
+        drawCoffeeCupScene();
+      };
+
+      nameInput.addEventListener('input', updateOrderSummary);
+      milkSelect.addEventListener('change', updateOrderSummary);
+      syrupSelect.addEventListener('change', updateOrderSummary);
+
+      // Scale canvas backing grid cleanly on high-DPI displays
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        requestCanvasRender();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+    })();
+  </script>
+
