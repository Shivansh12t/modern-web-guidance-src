+      margin-bottom: 20px;
+    }
+
+    #back-btn:hover {
+      background: #3e2723;
+    }
+
+    #hero {
+      display: block;
+      width: 100%;
+      max-height: 420px;
+      aspect-ratio: 16 / 9;
+      object-fit: cover;
+      border-radius: 8px;
+      margin-bottom: 20px;
+      view-transition-name: hero;
+    }
+
+    #detail-page #title {
+      width: fit-content;
+      color: var(--primary);
+      font-size: 2rem;
+      margin-bottom: 12px;
+      view-transition-name: title;
+    }
+
+    .thumbnail.selected {
+      view-transition-name: hero;
+    }
+
+    .thumbnail.selected .title {
+      view-transition-name: title;
+    }
+
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      height: 100%;
+      object-fit: cover;
+    }
+
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      height: 100%;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
+
