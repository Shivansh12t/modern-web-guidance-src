+  <script>
+    const listHeading = document.getElementById('list-heading');
+    const detailTitle = document.getElementById('title');
+    const detailHero = document.getElementById('hero');
+    const detailDesc = document.getElementById('detail-description');
+    const backBtn = document.getElementById('back-btn');
+    const thumbnails = document.querySelectorAll('.thumbnail');
+
+    function populateDetail(card) {
+      const titleText = card.dataset.title || card.querySelector('.title')?.textContent || '';
+      const imgSrc = card.dataset.img || card.querySelector('img')?.src || '';
+      const descText = card.dataset.desc || card.querySelector('p')?.textContent || '';
+
+      detailTitle.textContent = titleText;
+      detailHero.src = imgSrc;
+      detailHero.alt = titleText;
+      detailDesc.textContent = descText;
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+      card.classList.add('selected');
+      populateDetail(card);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      if (!document.startViewTransition) {
+        document.body.classList.remove('detail');
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+      });
+    }
+
+    thumbnails.forEach((card) => {
+      card.addEventListener('click', goFromListToDetail);
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          goFromListToDetail(e);
+        }
+      });
+    });
+
+    backBtn.addEventListener('click', goFromDetailToList);
+  </script>
