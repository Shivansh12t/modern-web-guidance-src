+  <script>
+    (function () {
+      const listPage = document.getElementById('list-page');
+      const listHeading = document.getElementById('list-heading');
+      const detailPage = document.getElementById('detail-page');
+      const heroImg = document.getElementById('hero');
+      const detailTitle = document.getElementById('title');
+      const detailDescription = document.getElementById('detail-description');
+      const detailNotes = document.getElementById('detail-notes');
+      const backButton = document.getElementById('back-button');
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      let activeCard = null;
+
+      function setActiveTransitionCard(card) {
+        thumbnails.forEach((thumb) => {
+          thumb.classList.remove('active');
+          thumb.style.viewTransitionName = '';
+          const titleEl = thumb.querySelector('.title');
+          if (titleEl) {
+            titleEl.style.viewTransitionName = '';
+          }
+        });
+
+        activeCard = card;
+        if (card) {
+          card.classList.add('active');
+          card.style.viewTransitionName = 'hero';
+          const titleEl = card.querySelector('.title');
+          if (titleEl) {
+            titleEl.style.viewTransitionName = 'title';
+          }
+        }
+      }
+
+      function runTransition(updateDOM, onDone) {
+        const prefersReducedMotion =
+          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+        if (!document.startViewTransition || prefersReducedMotion) {
+          updateDOM();
+          if (onDone) onDone();
+          return;
+        }
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        if (transition && transition.finished && onDone) {
+          transition.finished.then(onDone).catch(() => {});
+        }
+      }
+
+      function openDetail(card) {
+        const cardTitleEl = card.querySelector('.title');
+        const titleText = card.dataset.title || (cardTitleEl ? cardTitleEl.textContent : '');
+        const imageSrc = card.dataset.image || '';
+        const imageAlt = card.dataset.alt || titleText;
+        const descriptionText = card.dataset.description || '';
+        const notesText = card.dataset.notes || '';
+
+        setActiveTransitionCard(card);
+
+        runTransition(
+          () => {
+            heroImg.src = imageSrc;
+            heroImg.alt = imageAlt;
+            detailTitle.textContent = titleText;
+            detailDescription.textContent = descriptionText;
+            detailNotes.textContent = notesText;
+
+            listPage.hidden = true;
+            listPage.setAttribute('aria-hidden', 'true');
+            listPage.style.display = 'none';
+
+            detailPage.hidden = false;
+            detailPage.removeAttribute('aria-hidden');
+            detailPage.style.display = '';
+
+            detailTitle.focus({ preventScroll: true });
+          },
+          () => {
+            detailTitle.focus({ preventScroll: true });
+          }
+        );
+      }
+
+      function closeDetail() {
+        if (activeCard) {
+          setActiveTransitionCard(activeCard);
+        }
+
+        runTransition(
+          () => {
+            detailPage.hidden = true;
+            detailPage.setAttribute('aria-hidden', 'true');
+            detailPage.style.display = 'none';
+
+            listPage.hidden = false;
+            listPage.removeAttribute('aria-hidden');
+            listPage.style.display = '';
+
+            listHeading.focus({ preventScroll: true });
+          },
+          () => {
+            listHeading.focus({ preventScroll: true });
+          }
+        );
+      }
+
+      thumbnails.forEach((card) => {
+        card.addEventListener('click', () => {
+          openDetail(card);
+        });
+
+        card.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            openDetail(card);
+          }
+        });
+      });
+
+      backButton.addEventListener('click', () => {
+        closeDetail();
+      });
+
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && !detailPage.hidden) {
+          closeDetail();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
