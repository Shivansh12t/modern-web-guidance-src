+    /* Roast Selector */
+    .roast-selector {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.25rem;
+      margin-top: 1.25rem;
+      margin-bottom: 0.25rem;
+      text-align: left;
+    }
+
+    .roast-selector label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      color: var(--accent);
+      letter-spacing: 0.5px;
+    }
+
+    .brand-select,
+    .brand-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .brand-select {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      min-width: 14rem;
+      min-height: 48px;
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      padding: 0.65rem 1rem;
+      cursor: pointer;
+      transition: background-color 0.2s, border-color 0.2s;
+    }
+
+    .brand-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .brand-select::picker(select) {
+      font: inherit;
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      padding: 0.4rem;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
+    }
+
+    .brand-select::picker-icon {
+      color: var(--accent);
+    }
+
+    .brand-select option::checkmark {
+      color: var(--accent);
+    }
+
+    .brand-select option {
+      padding: 0.5rem 0.75rem;
+      border-radius: 4px;
+      background-color: var(--primary);
+      color: var(--accent);
+      cursor: pointer;
+    }
+
+    .brand-select option:hover,
+    .brand-select option:focus-visible {
+      background-color: var(--accent);
+      color: var(--primary);
+    }
+
+    .brand-select option:hover::checkmark,
+    .brand-select option:focus-visible::checkmark {
+      color: var(--primary);
+    }
+
+    @media (pointer: coarse) {
+      .brand-select {
+        min-height: 52px;
+      }
+    }
+
