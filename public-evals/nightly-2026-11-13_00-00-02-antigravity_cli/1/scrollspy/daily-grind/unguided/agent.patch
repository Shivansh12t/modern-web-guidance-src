+  <script>
+    (function () {
+      const nav = document.getElementById('main-nav');
+      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => {
+          const id = link.getAttribute('href').slice(1);
+          return document.getElementById(id);
+        })
+        .filter(Boolean);
+
+      function setActiveSection(sectionId) {
+        if (!sectionId) return;
+        navLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + sectionId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function computeActiveSection() {
+        if (!sections.length) return;
+
+        const navHeight = nav ? nav.offsetHeight : 68;
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        const scrollBottom = window.scrollY + viewportHeight;
+        const docHeight = Math.max(
+          document.body.scrollHeight,
+          document.documentElement.scrollHeight
+        );
+
+        // If scrolled to the very bottom of the page, highlight the last section if visible
+        if (scrollBottom >= docHeight - 10) {
+          const lastSection = sections[sections.length - 1];
+          const lastRect = lastSection.getBoundingClientRect();
+          if (lastRect.top < viewportHeight && lastRect.bottom > navHeight) {
+            setActiveSection(lastSection.id);
+            return;
+          }
+        }
+
+        // Probe line just below the sticky navigation bar
+        const probeLine = navHeight + Math.min(120, (viewportHeight - navHeight) * 0.3);
+
+        // 1. Check which section currently crosses the probe line
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= probeLine && rect.bottom > probeLine) {
+            setActiveSection(section.id);
+            return;
+          }
+        }
+
+        // 2. Otherwise pick the section with the largest visible height in the viewport
+        let bestSection = null;
+        let maxVisibleHeight = 0;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, viewportHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          if (visibleHeight > maxVisibleHeight) {
+            maxVisibleHeight = visibleHeight;
+            bestSection = section;
+          }
+        }
+
+        if (bestSection) {
+          setActiveSection(bestSection.id);
+          return;
+        }
+
+        // 3. Fallback: pick closest section to the top of the viewport
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const distance = Math.abs(rect.top - navHeight);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        }
+        if (closestSection) {
+          setActiveSection(closestSection.id);
+        }
+      }
+
+      // Update immediately when clicking a nav anchor link
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').slice(1);
+          setActiveSection(targetId);
+        });
+      });
+
+      // Use IntersectionObserver + scroll/resize/hashchange listeners for reliable updates
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            computeActiveSection();
+          },
+          {
+            root: null,
+            rootMargin: '-68px 0px -20% 0px',
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      window.addEventListener('scroll', computeActiveSection, { passive: true });
+      window.addEventListener('resize', computeActiveSection, { passive: true });
+      window.addEventListener('hashchange', () => {
+        const hashId = window.location.hash.replace(/^#/, '');
+        if (hashId && document.getElementById(hashId)) {
+          setActiveSection(hashId);
+        } else {
+          computeActiveSection();
+        }
+      });
+
+      computeActiveSection();
+    })();
+  </script>
+
 </body>
 
