+  width: 1px !important;
+  height: 1px !important;
+  margin: -1px !important;
+  padding: 0 !important;
+  border: 0 !important;
+  white-space: nowrap !important;
+}
+
+/* Visually signify inactivity on inert subtrees */
+[inert],
+[inert] * {
+  opacity: 0.5;
+  cursor: default;
+  user-select: none;
+}
+
+/* Prevent underlying page scroll chaining while a modal dialog is open */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  background-color: rgba(255, 255, 255, 0.3);
+  backdrop-filter: blur(4px);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+/* Support both native :popover-open and @oddbird/popover-polyfill class */
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
+
+/* Accessible high-contrast keyboard focus indicator */
+:where(a:any-link, button, input, select, textarea, summary):focus-visible {
+  outline: 3px solid #d97706;
+  outline-offset: 2px;
+}
